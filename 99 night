dUI then\r\n                    WindUI:Notify({\r\n                        Title = \"Stronghold Not Ready\",\r\n                        Content = \"Wait until the countdown ends and the Stronghold is marked ready before using Instant Attack.\",\r\n                        Duration = 5\r\n                    })\r\n                end\r\n                return\r\n            end\r\n        end\r\n\r\n        -- =====================================================\r\n        -- 5. FIND FINAL GATE\r\n        --\r\n        -- BARU DILAKUKAN SETELAH COUNTDOWN LOLOS.\r\n        -- =====================================================\r\n\r\n        local functional =\r\n            stronghold:FindFirstChild(\r\n                \"Functional\"\r\n            )\r\n\r\n        local finalGate =\r\n            functional\r\n            and functional:FindFirstChild(\r\n                \"FinalGate\"\r\n            )\r\n\r\n        if not finalGate then\r\n\r\n            if WindUI then\r\n                WindUI:Notify({\r\n                    Title = \"Stronghold Not Loaded\",\r\n                    Content = \"Please visit the Stronghold first to load its map completely, then try Manual Attack again.\",\r\n                    Duration = 15\r\n                })\r\n            end\r\n\r\n            return\r\n        end\r\n\r\n        -- =====================================================\r\n        -- 6. CHECK FINAL GATE POSITION\r\n        --\r\n        -- KHUSUS MANUAL ATTACK:\r\n        -- TIDAK menggunakan Sound.\r\n        --\r\n        -- CLOSED ≈ Y 53.996\r\n        -- OPEN   ≈ Y 62.996\r\n        --\r\n        -- Threshold = 58.5\r\n        -- =====================================================\r\n\r\n        local gateIsOpen = false\r\n\r\n        local gateCheckOK =\r\n            pcall(function()\r\n\r\n                local strongholdCF =\r\n                    stronghold:GetPivot()\r\n\r\n                local gateCF =\r\n                    finalGate:GetPivot