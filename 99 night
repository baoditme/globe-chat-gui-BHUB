sition = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)\r\n        end\r\n    end)\r\n    \r\n    btn.Visible = false\r\n    \r\n    while KixHubSession.Alive and task.wait(0.2) do\r\n        if not Window or not Window.UIElements or not Window.UIElements.Main or not Window.UIElements.Main.Parent then\r\n            sg:Destroy()\r\n            break\r\n        end\r\n        \r\n        if Window.Closed ~= previousWindowClosed then\r\n            if Window.Closed then\r\n                if os.clock() - lastGPress < 0.5 then\r\n                    closedByHotkey = true\r\n                else\r\n                    closedByHotkey = false\r\n                end\r\n            else\r\n                closedByHotkey = false\r\n            end\r\n            previousWindowClosed = Window.Closed\r\n        end\r\n        \r\n        if Window.Closed and not closedByHotkey then\r\n            if not isVisible then\r\n                isVisible = true\r\n                btn.Visible = true\r\n                TweenService:Create(btn, tweenInfo, {BackgroundTransparency = 0.1, TextTransparency = 0}):Play()\r\n                TweenService:Create(stroke, tweenInfo, {Transparency = 0.2}):Play()\r\n            end\r\n        else\r\n            if isVisible then\r\n                isVisible = false\r\n                TweenService:Create(btn, tweenInfo, {BackgroundTransparency = 1, TextTransparency = 1}):Play()\r\n                TweenService:Create(stroke, tweenInfo, {Transparency = 1}):Play()\r\n                task.delay(0.3, function()\r\n                    if not isVisible then btn.Visible = false end\r\n                end)\r\n            end\r\n        end\r\n    end\r\nend)\r\n]]\r\n\r\npcall(function()\r\n    Window:CreateTopbarButton('TransparencyToggle', 'eye', function()\r\n        if getgenv().TransparencyEnabled then\r\n            getgenv().TransparencyEnabled = false\r\n            pcall(function() Window:Toggl