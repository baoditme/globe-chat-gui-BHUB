"function\" then\r\n                                    pcall(function()\r\n                                        local consts = debug.getconstants(f)\r\n                                        for _, v in ipairs(consts) do\r\n                                            if type(v) == \"string\" and string.find(string.lower(v), \"anti%-fling\") then\r\n                                                isAntiFling = true\r\n                                                break\r\n                                            end\r\n                                        end\r\n                                    end)\r\n                                end\r\n                                \r\n                                if isAntiFling then\r\n                                    if conn.Disable then conn:Disable() end\r\n                                    if conn.Disconnect then conn:Disconnect() end\r\n                                end\r\n                            end\r\n                        end)\r\n                    end\r\n                end)\r\n            end\r\n        end\r\n\r\n        killAntiFling()\r\n        -- Scan lebih jarang untuk mencegah frame spikes dari getconnections/debug.getconstants.\r\n        while KixHubSession.Alive do\r\n            task.wait(12)\r\n            if not KixHubSession.Alive then break end\r\n            killAntiFling()\r\n        end\r\n    end)\r\nend)\r\n\r\n-- ==================== ADVANCED FUNCTIONS ====================\r\n\r\n-- HUMANOID SETUP\r\nlocal function applyWalkSpeedGuard()\r\n    if not humanoid then return end\r\n    -- Only force WalkSpeed if the current speed is BELOW TargetWalkSpeed\r\n    if humanoid.WalkSpeed < TargetWalkSpeed then\r\n        humanoid.WalkSpeed = TargetWalkSpeed\r\n    end\r\n    \r\n    if walkSpeedConn then walkSpeedConn:Disconnect() end\r\n    walkSpeedConn = humanoid:GetPropertyChangedSignal(\"WalkSpeed\"):Connect(function()\r\n        -- If Enabled, and the game tries to make us SLOWER than our target, resist it!\r\n        -- This allows the game to make us FASTER (like when Sprint feature sets speed to 29)\r\n        if WalkSpeedEnabled and humanoid.WalkSpeed < TargetWalkSpeed then\r\n            humanoid.WalkSpeed = TargetWalkSpeed\r\n        end\r\n    end)\r\nend\r\n\r\nlocal function setupHumanoid(char)\r\n    humanoid = char:WaitForChild(\"Humanoid\", 5)\r\n    if humanoid and WalkSpeedEnabled then\r\n        task.delay(0.1, applyWalkSpeedGuard)\r\n    end\r\nend\r\nif typeof(_LocalPlayer) == \"Instance\" and _LocalPlayer:IsA(\"Player\") and _LocalPlayer.Character then \r\n    setupHumanoid(_LocalPlayer.Character) \r\nend\r\nif typeof(_LocalPlayer) == \"Instance\" and _LocalPlayer:IsA(\"Player\") then\r\n    _LocalPlayer.CharacterAdded:Connect(setupHumanoid)\r\nend\r\n\r\n\r\n-- Custom Animation Engine to bypass RegisterKeyframeSequence blocks\r\nCustomAnimator = {}\r\nCustomAnimator.__index = CustomAnimator\r\n\r\nfunction CustomAnimator.new(character)\r\n    local self = setmetatable({}, CustomAnimator)\r\n    self.Character = character\r\n    self.Motors = {}\r\n    for _, desc in ipairs(character:GetDescendants()) do\r\n        if desc:IsA(\"Motor6D\") and desc.Part1 then\r\n            self.Motors[desc.Part1.Name] = desc\r\n        end\r\n    end\r\n    self.ActiveTrack = nil\r\n    self.StartTime = 0\r\n    \r\n    self.RenderConnection = game:GetService(\"RunService\").Stepped:Connect(function()\r\n        self:Update()\r\n    end)\r\n    return self\r\nend\r\n\r\nfunction CustomAnimator:Destroy()\r\n    if self.RenderConnection then\r\n        self.RenderConnection:Disconnect()\r\n    end\r\nend\r\n\r\nfunction CustomAnimator:Play(parsedTrack)\r\n    self.ActiveTrack = parsedTrack\r\n    self.StartTime = tick()\r\nend\r\n\r\nfunction CustomAnimator:Stop()\r\n    self.ActiveTrack = nil\r\nend\r\n\r\nfunction CustomAnimator:Update()\r\n    if not self.ActiveTrack then return end\r\n    \r\n    local t = tick() - self.St