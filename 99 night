r\n                            end\r\n                        end\r\n                    end\r\n\r\n                    if foundAny then\r\n                        local originalPos=hrp.CFrame\r\n                        local returnToCampfire=\r\n                            _G.IsStrongholdRaidActive\r\n                            or _G.CampfireCombatActive\r\n\r\n                        local wasFlying=flying\r\n                        local wasKillAura=killAuraEnabled\r\n\r\n                        if flying then\r\n                            stopFlying()\r\n                        end\r\n\r\n                        local staticFly=Instance.new(\"BodyVelocity\")\r\n                        staticFly.Name=\"CombatStaticFly\"\r\n                        staticFly.MaxForce=Vector3.new(math.huge,math.huge,math.huge)\r\n                        staticFly.Velocity=Vector3.zero\r\n                        staticFly.Parent=hrp\r\n\r\n                        if not killAuraEnabled then\r\n                            auraRadius=150\r\n                            toggleKillAura(true)\r\n                        end\r\n\r\n                        _G.AllowBodyAura=true\r\n                        _G.GlobalCultistCombatActive=true\r\n                        _G.CultistIceChopActive=false\r\n                        syncAuraDamageTool(\"weapon\")\r\n\r\n                        local hum=hrp.Parent:FindFirstChild(\"Humanoid\")\r\n                        local origWalkSpeed=16\r\n                        local origJumpPower=50\r\n                        local savedCollisions={}\r\n\r\n                        for _,part in ipairs(hrp.Parent:GetDescendants()) do\r\n                            if part:IsA(\"BasePart\") then\r\n                                savedCollisions[part]=part.CanCollide\r\n                            end\r\n                        end\r\n\r\n                        local noclipGlobalCultist=_RunService.Stepped:Connect(function()\r\n                            if not 