el\", true)\r\n        if childModel then\r\n            return childModel:GetPivot()\r\n        end\r\n\r\n        local childPart = anchor:FindFirstChildWhichIsA(\"BasePart\", true)\r\n        return childPart and childPart.CFrame or nil\r\n    end\r\n\r\n    local function resolveTargetCFrame(rawTarget)\r\n        if typeof(rawTarget) == \"CFrame\" then\r\n            return rawTarget\r\n        end\r\n\r\n        if type(rawTarget) ~= \"table\" then\r\n            return nil, \"InvalidTargetFormat\"\r\n        end\r\n\r\n        if rawTarget.Mode == \"Relative\" then\r\n            local anchorRef = rawTarget.AnchorPath or rawTarget.Anchor\r\n            local anchor = resolveAnchor(anchorRef)\r\n\r\n            if not anchor then\r\n                return nil, \"AnchorNotFound: \" .. tostring(anchorRef)\r\n            end\r\n\r\n            local anchorCFrame = getAnchorCFrame(anchor)\r\n            local relativeCFrame = rawTarget.CFrame or rawTarget.RelativeCFrame\r\n\r\n            if not anchorCFrame or typeof(relativeCFrame) ~= \"CFrame\" then\r\n                return nil, \"InvalidRelativeTarget\"\r\n            end\r\n\r\n            return anchorCFrame * relativeCFrame\r\n        end\r\n\r\n        if typeof(rawTarget.CFrame) == \"CFrame\" then\r\n            return rawTarget.CFrame\r\n        end\r\n\r\n        return nil, \"InvalidTargetFormat\"\r\n    end\r\n\r\n    local function getGridOffset()\r\n        local settings = GlobalSettings or (Client and Client.GlobalSettings)\r\n        local offset = settings and settings.GridOffset\r\n        return typeof(offset) == \"Vector3\" and offset or Vector3.zero\r\n    end\r\n\r\n    _G.AutoPlacementProtectedSlots = _G.AutoPlacementProtectedSlots or {}\r\n    local protectedSlotsTable = _G.AutoPlacementProtectedSlots\r\n    local hasRelativeTargets = false\r\n\r\n    for _, targets in pairs(PlacementData) do\r\n        for _, target in ipairs(targets) do\r\n            if type(target) == \"table\" and target.Mode == \"Relative\" then\r\n                hasRelativeTargets = true\r\n                break\r\n            end\r\n        end\r\n    end\r\n\r\n    local function updateProtectedSlots()\r\n        local gridOffset = getGridOffset()\r\n\r\n        for structureName, targets in pairs(PlacementData) do\r\n            if structureName ~= \"Teleporter_Legacy\" then\r\n                local slots = protectedSlotsTable[structureName]\r\n                if not slots then\r\n                    slots = {}\r\n                    protectedSlotsTable[structureName] = slots\r\n                end\r\n\r\n                for index, rawTarget in ipairs(targets) do\r\n                    local targetCFrame = resolveTargetCFrame(rawTarget)\r\n                    if targetCFrame then\r\n                        slots[index] = { Position = targetCFrame.Position + gridOffset }\r\n                    else\r\n                        slots[index] = nil\r\n                    end\r\n                end\r\n\r\n                for index = #slots, #targets + 1, -1 do\r\n                    slots[index] = nil\r\n                end\r\n            end\r\n        end\r\n    end\r\n\r\n    updateProtectedSlots()\r\n\r\n    -- ================================================================\r\n    -- STRUCTURE INDEX: NO REPEATED workspace.Structures:GetChildren()\r\n    -- ================================================================\r\n\r\n    local structuresFolder = nil\r\n    local structuresByName = {}\r\n    local indexedNames = {}\r\n\r\n    local function unindexModel(model)\r\n        local name = indexedNames[model]\r\n        if not name then\r\n            return\r\n        end\r\n\r\n        local entries = structuresByName[name]\r\n        if entries then\r\n            entries[model] = nil\r\n            if not next(entries) then\r\n                structuresByName[name] = nil\r\n            end\r\n        end\r\n\r\n        indexedNames[model] = nil\r\n        clearStructureState(name)\r\n    end\r\n\r\n    local function indexModel(model)\r\n        if not model:IsA(\"Model\") then\r\n            return\r\n        end\r\n\r\n        local name = canonicalizeName(model.Name)\r\n        if indexedNames[model] == name then\r\n            return\r\n        end\r\n\r\n        unindexModel(model)\r\n\r\n        local entries = structuresByName[name]\r\n        if not entries then\r\n            entries = {}\r\n            structuresByName[name] = entries\r\n        end\r\n\r\n        entries[model] = true\r\n        indexedNames[model] = name\r\n        clearStructureState(name)\r\n    end\r\n\r\n    local function trackModel(model)\r\n        if not model:IsA(\"Model\") then\r\n            return\r\n        end\r\n\r\n        -- Ignore unrelated structures; tracking every world model is wasteful.\r\n        if not BlueprintNames[canonicalizeName(model.Name)] then\r\n            return\r\n        end\r\n\r\n        indexModel(model)\r\n        if not modelNameConnections[model] then\r\n            modelNameConnections[model] = model:GetPropertyChangedSignal(\"Name\"):Connect(function()\r\n                indexModel(model)\r\n            end)\r\n        end\r\n    end\r\n\r\n    local function untrackModel(model)\r\n        local connection = modelNameConnections[model]\r\n        if connection then\r\n            connection:Disconnect()\r\n            modelNameConnections[model] = nil\r\n        end\r\n        unindexModel(model)\r\n    end\r\n\r\n    local function bindStructuresFolder()\r\n        local folder = world:FindFirstChild(\"Structures\")\r\n        if folder == structuresFolder then\r\n            return\r\n        end\r\n\r\n        disconnectAll(structureConnections)\r\n        for model, connection in pairs(modelNameConnections) do\r\n            connection:Disconnect()\r\n            modelNameConnections[model] = nil\r\n        end\r\n\r\n        table.clear(structuresByName)\r\n        table.clear(indexedNames)\r\n        table.clear(placementState)\r\n        structuresFolder = folder\r\n\r\n        if folder then\r\n            for _, child in ipairs(folder:GetChildren()) do\r\n                trackModel(child)\r\n            end\r\n\r\n            connect(folder.ChildAdded, function(child)\r\n                trackModel(child)\r\n            end, structureConnections)\r\n\r\n            connect(folder.ChildRemoved, function(child)\r\n                untrackModel(child)\r\n            end, structureConnections)\r\n        end\r\n\r\n        requestScan()\r\n    end\r\n\r\n    local function isAlreadyPlaced(structureName, targetCFrame)\r\n        if not structuresFolder then\r\n            return false\r\n        end\r\n\r\n        local entries = structuresByName[canonicalizeName(structureName)]\r\n        if not entries then\r\n            return false\r\n        end\r\n\r\n        local targetPosition = targetCFrame.Position\r\n        local checkFarmYaw = canonicalizeName(structureName) == \"Farm Plot\"\r\n        local _, targetYaw = targetCFrame:ToOrientation()\r\n        local tolerance = AutoPlacement.ExistingTolerance\r\n        local maxDistanceSquared = tolerance * tolerance\r\n\r\n        for model in pairs(entries) do\r\n            if model.Parent == structuresFolder then\r\n                local ok, modelCFrame = pcall(model.GetPivot, model)\r\n                if ok then\r\n                    local currentPosition = modelCFrame.Position\r\n                    local dx = currentPosition.X - targetPosition.X\r\n                    local dz = currentPosition.Z - targetPosition.Z\r\n\r\n                    -- Deliberately ignore Y: changing grass height must NOT\r\n                    -- cause an existing building to be treated as missing.\r\n                    if dx * dx + dz * dz <= maxDistanceSquared then\r\n                        if not checkFarmYaw then\r\n                            return true\r\n                        end\r\n\r\n                        local _, existingYaw = modelCFrame:ToOrientation()\r\n                        local deltaYaw = math.atan2(\r\n                            math.sin(existingYaw - targetYaw),\r\n                            math.cos(existingYaw - targetYaw)\r\n                        )\r\n\r\n                        if math.abs(deltaYaw) < AutoPlacement.FarmYawTolerance then\r\n                            return true\r\n                        end\r\n                    end\r\n                end\r\n            end\r\n        end\r\n\r\n        return false\r\n    end\r\n\r\n    -- ================================================================\r\n    -- GRASS INDEX: EVENT-DRIVEN AND REUSED RAYCAST PARAMETERS\r\n    -- ================================================================\r\n\r\n    local observedMap = nil\r\n    local groundFolder = nil\r\n    local grassParts = {}\r\n    local grassSet = {}\r\n    local grassDirty = true\r\n\r\n    local groundRayParams = RaycastParams.new()\r\n    groundRayParams.FilterType = Enum.RaycastFilterType.Include\r\n    groundRayParams.IgnoreWater = true\r\n    groundRayParams.RespectCanCollide = false\r\n\r\n    local function onGroundChanged()\r\n        grassDirty = true\r\n        -- Keep per-slot failure counts across streaming events so repeated\r\n        -- ground updates cannot restart the retry limit indefinitely.\r\n        requestScan()\r\n    end\r\n\r\n    local function addGrassPart(part)\r\n        if part:IsA(\"BasePart\") and part.Name == \"Grass\" then\r\n            grassSet[part] = true\r\n            onGroundChanged()\r\n        end\r\n    end\r\n\r\n    local function removeGrassPart(part)\r\n        if grassSet[part] then\r\n            grassSet[part] = nil\r\n            onGroundChanged()\r\n        end\r\n    end\r\n\r\n    local function bindGroundFolder()\r\n        local folder = observedMap and observedMap:FindFirstChild(\"Ground\")\r\n        if folder == groundFolder then\r\n            return\r\n        end\r\n\r\n        disconnectAll(groundConnections)\r\n        table.clear(grassSet)\r\n        groundFolder = folder\r\n\r\n        if folder then\r\n            for _, child in ipairs(folder:GetChildren()) do\r\n                if child:IsA(\"BasePart\") and child.Name == \"Grass\" then\r\n                    grassSet[child] = true\r\n                end\r\n            end\r\n\r\n            connect(folder.ChildAdded, addGrassPart, groundConnections)\r\n            connect(folder.ChildRemoved, removeGrassPart, groundConnections)\r\n        end\r\n\r\n        onGroundChanged()\r\n    end\r\n\r\n    local function bindMapFolder()\r\n        local map = world:FindFirstChild(\"Map\")\r\n        if map ~= observedMap then\r\n            disconnectAll(mapConnections)\r\n            observedMap = map\r\n\r\n            if map then\r\n                connect(map.ChildAdded, function(child)\r\n                    if child.Name == \"Ground\" then\r\n                        bindGroundFolder()\r\n                    end\r\n                end, mapConnections)\r\n\r\n                connect(map.ChildRemoved, function(child)\r\n                    if child == groundFolder then\r\n                        bindGroundFolder()\r\n                    end\r\n                end, mapConnections)\r\n            end\r\n        end\r\n\r\n        bindGroundFolder()\r\n    end\r\n\r\n    local function refreshRaycastFilter()\r\n        if not grassDirty then\r\n            return #grassParts > 0\r\n        end\r\n\r\n        table.clear(grassParts)\r\n\r\n        for part in pairs(grassSet) do\r\n            if part.Parent == groundFolder then\r\n                table.insert(grassParts, part)\r\n            else\r\n                grassSet[part] = nil\r\n            end\r\n        end\r\n\r\n        groundRayParams.FilterDescendantsInstances = grassParts\r\n        grassDirty = false\r\n        return #grassParts > 0\r\n    end\r\n\r\n    local groundSampleOffsets = {\r\n        Vector2.new(1, 0),\r\n        Vector2.new(-1, 0),\r\n        Vector2.new(0, 1),\r\n        Vector2.new(0, -1),\r\n        Vector2.new(1, 1),\r\n        Vector2.new(-1, 1),\r\n        Vector2.new(1, -1),\r\n        Vector2.new(-1, -1),\r\n    }\r\n\r\n    local function getGroundPosition(targetCFrame)\r\n        if not groundFolder or not refreshRaycastFilter() then\r\n            return nil\r\n        end\r\n\r\n        local target = targetCFrame.Position\r\n        local originY = target.Y + AutoPlacement.GroundRayUp\r\n        local direction = Vector3.new(0, -AutoPlacement.GroundRayDown, 0)\r\n        local radius = AutoPlacement.GroundSampleRadius\r\n\r\n        -- Try the exact requested X/Z first.\r\n        local result = world:Raycast(\r\n            Vector3.new(target.X, originY, target.Z),\r\n            direction,\r\n            groundRayParams\r\n        )\r\n\r\n        if result then\r\n            return result.Position\r\n        end\r\n\r\n        -- Edge-of-grass fallback: shift at most 0.75 studs horizontally.\r\n        -- Only executed if the primary ground ray fails.\r\n        for _, offset in ipairs(groundSampleOffsets) do\r\n            result = world:Raycast(\r\n                Vector3.new(\r\n                    target.X + offset.X * radius,\r\n                    originY,\r\n                    target.Z + offset.Y * radius\r\n                ),\r\n                direction,\r\n                groundRayParams\r\n            )\r\n\r\n            if result then\r\n                return result.Position\r\n            end\r\n        end\r\n\r\n        return nil\r\n    end\r\n\r\n    -- ================================================================\r\n    -- INVENTORY: LISTEN FOR BLUEPRINT CHANGES\r\n    -- ================================================================\r\n\r\n    local inventoryRoots = {}\r\n    local watchedContainers = {}\r\n\r\n    local function blueprintChanged(child)\r\n        if string.find(child.Name, \"Blueprint\", 1, true) then\r\n            requestScan()\r\n        end\r\n    end\r\n\r\n    local function watchContainer(container)\r\n        if not container or watchedContainers[container] then\r\n            return\r\n        end\r\n\r\n        watchedContainers[container] = {\r\n            container.ChildAdded:Connect(blueprintChanged),\r\n            container.ChildRemoved:Connect(blueprintChanged),\r\n        }\r\n    end\r\n\r\n    local function unwatchContainer(container)\r\n        local connections = watchedContainers[container]\r\n        if connections then\r\n            disconnectAll(connections)\r\n            watchedContainers[container] = nil\r\n        end\r\n    end\r\n\r\n    local function refreshInventoryRoots()\r\n        local newRoots = {}\r\n        local inventory = player:FindFirstChild(\"Inventory\")\r\n        local backpack = player:FindFirstChild(\"Backpack\")\r\n        local character = player.Character\r\n\r\n        -- Compact list; ipairs stops at the first nil value.\r\n        if inventory then\r\n            table.insert(newRoots, inventory)\r\n        end\r\n        if backpack then\r\n            table.insert(newRoots, backpack)\r\n        end\r\n        if character then\r\n            table.insert(newRoots, character)\r\n        end\r\n\r\n        local current = {}\r\n        for _, root in ipairs(newRoots) do\r\n            current[root] = true\r\n            watchContainer(root)\r\n        end\r\n\r\n        for root in pairs(watchedContainers) do\r\n            if not current[root] then\r\n                unwatchContainer(root)\r\n            end\r\n        end\r\n\r\n        inventoryRoots = newRoots\r\n        requestScan()\r\n    end\r\n\r\n    local function getBlueprintTool(structureName)\r\n        local names = BlueprintNames[canonicalizeName(structureName)]\r\n        if not names then\r\n            return nil\r\n        end\r\n\r\n        for _, blueprintName in ipairs(names) do\r\n            for _, root in ipairs(inventoryRoots) do\r\n                local found = root:FindFirstChild(blueprintName)\r\n                if found then\r\n                    return found\r\n                end\r\n            end\r\n        end\r\n\r\n        return nil\r\n    end\r\n\r\n    -- ================================================================\r\n    -- REMOTE & BLUEPRINT HEIGHT OFFSET\r\n    -- ================================================================\r\n\r\n    local cachedRemote = nil\r\n    local nextRemoteSearch = 0\r\n    local heightCache = setmetatable({}, { __mode = \"k\" })\r\n\r\n    local function getPlacementRemote()\r\n        if cachedRemote and cachedRemote.Parent then\r\n            return cachedRemote\r\n        end\r\n\r\n        local events = Client and Client.Events\r\n        local clientRemote = events and events.RequestPlaceStructure\r\n        if typeof(clientRemote) == \"Instance\" and clientRemote:IsA(\"RemoteFunction\") then\r\n            cachedRemote = clientRemote\r\n            return clientRemote\r\n        end\r\n\r\n        if os.clock() < nextRemoteSearch then\r\n            return nil\r\n        end\r\n\r\n        nextRemoteSearch = os.clock() + 5\r\n        local remote = replicatedStorage:FindFirstChild(\"RequestPlaceStructure\", true)\r\n        if remote and remote:IsA(\"RemoteFunction\") then\r\n            cachedRemote = remote\r\n            return remote\r\n        end\r\n\r\n        return nil\r\n    end\r\n\r\n    local function getStructureHeightOffset(blueprint)\r\n        local override = blueprint:GetAttribute(\"StructureHeightOffset\")\r\n        if typeof(override) == \"number\" then\r\n            return override\r\n        end\r\n\r\n        local cached = heightCache[blueprint]\r\n        if cached ~= nil then\r\n            return cached\r\n        end\r\n\r\n        local offset = 0\r\n        if blueprint:IsA(\"Model\") then\r\n            local ok, boundingCFrame, boundingSize = pcall(blueprint.GetBoundingBox, blueprint)\r\n            if ok then\r\n                local pivotPart = blueprint.PrimaryPart\r\n                local pivotY = pivotPart and pivotPart.Position.Y or boundingCFrame.Position.Y\r\n                local bottomY = boundingCFrame.Position.Y - boundingSize.Y / 2\r\n                offset = pivotY - bottomY\r\n            end\r\n        end\r\n\r\n        -- Tools without StructureHeightOffset retain the original 0 offset.\r\n        heightCache[blueprint] = offset\r\n        return offset\r\n    end\r\n\r\n    local function getGroundCFrame(targetCFrame, blueprint)\r\n        local groundPosition = getGroundPosition(targetCFrame)\r\n        if not groundPosition then\r\n            return nil, \"GrassNotFound\"\r\n        end\r\n\r\n        local rotation = targetCFrame - targetCFrame.Position\r\n        local offset = getGridOffset()\r\n        local height = getStructureHeightOffset(blueprint)\r\n\r\n        -- World-space height adjustment. The saved CFrame.Y is discarded.\r\n        -- Do NOT multiply a local Y translation by the structure rotation.\r\n        return rotation + groundPosition + offset + Vector3.new(0, height, 0)\r\n    end\r\n\r\n    -- ================================================================\r\n    -- SERVER PLACEMENT / RETRIES\r\n    -- ================================================================\r\n\r\n    local function markPlaced(structureName, slotIndex)\r\n        local slots = placementState[structureName]\r\n        if not slots then\r\n            slots = {}\r\n            placementState[structureName] = slots\r\n        end\r\n\r\n        slots[slotIndex] = true\r\n\r\n        local failures = placementFailures[structureName]\r\n        if failures then\r\n            failures[slotIndex] = nil\r\n        end\r\n    end\r\n\r\n    local function getRetryEntry(structureName, slotIndex)\r\n        local failures = placementFailures[structureName]\r\n        return failures and failures[slotIndex] or nil\r\n    end\r\n\r\n    local function registerFailure(structureName, slotIndex, reason)\r\n        local failures = placementFailures[structureName]\r\n        if not failures then\r\n            failures = {}\r\n            placementFailures[structureName] = failures\r\n        end\r\n\r\n        local entry = failures[slotIndex] or { Count = 0, NextAttempt = 0 }\r\n        entry.Count += 1\r\n        entry.Reason = reason\r\n\r\n        if entry.Count >= AutoPlacement.MaxFailureAttempts then\r\n            entry.Skipped = true\r\n            entry.NextAttempt = 0\r\n            failures[slotIndex] = entry\r\n            warn(string.format(\r\n                \"[AutoPlacement] %s #%d skipped after %d failed attempts (last: %s)\",\r\n                structureName,\r\n                slotIndex,\r\n                AutoPlacement.MaxFailureAttempts,\r\n                tostring(reason)\r\n            ))\r\n            return os.clock() + AutoPlacement.IdleRefreshDelay\r\n        end\r\n\r\n        local exponent = math.min(entry.Count - 1, 4)\r\n        local delay = math.min(\r\n            AutoPlacement.RetryDelay * 2 ^ exponent,\r\n            AutoPlacement.MaxRetryDelay\r\n        )\r\n\r\n        -- Ground may not have replicated yet. Keep retrying without\r\n        -- marking the slot as permanently invalid.\r\n        if reason == \"GrassNotFound\" then\r\n            delay = AutoPlacement.RetryDelay\r\n        end\r\n\r\n        entry.NextAttempt = os.clock() + delay\r\n        failures[slotIndex] = entry\r\n\r\n        if entry.Count == 1 or entry.Count % 5 == 0 then\r\n            warn(string.format(\r\n                \"[AutoPlacement] %s #%d: %s (retry in %.1fs)\",\r\n                structureName,\r\n                slotIndex,\r\n                tostring(reason),\r\n                delay\r\n            ))\r\n        end\r\n\r\n        return entry.NextAttempt\r\n    end\r\n\r\n    local function placeOneStructure(structureName, rawTarget, slotIndex, token, blueprint)\r\n        if not isActive(token) then\r\n            return false, \"Stopped\", false\r\n        end\r\n\r\n        local targetCFrame, targetError = resolveTargetCFrame(rawTarget)\r\n        if not targetCFrame then\r\n            return false, targetError, false\r\n        end\r\n\r\n        local state = placementState[structureName]\r\n        if state and state[slotIndex] then\r\n            return true, \"StateAlreadyPlaced\", false\r\n        end\r\n\r\n        if isAlreadyPlaced(structureName, targetCFrame) then\r\n            markPlaced(structureName, slotIndex)\r\n            return true, \"AlreadyExists\", false\r\n        end\r\n\r\n        if not blueprint or not blueprint.Parent then\r\n            return false, \"BlueprintNotAvailable\", false\r\n        end\r\n\r\n        local remote = getPlacementRemote()\r\n        if not remote then\r\n            return false, \"RequestPlaceStructureNotFound\", false\r\n        end\r\n\r\n        local finalCFrame, groundError = getGroundCFrame(targetCFrame, blueprint)\r\n        if not finalCFrame then\r\n            return false, groundError, false\r\n        end\r\n\r\n        local placementResult = {\r\n            Valid = true,\r\n            Position = finalCFrame.Position,\r\n            CFrame = finalCFrame,\r\n            ErrorType = nil,\r\n        }\r\n\r\n        local rotation = finalCFrame - finalCFrame.Position\r\n        local placeAnywhere = blueprint:GetAttribute(\"PlaceAnywhere\")\r\n\r\n        local success, response = pcall(function()\r\n            return remote:InvokeServer(\r\n                blueprint,\r\n                placementResult,\r\n                rotation,\r\n                placeAnywhere\r\n            )\r\n        end)\r\n\r\n        if not isActive(token) then\r\n            return false, \"Stopped\", true\r\n        end\r\n\r\n        if not success then\r\n            return false, tostring(response), true\r\n        end\r\n\r\n        if response == false then\r\n            return false, \"ServerRejected\", true\r\n        end\r\n\r\n        if type(response) == \"table\" and response.Success == false then\r\n            return false, tostring(response.Error or \"ServerRejected\"), true\r\n        end\r\n\r\n        markPlaced(structureName, slotIndex)\r\n        return true, \"Placed\", true\r\n    end\r\n\r\n    local function areAllFarmPlotsPlaced()\r\n        local positions = PlacementData[\"Farm Plot\"]\r\n        if not positions then\r\n            return true\r\n        end\r\n\r\n        for _, rawTarget in ipairs(positions) do\r\n            local target = resolveTargetCFrame(rawTarget)\r\n            if not target or not isAlreadyPlaced(\"Farm Plot\", target) then\r\n                return false\r\n            end\r\n        end\r\n\r\n        return true\r\n    end\r\n\r\n    local function processAvailableStructures(token)\r\n        -- Never attempt placements while grass is still replicating.\r\n        -- A single cheap test avoids dozens of failed per-slot raycasts.\r\n        if not groundFolder or not refreshRaycastFilter() then\r\n            return 2\r\n        end\r\n\r\n        local earliestRetry = os.clock() + AutoPlacement.IdleRefreshDelay\r\n        local farmPlotsComplete = nil\r\n\r\n        for _, structureName in ipairs(PlacementOrder) do\r\n            if not isActive(token) then\r\n                break\r\n            end\r\n\r\n            local fullAuto = _G.KixFullAuto\r\n            if fullAuto and fullAuto.Active\r\n                and type(fullAuto.ShouldSkipStructure) == \"function\"\r\n                and fullAuto.ShouldSkipStructure(structureName) then\r\n                continue\r\n            end\r\n\r\n            local positions = PlacementData[structureName]\r\n            if #positions == 0 then\r\n                continue\r\n            end\r\n\r\n            local blueprint = getBlueprintTool(structureName)\r\n            if not blueprint then\r\n                continue\r\n            end\r\n\r\n            if structureName == \"Crock Pot\" then\r\n                if farmPlotsComplete == nil then\r\n                    farmPlotsComplete = areAllFarmPlotsPlaced()\r\n                end\r\n\r\n                if not farmPlotsComplete then\r\n                    continue\r\n                end\r\n            end\r\n\r\n            for slotIndex, target in ipairs(positions) do\r\n                if not isActive(token) then\r\n                    break\r\n                end\r\n\r\n                local state = placementState[structureName]\r\n                if state and state[slotIndex] then\r\n                    continue\r\n                end\r\n\r\n                local failure = getRetryEntry(structureName, slotIndex)\r\n                if failure and failure.Skipped then\r\n                    continue\r\n                end\r\n                if failure and os.clock() < failure.NextAttempt then\r\n                    earliestRetry = math.min(earliestRetry, failure.NextAttempt)\r\n                    continue\r\n                end\r\n\r\n                local placed, reason, didInvoke = placeOneStructure(\r\n                    structureName,\r\n                    target,\r\n                    slotIndex,\r\n                    token,\r\n                    blueprint\r\n                )\r\n\r\n                if reason == \"BlueprintNotAvailable\" or reason == \"Stopped\" then\r\n                    break\r\n                end\r\n\r\n                if not placed then\r\n                    local retryAt = registerFailure(structureName, slotIndex, reason)\r\n                    earliestRetry = math.min(earliestRetry, retryAt)\r\n\r\n                    if reason == \"RequestPlaceStructureNotFound\" then\r\n                        -- Avoid warning for every slot when the remote is missing.\r\n                        return 5\r\n                    end\r\n                end\r\n\r\n                if didInvoke and isActive(token) then\r\n                    task.wait(AutoPlacement.PlacementDelay)\r\n                end\r\n            end\r\n        end\r\n\r\n        return math.max(0.25, earliestRetry - os.clock())\r\n    end\r\n\r\n    -- ================================================================\r\n    -- SINGLE WORKER: EVENT-DRIVEN, NO BUSY POLLING\r\n    -- ================================================================\r\n\r\n    local function scheduleNextScan(delay)\r\n        timerVersion += 1\r\n        local scheduledVersion = timerVersion\r\n\r\n        task.delay(delay, function()\r\n            if not cleanedUp\r\n                and AutoPlacement.Enabled\r\n                and scheduledVersion == timerVersion\r\n            then\r\n                requestScan()\r\n            end\r\n        end)\r\n    end\r\n\r\n    local function workerLoop()\r\n        if workerRunning then\r\n            return\r\n        end\r\n\r\n        workerRunning = true\r\n        local token = runToken\r\n\r\n        while isActive(token) do\r\n            if not needsWork then\r\n                wakeEvent.Event:Wait()\r\n            end\r\n\r\n            if not isActive(token) then\r\n                break\r\n            end\r\n\r\n            if needsWork then\r\n                needsWork = false\r\n\r\n                if hasRelativeTargets then\r\n                    updateProtectedSlots()\r\n                end\r\n\r\n                local success, result = pcall(processAvailableStructures, token)\r\n                if success then\r\n                    scheduleNextScan(result)\r\n                else\r\n                    warn(\"[AutoPlacement ERROR]\", result)\r\n                    scheduleNextScan(2)\r\n                end\r\n            end\r\n        end\r\n\r\n        workerRunning = false\r\n\r\n        -- If the toggle was switched off/on while InvokeServer yielded,\r\n        -- launch the new generation only after the previous one exits.\r\n        if AutoPlacement.Enabled and not cleanedUp then\r\n            task.spawn(workerLoop)\r\n        end\r\n    end\r\n\r\n    local function startAutoPlacement()\r\n        if cleanedUp or AutoPlacement.Enabled then\r\n            return\r\n        end\r\n\r\n        AutoPlacement.Enabled = true\r\n        runToken += 1\r\n        table.clear(placementState)\r\n        table.clear(placementFailures)\r\n        refreshInventoryRoots()\r\n        bindMapFolder()\r\n        bindStructuresFolder()\r\n        updateProtectedSlots()\r\n        requestScan()\r\n        task.spawn(workerLoop)\r\n    end\r\n\r\n    local function stopAutoPlacement()\r\n        if not AutoPlacement.Enabled then\r\n            return\r\n        end\r\n\r\n        AutoPlacement.Enabled = false\r\n        runToken += 1\r\n        timerVersion += 1\r\n        table.clear(placementState)\r\n        table.clear(placementFailures)\r\n        needsWork = false\r\n        wakeEvent:Fire()\r\n    end\r\n\r\n    -- ================================================================\r\n    -- ONE-TIME EVENT REGISTRATION\r\n    -- ================================================================\r\n\r\n    bindMapFolder()\r\n    bindStructuresFolder()\r\n    refreshInventoryRoots()\r\n\r\n    connect(world.ChildAdded, function(child)\r\n        if child.Name == \"Map\" then\r\n            bindMapFolder()\r\n        elseif child.Name == \"Structures\" then\r\n            bindStructuresFolder()\r\n        end\r\n    end, globalConnections)\r\n\r\n    connect(world.ChildRemoved, function(child)\r\n        if child == observedMap then\r\n            bindMapFolder()\r\n        elseif child == structuresFolder then\r\n            bindStructuresFolder()\r\n        end\r\n    end, globalConnections)\r\n\r\n    connect(player.ChildAdded, function(child)\r\n        if child.Name == \"Inventory\" or child.Name == \"Backpack\" then\r\n            refreshInventoryRoots()\r\n        end\r\n    end, inventoryConnections)\r\n\r\n    connect(player.ChildRemoved, function(child)\r\n        if child.Name == \"Inventory\" or child.Name == \"Backpack\" then\r\n            refreshInventoryRoots()\r\n        end\r\n    end, inventoryConnections)\r\n\r\n    connect(player.CharacterAdded, refreshInventoryRoots, inventoryConnections)\r\n    connect(player.CharacterRemoving, function(character)\r\n        unwatchContainer(character)\r\n        refreshInventoryRoots()\r\n    end, inventoryConnections)\r\n\r\n    -- ================================================================\r\n    -- CLEANUP / RE-EXECUTION SAFETY\r\n    -- ================================================================\r\n\r\n    local function cleanupAutoPlacement()\r\n        if cleanedUp then\r\n            return\r\n        end\r\n\r\n        stopAutoPlacement()\r\n        cleanedUp = true\r\n        runToken += 1\r\n        timerVersion += 1\r\n\r\n        disconnectAll(globalConnections)\r\n        disconnectAll(mapConnections)\r\n        disconnectAll(groundConnections)\r\n        disconnectAll(structureConnections)\r\n        disconnectAll(inventoryConnections)\r\n\r\n        for container in pairs(watchedContainers) do\r\n            unwatchContainer(container)\r\n        end\r\n\r\n        for model, connection in pairs(modelNameConnections) do\r\n            connection:Disconnect()\r\n            modelNameConnections[model] = nil\r\n        end\r\n\r\n        wakeEvent:Fire()\r\n        wakeEvent:Destroy()\r\n\r\n        if environment.KixAutoPlacementCleanup == cleanupAutoPlacement then\r\n            environment.KixAutoPlacementCleanup = nil\r\n        end\r\n        if _G.KixWakeAutoPlacement == requestScan then\r\n            _G.KixWakeAutoPlacement = nil\r\n        end\r\n        _G.ToggleAutoStructurePlacement = nil\r\n    end\r\n\r\n    environment.KixAutoPlacementCleanup = cleanupAutoPlacement\r\n\r\n    local previousHubCleanup = environment.KixHubCleanup\r\n    environment.KixHubCleanup = function(...)\r\n        cleanupAutoPlacement()\r\n        if type(previousHubCleanup) == \"function\" then\r\n            return previousHubCleanup(...)\r\n        end\r\n    end\r\n\r\n    -- ================================================================\r\n    -- WINDUI INTEGRATION (ORIGINAL UI KEPT)\r\n    -- ================================================================\r\n\r\n    _G.ToggleAutoStructurePlacement = function(value)\r\n        if value then\r\n            startAutoPlacement()\r\n        else\r\n            stopAutoPlacement()\r\n        end\r\n    end\r\n\r\n    -- Port the current placement controller into Full Automation's engine API.\r\n    -- The controller remains the source of truth for enabled state.\r\n    _G.KixAdapters = _G.KixAdapters or {}\r\n    _G.KixEngines = _G.KixEngines or {}\r\n    _G.KixEngines.AutoStructure = function(value)\r\n        _G.ToggleAutoStructurePlacement(value == true)\r\n    end\r\n    _G.KixAdapters.AutoStructure = {\r\n        IsEnabled = function()\r\n            return AutoPlacement.Enabled == true\r\n        end,\r\n        SetState = function(value)\r\n            return _G.KixEngines.AutoStructure(value)\r\n        end,\r\n    }\r\nend)()\r\n\r\n\r\n-- =========================================================\r\n-- AUTO BUY ON CRAFTING BENCH\r\n-- STANDALONE\r\n-- SEQUENTIAL PURCHASE CONTROLLER\r\n-- =========================================================\r\ndo local function INIT_AUTO_BUY_CRAFTING_BENCH()\r\n\r\n    local AutoBuy = {\r\n        Enabled = false,\r\n        CheckDelay = 0.25,\r\n        PurchaseCooldown = 0.15,\r\n    }\r\n\r\n    local sessionBought = {}\r\n\r\n    local BUY_SEQUENCE = {\r\n        { Step = 1,  Name = \"Map\",                    TargetCount = nil, IsUpgrade = false, RequiredTier = 1, WoodPrice = 3,  ScrapPrice = 0,  GemPrice = 0, GreenGemPrice = 0 },\r\n        { Step = 2,  Name = \"Old Bed\",                TargetCount = nil, IsUpgrade = false, RequiredTier = 1, WoodPrice = 20, ScrapPrice = 0,  GemPrice = 0, GreenGemPrice = 0, Aliases = {\"Spooky Old Bed\"} },\r\n        { Step = 3,  Name = \"Costume Closet\",         TargetCount = nil, IsUpgrade = false, RequiredTier = 1, WoodPrice = 3,  ScrapPrice = 0,  GemPrice = 0, GreenGemPrice = 0 },\r\n        { Step = 4,  Name = \"Supply Crate\",           TargetCount = nil, IsUpgrade = false, RequiredTier = 1, WoodPrice = 3,  ScrapPrice = 0,  GemPrice = 0, GreenGemPrice = 0 },\r\n        { Step = 5,  Name = \"Crafting Bench 2\",       TargetCount = nil, IsUpgrade = true,  RequiredTier = 1, TargetTier = 2, WoodPrice = 5,  ScrapPrice = 1,  GemPrice = 0, GreenGemPrice = 0 },\r\n        { Step = 6,  Name = \"Sun Dial\",               TargetCount = nil, IsUpgrade = false, RequiredTier = 2, WoodPrice = 0,  ScrapPrice = 5,  GemPrice = 0, GreenGemPrice = 0 },\r\n        { Step = 7,  Name = \"Regular Bed\",            TargetCount = nil, IsUpgrade = false, RequiredTier = 2, WoodPrice = 0,  ScrapPrice = 5,  GemPrice = 0, GreenGemPrice = 0, Aliases = {\"Reguler Bed\", \"Spooky Regular Bed\", \"Spooky Reguler Bed\"} },\r\n        { Step = 8,  Name = \"Compass\",                TargetCount = nil, IsUpgrade = false, RequiredTier = 2, WoodPrice = 0,  ScrapPrice = 3,  GemPrice = 0, GreenGemPrice = 0 },\r\n        { Step = 9,  Name = \"Crafting Bench 3\",       TargetCount = nil, IsUpgrade = true,  RequiredTier = 2, TargetTier = 3, WoodPrice = 15, ScrapPrice = 10, GemPrice = 0, GreenGemPrice = 0 },\r\n        { Step = 10, Name = \"Crock Pot\",              TargetCount = nil, IsUpgrade = false, RequiredTier = 3, WoodPrice = 15, ScrapPrice = 10, GemPrice = 0, GreenGemPrice = 0, Aliases = {\"Spooky Crock Pot\"} },\r\n        { Step = 11, Name = \"Good Bed\",               TargetCount = nil, IsUpgrade = false, RequiredTier = 3, WoodPrice = 10, ScrapPrice = 10, GemPrice = 0, GreenGemPrice = 0, Aliases = {\"Spooky Good Bed\"} },\r\n        { Step = 12, Name = \"Biofuel Processor\",      TargetCount = nil, IsUpgrade = false, RequiredTier = 3, WoodPrice = 12, ScrapPrice = 12, GemPrice = 0, GreenGemPrice = 0 },\r\n        { Step = 13, Name = \"Lightning Rod\",          TargetCount = 3,   IsUpgrade = false, RequiredTier = 3, WoodPrice = 0,  ScrapPrice = 8,  GemPrice = 0, GreenGemPrice = 0 },\r\n        { Step = 14, Name = \"Crafting Bench 4\",       TargetCount = nil, IsUpgrade = true,  RequiredTier = 3, TargetTier = 4, WoodPrice = 30, ScrapPrice = 20, GemPrice = 2, GreenGemPrice = 0 },\r\n        { Step = 15, Name = \"Giant Bed\",              TargetCount = nil, IsUpgrade = false, RequiredTier = 4, WoodPrice = 20, ScrapPrice = 30, GemPrice = 1, GreenGemPrice = 0, Aliases = {\"Spooky Giant Bed\"} },\r\n        { Step = 16, Name = \"Torch\",                  TargetCount = nil, IsUpgrade = false, RequiredTier = 3, WoodPrice = 6,  ScrapPrice = 6,  GemPrice = 0, GreenGemPrice = 0, Limit = 10, Aliases = {\"Spooky Torch\"} },\r\n        { Step = 17, Name = \"Bear Trap\",              TargetCount = 3,   IsUpgrade = false, RequiredTier = 2, WoodPrice = 0,  ScrapPrice = 3,  GemPrice = 0, GreenGemPrice = 0, Limit = 8, Aliases = {\"Volcanic Bear Trap\"} },\r\n        { Step = 18, Name = \"Radar\",                  TargetCount = nil, IsUpgrade = false, RequiredTier = 3, WoodPrice = 15, ScrapPrice = 10, GemPrice = 0, GreenGemPrice = 0 },\r\n        { Step = 19, Name = \"Boost Pad\",              TargetCount = nil, IsUpgrade = false, RequiredTier = 3, WoodPrice = 15, ScrapPrice = 10, GemPrice = 0, GreenGemPrice = 0, Aliases = {\"Winged Boost Pad\"} },\r\n        { Step = 20, Name = \"Farm Plot\",              TargetCount = nil, IsUpgrade = false, RequiredTier = 2, WoodPrice = 10, ScrapPrice = 0,  GemPrice = 0, GreenGemPrice = 0, Limit = 20, Aliases = {\"Enchanted Farm Plot\", \"Spooky Farm Plot\"} },\r\n        { Step = 21, Name = \"Oil Drill\",              TargetCount = nil, IsUpgrade = false, RequiredTier = 4, WoodPrice = 25, ScrapPrice = 35, GemPrice = 1, GreenGemPrice = 0 },\r\n        { Step = 22, Name = \"Teleporter\",             TargetCount = 2,   IsUpgrade = false, RequiredTier = 4, WoodPrice = 15, ScrapPrice = 25, GemPrice = 1, GreenGemPrice = 0 },\r\n        { Step = 23, Name = \"Crafting Bench 5\",       TargetCount = nil, IsUpgrade = true,  RequiredTier = 4, TargetTier = 5, WoodPrice = 50, ScrapPrice = 50, GemPrice = 0, GreenGemPrice = 1 },\r\n        { Step = 24, Name = \"Temporal Accelerometer\", TargetCount = nil, IsUpgrade = false, RequiredTier = 5, WoodPrice = 40, ScrapPrice = 40, GemPrice = 0, GreenGemPrice = 1 },\r\n        { Step = 25, Name = \"Weather Machine\",        TargetCount = nil, IsUpgrade = false, RequiredTier = 5, WoodPrice = 40, ScrapPrice = 40, GemPrice = 0, GreenGemPrice = 1 },\r\n        { Step = 26, Name = \"Respawn Capsule\",        TargetCount = nil, IsUpgrade = false, RequiredTier = 5, WoodPrice = 40, ScrapPrice = 40, GemPrice = 0, GreenGemPrice = 1 },\r\n\t\t{ Step = 27, Name = \"Recycler\",               TargetCount = nil, IsUpgrade = false, RequiredTier = 5, WoodPrice = 40, ScrapPrice = 40, GemPrice = 0, GreenGemPrice = 1 },\r\n    }\r\n\r\n    local autoBuyThread = nil\r\n\r\n    local function memoryClearActive()\r\n        local fullAuto = _G.KixFullAuto\r\n        return fullAuto and fullAuto.Jobs and fullAuto.Jobs.GiantBedMemoryClear == true\r\n    end\r\n\r\n    local function getCraftRemote()\r\n        local remotes = _ReplicatedStorage:FindFirstChild(\"RemoteEvents\")\r\n        if remotes then\r\n            local r = remotes:FindFirstChild(\"CraftItem\")\r\n            if r and r:IsA(\"RemoteFunction\") then\r\n                return r\r\n            end\r\n        end\r\n        local success, Client = pcall(function()\r\n            return require(_LocalPlayer.PlayerScripts.Client)\r\n        end)\r\n        if success and Client and Client.Events and Client.Events.CraftItem then\r\n            return Client.Events.CraftItem\r\n        end\r\n        return nil\r\n    end\r\n\r\n    local function getCraftingTableFolder()\r\n        return _ReplicatedStorage:FindFirstChild(\"Crafting Table\")\r\n    end\r\n\r\n    local function getCampground()\r\n        local map = _Workspace:FindFirstChild(\"Map\")\r\n        if map then\r\n            return map:FindFirstChild(\"Campground\")\r\n        end\r\n        return nil\r\n    end\r\n\r\n    local function getBenchTier()\r\n        local cTable = getCraftingTableFolder()\r\n        if cTable then\r\n            return cTable:GetAttribute(\"CraftingTableTier\") or 1\r\n        end\r\n        return 1\r\n    end\r\n\r\n    local function getItemFolder(step)\r\n        local cTable = getCraftingTableFolder()\r\n        if not cTable then return nil end\r\n        local folder = cTable:FindFirstChild(step.Name)\r\n        if folder then return folder end\r\n        if step.Aliases then\r\n            for _, alias in ipairs(step.Aliases) do\r\n                folder = cTable:FindFirstChild(alias)\r\n                if folder then return folder end\r\n            end\r\n        end\r\n        return nil\r\n    end\r\n\r\n    local function getItemCraftName(step, itemFolder)\r\n        if itemFolder then\r\n            return itemFolder.Name\r\n        end\r\n        return step.Name\r\n    end\r\n\r\n    local function countPhysicalInInventoryAndWorld(step)\r\n        local count = 0\r\n        local names = {step.Name, step.Name .. \" Blueprint\"}\r\n        for _, alias in ipairs(step.Aliases or {}) do\r\n            names[#names + 1] = alias\r\n            names[#names + 1] = alias .. \" Blueprint\"\r\n        end\r\n        local function checkContainer(container)\r\n            if not container then return end\r\n            for _, item in ipairs(_G.KixBuildIndex.Matching(container, names)) do\r\n                if item:IsA(\"Tool\") then\r\n                    local iName = item.Name\r\n                    local bpName = step.Name .. \" Blueprint\"\r\n                    if iName == step.Name or iName == bpName then\r\n                        count = count + 1\r\n                    elseif step.Aliases then\r\n                        for _, alias in ipairs(step.Aliases) do\r\n                            if iName == alias or iName == (alias .. \" Blueprint\") then\r\n                                count = count + 1\r\n                                break\r\n                            end\r\n                        end\r\n                    end\r\n                end\r\n            end\r\n        end\r\n\r\n        if _LocalPlayer then\r\n            checkContainer(_LocalPlayer:FindFirstChild(\"Backpack\"))\r\n            checkContainer(_LocalPlayer.Character)\r\n        end\r\n\r\n        local structures = _Workspace:FindFirstChild(\"Structures\")\r\n        if structures then\r\n            for _, s in ipairs(_G.KixBuildIndex.Matching(structures, names)) do\r\n                local sName = s.Name\r\n                if sName == step.Name then\r\n                    count = count + 1\r\n                elseif step.Aliases then\r\n                    for _, alias in ipairs(step.Aliases) do\r\n                        if sName == alias then\r\n                            count = count + 1\r\n                            break\r\n                        end\r\n                    end\r\n                end\r\n            end\r\n        end\r\n\r\n        return count\r\n    end\r\n\r\n    local function isStepCompleted(step)\r\n        local currentTier = getBenchTier()\r\n        local itemFolder = getItemFolder(step)\r\n\r\n        -- 1. Bench Upgrades\r\n        if step.IsUpgrade then\r\n            if currentTier >= step.TargetTier then\r\n                return true\r\n            end\r\n            if itemFolder and itemFolder:GetAttribute(\"SoldOut\") == true then\r\n                return true\r\n            end\r\n            return false\r\n        end\r\n\r\n        -- 2. Items with a specific TargetCount (Bear Trap: 3, Lightning Rod: 3, Teleporter: 2)\r\n        if step.TargetCount then\r\n            local bought = sessionBought[step.Name] or 0\r\n            if bought >= step.TargetCount then\r\n                return true\r\n            end\r\n\r\n            -- Check Bear Trap table limit\r\n            if step.Name == \"Bear Trap\" and itemFolder then\r\n                local limit = itemFolder:GetAttribute(\"Limit\")\r\n                if limit ~= nil and (8 - limit) >= step.TargetCount then\r\n                    return true\r\n                end\r\n            end\r\n\r\n            local physicalCount = countPhysicalInInventoryAndWorld(step)\r\n            if physicalCount >= step.TargetCount then\r\n                return true\r\n            end\r\n\r\n            if itemFolder and itemFolder:GetAttribute(\"SoldOut\") == true then\r\n                return true\r\n            end\r\n\r\n            return false\r\n        end\r\n\r\n        -- 3. Farm Plot (Limit 20) & Torch (Limit 10)\r\n        if step.Limit and step.Limit > 1 then\r\n            if itemFolder and itemFolder:GetAttribute(\"SoldOut\") == true then\r\n                return true\r\n            end\r\n            if itemFolder then\r\n                local limit = itemFolder:GetAttribute(\"Limit\")\r\n                if limit ~= nil and limit <= 0 then\r\n                    return true\r\n                end\r\n            end\r\n            local physicalCount = countPhysicalInInventoryAndWorld(step)\r\n            local bought = sessionBought[step.Name] or 0\r\n            if math.max(physicalCount, bought) >= step.Limit then\r\n                return true\r\n            end\r\n            return false\r\n        end\r\n\r\n        -- 4. Single-purchase items (\"Sampai Sold Out\")\r\n        if itemFolder and itemFolder:GetAttribute(\"SoldOut\") == true then\r\n            return true\r\n        end\r\n\r\n        local bought = sessionBought[step.Name] or 0\r\n        if bought >= 1 then\r\n            return true\r\n        end\r\n\r\n        local physicalCount = countPhysicalInInventoryAndWorld(step)\r\n        if physicalCount >= 1 then\r\n            return true\r\n        end\r\n\r\n        -- Map specific check\r\n        if step.Name == \"Map\" then\r\n            if _LocalPlayer and _LocalPlayer:GetAttribute(\"HasMap\") == true then\r\n                return true\r\n            end\r\n            local pGui = _LocalPlayer and _LocalPlayer:FindFirstChild(\"PlayerGui\")\r\n            if pGui and pGui:FindFirstChild(\"Map\") then\r\n                return true\r\n            end\r\n        end\r\n\r\n        -- Compass specific check\r\n        if step.Name == \"Compass\" then\r\n            local pGui = _LocalPlayer and _LocalPlayer:FindFirstChild(\"PlayerGui\")\r\n            if pGui and pGui:FindFirstChild(\"Compass\") then\r\n                return true\r\n            end\r\n        end\r\n\r\n        return false\r\n    end\r\n\r\n    local function canAfford(step, itemFolder, campground)\r\n        if not campground then return false end\r\n\r\n        local scrapPrice = (itemFolder and itemFolder:GetAttribute(\"ScrapPrice\")) or step.ScrapPrice or 0\r\n        local woodPrice = (itemFolder and itemFolder:GetAttribute(\"WoodPrice\")) or step.WoodPrice or 0\r\n        local gemPrice = (itemFolder and itemFolder:GetAttribute(\"GemPrice\")) or step.GemPrice or 0\r\n        local greenGemPrice = (itemFolder and itemFolder:GetAttribute(\"GreenGemPrice\")) or step.GreenGemPrice or 0\r\n\r\n        local totalScrap = campground:GetAttribute(\"TotalScrap\") or 0\r\n        local totalWood = campground:GetAttribute(\"TotalWood\") or 0\r\n        local totalGems = campground:GetAttribute(\"TotalGems\") or 0\r\n        local totalGreenGems = campground:GetAttribute(\"TotalGreenGems\") or 0\r\n\r\n        if woodPrice > 0 and totalWood < woodPrice then return false end\r\n        if scrapPrice > 0 and totalScrap < scrapPrice then return false end\r\n        if gemPrice > 0 and totalGems < gemPrice then return false end\r\n        if greenGemPrice > 0 and totalGreenGems < greenGemPrice then return false end\r\n\r\n        return true\r\n    end\r\n\r\n    local function buyVerified(step, craftRemote, nameToBuy, itemFolder)\r\n        return _G.KixBuildTransactions.Run(\"Buy\", function() return AutoBuy.Enabled end, function()\r\n            -- Recheck after waiting for placement to release the transaction slot.\r\n            if isStepCompleted(step) then return false, \"AlreadyComplete\" end\r\n            if not canAfford(step, itemFolder, getCampground()) then return false, \"Materials\" end\r\n            local beforeCount = countPhysicalInInventoryAndWorld(step)\r\n            local beforeTier = getBenchTier()\r\n            local beforeLimit = itemFolder and itemFolder:GetAttribute(\"Limit\")\r\n            local ok, result = pcall(function() return craftRemote:InvokeServer(nameToBuy) end)\r\n            if ok and (result == false or (type(result) == \"table\" and result.Success == false)) then\r\n                return false, \"Rejected\"\r\n            end\r\n            if ok and (result == true or (type(result) == \"table\" and result.Success == true)) then return true end\r\n            -- Nil/unknown responses need replicated evidence, not a blind retry.\r\n            for attempt = 1, 6 do\r\n                task.wait(0.25)\r\n                local afterLimit = itemFolder and itemFolder:GetAttribute(\"Limit\")\r\n                if countPhysicalInInventoryAndWorld(step) > beforeCount\r\n                    or (step.IsUpgrade and getBenchTier() > beforeTier)\r\n                    or (itemFolder and itemFolder:GetAttribute(\"SoldOut\") == true)\r\n                    or (type(beforeLimit) == \"number\" and type(afterLimit) == \"number\" and afterLimit < beforeLimit)\r\n                    or (step.Name == \"Map\" and _LocalPlayer:GetAttribute(\"HasMap\") == true) then\r\n                    return true\r\n                end\r\n            end\r\n            AutoBuy.Enabled = false\r\n            _G.KixEngines.Errors.AutoBuy = \"Purchase unconfirmed: \" .. nameToBuy .. \"; inspect inventory before enabling Auto Buy again\"\r\n            warn(\"[AutoBuy] \" .. _G.KixEngines.Errors.AutoBuy)\r\n            return false, \"Unconfirmed\"\r\n        end)\r\n    end\r\n\r\n    local function startAutoBuy()\r\n        if AutoBuy.Enabled then return end\r\n        if (_G.KixEngines.TaskCounts.AutoBuy or 0) > 0 then\r\n            warn(\"[AutoBuy] Previous transaction is still finishing; retry shortly\")\r\n            return\r\n        end\r\n        _G.KixEngines.Errors.AutoBuy = nil\r\n        AutoBuy.Enabled = true\r\n\r\n        autoBuyThread = _G.KixEngines.Spawn(\"AutoBuy\", function()\r\n            while AutoBuy.Enabled do\r\n                while AutoBuy.Enabled and memoryClearActive() do task.wait(0.1) end\r\n                if not AutoBuy.Enabled then break end\r\n                local purchased = false\r\n                local currentTier = getBenchTier()\r\n                local campground = getCampground()\r\n                local craftRemote = getCraftRemote()\r\n                for _, step in ipairs(BUY_SEQUENCE) do\r\n                    if not AutoBuy.Enabled or memoryClearActive() then break end\r\n                    local fullAuto = _G.KixFullAuto\r\n                    if fullAuto and fullAuto.Active\r\n                        and type(fullAuto.ShouldSkipStructure) == \"function\"\r\n                        and fullAuto.ShouldSkipStructure(step.Name) then\r\n                        continue\r\n                    end\r\n                    -- Skip locked/unaffordable entries before scanning inventory/world counts.\r\n                    if currentTier < step.RequiredTier then continue end\r\n                    local itemFolder = getItemFolder(step)\r\n                    if not canAfford(step, itemFolder, campground) then continue end\r\n                    if isStepCompleted(step) then continue end\r\n                    if not craftRemote then break end\r\n                    local nameToBuy = getItemCraftName(step, itemFolder)\r\n                    local success, reason = buyVerified(step, craftRemote, nameToBuy, itemFolder)\r\n                    if success then\r\n                        sessionBought[step.Name] = (sessionBought[step.Name] or 0) + 1\r\n                        purchased = true\r\n                        if WindUI and os.clock() >= (AutoBuy.NextNoticeAt or 0) then\r\n                            AutoBuy.NextNoticeAt = os.clock() + 5\r\n                            WindUI:Notify({Title = \"Auto Buy\", Content = \"Purchased \" .. nameToBuy .. \" (\" .. step.Step .. \"/27)\", Duration = 2})\r\n                        end\r\n                        break -- Refresh material/tier state before the next purchase.\r\n                    end\r\n                    if reason == \"Cancelled\" or reason == \"Unconfirmed\" then break end\r\n                    -- A rejected item does not block other affordable items.\r\n                    task.wait(0.15)\r\n                end\r\n                local delay = purchased and (AutoBuy.PurchaseCooldown + AutoBuy.CheckDelay) or 10\r\n                _G.KixAutoBuyStatus = purchased and \"Purchased; checking next affordable item\" or \"Waiting: no purchase available; next check in 10 seconds\"\r\n                -- Keep the wait light while allowing skip-selection changes to wake the next pass.\r\n                local elapsed = 0\r\n                local skipRevision = _G.KixFullAutomationSkipRevision or 0\r\n                while AutoBuy.Enabled and elapsed < delay do\r\n                    if (_G.KixFullAutomationSkipRevision or 0) ~= skipRevision then break end\r\n                    if memoryClearActive() then\r\n                        task.wait(0.1)\r\n                    else\r\n                        elapsed = elapsed + task.wait(math.min(0.25, delay - elapsed))\r\n                    end\r\n                end\r\n            end\r\n        end)\r\n    end\r\n\r\n    local function stopAutoBuy()\r\n        AutoBuy.Enabled = false\r\n        -- Never cancel an in-flight InvokeServer; its result may still arrive.\r\n        -- Worker exits at the next loop boundary; task accounting blocks overlap.\r\n        if AutoBuyCraftingBenchToggle and AutoBuyCraftingBenchToggle.SetValue then\r\n            AutoBuyCraftingBenchToggle:SetValue(false)\r\n        end\r\n    end\r\n\r\n    _G.ToggleAutoBuyCraftingBench = function(val)\r\n        if val == false and _G.KixFullAuto then\r\n            _G.KixFullAuto.Owned.AutoBuy = nil\r\n            if _G.KixFullAuto.Suspended then _G.KixFullAuto.Suspended.AutoBuy = nil end\r\n        end\r\n        if AutoBuy.Enabled == val then return end\r\n        if val then\r\n            startAutoBuy()\r\n            if WindUI then\r\n                WindUI:Notify({\r\n                    Title = \"Auto Buy\",\r\n                    Content = \"Auto Buy on Crafting Bench enabled.\",\r\n                    Duration = 3\r\n                })\r\n            end\r\n        else\r\n            stopAutoBuy()\r\n            if WindUI then\r\n                WindUI:Notify({\r\n                    Title = \"Auto Buy\",\r\n                    Content = \"Auto Buy on Crafting Bench disabled.\",\r\n                    Duration = 3\r\n                })\r\n            end\r\n        end\r\n    end\r\n\r\n    _G.KixAdapters = _G.KixAdapters or {}\r\n    _G.KixEngines.AutoBuy = function(value)\r\n        if value then startAutoBuy() else stopAutoBuy() end\r\n    end\r\n    _G.KixAdapters.AutoBuy = {\r\n        IsEnabled = function()\r\n            return AutoBuy.Enabled == true\r\n        end,\r\n        SetState = function(state)\r\n        return _G.KixEngines.AutoBuy(state)\r\n    end\r\n    }\r\n\r\n    local origCleanupAB = getgenv().KixHubCleanup\r\n    getgenv().KixHubCleanup = function()\r\n        stopAutoBuy()\r\n        if origCleanupAB then origCleanupAB() end\r\n    end\r\nend; INIT_AUTO_BUY_CRAFTING_BENCH() end\r\n\r\n-- ==================== SOUND SYSTEM (EXTERNAL SCRIPT EXECUTION) ====================\r\ndo\r\nif getgenv().KixMuteSoundExecuting == nil then\r\n    getgenv().KixMuteSoundExecuting = false\r\nend\r\n_G.KixExecuteMuteSound = function()\r\n    if getgenv().KixMuteSoundExecuting then return end\r\n    getgenv().KixMuteSoundExecuting = true\r\n    \r\n    task.spawn(function()\r\n        pcall(function()\r\n            -- 1. Anti-Double: Cleanup instance lama jika jendela external sudah terbuka\r\n            if getgenv().MuteSoundCleanup and type(getgenv().MuteSoundCleanup) == \"function\" then\r\n                pcall(getgenv().MuteSoundCleanup)\r\n                getgenv().MuteSoundCleanup = nil\r\n            end\r\n            if getgenv().MuteSoundScreenGui and getgenv().MuteSoundScreenGui.Parent then\r\n                pcall(function() getgenv().MuteSoundScreenGui:Destroy() end)\r\n                getgenv().MuteSoundScreenGui = nil\r\n            end\r\n            \r\n            -- Cari dan bersihkan ScreenGui lama di CoreGui, gethui, dan PlayerGui\r\n            local containers = {}\r\n            local okCore, coreGui = pcall(function() return game:GetService(\"CoreGui\") end)\r\n            if okCore and coreGui then table.insert(containers, coreGui) end\r\n            \r\n            local okHui, hui = pcall(function() return type(gethui) == \"function\" and gethui() end)\r\n            if okHui and hui and not table.find(containers, hui) then table.insert(containers, hui) end\r\n            \r\n            local playerGui = _LocalPlayer and _LocalPlayer:FindFirstChild(\"PlayerGui\")\r\n            if playerGui and not table.find(containers, playerGui) then table.insert(containers, playerGui) end\r\n            \r\n            for _, container in ipairs(containers) do\r\n                for _, child in ipairs(container:GetChildren()) do\r\n                    if child:IsA(\"ScreenGui\") then\r\n                        local lowerName = string.lower(child.Name)\r\n                        if string.find(lowerName, \"mutesound\", 1, true) or string.find(lowerName, \"mute sound\", 1, true) or string.find(lowerName, \"mute_sound\", 1, true) then\r\n                            pcall(function() child:Destroy() end)\r\n                        end\r\n                    end\r\n                end\r\n            end\r\n            \r\n            -- Catat daftar ScreenGui yang sudah ada sebelum eksekusi\r\n            local beforeGuis = {}\r\n            for _, container in ipairs(containers) do\r\n                for _, child in ipairs(container:GetChildren()) do\r\n                    if child:IsA(\"ScreenGui\") then\r\n                        beforeGuis[child] = true\r\n                    end\r\n                end\r\n            end\r\n            \r\n            if WindUI then\r\n                WindUI:Notify({\r\n                    Title = \"Sound System\",\r\n                    Content = \"Executing Mute Sound external script...\",\r\n                    Duration = 2.5\r\n                })\r\n            end\r\n            \r\n            -- 2. Eksekusi script external dari URL yang diminta\r\n            local muteSoundUrl = \"https://rawcdn.githack.com/Kixdev/99NITF/ff3223824af5a4fc6862fee5071593e5b52b951f/mute-sound-99\"\r\n            local loadSuccess, loadErr = pcall(function()\r\n                loadstring(game:HttpGet(muteSoundUrl))()\r\n            end)\r\n            \r\n            if not loadSuccess then\r\n                if WindUI then\r\n                    WindUI:Notify({\r\n                        Title = \"Sound System Error\",\r\n                        Content = \"Failed to execute: \" .. tostring(loadErr),\r\n                        Duration = 4\r\n                    })\r\n                end\r\n            else\r\n                -- 3. Deteksi ScreenGui baru yang di-spawn agar bisa di-replace jika tombol ditekan kembali\r\n                task.delay(0.2, function()\r\n                    for _, container in ipairs(containers) do\r\n                        for _, child in ipairs(container:GetChildren()) do\r\n                            if child:IsA(\"ScreenGui\") and not beforeGuis[child] then\r\n                                getgenv().MuteSoundScreenGui = child\r\n                                break\r\n                            end\r\n                        end\r\n                    end\r\n                end)\r\n            end\r\n        end)\r\n        \r\n        task.wait(1)\r\n        getgenv().KixMuteSoundExecuting = false\r\n    end)\r\nend\r\n\r\nTabs.Vision:Section({Title = 'Sound System', Icon = 'volume-2'})\r\nTabs.Vision:Button({\r\n    Title = 'Mute Sound',\r\n    Desc = 'Mute Sound Effect (Hide UI Press Comma)',\r\n    Icon = 'volume-x',\r\n    Callback = _G.KixExecuteMuteSound\r\n})\r\nend\r\n\r\n-- ==================== SETTINGS (VISION) TAB ====================\r\n\r\nfbConn = nil\r\norigLighting = {}\r\n\r\nTabs.Vision:Section({Title = 'Vision', Icon = 'eye'})\r\nFullBrightToggle = Tabs.Vision:Toggle({\r\n    Title = 'Full Bright in Caves',\r\n    Desc = 'Lights up dark caves. Safely adapts to normal day/night lighting when turned off.',\r\n    Value = false,\r\n    Callback = function(val)\r\n        if val then\r\n            fbConn = _RunService.RenderStepped:Connect(function()\r\n                _Lighting.Ambient = Color3.fromRGB(255, 255, 255)\r\n                _Lighting.OutdoorAmbient = Color3.fromRGB(200, 200, 200)\r\n                _Lighting.ColorShift_Bottom = Color3.fromRGB(255, 255, 255)\r\n                _Lighting.ColorShift_Top = Color3.fromRGB(0, 0, 0)\r\n                _Lighting.Brightness = 3\r\n                _Lighting.GlobalShadows = false\r\n                _Lighting.ExposureCompensation = 0\r\n                _Lighting.FogEnd = 1e9\r\n                -- Biarkan ClockTime tetap berjalan agar siklus game normal\r\n            end)\r\n        else\r\n            if fbConn then \r\n      