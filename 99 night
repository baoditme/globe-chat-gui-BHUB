{"authorized":true,"unrestricted":true,"source":"-- KIX HUB - 99 Nights in the Forest\r\n-- Custom UI Refactored with NaN God Mode, Custom Bring, & Advanced Movement/Vision Logics\r\n\r\n-- Stop the legacy flower collector if this build replaces a running instance.\r\nautoCollectFlower = false\r\ngetgenv().autoCollectFlower = false\r\n_G.BringFlowerPausedByCombat = nil\r\n\r\nlocal KixHubSavedState = getgenv().KixHubSavedState\r\nif type(KixHubSavedState) ~= \"table\" then\r\n    KixHubSavedState = {}\r\n    getgenv().KixHubSavedState = KixHubSavedState\r\nend\r\n\r\n-- [ ANTI DOUBLE UI & CLEANUP ]\r\n\r\n_G.SafeVirtualClick = function(x, y)\r\n    local vim = game:GetService(\"VirtualInputManager\")\r\n    local uis = game:GetService(\"UserInputService\")\r\n    pcall(function()\r\n        if uis.TouchEnabled and not uis.MouseEnabled then\r\n            -- 0 = TouchBegan, 2 = TouchEnded. TouchId = 123456\r\n            vim:SendTouchEvent(123456, 0, x, y)\r\n            task.wait(0.05)\r\n            vim:SendTouchEvent(123456, 2, x, y)\r\n        else\r\n            vim:SendMouseButtonEvent(x, y, 0, true, nil, 0)\r\n            task.wait(0.05)\r\n            vim:SendMouseButtonEvent(x, y, 0, false, nil, 0)\r\n        end\r\n    end)\r\nend\r\n\r\nif getgenv().KixHubCleanup then\r\n    if not pcall(function() getgenv().KixHubCleanup() end) then\r\n        warn(\"Previous cleanup is pending; retry after its operation finishes.\")\r\n        return\r\n    end\r\nend\r\n\r\n_G.AlienTechCombatEnabled = false\r\n\r\n-- Clean up the temporary camera proxy used by the previous revision.\r\nif type(_G.KixStopSmoothSpectateCamera) == \"function\" then\r\n    pcall(_G.KixStopSmoothSpectateCamera)\r\n    local camera = workspace.CurrentCamera\r\n    local character = game:GetService(\"Players\").LocalPlayer.Character\r\n    local humanoid = character and character:FindFirstChildOfClass(\"Humanoid\")\r\n    if camera and humanoid then camera.CameraSubject = humanoid end\r\nend\r\n_G.KixStopSmoothSpectateCamera = nil\r\n_G.KixSmoothSpectateCamera = nil\r\n_G.KixSmoothCameraSource = nil\r\n\r\n-- WindUI uses shared ScreenGui names, so only remove roots tagged by KixDev.\r\nlocal function clearStaleKixHubWindUI()\r\n    local coreGui = game:GetService(\"CoreGui\")\r\n    local roots = {coreGui}\r\n    local container = coreGui:FindFirstChild(\"Container\")\r\n    if container then roots[#roots + 1] = container end\r\n    pcall(function()\r\n        local hiddenGui = gethui and gethui()\r\n        if hiddenGui then roots[#roots + 1] = hiddenGui end\r\n    end)\r\n\r\n    local seen = {}\r\n    for _, root in ipairs(roots) do\r\n        for _, gui in ipairs(root:GetChildren()) do\r\n            if gui:IsA(\"ScreenGui\") and gui:GetAttribute(\"KixHubOwner\") == \"KIXDEV\" and not seen[gui] then\r\n                seen[gui] = true\r\n                pcall(function() gui:Destroy() end)\r\n            end\r\n        end\r\n    end\r\nend\r\npcall(clearStaleKixHubWindUI)\r\n-- Remove a preview left in Workspace by a prior execution whose cleanup was interrupted.\r\npcall(function()\r\n    local stalePreview = workspace:FindFirstChild(\"KixPreviewContainer\")\r\n    if stalePreview then stalePreview:Destroy() end\r\nend)\r\n\r\n-- Live execution token: background loops must not survive a hub reload.\r\nlocal KixHubSession = {Alive = true}\r\ngetgenv().KixHubSession = KixHubSession\r\n_G.KixEngines = {Tokens = {}, TaskCounts = {}, Errors = {}, WorkerStats = {}}\r\n_G.KixBuildTransactions = {Owner = nil, ReadyAt = 0}\r\n-- Share short-lived name indexes across buying and placement. No idle worker.\r\n_G.KixBuildIndex = {Containers = setmetatable({}, {__mode = \"k\"})}\r\nfunction _G.KixBuildIndex.Matching(container, names)\r\n    if not container then return {} end\r\n    local cache = _G.KixBuildIndex.Containers[container]\r\n    local now = os.clock()\r\n    if not cache or now - cache.At >= 0.25 then\r\n        cache = {At = now, Names = {}}\r\n        for _, child in ipairs(container:GetChildren()) do\r\n            local bucket = cache.Names[child.Name]\r\n            if not bucket then bucket = {}; cache.Names[child.Name] = bucket end\r\n            bucket[#bucket + 1] = child\r\n        end\r\n        _G.KixBuildIndex.Containers[container] = cache\r\n    end\r\n    local result, seen = {}, {}\r\n    for _, name in ipairs(names) do\r\n        for _, child in ipairs(cache.Names[name] or {}) do\r\n            if child.Parent == container and child.Name == name and not seen[child] then\r\n                seen[child] = true\r\n                result[#result + 1] = child\r\n            end\r\n        end\r\n    end\r\n    return result\r\nend\r\n-- Opt-in diagnostics: counters only in hot paths; one console summary every five seconds.\r\n_G.KixPerfDebug = {\r\n    Enabled = false, Token = 0, Counts = {}, Durations = {}, WorkerCounts = {},\r\n    WorkerByThread = setmetatable({}, {__mode = \"k\"})\r\n}\r\nfunction _G.KixPerfDebug.Count(name)\r\n    local d = _G.KixPerfDebug\r\n    if d.Enabled then\r\n        d.Counts[name] = (d.Counts[name] or 0) + 1\r\n        local workerName = d.WorkerByThread[coroutine.running()]\r\n        if workerName then\r\n            local counts = d.WorkerCounts[workerName]\r\n            if not counts then counts = {}; d.WorkerCounts[workerName] = counts end\r\n            counts[name] = (counts[name] or 0) + 1\r\n        end\r\n    end\r\nend\r\nfunction _G.KixPerfDebug.Event(kind, detail)\r\n    if _G.KixPerfDebug.Enabled then\r\n        print(string.format(\"[KixPerf][%s][%s] %s\", os.date(\"%H:%M:%S\"), kind, tostring(detail)))\r\n    end\r\nend\r\nfunction _G.KixPerfDebug.Set(value)\r\n    local d = _G.KixPerfDebug\r\n    value = value == true\r\n    if d.Enabled == value then return end\r\n    d.Enabled = value\r\n    d.Token = d.Token + 1\r\n    if d.Connection then d.Connection:Disconnect(); d.Connection = nil end\r\n    if not value then print(\"[KixPerf] Debug disabled\"); return end\r\n    d.Counts, d.Durations, d.WorkerCounts = {}, {}, {}\r\n    d.Frames, d.FrameTime, d.MaxFrame = 0, 0, 0\r\n    local token = d.Token\r\n    d.Connection = game:GetService(\"RunService\").RenderStepped:Connect(function(dt)\r\n        d.Frames = d.Frames + 1\r\n        d.FrameTime = d.FrameTime + dt\r\n        d.MaxFrame = math.max(d.MaxFrame, dt)\r\n    end)\r\n    d.Event(\"START\", \"5-second samples; operation times include server waits, not CPU time\")\r\n    task.spawn(function()\r\n        while d.Enabled and token == d.Token do\r\n            task.wait(5)\r\n            if not d.Enabled or token ~= d.Token then break end\r\n            local fps = d.FrameTime > 0 and d.Frames / d.FrameTime or 0\r\n            local worst = d.MaxFrame * 1000\r\n            d.Frames, d.FrameTime, d.MaxFrame = 0, 0, 0\r\n            local counts, durations = d.Counts, d.Durations\r\n            d.Counts, d.Durations = {}, {}\r\n            local workers, activity = {}, {}\r\n            local workerNames = {}\r\n            for name in pairs(_G.KixEngines.TaskCounts) do workerNames[name] = true end\r\n            for name in pairs(_G.KixEngines.WorkerStats) do workerNames[name] = true end\r\n            for name in pairs(workerNames) do\r\n                local count = _G.KixEngines.TaskCounts[name] or 0\r\n                local stats = _G.KixEngines.WorkerStats[name] or {}\r\n                local oldest = 0\r\n                for _, startedAt in pairs(stats.Live or {}) do\r\n                    oldest = math.max(oldest, os.clock() - startedAt)\r\n                end\r\n                local workerActivity = {}\r\n                for activityName, activityCount in pairs(d.WorkerCounts[name] or {}) do\r\n                    workerActivity[#workerActivity + 1] = activityName .. \":\" .. activityCount\r\n                end\r\n                table.sort(workerActivity)\r\n                workers[#workers + 1] = string.format(\r\n                    \"%s{active=%d,starts=%d,max=%d,errors=%d,oldest=%.0fs,ops={%s}}\",\r\n                    name, count, stats.Starts or 0, stats.MaxActive or 0,\r\n                    stats.Errors or 0, oldest, table.concat(workerActivity, \",\")\r\n                )\r\n                if stats.LastError then\r\n                    workers[#workers + 1] = name .. \"LastError=\" .. string.sub(stats.LastError, 1, 100)\r\n                end\r\n            end\r\n            for name, count in pairs(counts) do activity[#activity + 1] = name .. \"=\" .. count end\r\n            for name, seconds in pairs(durations) do\r\n                activity[#activity + 1] = string.format(\"%sElapsed=%.2fs\", name, seconds)\r\n            end\r\n            table.sort(workers); table.sort(activity)\r\n            d.WorkerCounts = {}\r\n            local f = _G.KixFullAuto\r\n            local items = workspace:FindFirstChild(\"Items\")\r\n            local structures = workspace:FindFirstChild(\"Structures\")\r\n            local player = game:GetService(\"Players\").LocalPlayer\r\n            local root = player.Character and player.Character:FindFirstChild(\"HumanoidRootPart\")\r\n            local position = root and string.format(\"%.0f,%.0f,%.0f\", root.Position.X, root.Position.Y, root.Position.Z) or \"missing\"\r\n            local line = string.format(\"FPS=%.1f | worstFrame=%.0fms | stage=%s/%s | pos=%s | items=%d structures=%d | workerDiagnostics={%s} | activity/5s={%s} | buildOwner=%s | buy=%s\",\r\n                fps, worst, tostring(f and f.Stage), tostring(f and f.State), position,\r\n                items and #items:GetChildren() or 0, structures and #structures:GetChildren() or 0,\r\n                table.concat(workers, \",\"), table.concat(activity, \",\"),\r\n                tostring(_G.KixBuildTransactions.Owner), tostring(_G.KixAutoBuyStatus))\r\n            if fps > 0 and fps < 20 then warn(\"[KixPerf][LOW_FPS] \" .. line)\r\n            else print(\"[KixPerf][SAMPLE] \" .. line) end\r\n        end\r\n    end)\r\nend\r\n\r\nfunction _G.KixBuildTransactions.Run(owner, active, action)\r\n    local state = _G.KixBuildTransactions\r\n    while state.Owner or os.clock() < state.ReadyAt do\r\n        if not active() then return false, \"Cancelled\" end\r\n        task.wait(0.1)\r\n    end\r\n    if not active() then return false, \"Cancelled\" end\r\n    state.Owner = owner\r\n    local debugStarted = _G.KixPerfDebug.Enabled and os.clock()\r\n    local debugToken = _G.KixPerfDebug.Token\r\n    if debugStarted then _G.KixPerfDebug.Count(owner .. \"Started\") end\r\n    local result = table.pack(pcall(action))\r\n    if debugStarted and _G.KixPerfDebug.Enabled and debugToken == _G.KixPerfDebug.Token then\r\n        _G.KixPerfDebug.Count(owner .. (result[1] and \"Finished\" or \"Error\"))\r\n        _G.KixPerfDebug.Durations[owner] = (_G.KixPerfDebug.Durations[owner] or 0) + os.clock() - debugStarted\r\n    end\r\n    -- Allow replication and rendering to settle before the next build operation.\r\n    state.ReadyAt = os.clock() + 0.5\r\n    table.clear(_G.KixBuildIndex.Containers)\r\n    state.Owner = nil\r\n    if not result[1] then error(result[2]) end\r\n    return table.unpack(result, 2, result.n)\r\nend\r\n_G.KixStartupFeatures = {Toggles = {}, Status = {}, States = {}}\r\nfunction _G.KixStartupFeatures.Set(name, value)\r\n    _G.KixEngines[name](value)\r\n    _G.KixStartupFeatures.States[name] = value == true\r\n    local status = _G.KixStartupFeatures.Status[name]\r\n    if status then status:SetDesc(value and \"Active — waiting for available targets/materials\" or \"Disabled\") end\r\nend\r\nfunction _G.KixEngines.Spawn(name, fn)\r\n    local engines = _G.KixEngines\r\n    local stats = engines.WorkerStats[name]\r\n    if not stats then\r\n        stats = {Starts = 0, Errors = 0, MaxActive = 0, Live = {}}\r\n        engines.WorkerStats[name] = stats\r\n    end\r\n    stats.Starts = stats.Starts + 1\r\n    local workerId = stats.Starts\r\n    local startedAt = os.clock()\r\n    stats.Live[workerId] = startedAt\r\n    engines.TaskCounts[name] = (engines.TaskCounts[name] or 0) + 1\r\n    stats.MaxActive = math.max(stats.MaxActive, engines.TaskCounts[name])\r\n    _G.KixPerfDebug.Event(\"WORKER_START\", name .. \" count=\" .. engines.TaskCounts[name])\r\n    return task.spawn(function()\r\n        local workerThread = coroutine.running()\r\n        _G.KixPerfDebug.WorkerByThread[workerThread] = name\r\n        local ok, err = xpcall(fn, function(e) return tostring(e) end)\r\n        _G.KixPerfDebug.WorkerByThread[workerThread] = nil\r\n        engines.TaskCounts[name] = engines.TaskCounts[name] - 1\r\n        stats.Live[workerId] = nil\r\n        stats.LastEndAt = os.clock()\r\n        stats.TotalRuntime = (stats.TotalRuntime or 0) + (stats.LastEndAt - startedAt)\r\n        _G.KixPerfDebug.Event(\"WORKER_END\", name .. (ok and \" completed\" or (\" error=\" .. tostring(err))))\r\n        if not ok then\r\n            stats.Errors = stats.Errors + 1\r\n            stats.LastError = tostring(err)\r\n            stats.LastErrorAt = stats.LastEndAt\r\n            engines.Errors[name] = err\r\n            warn(\"[KixEngine \" .. name .. \"] \" .. err)\r\n        end\r\n    end)\r\nend\r\nlocal _Players = game:GetService(\"Players\")\r\nlocal _ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\r\nlocal _Workspace = game:GetService(\"Workspace\")\r\n\r\nlocal _LocalPlayer = _Players.LocalPlayer\r\n\r\n_G.KixItemsIndex = {\r\n    Folder = nil,\r\n    Items = {},\r\n    Indices = setmetatable({}, {__mode = \"k\"}),\r\n    ByName = {},\r\n    NameByItem = setmetatable({}, {__mode = \"k\"}),\r\n    RecipeByItem = setmetatable({}, {__mode = \"k\"}),\r\n    RecipeNameCounts = {},\r\n    ItemConnections = setmetatable({}, {__mode = \"k\"}),\r\n    AddedConnection = nil,\r\n    RemovedConnection = nil,\r\n    Disabled = false\r\n}\r\nlocal function kixIndexRecipeName(cache, name, delta)\r\n    if not name then return end\r\n    local count = math.max(0, (cache.RecipeNameCounts[name] or 0) + delta)\r\n    if count == 0 then cache.RecipeNameCounts[name] = nil\r\n    else cache.RecipeNameCounts[name] = count end\r\nend\r\nlocal function kixUnindexItemName(cache, item)\r\n    local oldName = cache.NameByItem[item]\r\n    if oldName then\r\n        local bucket = cache.ByName[oldName]\r\n        local index = bucket and bucket.Indices[item]\r\n        if index then\r\n            local lastIndex = #bucket.Items\r\n            local lastItem = bucket.Items[lastIndex]\r\n            bucket.Items[index] = lastItem\r\n            bucket.Items[lastIndex] = nil\r\n            bucket.Indices[item] = nil\r\n            if lastItem and lastItem ~= item then bucket.Indices[lastItem] = index end\r\n            if lastIndex == 1 then cache.ByName[oldName] = nil end\r\n        end\r\n        cache.NameByItem[item] = nil\r\n    end\r\n    local recipeName = cache.RecipeByItem[item]\r\n    if recipeName then\r\n        kixIndexRecipeName(cache, recipeName, -1)\r\n        cache.RecipeByItem[item] = nil\r\n    end\r\nend\r\nlocal function kixIndexItemName(cache, item)\r\n    local name = item.Name\r\n    local bucket = cache.ByName[name]\r\n    if not bucket then\r\n        bucket = {Items = {}, Indices = setmetatable({}, {__mode = \"k\"})}\r\n        cache.ByName[name] = bucket\r\n    end\r\n    if not bucket.Indices[item] then\r\n        bucket.Items[#bucket.Items + 1] = item\r\n        bucket.Indices[item] = #bucket.Items\r\n    end\r\n    cache.NameByItem[item] = name\r\n    if item:GetAttribute(\"UpgradesRecipe\") ~= nil then\r\n        cache.RecipeByItem[item] = name\r\n        kixIndexRecipeName(cache, name, 1)\r\n    end\r\nend\r\nlocal function kixWatchIndexedItem(cache, item)\r\n    if cache.Indices[item] then return end\r\n    cache.Items[#cache.Items + 1] = item\r\n    cache.Indices[item] = #cache.Items\r\n    kixIndexItemName(cache, item)\r\n    cache.ItemConnections[item] = {\r\n        item:GetPropertyChangedSignal(\"Name\"):Connect(function()\r\n            if cache.Folder and item.Parent == cache.Folder then\r\n                kixUnindexItemName(cache, item)\r\n                kixIndexItemName(cache, item)\r\n            end\r\n        end),\r\n        item:GetAttributeChangedSignal(\"UpgradesRecipe\"):Connect(function()\r\n            if cache.Folder and item.Parent == cache.Folder then\r\n                kixUnindexItemName(cache, item)\r\n                kixIndexItemName(cache, item)\r\n            end\r\n        end),\r\n    }\r\nend\r\nfunction _G.KixItemsIndex.Get()\r\n    local cache = _G.KixItemsIndex\r\n    if cache.Disabled then return nil, cache.Items end\r\n    local folder = workspace:FindFirstChild(\"Items\") or workspace:FindFirstChild(\"items\")\r\n    if cache.Folder ~= folder then\r\n        if cache.AddedConnection then cache.AddedConnection:Disconnect() end\r\n        if cache.RemovedConnection then cache.RemovedConnection:Disconnect() end\r\n        cache.AddedConnection = nil\r\n        cache.RemovedConnection = nil\r\n        for _, connections in pairs(cache.ItemConnections) do\r\n            for _, connection in ipairs(connections) do connection:Disconnect() end\r\n        end\r\n        cache.ItemConnections = setmetatable({}, {__mode = \"k\"})\r\n        cache.Folder = folder\r\n        table.clear(cache.Items)\r\n        table.clear(cache.Indices)\r\n        cache.ByName = {}\r\n        cache.NameByItem = setmetatable({}, {__mode = \"k\"})\r\n        cache.RecipeByItem = setmetatable({}, {__mode = \"k\"})\r\n        cache.RecipeNameCounts = {}\r\n\r\n        if folder then\r\n            for _, item in ipairs(folder:GetChildren()) do\r\n                kixWatchIndexedItem(cache, item)\r\n            end\r\n\r\n            cache.AddedConnection = folder.ChildAdded:Connect(function(item)\r\n                kixWatchIndexedItem(cache, item)\r\n            end)\r\n            cache.RemovedConnection = folder.ChildRemoved:Connect(function(item)\r\n                local index = cache.Indices[item]\r\n                if not index then return end\r\n                kixUnindexItemName(cache, item)\r\n                local connections = cache.ItemConnections[item]\r\n                if connections then\r\n                    for _, connection in ipairs(connections) do connection:Disconnect() end\r\n                    cache.ItemConnections[item] = nil\r\n                end\r\n                local lastIndex = #cache.Items\r\n                local lastItem = cache.Items[lastIndex]\r\n                cache.Items[index] = lastItem\r\n                cache.Items[lastIndex] = nil\r\n                cache.Indices[item] = nil\r\n                if lastItem and lastItem ~= item then\r\n                    cache.Indices[lastItem] = index\r\n                end\r\n            end)\r\n        end\r\n    end\r\n    return folder, cache.Items\r\nend\r\nfunction _G.KixItemsIndex.GetByName(name)\r\n    local cache = _G.KixItemsIndex\r\n    if cache.Disabled then return nil end\r\n    _G.KixItemsIndex.Get()\r\n    return cache.ByName[name]\r\nend\r\n-- Shared, incremental farm cache: no permanent worker or event connections.\r\n_G.KixFarmCache = {Plots = {}, Slots = {}, Entries = {}, NextDiscovery = 0,\r\n    NextScan = 0, Cursor = 1, Claims = setmetatable({}, {__mode = \"k\"})}\r\n-- Traverse only the supplied plot or ingredient; never scan the map.\r\nfunction _G.KixFarmCache.Contents(root)\r\n    local contents = root:GetChildren()\r\n    local cursor = 1\r\n    while cursor <= #contents do\r\n        local object = contents[cursor]\r\n        for _, child in ipairs(object:GetChildren()) do contents[#contents + 1] = child end\r\n        cursor = cursor + 1\r\n    end\r\n    return contents\r\nend\r\nfunction _G.KixFarmCache.Get()\r\n    local cache = _G.KixFarmCache\r\n    local now = os.clock()\r\n    if now >= cache.NextDiscovery then\r\n        cache.NextDiscovery = now + 5\r\n        local plots, live = {}, {}\r\n        local structures = workspace:FindFirstChild(\"Structures\")\r\n        if structures then\r\n            for _, object in ipairs(structures:GetChildren()) do\r\n                if object.Name == \"Farm Plot\" then\r\n                    plots[#plots + 1] = object\r\n                    live[object] = true\r\n                end\r\n            end\r\n        end\r\n        for plot in pairs(cache.Slots) do\r\n            if not live[plot] then cache.Slots[plot] = nil end\r\n        end\r\n        cache.Plots = plots\r\n    end\r\n    if now >= cache.NextScan and #cache.Plots > 0 then\r\n        cache.NextScan = now + 0.1\r\n        if cache.Cursor > #cache.Plots then cache.Cursor = 1 end\r\n        local plot = cache.Plots[cache.Cursor]\r\n        cache.Cursor = cache.Cursor + 1\r\n        local entries = {}\r\n        if plot.Parent then\r\n            -- Refresh one plot per call instead of traversing every farm at once.\r\n            for _, object in ipairs(_G.KixFarmCache.Contents(plot)) do\r\n                if object:IsA(\"ProximityPrompt\") then\r\n                    local ancestor, crop = object.Parent, nil\r\n                    while ancestor and ancestor ~= plot do\r\n                        if ancestor:IsA(\"Model\") and (ancestor.Name == \"Pumpkin\"\r\n                            or ancestor.Name == \"Carrot\" or ancestor.Name == \"Corn\"\r\n                            or ancestor.Name == \"Apple\") then crop = ancestor; break end\r\n                        ancestor = ancestor.Parent\r\n                    end\r\n                    entries[#entries + 1] = {Prompt = object, Plot = plot, Crop = crop}\r\n                end\r\n            end\r\n        end\r\n        cache.Slots[plot] = entries\r\n    end\r\n    table.clear(cache.Entries)\r\n    for plot, entries in pairs(cache.Slots) do\r\n        if plot.Parent then\r\n            for _, entry in ipairs(entries) do\r\n                if entry.Prompt.Parent and entry.Prompt:IsDescendantOf(plot) then\r\n                    cache.Entries[#cache.Entries + 1] = entry\r\n                end\r\n            end\r\n        end\r\n    end\r\n    if not cache.Refreshing and now >= (cache.NextRefresh or 0) and #cache.Plots > 0 then\r\n        cache.Refreshing = true\r\n        cache.NextRefresh = now + 5\r\n        local remaining = #cache.Plots\r\n        task.defer(function()\r\n            -- Complete one bounded refresh over several frames, then stop.\r\n            for _ = 1, remaining do\r\n                task.wait(0.12)\r\n                _G.KixFarmCache.Get()\r\n            end\r\n            cache.Refreshing = false\r\n        end)\r\n    end\r\n    return cache.Entries\r\nend\r\nfunction _G.KixFarmCache.Available(prompt)\r\n    return prompt.Parent and prompt.Enabled\r\n        and os.clock() >= (_G.KixFarmCache.Claims[prompt] or 0)\r\nend\r\nfunction _G.KixFarmCache.Claim(prompt)\r\n    if not _G.KixFarmCache.Available(prompt) then return false end\r\n    _G.KixPerfDebug.Count(\"HarvestClaim\")\r\n    _G.KixFarmCache.Claims[prompt] = os.clock() + 3\r\n    return true\r\nend\r\n\r\nfunction _G.KixItemsIndex.Reset()\r\n    local cache = _G.KixItemsIndex\r\n    if cache.AddedConnection then cache.AddedConnection:Disconnect() end\r\n    if cache.RemovedConnection then cache.RemovedConnection:Disconnect() end\r\n    for _, connections in pairs(cache.ItemConnections) do\r\n        for _, connection in ipairs(connections) do connection:Disconnect() end\r\n    end\r\n    cache.AddedConnection = nil\r\n    cache.RemovedConnection = nil\r\n    cache.Folder = nil\r\n    table.clear(cache.Items)\r\n    table.clear(cache.Indices)\r\n    cache.ByName = {}\r\n    cache.NameByItem = setmetatable({}, {__mode = \"k\"})\r\n    cache.RecipeByItem = setmetatable({}, {__mode = \"k\"})\r\n    cache.RecipeNameCounts = {}\r\n    cache.ItemConnections = setmetatable({}, {__mode = \"k\"})\r\n    cache.Disabled = true\r\nend\r\n\r\ngetgenv().AdminUserIds = {\r\n    [\"2030610205\"] = true,\r\n    [\"10918419648\"] = true\r\n}\r\ngetgenv().IsAdmin = function(uid)\r\n    return getgenv().AdminUserIds[tostring(uid)]\r\nend\r\ngetgenv().IsSelfAdmin = getgenv().IsAdmin(_LocalPlayer.UserId)\r\n\r\n\r\n-- =========================================================\r\n-- NATIVE FURNITURE TRADER BUTTON\r\n-- Uses the game's original Furniture button\r\n-- =========================================================\r\n\r\nlocal function getNativeFurnitureButton()\r\n    local playerGui = _LocalPlayer:FindFirstChild(\"PlayerGui\")\r\n    if not playerGui then\r\n        return nil\r\n    end\r\n\r\n    local interface = playerGui:FindFirstChild(\"Interface\")\r\n    if not interface then\r\n        return nil\r\n    end\r\n\r\n    local topRight = interface:FindFirstChild(\"TopRight\")\r\n    if not topRight then\r\n        return nil\r\n    end\r\n\r\n    local frame = topRight:FindFirstChild(\"Frame\")\r\n    if not frame then\r\n        return nil\r\n    end\r\n\r\n    return frame:FindFirstChild(\"Furniture\")\r\nend\r\n\r\n\r\nlocal function hasFurnitureTrader()\r\n    local characters = _Workspace:FindFirstChild(\"Characters\")\r\n\r\n    if not characters then\r\n        return false\r\n    end\r\n\r\n    return characters:FindFirstChild(\"Furniture Trader\") ~= nil\r\nend\r\n\r\n\r\n-- Selalu aktif sejak script dijalankan\r\ntask.spawn(function()\r\n\r\n    while KixHubSession.Alive and task.wait(0.2) do\r\n\r\n        local furnitureButton = getNativeFurnitureButton()\r\n\r\n        if furnitureButton then\r\n            furnitureButton.Visible = hasFurnitureTrader()\r\n        end\r\n\r\n    end\r\n\r\nend)\r\n\r\nif not _LocalPlayer then\r\n    _Players:GetPropertyChangedSignal(\"LocalPlayer\"):Wait()\r\n    _LocalPlayer = _Players.LocalPlayer\r\nend\r\n\r\n-- Client module dari game\r\nlocal Client = require(\r\n    _LocalPlayer:WaitForChild(\"PlayerScripts\"):WaitForChild(\"Client\")\r\n)\r\n\r\n-- [ ANTI-CHEAT SPOOF BYPASS ]\r\nisSpoofedModel = false\r\npcall(function()\r\n    if _LocalPlayer and _LocalPlayer:IsA(\"Model\") then\r\n        isSpoofedModel = true\r\n    end\r\nend)\r\n\r\nif isSpoofedModel then\r\n    local realPlayer = nil\r\n    \r\n    if _LocalPlayer then\r\n        pcall(function() realPlayer = _Players:GetPlayerFromCharacter(_LocalPlayer) end)\r\n    end\r\n    \r\n    if not realPlayer then\r\n        pcall(function()\r\n            local charName = _LocalPlayer and pcall(function() return _LocalPlayer.Name end) and _LocalPlayer.Name or \"\"\r\n            for _, p in ipairs(_Players:GetPlayers()) do\r\n                if p.Name == charName then\r\n                    realPlayer = p\r\n                    break\r\n                end\r\n            end\r\n            \r\n            -- Absolute fallback for LocalPlayer crash: just get the first player\r\n            if not realPlayer then\r\n                local playersList = _Players:GetPlayers()\r\n                if #playersList == 1 then\r\n                    realPlayer = playersList[1]\r\n                end\r\n            end\r\n        end)\r\n    end\r\n    \r\n    if realPlayer then\r\n        _LocalPlayer = realPlayer\r\n    end\r\nend\r\nlocal _Lighting = game:GetService('Lighting')\r\nlocal _RunService = game:GetService('RunService')\r\nlocal _UserInputService = game:GetService('UserInputService')\r\nlocal _ProximityPromptService = game:GetService(\"ProximityPromptService\")\r\n\r\nlocal function GetPlayerDisplayListAndMap()\r\n    local list = {}\r\n    local map = {}\r\n    local displayCounts = {}\r\n    for _, p in ipairs(_Players:GetPlayers()) do\r\n        if p ~= _LocalPlayer then\r\n            displayCounts[p.DisplayName] = (displayCounts[p.DisplayName] or 0) + 1\r\n        end\r\n    end\r\n    for _, p in ipairs(_Players:GetPlayers()) do\r\n        if p ~= _LocalPlayer then\r\n            local nameToUse = p.DisplayName\r\n            if displayCounts[p.DisplayName] > 1 then\r\n                nameToUse = string.format(\"%s (@%s)\", p.DisplayName, p.Name)\r\n            end\r\n            table.insert(list, nameToUse)\r\n            map[nameToUse] = p.Name\r\n        end\r\n    end\r\n    table.sort(list)\r\n    return list, map\r\nend\r\n\r\n-- [ CORE SILENT SYSTEMS (EARLY INIT) ]\r\nautoReviveSelf = false\r\nreviveSelfLoopRunning = false\r\n\r\n_G.KixLoggingCampBlacklistCache = _G.KixLoggingCampBlacklistCache or {Initialized = false}\r\nif _G.KixLoggingCampBlacklistCache.Version ~= 6 then\r\n    _G.KixLoggingCampBlacklistCache.Initialized = false\r\n    _G.KixLoggingCampBlacklistCache.GrassFolder = nil\r\n    _G.KixLoggingCampBlacklistCache.HouseRoots = nil\r\n    _G.KixLoggingCampBlacklistCache.HouseGrassFolders = nil\r\n    _G.KixLoggingCampBlacklistCache.HouseBounds = nil\r\n    _G.KixLoggingCampBlacklistCache.HouseBoundsAt = nil\r\n    _G.KixLoggingCampBlacklistCache.HouseGrassFoldersAt = 0\r\n    _G.KixLoggingCampBlacklistCache.Version = 6\r\nend\r\n_G.KixIsHalloweenHousePumpkin = nil\r\n_G.KixIsPeltTraderGrassAsset = function(item)\r\n    if not item then return false end\r\n    local cache = _G.KixLoggingCampBlacklistCache\r\n    local now = os.clock()\r\n    if not cache.HouseGrassFolders or now - (cache.HouseGrassFoldersAt or 0) >= 2 then\r\n        local map = workspace:FindFirstChild(\"Map\")\r\n        local landmarks = map and map:FindFirstChild(\"Landmarks\")\r\n        local grassFolders = {}\r\n        if landmarks then\r\n            for _, house in ipairs(landmarks:GetChildren()) do\r\n                local lowerName = string.lower(house.Name)\r\n                if string.find(lowerName, \"halloween house\", 1, true)\r\n                    or lowerName == \"pelt trader\" then\r\n                    local grass = house:FindFirstChild(\"GrassFolder\", true)\r\n                    if grass then grassFolders[#grassFolders + 1] = grass end\r\n                end\r\n            end\r\n        end\r\n        cache.HouseGrassFolders = grassFolders\r\n        cache.HouseGrassFoldersAt = now\r\n        -- Keep the existing Pelt Trader reference used by the local grass formatter.\r\n        local trader = landmarks and landmarks:FindFirstChild(\"Halloween House Pelt Trader\")\r\n        cache.GrassFolder = trader and trader:FindFirstChild(\"GrassFolder\")\r\n    end\r\n    for _, grassFolder in ipairs(cache.HouseGrassFolders) do\r\n        if grassFolder and grassFolder.Parent\r\n            and (item == grassFolder or item:IsDescendantOf(grassFolder)) then\r\n            return true\r\n        end\r\n    end\r\n    return false\r\nend\r\n_G.KixIsBringBlacklistedItem = function(item)\r\n    if not item then return false end\r\n    local name = string.lower(item.Name)\r\n    if name == \"wood\" or name == \"plank\" or name == \"planks\"\r\n        or name == \"wood plank\" or name == \"wood planks\"\r\n        or name == \"woodplank\" or name == \"woodplanks\" then\r\n        return true\r\n    end\r\n    return _G.KixIsPeltTraderGrassAsset(item)\r\nend\r\n_G.KixIsLoggingCampItem = function(item)\r\n    if not item then return false end\r\n    local itemName = string.lower(item.Name)\r\n    if itemName == \"wood\" or itemName == \"plank\" or itemName == \"planks\"\r\n        or itemName == \"wood plank\" or itemName == \"wood planks\"\r\n        or itemName == \"woodplank\" or itemName == \"woodplanks\" then return true end\r\n    local localCharacter = _LocalPlayer and _LocalPlayer.Character\r\n    local localBackpack = _LocalPlayer and _LocalPlayer:FindFirstChild(\"Backpack\")\r\n    local localInventory = _LocalPlayer and _LocalPlayer:FindFirstChild(\"Inventory\")\r\n    if (localCharacter and item:IsDescendantOf(localCharacter))\r\n        or (localBackpack and item:IsDescendantOf(localBackpack))\r\n        or (localInventory and item:IsDescendantOf(localInventory)) then\r\n        return false\r\n    end\r\n    local cache = _G.KixLoggingCampBlacklistCache\r\n    local now = os.clock()\r\n    if not cache.Initialized or now - (cache.At or 0) >= 2 then\r\n        local map = workspace:FindFirstChild(\"Map\")\r\n        local landmarks = map and map:FindFirstChild(\"Landmarks\")\r\n        local camp = landmarks and landmarks:FindFirstChild(\"Logging Camp\")\r\n        local cabins = landmarks and landmarks:FindFirstChild(\"Log Cabins\")\r\n        local peltTrader = landmarks and landmarks:FindFirstChild(\"Halloween House Pelt Trader\")\r\n        cache.Model = camp\r\n        cache.CFrame = nil\r\n        cache.HalfSize = nil\r\n        cache.Cabins = cabins\r\n        cache.CabinsCFrame = nil\r\n        cache.CabinsHalfSize = nil\r\n        cache.PeltTrader = peltTrader\r\n        cache.GrassFolder = peltTrader and peltTrader:FindFirstChild(\"GrassFolder\")\r\n        cache.PeltTraderCFrame = nil\r\n        cache.PeltTraderHalfSize = nil\r\n        cache.At = now\r\n        cache.Initialized = true\r\n        if camp then\r\n            pcall(function()\r\n                local boundsCFrame, boundsSize = camp:GetBoundingBox()\r\n                cache.CFrame = boundsCFrame\r\n                cache.HalfSize = boundsSize * 0.5 + Vector3.new(3, 4, 3)\r\n            end)\r\n        end\r\n        if cabins then\r\n            pcall(function()\r\n                local boundsCFrame, boundsSize = cabins:GetBoundingBox()\r\n                cache.CabinsCFrame = boundsCFrame\r\n                cache.CabinsHalfSize = boundsSize * 0.5 + Vector3.new(3, 4, 3)\r\n            end)\r\n        end\r\n        if peltTrader then\r\n            pcall(function()\r\n                local boundsCFrame, boundsSize = peltTrader:GetBoundingBox()\r\n                cache.PeltTraderCFrame = boundsCFrame\r\n                cache.PeltTraderHalfSize = boundsSize * 0.5 + Vector3.new(3, 4, 3)\r\n            end)\r\n        end\r\n    end\r\n\r\n    local camp = cache.Model\r\n    local grassFolder = cache.GrassFolder\r\n    if grassFolder and (item == grassFolder or item:IsDescendantOf(grassFolder)) then return true end\r\n    if camp and (item == camp or item:IsDescendantOf(camp)) then return true end\r\n    local cabins = cache.Cabins\r\n    if cabins and (item == cabins or item:IsDescendantOf(cabins)) then return true end\r\n    local peltTrader = cache.PeltTrader\r\n    if peltTrader and (item == peltTrader or item:IsDescendantOf(peltTrader)) then return true end\r\n    if not cache.CFrame and not cache.CabinsCFrame and not cache.PeltTraderCFrame then return false end\r\n\r\n    local itemPosition\r\n    local ok = pcall(function()\r\n        if item:IsA(\"Model\") then\r\n            itemPosition = item:GetPivot().Position\r\n        elseif item:IsA(\"BasePart\") then\r\n            itemPosition = item.Position\r\n        else\r\n            local part = item:FindFirstChildWhichIsA(\"BasePart\", true)\r\n            itemPosition = part and part.Position\r\n        end\r\n    end)\r\n    if not ok or not itemPosition then return false end\r\n\r\n    if cache.CFrame and cache.HalfSize then\r\n        local localPosition = cache.CFrame:PointToObjectSpace(itemPosition)\r\n        local halfSize = cache.HalfSize\r\n        if math.abs(localPosition.X) <= halfSize.X\r\n            and math.abs(localPosition.Y) <= halfSize.Y\r\n            and math.abs(localPosition.Z) <= halfSize.Z then\r\n            return true\r\n        end\r\n    end\r\n    if cache.CabinsCFrame and cache.CabinsHalfSize then\r\n        local localPosition = cache.CabinsCFrame:PointToObjectSpace(itemPosition)\r\n        local halfSize = cache.CabinsHalfSize\r\n        if math.abs(localPosition.X) <= halfSize.X\r\n            and math.abs(localPosition.Y) <= halfSize.Y\r\n            and math.abs(localPosition.Z) <= halfSize.Z then\r\n            return true\r\n        end\r\n    end\r\n    if cache.PeltTraderCFrame and cache.PeltTraderHalfSize then\r\n        local localPosition = cache.PeltTraderCFrame:PointToObjectSpace(itemPosition)\r\n        local halfSize = cache.PeltTraderHalfSize\r\n        return math.abs(localPosition.X) <= halfSize.X\r\n            and math.abs(localPosition.Y) <= halfSize.Y\r\n            and math.abs(localPosition.Z) <= halfSize.Z\r\n    end\r\n    return false\r\nend\r\n\r\nlocal function isItemHeldByAnotherPlayerUncached(item, ignoreLoggingCamp)\r\n    if not item or not item.Parent then return true end\r\n\r\n    -- Explicit no-bring items/assets stay blocked even when a feature\r\n    -- bypasses the broader camp filter.\r\n    if _G.KixIsBringBlacklistedItem and _G.KixIsBringBlacklistedItem(item) then return true end\r\n    \r\n    -- Protected map drops and resources must not be moved by any bring system.\r\n    if not ignoreLoggingCamp and _G.KixIsLoggingCampItem and _G.KixIsLoggingCampItem(item) then return true end\r\n\r\n    -- 0. Abaikan jika item berada di karakter atau inventory LocalPlayer sendiri\r\n    if _LocalPlayer.Character and item:IsDescendantOf(_LocalPlayer.Character) then\r\n        return false\r\n    end\r\n    local myInv = _LocalPlayer:FindFirstChild(\"Inventory\")\r\n    if myInv and item:IsDescendantOf(myInv) then\r\n        return false\r\n    end\r\n    local myBp = _LocalPlayer:FindFirstChild(\"Backpack\")\r\n    if myBp and item:IsDescendantOf(myBp) then\r\n        return false\r\n    end\r\n    \r\n    -- 1. Check parent hierarchy: apakah item di dalam Character, Backpack, atau Inventory player lain?\r\n    for _, player in ipairs(_Players:GetPlayers()) do\r\n        if player ~= _LocalPlayer then\r\n            if player.Character and item:IsDescendantOf(player.Character) then\r\n                return true\r\n            end\r\n            local pInv = player:FindFirstChild(\"Inventory\")\r\n            if pInv and item:IsDescendantOf(pInv) then\r\n                return true\r\n            end\r\n            local pBp = player:FindFirstChild(\"Backpack\")\r\n            if pBp and item:IsDescendantOf(pBp) then\r\n                return true\r\n            end\r\n        end\r\n    end\r\n    \r\n    -- 2. Check carrier / holder / dragging attributes (sedang digendong/diangkat)\r\n    local carrier = item:GetAttribute(\"Carrier\") or item:GetAttribute(\"Holder\") or item:GetAttribute(\"HeldBy\")\r\n    if carrier ~= nil then\r\n        if carrier ~= _LocalPlayer.UserId and carrier ~= tostring(_LocalPlayer.UserId) and carrier ~= _LocalPlayer.Name then\r\n            return true\r\n        end\r\n    end\r\n    if item:GetAttribute(\"BeingCarried\") == true or item:GetAttribute(\"Carried\") == true or item:GetAttribute(\"Held\") == true or item:GetAttribute(\"Dragging\") == true or item:GetAttribute(\"IsDragged\") == true then\r\n        if carrier == nil or (carrier ~= _LocalPlayer.UserId and carrier ~= tostring(_LocalPlayer.UserId) and carrier ~= _LocalPlayer.Name) then\r\n            return true\r\n        end\r\n    end\r\n    \r\n    -- Fast path: parent and holder attributes above are ALWAYS checked first.\r\n    -- Only inspect expensive physics graphs if another player is close enough\r\n    -- to plausibly be holding the item. When location data is missing, fail\r\n    -- conservatively to the original full scan instead of assuming it is free.\r\n    local others = {}\r\n    for _, player in ipairs(_Players:GetPlayers()) do\r\n        if player ~= _LocalPlayer then others[#others + 1] = player end\r\n    end\r\n    if #others == 0 then return false, \"Fast\" end\r\n\r\n    local pivotOk, pivotPosition = pcall(function() return item:GetPivot().Position end)\r\n    local needPhysicsCheck = not pivotOk or not pivotPosition\r\n    if not needPhysicsCheck then\r\n        for _, player in ipairs(others) do\r\n            local char = player.Character\r\n            local root = char and (char:FindFirstChild(\"HumanoidRootPart\") or char.PrimaryPart)\r\n            if not root or (root.Position - pivotPosition).Magnitude <= 150 then\r\n                needPhysicsCheck = true\r\n                break\r\n            end\r\n        end\r\n    end\r\n    if not needPhysicsCheck then return false, \"Fast\" end\r\n\r\n    -- Same protection as before when players are nearby, without collecting\r\n    -- the player list again for every descendant or connected part.\r\n    local otherCharacters = {}\r\n    for _, player in ipairs(others) do\r\n        if player.Character then otherCharacters[#otherCharacters + 1] = player.Character end\r\n    end\r\n    local function touchesOtherCharacter(part)\r\n        if not part then return false end\r\n        for _, char in ipairs(otherCharacters) do\r\n            if part:IsDescendantOf(char) then return true end\r\n        end\r\n        return false\r\n    end\r\n    local function hasOtherPlayerConnection(part)\r\n        local ok, parts = pcall(function() return part:GetConnectedParts() end)\r\n        if ok and type(parts) == \"table\" then\r\n            for _, connected in ipairs(parts) do\r\n                if touchesOtherCharacter(connected) then return true end\r\n            end\r\n        end\r\n        return false\r\n    end\r\n    for _, desc in ipairs(item:GetDescendants()) do\r\n        if desc:IsA(\"WeldConstraint\") or desc:IsA(\"Weld\") or desc:IsA(\"Motor6D\") then\r\n            if touchesOtherCharacter(desc.Part0) or touchesOtherCharacter(desc.Part1) then\r\n                return true, \"Full\"\r\n            end\r\n        elseif desc:IsA(\"Constraint\") then\r\n            if touchesOtherCharacter(desc.Attachment0) or touchesOtherCharacter(desc.Attachment1) then\r\n                return true, \"Full\"\r\n            end\r\n        elseif desc:IsA(\"BasePart\") then\r\n            if hasOtherPlayerConnection(desc) then return true, \"Full\" end\r\n        end\r\n    end\r\n    if item:IsA(\"BasePart\") and hasOtherPlayerConnection(item) then\r\n        return true, \"Full\"\r\n    end\r\n    return false, \"Full\"\r\nend\r\n\r\n-- Cache only briefly; parent/holder changes invalidate immediately.\r\nlocal heldItemState = setmetatable({}, {__mode = \"k\"})\r\nlocal function isItemHeldByAnotherPlayer(item, ignoreLoggingCamp)\r\n    if not item or not item.Parent then return true end\r\n    local now = os.clock()\r\n    local skipLoggingCamp = ignoreLoggingCamp == true\r\n    local parent = item.Parent\r\n    local holder = item:GetAttribute(\"Carrier\") or item:GetAttribute(\"Holder\") or item:GetAttribute(\"HeldBy\")\r\n    local flags = item:GetAttribute(\"BeingCarried\") == true or item:GetAttribute(\"Carried\") == true\r\n        or item:GetAttribute(\"Held\") == true or item:GetAttribute(\"Dragging\") == true\r\n        or item:GetAttribute(\"IsDragged\") == true\r\n    local cached = heldItemState[item]\r\n    if cached and now < cached.Until and cached.Parent == parent\r\n        and cached.IgnoreLoggingCamp == skipLoggingCamp\r\n        and cached.Holder == holder and cached.Flags == flags then\r\n        _G.KixPerfDebug.Count(\"HeldCacheHit\")\r\n        return cached.Result\r\n    end\r\n    local result, scanKind = isItemHeldByAnotherPlayerUncached(item, skipLoggingCamp)\r\n    _G.KixPerfDebug.Count(scanKind == \"Fast\" and \"HeldFastPath\" or \"HeldFullScan\")\r\n    -- Keep the previous short cache duration to avoid stale holder decisions.\r\n    heldItemState[item] = {Until = now + 0.35, Parent = parent, Holder = holder,\r\n        Flags = flags, IgnoreLoggingCamp = skipLoggingCamp, Result = result}\r\n    return result\r\nend\r\n\r\nlocal function dragItemSmooth(item, destinationPos, validateStewMove, allowSelectedFood)\r\n    if not KixHubSession.Alive or not item or not item.Parent then return false end\r\n    if typeof(destinationPos) ~= \"Vector3\" then return false end\r\n\r\n    local function run()\r\n        if not item then return end\r\n        if _G.KixIsBringBlacklistedItem and _G.KixIsBringBlacklistedItem(item) then return end\r\n        if _G.KixPerfDebug.Enabled then\r\n            local name = item.Name\r\n            local kind = (name == \"Log\" or name == \"Chair\") and \"DragLogs\"\r\n                or ((name == \"Cultist Gem\" or name == \"Gem of the Forest Fragment\") and \"DragGems\")\r\n                or ((name == \"Stew\" or name == \"Hearty Stew\") and \"DragStew\")\r\n                or (name == \"Biofuel\" and \"DragBiofuel\") or \"DragOther\"\r\n            _G.KixPerfDebug.Count(kind .. \"Attempt\")\r\n        end\r\n        local isSelectedFood = allowSelectedFood and type(listFood) == \"table\"\r\n            and table.find(listFood, item.Name) ~= nil\r\n        if _G.KixIsLoggingCampItem and _G.KixIsLoggingCampItem(item)\r\n            and not isSelectedFood then return end\r\n        -- Stew collection uses its own uncached, ownership-aware validator.\r\n        -- Preserve the original held-item guard for every other Bring system.\r\n        if validateStewMove then\r\n            if not validateStewMove(\"beforeStart\") then return end\r\n        elseif isItemHeldByAnotherPlayer(item, isSelectedFood) then\r\n            return\r\n        end\r\n        -- Tolak semak-semak, planter, atau struktur map permanen\r\n        local itemName = item.Name\r\n        if string.find(itemName, \"Bush\", 1, true) or string.find(itemName, \"Planter\", 1, true) or string.find(itemName, \"Cabin\", 1, true) then\r\n            return\r\n        end\r\n        -- Tolak jika item merupakan bagian atau anak dari semak Bush atau Planter\r\n        local curAncestor = item.Parent\r\n        while curAncestor and curAncestor ~= workspace and curAncestor ~= game do\r\n            local caName = string.lower(curAncestor.Name)\r\n            if string.find(caName, \"bush\", 1, true) or string.find(caName, \"planter\", 1, true) then\r\n                return\r\n            end\r\n            curAncestor = curAncestor.Parent\r\n        end\r\n        local mapFolder = _Workspace:FindFirstChild(\"Map\") or workspace:FindFirstChild(\"Map\") or _Workspace:FindFirstChild(\"map\") or workspace:FindFirstChild(\"map\")\r\n        if mapFolder and item:IsDescendantOf(mapFolder) then return end\r\n        local hollowMap = _Workspace:FindFirstChild(\"HollowMap\") or workspace:FindFirstChild(\"HollowMap\")\r\n        if hollowMap and item:IsDescendantOf(hollowMap) then return end\r\n        local landmarksFolder = _Workspace:FindFirstChild(\"Landmarks\") or workspace:FindFirstChild(\"Landmarks\")\r\n        if landmarksFolder and item:IsDescendantOf(landmarksFolder) then return end\r\n        if item and (item:IsDescendantOf(workspace) and (item:IsA('BasePart') or item:IsA('Model') or item:IsA('Tool'))) then\r\n            local primary\r\n            if item:IsA('Model') then\r\n                primary = item.PrimaryPart or item:FindFirstChildWhichIsA('BasePart', true) or (item:FindFirstChild('Handle', true) or item)\r\n            elseif item:IsA('Tool') then\r\n                primary = item:FindFirstChild('Handle', true) or item:FindFirstChildWhichIsA('BasePart', true)\r\n            else\r\n                primary = item\r\n            end\r\n        \r\n            if primary and primary:IsA('BasePart') then\r\n                if item:IsA('Model') and not item.PrimaryPart then\r\n                    pcall(function() item.PrimaryPart = primary end)\r\n                end\r\n                -- Jika item adalah Berry, putuskan semua sambungan Joint/Weld ke luar agar semak tidak ikut\r\n                if string.find(string.lower(itemName), \"berry\", 1, true) then\r\n                    pcall(function()\r\n                        for _, d in ipairs(item:GetDescendants()) do\r\n                            if d:IsA(\"JointInstance\") or d:IsA(\"WeldConstraint\") then\r\n                                d:Destroy()\r\n                            end\r\n                        end\r\n                        for _, j in ipairs(primary:GetJoints()) do\r\n                            j:Destroy()\r\n                        end\r\n                    end)\r\n                end\r\n                local didDrag = false\r\n                local actionOk = pcall(function()\r\n                    local remotes = _ReplicatedStorage:FindFirstChild('RemoteEvents')\r\n                    local startDrag = remotes and remotes:FindFirstChild('RequestStartDraggingItem')\r\n                    local stopDrag = remotes and remotes:FindFirstChild('StopDraggingItem')\r\n                    if not (startDrag and stopDrag) then return end\r\n                    if validateStewMove and not validateStewMove() then return end\r\n                    startDrag:FireServer(item)\r\n                    task.wait(0.05)\r\n                    -- Teammates can grab stew while a remote is yielding. Never move it then.\r\n                    if validateStewMove and not validateStewMove(\"afterStart\") then\r\n                        stopDrag:FireServer(item)\r\n                        return\r\n                    end\r\n                    if item:IsA('Model') then\r\n                        if item.PivotTo then\r\n                            item:PivotTo(CFrame.new(destinationPos))\r\n                        elseif item.PrimaryPart then\r\n                            item:SetPrimaryPartCFrame(CFrame.new(destinationPos))\r\n                        end\r\n                    elseif item:IsA('Tool') or item:IsA('BasePart') then\r\n                        primary.CFrame = CFrame.new(destinationPos)\r\n                    end\r\n                    task.wait(0.1)\r\n                    stopDrag:FireServer(item)\r\n                    didDrag = true\r\n                end)\r\n                return actionOk and didDrag\r\n            end\r\n        end\r\n        return false\r\n    end\r\n\r\n    local ok, result = pcall(run)\r\n    if not ok then\r\n        _G.KixPerfDebug.Count(\"DragUnexpectedError\")\r\n        warn(\"[KixDrag] \" .. tostring(result))\r\n        return false\r\n    end\r\n    _G.KixPerfDebug.Count(result == true and \"DragCompleted\" or \"DragRejected\")\r\n    return result == true\r\nend\r\n\r\n\r\n-- =========================================================\r\nlocal function grabMedicine()\r\n    local inventory = _LocalPlayer:FindFirstChild(\"Inventory\")\r\n\r\n    -- =====================================================\r\n    -- 1. CEK INVENTORY TERLEBIH DAHULU\r\n    -- =====================================================\r\n\r\n    local function getHealItem()\r\n        if not inventory then\r\n            return nil\r\n        end\r\n\r\n        return inventory:FindFirstChild(\"Bandage\")\r\n            or inventory:FindFirstChild(\"MedKit\")\r\n            or inventory:FindFirstChild(\"Medkit\")\r\n    end\r\n\r\n    local existing = getHealItem()\r\n\r\n    if existing then\r\n        return existing\r\n    end\r\n\r\n    -- =====================================================\r\n    -- 2. CARI MEDICINE DI ITEMS\r\n    -- =====================================================\r\n\r\n    local itemsFolder =\r\n        workspace:FindFirstChild(\"Items\")\r\n        or workspace:FindFirstChild(\"items\")\r\n\r\n    if not itemsFolder then\r\n        return nil\r\n    end\r\n\r\n    local candidates = {}\r\n\r\n    for _, item in ipairs(itemsFolder:GetChildren()) do\r\n        if item:IsA(\"Model\") then\r\n            if item.Name == \"Bandage\"\r\n                or item.Name == \"MedKit\"\r\n                or item.Name == \"Medkit\"\r\n            then\r\n                table.insert(candidates, item)\r\n            end\r\n        end\r\n    end\r\n\r\n    if #candidates == 0 then\r\n        return nil\r\n    end\r\n\r\n    -- =====================================================\r\n    -- 3. REQUEST PICKUP\r\n    -- =====================================================\r\n\r\n    local remoteEvents =\r\n        _ReplicatedStorage:FindFirstChild(\"RemoteEvents\")\r\n\r\n    local hotbarRemote =\r\n        remoteEvents and remoteEvents:FindFirstChild(\"RequestHotbarItem\")\r\n\r\n    if not hotbarRemote then\r\n        return nil\r\n    end\r\n\r\n    for _, item in ipairs(candidates) do\r\n\r\n        if not item or not item.Parent then\r\n            continue\r\n        end\r\n        if _G.KixIsLoggingCampItem and _G.KixIsLoggingCampItem(item) then\r\n            continue\r\n        end\r\n\r\n        pcall(function()\r\n            hotbarRemote:InvokeServer(item)\r\n        end)\r\n\r\n        -- Tunggu singkat hanya untuk sinkronisasi inventory\r\n        for _ = 1, 5 do\r\n            task.wait(0.05)\r\n\r\n            local healItem = getHealItem()\r\n\r\n            if healItem then\r\n                return healItem\r\n            end\r\n        end\r\n    end\r\n\r\n    return getHealItem()\r\nend\r\n\r\nlocal function startReviveSelfLoop()\r\n    if reviveSelfLoopRunning then return end\r\n    reviveSelfLoopRunning = true\r\n    \r\n    task.spawn(function()\r\n        while autoReviveSelf do\r\n            pcall(function()\r\n                local pg = _LocalPlayer:FindFirstChild(\"PlayerGui\")\r\n                if not pg then return end\r\n                \r\n                local interface = pg:FindFirstChild(\"Interface\")\r\n                local deadFrame = interface and interface:FindFirstChild(\"DeadFrame\")\r\n                local isDowned = deadFrame and deadFrame.Visible\r\n            \r\n            if isDowned then\r\n                local myBody = nil\r\n                \r\n                -- CARA 1: Gunakan Camera Subject (Paling akurat karena saat mati, kamera fokus ke tubuh kita)\r\n                local cam = workspace.CurrentCamera\r\n                if cam and cam.CameraSubject and cam.CameraSubject:IsA(\"Humanoid\") and cam.CameraSubject.Parent then\r\n                    local subjectParent = cam.CameraSubject.Parent\r\n                    if subjectParent:FindFirstChild(\"ReviveBillboard\") or subjectParent.Name:match(\" Body$\") then\r\n                        myBody = subjectParent\r\n                    end\r\n                end\r\n                \r\n                -- CARA 2: Pengecekan aman menggunakan Attribute PlayerBody\r\n                local charsFolder = workspace:FindFirstChild(\"Characters\")\r\n                if not myBody and charsFolder then\r\n                    for _, char in ipairs(charsFolder:GetChildren()) do\r\n                        if char:GetAttribute(\"PlayerBody\") == _LocalPlayer.UserId then\r\n                            myBody = char\r\n                            break\r\n                        end\r\n                    end\r\n                end\r\n                \r\n                -- CARA 3: Gunakan DisplayName\r\n                if not myBody and charsFolder then\r\n                    myBody = charsFolder:FindFirstChild(_LocalPlayer.DisplayName .. \" Body\") or \r\n                             charsFolder:FindFirstChild(_LocalPlayer.Name .. \" Body\")\r\n                end\r\n                \r\n                if myBody then\r\n                    local inventory = _LocalPlayer:FindFirstChild(\"Inventory\")\r\n                    \r\n                    -- Cek apakah punya item penyembuh di Inventory custom game ini\r\n                    local hasHealItem = false\r\n                    if inventory then\r\n                        hasHealItem = inventory:FindFirstChild(\"Bandage\") or inventory:FindFirstChild(\"MedKit\") or inventory:FindFirstChild(\"Medkit\")\r\n                    end\r\n                    \r\n                    -- Jika tidak punya, CURI/TARIK dari tanah/tas/peti menggunakan sistem game\r\n                    if not hasHealItem then\r\n                        grabMedicine()\r\n                    end\r\n                    \r\n                    -- Cek ulang apakah item sudah berhasil masuk ke Inventory\r\n                    if inventory then\r\n                        hasHealItem = inventory:FindFirstChild(\"Bandage\") or inventory:FindFirstChild(\"MedKit\") or inventory:FindFirstChild(\"Medkit\")\r\n                    end\r\n                    \r\n                    if hasHealItem then\r\n                        -- EKSEKUSI REVIVE\r\n                        local remoteEvents = game:GetService(\"ReplicatedStorage\"):FindFirstChild(\"RemoteEvents\")\r\n                        if remoteEvents then\r\n                            local reviveRemote = remoteEvents:FindFirstChild(\"RequestRevivePlayer\")\r\n                            if reviveRemote then\r\n                                pcall(function() reviveRemote:FireServer(myBody) end)\r\n                            end\r\n                        end\r\n                        \r\n                        task.wait(1.5) -- Beri waktu sistem untuk memulihkan karakter\r\n                    end\r\n                end\r\n            end\r\n            end)\r\n            task.wait(0.5)\r\n        end\r\n        reviveSelfLoopRunning = false\r\n    end)\r\nend\r\n\r\n-- Eksekusi awal secepat mungkin (sebelum Loading Screen)\r\ntask.spawn(function()\r\n    pcall(function()\r\n        if not _LocalPlayer.Character then _LocalPlayer.CharacterAdded:Wait() end\r\n    end)\r\nend)\r\n\r\n-- [ ELEGANT LOADING SCREEN ]\r\nlocal ts = game:GetService(\"TweenService\")\r\nlocal coreGuiSuccess, coreGui = pcall(function() return game:GetService(\"CoreGui\") end)\r\nlocal guiParent = (coreGuiSuccess and coreGui) and coreGui or _LocalPlayer:WaitForChild(\"PlayerGui\")\r\n\r\nlocal KixLoadingScreen = Instance.new(\"ScreenGui\")\r\nKixLoadingScreen.Name = \"KixHubLoading\"\r\nKixLoadingScreen.IgnoreGuiInset = true\r\nKixLoadingScreen.ResetOnSpawn = false\r\nKixLoadingScreen.DisplayOrder = 99999\r\nKixLoadingScreen.Parent = guiParent\r\n\r\nlocal bg = Instance.new(\"Frame\")\r\nbg.Size = UDim2.fromScale(1, 1)\r\nbg.BackgroundColor3 = Color3.fromRGB(5, 8, 5)\r\nbg.BackgroundTransparency = 0.4\r\nbg.BorderSizePixel = 0\r\nbg.Parent = KixLoadingScreen\r\n\r\nlocal particleFolder = Instance.new(\"Folder\")\r\nparticleFolder.Name = \"Particles\"\r\nparticleFolder.Parent = bg\r\n\r\nloadingActive =