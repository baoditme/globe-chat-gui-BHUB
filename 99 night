e or '') end})\r\n    _G.KixBringBlockedKeywords = {\"chest\", \"structures\", \"building\", \"trap\"}\r\n    Tabs.Bring:Button({Title = 'Bring Custom Item Now', Callback = function() task.spawn(executeBringQuery, customBringItemName) end})\r\n\r\n    Tabs.Bring:Section({Title = 'Bandage & Medkit', Icon = 'bandage'})\r\n    local function executeBringMedicine()\r\n        task.spawn(function()\r\n            local folder, snapshot = _G.KixItemsIndex.Get()\r\n            local character = _LocalPlayer.Character\r\n            local root = character and character:FindFirstChild(\"HumanoidRootPart\")\r\n            if not folder or not root then return end\r\n            local candidates = {}\r\n            for _, item in ipairs(snapshot) do\r\n                local name = string.lower(item.Name)\r\n                if (name == \"bandage\" or name == \"medkit\") and item.Parent == folder\r\n                    and _G.KixItemTransportSystem.CanTeleport(item)\r\n                    and not isItemHeldByAnotherPlayer(item) then\r\n                    candidates[#candidates + 1] = item\r\n                end\r\n            end\r\n            local target = root.CFrame + Vector3.new(0, 5, 0)\r\n            for _, medicine in ipairs(candidates) do\r\n                if not KixHubSession.Alive then break end\r\n                if medicine.Parent == folder then\r\n                    local position\r\n                    pcall(function() position = medicine:GetPivot().Position end)\r\n                    if position and (position - root.Position).Magnitude > 12 then\r\n                        _G.KixItemTransportSystem.Move(medicine, target, function()\r\n                            return KixHubSession.Alive and medicine.Parent == folder and not isItemHeldByAnotherPlayer(medicine)\r\n                        end)\r\n                    end\r\n                    if medicine.Parent == folder then\r\n                        local originalParent = medicine.Parent\r\n                        local tempStorage = _ReplicatedStorage:FindFirstChild(\"TempStorage\")\r\n                        if tempStorage then pcall(function() medicine.Parent = tempStorage end) end\r\n                        local ok, result = pcall(function() return Client.Events.RequestHotbarItem:InvokeServer(medicine) end)\r\n                        if not (ok and result and result.Success) then\r\n                            pcall(function()\r\n                                if medicine.Parent and originalParent then medicine.Parent = originalParent end\r\n                            end)\r\n                        else\r\n                            pcall(function() Client.Sound.Play(\"BagGet\", {Duplicate = true, PitchShift = 1}) end)\r\n                        end\r\n                    end\r\n                    task.wait(0.05)\r\n                end\r\n            end\r\n        end)\r\n    end\r\n    _G.RunBringMedicine = executeBringMedicine\r\n    Tabs.Bring:Button({Title = '💊 Bring Bandage & Medkit 💊', Desc = 'Bring All Bandage & Medkit to you, then picks them up', Callback = executeBringMedicine})\r\n\r\n    Tabs.Bring:Section({Title = 'Scrap', Icon = 'recycle'})\r\n    CreateMultiDropdown(Tabs.Bring, {Title = 'Select Scrap', Desc = 'Choose scrap items to bring to the selected destination.', Values = listScrap, Multi = true, Callback = function(value) bringSelections.Scrap = value end})\r\n    Tabs.Bring:Button({Title = 'Bring Scrap Now', Callback = function() task.spawn(executeBring, bringSelections.Scrap) end})\r\n\r\n    Tabs.Bring:Section({Title = 'Equipment', Icon = 'sword'})\r\n    CreateMultiDropdown(Tabs.Bring, {Title = 'Select Equipment', Values = listEquipment, Multi = true, Callback = function(value) bringSelections.Equipment = value end})\r\n    Tabs.Bring:Button({Title = 'Bring Equipment Now', Callback = function() task.spawn(executeBring, bringSelections.Equipment) end})\r\n    Tabs.Bring:Section({Title = 'Pelt Trader', Icon = 'tag'})\r\n    CreateMulti