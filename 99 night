                 while\r\n                            autoStrongholdFarm\r\n                            and cooldown < 370\r\n                        do\r\n\r\n                            task.wait(1)\r\n\r\n                            cooldown =\r\n                                cooldown + 1\r\n                        end\r\n                    end)\r\n\r\n                    -- Menambahkan Yield/Wait agar tidak FREEZE (Infinite loop protection) saat pcall mereturn cepat.\r\n                    task.wait(1)\r\n                end\r\n            end)\r\n        else\r\n\r\n            releaseStrongholdHideLock()\r\n\r\n            -- =========================================================\r\n            -- STOP AUTO STRONGHOLD\r\n            -- =========================================================\r\n\r\n            _G.AllowBodyAura = false\r\n            _G.IsStrongholdRaidActive = false\r\n            _G.StrongholdTransition = false\r\n            _G.StrongholdPreparingRaid = false\r\n            _G.CampfireCombatActive = false\r\n\r\n            -- Lepaskan pause internal Stronghold.\r\n            -- Jangan menyentuh pause manual user.\r\n            _G.CampfireCombatStrongholdPaused = false\r\n\r\n            local resetCam=workspace.CurrentCamera\r\n\r\n            if resetCam then\r\n                resetCam.CameraType=Enum.CameraType.Custom\r\n                resetCam.CameraSubject=\r\n                    _LocalPlayer.Character\r\n                    and _LocalPlayer.Character:FindFirstChild(\"Humanoid\")\r\n            end\r\n\r\n            if strongholdCompleteConn then\r\n                strongholdCompleteConn:Disconnect()\r\n                strongholdCompleteConn=nil\r\n            end\r\n\r\n            if gateOpenConn then\r\n                gateOpenConn:Disconnect()\r\n                gateOpenConn=nil\r\n            end\r\n        end\r\nend\r\n_G.KixAdapters.AutoStronghold = {IsEnabled = function() return autoStrongholdFarm == true end}\r\n\r\n--[[\r\nTabs.Auto:Toggle({\r\n    Title = \"⏸️ Pause Campfire Cultist Attack\",\r\n    Desc = \"Temporarily pauses the auto-attack Cultists near Campfire. Toggle off to resume.\",\r\n    Value = false,\r\n\r\n    Callback = function(val)\r\n\r\n        _G.CampfireCombatPaused = val\r\n\r\n        if val then\r\n\r\n            _G.CampfireCombatActive = false\r\n\r\n            if WindUI then\r\n                WindUI:Notify({\r\n                    Title = \"Campfire Cultist\",\r\n                    Content = \"Combat temporarily paused.\",\r\n                    Duration = 2\r\n                })\r\n            end\r\n\r\n        else\r\n\r\n            if WindUI then\r\n                WindUI:Notify({\r\n                    Title = \"Campfire Cultist\",\r\n                    Content = \"Combat resumed.\",\r\n                    Duration = 2\r\n                })\r\n            end\r\n\r\n        end\r\n    end\r\n})\r\n]]\r\n\r\n_G.CampfireCombatPaused = false\r\n\r\n-- ==================== AUTO CONSUME STRONGHOLD AMMO ====================\r\nautoConsumeStrongholdAmmo = false\r\nautoVoidStrongholdAmmo = false -- Alias kompatibilitas\r\nautoConsumeStrongholdAmmoToken = 0\r\nautoVoidStrongholdAmmoToken = 0\r\n\r\nfunction startStrongholdAmmoConsumeCollector()\r\n    autoConsumeStrongholdAmmoToken = autoConsumeStrongholdAmmoToken + 1\r\n    autoVoidStrongholdAmmoToken = autoConsumeStrongholdAmmoToken\r\n    local myToken = autoConsumeStrongholdAmmoToken\r\n\r\n    task.spawn(function()\r\n        local ammoTargetNames = {\r\n            [\"Revolver Ammo\"] = true,\r\n            [\"Rifle Ammo\"] = true,\r\n            [\"Ammo Box\"] = true\r\n        }\r\n\r\n        local function isTargetAmmo(item)\r\n            if not item or not item.Parent then return false end\r\n            local name = item.Name\r\n            if ammoTargetNames[name] == true then return true end\r\n            local lower = string.lower(name)\r\n            if string.find(lower, \"ammo\", 1, true) and not string.find(lower, \"crate\", 1, true) then\r\n                return true\r\n            end\r\n            return false\r\n        end\r\n\r\n        local function getTargetAmmoPosition(item)\r\n            local ok, pos = pcall(function()\r\n                if item:IsA(\"Model\") then\r\n                    return item:GetPivot().Position\r\n                elseif item:IsA(\"BasePart\") then\r\n                    return item.Position\r\n                end\r\n                local p = item.PrimaryPart or item:FindFirstChildWhichIsA(\"BasePart\", true)\r\n                return p and p.Position or nil\r\n            end)\r\n            return ok and pos or nil\r\n        end\r\n\r\n        local function findNearestAmmo(hrp)\r\n            local itemsFolder = _Workspace:FindFirstChild(\"Items\") or _Workspace:FindFirstChild(\"items\") or workspace:FindFirstChild(\"Items\") or workspace:FindFirstChild(\"items\")\r\n            if not itemsFolder or not hrp then return nil end\r\n\r\n            local nearest = nil\r\n            local minDistance = math.huge\r\n\r\n            for _, item in ipairs(itemsFolder:GetChildren()) do\r\n                if item.Parent == itemsFolder and isTargetAmmo(item) then\r\n                    local pos = getTargetAmmoPosition(item)\r\n                    if pos and pos.Y > -50 then\r\n                        local dist = (pos - hrp.Position).Magnitude\r\n                        if dist < minDistance then\r\n                            minDistance = dist\r\n                            nearest = item\r\n                        end\r\n                    end\r\n                end\r\n            end\r\n            return nearest\r\n        end\r\n\r\n        local function bringAndConsumeSingleAmmo(item, hrp)\r\n            if not item or not item.Parent or not hrp then return false end\r\n\r\n            -- 1. Move ammo to the local player one item at a time.\r\n            if type(dragItemSmooth) == \"function\" then\r\n                pcall(function()\r\n                    dragItemSmooth(item, hrp.Position)\r\n                end)\r\n            end\r\n\r\n            -- Tunggu agar posisi mendarat / tersinkronisasi di badan pemain\r\n            task.wait(0.25)\r\n\r\n            if not item.Parent then\r\n                return true\r\n            end\r\n\r\n            -- Pastikan posisi benar-benar di badan karakter (jarak dekat)\r\n            local currentPos = getTargetAmmoPosition(item)\r\n            if currentPos and (currentPos - hrp.Position).Magnitude > 20 then\r\n                pcall(function()\r\n                    if item:IsA(\"Model\") then\r\n                        item:PivotTo(hrp.CFrame * CFrame.new(0, 1, 0))\r\n                    elseif item:IsA(\"BasePart\") then\r\n                        item.CFrame = hrp.CFrame * CFrame.new(0, 1, 0)\r\n                    end\r\n                end)\r\n                task.wait(0.1)\r\n            end\r\n\r\n            -- 2. Eksekusi Consume setelah berada di badan Local Player\r\n            local remoteEvents = _ReplicatedStorage:FindFirstChild(\"RemoteEvents\") or game:GetService(\"ReplicatedStorage\"):FindFirstChild(\"RemoteEvents\")\r\n            local remoteFuncs = _ReplicatedStorage:FindFirstChild(\"RemoteFunctions\") or game:GetService(\"ReplicatedStorage\"):FindFirstChild(\"RemoteFunctions\")\r\n            local reqStartDrag = remoteEvents and (remoteEvents:FindFirstChild(\"RequestStartDraggingItem_REAL\") or remoteEvents:FindFirstChild(\"RequestStartDraggingItem\"))\r\n            local reqStopDrag = remoteEvents and (remoteEvents:FindFirstChild(\"StopDraggingItem_REAL\") or remoteEvents:FindFirstChild(\"StopDraggingItem\"))\r\n\r\n            local okClient, Client = pcall(function() return require(_LocalPlayer.PlayerScripts.Client) end)\r\n\r\n            -- A. Sequence drag ownership\r\n            pcall(function()\r\n                if reqStartDrag and item.Parent then reqStartDrag:FireServer(item) end\r\n                task.wait(0.06)\r\n                if reqStopDrag and item.Parent then reqStopDrag:FireServer(item) end\r\n            end)\r\n            task.wait(0.05)\r\n\r\n            local consumed = false\r\n\r\n            -- B. Jalur Utama: Remote AmmoBoxConsume\r\n            local ammoBoxConsume = (okClient and Client and Client.Events and Client.Events.AmmoBoxConsume)\r\n                or (remoteEvents and (remoteEvents:FindFirstChild(\"AmmoBoxConsume_REAL\") or remoteEvents:FindFirstChild(\"AmmoBoxConsume\")))\r\n                or (remoteFuncs and (remoteFuncs:FindFirstChild(\"AmmoBoxConsume_REAL\") or remoteFuncs:FindFirstChild(\"AmmoBoxConsume\")))\r\n                or _ReplicatedStorage:FindFirstChild(\"AmmoBoxConsume\")\r\n                or game:GetService(\"ReplicatedStorage\"):FindFirstChild(\"AmmoBoxConsume\")\r\n\r\n            if ammoBoxConsume and item.Parent then\r\n                pcall(function()\r\n                    if ammoBoxConsume:IsA(\"RemoteFunction\") then\r\n                        local res = ammoBoxConsume:InvokeServer(item)\r\n                        if res ~= false then consumed = true end\r\n                    else\r\n                        ammoBoxConsume:FireServer(item)\r\n                        consumed = true\r\n                    end\r\n                end)\r\n            end\r\n\r\n            -- C. Cadangan 1: Remote RequestConsumeItem (seperti konsumsi makanan darurat)\r\n            if not consumed and item.Parent then\r\n                local consumeRemote = (okClient and Client and Client.Events and Client.Events.RequestConsumeItem)\r\n                    or (remoteEvents and (remoteEvents:FindFirstChild(\"RequestConsumeItem_REAL\") or remoteEvents:FindFirstChild(\"RequestConsumeItem\")))\r\n                    or (remoteFuncs and (remoteFuncs:FindFirstChild(\"RequestConsumeItem_REAL\") or remoteFuncs:FindFirstChild(\"RequestConsumeItem\")))\r\n                    or _ReplicatedStorage:FindFirstChild(\"RequestConsumeItem\")\r\n\r\n                if consumeRemote then\r\n                    pcall(function()\r\n                        if consumeRemote:IsA(\"RemoteFunction\") then\r\n                            local res = consumeRemote:InvokeServer(item)\r\n                            if res ~= false then consumed = true end\r\n                        else\r\n                            consumeRemote:FireServer(item)\r\n                            consumed = true\r\n                        end\r\n                    end)\r\n                end\r\n            end\r\n\r\n            -- D. Cadangan 2: InteractionHandler.AttemptConsumeItem\r\n            if not consumed and item.Parent and okClient and Client and Client.InteractionHandler and Client.InteractionHandler.AttemptConsumeItem then\r\n                pcall(function()\r\n                    if Client.InteractionHandler.AttemptConsumeItem(item) then\r\n                        consumed = true\r\n                    end\r\n                end)\r\n            end\r\n\r\n            -- E. Cadangan 3: ProximityPrompt\r\n            if not consumed and item.Parent then\r\n                local prompt = item:FindFirstChildWhichIsA(\"ProximityPrompt\", true)\r\n                if prompt and prompt.Enabled then\r\n                    pcall(function()\r\n                        if fireproximityprompt then\r\n                            fireproximityprompt(prompt, 1)\r\n                        else\r\n                            prompt:InputHoldBegin()\r\n                            task.wait((prompt.HoldDuration or 0) + 0.05)\r\n                            prompt:InputHoldEnd()\r\n                        end\r\n                        consumed = true\r\n                    end)\r\n                end\r\n            end\r\n\r\n            -- Safety cleanup drag\r\n            pcall(function()\r\n                if reqStopDrag and item.Parent then reqStopDrag:FireServer(item) end\r\n            end)\r\n\r\n            return true\r\n        end\r\n\r\n        -- MAIN LOOP INSTANT TEST MODE: Konsumsi seketika tanpa harus menunggu Stronghold Clear atau jeda 10 menit\r\n        while (autoConsumeStrongholdAmmo or autoVoidStrongholdAmmo) and autoConsumeStrongholdAmmoToken == myToken do\r\n            local char = _LocalPlayer.Character\r\n            local hrp = char and char:FindFirstChild(\"HumanoidRootPart\")\r\n\r\n            if not hrp then\r\n                task.wait(1)\r\n                continue\r\n            end\r\n\r\n            local ammoItem = findNearestAmmo(hrp)\r\n            if ammoItem then\r\n                bringAndConsumeSingleAmmo(ammoItem, hrp)\r\n                task.wait(0.2)\r\n            else\r\n                task.wait(1.5)\r\n            end\r\n        end\r\n    end)\r\nend\r\nstartStrongholdAmmoVoidCollector = startStrongholdAmmoConsumeCollector\r\n\r\nTabs.Auto:Toggle({\r\n    Title = \"📦 Auto Consume Ammo\",\r\n    Desc = \"Brings and consumes Revolver Ammo, Rifle Ammo and Ammo Boxes to player instantly.\",\r\n    Value = false,\r\n    Callback = function(value)\r\n        autoConsumeStrongholdAmmo = value\r\n        autoVoidStrongholdAmmo = value\r\n        if value then\r\n            startStrongholdAmmoConsumeCollector()\r\n        else\r\n            autoConsumeStrongholdAmmoToken = autoConsumeStrongholdAmmoToken + 1\r\n            autoVoidStrongholdAmmoToken = autoConsumeStrongholdAmmoToken\r\n        end\r\n    end\r\n})\r\n\r\n-- ==================== ANTI SPAM SYSTEM ====================\r\nlocal AntiSpamCooldowns = {\r\n    Corrupted = 0,\r\n    Mossy = 0,\r\n    Mammoth = 0\r\n}\r\nlocal COOLDOWN_TIME = 5\r\n\r\nlocal function NotifySpam(timeLeft)\r\n    pcall(function()\r\n        game:GetService(\"StarterGui\"):SetCore(\"SendNotification\", {\r\n            Title = \"Anti-Spam Active\",\r\n            Text = \"Please wait \" .. timeLeft .. \" seconds before pressing this toggle again.\",\r\n            Duration = 3\r\n        })\r\n    end)\r\nend\r\n\r\n-- ==================== AUTO HUNTING ====================\r\nTabs.Combat:Section({\r\n    Title='Hunting',\r\n    Icon='swords'\r\n})\r\n\r\n_G.AlienTechCombatToggle = Tabs.Combat:Toggle({\r\n    Title = 'Alien Tech Combat',\r\n    Desc = 'Moves beside hunted NPCs and keeps the camera on you. Weapon behaviour stays unchanged.',\r\n    Value = false,\r\n    Callback = function(value)\r\n        setAlienTechCombatState(value, false)\r\n    end\r\n})\r\npcall(function()\r\n    local frame = _G.AlienTechCombatToggle.ToggleFrame.UIElements.Main\r\n    if frame then frame.Visible = false end\r\nend)\r\n\r\ncustomHuntTarget=''\r\n_G.CustomHuntActive=false\r\n_G.CustomHuntCombatActive=false\r\ngetgenv().KixHub_CustomHunt_ToggleID=\r\n    getgenv().KixHub_CustomHunt_ToggleID or 0\r\n\r\nTabs.Combat:Input({\r\n    Title='Target Name',\r\n    Desc='Enter the exact name of the target. Case-sensitive. Examples: Hellephant, Mossy Mammoth, Polar Bear, Bear, Wolf, Alpha Wolf.',\r\n    Value='',\r\n    Placeholder='Example: Bear',\r\n    Callback=function(val)\r\n        customHuntTarget=tostring(val or '')\r\n    end\r\n})\r\n\r\nTabs.Combat:Toggle({\r\n    Title='Hunt Custom Target',\r\n    Desc='Turn OFF this toggle after hunting to return to Campfire and reset.',\r\n    Value=false,\r\n    Callback=function(val)\r\n        _G.CustomHuntActive=val\r\n        getgenv().KixHub_CustomHunt_ToggleID=\r\n            (getgenv().KixHub_CustomHunt_ToggleID or 0)+1\r\n\r\n        local myToggleID=getgenv().KixHub_CustomHunt_ToggleID\r\n\r\n        if val then\r\n            task.spawn(function()\r\n                while _G.CustomHuntActive\r\n                    and getgenv().KixHub_CustomHunt_ToggleID==myToggleID do\r\n\r\n                    task.wait(0.5)\r\n\r\n                    if not _G.CustomHuntActive\r\n                        or getgenv().KixHub_CustomHunt_ToggleID~=myToggleID then\r\n                        break\r\n                    end\r\n\r\n                    if _G.AutoChestRunning then\r\n                        continue\r\n                    end\r\n\r\n                    -- =================================================\r\n                    -- PRIORITY PALING RENDAH\r\n                    -- Jangan ganggu combat lain.\r\n                    -- =================================================\r\n                    if _G.IsStrongholdRaidActive\r\n                        or _G.CampfireCombatActive\r\n                        or _G.GlobalCultistCombatActive\r\n                        or _G.CorruptedCombatActive\r\n                        or _G.MossyCombatActive\r\n                        or _G.TurkeyCombatActive\r\n                        or _G.BearCombatActive then\r\n                        continue\r\n                    end\r\n\r\n                    pcall(function()\r\n                        if not _G.CustomHuntActive\r\n                            or getgenv().KixHub_CustomHunt_ToggleID~=myToggleID then\r\n                            return\r\n                        end\r\n\r\n                        local targetName=tostring(customHuntTarget or '')\r\n\r\n                        if targetName=='' then\r\n                            return\r\n                        end\r\n\r\n                        local chars=_Workspace:FindFirstChild('Characters')\r\n                        local myChar=_LocalPlayer.Character\r\n                        local hrp=myChar and myChar:FindFirstChild('HumanoidRootPart')\r\n\r\n                        if not chars or not hrp then\r\n                            return\r\n                        end\r\n\r\n                        -- =================================================\r\n                        -- CARI TARGET EXACT NAME\r\n                        -- =================================================\r\n                        local target=nil\r\n                        local targetHRP=nil\r\n                        local minDistance=math.huge\r\n\r\n                        for _,candidate in ipairs(chars:GetChildren()) do\r\n                            if candidate:IsA('Model')\r\n                                and candidate.Name==targetName\r\n                                and candidate:FindFirstChild('HumanoidRootPart') then\r\n\r\n                                local eHum=candidate:FindFirstChildWhichIsA('Humanoid')\r\n\r\n                                if not eHum or eHum.Health>0 then\r\n                                    local eHRP=candidate.HumanoidRootPart\r\n                                    local dist=\r\n                                        (eHRP.Position-hrp.Position).Magnitude\r\n\r\n                                    if dist<minDistance then\r\n                                        minDistance=dist\r\n                                        target=candidate\r\n                                        targetHRP=eHRP\r\n                                    end\r\n                                end\r\n                            end\r\n                        end\r\n\r\n                        -- =================================================\r\n                        -- TIDAK ADA TARGET\r\n                        -- KEMBALI KE RETURN POSITION SAJA\r\n                        -- =================================================\r\n                        if not target or not targetHRP then\r\n                            if not _G.IsStrongholdRaidActive and not _G.CampfireCombatActive then\r\n                                local fallbackPos=\r\n                                    customReturnPos\r\n                                    or campfirePos\r\n                                    or hrp.Position\r\n\r\n                                local distanceToReturn=\r\n                                    (\r\n                                        hrp.Position\r\n                                        -Vector3.new(\r\n                                            fallbackPos.X,\r\n                                            fallbackPos.Y+3,\r\n                                            fallbackPos.Z\r\n                                        )\r\n                                    ).Magnitude\r\n\r\n                                if distanceToReturn>3 then\r\n                                    hrp.Anchored=true\r\n                                    hrp.CFrame=\r\n                                        CFrame.new(\r\n                                            fallbackPos.X,\r\n                                            fallbackPos.Y+3,\r\n                                            fallbackPos.Z\r\n                                        )\r\n                                    task.wait(0.1)\r\n                                    hrp.Anchored=false\r\n                                end\r\n                            end\r\n\r\n                            return\r\n                        end\r\n\r\n                        -- =================================================\r\n                        -- FINAL PRIORITY CHECK\r\n                        -- =================================================\r\n                        if _G.IsStrongholdRaidActive\r\n                            or _G.CampfireCombatActive\r\n                            or _G.GlobalCultistCombatActive\r\n                            or _G.CorruptedCombatActive\r\n                            or _G.MossyCombatActive\r\n                            or _G.TurkeyCombatActive\r\n                            or _G.BearCombatActive then\r\n                            return\r\n                        end\r\n\r\n                        -- =================================================\r\n                        -- CUSTOM HUNT ACTIVE\r\n                        -- =================================================\r\n                        _G.CustomHuntCombatActive=true\r\n                        _G.AllowBodyAura=true\r\n\r\n                        local wasFlying=flying\r