O BAG LOGS ====================\r\n\r\nlocal function getAutoBagCampfirePosition()\r\n    local map = workspace:FindFirstChild(\"Map\")\r\n    local campground = map and map:FindFirstChild(\"Campground\")\r\n    local mainFire = campground and campground:FindFirstChild(\"MainFire\")\r\n\r\n    if not mainFire then\r\n        return nil\r\n    end\r\n\r\n    local center = mainFire:FindFirstChild(\"Center\", true)\r\n\r\n    if center then\r\n        if center:IsA(\"BasePart\") then\r\n            return center.Position\r\n        elseif center:IsA(\"Attachment\") then\r\n            return center.WorldPosition\r\n        end\r\n    end\r\n\r\n    if mainFire:IsA(\"BasePart\") then\r\n        return mainFire.Position\r\n    end\r\n\r\n    if mainFire:IsA(\"Model\") then\r\n        if mainFire.PrimaryPart then\r\n            return mainFire.PrimaryPart.Position\r\n        end\r\n\r\n        local success, pivot = pcall(function()\r\n            return mainFire:GetPivot()\r\n        end)\r\n\r\n        if success then\r\n            return pivot.Position\r\n        end\r\n    end\r\n\r\n    local part = mainFire:FindFirstChildWhichIsA(\"BasePart\", true)\r\n    return part and part.Position or nil\r\nend\r\n\r\nautoBagLogsLocalEnabled = false\r\n\r\nlocal autoStoreLogsToggle = Tabs.Auto:Toggle({\r\n    Title = \"🎒 Auto Store Logs in Sack\",\r\n    Desc = \"Stores Logs within 80 studs (Woodsman Class required).\",\r\n    Value = false,\r\n    Callback = function(val)\r\n        autoBagLogsLocalEnabled = val\r\n\r\n        if val then\r\n            task.spawn(function()\r\n                local warnedNoTool = false\r\n                local warnedNoRemote = false\r\n                local warnedNoCampfire = false\r\n\r\n                while autoBagLogsLocalEnabled do\r\n                    local char = _LocalPlayer.Character\r\n                    local hrp = char and char:FindFirstChild(\"HumanoidRootPart\")\r\n\r\n                    if char and hrp then\r\n                        local campfirePos = getAutoBagCampfirePosition()\r\n\r\n                        if not campfirePos then\r\n                            if not warnedNoCampfire then\r\n                                warnedNoCampfire = true\r\n                                warn(\"[KixHub] Campfire center not found. Auto Bag Logs is skipping all Logs until the position is available.\")\r\n                            end\r\n                        else\r\n                            warnedNoCampfire = false\r\n                        end\r\n\r\n                        local function findBagIn(folder)\r\n                            if not folder then\r\n                                return nil\r\n                            end\r\n\r\n                            for _, tool in ipairs(folder:GetChildren()) do\r\n                                if tool.Name == \"Item Bag\"\r\n                                    or tool.Name == \"Giant Sack\"\r\n                                    or tool:GetAttribute(\"ToolName\") == \"Item Bag\"\r\n                                    or tool:GetAttribute(\"NumberItems\") then\r\n                                    return tool\r\n                                end\r\n                            end\r\n\r\n                            return nil\r\n                        end\r\n\r\n                        local bagTool =\r\n                            findBagIn(char)\r\n                            or findBagIn(_LocalPlayer:FindFirstChild(\"Backpack\"))\r\n                            or findBagIn(_LocalPlayer:FindFirstChild(\"Inventory\"))\r\n                            or findBagIn(char:FindFirstChild(\"Inventory\"))\r\n\r\n                        if bagTool then\r\n                            warnedNoTool = false\r\n\r\n                            local itemsFolder =\r\n                                workspace:FindFirstChild(\"Items\")\r\n                                or workspace:FindFirstChild(\"items\")\r\n\r\n                     