ion radius.\r\n                                                    if dist <= 80 and campfireDist >= 200 then\r\n                                                        item:SetAttribute(\"KixHubBagging\", true)\r\n\r\n                                                        local oldParent = item.Parent\r\n\r\n                                                        if ts then\r\n                                                            pcall(function()\r\n                                                                item.Parent = ts\r\n                                                            end)\r\n                                                        end\r\n\r\n                                                        task.spawn(function()\r\n                                                            local success, res = pcall(function()\r\n                                                                if storeRemote:IsA(\"RemoteFunction\") then\r\n                                                                    return storeRemote:InvokeServer(bagTool, item)\r\n                                                                else\r\n                                                                    return storeRemote:FireServer(bagTool, item)\r\n                                                                end\r\n                                                            end)\r\n\r\n                                                            if not success\r\n                                                                or (type(res) == \"table\" and not res.Success) then\r\n\r\n                                                                pcall(function()\r\n                                                                    if item and oldParent then\r\n                                                                        item.Parent = oldParent\r\n                                                                        item:SetAttribute(\"KixHubBagging\", nil)\r\n                                                                    end\r\n                                                                end)\r\n                                                            end\r\n                                                        end)\r\n\r\n                                                        task.wait(0.02)\r\n                                                    end\r\n                                                end\r\n                                            end\r\n                                        end\r\n                                    end\r\n                                else\r\n                                    if not warnedNoRemote then\r\n                                        warnedNoRemote = true\r\n                                        warn(\"[KixHub] Error: RequestBagStoreItem remote not found!\")\r\n                                    end\r\n                                end\r\n                            end\r\n                        else\r\n                            if not warnedNoTool then\r\n                                warnedNoTool = true\r\n                                warn(\"[KixHub] Error: Item Bag tool not found in Inventory!\")\r\n                            end\r\n                        end\r\n                    end\r\n\r\n                    task.wait(0.1)\r\n                end\r\n            end)\r\n        end\r\n    end\r\n})\r\npcall(function()\r\n    local row = autoStoreLogsToggle\r\n        and autoStoreLogsToggle.ToggleFrame\r\n        and autoStoreLogsToggle.ToggleFrame.UIElements\r\n        and autoStoreLogsToggle.ToggleFrame.UIElements.Main\r\n    if row then\r\n        row.Visible = false\r\n        row.Size = UDim2.new(0, 0, 0, 0)\r\n    end\r\nend)\r\n\r\n-- ==================== AUTO EAT ====================\r\nTabs.Auto:Section({Title = 'Auto Eat', Icon = 'utensils'})\r\n\r\nautoEatEnabled = false\r\nautoEatStewEnabled = false\r\nautoEatThreshold = 20 -- Start eating at <= 20%\r\nlocal AUTO_EAT_STEW_NAMES = {\r\n    Stew = true, [\"Hearty Stew\"] = true, [\"Seafood Chowder\"] = true,\r\n    [\"Steak Dinner\"] = true, [\"Pumpkin Soup\"] = true, [\"BBQ Ribs\"] = true,\r\n}\r\nlocal AUTO_EAT_SELECTED_ITEMS = {\r\n    [\"Stew\"] = true, [\"Hearty Stew\"] = true,\r\n    [\"Pumpkin\"] = true, [\"Berry\"] = true, [\"Corn\"] = true,\r\n    [\"Cooked Morsel\"] = true, [\"Cooked Steak\"] = true, [\"Carrot\"] = true,\r\n    [\"Apple\"] = true, [\"Cooked Ribs\"] = true, [\"Carrot Cake\"] = true,\r\n}\r\n_G.KixAutoEatSelectedFoodNames = AUTO_EAT_SELECTED_ITEMS\r\nlocal function isAutoEatStewName(name)\r\n    return AUTO_EAT_STEW_NAMES[name] == true and AUTO_EAT_SELECTED_ITEMS[name] == true\r\nend\r\nlocal AUTO_EAT_SLOT_KEYS = {\r\n    [1] = Enum.KeyCode.One, [2] = Enum.KeyCode.Two, [3] = Enum.KeyCode.Three,\r\n    [4] = Enum.KeyCode.Four, [5] = Enum.KeyCode.Five, [6] = Enum.KeyCode.Six,\r\n    [7] = Enum.KeyCode.Seven, [8] = Enum.KeyCode.Eight, [9] = Enum.KeyCode.Nine,\r\n}\r\n\r\nlocal function getAutoEatFoodSlot()\r\n    -- Mengembalikan: keyCode (jika di hotbar 1-9), foodInstance (jika di inventory/bag), uiButton (referensi UI)\r\n    local keyCode = nil\r\n    local foodInstance = nil\r\n    local uiButton = nil\r\n    \r\n    -- 1. Cek di Hotbar UI terlebih dahulu (Prioritas Utama: VIM 1-9)\r\n    pcall(function()\r\n        local playerGui = _LocalPlayer:FindFirstChild(\"PlayerGui\")\r\n        local hotbar = playerGui and playerGui:FindFirstChild(\"Interface\") and playerGui.Interface:FindFirstChild(\"Hotbar\")\r\n        if hotbar then\r\n            for _, btn in ipairs(hotbar:GetChildren()) do\r\n                local slotNum = nil\r\n                local numNode = btn:FindFirstChild(\"Number\")\r\n                if numNode and numNode:IsA(\"TextLabel\") then\r\n                    slotNum = tonumber(numNode.Text)\r\n                end\r\n                \r\n                if slotNum then\r\n                    local isFood = false\r\n                    for _, desc in ipairs(btn:GetChildren()) do\r\n                        if (desc:IsA(\"ObjectValue\") or desc:IsA(\"StringValue\")) and desc.Value then\r\n                            local valName = typeof(desc.Value) == \"Instance\" and desc.Value.Name or tostring(desc.Value)\r\n                            if isAutoEatStewName(valName) then\r\n                                isFood = true\r\n                                if typeof(desc.Value) == \"Instance\" then foodInstance = desc.Value end\r\n                                break\r\n                            end\r\n                        end\r\n                    end\r\n                    if not isFood then\r\n                        local itemName = btn.Name:gsub(\"^Button\", \"\")\r\n                        if isAutoEatStewName(itemName) then\r\n                            isFood = true\r\n                        else\r\n                            for _, desc in ipairs(btn:GetDescendants()) do\r\n                                if desc:IsA(\"TextLabel\") and isAutoEatStewName(desc.Text) then\r\n                                    isFood = true\r\n                                    break\r\n                                end\r\n                            end\r\n                        end\r\n                    end\r\n                    if isFood then\r\n                        uiButton = btn\r\n                        keyCode = AUTO_EAT_SLOT_KEYS[slotNum]\r\n                        break\r\n                    end\r\n                end\r\n            end\r\n        end\r\n    end)\r\n    \r\n    if keyCode then\r\n        return keyCode, foodInstance, uiButton\r\n    end\r\n    \r\n    -- 2. Jika tidak ada di hotbar 1-9, cari di Inventory/ItemBag sebagai fallback (Metode Remote)\r\n    local inv = _LocalPlayer:FindFirstChild(\"Inventory\")\r\n    local bag = _LocalPlayer:FindFirstChild(\"ItemBag\")\r\n    \r\n    local function searchFolder(folder)\r\n        if not folder then return nil end\r\n        for _, item in ipairs(folder:GetChildren()) do\r\n            if isAutoEatStewName(item.Name) then return item end\r\n        end\r\n        for foodName in pairs(AUTO_EAT_STEW_NAMES) do\r\n            local item = folder:FindFirstChild(foodName)\r\n            if item then return item end\r\n        end\r\n        return nil\r\n    end\r\n    \r\n    foodInstance = searchFolder(inv) or searchFolder(bag)\r\n        or searchFolder(_LocalPlayer:FindFirstChild(\"Backpack\")) or searchFolder(_LocalPlayer.Character)\r\n    return nil, foodInstance, nil\r\nend\r\n\r\nlocal function unequipAutoEatFood(keyCode, foodItem, uiButton)\r\n    local inventoryHandler = Client and Client.InventoryHandler\r\n    local currentItem\r\n    if inventoryHandler and type(inventoryHandler.GetCurrentlyEquipped) == \"function\" then\r\n        pcall(function() currentItem = inventoryHandler.GetCurrentlyEquipped() end)\r\n    end\r\n\r\n    local currentIsStew = currentItem and isAutoEatStewName(currentItem.Name)\r\n    local isEquipped = currentIsStew == true\r\n    if not currentItem and uiButton then\r\n        local stroke = uiButton:FindFirstChild(\"EquippedStroke\")\r\n        isEquipped = stroke and stroke:IsA(\"UIStroke\") and stroke.Enabled == true or false\r\n    end\r\n    if not currentItem and not isEquipped and foodItem then\r\n        local char = _LocalPlayer.Character\r\n        local handle = char and char:FindFirstChild(\"ToolHandle\")\r\n        local original = handle and handle:FindFirstChild(\"OriginalItem\")\r\n        isEquipped = (char and char:FindFirstChild(foodItem.Name) ~= nil)\r\n            or (original and original:IsA(\"ObjectValue\") and original.Value == foodItem) or false\r\n    end\r\n\r\n    if not isEquipped then return end\r\n\r\n    -- InventoryHandler exposes UnequipCurrentItem() (no item argument).\r\n    if inventoryHandler and type(inventoryHandler.UnequipCurrentItem) == \"function\" then\r\n        local ok = pcall(function() inventoryHandler.UnequipCurrentItem() end)\r\n        if ok then return end\r\n    end\r\n\r\n    if keyCode then\r\n        pcall(function()\r\n            local vim = game:GetService(\"VirtualInputManager\")\r\n            vim:SendKeyEvent(true, keyCode, false, game)\r\n            task.wait(0.05)\r\n            vim:SendKeyEvent(false, keyCode, false, game)\r\n        end)\r\n        return\r\n    end\r\n\r\n    local remoteEvents = _ReplicatedStorage:FindFirstChild(\"RemoteEvents\")\r\n    local unequipRemote = remoteEvents and remoteEvents:FindFirstChild(\"UnequipItemHandle\")\r\n    if unequipRemote then\r\n        pcall(function() unequipRemote:FireServer(\"FireAllClients\", foodItem) end)\r\n    end\r\nend\r\n\r\nlocal function getHungerPercent()\r\n    local result = -1\r\n    pcall(function()\r\n        local pg = _LocalPlayer:FindFirstChild(\"PlayerGui\")\r\n        if pg then\r\n            local bar = pg:FindFirstChild(\"Interface\") and pg.Interface:FindFirstChild(\"StatBars\") and pg.Interface.StatBars:FindFirstChild(\"HungerBar\") and pg.Interface.StatBars.HungerBar:FindFirstChild(\"Bar\")\r\n            if bar then\r\n                result = math.floor(bar.Size.X.Scale * 100)\r\n            end\r\n        end\r\n    end)\r\n    return result\r\nend\r\n\r\nAutoEatStatus = Tabs.Auto:Paragraph({\r\n    Title = \"Auto Eat Status\",\r\n    Desc = \"Status: Disabled | Hunger: --\"\r\n})\r\n\r\ntask.spawn(function()\r\n    while KixHubSession.Alive and task.wait(1) do\r\n        if not autoEatEnabled then\r\n            local hunger = getHungerPercent()\r\n            if hunger >= 0 then\r\n                AutoEatStatus:SetDesc(string.format(\"Status: Disabled | Hunger: %d%%\", hunger))\r\n            end\r\n        end\r\n    end\r\nend)\r\n\r\n_G.KixEngines.AutoEat = function(val)\r\n        val = val == true\r\n        if val == (autoEatStewEnabled == true)\r\n            and (not val or (_G.KixEngines.TaskCounts.AutoEat or 0) > 0) then return end\r\n        _G.KixEngines.Errors.AutoEat = nil\r\n        local engineTokens = _G.KixEngines.Tokens\r\n        engineTokens.AutoEat = (engineTokens.AutoEat or 0) + 1\r\n        local engineToken = engineTokens.AutoEat\r\n        autoEatStewEnabled = val\r\n\r\n        if not val then\r\n            _G.IsEating = false\r\n            AutoEatStatus:SetDesc(\"Status: Disabled | Hunger: --\")\r\n            return\r\n        end\r\n\r\n        _G.KixEngines.Spawn(\"AutoEat\", function()\r\n            local Client\r\n            pcall(function() Client = require(_LocalPlayer.PlayerScripts.Client) end)\r\n            -- Keep the no-food warning latched for this Auto Eat run, rather than\r\n            -- resetting it on every hunger cycle in the outer monitoring loop.\r\n            local hasToastedNoFood = false\r\n            while autoEatStewEnabled and engineTokens.AutoEat == engineToken do\r\n                if _G.KixRescueBusy then task.wait(0.2); continue end\r\n                local hunger = getHungerPercent()\r\n\r\n                if hunger >= 0 then\r\n                    AutoEatStatus:SetDesc(string.format(\"Status: Monitoring | Hunger: %d%%\", hunger))\r\n                end\r\n\r\n                if hunger >= 0 and hunger <= autoEatThreshold then\r\n                    _G.IsEating = true\r\n                    AutoEatStatus:SetDesc(string.format(\"Status: Eating! | Hunger: %d%%\", hunger))\r\n\r\n                    local lastHunger = hunger\r\n                    local stuckCount = 0\r\n                    local hasToastedEating = false\r\n                    \r\n                    local activeKeyCode = nil\r\n                    local activeFoodItem = nil\r\n                    local activeUIButton = nil\r\n\r\n                    while autoEatStewEnabled and engineTokens.AutoEat == engineToken do\r\n                        local keyCode, foodItem, uiButton = getAutoEatFoodSlot()\r\n                        if keyCode then activeKeyCode = keyCode end\r\n                        if foodItem then activeFoodItem = foodItem end\r\n                        if uiButton then activeUIButton = uiButton end\r\n\r\n                        local currentHunger = getHungerPercent()\r\n                        if currentHunger < 0 or currentHunger >= 95 then\r\n                            _G.IsEating = false\r\n                            break\r\n                        end\r\n\r\n                        AutoEatStatus:SetDesc(string.format(\"Status: Eating... | Hunger: %d%%\", currentHunger))\r\n\r\n                        if currentHunger == lastHunger then\r\n                            stuckCount = stuckCount + 1\r\n                        else\r\n                            stuckCount = 0\r\n                        end\r\n                        lastHunger = currentHunger\r\n\r\n                        if stuckCount > 4 then\r\n                            _G.IsEating = false\r\n                            AutoEatStatus:SetDesc(\"Status: Stuck! (No Food?)\")\r\n                            if not hasToastedNoFood then\r\n                                hasToastedNoFood = true\r\n                                if WindUI then\r\n                                    WindUI:Notify({Title=\"Auto Eat Failed\", Content=\"Place selected food in Hotbar 1-9 or check inventory.\", Duration=10, Icon=\"x\"})\r\n                                end\r\n                            end\r\n                            task.wait(2)\r\n                            break\r\n                        end\r\n                        \r\n                        -- Cek status equip\r\n                        local isFoodEquipped = false\r\n                        if uiButton then\r\n                            local stroke = uiButton:FindFirstChild(\"EquippedStroke\")\r\n                            if stroke and stroke:IsA(\"UIStroke\") then\r\n                                isFoodEquipped = stroke.Enabled\r\n                            end\r\n                        end\r\n                        if not isFoodEquipped and foodItem then\r\n                            local char = _LocalPlayer.Character\r\n                            if char and char:FindFirstChild(foodItem.Name) then\r\n                                isFoodEquipped = true\r\n                            end\r\n                        end\r\n\r\n                        -- Try the consume request before equipping. Some game\r\n                        -- patches accept an owned food model directly; if not,\r\n                        -- fall back to the normal hotbar/equip interaction below.\r\n                        local consumedWithoutEquip = false\r\n                        if foodItem and not isFoodEquipped and Client and Client.Events\r\n                            and Client.Events.RequestConsumeItem then\r\n                            local beforeParent = foodItem.Parent\r\n                            local consumeOk, consumeResult = pcall(function()\r\n                                return Client.Events.RequestConsumeItem:InvokeServer(foodItem)\r\n                            end)\r\n                            task.wait(0.2)\r\n                            local afterHunger = getHungerPercent()\r\n                            local accepted = consumeResult == true\r\n                                or (type(consumeResult) == 'table' and consumeResult.Success == true)\r\n                            consumedWithoutEquip = consumeOk and (accepted\r\n                                or (afterHunger >= 0 and afterHunger > currentHunger)\r\n                                or foodItem.Parent ~= beforeParent)\r\n                        end\r\n\r\n                        if consumedWithoutEquip then\r\n                            if not hasToastedEating then\r\n                                hasToastedEating = true\r\n                                if WindUI then\r\n                                    WindUI:Notify({Title=\"Auto Eat\", Content=\"Delicious!\", Duration=5, Icon=\"utensils\"})\r\n                                end\r\n                            end\r\n                            task.wait(0.2)\r\n                            continue\r\n                        end\r\n\r\n                        if keyCode then\r\n                            if not hasToastedEating then\r\n                                hasToastedEating = true\r\n                                if WindUI then\r\n                                    WindUI:Notify({Title=\"Auto Eat\", Content=\"Delicious!\", Duration=5, Icon=\"utensils\"})\r\n                                end\r\n                            end\r\n\r\n                            -- Tekan tombol angka untuk equip HANYA jika belum ter-equip\r\n                            if not isFoodEquipped then\r\n                                pcall(function()\r\n                                    local vim = game:GetService(\"VirtualInputManager\")\r\n                                    vim:SendKeyEvent(true, keyCode, false, game)\r\n                                    task.wait(0.05)\r\n                                    vim:SendKeyEvent(false, keyCode, false, game)\r\n                                end)\r\n                                task.wait(0.25)\r\n                            end\r\n\r\n                        elseif foodItem then\r\n                            if not hasToastedEating then\r\n                                hasToastedEating = true\r\n                                if WindUI then\r\n                                    WindUI:Notify({Title=\"Auto Eat\", Content=\"Instant Eat\", Duration=5, Icon=\"utensils\"})\r\n                                end\r\n                            end\r\n\r\n                            if not isFoodEquipped then\r\n                                if Client and Client.InventoryHandler and Client.InventoryHandler.RequestEquipItem then\r\n                                    pcall(function() Client.InventoryHandler.RequestEquipItem(foodItem) end)\r\n                                    task.wait(0.25)\r\n                                end\r\n                            end\r\n                        end\r\n                        \r\n                        if keyCode or foodItem then\r\n                            -- The remote-only attempt above was not confirmed; use\r\n                            -- the established consume request after equipping.\r\n                            if foodItem and foodItem.Parent and Client and Client.Events and Client.Events.RequestConsumeItem then\r\n                                pcall(function()\r\n                                    Client.Events.RequestConsumeItem:InvokeServer(foodItem)\r\n                                end)\r\n                            end\r\n                            -- Klik layar untuk makan\r\n                            pcall(function()\r\n                                local cam = workspace.CurrentCamera\r\n                                local viewSize = cam and cam.ViewportSize or Vector2.new(800, 600)\r\n                                _G.SafeVirtualClick(viewSize.X/2, viewSize.Y/2)\r\n                                _G.SafeVirtualClick(math.floor(viewSize.X - 50), 50)\r\n                            end)\r\n                            task.wait(0.8)\r\n                        else\r\n                            _G.IsEating = false\r\n                            AutoEatStatus:SetDesc(\"Status: No selected food found\")\r\n                            if not hasToastedNoFood then\r\n                                hasToastedNoFood = true\r\n                                if WindUI then\r\n                                    WindUI:Notify({Title=\"Auto Eat Failed\", Content=\"Place selected food in Hotbar 1-9 or check inventory.\", Duration=10, Icon=\"x\"})\r\n                                end\r\n                            end\r\n                            task.wait(3)\r\n                            break\r\n                        end\r\n                    end\r\n\r\n                    -- Clean up the held stew on every exit: full hunger, toggle\r\n                    -- off, no food, or a stalled consume cycle.\r\n                    if activeKeyCode or activeFoodItem or activeUIButton then\r\n                        unequipAutoEatFood(activeKeyCode, activeFoodItem, activeUIButton)\r\n                        task.wait(0.1)\r\n                    end\r\n\r\n                    local finalHunger = getHungerPercent()\r\n                    if finalHunger >= 0 then\r\n                        AutoEatStatus:SetDesc(string.format(\"Status: Full! | Hunger: %d%%\", finalHunger))\r\n                    end\r\n                end\r\n\r\n                task.wait(2)\r\n            end\r\n\r\n            if engineTokens.AutoEat == engineToken then\r\n                _G.IsEating = false\r\n                AutoEatStatus:SetDesc(\"Status: Disabled | Hunger: --\")\r\n            end\r\n        end)\r\nend\r\n\r\n_G.AutoEatToggle = Tabs.Auto:Toggle({\r\n    Title = '🍽️ Auto Eat',\r\n    Desc = 'Prefers Stew from Hotbar/inventory; otherwise eats selected fresh food.',\r\n    Value = true,\r\n    Callback = function(value)\r\n        local controller = _G.KixFullAuto\r\n        if value == false and controller then\r\n            controller.Owned[\"AutoEat\"] = nil\r\n            if controller.Suspended then controller.Suspended[\"AutoEat\"] = nil end\r\n        end\r\n        return _G.KixEngines.AutoEat(value)\r\n    end\r\n})\r\n\r\n-- Stew meals remain owned by the separate Auto Eat Stew engine above.\r\ndo\r\n    local function INIT_AUTO_EAT_FRESH_FOOD()\r\n        local FOOD_THRESHOLD = autoEatThreshold\r\n        local FOOD_TARGET = 95\r\n        local freshFoodOptions = {\r\n            \"Cooked Steak\", \"Cooked Morsel\", \"Berry\", \"Carrot\", \"Cake\", \"Corn\", \"Pumpkin\",\r\n            \"Chilli\", \"Apple\", \"Cooked Ribs\", \"Meat? Sandwich\", \"Carrot Cake\", \"Jar o' Jelly\",\r\n            \"Cooked Mackerel\", \"Cooked Salmon\", \"Cooked Clownfish\", \"Cooked Char\", \"Cooked Eel\",\r\n            \"Cooked Swordfish\", \"Cooked Shark\", \"Cooked Lava Eel\", \"Cooked Lionfish\",\r\n        }\r\n        local foodOptions, allowedFoods, selectedFoods, selectedLookup = {}, {}, {}, {}\r\n        for _, name in ipairs({\"Stew\", \"Hearty Stew\", \"Seafood Chowder\", \"Steak Dinner\", \"Pumpkin Soup\", \"BBQ Ribs\"}) do\r\n            foodOptions[#foodOptions + 1] = name\r\n            allowedFoods[name] = true\r\n        end\r\n        for _, name in ipairs(freshFoodOptions) do\r\n            foodOptions[#foodOptions + 1] = name\r\n            allowedFoods[name] = true\r\n        end\r\n        for _, name in ipairs(foodOptions) do\r\n            if AUTO_EAT_SELECTED_ITEMS[name] then\r\n                selectedLookup[name] = true\r\n                selectedFoods[#selectedFoods + 1] = name\r\n            end\r\n        end\r\n\r\n        local foodEnabled = false\r\n        local lastFoodStatus\r\n        local function setFoodStatus(text)\r\n            if _G.KixAutoEatMode ~= \"Food\" then return end\r\n            if text == lastFoodStatus then return end\r\n            lastFoodStatus = text\r\n            pcall(function() AutoEatStatus:SetDesc(\"Status: \" .. text) end)\r\n        end\r\n\r\n        local function sanitizeSelection(value)\r\n            local result, seen = {}, {}\r\n            if type(value) ~= \"table\" then value = {value} end\r\n            for _, name in ipairs(value) do\r\n                if allowedFoods[name] and not seen[name] then\r\n                    seen[name] = true\r\n                    result[#result + 1] = name\r\n                end\r\n            end\r\n            return result\r\n        end\r\n\r\n        Tabs.Auto:Dropdown({\r\n            Title = \"Foods to Eat\",\r\n            Desc = \"Choose which meals and food items Auto Eat can use.\",\r\n            Values = foodOptions,\r\n            Value = (function()\r\n                local values = {}\r\n                for _, name in ipairs(foodOptions) do\r\n                    if AUTO_EAT_SELECTED_ITEMS[name] then values[#values + 1] = name end\r\n                end\r\n                return values\r\n            end)(),\r\n            Multi = true,\r\n            AllowNone = true,\r\n            Callback = function(value)\r\n                local selection = sanitizeSelection(value)\r\n                table.clear(AUTO_EAT_SELECTED_ITEMS)\r\n                selectedLookup = {}\r\n                selectedFoods = {}\r\n                for _, name in ipairs(selection) do\r\n                    AUTO_EAT_SELECTED_ITEMS[name] = true\r\n                    selectedLookup[name] = true\r\n                    selectedFoods[#selectedFoods + 1] = name\r\n                end\r\n            end,\r\n        })\r\n\r\n        local function setAutoEatFood(value)\r\n            value = value == true\r\n            if value == foodEnabled\r\n                and (not value or (_G.KixEngines.TaskCounts.AutoEatFood or 0) > 0) then return end\r\n            _G.KixEngines.Errors.AutoEatFood = nil\r\n            local tokens = _G.KixEngines.Tokens\r\n            tokens.AutoEatFood = (tokens.AutoEatFood or 0) + 1\r\n            local token = tokens.AutoEatFood\r\n            foodEnabled = value\r\n            if not value then\r\n                if _G.KixAutoEatMode ~= \"Stew\" then _G.IsEating = false end\r\n                setFoodStatus(\"Disabled\")\r\n                return\r\n            end\r\n\r\n            _G.KixEngines.Spawn(\"AutoEatFood\", function()\r\n                local player = _LocalPlayer\r\n                local itemFolder, folderConnections = nil, {}\r\n                local buckets = {}\r\n                local indexedName = setmetatable({}, {__mode = \"k\"})\r\n                local itemConnections = setmetatable({}, {__mode = \"k\"})\r\n                local busyItems = setmetatable({}, {__mode = \"k\"})\r\n                local retryAt = setmetatable({}, {__mode = \"k\"})\r\n                local refilling, trackedCharacter = false, nil\r\n                local workCount, workStarted = 0, os.clock()\r\n                local function active()\r\n                    return KixHubSession.Alive and foodEnabled and tokens.AutoEatFood == token\r\n                end\r\n                local function wait(seconds)\r\n                    if not active() then return false end\r\n                    task.wait(seconds or 0)\r\n                    return active()\r\n                end\r\n                local function budget()\r\n                    workCount = workCount + 1\r\n                    if workCount >= 32 or os.clock() - workStarted >= 0.001 then\r\n                        workCount, workStarted = 0, os.clock()\r\n                        task.wait()\r\n                        return active()\r\n                    end\r\n                    return active()\r\n                end\r\n                local function disconnect(connection)\r\n                    if connection then pcall(function() connection:Disconnect() end) end\r\n                end\r\n                local function removeItem(item)\r\n                    local name = indexedName[item]\r\n                    local bucket = name and buckets[name]\r\n                    if bucket then\r\n                        bucket[item] = nil\r\n                        if not next(bucket) then buckets[name] = nil end\r\n                    end\r\n                    indexedName[item] = nil\r\n                    disconnect(itemConnections[item])\r\n                    itemConnections[item] = nil\r\n                end\r\n                local function refreshItem(item)\r\n                    local oldName = indexedName[item]\r\n                    local bucket = oldName and buckets[oldName]\r\n                    if bucket then\r\n                        bucket[item]