m)) then\r\n                pcall(function() remote:InvokeServer(item) end)\r\n                count += 1\r\n                if count % 100 == 0 then task.wait() end\r\n            end\r\n        end\r\n        local totalCoins = count * 5\r\n        if count > 0 then\r\n            if _G.TotalCoins then\r\n                _G.TotalCoins += totalCoins\r\n                if _G.SaveScriptStats then _G.SaveScriptStats() end\r\n            end\r\n            if WindUI then WindUI:Notify({Title = \"Coin Collect\", Content = \"Collected \" .. totalCoins .. \" Coins!\", Duration = 3}) end\r\n        end\r\n    end\r\n    Tabs.Bring:Button({Title = 'Collect All Coin Stacks', Desc = 'Instantly collects all Coin Stacks', Callback = function() task.spawn(_G.CollectAllCoinStacks) end})\r\n\r\nend)()\r\n\r\nTabs.Info:Select()\r\n\r\ninCave = false\r\nwasNoFogOn = false\r\n\r\n\r\nWindUI:Notify({\r\n    Title = \"KIX HUB Loaded\",\r\n    Content = \"Press 'G' to toggle the UI.\",\r\n    Duration = 5\r\n})\r\n\r\n-- Force bypass AttemptPlaceItem removed as ContentCreator handles it naturally.\r\n\r\n-- ==================== CLEANUP LOGIC ====================\r\ngetgenv().KixHubCleanup = function()\r\n    -- 0. Save current state\r\n    getgenv().KixHubSavedState = {\r\n        WalkSpeed = WalkSpeedEnabled,\r\n        TargetWalkSpeed = TargetWalkSpeed,\r\n        InfJump = InfiniteJumpEnabled,\r\n        InstantInteract = InstantInteractEnabled,\r\n        NoFog = NoFogEnabled,\r\n        KillAura = (_G.KixAuraEquipPause and _G.KixAuraEquipPause.Equipped)\r\n            and _G.KixAuraEquipPause.Resume or killAuraEnabled,\r\n        ChopAura = chopAuraEnabled,\r\n        AutoCamp = autoUpgCamp,\r\n        AutoScrap = autoScrap,\r\n        AutoScrapItems = table.clone(_G.KixAutoScrapTargets or {\"All\"}),\r\n        AutoCook = autoCook,\r\n        AutoSacrifice = autoSacrifice,\r\n        HUDOn = _G.HUDOn,\r\n        customReturnPos = KixHubSavedState.customReturnPos\r\n    }\r\n\r\n    if _G.KixEngines and _G.KixEngines.CleanupProtection then\r\n        pcall(_G.KixEngines.CleanupProtection)\r\n    end\r\n\r\n    -- 1. Stop all toggles\r\n    WalkSpeedEnabled = false\r\n    InfiniteJumpEnabled = false\r\n    InstantInteractEnabled = false\r\n    NoFogEnabled = false\r\n    killAuraEnabled = false\r\n    chopAuraEnabled = false\r\n    autoUpgCamp = false\r\n    if _G.KixAutoScrapSet then pcall(_G.KixAutoScrapSet, false) end\r\n    autoScrap = false\r\n    autoCook = false\r\n    autoSacrifice = false\r\n\r\n    -- 2. Disconnect connections\r\n    if walkSpeedConn then walkSpeedConn:Disconnect() end\r\n    if flyConnection then flyConnection:Disconnect() end\r\n    if rsConn then rsConn:Disconnect() end\r\n    if fbConn then fbConn:Disconnect(); fbConn = nil end\r\n    if _G.KixStatsFPSConnection then\r\n        _G.KixStatsFPSConnection:Disconnect()\r\n        _G.KixStatsFPSConnection = nil\r\n    end\r\n    pcall(stopNoclip)\r\n    if tickConn then task.cancel(tickConn) tickConn = nil end\r\n    if _G.GodModeConn then _G.GodModeConn:Disconnect() end\r\n    if espLoop then espLoop:Disconnect() end\r\n    if hudConn then hudConn:Disconnect() end\r\n    \r\n    for _, bg in pairs(_G.playerBillboards or {}) do if bg then bg:Destroy() end end\r\n    table.clear(_G.playerBillboards or {})\r\n    if hudFps then hudFps:Remove() end\r\n    if hudPing then hudPing:Remove() end\r\n\r\n    -- 3. Restore characters\r\n    if humanoid then humanoid.WalkSpeed = 16 end\r\n    _G.GodModeNaN = false\r\n    pcall(function() stopFlying() end)\r\n    pcall(function() restoreFog() end)\r\n    \r\n\r\n    -- 4. Destroy UI safely\r\n    if getgenv().KixHubWindow then\r\n        pcall(function() getgenv().KixHubWindow:Destroy() end)\r\n        getgenv().KixHubWindow = nil\r\n    end\r\n    getgenv().KixHubCleanup = nil\r\nend\r\n\r\ntask.spawn(function()\r\n    -- ==================== TREE TAB (AUTO PLANT) ====================\r\n    local KixTreeConfig = {\r\n        plantDelay = 0.05,\r\n        amountPerLayer = 200,\r\n        layers = 1,\r\n        layerSpacing = 15,\r\n        circleRadius = 2,\r\n        plantHeight = 0,\r\n        shape = \"Circle\",\r\n        centerMode = \"Player\"\r\n    }\r\n    \r\n    local treeRaycastParams=RaycastParams.new()\r\n    treeRaycastParams.FilterType=Enum.RaycastFilterType.Include\r\n\r\n    local function getGroundY(xzPos,defaultY)\r\n        local map=_Workspace:FindFirstChild(\"Map\")\r\n        local ground=map and map:FindFirstChild(\"Ground\")\r\n        local snow=map and map:FindFirstChild(\"Snow\")\r\n        local includeList={}\r\n        \r\n        if ground then\r\n            table.insert(includeList,ground)\r\n        end\r\n        \r\n        if snow then\r\n            table.insert(includeList,snow)\r\n        end\r\n        \r\n        treeRaycastParams.FilterDescendantsInstances=includeList\r\n        \r\n        local origin=Vector3.new(\r\n            xzPos.X,\r\n            (defaultY or xzPos.Y)+50,\r\n            xzPos.Z\r\n        )\r\n        \r\n        local result=_Workspace:Raycast(\r\n            origin,\r\n            Vector3.new(0,-600,0),\r\n            treeRaycastParams\r\n        )\r\n        \r\n        if result then\r\n            return result.Position.Y\r\n        end\r\n        \r\n        return defaultY or xzPos.Y\r\n    end\r\n    \r\n    local function getTargetCenter()\r\n        if KixTreeConfig.centerMode == \"Campfire\" then\r\n            if workspace.Map.Campground.MainFire.PrimaryPart then return workspace.Map.Campground.MainFire.PrimaryPart.Position end\r\n        end\r\n        return _LocalPlayer.Character and _LocalPlayer.Character.PrimaryPart and _LocalPlayer.Character.PrimaryPart.Position or Vector3.new()\r\n    end\r\n    \r\n    local function getCirclePos(center, radius, count)\r\n        local pos = {}\r\n        local step = (2 * math.pi) / count\r\n        for i=0, count-1 do table.insert(pos, center + Vector3.new(math.cos(i*step)*radius, 0, math.sin(i*step)*radius)) end\r\n        return pos\r\n    end\r\n    \r\n    local function getSquarePos(center, radius, count)\r\n        local pos = {}\r\n        if count == 1 then return {center} end\r\n        local side = 2 * radius\r\n        for i=0, count-1 do\r\n            local p = (i/count) * 4\r\n            local e = math.floor(p)\r\n            local t = p - e\r\n            local x, z = 0, 0\r\n            if e == 0 then x = -radius + (t * side); z = -radius\r\n            elseif e == 1 then x = radius; z = -radius + (t * side)\r\n            elseif e == 2 then x = radius - (t * side); z = radius\r\n            elseif e == 3 then x = -radius; z = radius - (t * side) end\r\n            table.insert(pos, center + Vector3.new(x, 0, z))\r\n        end\r\n        return pos\r\n    end\r\n    \r\n    local function getTrianglePos(center, radius, count)\r\n        local pos = {}\r\n        if count == 1 then return {center} end\r\n        local v0, v1, v2 = Vector3.new(0, 0, -radius), Vector3.new(radius*0.866, 0, radius*0.5), Vector3.new(-radius*0.866, 0, radius*0.5)\r\n        for i=0, count-1 do\r\n            local p = (i/count) * 3\r\n            local e, t = math.floor(p), p - math.floor(p)\r\n            table.insert(pos, center + (e==0 and v0:Lerp(v1,t) or e==1 and v1:Lerp(v2,t) or v2:Lerp(v0,t)))\r\n        end\r\n        return pos\r\n    end\r\n    \r\n    local function getStarPos(center, radius, count)\r\n        local pos = {}\r\n        if count == 1 then return {center} end\r\n        local pts = {}\r\n        for i=0, 4 do\r\n            local a = (i * math.pi * 2 / 5) - (math.pi / 2)\r\n            table.insert(pts, Vector3.new(math.cos(a)*radius, 0, math.sin(a)*radius))\r\n            local ia = a + (math.pi / 5)\r\n            table.insert(pts, Vector3.new(math.cos(ia)*(radius*0.382), 0, math.sin(ia)*(radius*0.382)))\r\n        end\r\n        table.insert(pts, pts[1])\r\n        for i=0, count-1 do\r\n            local p = (i/count) * 10\r\n            local e = math.floor(p) + 1\r\n            table.insert(pos, center + pts[e]:Lerp(pts[e+1], p - (e - 1)))\r\n        end\r\n        return pos\r\n    end\r\n    \r\n    local function getLinePos(center, width, count, forwardOffset)\r\n        local pos = {}\r\n        local lv = _LocalPlayer.Character and _LocalPlayer.Character.PrimaryPart and _LocalPlayer.Character.PrimaryPart.CFrame.LookVector or Vector3.new(0,0,1)\r\n        local rv = Vector3.new(-lv.Z, 0, lv.X).Unit\r\n        \r\n        -- Center it around the player, push forward by forwardOffset (to form roof layers)\r\n        local startP = center + (lv * forwardOffset)\r\n        for i=0, count-1 do\r\n            local t = count > 1 and (i / (count - 1)) or 0.5\r\n            table.insert(pos, startP + (rv * ((width*2) * t - width)))\r\n        end\r\n        return pos\r\n    end\r\n    \r\n    local function generatePositions()\r\n        local positions = {}\r\n        local center = getTargetCenter()\r\n        \r\n        for layer = 1, KixTreeConfig.layers do\r\n            local localPos = {}\r\n            \r\n            if KixTreeConfig.shape == \"Line\" or KixTreeConfig.shape == \"Roof\" then\r\n                -- For Line and Roof mode, the width (Base Radius) stays identical across all layers.\r\n                -- Layer Spacing only dictates the distance between the parallel lines.\r\n                local forwardOffset = (layer - 1) * KixTreeConfig.layerSpacing\r\n                localPos = getLinePos(center, KixTreeConfig.circleRadius, KixTreeConfig.amountPerLayer, forwardOffset)\r\n            else\r\n                local currentRadius = KixTreeConfig.circleRadius + ((layer - 1) * KixTreeConfig.layerSpacing)\r\n                \r\n                if KixTreeConfig.shape == \"Circle\" then localPos = getCirclePos(center, currentRadius, KixTreeConfig.amountPerLayer)\r\n                elseif KixTreeConfig.shape == \"Square\" then localPos = getSquarePos(center, currentRadius, KixTreeConfig.amountPerLayer)\r\n                elseif KixTreeConfig.shape == \"Triangle\" then localPos = getTrianglePos(center, currentRadius, KixTreeConfig.amountPerLayer)\r\n                elseif KixTreeConfig.shape == \"Star\" then localPos = getStarPos(center, currentRadius, KixTreeConfig.amountPerLayer)\r\n                end\r\n            end\r\n            \r\n            for _, p in ipairs(localPos) do\r\n                -- Lock Y to Ground + Sky Height, totally ignoring the player's vertical elevation (center.Y)\r\n                local y = getGroundY(p, center.Y) + KixTreeConfig.plantHeight\r\n                table.insert(positions, Vector3.new(p.X, y, p.Z))\r\n            end\r\n        end\r\n        return positions\r\n    end\r\n    \r\n    local previewParts = {}\r\n    local previewEnabled = false\r\n    local previewTask = nil\r\n    \r\n    local function clearPreview()\r\n        for _, part in ipairs(previewParts) do\r\n            if part and part.Parent then part:Destroy() end\r\n        end\r\n        previewParts = {}\r\n    end\r\n    \r\n    local function updatePreview()\r\n        if not previewEnabled then clearPreview(); return end\r\n        local positions = generatePositions()\r\n        while #previewParts < #positions do\r\n            local p = Instance.new(\"Part\")\r\n            p.Size = Vector3.new(1.5, 0.2, 1.5)\r\n            p.Anchored = true; p.CanCollide = false\r\n            p.Transparency = 0.5; p.Material = Enum.Material.Neon\r\n            p.Color = Color3.fromRGB(0, 255, 0)\r\n            p.Name = \"SaplingPreview\"\r\n            p.Parent = workspace\r\n            table.insert(previewParts, p)\r\n        end\r\n        while #previewParts > #positions do table.remove(previewParts):Destroy() end\r\n        for i, pos in ipairs(positions) do previewParts[i].CFrame = CFrame.new(pos + Vector3.new(0, 0.2, 0)) end\r\n    end\r\n    \r\n    local function findSapling()\r\n        local items = workspace:FindFirstChild('Items')\r\n        if items then\r\n            for _, c in ipairs(items:GetChildren()) do if c.Name:lower():find('sapling') then return c end end\r\n        end\r\n        local inv = _LocalPlayer:FindFirstChild('Inventory')\r\n        if inv then\r\n            for _, c in ipairs(inv:GetChildren()) do if c.Name:lower():find('sapling') then return c end end\r\n        end\r\n        local bag = _LocalPlayer:FindFirstChild('ItemBag')\r\n        if bag then\r\n            for _, c in ipairs(bag:GetChildren()) do if c.Name:lower():find('sapling') then return c end end\r\n        end\r\n        return nil\r\n    end\r\n    \r\n    local plantRemoteMode = nil\r\n\r\n    local function tryCallRemote(remote, argTable)\r\n        if not remote then\r\n            return false\r\n        end\r\n\r\n        if remote:IsA(\"RemoteFunction\") then\r\n            return pcall(function()\r\n                remote:InvokeServer(unpack(argTable))\r\n            end)\r\n        end\r\n\r\n        if remote:IsA(\"RemoteEvent\") then\r\n            return pcall(function()\r\n                remote:FireServer(unpack(argTable))\r\n            end)\r\n        end\r\n\r\n        return false\r\n    end\r\n\r\n    local function robustPlantCall(remote, saplingArg, position)\r\n        if not remote then\r\n            return false\r\n        end\r\n\r\n        -- =====================================================\r\n        -- MODE SUDAH TERDETEKSI\r\n        -- LANGSUNG PAKAI SIGNATURE TERPILIH\r\n        -- =====================================================\r\n\r\n        if plantRemoteMode == 1 then\r\n            return tryCallRemote(\r\n                remote,\r\n                {saplingArg, position}\r\n            )\r\n        elseif plantRemoteMode == 2 then\r\n            return tryCallRemote(\r\n                remote,\r\n                {position, saplingArg}\r\n            )\r\n        elseif plantRemoteMode == 3 then\r\n            return tryCallRemote(\r\n                remote,\r\n                {tostring(saplingArg), position}\r\n            )\r\n        end\r\n\r\n        -- =====================================================\r\n        -- FIRST CALL ONLY\r\n        -- COBA 3 SIGNATURE\r\n        -- =====================================================\r\n\r\n        local args1 = {\r\n            saplingArg,\r\n            position\r\n        }\r\n\r\n        if tryCallRemote(remote, args1) then\r\n            plantRemoteMode = 1\r\n            return true\r\n        end\r\n\r\n        task.wait(0.02)\r\n\r\n        local args2 = {\r\n            position,\r\n            saplingArg\r\n        }\r\n\r\n        if tryCallRemote(remote, args2) then\r\n            plantRemoteMode = 2\r\n            return true\r\n        end\r\n\r\n        task.wait(0.02)\r\n\r\n        local args3 = {\r\n            tostring(saplingArg),\r\n            position\r\n        }\r\n\r\n        if tryCallRemote(remote, args3) then\r\n            plantRemoteMode = 3\r\n            return true\r\n        end\r\n\r\n        return false\r\n    end\r\n    \r\n    local function createMarker(pos)\r\n        local p = Instance.new('Part')\r\n        p.Size = Vector3.new(1.5, 0.4, 1.5)\r\n        p.Anchored = true; p.CanCollide = false\r\n        p.Transparency = 0.3; p.Material = Enum.Material.Neon\r\n        p.Color = Color3.fromRGB(255, 100, 0)\r\n        p.Name = 'SaplingMarker'\r\n        p.CFrame = CFrame.new(pos + Vector3.new(0, 0.3, 0))\r\n        p.Parent = workspace\r\n        game:GetService(\"Debris\"):AddItem(p, 4)\r\n    end\r\n    \r\n    local autoPlantTreeActive = false\r\n    \r\n    local treeOverlapParams = OverlapParams.new()\r\n    local function isPositionOccupied(pos)\r\n        local parts = workspace:GetPartBoundsInRadius(pos, 2.5, treeOverlapParams)\r\n        for _, part in ipairs(parts) do\r\n            if part.Name ~= \"Ground\" and part.Name ~= \"Snow\" and not part.Name:find(\"Water\") and not part.Name:find(\"Terrain\") then\r\n                local model = part:FindFirstAncestorOfClass(\"Model\")\r\n                if model and model ~= _LocalPlayer.Character then\r\n                    -- Abaikan barang-barang yang jatuh di tanah (hasil tebangan seperti logs & saplings)\r\n                    if model:FindFirstAncestor(\"Items\") or model:FindFirstAncestor(\"items\") then\r\n                        continue\r\n                    end\r\n                    \r\n                    local name = model.Name:lower()\r\n                    -- Abaikan tunggul pohon (stump) dan kayu glondongan (log)\r\n                    if name:find(\"stump\") or name:find(\"log\") or name:find(\"wood\") then\r\n                        continue\r\n                    end\r\n                    \r\n                    -- Detect specific tree or sapling names\r\n                    if name:find(\"sapling\") or name:find(\"tree\") or name:find(\"birch\") or name:find(\"pine\") or name:find(\"oak\") then\r\n                        return true\r\n                    end\r\n                    -- Detect if it belongs to the Trees folder\r\n                    if model.Parent and model.Parent.Name == \"Trees\" then\r\n                        return true\r\n                    end\r\n                end\r\n            end\r\n        end\r\n        return false\r\n    end\r\n    \r\n    -- ==================== AUTO PLANT NAME & REALTIME LOGIC ====================\r\n    local FONT_5x7 = {\r\n        [\"A\"] = {{1,0},{2,0},{3,0}, {0,1},{4,1}, {0,2},{4,2}, {0,3},{1,3},{2,3},{3,3},{4,3}, {0,4},{4,4}, {0,5},{4,5}, {0,6},{4,6}},\r\n        [\"B\"] = {{0,0},{1,0},{2,0},{3,0}, {0,1},{4,1}, {0,2},{4,2}, {0,3},{1,3},{2,3},{3,3}, {0,4},{4,4}, {0,5},{4,5}, {0,6},{1,6},{2,6},{3,6}},\r\n        [\"C\"] = {{1,0},{2,0},{3,0}, {0,1},{4,1}, {0,2}, {0,3}, {0,4}, {0,5},{4,5}, {1,6},{2,6},{3,6}},\r\n        [\"D\"] = {{0,0},{1,0},{2,0},{3,0}, {0,1},{4,1}, {0,2},{4,2}, {0,3},{4,3}, {0,4},{4,4}, {0,5},{4,5}