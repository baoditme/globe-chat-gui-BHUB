ble\" then val = {val} end\r\n        local hasAll = table.find(val, \"[ Select All ]\") ~= nil\r\n        \r\n        local cleanVals = {}\r\n        local visualVals = {}\r\n        for _, v in ipairs(config.Values) do\r\n            if v ~= \"[ Select All ]\" then\r\n                table.insert(cleanVals, v)\r\n            end\r\n            table.insert(visualVals, v)\r\n        end\r\n        \r\n        if hasAll and not isAllSelected then\r\n            -- Centang Semua\r\n            isAllSelected = true\r\n            if actualCallback then pcall(function() actualCallback(cleanVals) end) end\r\n            \r\n            task.spawn(function()\r\n                task.wait()\r\n                if dropdownObj and type(dropdownObj.Select) == \"function\" then\r\n                    isProgrammaticSelect = true\r\n                    pcall(function() dropdownObj:Select(visualVals) end)\r\n                    task.wait(0.1)\r\n                    isProgrammaticSelect = false\r\n                end\r\n            end)\r\n            return\r\n        elseif not hasAll and isAllSelected then\r\n            -- Uncentang Semua\r\n            isAllSelected = false\r\n            if actualCallback then pcall(function() actualCallback({}) end) end\r\n            \r\n            task.spawn(function()\r\n                task.wait()\r\n                if dropdownObj and type(dropdownObj.Select) == \"function\" then\r\n                    isProgrammaticSelect = true\r\n                    pcall(function() dropdownObj:Select({}) end)\r\n                    task.wait(0.1)\r\n                    isProgrammaticSelect = false\r\n                end\r\n            end)\r\n            return\r\n        end\r\n        \r\n        isAllSelected = hasAll\r\n        \r\n        -- Filter out [ Select All ] agar tidak masuk ke sistem KixHub\r\n        local realVals = {}\r\n        for _, v in ipairs(val) do\r\n            if v ~= \"[ Select All ]\" then\r\n                table.insert(realVals, v)\r\n            end\r\n        end\r\n        if actualCallback then actualCallback(realVals) end\r\n    end\r\n    \r\n    dropdownObj = tab:Dropdown(config)\r\n    return dropdownObj\r\nend\r\n\r\nlocal isLobby = _Workspace:FindFirstChild(\"GeneralStore\") ~= nil\r\n\r\nlocal function DummyTab()\r\n    return {\r\n        Section = function() end, Toggle = function() end, Button = function() end,\r\n        Slider = function() end, Dropdown = function() end, Keybind = function() end,\r\n        Select = function() end, Paragraph = function() end, Input = function() end,\r\n        Colorpicker = function() end\r\n    }\r\nend\r\n\r\nlocal Tabs = {}\r\nTabs.Home = Window:Tab({Title = 'Home', Icon = 'house'})\r\nTabs.Combat = isLobby and DummyTab() or Window:Tab({Title = 'Combat', Icon = 'sword'})\r\nTabs.Auto = isLobby and DummyTab() or Window:Tab({Title = 'Auto', Icon = 'wrench'})\r\nTabs.Player = Window:Tab({Title = 'Player', Icon = 'user'})\r\nTabs.Fishing = isLobby and DummyTab() or Window:Tab({Title = 'Fish & Tame', Icon = 'fish'})\r\nTabs.Bring = isLobby and DummyTab() or Window:Tab({Title = 'Bring', Icon = 'package'})\r\nTabs.Teleport = isLobby and DummyTab() or Window:Tab({Title = 'Teleport', Icon = 'map'})\r\nTabs.Event = isLobby and DummyTab() or Window:Tab({Title = 'Event', Icon = 'party-popper'})\r\nTabs.MapReveal = isLobby and DummyTab() or Window:Tab({Title = 'Map Reveal', Icon = 'compass'})\r\nTabs.Inventory = isLobby and DummyTab() or Window:Tab({Title = 'Inventory', Icon = 'backpack'})\r\nTabs.Shop = isLobby and DummyTab() or Window:Tab({Title = 'Shop', Icon = 'shopping-cart'})\r\n-- Keep the GC page hidden; its controller below still runs without rendering controls.\r\nTabs.GarbageCollector = DummyTab()\r\nTabs.Spectate = isLobby and DummyTab() or Window:Tab({Title = 'Spectate', Icon = 'monitor'})\r\nTabs.Tree = isLobby and DummyTab() or Window:Tab({Title = 'Tree', Icon = 'leaf'})\r\nTabs.Base = isLobby and DummyTab() or Window:Tab({Title = 'Base', Icon = 'hammer'})\r\nTabs.Vision = Window:Tab({Title = 'Settings', Icon = 'settings'})\r\n-- Keep Optimization runtime active while hiding its controls from the published UI.\r\nTabs.Optimization = DummyTab()\r\nTabs.Info = Window:Tab({Title = 'Information', Icon = 'info'})\r\n\r\n-- World-item limit manager. Keep scans frame-budgeted and reuse the shared transport\r\n-- layer so cleanup can process items steadily without duplicating drag ownership logic.\r\n;(function()\r\n    if isLobby then return end\r\n    local page = Tabs.GarbageCollector\r\n    local transport = _G.KixItemTransportSystem\r\n    if not page or not transport or type(transport.Move) ~= \"function\" or type(transport.CanTeleport) ~= \"function\" then return end\r\n\r\n    local gcManagedItems = _G.KixGarbageCollectorItems\r\n    if not gcManagedItems then\r\n        gcManagedItems = setmetatable({}, {__mode = \"k\"})\r\n        _G.KixGarbageCollectorItems = gcManagedItems\r\n    end\r\n    KixHubSession.GarbageCollectorToken = KixHubSession.GarbageCollectorToken or 0\r\n    local saved = KixHubSavedState\r\n    local configKey = \"GarbageCollectorLimits\"\r\n    local maxLimit = 100000\r\n    local enabled = true\r\n    saved.GarbageCollectorEnabled = true\r\n    local rawDefaultLimit = tonumber(saved.GarbageCollectorDefaultLimit)\r\n    local defaultLimit = rawDefaultLimit and rawDefaultLimit == rawDefaultLimit and rawDefaultLimit > 0\r\n        and rawDefaultLimit < math.huge and math.min(100000, math.floor(rawDefaultLimit)) or 0\r\n    local limits = type(saved[configKey]) == \"table\" and table.clone(saved[configKey]) or {}\r\n    local never = -1\r\n    local maxPerPass = 50\r\n    local pending, attempts = setmetatable({}, {__mode = \"k\"}), setmetatable({}, {__mode = \"k\"})\r\n    local selectedName, pendingLimit, scanSnapshot = nil, \"\", nil\r\n    local lastStatus = enabled and \"Starting\" or \"Off\"\r\n    local stopped = false\r\n\r\n    page:Section({Title = \"Garbage Collector\", Icon = \"trash-2\"})\r\n    local statusUi = page:Paragraph({Title = \"Garbage Collector Status\", Desc = lastStatus})\r\n    local countsUi\r\n    local itemPicker, selectedUi, lastPickerKey\r\n\r\n    local function saveConfig()\r\n        saved.GarbageCollectorEnabled = enabled\r\n        saved.GarbageCollectorDefaultLimit = defaultLimit\r\n        saved[configKey] = table.clone(limits)\r\n    end\r\n    local function setStatus(message)\r\n        message = tostring(message or \"Idle\")\r\n        if lastStatus == message then return end\r\n        lastStatus = message\r\n        if statusUi then pcall(function() statusUi:SetDesc(lastStatus) end) end\r\n    end\r\n    local function parseLimit(value)\r\n        local n = tonumber(value)\r\n        if not n or n ~= n or n < 0 or n == math.huge then return nil end\r\n        return math.min(maxLimit, math.floor(n))\r\n    end\r\n    local function readOwnLimit(name)\r\n        local value = tonumber(limits[name])\r\n        if not value or value ~= value then return nil end\r\n        if value < 0 then return never end\r\n        return math.min(maxLimit, math.floor(value))\r\n    end\r\n    local function itemLimit(name, isCostume)\r\n        local own = readOwnLimit(name)\r\n        if own == never then return nil end\r\n        if own ~= nil then return own end\r\n        if isCostume then return 10 end\r\n        if defaultLimit > 0 then return defaultLimit end\r\n        return nil\r\n    end\r\n    local function priorityBusy()\r\n        return _G.IsStrongholdRaidActive == true or _G.StrongholdTransition == true\r\n            or _G.StrongholdPreparingRaid == true or _G.CampfireCombatActive == true\r\n            or _G.GlobalCultistCombatActive == true or _G.CorruptedCombatActive == true\r\n            or _G.MossyCombatActive == true or _G.TurkeyCombatActive == true\r\n            or _G.BearCombatActive == true or _G.MammothCombatActive == true\r\n            or _G.FrogCombatActive == true or _G.CustomHuntCombatActive == true\r\n            or _G.KixRescueBusy == true or _G.KixHalloweenTrickBusy == true\r\n            or _G.AutoChestRunning == true or _G.AutoMapRevealRunning == true\r\n            or (AutoMapReveal and AutoMapReveal.State and AutoMapReveal.State.IsScanning == true)\r\n            or (_G.KixBuildTransactions and _G.KixBuildTransactions.Owner ~= nil)\r\n    end\r\n    local function newFrameBudget(operationLimit, timeLimit)\r\n        operationLimit, timeLimit = operationLimit or 32, timeLimit or 0.001\r\n        local startClock, operations = os.clock(), 0\r\n        local frameClock = type(time) == \"function\" and time or nil\r\n        local previousClock, previousFrame = startClock, frameClock and frameClock() or nil\r\n        local frameShare, sameFrameSlice = 0, 0\r\n        return function()\r\n            operations += 1\r\n            local now = os.clock()\r\n            local frameLimitReached = false\r\n            if frameClock then\r\n                local frame = frameClock()\r\n                local elapsed = now - previousClock\r\n                if frame ~= previousFrame then\r\n                    frameShare, sameFrameSlice = 0, 0\r\n                else\r\n                    frameShare += elapsed\r\n                    sameFrameSlice += elapsed\r\n                end\r\n                previousClock, previousFrame = now, frame\r\n                frameLimitReached = frameShare >= 0.003 and sameFrameSlice >= 0.0002\r\n            end\r\n            if frameLimitReached or operations >= operationLimit or now - startClock >= timeLimit then\r\n                task.wait()\r\n                startClock, operations = os.clock(), 0\r\n                previousClock = startClock\r\n                previousFrame = frameClock and frameClock() or nil\r\n                sameFrameSlice = 0\r\n            end\r\n        end\r\n    end\r\n    local function scan(folder, token)\r\n        local result = {folder = folder, entries = {}, byName = {}, total = 0}\r\n        if not folder then return result end\r\n        local now = os.clock()\r\n        local children = folder:GetChildren()\r\n        local budget = newFrameBudget()\r\n        for _, item in ipairs(children) do\r\n            budget()\r\n            if stopped or not KixHubSession.Alive or token ~= KixHubSession.GarbageCollectorToken then return nil end\r\n            local pendingAt = pending[item]\r\n            if pendingAt and now - pendingAt >= 30 then pending[item] = nil end\r\n            if item.Parent == folder and item:IsA(\"Model\") and item:GetAttribute(\"Interaction\") ~= \"ItemChest\"\r\n                and not pending[item] then\r\n                local name = item.Name\r\n                local entry = result.byName[name]\r\n                if not entry then\r\n                    entry = {name = name, count = 0, items = {}, costume = false}\r\n                    result.byName[name] = entry\r\n                    result.entries[#result.entries + 1] = entry\r\n                end\r\n                entry.count += 1\r\n                entry.costume = entry.costume or item:GetAttribute(\"Interaction\") == \"Costume\"\r\n                entry.items[#entry.items + 1] = item\r\n                result.total += 1\r\n            end\r\n        end\r\n        table.sort(result.entries, function(a, b)\r\n            if a.count ~= b.count then return a.count > b.count end\r\n            return a.name < b.name\r\n        end)\r\n        return result\r\n    end\r\n    local function campfirePosition(fallback)\r\n        local map = workspace:FindFirstChild(\"Map\")\r\n        local campground = map and map:FindFirstChild(\"Campground\")\r\n        local fire = campground and campground:FindFirstChild(\"MainFire\")\r\n        if fire then\r\n            local ok, pivot = pcall(function() return fire:GetPivot() end)\r\n            if ok and pivot then return pivot.Position end\r\n        end\r\n        return fallback\r\n    end\r\n    local function makePlan(snapshot, root, token, manual)\r\n        local chosen, summaries = {}, {}\r\n        local folder = snapshot.folder\r\n        local origin = campfirePosition(root.Position)\r\n        local budget = newFrameBudget()\r\n        for _, entry in ipairs(snapshot.entries) do\r\n            budget()\r\n            local limit = itemLimit(entry.name, entry.costume)\r\n            if limit and entry.count > limit then\r\n                local candidates = {}\r\n                for _, item in ipairs(entry.items) do\r\n                    budget()\r\n                    if stopped or token ~= KixHubSession.GarbageCollectorToken or (not manual and not enabled) then return {}, {} end\r\n                    local attemptedAt = attempts[item]\r\n                    if item.Parent == folder and item:GetAttribute(\"Owner\") == nil\r\n                        and (not attemptedAt or os.clock() - attemptedAt >= 10)\r\n                        and transport.CanTeleport(item) then\r\n                        local ok, pivot = pcall(function() return item:GetPivot() end)\r\n                        if ok and pivot then\r\n                            candidates[#candidates + 1] = {item = item, distance = (pivot.Position - origin).Magnitude}\r\n                        end\r\n                    end\r\n                end\r\n                table.sort(candidates, function(a, b) return a.distance > b.distance end)\r\n                local wanted = math.min(entry.count - limit, #candidates, maxPerPass - #chosen)\r\n                for i = 1, wanted do chosen[#chosen + 1] = candidates[i].item end\r\n                if wanted > 0 then summaries[#summaries + 1] = string.format(\"%d %s\", wanted, entry.name) end\r\n                if #chosen >= maxPerPass then break end\r\n            end\r\n            if stopped or token ~= KixHubSession.GarbageCollectorToken or (not manual and not enabled) then return {}, {} end\r\n        end\r\n        return chosen, summaries\r\n    end\r\n    local function collect(manual, token, suppliedSnapshot)\r\n        local character = _LocalPlayer.Character\r\n        local root = character and character:FindFirstChild(\"HumanoidRootPart\")\r\n        if not root then return 0, \"Waiting for your character\" end\r\n        local folder = workspace:FindFirstChild(\"Items\")\r\n        if not folder then return 0, \"World item folder is not loaded\" end\r\n        local snapshot = suppliedSnapshot and suppliedSnapshot.folder == folder and suppliedSnapshot or scan(folder, token)\r\n        if not snapshot then return 0, \"Stopped\" end\r\n        scanSnapshot = snapshot\r\n        local chosen, summaries = makePlan(snapshot, root, token, manual)\r\n        if #chosen == 0 then\r\n            if snapshot.total == 0 then return 0, \"No loose items are loaded\" end\r\n            return 0, \"Every item is within its limit\"\r\n        end\r\n        local moved = 0\r\n        local active = function()\r\n            return not stopped and KixHubSession.Alive and (manual or enabled)\r\n                and token == KixHubSession.GarbageCollectorToken\r\n                and _LocalPlayer.Character == character and root.Parent == character\r\n                and workspace:FindFirstChild(\"Items\") == folder\r\n        end\r\n        moved = transport.Batch(chosen, function(item)\r\n            if not active() or item.Parent ~= folder or not transport.CanTeleport(item) then return false end\r\n            attempts[item] = os.clock()\r\n            -- Mark before moving so the anti-void worker cannot race the transport.\r\n            gcManagedItems[item] = true\r\n            local ok = transport.Move(item, root.CFrame + Vector3.new(0, -100, 0), active)\r\n            if ok then\r\n                pending[item] = os.clock()\r\n            else\r\n                gcManagedItems[item] = nil\r\n            end\r\n            return ok\r\n        end, {active = active}) or 0\r\n        if moved > 0 then\r\n            KixHubSavedState.GarbageCollectorDeleted = (KixHubSavedState.GarbageCollectorDeleted or 0) + moved\r\n            setStatus(string.format(\"Moved %d extra item(s) below the map: %s\", moved, table.concat(summaries, \", \")))\r\n        else\r\n            setStatus(\"No eligible excess items could be moved\")\r\n        end\r\n        return moved\r\n    end\r\n    local function refreshUi(snapshot)\r\n        if stopped or not KixHubSession.Alive then return end\r\n        local lines, names, seen = {}, {}, {}\r\n        if snapshot then\r\n            for i, entry in ipairs(snapshot.entries) do\r\n                if i <= 25 then\r\n                    local limit = itemLimit(entry.name, entry.costume)\r\n                    local own = readOwnLimit(entry.name)\r\n                    local suffix = own == never and \" · protected\" or limit and (\" · limit \" .. limit) or \" · unlimited\"\r\n                    lines[#lines + 1] = string.format(\"%s: %d%s\", entry.name, entry.count, suffix)\r\n                    seen[entry.name] = true\r\n                    names[#names + 1] = entry.name\r\n                end\r\n            end\r\n            if #snapshot.entries > 25 then lines[#lines + 1] = string.format(\"…and %d more item types\", #snapshot.entries - 25) end\r\n            pcall(function()\r\n                countsUi:SetDesc(#lines > 0 and string.format(\"%d item(s), %d type(s)\\n%s\", snapshot.total, #snapshot.entries, table.concat(lines, \"\\n\"))\r\n                    or (snapshot.folder and \"No loose items are loaded\" or \"World item folder is not loaded\"))\r\n            end)\r\n        end\r\n        for name in pairs(limits) do if type(name) == \"string\" and not seen[name] then names[#names + 1] = name; seen[name] = true end end\r\n        if selectedName and not seen[selectedName] then names[#names + 1] = selectedName end\r\n        table.sort(names)\r\n        local pickerKey = table.concat(names, \"\\000\")\r\n        if itemPicker and pickerKey ~= lastPickerKey then\r\n            lastPickerKey = pickerKey\r\n            pcall(function() itemPicker:Refresh(names) end)\r\n        end\r\n        if selectedUi then\r\n            local entry = snapshot and snapshot.byName[selectedName]\r\n            local own = selectedName and readOwnLimit(selectedName)\r\n            local text = selectedName and string.format(\"%s: %d loaded\", selectedName, entry and entry.count or 0) or \"Choose an item above.\"\r\n            if own == never then text ..= \" · never delete\" elseif own ~= nil then text ..= \" · keep \" .. own elseif entry and itemLimit(selectedName, entry.costume) then text ..= \" · default limit \" .. itemLimit(selectedName, entry.costume) else text ..= \" · no limit\" end\r\n            pcall(function() selectedUi:SetDesc(text) end)\r\n        end\r\n    end\r\n\r\n    page:Toggle({Title = \"Garbage Collector\", Desc = \"Move excess loose items below the map. Costume pieces keep 10 by default.\", Value = enabled, Callback = function(value)\r\n        enabled = value == true\r\n        saveConfig()\r\n        KixHubSession.GarbageCollectorToken = (KixHubSession.GarbageCollectorToken or 0) + 1\r\n        if enabled then setStatus(\"Starting\") else setStatus(\"Off\") end\r\n    end})\r\n    page:Input({Title = \"Default Limit\", Desc = \"Items without a custom limit use this amount. 0 means unlimited; costumes default to 10.\", Placeholder = \"0\", Value = tostring(defaultLimit), Callback = function(value)\r\n        local limit = parseLimit(value)\r\n        if limit then defaultLimit = limit; saveConfig(); refreshUi(scanSnapshot) end\r\n    end})\r\n    page:Section({Title = \"Item Limits\", Icon = \"list-ordered\"})\r\n    itemPicker = page:Dropdown({Title = \"Item\", Desc = \"Loaded item types and items with a saved limit.\", Values = {}, SearchBarEnabled = true, AllowNone = true, Placeholder = \"Choose an item\", Callback = function(value)\r\n        selectedName = type(value) == \"table\" and value[1] or value\r\n        if selectedName == \"\" then selectedName = nil end\r\n        refreshUi(scanSnapshot)\r\n    end})\r\n    selectedUi = page:Paragraph({Title = \"Selected Item\", Desc = \"Choose an item above.\"})\r\n    page:Input({Title = \"Item Limit\", Desc = \"How many to keep. 0 removes every eligible item of this type.\", Placeholder = \"50\", Value = \"\", Callback = function(value) pendingLimit = tostring(value) end})\r\n    page:Button({Title = \"Set Item Limit\", Icon = \"check\", Callback = function()\r\n        if not selectedName then setStatus(\"Select an item first\"); return end\r\n        local limit = parseLimit(pendingLimit)\r\n        if not limit then setStatus(\"Enter a whole-number limit of 0 or more\"); return end\r\n        limits[selectedName] = limit\r\n        saveConfig(); refreshUi(scanSnapshot)\r\n        setStatus(string.format(\"Keep at most %d %s\", limit, selectedName))\r\n    end})\r\n    page:Button({Title = \"Never Delete Item\", Desc = \"Protect the selected type from all automatic limits.\", Icon = \"shield\", Callback = function()\r\n        if not selectedName then setStatus(\"Select an item first\"); return end\r\n        limits[selectedName] = never\r\n        saveConfig(); refreshUi(scanSnapshot); setStatus(selectedName .. \" is protected\")\r\n    end})\r\n    page:Button({Title = \"Use Default Limit\", Desc = \"Remove this item's custom rule.\", Icon = \"undo-2\", Callback = function()\r\n        if not selectedName then setStatus(\"Select an item first\"); return end\r\n        limits[selectedName] = nil\r\n        saveConfig(); refreshUi(scanSnapshot); setStatus(selectedName .. \" now uses the default limit\")\r\n    end})\r\n    page:Button({Title = \"Delete Extras Now\", Desc = \"Run one cleanup pass while the toggle is off.\", Icon = \"trash-2\", Variant = \"Destructive\", Callback = function()\r\n        if priorityBusy() then setStatus(\"Paused for a higher-priority activity\"); return end\r\n        local token = KixHubSession.GarbageCollectorToken or 0\r\n        task.spawn(function()\r\n            if stopped or not KixHubSession.Alive then return end\r\n            setStatus(\"Running one cleanup pass\")\r\n            local ok, moved, message = pcall(collect, true, token)\r\n            if not ok then setStatus(\"Cleanup stopped: \" .. tostring(moved)) elseif moved == 0 then setStatus(message) end\r\n        end)\r\n    end})\r\n    page:Button({Title = \"Clear All Item Limits\", Desc = \"Remove all per-item rules.\", Icon = \"list-x\", Callback = function()\r\n        limits = {}; saveConfig(); refreshUi(scanSnapshot); setStatus(\"All item limits cleared\")\r\n    end})\r\n    page:Section({Title = \"Items in the World\", Icon = \"package\"})\r\n    countsUi = page:Paragraph({Title = \"Loaded Items\", Desc = \"Waiting for world items...\"})\r\n\r\n    local itemsFolder\r\n    local connections = {}\r\n    local function bindFolder(folder)\r\n        if folder == itemsFolder then return end\r\n        itemsFolder = folder\r\n    end\r\n    local function connect(signal, callback)\r\n        if signal then connections[#connections + 1] = signal:Connect(callback) end\r\n    end\r\n    connect(workspace.ChildAdded, function(child) if child.Name == \"Items\" then bindFolder(child) end end)\r\n    connect(workspace.ChildRemoved, function(child) if child == itemsFolder then bindFolder(nil); scanSnapshot = nil end end)\r\n    local previousCleanup = getgenv().KixHubCleanup\r\n    getgenv().KixHubCleanup = function()\r\n        stopped = true\r\n        for _, connection in ipairs(connections) do pcall(function() connection:Disconnect() end) end\r\n        connections = {}\r\n        if previousCleanup then pcall(previousCleanup) end\r\n    end\r\n    local activeToken = KixHubSession.GarbageCollectorToken or 0\r\n    task.spawn(function()\r\n        task.wait(3)\r\n        while KixHubSession.Alive and not stopped do\r\n            activeToken = KixHubSession.GarbageCollectorToken or 0\r\n            local folder = workspace:FindFirstChild(\"Items\")\r\n            bindFolder(folder)\r\n            if not folder then\r\n                setStatus(enabled and \"Waiting for world items\" or \"Off\")\r\n            elseif enabled then\r\n                local snapshot = scan(folder, activeToken)\r\n                if snapshot then\r\n                    scanSnapshot = snapshot\r\n                    refreshUi(snapshot)\r\n                    local ok, moved, message = pcall(collect, false, activeToken, snapshot)\r\n                    if not ok then setStatus(\"Cleanup paused: \" .. tostring(moved)) elseif moved == 0 then setStatus(message) end\r\n                end\r\n            end\r\n            task.wait(2)\r\n        end\r\n    end)\r\nend)()\r\n\r\n-- Optimization port: game-code reductions, reversible graphics, rain, FPS cap, and budgeted FPS Booster.\r\n;(function()\r\n    local Lighting = game:GetService(\"Lighting\")\r\n    local CollectionService = game:GetService(\"CollectionService\")\r\n    local RunService = game:GetService(\"RunService\")\r\n    local alive = function() return KixHubSession.Alive end\r\n    local tagControllers, propertyRecords, graphicsEnabled, graphicsLinks = {}, {}, {}, {}\r\n    local optionValues = {\"All\", \"Shadows\", \"Post Effects\", \"Atmosphere\", \"Particles\", \"Materials\", \"Mesh Fidelity\", \"Water\", \"Graphics Quality\"}\r\n    local selectedOptions = {Shadows = true, [\"Post Effects\"] = true, Atmosphere = true, Particles = true, Water = true}\r\n    local boosterEnabled, boosterGeneration, boosterLinks = false, 0, {}\r\n    local boosterStatus\r\n    local function safeIs(instance, className)\r\n        local ok, result = pcall(function() return instance:IsA(className) end)\r\n        return ok and result == true\r\n    end\r\n    local function setStatus(message)\r\n        if boosterStatus then pcall(function() boosterStatus:SetDesc(message) end) end\r\n    end\r\n\r\n    -- Cache reversible writes by category and instance; only restore values still owned by this optimizer.\r\n    local function categoryRecords(category)\r\n        propertyRecords[category] = propertyRecords[category] or setmetatable({}, {__mode = \"k\"})\r\n        return propertyRecords[category]\r\n    end\r\n    local function patchProperty(instance, property, value, category, access)\r\n        if not instance then return false end\r\n        access = access or \"normal\"\r\n        local records = categoryRecords(category)\r\n        local props = records[instance]\r\n        if not props then props = {}; records[instance] = props end\r\n        if props[property] then return true end\r\n        local function read()\r\n            if access == \"hidden\" and type(gethiddenproperty) == \"function\" then return gethiddenproperty(instance, property) end\r\n            return instance[property]\r\n        end\r\n        local function write(v)\r\n            if access == \"hidden\" and type(sethiddenproperty) == \"function\" then return sethiddenproperty(instance, property, v) end\r\n            instance[property] = v\r\n        end\r\n        local ok, original = pcall(read)\r\n        if not ok then return false end\r\n        if original == value then return true end\r\n        if not pcall(write, value) then return false end\r\n        local record = {original = original, applied = value, write = write, read = read}\r\n        props[property] = record\r\n        local signalOk, signal = pcall(function() return instance:GetPropertyChangedSignal(property) end)\r\n        if signalOk and signal then\r\n            record.connection = signal:Connect(function()\r\n                if not alive() or not props[property] then return end\r\n                local currentOk, current = pcall(read)\r\n                if currentOk and current ~= value then\r\n                    record.original = current\r\n                    pcall(write, value)\r\n                end\r\n            end)\r\n        end\r\n        return true\r\n    end\r\n    local function restoreCategory(category)\r\n        local records = propertyRecords[category]\r\n        if not records then return end\r\n        for instance, props in pairs(records) do\r\n            for property, record in pairs(props) do\r\n                if record.connection then pcall(function() record.connection:Disconnect() end) end\r\n                pcall(function()\r\n                    if instance.Parent and record.read() == record.applied then record.write(record.original) end\r\n                end)\r\n                props[property] = nil\r\n            end\r\n            records[instance] = nil\r\n        end\r\n        propertyRecords[category] = nil\r\n    end\r\n\r\n    local function setTagOptimization(key, tags, transform)\r\n        local prior = tagControllers[key]\r\n        if prior then return end\r\n        local controller = {originals = setmetatable({}, {__mode = \"k\"}), links = {}}\r\n        tagControllers[key] = controller\r\n        local function handle(instance, tag)\r\n            if not alive() or tagControllers[key] ~= controller then return end\r\n            local ok, has = pcall(function() return instance:HasTag(tag) end)\r\n            if not ok or not has then return end\r\n            controller.originals[instance] = tag\r\n            pcall(function() instance:RemoveTag(tag) end)\r\n        end\r\n        for _, tag in ipairs(tags) do\r\n            table.insert(controller.links, CollectionService:GetInstanceAddedSignal(tag):Connect(function(instance) handle(instance, tag) end))\r\n        end\r\n        task.spawn(function()\r\n            local count = 0\r\n            for _, tag in ipairs(tags) do\r\n                for _, instance in ipairs(CollectionService:GetTagged(tag)) do\r\n                    if not alive() or tagControllers[key] ~= controller then return end\r\n                    handle(instance, tag)\r\n                    count += 1\r\n                    if count % 64 == 0 then task.wait() end\r\n                end\r\n            end\r\n        end)\r\n    end\r\n    local function stopTagOptimization(key, restore, restoreTransform)\r\n        local controller = tagControllers[key]\r\n        tagControllers[key] = nil\r\n        if not controller then return end\r\n        for _, c in ipairs(controller.links) do pcall(function() c:Disconnect() end) end\r\n        if restore then\r\n            for instance, tag in pairs(controller.originals) do\r\n                pcall(function()\r\n                    if instance.Parent then\r\n                        local restoreTag = tag\r\n                        if restoreTransform then\r\n                            local transformed = restoreTransform(instance, tag)\r\n                            if transformed ~= nil then restoreTag = transformed end\r\n                        end\r\n                        if restoreTag ~= false and not instance:HasTag(restoreTag) then instance:AddTag(restoreTag) end\r\n                    end\r\n                end)\r\n            end\r\n        end\r\n        table.clear(controller.originals)\r\n    end\r\n\r\n    -- Stop game-owned per-frame work by changing its CollectionService tags.\r\n    local function setLightFlicker(on)\r\n        if on then\r\n            setTagOptimization(\"flicker\", {\"FlickeringPart\"})\r\n        else\r\n            stopTagOptimization(\"flicker\", true, function(instance)\r\n                local light = instance.Parent and instance:FindFirstChildOfClass(\"PointLight\")\r\n                if not (light and light.Enabled) then return false end\r\n            end)\r\n        end\r\n    end\r\n    local function setWindmill(on)\r\n        if on then\r\n            setTagOptimization(\"windmill\", {\"StuckWindmill\", \"MovingWindmill\"}, function(instance, previousTag)\r\n                local player = _LocalPlayer\r\n                local replacement = previousTag\r\n        