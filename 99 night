alse end\r\n        local function invoke()\r\n            if not active(id) or not isEligibleKid(kid) or not item.Parent then return nil end\r\n            if remote:IsA('RemoteFunction') then return remote:InvokeServer(kid, item) end\r\n            if remote:IsA('RemoteEvent') then remote:FireServer(kid, item); return {Success = true} end\r\n            return nil\r\n        end\r\n        local inventory = _LocalPlayer:FindFirstChild('Inventory')\r\n        local result\r\n        if item.Parent == inventory then\r\n            pcall(function() result = invoke() end)\r\n        else\r\n            local mover = _G.KixItemTransportSystem\r\n            if not mover or type(mover.Move) ~= 'function' or not mover.CanTeleport(item) then return false end\r\n            pcall(function()\r\n                mover.Move(item, item:GetPivot(), function()\r\n                    return active(id) and isEligibleKid(kid) and item.Parent ~= nil\r\n                end, function()\r\n                    if not result then result = invoke() end\r\n                end)\r\n            end)\r\n        end\r\n        return type(result) == 'table' and result.Success == true\r\n    end\r\n    local function careItemAllowed(item, folder)\r\n        local owner = item and item:GetAttribute('Owner')\r\n        return item ~= nil and item.Parent == folder\r\n            and (owner == nil or owner == _LocalPlayer.UserId)\r\n            and item:GetAttribute('Locked') ~= true\r\n            and item:GetAttribute('IceBlock') ~= true\r\n            and item:GetAttribute('LockedHotbarSlot') == nil\r\n            and item:GetAttribute('NoDropping') ~= true\r\n            and item:GetAttribute('NoDragging') ~= true\r\n            and _G.KixItemTransportSystem and _G.KixItemTransportSystem.CanTeleport(item)\r\n    end\r\n    local function findCareItem(name, origin, requireFuel)\r\n        local folder = _G.KixItemsIndex.Get()\r\n        local bucket = _G.KixItemsIndex.GetByName(name)\r\n        local best, bestDistance\r\n        for _, item in ipairs(bucket and bucket.Items or {}) do\r\n            if careItemAllowed(item, folder) then\r\n                local burnFuel = requireFuel and item:GetAttribute('BurnFuel') or nil\r\n                if not requireFuel or (type(burnFuel) == 'number' and burnFuel > 0\r\n                    and (tonumber(item:GetAttribute('Wet')) or 0) < 1) then\r\n                    local distance = 0\r\n                    if origin then\r\n                        pcall(function() distance = (item:GetPivot().Position - origin).Magnitude end)\r\n                    end\r\n                    if not bestDistance or distance < bestDistance then\r\n                        best, bestDistance = item, distance\r\n                    end\r\n                end\r\n            end\r\n        end\r\n        return best, folder\r\n    end\r\n    local function giveCareItem(kid, item, id)\r\n        local events = _ReplicatedStorage:FindFirstChild('RemoteEvents')\r\n        local remote = events and events:FindFirstChild('AttemptGiveKidItem')\r\n        if not remote or not active(id) or not item or not item.Parent then return false end\r\n        local result\r\n        local function invoke()\r\n            if not active(id) or not isEligibleKid(kid) or not item.Parent then return nil end\r\n            if remote:IsA('RemoteFunction') then return remote:InvokeServer(kid, item) end\r\n            if remote:IsA('RemoteEvent') then remote:FireServer(kid, item); return {Success = true} end\r\n            return nil\r\n        end\r\n        local inventory = _LocalPlayer:FindFirstChild('Inventory')\r\n        if item.Parent == inventory then\r\n            pcall(function() result = invoke() end)\r\n        else\r\n            local mover = _G.KixItemTransportSystem\r\n            if not mover or type(mover.Move) ~= 'function' or not mover.CanTeleport(item) then return false end\r\n            pcall(function()\r\n                mover.Move(item, item:GetPivot(), function()\r\n                    return active(id) and isEligibleKid(kid) and item.Parent ~= nil\r\n                end, function()\r\n                    if not result then result = invoke() end\r\n                end)\r\n            end)\r\n        end\r\n        return type(result) == 'table' and result.Success == true\r\n    end\r\n    local function makeSleepyKidBed(kid, id)\r\n        if (bedRetryAt[kid] or 0) > os.clock() then return false end\r\n        local structures = _Workspace:FindFirstChild('Structures')\r\n        local kidId = kid:GetAttribute('KidId')\r\n        local tent\r\n        for _, structure in ipairs(structures and structures:GetChildren() or {}) do\r\n            if structure:GetAttribute('KidTent') == true and structure:GetAttribute('KidId') == kidId then\r\n                tent = structure\r\n                break\r\n            end\r\n        end\r\n        local bed = tent\r\n        local prompt\r\n        for _, child in ipairs(bed and bed:GetChildren() or {}) do\r\n            if child:GetAttribute('Interaction') == 'MakeKidBed' then\r\n                prompt = child:FindFirstChildWhichIsA('ProximityPrompt', true)\r\n                if prompt then bed = child; break end\r\n            end\r\n        end\r\n        if not tent or not bed or not prompt or prompt.Enabled ~= true then return false end\r\n        local character = _LocalPlayer.Character\r\n        local root = character and character:FindFirstChild('HumanoidRootPart')\r\n        if not root or _G.KixRescueBusy or isAnyCombatActive() then return false end\r\n        local promptPosition\r\n        pcall(function()\r\n            local parent = prompt.Parent\r\n            promptPosition = parent and parent:IsA('Attachment') and parent.WorldPosition or bed:GetPivot().Position\r\n        end)\r\n        if not promptPosition then return false end\r\n        local center, size\r\n        pcall(function() center, size = tent:GetBoundingBox() end)\r\n        local roofY = center and size and center.Y + size.Y / 2 + 3.5 or promptPosition.Y + 3\r\n        local maxY = promptPosition.Y + math.max(4, (tonumber(prompt.MaxActivationDistance) or 10) - 1.5)\r\n        local target = CFrame.new(promptPosition.X, math.min(roofY, maxY), promptPosition.Z)\r\n        local original = character:GetPivot()\r\n        bedRetryAt[kid] = os.clock() + 15\r\n        local ok = pcall(function()\r\n            if not active(id) or not kid.Parent or kid:GetAttribute('NeedsSleep') ~= true then return end\r\n            character:PivotTo(target)\r\n            task.wait(0.25)\r\n            if not active(id) or _LocalPlayer.Character ~= character then return end\r\n            if type(fireproximityprompt) == 'function' then\r\n                fireproximityprompt(prompt)\r\n            else\r\n                prompt:InputHoldBegin()\r\n                local deadline = os.clock() + math.max(0.1, (tonumber(prompt.HoldDuration) or 0) + 0.2)\r\n                while active(id) and os.clock() < deadline do task.wait(0.1) end\r\n                pcall(function() prompt:InputHoldEnd() end)\r\n            end\r\n            local deadline = os.clock() + 3\r\n            while active(id) and os.clock() < deadline\r\n                and kid.Parent and kid:GetAttribute('NeedsSleep') == true do task.wait(0.1) end\r\n        end)\r\n        if _LocalPlayer.Character == character and root.Parent == character\r\n            and (root.Position - target.Position).Magnitude < 12 then\r\n            pcall(function() character:PivotTo(original) end)\r\n        end\r\n        return ok and kid:GetAttribute('NeedsSleep') ~= true\r\n    end\r\n    local function fuelFreezingKid(kid, id)\r\n        local now = os.clock()\r\n        if now < fireNextAt or now < firePauseUntil then return false end\r\n        if fireFuelCount >= 10 then\r\n            fireFuelCount, firePauseUntil = 0, now + 120\r\n            return false\r\n        end\r\n        local map = _Workspace:FindFirstChild('Map')\r\n        local campground = map and map:FindFirstChild('Campground')\r\n        local fire = campground and campground:FindFirstChild('MainFire')\r\n        local zone = fire and fire:FindFirstChild('InnerTouchZone')\r\n        if not fire or not zone then return false end\r\n        local origin\r\n        pcall(function() origin = fire:GetPivot().Position end)\r\n        local item, folder\r\n        for _, name in ipairs({'Log', 'Coal', 'Biofuel', 'Fuel Canister', 'Oil Barrel'}) do\r\n            item, folder = findCareItem(name, origin, true)\r\n            if item then break end\r\n        end\r\n        if not item or not folder or (careRetryAt[item] or 0) > now then return false end\r\n        local target\r\n        pcall(function()\r\n            target = zone.CFrame + Vector3.new(0, zone.Size.Y / 2 + 8, 0)\r\n        end)\r\n        if not target then return false end\r\n        careRetryAt[item] = now + 15\r\n        local moved = false\r\n        pcall(function()\r\n            moved = _G.KixItemTransportSystem.Move(item, target, function()\r\n                return active(id) and kid.Parent ~= nil and kid:GetAttribute('NeedsFire') == true\r\n            end)\r\n        end)\r\n        if moved then\r\n            fireFuelCount += 1\r\n            fireNextAt = os.clock() + 4\r\n        end\r\n        return moved == true\r\n    end\r\n    local function runSelectedKidCare(id)\r\n        local characters = _Workspace:FindFirstChild('Characters')\r\n        local freezingFound = false\r\n        for _, kid in ipairs(characters and characters:GetChildren() or {}) do\r\n            if not active(id) then return false end\r\n            if isEligibleKid(kid) and kid:GetAttribute('Friending') == true then\r\n                if kid:GetAttribute('NeedsFire') == true then freezingFound = true end\r\n                local busy = kid:GetAttribute('HoldingItem') ~= nil or kid:GetAttribute('State') == 'InspectItem'\r\n                if not busy and kid:GetAttribute('NeedsBandage') == true\r\n                    and (tonumber(_Workspace:GetAttribute('CultistsAtFire')) or 0) <= 0 then\r\n                    local inventory = _LocalPlayer:FindFirstChild('Inventory')\r\n                    local bandage\r\n                    for _, item in ipairs(inventory and inventory:GetChildren() or {}) do\r\n                        if item.Name == 'Bandage' and itemAllowed(item)\r\n                            and (careRetryAt[item] or 0) <= os.clock() then bandage = item; break end\r\n                    end\r\n                    if not bandage then bandage = findCareItem('Bandage', kid:GetPivot().Position, false) end\r\n                    if bandage and (careRetryAt[bandage] or 0) <= os.clock() then\r\n                        local success = giveCareItem(kid, bandage, id)\r\n                        careRetryAt[bandage] = os.clock() + 15\r\n                        if success then return true end\r\n                    end\r\n                end\r\n                if not busy and kid:GetAttribute('NeedsSleep') == true\r\n                    and (bedRetryAt[kid] or 0) <= os.clock()\r\n                    and not (AutoMapReveal and AutoMapReveal.State and AutoMapReveal.State.IsScanning) then\r\n                    if makeSleepyKidBed(kid, id) then return true end\r\n                end\r\n                if kid:GetAttribute('NeedsFire') == true and fuelFreezingKid(kid, id) then return true end\r\n            end\r\n        end\r\n        if not freezingFound then fireFuelCount, firePauseUntil = 0, 0 end\r\n        return false\r\n    end\r\n\r\n    _G.KixEngines.AutoBefriendKids = function(value)\r\n        value = value == true\r\n        if value == enabled then return end\r\n        generation += 1\r\n        local id = generation\r\n        enabled = value\r\n        if not enabled then restoreConfirm(); return end\r\n        itemsFolder = _G.KixItemsIndex.Get()\r\n        installBefriendConfirm()\r\n        local playerGui = _LocalPlayer:FindFirstChild('PlayerGui')\r\n        local interface = playerGui and playerGui:FindFirstChild('Interface')\r\n        if interface then\r\n            uiLink = interface.ChildAdded:Connect(function()\r\n                task.defer(function() if active(id) then clickBefriendDialogs() end end)\r\n            end)\r\n        end\r\n        _G.KixEngines.Spawn('AutoBefriendKids', function()\r\n            while active(id) do\r\n                if AutoMapReveal and AutoMapReveal.State and AutoMapReveal.State.IsScanning then\r\n                    task.wait(2)\r\n                    continue\r\n                end\r\n                local acted = false\r\n                clickBefriendDialogs()\r\n                local characters = _Workspace:FindFirstChild('Characters')\r\n                for _, kid in ipairs(characters and characters:GetChildren() or {}) do\r\n                    if not active(id) then break end\r\n                    if isEligibleKid(kid) then\r\n                        local isBefriended = kid:GetAttribute('Friending') == true\r\n                        local level = tonumber(kid:GetAttribute('FriendLevel')) or 1\r\n                        local needsTrinket = not isBefriended\r\n                            or (level < 5 and kid:GetAttribute('XPRequired') ~= nil)\r\n                        local busy = kid:GetAttribute('HoldingItem') ~= nil\r\n                            or kid:GetAttribute('State') == 'InspectItem'\r\n                        if needsTrinket and not busy then\r\n                            local item = findTrinket(kid)\r\n                            if item and (retryAt[item] or 0) <= os.clock() then\r\n                                if (tonumber(workspace:GetAttribute('CultistsAtFire')) or 0) > 0 then\r\n                                    break\r\n                                end\r\n                                local success = giveTrinket(kid, item, id)\r\n                                retryAt[item] = os.clock() + 15\r\n                                acted = true\r\n                                clickBefriendDialogs()\r\n                                if success then break end\r\n                            end\r\n                        end\r\n                    end\r\n                end\r\n                local careOk, careActed = pcall(runSelectedKidCare, id)\r\n                if careOk and careActed then acted = true\r\n                elseif not careOk and os.clock() >= careErrorWarnAt then\r\n                    careErrorWarnAt = os.clock() + 15\r\n                    warn('[Auto Befriend Kids care] ' .. tostring(careActed))\r\n                end\r\n                task.wait(acted and 0.5 or 2)\r\n            end\r\n            if generation == id then restoreConfirm() end\r\n        end)\r\n    end\r\n    _G.KixAdapters = _G.KixAdapters or {}\r\n    _G.KixAdapters.AutoBefriendKids = {\r\n        IsEnabled = function() return enabled == true end,\r\n    }\r\n\r\n    Tabs.Auto:Section({Title = 'Befriend Kids', Icon = 'heart-handshake'})\r\n    _G.KixStartupFeatures.Toggles.AutoBefriendKids = Tabs.Auto:Toggle({\r\n        Title = 'Auto Befriend Kids',\r\n        Desc = 'Befriends rescued kids and handles bandages, sleepy beds, and campfire fuel.',\r\n        Value = false,\r\n        Callback = _G.KixEngines.AutoBefriendKids,\r\n    })\r\nend)() end\r\n\r\n-- Flower farming: one switch owns both discovery and the normal flower-pick request.\r\ndo (function()\r\n    local collection = game:GetService(\"CollectionService\")\r\n    local enabled, generation = false, 0\r\n    local targets = setmetatable({}, {__mode = \"k\"})\r\n    local itemLinks = setmetatable({}, {__mode = \"k\"})\r\n    local pulledFlowers = setmetatable({}, {__mode = \"k\"})\r\n    local inFlight = setmetatable({}, {__mode = \"k\"})\r\n    local activePickCount = 0\r\n    local RANGE, REACH = 1400, 16\r\n    local nextPriorityCheck, nearbyPriorityActive = 0, false\r\n\r\n    local function tagged(item, tag)\r\n        local ok, result = pcall(function() return collection:HasTag(item, tag) end)\r\n        return ok and result == true\r\n    end\r\n\r\n    local function qualifies(item)\r\n        return item and item.Parent and item:IsDescendantOf(workspace)\r\n            and (item:IsA(\"Model\") or item:IsA(\"BasePart\"))\r\n            and (tagged(item, \"Flower\") or item:GetAttribute(\"Interaction\") == \"Flower\" or item.Name == \".Flower\")\r\n    end\r\n\r\n    local function untrack(item)\r\n        targets[item] = nil\r\n        local links = itemLinks[item]\r\n        if links then\r\n            for _, link in ipairs(links) do pcall(function() link:Disconnect() end) end\r\n            itemLinks[item] = nil\r\n        end\r\n    end\r\n\r\n    local function track(item)\r\n        if not item then return end\r\n        if not qualifies(item) then\r\n            if itemLinks[item] then untrack(item) end\r\n            return\r\n        end\r\n        targets[item] = true\r\n        if itemLinks[item] then return end\r\n        itemLinks[item] = {\r\n            item:GetPropertyChangedSignal(\"Name\"):Connect(function() track(item) end),\r\n            item:GetAttributeChangedSignal(\"Interaction\"):Connect(function() track(item) end),\r\n            item.AncestryChanged:Connect(function()\r\n                if not item:IsDescendantOf(workspace) then untrack(item) end\r\n            end),\r\n        }\r\n    end\r\n\r\n    local function insideMap(position)\r\n        local mapRange = workspace:GetAttribute(\"MapRange\")\r\n        if type(mapRange) == \"number\" and mapRange > 0 and mapRange == mapRange then\r\n            RANGE = mapRange\r\n        end\r\n        return math.sqrt(position.X * position.X + position.Z * position.Z) <= RANGE - 12\r\n    end\r\n\r\n    local function describe(item)\r\n        if not qualifies(item) or tagged(item, \"HollowPlant\")\r\n            or item:GetAttribute(\"Owner\") ~= nil and item:GetAttribute(\"Owner\") ~= _LocalPlayer.UserId\r\n            or item:GetAttribute(\"Destroyed\") or item:GetAttribute(\"QueuedToTake\")\r\n            or item:GetAttribute(\"InteractOnCooldown\") ~= nil or item:GetAttribute(\"NotClickable\") ~= nil then\r\n            return nil\r\n        end\r\n        local ok, pivot = pcall(function() return item:GetPivot() end)\r\n        if not ok or not pivot or not insideMap(pivot.Position) then return nil end\r\n\r\n        local group, ring = 4, nil\r\n        local previous, ancestor = nil, item.Parent\r\n        while ancestor and ancestor ~= workspace do\r\n            if ancestor.Name == \"HollowMap\" or ancestor.Name == \"Hollow Plant\" then return nil end\r\n            if ancestor.Name == \"Landmarks\" and ancestor.Parent and ancestor.Parent.Name == \"Map\" then\r\n                if previous and string.match(previous.Name, \"^FlowerRing%d*$\") then\r\n                    group, ring = 1, previous\r\n                else\r\n                    group = 2\r\n                end\r\n                break\r\n            elseif ancestor.Name == \"Foliage\" and ancestor.Parent and ancestor.Parent.Name == \"Map\" then\r\n                group = 3\r\n                break\r\n            end\r\n            previous, ancestor = ancestor, ancestor.Parent\r\n        end\r\n        return {Item = item, Position = pivot.Position, Group = group, Ring = ring}\r\n    end\r\n\r\n    local function movementBusy()\r\n        local revealActive = AutoMapReveal and AutoMapReveal.State\r\n            and AutoMapReveal.State.IsScanning == true\r\n        -- Full Automation stays Active across the whole run; pause only for its\r\n        -- specific workers/teleport phases below, not for the master toggle.\r\n        local localPriorityActive = revealActive\r\n            or _G.AutoChestRunning or _G.KixHalloweenTrickBusy\r\n            or _G.IsStrongholdRaidActive or _G.StrongholdTransition or _G.StrongholdPreparingRaid\r\n            or _G.CampfireCombatActive or _G.GlobalCultistCombatActive\r\n            or _G.CorruptedCombatActive or _G.CorruptedChopActive\r\n            or _G.MossyCombatActive or _G.TurkeyCombatActive or _G.BearCombatActive\r\n            or _G.MammothCombatActive or _G.FrogCombatActive or _G.CustomHuntCombatActive\r\n            or (_G.KixAutoChopTargetActive == true\r\n                and os.clock() - (tonumber(_G.KixAutoChopTargetAt) or 0) < 1)\r\n            or _G.KixRescueBusy or _G.KixRescuePending\r\n            or _G.AutoFeedCampfireRunning or _G.IsEating or _G.KixHubAuraLock\r\n            or _G.NinjaAssistActive or KixSharedFarmHarvest.Active == true\r\n        if localPriorityActive then return true end\r\n\r\n        local now = os.clock()\r\n        if now >= nextPriorityCheck then\r\n            nextPriorityCheck = now + 0.5\r\n            local checker = _G.KixPriorityActionActive\r\n            if type(checker) == \"function\" then\r\n                local ok, result = pcall(checker)\r\n                nearbyPriorityActive = ok and result == true\r\n            else\r\n                nearbyPriorityActive = false\r\n            end\r\n        end\r\n        return nearbyPriorityActive\r\n    end\r\n\r\n    local function pick(item, runId)\r\n        if not enabled or generation ~= runId or not KixHubSession.Alive then return false end\r\n        local character = _LocalPlayer.Character\r\n        local root = character and character:FindFirstChild(\"HumanoidRootPart\")\r\n        local humanoid = character and character:FindFirstChildOfClass(\"Humanoid\")\r\n        if not root or not humanoid or humanoid.Health <= 0 or _LocalPlayer:GetAttribute(\"Undead\") then return false end\r\n        local info = describe(item)\r\n        local clientDistance = Client and Client.GlobalSettings and tonumber(Client.GlobalSettings.InteractionDistance)\r\n        local pickupRadius = clientDistance and (clientDistance + 1) or (REACH + 1)\r\n        if not info or (root.Position - info.Position).Magnitude > pickupRadius then return false end\r\n\r\n        local originalParent = item.Parent\r\n        local marked = pcall(function() item:SetAttribute(\"QueuedToTake\", true) end)\r\n        if not marked then return false end\r\n        local tempStorage = _ReplicatedStorage:FindFirstChild(\"TempStorage\")\r\n        local flowerClient = Client and Client.FlowerAndCoinsClient\r\n        local pullFlower = flowerClient and flowerClient.PullFlower\r\n        if pullFlower and not pulledFlowers[item] then\r\n            pulledFlowers[item] = true\r\n            pcall(pullFlower, item)\r\n        end\r\n        if tempStorage then pcall(function() item.Parent = tempStorage end) end\r\n        local ok, response = pcall(function()\r\n            local request = Client and Client.Events and Client.Events.RequestPickFlower\r\n            if not request then error(\"RequestPickFlower is unavailable\") end\r\n            return request:InvokeServer(item)\r\n        end)\r\n        if ok and type(response) == \"table\" and response.Success then return true end\r\n        if item.Parent then\r\n            pcall(function()\r\n                item.Parent = originalParent\r\n                item:SetAttribute(\"QueuedToTake\", nil)\r\n            end)\r\n            if enabled and generation == runId then track(item) end\r\n        end\r\n        return false\r\n    end\r\n\r\n    local function stopWorker(runId, character, home, links)\r\n        for _, link in ipairs(links) do pcall(function() link:Disconnect() end) end\r\n        local mayReturn = generation == runId or (not enabled and generation == runId + 1)\r\n        if mayReturn then\r\n            local tracked = {}\r\n            for item in pairs(itemLinks) do tracked[#tracked + 1] = item end\r\n            for _, item in ipairs(tracked) do untrack(item) end\r\n            table.clear(targets)\r\n        end\r\n        local characterNow = _LocalPlayer.Character\r\n        local root = character and character:FindFirstChild(\"HumanoidRootPart\")\r\n        local humanoid = character and character:FindFirstChildOfClass(\"Humanoid\")\r\n        if mayReturn and characterNow == character and character.Parent\r\n            and root and humanoid and humanoid.Health > 0 and not movementBusy() then\r\n            pcall(function()\r\n                character:PivotTo(home)\r\n                root.AssemblyLinearVelocity = Vector3.zero\r\n                root.AssemblyAngularVelocity = Vector3.zero\r\n            end)\r\n        end\r\n        if generation == runId then\r\n            enabled = false\r\n            if _G.AutoFarmFlowersToggle then pcall(function() _G.AutoFarmFlowersToggle:Set(false) end) end\r\n        end\r\n    end\r\n\r\n    local function startWorker(runId)\r\n        task.spawn(function()\r\n            local character = _LocalPlayer.Character\r\n            local root = character and character:FindFirstChild(\"HumanoidRootPart\")\r\n            local humanoid = character and character:FindFirstChildOfClass(\"Humanoid\")\r\n            if not character or not root or not humanoid or humanoid.Health <= 0 then\r\n                if generation == runId then\r\n                    enabled = false\r\n                    if _G.AutoFarmFlowersToggle then pcall(function() _G.AutoFarmFlowersToggle:Set(false) end) end\r\n                end\r\n                return\r\n            end\r\n            local home = character:GetPivot()\r\n            local links = {}\r\n            local function active()\r\n                return enabled and generation == runId and KixHubSession.Alive\r\n                    and _LocalPlayer.Character == character and character.Parent ~= nil\r\n                    and humanoid.Parent == character and humanoid.Health > 0\r\n            end\r\n            local function trackIfActive(item)\r\n                if active() then track(item) end\r\n            end\r\n            links[#links + 1] = collection:GetInstanceAddedSignal(\"Flower\"):Connect(trackIfActive)\r\n            links[#links + 1] = collection:GetInstanceAddedSignal(\"Interaction\"):Connect(trackIfActive)\r\n            links[#links + 1] = collection:GetInstanceRemovedSignal(\"Flower\"):Connect(trackIfActive)\r\n            links[#links + 1] = collection:GetInstanceRemovedSignal(\"Interaction\"):Connect(trackIfActive)\r\n            for _, tag in ipairs({\"Flower\", \"Interaction\"}) do\r\n                local taggedItems = collection:GetTagged(tag)\r\n                for index, item in ipairs(taggedItems) do\r\n                    trackIfActive(item)\r\n                    if index % 256 == 0 then task.wait() end\r\n                    if not active() then break end\r\n                end\r\n            end\r\n\r\n            local dwell = 0.5\r\n            local failures = setmetatable({}, {__mode = \"k\"})\r\n            local nextTry = setmetatable({}, {__mode = \"k\"})\r\n            while active() do\r\n                if movementBusy() then\r\n                    task.wait(0.5)\r\n                else\r\n                    local candidates = {}\r\n                    local examined = 0\r\n                    for item in pairs(targets) do\r\n                        examined += 1\r\n                        if (nextTry[item] or 0) <= os.clock() then\r\n                            local info = describe(item)\r\n                            if info then candidates[#candidates + 1] = info end\r\n                        end\r\n                        if examined % 256 == 0 then task.wait() end\r\n                        if not active() then break end\r\n                    end\r\n                    if #candidates == 0 then\r\n                        task.wait(5)\r\n                    else\r\n                        local origin, first, firstDistance = root.Position, nil, math.huge\r\n                        for _, info in ipairs(candidates) do\r\n                            local distance = (info.Position - origin).Magnitude\r\n                            if not first or info.Group < first.Group\r\n                                or (info.Group == first.Group and distance < firstDistance) then\r\n                                first, firstDistance = info, distance\r\n                            end\r\n                        end\r\n                        local stopPosition = first.Position\r\n                        if first.Ring then\r\n                            local ringOk, ringPivot = pcall(function() return first.Ring:GetPivot() end)\r\n                            if ringOk and ringPivot and insideMap(ringPivot.Position) then\r\n                                for _, info in ipairs(candidates) do\r\n                                    if (info.Position - ringPivot.Position).Magnitude <= REACH then\r\n                                        stopPosition = ringPivot.Position\r\n                                        break\r\n                                    end\r\n                                end\r\n                            end\r\n                        end\r\n                        local batch = {}\r\n                        for _, info in ipairs(candidates) do\r\n                            if (info.Position - stopPosition).Magnitude <= REACH then batch[#batch + 1] = info.Item end\r\n                        end\r\n                        if #batch == 0 then batch[1] = first.Item end\r\n\r\n                        if movementBusy() then\r\n                            task.wait(0.5)\r\n                            continue\r\n                        end\r\n                        local moved = pcall(function()\r\n                            character:PivotTo(CFrame.new(stopPosition + Vector3.new(0, 3, 0)))\r\n                            root.AssemblyLinearVelocity = Vector3.zero\r\n                            root.AssemblyAngularVelocity = Vector3.zero\r\n                        end)\r\n                        if not moved then\r\n                            task.wait(0.5)\r\n                            continue\r\n                        end\r\n                        task.wait(0.05)\r\n                        if not active() or movementBusy() then continue end\r\n                        local deadline = os.clock() + dwell\r\n                        local pickedThisStop, nextResend = 0, 0\r\n                        repeat\r\n                            if not active() or movementBusy() then break end\r\n                            local now, unresolved = os.clock(), 0\r\n                            for _, item in ipairs(batch) do\r\n                                if item.Parent == nil or item:GetAttribute(\"Destroyed\") then\r\n                                    failures[item], nextTry[item] = nil, nil\r\n                                elseif inFlight[item] then\r\n                                    unresolved += 1\r\n                                elseif item:GetAttribute(\"QueuedToTake\") then\r\n                                    if item:IsDescendantOf(workspace) then unresolved += 1 end\r\n                                elseif describe(item) then\r\n                                    unresolved += 1\r\n                                    if now >= (nextTry[item] or 0) and activePickCount < 8 then\r\n                                        inFlight[item] = true\r\n                                        activePickCount += 1\r\n                                        task.spawn(function()\r\n                                            local ok, result = pcall(pick, item, runId)\r\n                                            inFlight[item] = nil\r\n                                            activePickCount = math.max(0, activePickCount - 1)\r\n                                            if ok and result then\r\n                                                pickedThisStop += 1\r\n                                                failures[item], nextTry[item] = nil, nil\r\n                                            elseif enabled and generation == runId then\r\n                                                failures[item] = (failures[item] or 0) + 1\r\n                                                nextTry[item] = os.clock() + 0.1\r\n                                                if failures[item] >= 3 then\r\n                                                    failures[item], nextTry[item] = nil, os.clock() + 30\r\n                                                end\r\n                                            end\r\n                                        end)\r\n                                    end\r\n                                else\r\n                                    failures[item], nextTry[item] = nil, nil\r\n                                end\r\n                            end\r\n                            if unresolved == 0 then break end\r\n                            if now >= nextResend then\r\n                                nextResend = now + 0.05\r\n                                task.wait(0.01)\r\n                            else\r\n                                task.wait(0.02)\r\n                            end\r\n                        until os.clock() >= deadline\r\n                        local remaining = 0\r\n                        for _, item in ipairs(batch) do\r\n                            if item.Parent and not item:GetAttribute(\"QueuedToTake\") and describe(item) then\r\n                                remaining += 1\r\n                            end\r\n                        end\r\n                        if remaining > 0 then\r\n                            dwell = math.clamp(dwell * 1.5, 0.2, 2.5)\r\n                        elseif pickedThisStop > 0 then\r\n                            dwell = math.clamp(dwell * 0.9, 0.2, 2.5)\r\n                        else\r\n                            dwell = math.clamp(dwell * 1.5, 0.2, 2.5)\r\n                        end\r\n                    end\r\n                end\r\n            end\r\n            stopWorker(runId, character, home, links)\r\n        end)\r\n    end\r\n\r\n    _G.KixEngines.AutoFarmFlowers = function(value)\r\n        value = value == true\r\n        if value == enabled then return end\r\n        generation += 1\r\n        enabled = value\r\n        if value then startWorker(generation) end\r\n    end\r\n    _G.KixAdapters = _G.KixAdapters or {}\r\n    _G.KixAdapters.AutoFarmFlowers = {IsEnabled = function() return enabled == true end}\r\n\r\n    Tabs.Auto:Section({Title = \"Flowers\", Icon = \"flower\"})\r\n    _G.AutoFarmFlowersToggle = Tabs.Auto:Toggle({\r\n        Title = \"Auto Collect Flower\",\r\n        Desc = \"Gathers flowers from the explored map.\",\r\n        Value = false,\r\n        Callback = _G.KixEngines.AutoFarmFlowers,\r\n    })\r\nend)() end\r\n\r\nTabs.Auto:Section({Title = 'Revive Player', Icon = 'heart'})\r\n\r\nexcludeReviveTargets = {}\r\nExcludePlayerMap = {}\r\nlocal function getExcludePlayerList()\r\n    local list, map = GetPlayerDisplayListAndMap()\r\n    local finalList = {\"None\"}\r\n    ExcludePlayerMap = map\r\n    for _, v in ipairs(list) do table.insert(finalList, v) end\r\n    return finalList\r\nend\r\n\r\nCreateMultiDropdown(Tabs.Auto, {\r\n    Title = 'Select Players (Exclude)',\r\n    Desc = 'Select players to exclude from Auto Revive (e.g. to save bandages from noobs).',\r\n    Values = getExcludePlayerList(),\r\n    Multi = true,\r\n    Callback = function(val)\r\n        excludeReviveTargets = {}\r\n        if type(val) == \"table\" then\r\n            for _, selectedName in ipairs(val) do\r\n                if selectedName == \"None\" then\r\n                    excludeReviveTargets = {}\r\n                    return\r\n                end\r\n                if ExcludePlayerMap[selectedName] then\r\n                    excludeReviveTargets[ExcludePlayerMap[selectedName]] = true\r\n                end\r\n                local displayOnly = selectedName:match(\"^(.+) %(@.+%)$\") or selectedName\r\n                excludeReviveTargets[displayOnly] = true\r\n            end\r\n        end\r\n    end\r\n})\r\n\r\n-- Bring tagged dead player bodies to the campfire only while enabled.\r\n-- Discovery is event-driven: one initial snapshot plus PlayerBody tag/attribute events.\r\ndo (function()\r\n    local collection = game:GetService('CollectionService')\r\n    local enabled, generation = false, 0\r\n    local links, bodyLinks = {}, setmetatable({}, {__mode = 'k'})\r\n    local pending, moved = setmetatable({}, {__mode = 'k'}), setmetatable({}, {__mode = 'k'})\r\n    local queue, draining = {}, false\r\n    local slot = 0\r\n    _G.KixReturnedDeadBodies = {\r\n        IsEnabled = function() return enabled == true end,\r\n        IsReturned = function(body) return moved[body] == true end,\r\n    }\r\n\r\n    local function disconnectBody(body)\r\n        local list = bodyLinks[body]\r\n        if list then\r\n            for _, link in ipairs(list) do pcall(function() link:Disconnect() end) end\r\n            bodyLinks[body] = nil\r\n        end\r\n    end\r\n\r\n    local function stopLinks()\r\n        for _, link in ipairs(links) do pcall(function() link:Disconnect() end) end\r\n        table.clear(links)\r\n        for body in pairs(bodyLinks) do disconnectBody(body) end\r\n        for body in pairs(pending) do pending[body] = nil end\r\n        table.clear(queue)\r\n    end\r\n\r\n    local function eligible(body)\r\n        if not body or not body:IsA('Model') or not body:IsDescendantOf(workspace) then return false end\r\n        local userId = body:GetAttribute('PlayerBody')\r\n        if type(userId) ~= 'number' or not _Players:GetPlayerByUserId(userId) then return false end\r\n        local interaction = body:GetAttribute('Interaction')\r\n        return interaction == 'Revive'\r\n            or (interaction == nil and body:GetAttribute('Owner') == _LocalPlayer.UserId)\r\n    end\r\n\r\n    local function drain(runId)\r\n        if draining then return end\r\n        draining = true\r\n        task.spawn(function()\r\n            while enabled and generation == runId and #queue > 0 do\r\n                local body = table.remove(queue, 1)\r\n                if body and eligible(body) and not moved[body] then\r\n                    local fire = workspace:FindFirstChild('Map')\r\n                    fire = fire and fire:FindFirstChild('Campground')\r\n                    fire = fire and fire:FindFirstChild('MainFire')\r\n                    local transport = _G.KixItemTransportSystem\r\n                    if fire and (fire:IsA('Model') or fire:IsA('BasePart'))\r\n                        and transport and type(transport.Move) == 'function'\r\n                        and type(transport.CanTeleport) == 'function' and transport.CanTeleport(body) then\r\n                        slot += 1\r\n                        local point = slot - 1\r\n                        local ring = math.floor(point / 8)\r\n                        local angle = (point % 8) * (math.pi / 4)\r\n                        local radius = 8 + ring * 3\r\n                        local target = fire:GetPivot() * CFrame.new(\r\n                            math.cos(angle) * radius,\r\n                            4,\r\n                            math.sin(angle) * radius\r\n                        )\r\n                        local ok, result = pcall(transport.Move, body, target, function()\r\n                            return enabled and generation == runId and eligible(body)\r\n                        end)\r\n                        if ok and result then moved[body] = true end\r\n                    end\r\n                end\r\n                pending[body] = nil\r\n            end\r\n            draining = false\r\n            if enabled and #queue > 0 then drain(generation) end\r\n        end)\r\n    end\r\n\r\n    local function bring(body, runId)\r\n        if not enabled or generation ~= runId or pending[body] or moved[body] or not eligible(body) then return end\r\n        pending[body] = true\r\n        table.insert(queue, body)\r\n        drain(runId)\r\n    end\r\n\r\n    local function watch(body, runId)\r\n        if bodyLinks[body] then bring(body, runId); return end\r\n        local function changed() bring(body, runId) end\r\n        local list = {}\r\n        local ok, signal = pcall(function() return body:GetAttributeChangedSignal('PlayerBody') end)\r\n        if ok and signal then table.insert(list, signal:Connect(changed)) end\r\n        ok, signal = pcall(function() return body:GetAttributeChangedSignal('Interaction') end)\r\n        if ok and signal then table.insert(list, signal:Connect(changed)) end\r\n        ok, signal = pcall(function() return body:GetAttributeChangedSignal('Owner') end)\r\n        if ok and signal then table.insert(list, signal:Connect(changed)) end\r\n        table.insert(list, body.AncestryChanged:Connect(function(_, parent)\r\n            if not parent then disconnectBody(body) else changed() end\r\n        end))\r\n        bodyLinks[body] = list\r\n        bring(body, runId)\r\n    end\r\n\r\n    _G.KixEngines.AutoBringDeadBodies = function(value)\r\n        value = value == true\r\n        if value == enabled then return end\r\n        generation += 1\r\n        enabled = value\r\n        stopLinks()\r\n        if not enabled then return end\r\n        local runId = generation\r\n        table.insert(links, collection:GetInstanceAddedSignal('PlayerBody'):Connect(function(body)\r\n            watch(body, runId)\r\n        end))\r\n        table.insert(links, collection:GetInstanceRemovedSignal('PlayerBody'):Connect(disconnectBody))\r\n        for _, body in ipairs(collection:GetTagged('PlayerBody')) do watch(body, runId) end\r\n    end\r\n    _G.KixAdapters = _G.KixAdapters or {}\r\n    _G.KixAdapters.AutoBringDeadBodies = {\r\n        IsEnabled = function() return enabled == true end,\r\n        SetState = _G.KixEngines.AutoBringDeadBodies,\r\n    }\r\nend)() end\r\n\r\n_G.KixStartupFeatures.Toggles.AutoBringDeadBodies = Tabs.Auto:Toggle({\r\n    Title = '🔥 Return Died Players',\r\n    Desc = 'Automatically brings dead players to the campfire.',\r\n    Value = false,\r\n    Callback = function(value)\r\n        _G.KixStartupFeatures.Set('AutoBringDeadBodies', value)\r\n    end\r\n})\r\n\r\nautoRevivePlayers = false\r\n_G.KixEngines.AutoReviveOthers = function(val)\r\n    val = val == true\r\n    if val == (autoRevivePlayers == true) then return end\r\n    _G.KixEngines.Tokens.AutoReviveOthers = (_G.KixEngines.Tokens.AutoReviveOthers or 0) + 1\r\n    local token = _G.KixEngines.Tokens.AutoReviveOthers\r\n\r\n        autoRevivePlayers = val\r\n        if val then\r\n            _G.KixEngines.Spawn(\"AutoReviveOthers\", function()\r\n                while autoRevivePlayers and token == _G.KixEngines.Tokens.AutoReviveOthers do\r\n                    task.wait(1)\r\n                    local fullAuto = _G.KixFullAuto\r\n                    if fullAuto and fullAuto.Active\r\n                        and type(fullAuto.IsSkipped) == \"function\"\r\n                        and fullAuto.IsSkipped(\"Revive Player\") then\r\n                        continue\r\n                    end\r\n                    pcall(function()\r\n                        for _, char in ipairs(workspace.Characters:GetChildren()) do\r\n                            if char.Name:match(\" Body$\") then\r\n                                local bodyDisplayName = char.Name:gsub(\" Body$\", \"\")\r\n                                \r\n                                if excludeReviveTargets[bodyDisplayName] then continue end\r\n                                \r\n                                local bodyUserId = char:GetAttribute(\"PlayerBody\")\r\n                                if bodyUserId then\r\n                                    local targetPlayer = _Players:GetPlayerByUserId(bodyUserId)\r\n                                    if targetPlayer and excludeReviveTargets[targetPlayer.Name] then continue end\r\n                                end\r\n\r\n                                local returnState = _G.KixReturnedDeadBodies\r\n                                if fullAuto and fullAuto.Active\r\n                                    and (not returnState or not returnState.IsReturned(char)) then\r\n                                    continue\r\n                                end\r\n                                \r\n                                local remote = game:GetService(\"ReplicatedStorage\"):FindFirstChild(\"RemoteEvents\") and game:GetService(\"ReplicatedStorage\").RemoteEvents:FindFirstChild(\"RequestRevivePlayer\")\r\n                                if remote then\r\n                                    remote:FireServer(char)\r\n                                end\r\n                            end\r\n                        end\r\n                    end)\r\n                end\r\n            end)\r\n        end\r\nend\r\n\r\n_G.KixStartupFeatures.Toggles.AutoReviveOthers = Tabs.Auto:Toggle({\r\n    Title = '❤︎ Auto Revive Other Players',\r\n    Desc = 'Automatically revive players if you have bandages or medkit',\r\n    Value = false,\r\n    Callback = function(value)\r\n        _G.KixStartupFeatures.Set(\"AutoReviveOthers\", value)\r\n    end\r\n})\r\n-- Status paragraph intentionally hidden; engine state remains available internally.\r\n_G.KixStartupFeatures.Status.AutoReviveOthers = nil\r\n-- Full Automation manages this startup feature through Ensure as well.\r\n_G.KixAdapters.AutoReviveOthers = {\r\n    IsEnabled = function()\r\n        return autoRevivePlayers == true\r\n    end,\r\n    SetState = function(state)\r\n        return _G.KixEngines.AutoReviveOthers(state)\r\n    end\r\n}\r\n\r\n\r\n-- ==================== PLAYER TAB ====================\r\nTabs.Player:Section({Title = 'Player Settings', Icon = 'user'})\r\n\r\nTabs.Player:Toggle({\r\n    Title = 'Enable Walk and Fly Speed',\r\n    Value = true,\r\n    Callback = function(val)\r\n        WalkSpeedEnabled = val\r\n        if val and humanoid then\r\n            applyWalkSpeedGuard()\r\n        elseif humanoid then\r\n            if walkSpeedConn then walkSpeedConn:Disconnect() end\r\n            humanoid.WalkSpeed = 16\r\n        end\r\n    end\r\n})\r\n\r\nTabs.Player:Slider({\r\n    Title = 'Set Speed',\r\n    Value = {Min = 16, Max = 350, Default = 16},\r\n    Callback = function(val)\r\n        TargetWalkSpeed = val\r\n        if WalkSpeedEnabled and humanoid then\r\n            humanoid.WalkSpeed = val\r\n        end\r\n    end\r\n})\r\n\r\nFlyToggle = Tabs.Player:Toggle({\r\n    Title = 'Enable Fly',\r\n    Value = false,\r\n    Callback = function(val)\r\n        if val then startFlying() else stopFlying() end\r\n    end\r\n})\r\n\r\nTabs.Player:Section({Title = 'Power Settings', Icon = 'flame'})\r\n\r\nTabs.Player:Toggle({\r\n    Title = 'Infinite Jump',\r\n    Value = true,\r\n    Callback = function(val)\r\n        InfiniteJumpEnabled = val\r\n    end\r\n})\r\n\r\nNoclipToggle = Tabs.Player:Toggle({\r\n    Title = 'No Clip',\r\n    Value = false,\r\n    Callback = function(state)\r\n        if state then startNoclip() else stopNoclip() end\r\n    end\r\n})\r\n\r\nautoStunNpc = false\r\nTabs.Player:Toggle({\r\n    Title = 'Auto Stun',\r\n    Desc = 'Stuns Deer, Ram, Owl, and Cats on the map. (Requires a flashlight)',\r\n    Value = false,\r\n    Callback = function(val)\r\n        autoStunNpc = val\r\n        if val then\r\n            -- Auto Bring: Seret 2 Old Flashlight dari map ke player\r\n            task.spawn(function()\r\n                pcall(function()\r\n                    local hrp = _LocalPlayer.Character and _LocalPlayer.Character:FindFirstChild(\"HumanoidRootPart\")\r\n                    local itemsFolder = (_Workspace:FindFirstChild(\"Items\") or workspace:FindFirstChild(\"items\"))\r\n                    if hrp and itemsFolder then\r\n                        local brought = 0\r\n                        for _, item in ipairs(itemsFolder:GetChildren()) do\r\n                            if brought >= 2 then break end\r\n                            if item.Name == \"Old Flashlight\" then\r\n                                dragItemSmooth(item, hrp.Position)\r\n                                brought = brought + 1\r\n                                task.wait(0.1)\r\n                            end\r\n                        end\r\n                    end\r\n                end)\r\n            end)\r\n            task.spawn(function()\r\n                while autoStunNpc do\r\n                    pcall(function()\r\n                        local lp = game:GetService(\"Players\").LocalPlayer\r\n                        local inv = lp:FindFirstChild(\"Inventory\")\r\n                        local hasFlashlight = false\r\n                        \r\n                        -- Check if player has any flashlight\r\n                        if inv then\r\n                            for _, item in ipairs(inv:GetChildren()) do\r\n                                if string.match(item.Name, \"Flashlight\") then\r\n                                    hasFlashlight = true\r\n                                    break\r\n                                end\r\n                            end\r\n                        end\r\n                        \r\n                        if hasFlashlight then\r\n                            local remote = _ReplicatedStorage:FindFirstChild('RemoteEvents') and _ReplicatedStorage.RemoteEvents:FindFirstChild('MonsterHitByTorch')\r\n                            if not remote then \r\n                                remote = _ReplicatedStorage:FindFirstChild('RemoteEvents') and _ReplicatedStorage.RemoteEvents:FindFirstChild('DeerHitByTorch')\r\n                            end\r\n                            \r\n                            local chars = workspace:FindFirstChild('Characters')\r\n                            local root = lp.Character and lp.Character:FindFirstChild(\"HumanoidRootPart\")\r\n                            \r\n                            if remote and chars and root then\r\n                                for _, npc in ipairs(chars:GetChildren()) do\r\n                                    if npc.Name == \"Deer\" or npc.Name == \"Ram\" or npc.Name == \"Owl\" or npc.Name == \"Cat\" then\r\n                                        task.spawn(function()\r\n                                            pcall(function() remote:InvokeServer(npc) end)\r\n                                        end)\r\n                                    end\r\n                                end\r\n                            end\r\n                        end\r\n                    end)\r\n                    task.wait(0.2)\r\n                end\r\n            end)\r\n        end\r\n    end\r\n})\r\n\r\n\r\nTabs.Player:Section({Title = 'Safety', Icon = 'shield'})\r\n_G.AntiVoidEnabled = true\r\nTabs.Player:Toggle({\r\n    Title = 'Anti Void',\r\n    Desc = 'Automatically saves you from falling into the void. Teleports you back to your last safe position.',\r\n    Value = true,\r\n    Callback = function(val)\r\n        _G.AntiVoidEnabled = val\r\n        if val then\r\n            WindUI:Notify({Title = 'Anti Void', Content = 'Anti Void enabled!', Duration = 2})\r\n        else\r\n            WindUI:Notify({Title = 'Anti Void', Content = 'Anti Void disabled!', Duration = 2})\r\n        end\r\n    end\r\n})\r\n\r\n-- =========================================================\r\n-- ANTI GAMEPLAY PAUSED (SAFE MODE WITH COOLDOWN)\r\n-- Default: ON\r\n-- =========================================================\r\n\r\nlocal Players = game:GetService(\"Players\")\r\nlocal LocalPlayer = Players.LocalPlayer\r\n\r\n-- Initialize global state\r\n_G.GameplayPauseWatchdogEnabled = true\r\n\r\n-- Debounce and Cooldown Settings\r\nlocal isBypassing = false\r\nlocal cooldownDuration = 10 -- (Dalam detik) Durasi \"napas\" setelah mematikan pause\r\n\r\n-- Function to override and disable gameplay pause safely\r\nlocal function handleGameplayPaused()\r\n    -- Stop if toggle is OFF\r\n    if not _G.GameplayPauseWatchdogEnabled then return end\r\n    \r\n    -- Stop if we are already processing or in cooldown phase\r\n    if isBypassing then return end\r\n    \r\n    if LocalPlayer.GameplayPaused then\r\n        isBypassing = true\r\n        \r\n        -- A tiny 0.1s delay before disabling pause to prevent instant engine crash\r\n        task.wait(0.1) \r\n        \r\n        -- Safely change the property\r\n        pcall(function()\r\n            if LocalPlayer.GameplayPaused then\r\n                LocalPlayer.GameplayPaused = false\r\n            end\r\n        end)\r\n        \r\n        -- Cooldown Phase: Give Roblox engine a breather for 10 seconds.\r\n        -- During this time, if the game pauses again, the script will ignore it.\r\n        task.wait(cooldownDuration)\r\n        \r\n        -- End of cooldown, ready to bypass again if needed\r\n        isBypassing = false\r\n    end\r\nend\r\n\r\nTabs.Player:Toggle({\r\n    Title = 'Anti Gameplay Paused',\r\n    Desc = 'Helps prevent gameplay pause issues',\r\n    Value = true,\r\n\r\n    Callback = function(val)\r\n        _G.GameplayPauseWatchdogEnabled = val\r\n\r\n        if val then\r\n            WindUI:Notify({\r\n                Title = 'Anti Gameplay Paused',\r\n                Content = 'Anti Gameplay Paused enabled!',\r\n                Duration = 2\r\n            })\r\n            \r\n            -- Check immediately in a separate thread safely\r\n            task.spawn(handleGameplayPaused)\r\n        else\r\n            WindUI:Notify({\r\n                Title = 'Anti Gameplay Paused',\r\n                Content = 'Anti Gameplay Paused disabled!',\r\n                Duration = 2\r\n            })\r\n        end\r\n    end\r\n})\r\n\r\n-- =======================================================