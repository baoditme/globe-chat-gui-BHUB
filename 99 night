l Skull\",\r\n        Desc = \"Routes available Crystal Skull Keys to unfilled temple stands and resumes when more keys appear.\",\r\n        Value = false,\r\n        Callback = _G.KixEngines.AutoCompleteCrystalSkullKey,\r\n    })\r\n    _G.KixHiddenFillEmptyKeyPedestalsButton = Tabs.Auto:Button({\r\n        Title = \"Fill Empty Key Pedestals\",\r\n        Desc = \"Send one unused key to each temple stand that is loaded and still empty.\",\r\n        Icon = \"gem\",\r\n        Variant = \"Primary\",\r\n        Callback = function()\r\n            _G.KixEngines.Spawn(\"CompleteCrystalSkullKey\", function()\r\n                local count, result = deliver(function() return KixHubSession.Alive end)\r\n                if KixHubSession.Alive and WindUI then\r\n                    WindUI:Notify({Title = count > 0 and \"Skull Keys Moved\" or \"Jungle Temple\",\r\n                        Content = tostring(result), Duration = 4, Icon = \"gem\"})\r\n                end\r\n            end)\r\n        end,\r\n    })\r\n    pcall(function()\r\n        local button = _G.KixHiddenFillEmptyKeyPedestalsButton\r\n        local frame = button and button.ButtonFrame and button.ButtonFrame.UIElements\r\n            and button.ButtonFrame.UIElements.Main\r\n        if frame then frame.Visible = false; frame.Size = UDim2.new(0, 0, 0, 0) end\r\n    end)\r\nend)() end\r\n\r\n-- Start both support systems on every script execution. Their controls are\r\n-- created with Value=true so WindUI renders the active thumb in its correct\r\n-- position from first paint instead of being visually patched after creation.\r\ndo (function()\r\n    local function enableOnStartup(name)\r\n        local adapters = _G.KixAdapters\r\n        local engines = _G.KixEngines\r\n        local adapter = adapters and adapters[name]\r\n        local engine = engines and engines[name]\r\n        if not adapter or type(adapter.IsEnabled) ~= \"function\" or type(engine) ~= \"function\" then\r\n            warn(\"[Startup] Cannot initialise \" .. tostring(name) .. \": engine adapter unavailable\")\r\n            return\r\n        end\r\n\r\n        if adapter.IsEnabled() ~= true then\r\n            local ok, err = pcall(engine, true)\r\n            if not ok then\r\n                warn(\"[Startup] Failed to enable \" .. tostring(name) .. \": \" .. tostring(err))\r\n                return\r\n            end\r\n        end\r\n\r\n    end\r\n\r\n    enableOnStartup(\"SemiGodMode\")\r\n    enableOnStartup(\"AutoEat\")\r\nend)() end\r\n\r\n-- ==================== AUTO CHEST SECTION ====================\r\nautoSkipNight = false\r\nTabs.Auto:Section({Title = 'Auto Chest', Icon = 'box'})\r\n_G.OpenedChestsMemory = setmetatable(_G.OpenedChestsMemory or {}, {__mode = \"k\"})\r\nAutoChestStatus = Tabs.Auto:Paragraph({Title = \"Auto Chest Status\", Desc = \"Status: Idle\"})\r\n\r\nhighTierChests = {\r\n    \"Item Chest4\", \"Item Chest5\", \"Item Chest6\", \"Volcanic Chest1\", \"Volcanic Chest2\", \"Jungle Chest2\",\r\n    \"StoneChest2\", \"Alien Chest\", \"Alien Military Chest\", \"Vampire Chest\", \"Corrupted Chest\",\r\n    \"Halloween Maze Chest\", \"Hardmode Crate\", \"Mossy Chest\", \"Snow Chest2\", \"Costume Box\"\r\n}\r\nlowTierChests = {\"Halloween Chest1\", \"Item Chest\", \"Item Chest2\", \"Item Chest3\", \"Snow Chest1\", \"StoneChest1\", \"Jungle Chest1\"}\r\nautoChestBringItems = {\r\n    \"Happy's Scythe\", \"Strong Axe\", \"Strong Flashlight\", \"Corrupted Axe\", \"Good Sack\", \"Giant Sack\", \"Diamond\", \"Diamonds\",\r\n    \"Defense Blueprint\", \"Iron Body\", \"Defensive Blueprint Barbed Wire\", \"Morningstar\", \"Morning Star\", \"Cultist Gem\",\r\n    \"Gem of the Forest Fragment\", \"Chainsaw\", \"Kunai\", \"Riot Shield\", \"Thorn Body\", \"Strong Flashlight\",\r\n    \"Tactical Shotgun\", \"Vampire Cloak\", \"Scythe\", \"Bouncing Blade\", \"Wildfire\",\r\n    \"Infernal Sword\", \"Infernal Crossbow\", \"Raygun\", \"Laser Fence Blueprint\", \"Laser Sword\", \"Alien Armour\", \"Laser Cannon\"\r\n}\r\nSinglePriorityLoot = {\r\n    [\"Happy's Scythe\"] = true, [\"Strong Axe\"] = true, [\"Chainsaw\"] = true,\r\n    [\"Good Sack\"] = true, [\"Giant Sack\"] = true,\r\n    [\"Infernal Sword\"] = true, [\"Morningstar\"] = true, [\"Morning Star\"] = true,\r\n    [\"Strong Flashlight\"] = true, [\"Thorn Body\"] = true,\r\n    [\"Alien Armour\"] = true, [\"Vampire Cloak\"] = true, [\"Scythe\"] = true,\r\n}\r\nUnlimitedPriorityLoot = { [\"Defense Blueprint\"] = true, [\"Bandage\"] = true, [\"MedKit\"] = true, [\"Medkit\"] = true }\r\nautoChestRunning, autoChestHasRun = false, false\r\nincludeHighTierChests, includeLowTierChests = true, true\r\n\r\nfunction hasInventoryItem(itemName)\r\n    local inventory = _LocalPlayer:FindFirstChild(\"Inventory\")\r\n    if inventory and inventory:FindFirstChild(itemName) then return true end\r\n    local backpack = _LocalPlayer:FindFirstChild(\"Backpack\")\r\n    if backpack and backpack:FindFirstChild(itemName) then return true end\r\n    local character = _LocalPlayer.Character\r\n    return character ~= nil and character:FindFirstChild(itemName) ~= nil\r\nend\r\nfunction hasHammer() return hasInventoryItem(\"Hammer\") end\r\n\r\nfunction autoBuyToolTraderItems()\r\n    local remoteEvents = _ReplicatedStorage:FindFirstChild(\"RemoteEvents\")\r\n    local getExtraState = remoteEvents and remoteEvents:FindFirstChild(\"GetExtraState\")\r\n    local purchaseExtra = remoteEvents and remoteEvents:FindFirstChild(\"RequestPurchaseExtra\")\r\n    local purchaseTool = remoteEvents and remoteEvents:FindFirstChild(\"RequestPurchaseTool\")\r\n    if not purchaseExtra or not purchaseTool then return false end\r\n\r\n    local coins = tonumber(_LocalPlayer:GetAttribute(\"Coins\")) or 0\r\n    local hammerPurchased = hasHammer()\r\n    if not hammerPurchased and getExtraState and getExtraState:IsA(\"RemoteFunction\") then\r\n        local ok, state = pcall(function() return getExtraState:InvokeServer() end)\r\n        hammerPurchased = ok and type(state) == \"table\" and state.HammerPurchased == true\r\n    end\r\n\r\n    local function requestPurchase(remote, itemName)\r\n        return pcall(function()\r\n            if remote:IsA(\"RemoteEvent\") then remote:FireServer(itemName)\r\n            elseif remote:IsA(\"RemoteFunction\") then remote:InvokeServer(itemName)\r\n            else error(\"Unsupported purchase remote\") end\r\n        end)\r\n    end\r\n\r\n    if not hammerPurchased and coins >= 25 then\r\n        requestPurchase(purchaseExtra, \"Hammer\")\r\n        task.wait(0.25)\r\n        coins = tonumber(_LocalPlayer:GetAttribute(\"Coins\")) or 0\r\n    end\r\n    if coins >= 20 then\r\n        requestPurchase(purchaseTool, \"Old Rod\")\r\n        task.wait(0.25)\r\n        coins = tonumber(_LocalPlayer:GetAttribute(\"Coins\")) or 0\r\n    end\r\n    if coins >= 20 then\r\n        requestPurchase(purchaseTool, \"Old Taming Flute\")\r\n    end\r\n    return true\r\nend\r\n\r\nTabs.Auto:Toggle({Title = '🥇 High-Tier Chests', Desc = 'Include rare chests (Strong Axe, Giant Sack, Corrupted, Hardmode, etc.)', Value = true, Callback = function(value) includeHighTierChests = value == true end})\r\nTabs.Auto:Toggle({Title = '🥉 Low-Tier Chests', Desc = 'Include common chests (Item Chest 1-3, Snow Chest1, etc.)', Value = true, Callback = function(value) includeLowTierChests = value == true end})\r\n\r\n-- Event-driven chest queue + bounded chest-drop watcher. Delivery remains KixDev Anti Void.\r\ndo\r\n    local Core = {Running = false}\r\n    local allowedInteractions = {Item = true, Tool = true, Armour = true, Currency = true}\r\n    local function selectedName(name)\r\n        local longest, enabled = 0, false\r\n        for _, pair in ipairs({{highTierChests, includeHighTierChests}, {lowTierChests, includeLowTierChests}}) do\r\n            for _, chestName in ipairs(pair[1]) do\r\n                if name:sub(1, #chestName) == chestName and #chestName > longest then\r\n                    longest, enabled = #chestName, pair[2] == true\r\n                end\r\n            end\r\n        end\r\n        return longest > 0 and enabled\r\n    end\r\n    local function isLootName(name)\r\n        return table.find(autoChestBringItems, name) ~= nil or SinglePriorityLoot[name] == true\r\n            or UnlimitedPriorityLoot[name] == true\r\n            or name == \"Bandage\" or name == \"MedKit\" or name == \"Medkit\"\r\n    end\r\n    function Core.Run(isValid, setStatus, waitFor, stopWhenIdle, concurrent, onDeliveryActive, keepAlive)\r\n        if Core.Running then return false, \"Auto Chest is already running\" end\r\n        if not includeHighTierChests and not includeLowTierChests then return false, \"Select at least one chest tier\" end\r\n        Core.Running = true\r\n        autoChestRunning = true\r\n        if not concurrent then _G.AutoChestRunning = true end\r\n        _G.AutoChestStatus = \"running\"\r\n        local deliveryActivated = not concurrent\r\n        if deliveryActivated then\r\n            if _G.AutoChestAntiVoidOriginal == nil then\r\n                _G.AutoChestAntiVoidOriginal = _G.AntiVoidItemsEnabled\r\n            end\r\n            _G.AutoChestAntiVoidMode, _G.AntiVoidItemsEnabled = true, true\r\n            _G.AutoChestBroughtCounts = {}\r\n        end\r\n        _G.TempEquippedCache = _G.TempEquippedCache or {}\r\n\r\n        local connections, folderConnections = {}, {}\r\n        local chestRecords = setmetatable({}, {__mode = \"k\"})\r\n        local dropRecords = setmetatable({}, {__mode = \"k\"})\r\n        local medicineRecords = setmetatable({}, {__mode = \"k\"})\r\n        local priorityRetryRecords = setmetatable({}, {__mode = \"k\"})\r\n        local sackRetryRecords = setmetatable({}, {__mode = \"k\"})\r\n        -- Keep the chest key strongly reachable through the loot replication window;\r\n        -- entries are expired after five seconds and the table is cleared on cleanup.\r\n        local openedDrops = {}\r\n        local openQueue, queueHead, queueTail = {}, 1, 0\r\n        local itemsFolder, openedKey = nil, tostring(math.abs(_LocalPlayer.UserId)) .. \"Opened\"\r\n        local lastActivity, lastOpenRequest = os.clock(), 0\r\n        local openedCount, routedCount, requestCount = 0, 0, 0\r\n        local workCount, workStarted = 0, os.clock()\r\n        local nextPriorityPickupAt = 0\r\n        local priorityPickupNames = {\r\n            [\"Strong Axe\"] = true, [\"Strong Flashlight\"] = true,\r\n            [\"Good Sack\"] = true, [\"Giant Sack\"] = true,\r\n            [\"Morningstar\"] = true, [\"Morning Star\"] = true, [\"Scythe\"] = true, [\"Rifle\"] = true,\r\n            [\"Tactical Shotgun\"] = true, [\"Happy's Scythe\"] = true,\r\n            [\"Infernal Sword\"] = true, [\"Poison Claws\"] = true,\r\n        }\r\n        local function active()\r\n            if not KixHubSession.Alive or not Core.Running then return false end\r\n            if isValid then local ok, value = pcall(isValid); if not ok or value ~= true then return false end end\r\n            return true\r\n        end\r\n        local function wait(seconds)\r\n            if not active() then return false end\r\n            if waitFor then local ok, value = pcall(waitFor, seconds or 0); return ok and value ~= false and active() end\r\n            task.wait(seconds or 0)\r\n            return active()\r\n        end\r\n        local function report(text)\r\n            _G.AutoChestStatus = text\r\n            if setStatus then pcall(setStatus, text) end\r\n        end\r\n        local function budget()\r\n            workCount += 1\r\n            if workCount >= 32 or os.clock() - workStarted >= 0.001 then\r\n                workCount, workStarted = 0, os.clock()\r\n                return wait(0)\r\n            end\r\n            return active()\r\n        end\r\n        local function positionOf(item)\r\n            if not item or not item.Parent then return nil end\r\n            local ok, position = pcall(function()\r\n                if item:IsA(\"Model\") then return item:GetPivot().Position end\r\n                if item:IsA(\"BasePart\") then return item.Position end\r\n                local part = item:FindFirstChild(\"Handle\") or item:FindFirstChildWhichIsA(\"BasePart\", true)\r\n                return part and part.Position\r\n            end)\r\n            return ok and position or nil\r\n        end\r\n        local function chestOpened(chest)\r\n            return chest:GetAttribute(\"LocalOpened\") == true\r\n                or chest:GetAttribute(openedKey) == true\r\n                or (chest:GetAttribute(\"ChestEmpty\") == true and chest:GetAttribute(\"ChristmasPresent\") ~= true)\r\n        end\r\n        local function matchingOpenedChest(position, itemTime, now)\r\n            for chest, opened in pairs(openedDrops) do\r\n                if itemTime >= opened.at - 1 and now <= opened.at + 5\r\n                    and (position - opened.position).Magnitude <= 12 then return true end\r\n                if now > opened.at + 5 then openedDrops[chest] = nil end\r\n            end\r\n            return false\r\n        end\r\n        local function isEligibleChest(chest)\r\n            if not active() or not chest or chest.Parent ~= itemsFolder or not chest:IsA(\"Model\") then return false end\r\n            if not selectedName(chest.Name) or chest:GetAttribute(\"Locked\") == true or chestOpened(chest) then return false end\r\n            local primary = chest.PrimaryPart\r\n            if not primary then return false end\r\n            return primary:FindFirstChild(\"ProximityAttachment\") ~= nil or chest:FindFirstChildWhichIsA(\"ProximityPrompt\", true) ~= nil\r\n        end\r\n        local queueChest\r\n        local function noteOpened(chest, record)\r\n            if chestOpened(chest) and not record.opened then\r\n                record.opened, record.sent, record.openedAt = true, true, os.clock()\r\n                local position = positionOf(chest)\r\n                if position then openedDrops[chest] = {at = record.openedAt, position = position} end\r\n                _G.OpenedChestsMemory[chest] = true\r\n                openedCount += 1\r\n                lastActivity = os.clock()\r\n            end\r\n        end\r\n        local function trackChest(chest)\r\n            if not chest or chest.Parent ~= itemsFolder or not chest:IsA(\"Model\") or not selectedName(chest.Name) or chestRecords[chest] then return end\r\n            local record = {connections = {}, queued = false, sent = false, attempts = 0, opened = chestOpened(chest)}\r\n            chestRecords[chest] = record\r\n            local function changed()\r\n                if not active() then return end\r\n                noteOpened(chest, record)\r\n                if chest:GetAttribute(\"Locked\") == true then record.sent, record.queued = false, false else queueChest(chest, record) end\r\n            end\r\n            for _, attribute in ipairs({\"Locked\", \"LocalOpened\", openedKey, \"ChestEmpty\", \"ChristmasPresent\", \"Interaction\"}) do\r\n                table.insert(record.connections, chest:GetAttributeChangedSignal(attribute):Connect(changed))\r\n            end\r\n            table.insert(record.connections, chest:GetPropertyChangedSignal(\"Name\"):Connect(changed))\r\n            table.insert(record.connections, chest:GetPropertyChangedSignal(\"PrimaryPart\"):Connect(changed))\r\n            table.insert(record.connections, chest.DescendantAdded:Connect(function(child)\r\n                if child.Name == \"ProximityAttachment\" or child:IsA(\"ProximityPrompt\") then changed() end\r\n            end))\r\n            if not record.opened then queueChest(chest, record) end\r\n        end\r\n        queueChest = function(chest, record)\r\n            if not active() or record.attempts >= 3 or record.queued or record.sent or not isEligibleChest(chest) then return end\r\n            record.queued = true\r\n            queueTail += 1\r\n            openQueue[queueTail] = {item = chest, record = record}\r\n            lastActivity = os.clock()\r\n        end\r\n        local function eligibleDrop(item)\r\n            if not item or item.Parent ~= itemsFolder or not isLootName(item.Name) then return false end\r\n            if _G.KixIsBringBlacklistedItem and _G.KixIsBringBlacklistedItem(item) then return false end\r\n            if not allowedInteractions[item:GetAttribute(\"Interaction\")] then return false end\r\n            if not (item:IsA(\"Model\") or item:IsA(\"BasePart\") or item:IsA(\"Tool\")) then return false end\r\n            if item:IsA(\"Model\") and not item.PrimaryPart then return false end\r\n            local owner = item:GetAttribute(\"Owner\")\r\n            if owner ~= nil and owner ~= _LocalPlayer.UserId then return false end\r\n            if item:GetAttribute(\"Locked\") or item:GetAttribute(\"IceBlock\") or item:GetAttribute(\"EasterDraggingLocked\") or item:GetAttribute(\"NoDragging\") then return false end\r\n            return not isItemHeldByAnotherPlayer(item, true)\r\n        end\r\n        local function trackDrop(item)\r\n            if concurrent and not deliveryActivated then return end\r\n            if not item or item.Parent ~= itemsFolder or not isLootName(item.Name) then return end\r\n            if priorityPickupNames[item.Name] then return end\r\n            if item.Name == \"Bandage\" or item.Name == \"MedKit\" or item.Name == \"Medkit\" then return end\r\n            if _G.KixIsLoggingCampItem and _G.KixIsLoggingCampItem(item) then return end\r\n            if not dropRecords[item] then\r\n                dropRecords[item] = {at = os.clock(), position = positionOf(item), nextAttempt = 0, busy = false}\r\n                lastActivity = os.clock()\r\n            end\r\n        end\r\n        local function trackMedicine(item)\r\n            if not item or item.Parent ~= itemsFolder then return end\r\n            if item.Name ~= \"Bandage\" and item.Name ~= \"MedKit\" and item.Name ~= \"Medkit\" then return end\r\n            if not (item:IsA(\"Model\") or item:IsA(\"BasePart\") or item:IsA(\"Tool\")) then return end\r\n            if not medicineRecords[item] then\r\n                medicineRecords[item] = {at = os.clock(), attempts = 0, nextAttempt = 0}\r\n                lastActivity = os.clock()\r\n            end\r\n        end\r\n        local function medicineInventoryCount(name)\r\n            local count = 0\r\n            local function countContainer(container)\r\n                if container then\r\n                    for _, child in ipairs(container:GetChildren()) do\r\n                        if child.Name == name then count += 1 end\r\n                    end\r\n                end\r\n            end\r\n            countContainer(_LocalPlayer:FindFirstChild(\"Inventory\"))\r\n            countContainer(_LocalPlayer:FindFirstChild(\"Backpack\"))\r\n            countContainer(_LocalPlayer.Character)\r\n            return count\r\n        end\r\n        local function eligibleMedicine(item)\r\n            if not item or item.Parent ~= itemsFolder then return false end\r\n            local owner = item:GetAttribute(\"Owner\")\r\n            if owner ~= nil and owner ~= _LocalPlayer.UserId then return false end\r\n            if item:GetAttribute(\"Locked\") or item:GetAttribute(\"IceBlock\")\r\n                or item:GetAttribute(\"EasterDraggingLocked\") or item:GetAttribute(\"NoDragging\") then\r\n                return false\r\n            end\r\n            return not isItemHeldByAnotherPlayer(item, true)\r\n        end\r\n        local function processMedicine(remote)\r\n            local now = os.clock()\r\n            for item, record in pairs(medicineRecords) do\r\n                if not budget() then return false end\r\n                if not item.Parent or item.Parent ~= itemsFolder or now - record.at > 15 then\r\n                    medicineRecords[item] = nil\r\n                elseif now >= record.nextAttempt then\r\n                    if not eligibleMedicine(item) then\r\n                        record.nextAttempt = now + 0.75\r\n                    else\r\n                        record.attempts += 1\r\n                        record.nextAttempt = now + 0.4\r\n                        local beforeCount = medicineInventoryCount(item.Name)\r\n                        local requestOk, requestResult = false, nil\r\n                        local function requestPickup()\r\n                            if not remote or item.Parent ~= itemsFolder then return false, nil end\r\n                            return pcall(function()\r\n                                if remote:IsA(\"RemoteFunction\") then return remote:InvokeServer(item) end\r\n                                if remote:IsA(\"RemoteEvent\") then remote:FireServer(item); return nil end\r\n                                return false\r\n                            end)\r\n                        end\r\n                        if remote and item.Parent == itemsFolder then\r\n                            requestOk, requestResult = requestPickup()\r\n                        end\r\n                        if not wait(0.1) then return false end\r\n                        local collected = item.Parent ~= itemsFolder\r\n                            or medicineInventoryCount(item.Name) > beforeCount\r\n                            or (type(requestResult) == \"table\" and requestResult.Success == true)\r\n                            or requestResult == true\r\n                        if not collected and item.Parent == itemsFolder then\r\n                            local hrp = _LocalPlayer.Character and _LocalPlayer.Character:FindFirstChild(\"HumanoidRootPart\")\r\n                            if hrp then pcall(function() dragItemSmooth(item, hrp.Position) end) end\r\n                            if not wait(0.1) then return false end\r\n                            requestOk, requestResult = requestPickup()\r\n                            if not wait(0.1) then return false end\r\n                            collected = item.Parent ~= itemsFolder\r\n                                or medicineInventoryCount(item.Name) > beforeCount\r\n                                or (type(requestResult) == \"table\" and requestResult.Success == true)\r\n                                or requestResult == true\r\n                        end\r\n                        if requestOk and collected then\r\n                            medicineRecords[item] = nil\r\n                            lastActivity = os.clock()\r\n                            report(\"Picked up \" .. item.Name .. \" from Auto Chest\")\r\n                        elseif record.attempts >= 3 then\r\n                            medicineRecords[item] = nil\r\n                            report(\"Medicine pickup not confirmed: \" .. item.Name)\r\n                        end\r\n                        return active()\r\n                    end\r\n                end\r\n            end\r\n            return true\r\n        end\r\n        local function findHappyScythe()\r\n            if itemsFolder then\r\n                local item = itemsFolder:FindFirstChild(\"Happy's Scythe\")\r\n                if item then return item end\r\n            end\r\n            local map = workspace:FindFirstChild(\"Map\")\r\n            local landmarks = map and map:FindFirstChild(\"Landmarks\")\r\n            local plot = landmarks and landmarks:FindFirstChild(\"LargeHalloweenPlot6\")\r\n            local plotItems = plot and plot:FindFirstChild(\"Items\")\r\n            return (plotItems and plotItems:FindFirstChild(\"Happy's Scythe\"))\r\n                or (landmarks and landmarks:FindFirstChild(\"Happy's Scythe\", true))\r\n        end\r\n        local function hasPriorityItem(name)\r\n            if hasInventoryItem(name) then return true end\r\n            local playerGui = _LocalPlayer:FindFirstChild(\"PlayerGui\")\r\n            local interface = playerGui and playerGui:FindFirstChild(\"Interface\")\r\n            local hotbar = interface and interface:FindFirstChild(\"Hotbar\")\r\n            return hotbar ~= nil and hotbar:FindFirstChild(\"Button\" .. name) ~= nil\r\n        end\r\n        local function isMorningStar(name)\r\n            return name == \"Morningstar\" or name == \"Morning Star\"\r\n        end\r\n        local function pickupPriorityItem(name, item, remote)\r\n            if isMorningStar(name) and hasPriorityItem(\"Infernal Sword\") then return false end\r\n            if hasPriorityItem(name) then return true end\r\n            if not item or not item.Parent or not priorityPickupNames[name] then return false end\r\n            local isWorldScythe = name == \"Happy's Scythe\" and item.Parent ~= itemsFolder\r\n            if not isWorldScythe and item.Parent ~= itemsFolder then return false end\r\n            local owner = item:GetAttribute(\"Owner\")\r\n            if owner ~= nil and owner ~= _LocalPlayer.UserId then return false end\r\n            if item:GetAttribute(\"Locked\") or item:GetAttribute(\"IceBlock\")\r\n                or item:GetAttribute(\"EasterDraggingLocked\") or item:GetAttribute(\"NoDragging\")\r\n                or isItemHeldByAnotherPlayer(item, true) then return false end\r\n\r\n            local character = _LocalPlayer.Character\r\n            local hrp = character and character:FindFirstChild(\"HumanoidRootPart\")\r\n            if not hrp or not remote then return false end\r\n            local origin = hrp.CFrame\r\n            if name == \"Strong Axe\" then\r\n                -- Reuse the same no-equip pickup route used by Full Automation.\r\n                -- It verifies inventory/hotbar after dragging, instead of assuming\r\n                -- the remote call succeeded (which is unreliable on low-level execs).\r\n                local fullAuto = _G.KixFullAuto\r\n                local pickupStrongAxe = fullAuto and fullAuto.TryPickupStrongAxeDrop\r\n                if type(pickupStrongAxe) == \"function\" then\r\n                    local token = fullAuto.Active and fullAuto.RunToken or nil\r\n                    pcall(pickupStrongAxe, token, item)\r\n                    if hasPriorityItem(name) then\r\n                        lastActivity = os.clock()\r\n                        report(\"Picked up Strong Axe from Auto Chest\")\r\n                        return true\r\n                    end\r\n                    return false\r\n                end\r\n                return false\r\n            end\r\n            local function requestPickup()\r\n                if not item.Parent then return false end\r\n                local ok, result = pcall(function()\r\n                    if remote:IsA(\"RemoteFunction\") then return remote:InvokeServer(item) end\r\n                    if remote:IsA(\"RemoteEvent\") then remote:FireServer(item); return true end\r\n                    return false\r\n                end)\r\n                return ok and (result == true or (type(result) == \"table\" and result.Success == true))\r\n            end\r\n\r\n            if isWorldScythe then\r\n                local ok, position = pcall(function()\r\n                    if item:IsA(\"Model\") then return item:GetPivot().Position end\r\n                    if item:IsA(\"BasePart\") then return item.Position end\r\n                    local part = item:FindFirstChildWhichIsA(\"BasePart\", true)\r\n                    return part and part.Position\r\n                end)\r\n                if not ok or not position then return false end\r\n                pcall(function() hrp.CFrame = CFrame.new(position + Vector3.new(0, 3, 0)) end)\r\n                if not wait(0.05) then\r\n                    if _LocalPlayer.Character == character and hrp.Parent then pcall(function() hrp.CFrame = origin end) end\r\n                    return false\r\n                end\r\n                for _, descendant in ipairs(item:GetDescendants()) do\r\n                    if descendant:IsA(\"ProximityPrompt\") then\r\n                        if type(fireproximityprompt) == \"function\" then\r\n                            pcall(fireproximityprompt, descendant)\r\n                        else\r\n                            pcall(function()\r\n                                descendant:InputHoldBegin()\r\n                                task.wait(descendant.HoldDuration + 0.1)\r\n                                descendant:InputHoldEnd()\r\n                            end)\r\n                        end\r\n                    end\r\n                end\r\n                pcall(function()\r\n                    local handler = Client and Client.InteractionHandler\r\n                    if handler and handler.Interactions and handler.Interactions.PickUpWindmillScythe then\r\n                        handler.Interactions.PickUpWindmillScythe(item)\r\n                    elseif handler and handler.TriggerInteraction then\r\n                        handler.TriggerInteraction(\"PickUpWindmillScythe\", item)\r\n                    end\r\n                end)\r\n                requestPickup()\r\n                local stillRunning = wait(0.1)\r\n                if _LocalPlayer.Character == character and hrp.Parent then\r\n                    pcall(function() hrp.CFrame = origin end)\r\n                end\r\n                if not stillRunning then return false end\r\n                if hasPriorityItem(name) then _G.TempEquippedCache[name] = true; return true end\r\n                return false\r\n            end\r\n\r\n            requestPickup()\r\n            if not wait(0.1) then return false end\r\n            if not hasPriorityItem(name) and item.Parent == itemsFolder then\r\n                pcall(function() dragItemSmooth(item, hrp.Position) end)\r\n                if not wait(0.1) then return false end\r\n                requestPickup()\r\n            end\r\n            if not wait(0.1) then return false end\r\n            if hasPriorityItem(name) then\r\n                if name == \"Happy's Scythe\" then _G.TempEquippedCache[name] = true end\r\n                lastActivity = os.clock()\r\n                report(\"Picked up \" .. name .. \" from Auto Chest\")\r\n                return true\r\n            end\r\n            return false\r\n        end\r\n        local autoObtainTools = {}\r\n        function autoObtainTools.getRank(item)\r\n            if not item then return 0 end\r\n            local capacity = tonumber(item:GetAttribute(\"Capacity\"))\r\n            if capacity and capacity == capacity and math.abs(capacity) ~= math.huge then\r\n                return capacity\r\n            end\r\n            local ranks = { [\"Old Sack\"] = 1, [\"Good Sack\"] = 2, [\"Giant Sack\"] = 3,\r\n                [\"Infernal Sack\"] = 4, [\"Admin Sack\"] = 5 }\r\n            return ranks[item.Name] or (item:GetAttribute(\"ToolName\") == \"Sack\" and 1 or 0)\r\n        end\r\n        function autoObtainTools.ownedRank()\r\n            local best = 0\r\n            local character = _LocalPlayer.Character\r\n            local roots = {\r\n                _LocalPlayer:FindFirstChild(\"Inventory\"), _LocalPlayer:FindFirstChild(\"Armour\"),\r\n                _LocalPlayer:FindFirstChild(\"Backpack\"), character,\r\n            }\r\n            for _, root in pairs(roots) do\r\n                if root then\r\n                    for _, tool in ipairs(root:GetChildren()) do\r\n                        if tool:GetAttribute(\"ToolName\") == \"Sack\"\r\n                            or tool.Name == \"Good Sack\" or tool.Name == \"Giant Sack\"\r\n                            or tool.Name == \"Infernal Sack\" or tool.Name == \"Admin Sack\" then\r\n                            best = math.max(best, autoObtainTools.getRank(tool))\r\n                        end\r\n                    end\r\n                end\r\n            end\r\n            for _, sackName in ipairs({\"Good Sack\", \"Giant Sack\"}) do\r\n                if hasPriorityItem(sackName) then\r\n                    best = math.max(best, sackName == \"Giant Sack\" and 3 or 2)\r\n                end\r\n            end\r\n            return best\r\n        end\r\n        function autoObtainTools.choose(candidates)\r\n            local ownedRank = autoObtainTools.ownedRank()\r\n            for _, sackName in ipairs({\"Good Sack\", \"Giant Sack\"}) do\r\n                local sack = candidates[sackName]\r\n                local retry = sack and sackRetryRecords[sack]\r\n                if sack and sack.Parent == itemsFolder and (not retry or retry.Attempts < 3) then\r\n                    local rank = autoObtainTools.getRank(sack)\r\n                    if rank > ownedRank then return sackName, sack, rank, ownedRank end\r\n                end\r\n            end\r\n            return nil, nil, ownedRank, ownedRank\r\n        end\r\n        function autoObtainTools.eligible(item, remote)\r\n            if not item or item.Parent ~= itemsFolder or not item:IsA(\"Model\") or not item.PrimaryPart then return false end\r\n            if item:GetAttribute(\"Interaction\") ~= \"Tool\" then return false end\r\n            if item:GetAttribute(\"Locked\") == true or item:GetAttribute(\"IceBlock\") == true\r\n                or item:GetAttribute(\"QueuedToTake\") == true or item:GetAttribute(\"EasterDraggingLocked\") == true\r\n                or item:GetAttribute(\"NoDragging\") == true then return false end\r\n            local owner = item:GetAttribute(\"Owner\")\r\n            if owner ~= nil and owner ~= _LocalPlayer.UserId then return false end\r\n            if not remote or not remote.Parent or isItemHeldByAnotherPlayer(item, true) then return false end\r\n            local primary = item.PrimaryPart\r\n            if primary.Anchored and not primary.CanCollide and not primary.CanQuery and not primary.CanTouch then\r\n                local hasMovablePart = false\r\n                for _, part in ipairs(item:GetDescendants()) do\r\n                    if part:IsA(\"BasePart\") and (not part.Anchored or part.CanCollide or part.CanQuery or part.CanTouch) then\r\n                        hasMovablePart = true\r\n                        break\r\n                    end\r\n                end\r\n                if not hasMovablePart then return false end\r\n            end\r\n            return true\r\n        end\r\n        function autoObtainTools.pickup(name, item, remote, targetRank)\r\n            if autoObtainTools.ownedRank() >= targetRank or hasPriorityItem(name) then return true end\r\n            local character = _LocalPlayer.Character\r\n            local hrp = character and character:FindFirstChild(\"HumanoidRootPart\")\r\n            if not hrp or not autoObtainTools.eligible(item, remote) then return false end\r\n            local originalCharacter = character\r\n            if not dragItemSmooth(item, hrp.Position) then return false end\r\n            if not active() or _LocalPlayer.Character ~= originalCharacter or not autoObtainTools.eligible(item, remote) then return false end\r\n            local requestOk, response = pcall(function()\r\n                if remote:IsA(\"RemoteFunction\") then return remote:InvokeServer(item) end\r\n                if remote:IsA(\"RemoteEvent\") then remote:FireServer(item); return nil end\r\n                return false\r\n            end)\r\n            if not requestOk or (type(response) == \"table\" and response.Success == false) or response == false then\r\n                return false\r\n            end\r\n            local confirmUntil = os.clock() + 1.25\r\n            repeat\r\n                if autoObtainTools.ownedRank() >= targetRank or hasPriorityItem(name) then\r\n                    _G.TempEquippedCache[name] = true\r\n                    return true\r\n                end\r\n                if not wait(0.1) then return false end\r\n            until os.clock() >= confirmUntil\r\n            return autoObtainTools.ownedRank() >= targetRank or hasPriorityItem(name)\r\n        end\r\n        function autoObtainTools.attempt(name, item, remote, targetRank)\r\n            if not item or not item.Parent or autoObtainTools.ownedRank() >= targetRank then return false end\r\n            local now = os.clock()\r\n            local retry = sackRetryRecords[item]\r\n            if retry and (retry.Attempts >= 3 or now < retry.NextAt) then return false end\r\n            retry = retry or {Attempts = 0, NextAt = 0}\r\n            retry.Attempts += 1\r\n            retry.NextAt = now + 5\r\n            sackRetryRecords[item] = retry\r\n            lastActivity = now\r\n            report(\"Auto Obtain Tools: collecting \" .. name)\r\n            local picked = autoObtainTools.pickup(name, item, remote, targetRank)\r\n            if picked or autoObtainTools.ownedRank() >= targetRank then\r\n                sackRetryRecords[item] = nil\r\n                lastActivity = os.clock()\r\n                report(\"Auto Obtain Tools: confirmed \" .. name .. \" in inventory\")\r\n                return true\r\n            end\r\n            return false\r\n        end\r\n        local function attemptPriorityPickup(name, item, remote)\r\n            if not item or not item.Parent then return false end\r\n            if isMorningStar(name) and hasPriorityItem(\"Infernal Sword\") then\r\n                priorityRetryRecords[item] = nil\r\n                return false\r\n            end\r\n            if hasPriorityItem(name) then\r\n                priorityRetryRecords[item] = nil\r\n                return true\r\n            end\r\n            local attempts = priorityRetryRecords[item] or 0\r\n            if attempts >= 2 then return false end\r\n            priorityRetryRecords[item] = attempts + 1\r\n            local picked = pickupPriorityItem(name, item, remote)\r\n            if picked or hasPriorityItem(name) then\r\n                priorityRetryRecords[item] = nil\r\n                return true\r\n            end\r\n            return false\r\n        end\r\n        function autoObtainTools.kidsDelivered()\r\n            -- Manual chest mode has no kid-rescue phase, so allow its sack\r\n            -- pickup from the first Auto Chest scan during Map Reveal.\r\n            local fullAuto = _G.KixFullAuto\r\n            if fullAuto and fullAuto.StopAfterChestLoot == true then return true end\r\n\r\n            local fireAdapter = _G.KixAdapters and _G.KixAdapters.UpgradeFire\r\n            if not fireAdapter or type(fireAdapter.GetLevel) ~= \"function\" then return false end\r\n            local fireOk, fireLevel = pcall(fireAdapter.GetLevel)\r\n            if not fireOk or type(fireLevel) ~= \"number\" or fireLevel < 6 then return false end\r\n\r\n            if _G.KixRescueBusy or _G.KixRescuePending then return false end\r\n            local rescueAdapter = _G.KixAdapters and _G.KixAdapters.AutoRescue\r\n            if rescueAdapter and type(rescueAdapter.IsCarryingKid) == \"function\" then\r\n                local ok, carrying = pcall(rescueAdapter.IsCarryingKid)\r\n                if not ok or carrying then return false end\r\n            end\r\n            if type(_G.KixRescueFindTarget) == \"function\" then\r\n                local scanOk, remainingKid = pcall(_G.KixRescueFindTarget)\r\n                if not scanOk or remainingKid then return false end\r\n            end\r\n            if fullAuto and type(fullAuto.TentCount) == \"function\" then\r\n                local countOk, tentCount = pcall(fullAuto.TentCount)\r\n                if not countOk or type(tentCount) ~= \"number\" or tentCount < 4 then return false end\r\n            else\r\n                local structures = workspace:FindFirstChild(\"Structures\")\r\n                if not structures then return false end\r\n                local rescuedKinds = {}\r\n                for _, structure in ipairs(structures:GetChildren()) do\r\n                    local name = structure.Name\r\n                    for _, kind in ipairs({\"Dino\", \"Kraken\", \"Koala\", \"Squid\"}) do\r\n                        if name:match(\"^Tent\" .. kind .. \"Kid%d*$\") or name == \"Tent\" .. kind then\r\n                            rescuedKinds[kind] = true\r\n                        end\r\n                    end\r\n                end\r\n                local count = 0\r\n                for _, kind in ipairs({\"Dino\", \"Kraken\", \"Koala\", \"Squid\"}) do\r\n                    if rescuedKinds[kind] then count += 1 end\r\n                end\r\n                if count < 4 then return false end\r\n            end\r\n            return true\r\n        end\r\n        local function processPriorityPickups(remote)\r\n            local now = os.clock()\r\n            if now < nextPriorityPickupAt then return true end\r\n            nextPriorityPickupAt = now + 5\r\n\r\n            local sackPickupAllowed = autoObtainTools.kidsDelivered()\r\n            if not remote or not remote.Parent then\r\n                local remotes = _ReplicatedStorage:FindFirstChild(\"RemoteEvents\")\r\n                remote = remotes and remotes:FindFirstChild(\"RequestHotbarItem\")\r\n            end\r\n            if not itemsFolder or not remote then return true end\r\n\r\n            local candidates = {}\r\n            local priorityPending = false\r\n            for index, item in ipairs(itemsFolder:GetChildren()) do\r\n                local sackRetry = sackRetryRecords[item]\r\n                local sackRetryEligible = (item.Name ~= \"Good Sack\" and item.Name ~= \"Giant Sack\")\r\n                    or not sackRetry or sackRetry.Attempts < 3\r\n                if priorityPickupNames[item.Name] and sackRetryEligible and not candidates[item.Name]\r\n                    and ((item.Name ~= \"Good Sack\" and item.Name ~= \"Giant Sack\")\r\n                        or autoObtainTools.eligible(item, remote)) then\r\n                    local owner = item:GetAttribute(\"Owner\")\r\n                    local isBlocked = item:GetAttribute(\"Locked\") == true\r\n                        or item:GetAttribute(\"IceBlock\") == true\r\n                        or item:GetAttribute(\"EasterDraggingLocked\") == true\r\n                        or item:GetAttribute(\"NoDragging\") == true\r\n                        or (_G.KixIsBringBlacklistedItem and _G.KixIsBringBlacklistedItem(item))\r\n                    local held = false\r\n                    pcall(function() held = isItemHeldByAnotherPlayer(item, true) end)\r\n                    if not isBlocked and not held and (owner == nil or owner == _LocalPlayer.UserId) then\r\n                        candidates[item.Name] = item\r\n                    end\r\n                end\r\n                if index % 32 == 0 and not budget() then return false end\r\n            end\r\n\r\n            if not candidates[\"Happy's Scythe\"] and not hasPriorityItem(\"Happy's Scythe\") then\r\n                local worldScythe = findHappyScythe()\r\n                if worldScythe and worldScythe.Parent then\r\n                    candidates[\"Happy's Scythe\"] = worldScythe\r\n                end\r\n            end\r\n\r\n            local sackChoice = sackPickupAllowed and {autoObtainTools.choose(candidates)} or nil\r\n            local sackItem = sackChoice and sackChoice[2]\r\n            for name, item in pairs(candidates) do\r\n                if name == \"Good Sack\" or name == \"Giant Sack\" then\r\n                    local retry = item and sackRetryRecords[item]\r\n                    if item == sackItem and (not retry or retry.Attempts < 3)\r\n                        and (not retry or now >= retry.NextAt) then\r\n                        priorityPending = true\r\n                        break\r\n                    end\r\n                elseif not (isMorningStar(name) and hasPriorityItem(\"Infernal Sword\"))\r\n                    and not hasPriorityItem(name) and (priorityRetryRecords[item] or 0) < 2 then\r\n                    priorityPending = true\r\n                    break\r\n                end\r\n            end\r\n\r\n            -- Keep both manual and Full Automation scans alive while an eligible\r\n            -- priority pickup remains on the map, so a failed request gets retried\r\n            -- on the next five-second scan instead of ending Auto Chest early.\r\n            if priorityPending then lastActivity = now end\r\n\r\n            if not hasPriorityItem(\"Strong Axe\") and candidates[\"Strong Axe\"] then\r\n                attemptPriorityPickup(\"Strong Axe\", candidates[\"Strong Axe\"], remote)\r\n            end\r\n\r\n            if sackChoice and sackChoice[1] and sackItem then\r\n                autoObtainTools.attempt(sackChoice[1], sackItem, remote, sackChoice[3])\r\n            end\r\n\r\n            for _, name in ipairs({\"Strong Flashlight\", \"Poison Claws\", \"Infernal Sword\", \"Morningstar\", \"Morning Star\", \"Scythe\", \"Rifle\", \"Tactical Shotgun\", \"Happy's Scythe\"}) do\r\n                local alreadyHasInfernalSword = isMorningStar(name) and hasPriorityItem(\"Infernal Sword\")\r\n                if not alreadyHasInfernalSword and not hasPriorityItem(name) then\r\n                    local item = candidates[name]\r\n                    if name == \"Happy's Scythe\" and not item then item = findHappyScythe() end\r\n                    if item then attemptPriorityPickup(name, item, remote) end\r\n                end\r\n                if not active() then return false end\r\n            end\r\n            return active()\r\n        end\r\n        local function activateDelivery()\r\n            if deliveryActivated then return true end\r\n            if _G.AutoChestAntiVoidOriginal == nil then\r\n                _G.AutoChestAntiVoidOriginal = _G.AntiVoidItemsEnabled\r\n            end\r\n            _G.AutoChestAntiVoidMode, _G.AntiVoidItemsEnabled = true, true\r\n            _G.AutoChestBroughtCounts = {}\r\n            deliveryActivated = true\r\n            lastActivity = os.clock()\r\n            if type(onDeliveryActive) == \"function\" then pcall(onDeliveryActive) end\r\n            if itemsFolder and not concurrent then\r\n                for index, item in ipairs(itemsFolder:GetChildren()) do\r\n                    if not active() then return false end\r\n                    trackDrop(item)\r\n                    if index % 32 == 0 and not budget() then return false end\r\n                end\r\n            end\r\n            report(\"Map Reveal complete; routing chest loot through KixDev Anti Void\")\r\n            return active()\r\n        end\r\n        local function untrackChest(chest)\r\n            local record = chestRecords[chest]\r\n            if record then\r\n                for _, connection in ipairs(record.connections) do pcall(function() connection:Disconnect() end) end\r\n                chestRecords[chest] = nil\r\n            end\r\n        end\r\n        local function bindFolder(folder)\r\n            if itemsFolder ~= folder then\r\n                for chest in pairs(chestRecords) do untrackChest(chest) end\r\n                table.clear(dropRecords)\r\n                table.clear(openedDrops)\r\n                table.clear(openQueue)\r\n                queueHead, queueTail = 1, 0\r\n            end\r\n            for _, connection in ipairs(folderConnections) do pcall(function() connection:Disconnect() end) end\r\n            table.clear(folderConnections)\r\n            itemsFolder = folder\r\n            if not folder then return end\r\n            table.insert(folderConnections, folder.ChildAdded:Connect(function(item)\r\n                trackChest(item)\r\n                trackDrop(item)\r\n                trackMedicine(item)\r\n            end))\r\n            table.insert(folderConnections, folder.ChildRemoved:Connect(function(item)\r\n                dropRecords[item] = nil\r\n                medicineRecords[item] = nil\r\n                untrackChest(item)\r\n            end))\r\n            for index, item in ipairs(folder:GetChildren()) do\r\n                if not active() then return end\r\n                trackChest(item)\r\n                trackDrop(item)\r\n                trackMedicine(item)\r\n                if index % 32 == 0 and not budget() then return end\r\n            end\r\n            lastActivity = os.clock()\r\n        end\r\n        local function openOne(entry, remote)\r\n            local chest, record = entry.item, entry.record\r\n            record.queued = false\r\n            if chestRecords[chest] ~= record or not isEligibleChest(chest) or record.attempts >= 3 then return end\r\n            local ok = false\r\n            if remote and remote:IsA(\"RemoteEvent\") then ok = pcall(function() remote:FireServer(chest) end)\r\n            else\r\n                local prompt = chest:FindFirstChildWhichIsA(\"ProximityPrompt\", true)\r\n                if prompt then ok = pcall(function() fireproximityprompt(prompt) end) end\r\n            end\r\n            if ok then\r\n                record.sent, record.sentAt = true, os.clock()\r\n                record.attempts += 1\r\n                requestCount += 1\r\n                lastOpenRequest, lastActivity = os.clock(), os.clock()\r\n                report(string.format(\"Auto Chest: sent %d request(s); observed %d opened chest(s)\", requestCount, openedCount))\r\n            end\r\n        end\r\n        local function deliverDrops()\r\n            local now = os.clock()\r\n            for item, record in pairs(dropRecords) do\r\n                if not budget() then return false end\r\n                if not item.Parent or item.Parent ~= itemsFolder or now - record.at > 7 then dropRecords[item] = nil\r\n                elseif not record.busy and now >= record.nextAttempt then\r\n                    local position = record.position or positionOf(item)\r\n                    if position then record.position = position end\r\n                    if position and now >= record.nextAttempt and eligibleDrop(item) and matchingOpenedChest(position, record.at, now) then\r\n                        local horizontalDistance = (Vector3.new(position.X, 0, position.Z) - Vector3.new(campfirePos.X, 0, campfirePos.Z)).Magnitude\r\n                        record.nextAttempt = now + 0.5\r\n                        if horizontalDistance < 35 and position.Y > campfirePos.Y - 20 then\r\n                            dropRecords[item] = nil\r\n                            routedCount += 1\r\n                            lastActivity = os.clock()\r\n                            report(string.format(\"Chest loot routed to Anti Void: %d item(s)\", routedCount))\r\n                        elseif not record.announced then\r\n                            record.announced = true\r\n                            report(\"Chest loot detected; KixDev Anti Void is routing it to Campfire\")\r\n                        end\r\n                    end\r\n                end\r\n            end\r\n            return true\r\n        end\r\n        local ok, result, detail = xpcall(function()\r\n            local remotes = game:GetService(\"ReplicatedStorage\"):FindFirstChild(\"RemoteEvents\")\r\n            local requestOpen = remotes and remotes:FindFirstChild(\"RequestOpenItemChest\")\r\n            local requestHotbarItem = remotes and remotes:FindFirstChild(\"RequestHotbarItem\")\r\n            table.insert(connections, workspace.ChildAdded:Connect(function(child) if child.Name == \"Items\" then bindFolder(child) end end))\r\n            table.insert(connections, workspace.ChildRemoved:Connect(function(child) if child == itemsFolder then bindFolder(workspace:FindFirstChild(\"Items\")) end end))\r\n            if not workspace:FindFirstChild(\"KixHub_SafeZonePlatform\") then\r\n                local platform = Instance.new(\"Part\")\r\n                platform.Name, platform.Size = \"KixHub_SafeZonePlatform\", Vector3.new(500, 2, 500)\r\n                platform.Position = campfirePos - Vector3.new(0, 50, 0)\r\n                platform.Anchored, platform.CanCollide, platform.Transparency = true, true, 1\r\n                platform.Parent = workspace\r\n            end\r\n            bindFolder(workspace:FindFirstChild(\"Items\"))\r\n            report(\"Auto Chest: monitoring loaded and streamed chests\")\r\n            while active() do\r\n                local now = os.clock()\r\n                for chest, record in pairs(chestRecords) do\r\n                    if not budget() then break end\r\n                    noteOpened(chest, record)\r\n                    if chest.Parent == itemsFolder and not record.opened then\r\n                        if record.sent and now - (record.sentAt or now) >= 1.5 then\r\n                            record.sent = false\r\n                            if record.attempts < 3 then queueChest(chest, record) end\r\n                        elseif not record.sent then queueChest(chest, record) end\r\n                    end\r\n                end\r\n                local stopReady = true\r\n                if type(stopWhenIdle) == \"function\" then\r\n                    local conditionOk, condition = pcall(stopWhenIdle)\r\n                    stopReady = conditionOk and condition == true\r\n                end\r\n                if stopReady then\r\n                    stopReady = openQueue[queueHead] == nil\r\n                end\r\n                if stopReady then\r\n                    for chest, record in pairs(chestRecords) do\r\n                        if not record.opened and record.attempts < 3 and isEligibleChest(chest) then\r\n                            stopReady = false\r\n                            break\r\n                        end\r\n                    end\r\n                end\r\n                if concurrent and stopReady and not deliveryActivated then\r\n                    if not activateDelivery() then break end\r\n                    -- Full Automation opens chests during Map Reveal. Once the\r\n                    -- preparation gate is reached and queued chests are handled,\r\n                    -- let the existing Campfire loot phase take over.\r\n                    break\r\n                end\r\n                local entry = openQueue[queueHead]\r\n                if entry then\r\n                    openQueue[queueHead] = nil\r\n                    queueHead += 1\r\n                    openOne(entry, requestOpen)\r\n                    if not wait(0.05) then break end\r\n                end\r\n                if not processMedicine(requestHotbarItem) then break end\r\n                if not processPriorityPickups(requestHotbarItem) then break end\r\n                if not deliverDrops() then break end\r\n                if queueHead > queueTail then table.clear(openQueue); queueHead, queueTail = 1, 0 end\r\n                -- Give delayed chest loot two five-second pickup scans, then let\r\n                -- Full Automation proceed even if an executor cannot collect one.\r\n                if os.clock() - lastActivity >= 10 and os.clock() - lastOpenRequest >= 10\r\n                    and next(dropRecords) == nil and next(medicineRecords) == nil and stopReady\r\n                    and keepAlive ~= true then\r\n                    break\r\n                end\r\n                if not wait(keepAlive == true and 0.5 or 0.1) then break end\r\n            end\r\n            return active(), string.format(\"opened=%d requests=%d routed=%d\", openedCount, requestCount, routedCount)\r\n        end, function(err) return tostring(err) end)\r\n        for _, connection in ipairs(folderConnections) do pcall(function() connection:Disconnect() end) end\r\n        for _, connection in ipairs(connections) do pcall(function() connection:Disconnect() end) end\r\n        for chest, record in pairs(chestRecords) do\r\n            for _, connection in ipairs(record.connections) do pcall(function() connection:Disconnect() end) end\r\n            chestRecords[chest] = nil\r\n        end\r\n        table.clear(openQueue)\r\n        table.clear(openedDrops)\r\n        Core.Running = false\r\n        autoChestRunning = false\r\n        if not concurrent then _G.AutoChestRunning = false end\r\n        if not ok then return false, result end\r\n        _G.AutoChestStatus = detail or \"completed\"\r\n        return result == true, detail or \"cancelled\"\r\n    end\r\n    _G.KixAutoChestCore = Core\r\n\r\n    -- Shared manual/Full Automation tail: return to Campfire, collect coin\r\n    -- stacks, then buy the same Tool Trader items in the same order.\r\n    function Core.FinalizeCampfireLoot(isValid, waitFor, setStatus, teleportToCampfire)\r\n        local function valid()\r\n            if type(isValid) ~= \"function\" then return true end\r\n            local ok, value = pcall(isValid)\r\n            return ok and value == true\r\n        end\r\n        local function wait(seconds)\r\n            if type(waitFor) == \"function\" then return waitFor(seconds) end\r\n            task.wait(seconds or 0)\r\n            return valid()\r\n        end\r\n        local function status(stage, detail)\r\n            if type(setStatus) == \"function\" then\r\n                pcall(setStatus, stage, detail)\r\n            end\r\n        end\r\n\r\n        if not valid() then return false, \"cancelled before Campfire looting\" end\r\n        status(\"CHEST_CAMPFIRE\", \"Chest scan complete; bringing loot to Campfire\")\r\n        if type(teleportToCampfire) ~= \"function\" or not teleportToCampfire() then\r\n            return false, \"could not reach Campfire\"\r\n        end\r\n        if not wait(0.05) then return false, \"cancelled at Campfire\" end\r\n\r\n        status(\"CHEST_COINS\", \"Collecting Coin Stacks at Campfire\")\r\n        local itemsFolder = workspace:FindFirstChild(\"Items\") or workspace:FindFirstChild(\"items\")\r\n        local remoteEvents = _ReplicatedStorage:FindFirstChild(\"RemoteEvents\")\r\n        local collectCoins = remoteEvents and remoteEvents:FindFirstChild(\"RequestCollectCoints\")\r\n        if itemsFolder and collectCoins then\r\n            local collected = 0\r\n            for _, item in ipairs(itemsFolder:GetChildren()) do\r\n                if not valid() or collected >= 20 then break end\r\n                if item.Name == \"Coin Stack\"\r\n                    and not (_G.KixIsLoggingCampItem and _G.KixIsLoggingCampItem(item)) then\r\n                    pcall(function()\r\n                        if collectCoins:IsA(\"RemoteFunction\") then\r\n                            collectCoins:InvokeServer(item)\r\n                        elseif collectCoins:IsA(\"RemoteEvent\") then\r\n                            collectCoins:FireServer(item)\r\n                        end\r\n                    end)\r\n                    collected += 1\r\n                    if not wait(0.05) then break end\r\n                end\r\n            end\r\n            if collected > 0 and WindUI then\r\n                pcall(function()\r\n                    WindUI:Notify({Title = \"Coin Collect\", Content = \"Collected \" .. tostring(collected * 5) .. \" Coins!\", Duration = 2})\r\n                end)\r\n            end\r\n        end\r\n\r\n        if not valid() then return false, \"cancelled before Tool Trader\" end\r\n        status(\"CHEST_TOOL_TRADER\", \"Buying available Tool Trader items\")\r\n        if type(autoBuyToolTraderItems) == \"function\" then\r\n            local traderOk, traderResult = pcall(autoBuyToolTraderItems)\r\n            if not traderOk then warn(\"[Auto Chest Tool Trader] \" .. tostring(traderResult)) end\r\n        end\r\n        return valid(), \"Campfire looting and Tool Trader complete\"\r\n    end\r\nend\r\n\r\nfunction setAutoChestStatus(text)\r\n    pcall(function() if AutoChestStatus and type(AutoChestStatus.SetDesc) == \"function\" then AutoChestStatus:SetDesc(text) end end)\r\nend\r\nexecuteAutoChest = function()\r\n    if autoChestRunning or _G.AutoChestRunning then return end\r\n    if not includeHighTierChests and not includeLowTierChests then\r\n        _G.AutoChestStatus = \"waiting_selection\"\r\n        if WindUI then WindUI:Notify({Title = \"Error\", Content = \"Please select at least one chest tier to open!\", Duration = 3}) end\r\n        return\r\n    end\r\n    task.spawn(function()\r\n        autoChestRunning, _G.AutoChestRunning = true, true\r\n        _G.AutoChestAntiVoidOriginal = _G.AntiVoidItemsEnabled\r\n        _G.AntiVoidItemsEnabled, _G.AutoChestAntiVoidMode = true, true\r\n        _G.AutoChestBroughtCounts, _G.TempEquippedCache = {}, {}\r\n        local function safeSetStatus(text) setAutoChestStatus(text) end\r\n        local opened, detail = _G.KixAutoChestCore.Run(\r\n            function() return KixHubSession.Alive end,\r\n            function(text) safeSetStatus(\"Status: \" .. tostring(text)) end,\r\n            function(seconds) task.wait(seconds or 0); return KixHubSession.Alive end\r\n        )\r\n        if opened then\r\n            -- Core.Run closes its chest monitor before this tail; keep the\r\n            -- delivery guard active until manual mode finishes the FA loot steps.\r\n            autoChestRunning, _G.AutoChestRunning = true, true\r\n            local finishOk, finishResult, finishDetail = pcall(function()\r\n                return _G.KixAutoChestCore.FinalizeCampfireLoot(\r\n                    function() return KixHubSession.Alive end,\r\n                    function(seconds) task.wait(seconds or 0); return KixHubSession.Alive end,\r\n                    function(_, text) safeSetStatus(\"Status: \" .. tostring(text)) end,\r\n                    function()\r\n                        local character = _LocalPlayer.Character\r\n                        local hrp = character and character:FindFirstChild(\"HumanoidRootPart\")\r\n                        if not hrp then return false end\r\n                        local campfirePos = AutoMapReveal and AutoMapReveal.CampfirePos\r\n                            or Vector3.new(0.43, 15.77, -1.88)\r\n                        local ok = pcall(function()\r\n                            hrp.CFrame = CFrame.new(campfirePos)\r\n                            hrp.AssemblyLinearVelocity = Vector3.zero\r\n                            hrp.AssemblyAngularVelocity = Vector3.zero\r\n                        end)\r\n                        return ok and hrp.Parent ~= nil\r\n                    end\r\n                )\r\n            end)\r\n            opened = finishOk and finishResult == true\r\n            detail = opened and finishDetail or (finishOk and finishDetail or finishResult)\r\n        end\r\n        if opened then safeSetStatus(\"Status: Chest requests completed; loot routed through KixDev Anti Void.\")\r\n        else safeSetStatus(\"Status: Auto Chest \" .. tostring(detail)) end\r\n        if opened then autoChestHasRun = true end\r\n\r\n        -- MATIKAN MODE KHUSUS AUTO CHEST (kembalikan Anti Void ke mode normal agar berhenti menarik item)\r\n        _G.AutoChestAntiVoidMode = false\r\n        if _G.AutoChestAntiVoidOriginal ~= nil then\r\n            _G.AntiVoidItemsEnabled = _G.AutoChestAntiVoidOriginal\r\n        end\r\n        _G.FailedEquipCache = {}\r\n\r\n        autoChestRunning = false\r\n        _G.AutoChestRunning = false\r\n        _G.AutoChestStatus = opened and \"completed\" or \"cancelled\"\r\n        if opened then _G.AutoChestLastCompletedTime = os.time() end\r\n\r\n        safeSetStatus(opened and \"Status: Done! Loot routed to Campfire via Anti Void.\" or \"Status: Auto Chest cancelled.\")\r\n\r\n    end)\r\nend\r\n\r\n\r\n_G.KixAdapters = _G.KixAdapters or {}\r\n_G.KixAdapters.AutoChest = {\r\n    IsRunning = function() return autoChestRunning == true or _G.AutoChestRunning == true end,\r\n    HasTierSelection = function() return includeHighTierChests == true or includeLowTierChests == true end,\r\n    Start = function() if type(executeAutoChest) == \"function\" then executeAutoChest() end end,\r\n    GetStatus = function() return _G.AutoChestStatus or (autoChestRunning and \"running\" or \"idle\") end\r\n}\r\n\r\n-- ===========================================\r\n\r\nlocal function getMachine()\r\n    local structures = workspace:FindFirstChild(\"Structures\")\r\n\r\n    if not structures then\r\n        return nil\r\n    end\r\n\r\n    local machine =\r\n        structures:FindFirstChild(\"Temporal Accelerometer\")\r\n\r\n    if machine\r\n        and machine:IsA(\"Model\")\r\n        and machine.Parent\r\n        and machine.PrimaryPart\r\n    then\r\n        return machine\r\n    end\r\n\r\n    return nil\r\nend\r\n\r\n\r\nTabs.Auto:Section({\r\n    Title = \"Environment\",\r\n    Icon = \"moon\"\r\n})\r\n\r\n\r\ngetgenv().KixHub_AutoSkip_ToggleID =\r\n    getgenv().KixHub_AutoSkip_ToggleID or 0\r\n\r\ngetgenv().autoSkipNight =\r\n    getgenv().autoSkipNight or false\r\n\r\n\r\n_G.KixHubSetAutoSkipNight = function(enabled)\r\n        enabled = enabled == true\r\n        if (getgenv().autoSkipNight == true) == enabled then return end\r\n\r\n        getgenv().autoSkipNight = enabled\r\n\r\n        -- =====================================================\r\n        -- TOGGLE ID\r\n        -- =====================================================\r\n\r\n        getgenv().KixHub_AutoSkip_ToggleID =\r\n            getgenv().KixHub_AutoSkip_ToggleID + 1\r\n\r\n        local myToggleID =\r\n            getgenv().KixHub_AutoSkip_ToggleID\r\n\r\n\r\n        if not enabled then\r\n            return\r\n        end\r\n\r\n\r\n        -- =====================================================\r\n        -- WARNING\r\n        -- =====================================================\r\n\r\n        if WindUI then\r\n            WindUI:Notify({\r\n                Title = \"⚠️ Warning\",\r\n                Content = \"Please make sure to activate Auto Skip Night during DAYTIME only! Enabling it at night may cause bugs.\",\r\n                Duration = 6,\r\n                Icon = \"alert-triangle\"\r\n            })\r\n        end\r\n\r\n\r\n        task.spawn(function()\r\n\r\n            -- =================================================\r\n            -- SERVICES\r\n            -- =================================================\r\n\r\n            local CollectionService =\r\n                game:GetService(\"CollectionService\")\r\n\r\n            local ReplicatedStorage =\r\n                game:GetService(\"ReplicatedStorage\")\r\n\r\n\r\n            -- =================================================\r\n            -- DIRECT REMOTE\r\n            -- Tidak menggunakan require(PlayerScripts.Client)\r\n            -- =================================================\r\n\r\n            local RemoteEvents =\r\n                ReplicatedStorage:WaitForChild(\"RemoteEvents\")\r\n\r\n            local RequestActivateNightSkipMachine =\r\n                RemoteEvents:WaitForChild(\r\n                    \"RequestActivateNightSkipMachine\"\r\n                )\r\n\r\n\r\n            -- =================================================\r\n            -- CHECK REMOTE TYPE\r\n            -- =================================================\r\n\r\n            if not RequestActivateNightSkipMachine:IsA(\"RemoteEvent\") then\r\n\r\n                warn(\r\n                    \"[Auto Skip Night] RequestActivateNightSkipMachine is not a RemoteEvent.\"\r\n                )\r\n\r\n                return\r\n            end\r\n\r\n\r\n            print(\r\n                \"[Auto Skip Night] Remote loaded successfully.\"\r\n            )\r\n\r\n\r\n            -- =================================================\r\n            -- VARIABLES\r\n            -- =================================================\r\n\r\n            local peakSeconds = 0\r\n            local activatedTonight = false\r\n            local notifiedMissingGem = false\r\n\r\n\r\n            -- =================================================\r\n            -- MAIN LOOP\r\n            -- =================================================\r\n\r\n            while task.wait(1) do\r\n\r\n                -- ---------------------------------------------\r\n                -- Toggle check\r\n                -- ---------------------------------------------\r\n\r\n                if not getgenv().autoSkipNight then\r\n                    break\r\n                end\r\n\r\n\r\n                -- ---------------------------------------------\r\n                -- Prevent old loop\r\n                -- ---------------------------------------------\r\n\r\n                if getgenv().KixHub_AutoSkip_ToggleID\r\n                    ~= myToggleID\r\n                then\r\n                    break\r\n                end\r\n\r\n\r\n                -- =================================================\r\n                -- CURRENT STATE\r\n                -- =================================================\r\n\r\n                local currentState =\r\n                    workspace:GetAttribute(\"State\")\r\n\r\n\r\n                -- =================================================\r\n                -- DAY\r\n                -- Reset detection\r\n                -- =================================================\r\n\r\n                if currentState == \"Day\" then\r\n\r\n                    peakSeconds = 0\r\n                    activatedTonight = false\r\n                    notifiedMissingGem = false\r\n\r\n                    continue\r\n                end\r\n\r\n\r\n                -- =================================================\r\n                -- NIGHT\r\n                -- =================================================\r\n\r\n                if not activatedTonight then\r\n\r\n                    local seconds =\r\n                        workspace:GetAttribute(\"SecondsLeft\")\r\n\r\n\r\n                    if seconds\r\n                        and type(seconds) == \"number\"\r\n                        and seconds > 0\r\n                    then\r\n\r\n                        -- -----------------------------------------\r\n                        -- Track peak SecondsLeft\r\n                        -- -----------------------------------------\r\n\r\n                        if peakSeconds == 0\r\n                            or seconds > peakSeconds\r\n                        then\r\n\r\n                            peakSeconds = seconds\r\n                        end\r\n\r\n\r\n                        -- -----------------------------------------\r\n                        -- Detect that night has progressed\r\n                        -- -----------------------------------------\r\n\r\n                        if (peakSeconds - seconds) >= 4 then\r\n\r\n\r\n                            -- =================================================\r\n                            -- FIND TEMPORAL ACCELEROMETER\r\n                            -- =================================================\r\n\r\n                            local machines =\r\n                                CollectionService:GetTagged(\r\n                                    \"NightSkipMachine\"\r\n                                )\r\n\r\n                            local myMachine = nil\r\n                            local closestDist = math.huge\r\n\r\n                            local centerPos =\r\n                                Vector3.new(0, 19, 0)\r\n\r\n\r\n                            for _, machine in ipairs(machines) do\r\n\r\n                                if machine\r\n                                    and machine:IsDescendantOf(workspace)\r\n                                    and machine.PrimaryPart\r\n                                then\r\n\r\n                                    local name =\r\n                                        machine.Name\r\n\r\n\r\n                                    -- -----------------------------------------\r\n                                    -- Only allow valid Night Skip Machine\r\n                                    -- -----------------------------------------\r\n\r\n                                    if name == \"Temporal Accelerometer\"\r\n                                        or (\r\n                                            name ~= \"Respawn Capsule\"\r\n                                            and name ~= \"Weather Machine\"\r\n                                            and name ~= \"Recycler\"\r\n                                        )\r\n                                    then\r\n\r\n                                        local dist =\r\n                                            (\r\n                                                machine.PrimaryPart.Position\r\n                                                - centerPos\r\n                                            ).Magnitude\r\n\r\n\r\n                                        if dist < closestDist then\r\n\r\n                                            closestDist = dist\r\n                                            myMachine = machine\r\n\r\n                                        end\r\n                                    end\r\n                                end\r\n                            end\r\n\r\n\r\n                            -- =================================================\r\n                            -- MACHINE FOUND\r\n                            -- =================================================\r\n\r\n                            if myMachine then\r\n\r\n                                local isCharged =\r\n                                    myMachine:GetAttribute(\"Charged\")\r\n\r\n                                local isActive =\r\n                                    myMachine:GetAttribute(\"Active\")\r\n\r\n\r\n                                -- =================================================\r\n                                -- MACHINE READY\r\n                                -- =================================================\r\n\r\n                                if not isCharged\r\n                                    and not isActive\r\n                                then\r\n\r\n                                    -- -----------------------------------------\r\n                                    -- GET GEMS\r\n                                    -- -----------------------------------------\r\n\r\n                                    local map =\r\n                                        workspace:FindFirstChild(\"Map\")\r\n\r\n                                    local campground =\r\n                                        map\r\n                                        and map:FindFirstChild(\"Campground\")\r\n\r\n\r\n                                    local totalGems = 0\r\n\r\n\r\n                                    if campground then\r\n\r\n                                        totalGems =\r\n                                            campground:GetAttribute(\r\n                                                \"TotalGems\"\r\n                                            ) or 0\r\n\r\n                                    end\r\n\r\n\r\n                                    -- -----------------------------------------\r\n                                    -- No Gem\r\n                                    -- -----------------------------------------\r\n\r\n                                    if totalGems <= 0 then\r\n\r\n                                        if WindUI and not notifiedMissingGem then\r\n                                            notifiedMissingGem = true\r\n                                            WindUI:Notify({\r\n                                                Title = \"Night Skip\",\r\n                                                Content = \"Requires at least 1 Gem stored in the Campground! (Skipping disabled to prevent grinder bug)\",\r\n                                                Duration = 3\r\n                                            })\r\n                                        end\r\n\r\n                                        task.wait(5)\r\n                                        continue\r\n                                    end\r\n\r\n\r\n                                    -- =================================================\r\n                                    -- ACTIVATE\r\n                                    -- =================================================\r\n\r\n                                    if WindUI then\r\n                                        WindUI:Notify({\r\n                                            Title = \"Night Skip\",\r\n                                            Content = \"Activating Temporal Accelerometer...\",\r\n                                            Duration = 2\r\n                                        })\r\n                                    end\r\n\r\n\r\n                                    -- Set immediately so it cannot fire twice\r\n                                    activatedTonight = true\r\n\r\n\r\n                                    -- =================================================\r\n                                    -- FIRE REMOTE DIRECTLY\r\n                                    -- =================================================\r\n\r\n                                    local success, result =\r\n                                        pcall(function()\r\n\r\n                                            return RequestActivateNightSkipMachine:FireServer(\r\n                                                myMachine\r\n                                            )\r\n\r\n                                        end)\r\n\r\n\r\n                                    if not success then\r\n\r\n                                        warn(\r\n                                            \"[Auto Skip Night] Request failed:\",\r\n                                            result\r\n                                        )\r\n\r\n                                        -- Allow another attempt if\r\n                                        -- the request itself failed\r\n                                        activatedTonight = false\r\n\r\n                                    else\r\n\r\n                                    end\r\n\r\n\r\n                                    -- Small cooldown\r\n                                    task.wait(5)\r\n\r\n                                end\r\n\r\n                            else\r\n\r\n                                -- =================================================\r\n                                -- MACHINE NOT FOUND\r\n                                -- =================================================\r\n\r\n                                if WindUI then\r\n                                    WindUI:Notify({\r\n                                        Title = \"Night Skip\",\r\n                                        Content = \"Temporal Accelerometer not found! Please build or place one.\",\r\n                                        Duration = 4\r\n                                    })\r\n                                end\r\n\r\n                                task.wait(4)\r\n\r\n                            end\r\n                        end\r\n                    end\r\n                end\r\n            end\r\n\r\n\r\n            print(\r\n                \"[Auto Skip Night] Stopped.\"\r\n            )\r\n\r\n        end)\r\nend\r\n\r\n_G.AutoSkipNightToggle = Tabs.Auto:Toggle({\r\n    Title = \"⏳ Auto Skip Night\",\r\n    Desc = \"Activate this feature ONLY during DAYTIME to minimize bugs!\",\r\n    Value = false,\r\n    Callback = _G.KixHubSetAutoSkipNight\r\n})\r\n_G.KixAdapters.AutoSkipNight = {\r\n    IsEnabled = function() return getgenv().autoSkipNight == true end,\r\n}\r\n_G.KixEngines.AutoSkipNight = function(enabled)\r\n    _G.KixHubSetAutoSkipNight(enabled == true)\r\nend\r\n\r\n_G.KixAdapters.AutoEat = {\r\n    IsEnabled = function()\r\n        return autoEatEnabled == true\r\n    end,\r\n    SetState = function(state)\r\n        return _G.KixEngines.AutoEat(state)\r\n    end\r\n}\r\n\r\n-- =========================================================\r\n-- AUTO WEATHER MACHINE\r\n-- =========================================================\r\n\r\ngetgenv().KixHub_AutoWeather_ToggleID =\r\n    getgenv().KixHub_AutoWeather_ToggleID or 0\r\n\r\ngetgenv().autoWeatherMachine =\r\n    getgenv().autoWeatherMachine or false\r\n\r\n_G.KixHubSetAutoWeatherMachine = function(enabled)\r\n        getgenv().autoWeatherMachine = enabled\r\n\r\n        -- =====================================================\r\n        -- TOGGLE ID\r\n        -- Mencegah loop lama tetap berjalan\r\n        -- =====================================================\r\n\r\n        getgenv().KixHub_AutoWeather_ToggleID =\r\n            getgenv().KixHub_AutoWeather_ToggleID + 1\r\n\r\n        local myToggleID =\r\n            getgenv().KixHub_AutoWeather_ToggleID\r\n\r\n        if not enabled then\r\n            return\r\n        end\r\n\r\n        task.spawn(function()\r\n\r\n            -- =================================================\r\n            -- SERVICES\r\n            -- =================================================\r\n\r\n            local CollectionService =\r\n                game:GetService(\"CollectionService\")\r\n\r\n            local Players =\r\n                game:GetService(\"Players\")\r\n\r\n            local ReplicatedStorage =\r\n                game:GetService(\"ReplicatedStorage\")\r\n\r\n            local LocalPlayer =\r\n                Players.LocalPlayer\r\n\r\n            -- =================================================\r\n            -- DIRECT REMOTE\r\n            -- Tidak lagi require PlayerScripts.Client\r\n            -- =================================================\r\n\r\n            local RemoteEvents =\r\n                ReplicatedStorage:WaitForChild(\"RemoteEvents\")\r\n\r\n            local RequestClearWeather =\r\n                RemoteEvents:WaitForChild(\"RequestClearWeather\")\r\n\r\n            -- Pastikan RemoteFunction\r\n            if not RequestClearWeather:IsA(\"RemoteFunction\") then\r\n                warn(\r\n                    \"[Auto Weather Machine] RequestClearWeather is not a RemoteFunction.\"\r\n                )\r\n                return\r\n            end\r\n\r\n            print(\r\n                \"[Auto Weather Machine] Started.\"\r\n            )\r\n\r\n            -- =================================================\r\n            -- FIND WEATHER MACHINE\r\n            -- =================================================\r\n\r\n            local function FindWeatherMachine()\r\n\r\n                local machines =\r\n                    CollectionService:GetTagged(\"WeatherMachine\")\r\n\r\n                local myMachine = nil\r\n                local closestDist = math.huge\r\n\r\n                -- Posisi tengah map\r\n                local centerPos =\r\n                    Vector3.new(0, 19, 0)\r\n\r\n                -- ---------------------------------------------\r\n                -- Primary: CollectionService tag\r\n                -- ---------------------------------------------\r\n\r\n                for _, machine in ipairs(machines) do\r\n\r\n                    if machine\r\n                        and machine:IsDescendantOf(workspace)\r\n                        and machine.Name == \"Weather Machine\"\r\n                        and machine.PrimaryPart\r\n                    then\r\n\r\n                        local dist =\r\n                            (machine.PrimaryPart.Position - centerPos).Magnitude\r\n\r\n                        if dist < closestDist then\r\n                            closestDist = dist\r\n                            myMachine = machine\r\n                        end\r\n                    end\r\n                end\r\n\r\n                -- ---------------------------------------------\r\n                -- Fallback: Workspace.Structures\r\n                -- ---------------------------------------------\r\n\r\n                if not myMachine then\r\n\r\n                    local structures =\r\n                        workspace:FindFirstChild(\"Structures\")\r\n\r\n                    if structures then\r\n\r\n                        for _, machine in ipairs(\r\n                            structures:GetChildren()\r\n                        ) do\r\n\r\n                            if machine.Name == \"Weather Machine\"\r\n                                and machine.PrimaryPart\r\n                            then\r\n\r\n                                local dist =\r\n                                    (machine.PrimaryPart.Position - centerPos).Magnitude\r\n\r\n                                if dist < closestDist then\r\n                                    closestDist = dist\r\n                                    myMachine = machine\r\n                                end\r\n                            end\r\n                        end\r\n                    end\r\n                end\r\n\r\n                return myMachine\r\n            end\r\n\r\n            -- =================================================\r\n            -- GET CULTIST GEMS\r\n            -- =================================================\r\n\r\n            local function GetCultistGems()\r\n\r\n                local map =\r\n                    workspace:FindFirstChild(\"Map\")\r\n\r\n                if not map then\r\n                    return 0\r\n                end\r\n\r\n                local campground =\r\n                    map:FindFirstChild(\"Campground\")\r\n\r\n                if not campground then\r\n                    return 0\r\n                end\r\n\r\n                -- ---------------------------------------------\r\n                -- Preferred attribute\r\n                -- ---------------------------------------------\r\n\r\n                local totalGems =\r\n                    campground:GetAttribute(\"TotalCultistGems\")\r\n\r\n                if typeof(totalGems) == \"number\" then\r\n                    return totalGems\r\n                end\r\n\r\n                -- ---------------------------------------------\r\n                -- Fallback\r\n                -- ---------------------------------------------\r\n\r\n                totalGems =\r\n                    campground:GetAttribute(\"TotalGems\")\r\n\r\n                if typeof(totalGems) == \"number\" then\r\n                    return totalGems\r\n                end\r\n\r\n                return 0\r\n            end\r\n\r\n            -- =================================================\r\n            -- MAIN LOOP\r\n            -- =================================================\r\n\r\n            while task.wait(1) do\r\n\r\n                -- ---------------------------------------------\r\n                -- Toggle check\r\n                -- ---------------------------------------------\r\n\r\n                if not getgenv().autoWeatherMachine then\r\n                    break\r\n                end\r\n\r\n                -- ---------------------------------------------\r\n                -- Prevent old loop\r\n                -- ---------------------------------------------\r\n\r\n                if getgenv().KixHub_AutoWeather_ToggleID\r\n                    ~= myToggleID\r\n                then\r\n                    break\r\n                end\r\n\r\n                -- =================================================\r\n                -- CURRENT WEATHER\r\n                -- =================================================\r\n\r\n                local currentWeather =\r\n                    workspace:GetAttribute(\"Weather\")\r\n\r\n                if currentWeather ~= \"Rain\"\r\n                    and currentWeather ~= \"Thunderstorm\"\r\n                    and currentWeather ~= \"Blizzard\"\r\n                then\r\n                    continue\r\n                end\r\n\r\n                -- =================================================\r\n                -- FIND MACHINE\r\n                -- =================================================\r\n\r\n                local myMachine =\r\n                    FindWeatherMachine()\r\n\r\n                if not myMachine then\r\n\r\n                    if WindUI then\r\n                        WindUI:Notify({\r\n                            Title = \"Anti Rain\",\r\n                            Content = \"Weather Machine not found! Please build or place one.\",\r\n                            Duration = 4\r\n                        })\r\n                    end\r\n\r\n                    task.wait(4)\r\n                    continue\r\n                end\r\n\r\n                -- =================================================\r\n                -- CHECK ACTIVE\r\n                -- =================================================\r\n\r\n                local active =\r\n                    myMachine:GetAttribute(\"Active\")\r\n\r\n                if active then\r\n                    continue\r\n                end\r\n\r\n                -- =================================================\r\n                -- CHECK GEM\r\n                -- =================================================\r\n\r\n                local totalGems =\r\n                    GetCultistGems()\r\n\r\n                if totalGems < 1 then\r\n\r\n                    if WindUI then\r\n                        WindUI:Notify({\r\n                            Title = \"Anti Rain\",\r\n                            Content = \"Requires at least 1 Cultist Gem stored in the Campground!\",\r\n                            Duration = 3\r\n                        })\r\n                    end\r\n\r\n                    task.wait(5)\r\n                    continue\r\n                end\r\n\r\n                -- =================================================\r\n                -- ACTIVATE WEATHER MACHINE\r\n                -- =================================================\r\n\r\n                if WindUI then\r\n                    WindUI:Notify({\r\n                        Title = \"Anti Rain\",\r\n                        Content = \"Activating Weather Machine to clear the sky...\",\r\n                        Duration = 2\r\n                    })\r\n                end\r\n\r\n                -- =================================================\r\n                -- INVOKE REMOTE\r\n                -- =================================================\r\n\r\n                local success, result =\r\n                    pcall(function()\r\n                        return RequestClearWeather:InvokeServer(\r\n                            myMachine\r\n                        )\r\n                    end)\r\n\r\n                if success then\r\n\r\n                else\r\n\r\n                    warn(\r\n                        \"[Auto Weather Machine] Request failed:\",\r\n                        result\r\n                    )\r\n\r\n                    if WindUI then\r\n                        WindUI:Notify({\r\n                            Title = \"Anti Rain\",\r\n                            Content = \"Failed to activate Weather Machine.\",\r\n                            Duration = 3\r\n                        })\r\n                    end\r\n\r\n                    task.wait(3)\r\n                    continue\r\n                end\r\n\r\n                -- =================================================\r\n                -- COOLDOWN\r\n                -- WeatherMachineClient menggunakan 540 detik\r\n                -- =================================================\r\n\r\n                task.wait(15)\r\n            end\r\n\r\n            print(\r\n                \"[Auto Weather Machine] Stopped.\"\r\n            )\r\n        end)\r\nend\r\n_G.AutoWeatherMachineToggle = Tabs.Auto:Toggle({\r\n    Title = \"🌧️ Auto Weather Machine\",\r\n    Desc = \"Automatically pays 1 Cultist Gem to the Weather Machine to skip rain/thunderstorm/blizzard when they occur.\",\r\n    Value = false,\r\n    Callback = _G.KixHubSetAutoWeatherMachine\r\n})\r\n_G.KixAdapters.AutoWeatherMachine = {\r\n    IsEnabled = function() return getgenv().autoWeatherMachine == true end,\r\n}\r\n_G.KixEngines.AutoWeatherMachine = function(enabled)\r\n    _G.KixHubSetAutoWeatherMachine(enabled == true)\r\nend\r\n\r\n-- =========================================================\r\n-- AUTO RECYCLER\r\n-- GEM OF THE FOREST -> CULTIST GEM\r\n-- =========================================================\r\n\r\ngetgenv().KixHub_AutoRecycler_ToggleID =\r\n    getgenv().KixHub_AutoRecycler_ToggleID or 0\r\n\r\ngetgenv().autoRecycler =\r\n    getgenv().autoRecycler or false\r\ngetgenv().KixHub_AutoRecyclerNoticeOnce =\r\n    getgenv().KixHub_AutoRecyclerNoticeOnce or {}\r\n\r\n\r\n_G.KixHubSetAutoRecycler = function(enabled)\r\n\r\n        getgenv().autoRecycler = enabled\r\n\r\n\r\n        -- =====================================================\r\n        -- TOGGLE ID\r\n        -- Mencegah thread lama tetap berjalan\r\n        -- =====================================================\r\n\r\n        getgenv().KixHub_AutoRecycler_ToggleID =\r\n            getgenv().KixHub_AutoRecycler_ToggleID + 1\r\n\r\n        local myToggleID =\r\n            getgenv().KixHub_AutoRecycler_ToggleID\r\n\r\n\r\n        if not enabled then\r\n            return\r\n        end\r\n\r\n\r\n        task.spawn(function()\r\n\r\n            -- =================================================\r\n            -- SERVICES\r\n            -- =================================================\r\n\r\n            local CollectionService =\r\n                game:GetService(\"CollectionService\")\r\n\r\n            local ReplicatedStorage =\r\n                game:GetService(\"ReplicatedStorage\")\r\n\r\n\r\n            -- =================================================\r\n            -- DIRECT REMOTE\r\n            -- Tidak menggunakan require(PlayerScripts.Client)\r\n            -- =================================================\r\n\r\n            local RemoteEvents =\r\n                ReplicatedStorage:WaitForChild(\"RemoteEvents\")\r\n\r\n            local RequestRecycleMaterial =\r\n                RemoteEvents:WaitForChild(\r\n                    \"RequestRecycleMaterial\"\r\n                )\r\n\r\n\r\n            -- =================================================\r\n            -- CHECK REMOTE TYPE\r\n            -- =================================================\r\n\r\n            if not RequestRecycleMaterial:IsA(\"RemoteEvent\") then\r\n\r\n                warn(\r\n                    \"[Auto Recycler] RequestRecycleMaterial is not a RemoteEvent.\"\r\n                )\r\n\r\n                return\r\n\r\n            end\r\n\r\n\r\n            print(\r\n                \"[Auto Recycler] Remote loaded successfully.\"\r\n            )\r\n\r\n\r\n            -- =================================================\r\n            -- FIND RECYCLER\r\n            -- =================================================\r\n\r\n            local function findRecycler()\r\n\r\n                local recycler = nil\r\n\r\n\r\n                -- ---------------------------------------------\r\n                -- PRIORITAS 1: TAG RecyclerMachine\r\n                -- ---------------------------------------------\r\n\r\n                local machines =\r\n                    CollectionService:GetTagged(\r\n                        \"RecyclerMachine\"\r\n                    )\r\n\r\n\r\n                for _, machine in ipairs(machines) do\r\n\r\n                    if machine\r\n                        and machine:IsDescendantOf(workspace)\r\n                        and machine.Name == \"Recycler\"\r\n                    then\r\n\r\n                        recycler = machine\r\n                        break\r\n\r\n                    end\r\n\r\n                end\r\n\r\n\r\n                -- ---------------------------------------------\r\n                -- PRIORITAS 2: Workspace.Structures\r\n                -- ---------------------------------------------\r\n\r\n                if not recycler then\r\n\r\n                    local structures =\r\n                        workspace:FindFirstChild(\r\n                            \"Structures\"\r\n                        )\r\n\r\n\r\n                    if structures then\r\n\r\n                        for _, machine in ipairs(\r\n                            structures:GetChildren()\r\n                        ) do\r\n\r\n                            if machine.Name == \"Recycler\" then\r\n\r\n                                recycler = machine\r\n                                break\r\n\r\n                            end\r\n\r\n                        end\r\n\r\n                    end\r\n\r\n                end\r\n\r\n\r\n                return recycler\r\n\r\n            end\r\n\r\n\r\n            -- =================================================\r\n            -- MAIN LOOP\r\n            -- =================================================\r\n\r\n            while task.wait(1) do\r\n\r\n\r\n                -- ---------------------------------------------\r\n                -- CEK TOGGLE\r\n                -- ---------------------------------------------\r\n\r\n                if not getgenv().autoRecycler\r\n                    or getgenv().KixHub_AutoRecycler_ToggleID\r\n                        ~= myToggleID\r\n                then\r\n\r\n                    break\r\n\r\n                end\r\n\r\n\r\n                -- =================================================\r\n                -- CAMPGROUND\r\n                -- =================================================\r\n\r\n                local map =\r\n                    workspace:FindFirstChild(\"Map\")\r\n\r\n\r\n                local campground =\r\n                    map\r\n                    and map:FindFirstChild(\"Campground\")\r\n\r\n\r\n                if not campground then\r\n                    continue\r\n                end\r\n\r\n\r\n                -- =================================================\r\n                -- JUMLAH GEM OF THE FOREST\r\n                -- =================================================\r\n\r\n                local greenGems =\r\n                    campground:GetAttribute(\r\n                        \"TotalGreenGems\"\r\n                    )\r\n\r\n\r\n                greenGems =\r\n                    tonumber(greenGems) or 0\r\n\r\n\r\n                -- Tidak ada Gem of the Forest\r\n                if greenGems < 1 then\r\n                    continue\r\n                end\r\n\r\n\r\n                -- =================================================\r\n                -- CARI RECYCLER\r\n                -- =================================================\r\n\r\n                local recycler =\r\n                    findRecycler()\r\n\r\n\r\n                if not recycler then\r\n\r\n                    if WindUI then\r\n\r\n                        WindUI:Notify({\r\n                            Title = \"Auto Recycler\",\r\n                            Content = \"Recycler not found! Please build or place a Recycler.\",\r\n                            Duration = 4\r\n                        })\r\n\r\n                    end\r\n\r\n\r\n                    task.wait(4)\r\n                    continue\r\n\r\n                end\r\n\r\n\r\n                -- =================================================\r\n                -- CEK RECYCLER ACTIVE\r\n                -- =================================================\r\n\r\n                local active =\r\n                    recycler:GetAttribute(\"Active\")\r\n\r\n\r\n                if active then\r\n                    task.wait(1)\r\n                    continue\r\n                end\r\n\r\n\r\n                -- =================================================\r\n                -- CONVERT 1 GEM\r\n                -- =================================================\r\n\r\n                if not getgenv().KixHub_AutoRecyclerNoticeOnce.Converting then\r\n                    getgenv().KixHub_AutoRecyclerNoticeOnce.Converting = true\r\n                    print(\"[Auto Recycler] Converting Gem of the Forest...\")\r\n                    if WindUI then\r\n                        WindUI:Notify({\r\n                            Title = \"Auto Recycler\",\r\n                            Content = \"Converting 1 Gem of the Forest into a Cultist Gem...\",\r\n                            Duration = 2\r\n                        })\r\n                    end\r\n                end\r\n\r\n\r\n                local success = false\r\n\r\n\r\n                -- =================================================\r\n                -- REQUEST RECYCLE\r\n                -- =================================================\r\n\r\n                local requestSuccess, result =\r\n                    pcall(function()\r\n\r\n                        return RequestRecycleMaterial:FireServer(\r\n                            recycler,\r\n                            \"TotalGreenGems\"\r\n                        )\r\n\r\n                    end)\r\n\r\n\r\n                if requestSuccess then\r\n\r\n                    success = true\r\n\r\n                    if not getgenv().KixHub_AutoRecyclerNoticeOnce.RequestSent then\r\n                        getgenv().KixHub_AutoRecyclerNoticeOnce.RequestSent = true\r\n                        print(\"[Auto Recycler] Conversion request sent successfully.\")\r\n                    end\r\n\r\n                else\r\n\r\n                    warn(\r\n                        \"[Auto Recycler] Conversion failed:\",\r\n                        result\r\n                    )\r\n\r\n                end\r\n\r\n\r\n                -- =================================================\r\n                -- JEDA 5 DETIK PER GEM\r\n                -- =================================================\r\n\r\n                if success then\r\n\r\n                    task.wait(5)\r\n\r\n                else\r\n\r\n                    task.wait(2)\r\n\r\n                end\r\n\r\n            end\r\n\r\n\r\n            print(\r\n                \"[Auto Recycler] Stopped.\"\r\n            )\r\n\r\n        end)\r\n\r\nend\r\n_G.AutoRecyclerToggle = Tabs.Auto:Toggle({\r\n    Title = \"♻️ Auto Recycler\",\r\n    Desc = \"Automatically converts all Gem of the Forest into Cultist Gems with a 5-second delay per gem.\",\r\n    Value = false,\r\n    Callback = _G.KixHubSetAutoRecycler\r\n})\r\n_G.KixAdapters.AutoRecycler = {\r\n    IsEnabled = function() return getgenv().autoRecycler == true end,\r\n}\r\n_G.KixEngines.AutoRecycler = function(enabled)\r\n    _G.KixHubSetAutoRecycler(enabled == true)\r\nend\r\n\r\n-- =========================================================\r\n-- OPEN RESPAWN CAPSULE MENU\r\n-- =========================================================\r\n\r\nTabs.Auto:Button({\r\n    Title = \"🏥 Open Respawn Capsule\",\r\n    Desc = \"Opens the default Respawn Capsule payment menu.\",\r\n    Icon = \"rotate-ccw\",\r\n\r\n    Callback = function()\r\n\r\n        -- =====================================================\r\n        -- SERVICES\r\n        -- =====================================================\r\n\r\n        local CollectionService =\r\n            game:GetService(\"CollectionService\")\r\n\r\n        local Players =\r\n            game:GetService(\"Players\")\r\n\r\n        local LocalPlayer =\r\n            Players.LocalPlayer\r\n\r\n\r\n        -- =====================================================\r\n        -- CARI RESPAWN CAPSULE\r\n        -- =====================================================\r\n\r\n        local capsule = nil\r\n\r\n        for _, beacon in ipairs(\r\n            CollectionService:GetTagged(\"RespawnBeacon\")\r\n        ) do\r\n\r\n            if beacon\r\n                and beacon:IsDescendantOf(workspace)\r\n                and beacon.Name == \"Respawn Capsule\"\r\n            then\r\n\r\n                capsule = beacon\r\n                break\r\n\r\n            end\r\n\r\n        end\r\n\r\n\r\n        -- =====================================================\r\n        -- FALLBACK: CARI DI STRUCTURES\r\n        -- =====================================================\r\n\r\n        if not capsule then\r\n\r\n            local structures =\r\n                workspace:FindFirstChild(\"Structures\")\r\n\r\n            if structures then\r\n\r\n                for _, object in ipairs(\r\n                    structures:GetChildren()\r\n                ) do\r\n\r\n                    if object.Name == \"Respawn Capsule\" then\r\n\r\n                        capsule = object\r\n                        break\r\n\r\n                    end\r\n\r\n                end\r\n\r\n            end\r\n\r\n        end\r\n\r\n\r\n        -- =====================================================\r\n        -- TIDAK DITEMUKAN\r\n        -- =====================================================\r\n\r\n        if not capsule then\r\n\r\n            if WindUI then\r\n                WindUI:Notify({\r\n                    Title = \"Respawn Capsule\",\r\n                    Content = \"Respawn Capsule not found!\",\r\n                    Duration = 3\r\n                })\r\n            end\r\n\r\n            return\r\n\r\n        end\r\n\r\n\r\n        -- =====================================================\r\n        -- SUDAH CHARGED\r\n        -- =====================================================\r\n\r\n        if capsule:GetAttribute(\"Charged\") then\r\n\r\n            if WindUI then\r\n                WindUI:Notify({\r\n                    Title = \"Respawn Capsule\",\r\n                    Content = \"Respawn Capsule is already charged!\",\r\n                    Duration = 3\r\n                })\r\n            end\r\n\r\n            return\r\n\r\n        end\r\n\r\n\r\n        -- =====================================================\r\n        -- AMBIL BIAYA\r\n        -- =====================================================\r\n\r\n        local rechargeCost =\r\n            capsule:GetAttribute(\"RechargeCost\") or 1\r\n\r\n\r\n        -- =====================================================\r\n        -- AMBIL GEMACTIVATECLIENT\r\n        -- =====================================================\r\n\r\n        local playerScripts =\r\n            LocalPlayer:WaitForChild(\"PlayerScripts\")\r\n\r\n        local clientFolder =\r\n            playerScripts:WaitForChild(\"Client\")\r\n\r\n        local gemActivateModule =\r\n            clientFolder:FindFirstChild(\r\n                \"GemActivateClient\",\r\n                true\r\n            )\r\n\r\n\r\n        if not gemActivateModule then\r\n\r\n            warn(\r\n                \"[Respawn Capsule] GemActivateClient not found.\"\r\n            )\r\n\r\n            if WindUI then\r\n                WindUI:Notify({\r\n                    Title = \"Respawn Capsule\",\r\n                    Content = \"GemActivateClient module not found!\",\r\n                    Duration = 3\r\n                })\r\n            end\r\n\r\n            return\r\n\r\n        end\r\n\r\n\r\n        -- =====================================================\r\n        -- REQUIRE MODULE\r\n        -- =====================================================\r\n\r\n        local success, GemActivateClient =\r\n            pcall(function()\r\n\r\n                return require(gemActivateModule)\r\n\r\n            end)\r\n\r\n\r\n        if not success or not GemActivateClient then\r\n\r\n            warn(\r\n                \"[Respawn Capsule] Failed to load GemActivateClient:\",\r\n                GemActivateClient\r\n            )\r\n\r\n            if WindUI then\r\n                WindUI:Notify({\r\n                    Title = \"Respawn Capsule\",\r\n                    Content = \"Failed to load payment menu.\",\r\n                    Duration = 3\r\n                })\r\n            end\r\n\r\n            return\r\n\r\n        end\r\n\r\n\r\n        -- =====================================================\r\n        -- OPEN DEFAULT GAME MENU\r\n        -- =====================================================\r\n\r\n        local openSuccess, openError =\r\n            pcall(function()\r\n\r\n                GemActivateClient.OpenMenu(\r\n                    capsule,\r\n                    rechargeCost\r\n                )\r\n\r\n            end)\r\n\r\n\r\n        if not openSuccess then\r\n\r\n            warn(\r\n                \"[Respawn Capsule] OpenMenu failed:\",\r\n                openError\r\n            )\r\n\r\n            if WindUI then\r\n                WindUI:Notify({\r\n                    Title = \"Respawn Capsule\",\r\n                    Content = \"Failed to open the payment menu.\",\r\n                    Duration = 3\r\n                })\r\n            end\r\n\r\n            return\r\n\r\n        end\r\n\r\n\r\n        print(\r\n            \"[Respawn Capsule] Payment menu opened.\"\r\n        )\r\n\r\n    end\r\n})\r\n\r\nTabs.Auto:Section({Title = 'Cook', Icon = 'flame'})\r\nCreateMultiDropdown(Tabs.Auto, {Title = 'Select Food', Values = listCookFood, Multi = true, Callback = function(val) cookFoodTargets = val end})\r\nTabs.Auto:Toggle({\r\n    Title = 'Auto Cook Selected Food in Fire',\r\n    Value = false,\r\n    Callback = function(val)\r\n        autoCook = val\r\n        if val then\r\n            task.spawn(function()\r\n                while autoCook do\r\n                    if #cookFoodTargets > 0 then\r\n                        for _, item in ipairs(workspace:WaitForChild('Items'):GetChildren()) do\r\n                            if table.find(cookFoodTargets, item.Name) then dragItemSmooth(item, campfirePos) end\r\n                        end\r\n                    end\r\n                    task.wait(0.5)\r\n                end\r\n            end)\r\n        end\r\n    end\r\n})\r\n\r\n-- ==================== FURNITURE AUTO BUYER ====================\r\nTabs.Auto:Section({\r\n    Title='Furniture Auto Buyer',\r\n    Icon='shopping-cart'\r\n})\r\n_G.KixFurnitureMaster={\r\n    'Amaryllis',\r\n    'Barrel',\r\n    'Beanbag',\r\n    'Birdhouse',\r\n    'Brick Lantern',\r\n    'Bullseye Rug',\r\n    'Bush Planter',\r\n    'Bucket',\r\n    'Candles',\r\n    'Cloth Frame',\r\n    'Fairy Lights Arch',\r\n    'Fairy Lights Double',\r\n    'Fairy Lights Single',\r\n    'Flower Bush',\r\n    'Flower Vase',\r\n    'Grey Brick Bench',\r\n    'Hedgerow',\r\n    'Hedgerow Curved',\r\n    'Hedgerow Intersection',\r\n    'Leaf Pinwheel',\r\n    'Log Bench',\r\n    'Log Stool',\r\n    'Lush Canopy',\r\n    'Mossy Fence Segment',\r\n    'Mossy Rock',\r\n    'Mossy Rock Small',\r\n    'Mushroom Chair',\r\n    'Mushroom Red',\r\n    'Painting Landscape',\r\n    'Painting Portrait',\r\n    'Painting Square',\r\n    'Picket Fence Painted',\r\n    'Pillow',\r\n    'Raccoon Plush',\r\n    'Red Brick Bench',\r\n    'Red Brick Fountain',\r\n    'Red Brick Table',\r\n    'Shrub',\r\n    'Stone Lantern',\r\n    'Street Lantern',\r\n    'Lantern Cylinder',\r\n    'Stump Table',\r\n    'Trellis Fence Painted',\r\n    'Vase',\r\n    'Wooden Bookshelf',\r\n    'Wooden Chair',\r\n    'Wooden Nightstand',\r\n    'Wooden Picket Fence',\r\n    'Wooden Stool',\r\n    'Wooden Table',\r\n    'Wooden Trellis Fence',\r\n    'Red Brick Circle',\r\n    'Clownfish Couch',\r\n    'Lavender',\r\n    'Stone Pillar',\r\n    'Trellis',\r\n    'Mossy Trellis',\r\n    'Grey Brick Table',\r\n    'Big Blue Flower',\r\n    'Big Pink Flower',\r\n    'Bluebells',\r\n    'Plates',\r\n    'Wooden Fence Segment',\r\n    'Writable Sign Small',\r\n    'Writable Sign Large',\r\n    'Owl Statuette',\r\n    'Plant Lantern',\r\n    'Stone Bridge',\r\n    'Clownfish Chair',\r\n    'Magnolia',\r\n    'Gazebo',\r\n    'Grey Brick Table',\r\n    'Writable Sign Wall-Mounted'\r\n}\r\n\r\ntable.sort(_G.KixFurnitureMaster,function(a,b)\r\n    return a:lower()<b:lower()\r\nend)\r\n\r\n_G.KixFurnitureKnown={}\r\n_G.KixFurnitureSelected=_G.KixFurnitureSelected or {}\r\n_G.KixFurnitureAutoBuy=false\r\nfor _,name in ipairs(_G.KixFurnitureMaster) do\r\n    _G.KixFurnitureKnown[name]=true\r\nend\r\n_G.KixFurnitureValues={'None'}\r\nfor _,name in ipairs(_G.KixFurnitureMaster) do\r\n    table.insert(_G.KixFurnitureValues,name)\r\nend\r\nFurnitureBuyerStatus=Tabs.Auto:Paragraph({\r\n    Title='Furniture Buyer Status',\r\n    Desc='Status: Disabled | Furniture List: '..tostring(#_G.KixFurnitureMaster)\r\n})\r\nFurnitureSelectDrop=CreateMultiDropdown(Tabs.Auto, {\r\n    Title='Select Furniture to Auto Buy',\r\n    Desc='Select multiple furniture blueprints to purchase automatically. Only selected furniture will be purchased.',\r\n    Values=_G.KixFurnitureValues,\r\n    Multi=true,\r\n    Callback=function(val)\r\n        table.clear(_G.KixFurnitureSelected)\r\n        if type(val)~='table' then\r\n            return\r\n        end\r\n        for _,name in ipairs(val) do\r\n            if name~='None' and name~='' then\r\n                _G.KixFurnitureSelected[name]=true\r\n            end\r\n        end\r\n    end\r\n})\r\n\r\nif _G.KixFurnitureThumbnail then\r\n    _G.KixFurnitureThumbnail.ChildAdded:Connect(function(item)\r\n        _G.KixFurnitureNewName=item.Name\r\n        if not _G.KixFurnitureNewName or _G.KixFurnitureNewName=='' then\r\n            return\r\n        end\r\n        if _G.KixFurnitureKnown[_G.KixFurnitureNewName] then\r\n            return\r\n        end\r\n        _G.KixFurnitureKnown[_G.KixFurnitureNewName]=true\r\n        table.insert(\r\n            _G.KixFurnitureMaster,\r\n            _G.KixFurnitureNewName\r\n        )\r\n        table.sort(\r\n            _G.KixFurnitureMaster,\r\n            function(a,b)\r\n                return a:lower()<b:lower()\r\n            end\r\n        )\r\n        table.clear(_G.KixFurnitureValues)\r\n        table.insert(_G.KixFurnitureValues,'None')\r\n        for _,name in ipairs(_G.KixFurnitureMaster) do\r\n            table.insert(_G.KixFurnitureValues,name)\r\n        end\r\n        pcall(function()\r\n            FurnitureSelectDrop:Refresh(_G.KixFurnitureValues)\r\n        end)\r\n    end)\r\nend\r\n\r\n-- =========================================================\r\n-- AUTO BUY FURNITURE - FAST ROUND ROBIN\r\n-- =========================================================\r\n\r\nTabs.Auto:Toggle({\r\n    Title = '📦 Auto Buy Furniture',\r\n    Desc = 'Automatically buys selected Furniture Trader blueprints.',\r\n    Value = false,\r\n\r\n    Callback = function(val)\r\n\r\n        _G.KixFurnitureAutoBuy = val\r\n\r\n        if not val then\r\n            _G.KixFurnitureRoundRobinIndex = nil\r\n\r\n            pcall(function()\r\n                FurnitureBuyerStatus:SetDesc(\r\n                    'Status: Disabled | Furniture List: '\r\n                    .. tostring(#_G.KixFurnitureMaster)\r\n                )\r\n            end)\r\n\r\n            return\r\n        end\r\n\r\n        task.spawn(function()\r\n\r\n            while _G.KixFurnitureAutoBuy do\r\n\r\n                pcall(function()\r\n\r\n                    local RS = game:GetService(\"ReplicatedStorage\")\r\n\r\n                    -- =========================================\r\n                    -- GET SHOP\r\n                    -- =========================================\r\n\r\n                    local shops = RS:FindFirstChild(\"Shops\")\r\n                    local shop = shops and shops:FindFirstChild(\"Furniture Trader\")\r\n\r\n                    if not shop then\r\n                        FurnitureBuyerStatus:SetDesc(\r\n                            \"Status: Waiting for Furniture Trader...\"\r\n                        )\r\n                        return\r\n                    end\r\n\r\n                    -- =========================================\r\n                    -- GET REMOTE\r\n                    -- =========================================\r\n\r\n                    local remoteEvents = RS:FindFirstChild(\"RemoteEvents\")\r\n\r\n                    local buyRemote =\r\n                        remoteEvents\r\n                        and remoteEvents:FindFirstChild(\"RequestBuyFurniture\")\r\n\r\n                    if not buyRemote\r\n                        or not buyRemote:IsA(\"RemoteEvent\")\r\n                    then\r\n                        FurnitureBuyerStatus:SetDesc(\r\n                            \"Status: RequestBuyFurniture not found\"\r\n                        )\r\n                        return\r\n                    end\r\n\r\n                    -- =========================================\r\n                    -- SCAN SHOP SEKALI\r\n                    -- =========================================\r\n\r\n                    local selectedItems = {}\r\n                    local available = 0\r\n\r\n                    local folders = {\r\n                        shop:FindFirstChild(\"Basics\"),\r\n                        shop:FindFirstChild(\"Rares\")\r\n                    }\r\n\r\n                    for _, folder in ipairs(folders) do\r\n\r\n                        if folder then\r\n\r\n                            for _, item in ipairs(folder:GetChildren()) do\r\n\r\n                                if item:IsA(\"Folder\") then\r\n\r\n                                    local itemName =\r\n                                        item:GetAttribute(\"ItemName\")\r\n\r\n                                    local stock =\r\n                                        item:GetAttribute(\"Stock\")\r\n\r\n                                    if itemName\r\n                                        and itemName ~= \"\"\r\n                                    then\r\n\r\n                                        available += 1\r\n\r\n                                        if _G.KixFurnitureSelected\r\n                                            and _G.KixFurnitureSelected[itemName]\r\n                                        then\r\n\r\n                                            if stock == nil or stock > 0 then\r\n\r\n                                                table.insert(\r\n                                                    selectedItems,\r\n                                                    {\r\n                                                        Name = itemName,\r\n                                                        Folder = item\r\n                                                    }\r\n                                                )\r\n\r\n                                            end\r\n                                        end\r\n                                    end\r\n                                end\r\n                            end\r\n                        end\r\n                    end\r\n\r\n                    if #selectedItems == 0 then\r\n                        FurnitureBuyerStatus:SetDesc(\r\n                            \"Status: Active | No selected furniture available\"\r\n                        )\r\n                        return\r\n                    end\r\n\r\n                    -- =========================================\r\n                    -- ROUND ROBIN INDEX\r\n                    -- =========================================\r\n\r\n                    if not _G.KixFurnitureRoundRobinIndex then\r\n                        _G.KixFurnitureRoundRobinIndex = 1\r\n                    end\r\n\r\n                    if _G.KixFurnitureRoundRobinIndex > #selectedItems then\r\n                        _G.KixFurnitureRoundRobinIndex = 1\r\n                    end\r\n\r\n                    -- =========================================\r\n                    -- MULTI BUY DALAM SATU CYCLE\r\n                    -- =========================================\r\n\r\n                    local boughtThisCycle = 0\r\n                    local checked = 0\r\n\r\n                    while _G.KixFurnitureAutoBuy\r\n                        and checked < #selectedItems\r\n                    do\r\n\r\n                        if _G.KixFurnitureRoundRobinIndex > #selectedItems then\r\n                            _G.KixFurnitureRoundRobinIndex = 1\r\n                        end\r\n\r\n                        local target =\r\n                            selectedItems[_G.KixFurnitureRoundRobinIndex]\r\n\r\n                        if target\r\n                            and target.Folder\r\n                            and target.Folder.Parent\r\n                        then\r\n\r\n                            local stock =\r\n                                target.Folder:GetAttribute(\"Stock\")\r\n\r\n                            -- =====================================\r\n                            -- MASIH ADA STOCK\r\n                            -- =====================================\r\n\r\n                            if stock == nil or stock > 0 then\r\n\r\n                                buyRemote:FireServer(target.Name)\r\n\r\n                                boughtThisCycle += 1\r\n\r\n                                -- langsung pindah ke jenis berikutnya\r\n                                _G.KixFurnitureRoundRobinIndex += 1\r\n\r\n                            else\r\n\r\n                                -- stock habis → skip\r\n                                _G.KixFurnitureRoundRobinIndex += 1\r\n\r\n                            end\r\n\r\n                        else\r\n\r\n                            _G.KixFurnitureRoundRobinIndex += 1\r\n\r\n                        end\r\n\r\n                        checked += 1\r\n\r\n                        -- Jeda sangat kecil antar request\r\n                        task.wait(0.03)\r\n                    end\r\n\r\n                    -- =========================================\r\n                    -- STATUS\r\n                    -- =========================================\r\n\r\n                    local currentTarget =\r\n                        selectedItems[\r\n                            math.clamp(\r\n                                _G.KixFurnitureRoundRobinIndex,\r\n                                1,\r\n                                #selectedItems\r\n                            )\r\n                        ]\r\n\r\n                    FurnitureBuyerStatus:SetDesc(\r\n                        \"Status: Active | Shop: \"\r\n                        .. tostring(available)\r\n                        .. \" | Bought: \"\r\n                        .. tostring(boughtThisCycle)\r\n                        .. \" | Next: \"\r\n                        .. tostring(\r\n                            currentTarget\r\n                            and currentTarget.Name\r\n                            or \"None\"\r\n                        )\r\n                        .. \" | Furniture List: \"\r\n                        .. tostring(#_G.KixFurnitureMaster)\r\n                    )\r\n\r\n                end)\r\n\r\n                -- Tidak ada delay 1 detik.\r\n                -- Beri sedikit waktu agar client/server update.\r\n                task.wait(0.05)\r\n            end\r\n\r\n            _G.KixFurnitureRoundRobinIndex = nil\r\n\r\n        end)\r\n    end\r\n})\r\n\r\n-- ==================== AUTO FISHING ITEM TRANSPORT ====================\r\n\r\ndo (function()\r\n    local F = {\r\n        FishOn = false, UpgradeOn = false, FishRun = 0, UpgradeRun = 0,\r\n        Pond = 103, FishStatus = 'Off', UpgradeStatus = 'Waiting for a rod to reach its XP cap',\r\n        TrashAllFish = false,\r\n        FishNames = {\r\n            salmon = true, mackerel = true, clownfish = true, clowfish = true,\r\n            swordfish = true, jellyfish = true, char = true, eel = true,\r\n            shark = true, [\"lava eel\"] = true, lionfish = true,\r\n            fish = true,\r\n        },\r\n        SpotConnections = {}, SpotItemConnections = setmetatable({}, {__mode = 'k'}), Spots = {}, SpotWater = nil,\r\n        GuardModule = nil, GuardOriginals = {},\r\n        MedicineOn = false, MedicineRun = 0,\r\n        MedicineRetry = setmetatable({}, {__mode = 'k'}),\r\n        MedicineCursor = {Bandage = 1, MedKit = 1, Medkit = 1},\r\n    }\r\n    local FishingTiers = {\r\n        [1] = 'Small Pond', [2] = 'Rocky Pond', [3] = 'Bone Pond (Huge Fish)',\r\n        [101] = 'Cold Pond', [103] = 'Lava Pond (Rare Items)',\r\n    }\r\n    local UpgradeNames = {['Old Rod'] = true, ['Good Rod'] = true}\r\n    local UpgradeTo = {['Old Rod'] = 'Good Rod', ['Good Rod'] = 'Strong Rod'}\r\n\r\n    function F.SetFishStatus(text)\r\n        if F.FishStatus ~= text then\r\n            F.FishStatus = text\r\n            if F.FishStatusUI then pcall(function() F.FishStatusUI:SetDesc(text) end) end\r\n        end\r\n    end\r\n    function F.SetUpgradeStatus(text)\r\n        if F.UpgradeStatus ~= text then\r\n            F.UpgradeStatus = text\r\n            if F.UpgradeStatusUI then pcall(function() F.UpgradeStatusUI:SetDesc(text) end) end\r\n        end\r\n    end\r\n    function F.GetItemValue(item)\r\n        local original = item and item:FindFirstChild('OriginalItem')\r\n        if original and original:IsA('StringValue') then return original.Value end\r\n        if original and original:IsA('ObjectValue') and original.Value then return original.Value.Name end\r\n        return item and item.Name or nil\r\n    end\r\n    function F.FindOwnedRod(names)\r\n        local player = _LocalPlayer\r\n        local character = player.Character\r\n        local handle = character and character:FindFirstChild('ToolHandle')\r\n        local originalName = F.GetItemValue(handle)\r\n        if originalName and names[originalName] then\r\n            local inventory = player:FindFirstChild('Inventory')\r\n            local backpack = player:FindFirstChild('Backpack')\r\n            local equippedItem = (character and character:FindFirstChild(originalName))\r\n                or (inventory and inventory:FindFirstChild(originalName))\r\n                or (backpack and backpack:FindFirstChild(originalName))\r\n            if equippedItem then return equippedItem end\r\n        end\r\n        local containers = {player:FindFirstChild('Inventory'), player:FindFirstChild('Backpack'), character}\r\n        for _, container in pairs(containers) do\r\n            if container then\r\n                for _, item in ipairs(container:GetChildren()) do\r\n                    if names[item.Name] and item:GetAttribute('ToolName') == 'Fishing Rod' then return item end\r\n                end\r\n            end\r\n        end\r\n        return nil\r\n    end\r\n    function F.IsFishCatch(item)\r\n        local function isFishName(name)\r\n            if type(name) ~= 'string' then return false end\r\n            local normalized = string.lower(name)\r\n            normalized = string.gsub(normalized, '^cooked%s+', '')\r\n            normalized = string.gsub(normalized, '^raw%s+', '')\r\n            return F.FishNames[normalized] == true\r\n        end\r\n        return isFishName(F.GetItemValue(item)) or isFishName(item and item.Name)\r\n    end\r\n    function F.HeldRod()\r\n        local character = _LocalPlayer.Character\r\n        local handle = character and character:FindFirstChild('ToolHandle')\r\n        if not handle or handle:GetAttribute('ToolName') ~= 'Fishing Rod' then return nil end\r\n        local equippedName = F.GetItemValue(handle)\r\n        local rodNames = {['Old Rod'] = true, ['Good Rod'] = true, ['Strong Rod'] = true}\r\n        if not rodNames[equippedName] then return nil end\r\n        local item = F.FindOwnedRod({[equippedName] = true})\r\n        if item and item:GetAttribute('ToolName') == 'Fishing Rod' then return item end\r\n        return nil\r\n    end\r\n    function F.PriorityActionActive()\r\n        if isAnyCombatActive()\r\n            or _G.StrongholdTransition\r\n            or _G.StrongholdPreparingRaid\r\n            or _G.ForceStrongholdRaid\r\n            or _G.AutoChopSelectedTreesActive\r\n            or _G.AutoChopSelectedTreesRunning then\r\n            return true\r\n        end\r\n\r\n        -- Some campfire cultists are alive before their combat worker raises a flag.\r\n        local campfirePosition = getAutoBagCampfirePosition()\r\n        local characters = _Workspace:FindFirstChild('Characters')\r\n        if not campfirePosition or not characters then return false end\r\n\r\n        local checked = 0\r\n        for _, entity in ipairs(characters:GetChildren()) do\r\n            checked += 1\r\n            if checked % 48 == 0 then task.wait() end\r\n            if entity:IsA('Model') and not entity:HasTag('CultistCorpse') then\r\n                local name = string.lower(entity.Name)\r\n                local npcType = string.lower(tostring(entity:GetAttribute('NPCType') or ''))\r\n                local isCultist = string.find(name, 'cultist', 1, true) ~= nil\r\n                    or string.find(npcType, 'cultist', 1, true) ~= nil\r\n                local health = entity:GetAttribute('Health')\r\n                if isCultist and entity:GetAttribute('Dead') ~= true\r\n                    and (type(health) ~= 'number' or health > 0) then\r\n                    local position\r\n                    pcall(function() position = entity:GetPivot().Position end)\r\n                    if position and (position - campfirePosition).Magnitude <= 200 then\r\n                        return true\r\n                    end\r\n                end\r\n            end\r\n        end\r\n        return false\r\n    end\r\n    _G.KixPriorityActionActive = F.PriorityActionActive\r\n    function F.EnsureHeldRod(active)\r\n        local rodNames = {['Old Rod'] = true, ['Good Rod'] = true, ['Strong Rod'] = true}\r\n        local rod = F.FindOwnedRod(rodNames)\r\n        if not rod then\r\n            F.SetFishStatus('Waiting for a fishing rod')\r\n            return nil\r\n        end\r\n\r\n        local inventoryHandler = Client and Client.InventoryHandler\r\n        local getEquipped = inventoryHandler and inventoryHandler.GetCurrentlyEquippedClass\r\n        local current = type(getEquipped) == 'function' and getEquipped() or nil\r\n        if current and current.Model == rod and current.Tool and current.Tool.Equipped == true then\r\n            return rod\r\n        end\r\n\r\n        if F.PriorityActionActive() then\r\n            F.SetFishStatus('Paused for combat or chopping')\r\n            return nil\r\n        end\r\n\r\n        -- A replicated ToolHandle alone is only a visual sync; Fishing Rod\r\n        -- needs InventoryHandler's local controller to enter Fishing state.\r\n        -- Equip the owned inventory model through the game's normal handler.\r\n        if _G.IsEating or _G.KixHubAuraLock then\r\n            F.SetFishStatus('Waiting for the current action to finish')\r\n            return nil\r\n        end\r\n\r\n        if rod.Parent ~= _LocalPlayer:FindFirstChild('Inventory') then\r\n            F.SetFishStatus('Moving rod into inventory...')\r\n            return nil\r\n        end\r\n\r\n        local requestEquip = inventoryHandler and inventoryHandler.RequestEquipItem\r\n        if type(requestEquip) ~= 'function' then\r\n            F.SetFishStatus('Fishing controls are unavailable')\r\n            return nil\r\n        end\r\n\r\n        local equipOk, equipResult = pcall(requestEquip, rod)\r\n        if equipOk and equipResult ~= false then\r\n            local deadline = os.clock() + 0.4\r\n            repeat\r\n                task.wait(0.05)\r\n                if not active() or not rod.Parent then return nil end\r\n                current = type(getEquipped) == 'function' and getEquipped() or nil\r\n                if current and current.Model == rod and current.Tool and current.Tool.Equipped == true then\r\n                    return rod\r\n                end\r\n            until os.clock() >= deadline\r\n        end\r\n\r\n        F.SetFishStatus('Waiting for the rod controller to equip...')\r\n        return nil\r\n    end\r\n    function F.CanMove(item)\r\n        return _G.KixItemTransportSystem and _G.KixItemTransportSystem.CanTeleport\r\n            and _G.KixItemTransportSystem.CanTeleport(item)\r\n    end\r\n    function F.Move(item, target, active)\r\n        if not F.CanMove(item) or not _G.KixItemTransportSystem.Move then return false end\r\n        return _G.KixItemTransportSystem.Move(item, target, active)\r\n    end\r\n    function F.StartMedicinePickup(value)\r\n        F.MedicineRun += 1\r\n        local run = F.MedicineRun\r\n        F.MedicineOn = value == true\r\n        if not F.MedicineOn then return end\r\n\r\n        task.spawn(function()\r\n            local function active()\r\n                return F.MedicineOn and F.MedicineRun == run and F.FishOn\r\n                    and F.FishRun > 0 and KixHubSession.Alive\r\n            end\r\n            local medicineNames = {'Bandage', 'MedKit', 'Medkit'}\r\n            while active() do\r\n                local folder, items = _G.KixItemsIndex.Get()\r\n                local candidate\r\n                if folder and items then\r\n                    for _, name in ipairs(medicineNames) do\r\n                        local bucket = _G.KixItemsIndex.GetByName(name)\r\n                        local indexed = bucket and bucket.Items\r\n                        local count = indexed and #indexed or 0\r\n                        if count > 0 then\r\n                            local cursor = F.MedicineCursor[name] or 1\r\n                            if cursor > count then cursor = 1 end\r\n                            local checked = 0\r\n                            while checked < math.min(8, count) do\r\n                                if not active() then return end\r\n                                local item = indexed[cursor]\r\n                                cursor = cursor % count + 1\r\n                                checked += 1\r\n                                F.MedicineCursor[name] = cursor\r\n                                if item and item.Parent == folder\r\n                                    and os.clock() >= (F.MedicineRetry[item] or 0)\r\n                                    and not (_G.KixIsLoggingCampItem and _G.KixIsLoggingCampItem(item))\r\n                                    and not (_G.KixIsBringBlacklistedItem and _G.KixIsBringBlacklistedItem(item)) then\r\n                                    local owner = item:GetAttribute('Owner')\r\n                                    if (owner == nil or owner == _LocalPlayer.UserId)\r\n                                        and item:GetAttribute('Locked') ~= true\r\n                                        and item:GetAttribute('IceBlock') ~= true\r\n                                        and item:GetAttribute('EasterDraggingLocked') ~= true\r\n                                        and item:GetAttribute('NoDragging') ~= true\r\n                                        and not isItemHeldByAnotherPlayer(item, true) then\r\n                                        candidate = item\r\n                                        break\r\n                                    end\r\n                                end\r\n                            end\r\n                        end\r\n                        if candidate then break end\r\n                    end\r\n                end\r\n\r\n                if candidate and active() then\r\n                    local item = candidate\r\n                    local character = _LocalPlayer.Character\r\n                    local root = character and character:FindFirstChild('HumanoidRootPart')\r\n                    local remoteEvents = _ReplicatedStorage:FindFirstChild('RemoteEvents')\r\n                    local pickup = remoteEvents and remoteEvents:FindFirstChild('RequestHotbarItem')\r\n                    if root and pickup and item.Parent == folder then\r\n                        F.MedicineRetry[item] = os.clock() + 3\r\n                        local inventory = _LocalPlayer:FindFirstChild('Inventory')\r\n                        local beforeCount = 0\r\n                        for _, container in ipairs({inventory, _LocalPlayer:FindFirstChild('Backpack'), character}) do\r\n                            if container then\r\n                                for _, owned in ipairs(container:GetChildren()) do\r\n                                    if owned.Name == item.Name then beforeCount += 1 end\r\n                                end\r\n                            end\r\n                        end\r\n\r\n                        local function requestPickup()\r\n                            if not active() or item.Parent ~= folder then return false, nil end\r\n                            return pcall(function()\r\n                                if pickup:IsA('RemoteFunction') then return pickup:InvokeServer(item) end\r\n                                if pickup:IsA('RemoteEvent') then pickup:FireServer(item); return nil end\r\n                                return false\r\n                            end)\r\n                        end\r\n                        local callOk, result = requestPickup()\r\n                        task.wait(0.1)\r\n                        local function confirmed()\r\n                            if item.Parent ~= folder then return true end\r\n                            local currentCount = 0\r\n                            for _, container in ipairs({inventory, _LocalPlayer:FindFirstChild('Backpack'), _LocalPlayer.Character}) do\r\n                                if container then\r\n                                    for _, owned in ipairs(container:GetChildren()) do\r\n                                        if owned.Name == item.Name then currentCount += 1 end\r\n                                    end\r\n                                end\r\n                            end\r\n                            return currentCount > beforeCount\r\n                                or result == true\r\n                                or (type(result) == 'table' and result.Success == true)\r\n                        end\r\n\r\n                        if not confirmed() and active() and item.Parent == folder then\r\n                            F.Move(item, root.CFrame, active)\r\n                            task.wait(0.1)\r\n                            callOk, result = requestPickup()\r\n                            task.wait(0.1)\r\n                            if not confirmed() then F.MedicineRetry[item] = os.clock() + 6 end\r\n                        end\r\n                        if callOk and confirmed() then\r\n                            F.MedicineRetry[item] = nil\r\n                        end\r\n                    end\r\n                    task.wait(0.5)\r\n                else\r\n                    task.wait(1)\r\n                end\r\n            end\r\n        end)\r\n    end\r\n    function F.ClearSpots()\r\n        for _, connection in ipairs(F.SpotConnections) do pcall(function() connection:Disconnect() end) end\r\n        table.clear(F.SpotConnections)\r\n        for _, connection in pairs(F.SpotItemConnections) do pcall(function() connection:Disconnect() end) end\r\n        table.clear(F.SpotItemConnections)\r\n        table.clear(F.Spots)\r\n        F.SpotWater = nil\r\n    end\r\n    function F.RefreshSpots(water)\r\n        if F.SpotWater == water then return end\r\n        F.ClearSpots()\r\n        F.SpotWater = water\r\n        if not water then return end\r\n        local function add(item)\r\n            if item:IsA('BasePart') then F.Spots[item] = item:GetAttribute('FishingSpotTier') end\r\n            F.SpotItemConnections[item] = item:GetAttributeChangedSignal('FishingSpotTier'):Connect(function()\r\n                F.Spots[item] = item:IsA('BasePart') and item:GetAttribute('FishingSpotTier') or nil\r\n            end)\r\n        end\r\n        for _, item in ipairs(water:GetChildren()) do add(item) end\r\n        table.insert(F.SpotConnections, water.ChildAdded:Connect(add))\r\n        table.insert(F.SpotConnections, water.ChildRemoved:Connect(function(item)\r\n            F.Spots[item] = nil\r\n            local connection = F.SpotItemConnections[item]\r\n            if connection then connection:Disconnect(); F.SpotItemConnections[item] = nil end\r\n        end))\r\n    end\r\n    function F.FindSpot(tier, active)\r\n        local map = _Workspace:FindFirstChild('Map')\r\n        local water = map and map:FindFirstChild('Water')\r\n        F.RefreshSpots(water)\r\n        if not map or not water then return nil end\r\n        local character = _LocalPlayer.Character\r\n        local root = character and character:FindFirstChild('HumanoidRootPart')\r\n        if not root then return nil end\r\n        local best, bestDistance\r\n        local budget = 0\r\n        for spot, spotTier in pairs(F.Spots) do\r\n            budget += 1\r\n            if budget >= 32 then budget = 0; task.wait() end\r\n            if not active() then return nil end\r\n            if spot.Parent == water and spotTier == tier then\r\n                local distance = (root.Position - spot.Position).Magnitude\r\n                if not bestDistance or distance < bestDistance then best, bestDistance = spot, distance end\r\n            end\r\n        end\r\n        return best, map, water, root, character\r\n    end\r\n    function F.CancelCatch()\r\n        local pending = F.Pending\r\n        F.Pending = nil\r\n        if pending and pending.EndRemote then pcall(function() pending.EndRemote:FireServer() end) end\r\n    end\r\n    function F.RestoreGuards()\r\n        for key, original in pairs(F.GuardOriginals) do\r\n            if F.GuardModule and F.GuardModule[key] == F.GuardWrappers[key] then F.GuardModule[key] = original end\r\n        end\r\n        table.clear(F.GuardOriginals)\r\n        table.clear(F.GuardWrappers or {})\r\n        F.GuardModule = nil\r\n    end\r\n    function F.InstallGuards(module, run)\r\n        F.RestoreGuards()\r\n        F.GuardModule = module\r\n        F.GuardWrappers = {}\r\n        for _, key in ipairs({'Activate', 'Cast', 'Reel'}) do\r\n            local original = module[key]\r\n            F.GuardOriginals[key] = original\r\n            local wrapper = function(...)\r\n                if F.FishOn and F.FishRun == run then return end\r\n                return original(...)\r\n            end\r\n            F.GuardWrappers[key] = wrapper\r\n            module[key] = wrapper\r\n        end\r\n    end\r\n    function F.FishStatusText()\r\n        if not F.FishOn then return 'Off' end\r\n        if not F.FindOwnedRod({['Old Rod'] = true, ['Good Rod'] = true, ['Strong Rod'] = true}) then\r\n            return 'Waiting for a fishing rod'\r\n        end\r\n        local pending = F.Pending\r\n        if pending and pending.Spot and pending.Spot.Parent == pending.Water then\r\n            return 'Fishing at ' .. (FishingTiers[pending.Tier] or 'Water zone')\r\n        end\r\n        return F.FishStatus or ('Finding ' .. (FishingTiers[F.Pond] or 'water'))\r\n    end\r\n    function F.StartFish(value)\r\n        value = value == true\r\n        if value == F.FishOn then return end\r\n        F.FishRun += 1\r\n        local run = F.FishRun\r\n        F.FishOn = value\r\n        F.StartMedicinePickup(value)\r\n        F.CancelCatch()\r\n        F.SetFishStatus(F.FishOn and 'Checking rod...' or 'Off')\r\n        if not F.FishOn then\r\n            F.StartUpgrade(false)\r\n            F.RestoreGuards()\r\n            return\r\n        end\r\n        task.spawn(function()\r\n            local function active()\r\n                return F.FishOn and F.FishRun == run and KixHubSession.Alive\r\n            end\r\n            F.SetFishStatus('Checking rod...')\r\n            F.EnsureRod(active)\r\n            if not active() then return end\r\n            F.StartUpgrade(true)\r\n            local module\r\n            local ok = pcall(function()\r\n                local tools = _ReplicatedStorage:FindFirstChild('Tools')\r\n                local rodModule = tools and tools:FindFirstChild('Fishing Rod')\r\n                if rodModule then module = require(rodModule) end\r\n            end)\r\n            if not ok or type(module) ~= 'table' or type(module.Activate) ~= 'function'\r\n                or type(module.Cast) ~= 'function' or type(module.Reel) ~= 'function' then\r\n                if F.FishRun == run then\r\n                    F.FishOn = false\r\n                    F.StartUpgrade(false)\r\n                    F.SetFishStatus('Fishing unavailable')\r\n                    if F.FishToggle then pcall(function() F.FishToggle:Set(false, false) end) end\r\n                end\r\n                return\r\n            end\r\n            while F.FishOn and F.FishRun == run and KixHubSession.Alive do\r\n                local resultOk, result = pcall(function()\r\n                    if F.PriorityActionActive() then\r\n                        F.SetFishStatus('Paused for combat or chopping')\r\n                        return\r\n                    end\r\n                    local rod = F.EnsureHeldRod(active)\r\n                    if not rod then return end\r\n                    local spot, map, water, root, character = F.FindSpot(F.Pond, active)\r\n                    local remotes = _ReplicatedStorage:FindFirstChild('RemoteEvents')\r\n                    local start = remotes and remotes:FindFirstChild('StartCatchTimer')\r\n                    local confirm = remotes and remotes:FindFirstChild('ConfirmCatchItem')\r\n                    local finish = remotes and remotes:FindFirstChild('EndCatching')\r\n                    if not spot then\r\n                        F.SetFishStatus('No ' .. (FishingTiers[F.Pond] or 'water') .. ' loaded')\r\n                        return\r\n                    end\r\n                    if not start or not confirm or not finish or not start:IsA('RemoteFunction') then\r\n                        F.SetFishStatus('Fishing is loading...'); return\r\n                    end\r\n                    local pending = {Run = run, Tier = F.Pond, Character = character, Root = root,\r\n                        Rod = rod, Spot = spot, Water = water, Map = map, EndRemote = finish}\r\n                    F.Pending = pending\r\n                    local function valid()\r\n                        local inventory = _LocalPlayer:FindFirstChild('Inventory')\r\n                        local backpack = _LocalPlayer:FindFirstChild('Backpack')\r\n                        return F.FishOn and F.FishRun == run and F.Pending == pending\r\n                            and _LocalPlayer.Character == character and root.Parent == character\r\n                            and (rod.Parent == inventory or rod.Parent == backpack or rod.Parent == character)\r\n                            and spot.Parent == water and water.Parent == map\r\n                            and map.Parent == _Workspace and spot:GetAttribute('FishingSpotTier') == pending.Tier\r\n                            and F.Pond == pending.Tier\r\n                    end\r\n                    if not valid() then F.CancelCatch(); return end\r\n                    F.SetFishStatus('Fishing at ' .. (FishingTiers[pending.Tier] or 'your water zone'))\r\n                    local callOk, catch = pcall(function()\r\n                        return start:InvokeServer(rod, spot, spot.Position + Vector3.new(0, spot.Size.Y / 2, 0))\r\n                    end)\r\n                    local trashAttempted = false\r\n                    if valid() and callOk and catch and catch.Item then\r\n                        confirm:FireServer()\r\n                        local item = catch.Item\r\n                        local itemFolder = _Workspace:FindFirstChild('Items')\r\n                        if itemFolder and item.Parent ~= itemFolder then pcall(function() item.Parent = itemFolder end) end\r\n                        if F.TrashAllFish == true and F.IsFishCatch(item) then\r\n                            trashAttempted = true\r\n                            local trashOk, discarded = pcall(function()\r\n                                if type(_G.KixMoveItemsToVoid) ~= 'function' then return 0 end\r\n                                return _G.KixMoveItemsToVoid({item}, valid)\r\n                            end)\r\n                            discarded = trashOk and tonumber(discarded) or 0\r\n                            F.SetFishStatus(discarded > 0 and 'Fish caught; discarded to Void. Casting again...'\r\n                                or 'Trash move failed; fish may remain')\r\n                        elseif root.Parent and F.CanMove(item) then\r\n                            F.Move(item, root.CFrame * CFrame.new(0, 5, -5), valid)\r\n                        end\r\n                    else\r\n                        pcall(function() finish:FireServer() end)\r\n                        if F.FishOn and F.FishRun == run then\r\n                            F.SetFishStatus(not callOk and 'Fishing request failed; retrying...'\r\n                                or 'No bite yet; retrying at ' .. (FishingTiers[F.Pond] or 'your pond'))\r\n                        end\r\n                    end\r\n                    if F.Pending == pending then F.Pending = nil end\r\n                    if F.FishOn and F.FishRun == run then\r\n                        if not trashAttempted then\r\n                            F.SetFishStatus(callOk and catch and catch.Item\r\n                                and 'Fish caught; casting again...'\r\n                                or (not callOk and 'Fishing request failed; retrying...'\r\n                                    or 'No bite yet; retrying at ' .. (FishingTiers[F.Pond] or 'your pond')))\r\n                        end\r\n                    end\r\n                end)\r\n                if not resultOk then warn('[Fishing] Auto Fish: ' .. tostring(result)) end\r\n                task.wait(1)\r\n            end\r\n            if F.FishRun == run then F.CancelCatch(); F.RestoreGuards() end\r\n        end)\r\n    end\r\n    function F.SetPond(tier)\r\n        if not FishingTiers[tier] or F.Pond == tier then return end\r\n        F.Pond = tier\r\n        F.CancelCatch()\r\n        F.SetFishStatus('Finding ' .. FishingTiers[tier])\r\n    end\r\n\r\n    function F.EnsureRod(active)\r\n            local rodNames = {['Old Rod'] = true, ['Good Rod'] = true, ['Strong Rod'] = true}\r\n            if F.FindOwnedRod(rodNames) then\r\n                WindUI:Notify({Title = 'Fishing Setup', Content = 'A fishing rod is already in your gear', Duration = 3})\r\n                return true\r\n            end\r\n            if not active() then return false end\r\n            local character = _LocalPlayer.Character\r\n            local root = character and character:FindFirstChild('HumanoidRootPart')\r\n            local humanoid = character and character:FindFirstChildOfClass('Humanoid')\r\n            local items = _Workspace:FindFirstChild('Items')\r\n            local remotes = _ReplicatedStorage:FindFirstChild('RemoteEvents')\r\n            local pickup = remotes and remotes:FindFirstChild('RequestHotbarItem')\r\n            if not root or not humanoid or humanoid.Health <= 0 or _LocalPlayer:GetAttribute('Undead') then\r\n                WindUI:Notify({Title = 'Fishing Setup', Content = 'Your character must be alive to collect a rod', Duration = 3}); return false\r\n            end\r\n            if pickup and items then\r\n                local budget = 0\r\n                for _, item in ipairs(items:GetChildren()) do\r\n                    if not active() then return false end\r\n                    budget += 1\r\n                    if budget >= 32 then budget = 0; task.wait() end\r\n                    local owner = item:GetAttribute('Owner')\r\n                    if item.Name == 'Old Rod' and item:GetAttribute('Interaction') == 'Tool'\r\n                        and (owner == nil or owner == _LocalPlayer.UserId)\r\n                        and item:GetAttribute('Locked') ~= true and item:GetAttribute('IceBlock') ~= true\r\n                        and F.CanMove(item) then\r\n                        if F.Move(item, root.CFrame, function()\r\n                            return active() and _LocalPlayer.Character == character and humanoid.Health > 0\r\n                        end) then\r\n                            task.wait(0.1)\r\n                            if active() then pcall(function() pickup:InvokeServer(item) end) end\r\n                            local deadline = os.clock() + 3\r\n                            while active() and os.clock() < deadline and not F.FindOwnedRod(rodNames) do task.wait(0.1) end\r\n                            if F.FindOwnedRod(rodNames) then\r\n                                WindUI:Notify({Title = 'Fishing Setup', Content = 'Starter rod collected from the ground', Duration = 3}); return true\r\n                            end\r\n                        end\r\n                    end\r\n                end\r\n            end\r\n            if not active() then return false end\r\n            if (tonumber(_LocalPlayer:GetAttribute('Coins')) or 0) < 20 then\r\n                WindUI:Notify({Title = 'Fishing Setup', Content = 'No rod found and 20 coins are needed for a starter rod', Duration = 3}); return false\r\n            end\r\n            local purchase = remotes and remotes:FindFirstChild('RequestPurchaseTool')\r\n            local bought = false\r\n            if purchase then\r\n                bought = pcall(function()\r\n                    if purchase:IsA('RemoteFunction') then return purchase:InvokeServer('Old Rod') end\r\n                    if purchase:IsA('RemoteEvent') then purchase:FireServer('Old Rod'); return true end\r\n                end)\r\n            end\r\n            local deadline = os.clock() + 4\r\n            local owned\r\n            repeat\r\n                owned = F.FindOwnedRod({['Old Rod'] = true, ['Good Rod'] = true, ['Strong Rod'] = true})\r\n                if owned then break end\r\n                task.wait(0.1)\r\n            until os.clock() >= deadline or not active()\r\n            WindUI:Notify({Title = 'Fishing Setup',\r\n                Content = owned and 'Starter rod purchased from the trader' or (bought and 'The trader request was not confirmed' or 'The starter rod could not be purchased'), Duration = 3})\r\n            return owned ~= nil\r\n    end\r\n\r\n    function F.RodReady(rod)\r\n        local xp, maxXp = rod and rod:GetAttribute('XP'), rod and rod:GetAttribute('LevelUpXP')\r\n        return rod and UpgradeNames[rod.Name] and rod:GetAttribute('ToolName') == 'Fishing Rod'\r\n            and type(xp) == 'number' and type(maxXp) == 'number' and maxXp > 0 and xp >= maxXp\r\n    end\r\n    function F.WatchUpgrade(bench, rod, character)\r\n        local seen = setmetatable({}, {__mode = 'k'})\r\n        local items = _Workspace:FindFirstChild('Items')\r\n        for _, item in ipairs(items and items:GetChildren() or {}) do seen[item] = true end\r\n        return {Bench = bench, Rod = rod, Character = character, Seen = seen,\r\n            Name = UpgradeTo[rod.Name], Started = os.clock(), Deadline = os.clock() + 60}\r\n    end\r\n    function F.StepUpgradePickup(watch, active)\r\n        if os.clock() >= watch.Deadline or not active() or _LocalPlayer.Character ~= watch.Character then return true end\r\n        local character = watch.Character\r\n        local root = character and character:FindFirstChild('HumanoidRootPart')\r\n        local items = _Workspace:FindFirstChild('Items')\r\n        local inventory = _LocalPlayer:FindFirstChild('Inventory')\r\n        if not watch.Bench or not watch.Bench:IsDescendantOf(_Workspace) or not watch.Bench.PrimaryPart then return true end\r\n        if inventory and watch.Rod.Parent == inventory and os.clock() - watch.Started >= 1 then return true end\r\n        if not root or not items then return false end\r\n        local pickup = _ReplicatedStorage:FindFirstChild('RemoteEvents')\r\n        pickup = pickup and pickup:FindFirstChild('RequestHotbarItem')\r\n        if not pickup then return false end\r\n        local budget = 0\r\n        for _, item in ipairs(items:GetChildren()) do\r\n            budget += 1\r\n            if budget >= 32 then budget = 0; task.wait() end\r\n            local owner = item:GetAttribute('Owner')\r\n            if not watch.Seen[item] and item.Name == watch.Name and item:GetAttribute('ToolName') == 'Fishing Rod'\r\n                and item:GetAttribute('Interaction') == 'Tool' and (owner == nil or owner == _LocalPlayer.UserId)\r\n                and item:GetAttribute('Locked') ~= true and item:GetAttribute('IceBlock') ~= true\r\n                and F.CanMove(item) and (item.PrimaryPart.Position - watch.Bench.PrimaryPart.Position).Magnitude <= 16 then\r\n                if F.Move(item, root.CFrame, active) then\r\n                    task.wait(0.1)\r\n                    pcall(function() pickup:InvokeServer(item) end)\r\n                    task.wait(0.2)\r\n                    return item.Parent == inventory\r\n                end\r\n            end\r\n        end\r\n        return false\r\n    end\r\n    function F.RequestUpgrade(client, bench, rod, prompt)\r\n        if client and type(client.RequestUpgradeRod) == 'function' then\r\n            return pcall(client.RequestUpgradeRod, bench)\r\n        end\r\n        local remotes = _ReplicatedStorage:FindFirstChild('RemoteEvents')\r\n        local remote = remotes and remotes:FindFirstChild('RequestUpgradeRod')\r\n        local temp = _ReplicatedStorage:FindFirstChild('TempStorage')\r\n        local inventory = _LocalPlayer:FindFirstChild('Inventory')\r\n        if not remote or not temp or not inventory or not prompt then return false end\r\n        bench:SetAttribute('LocalUpgrading', true)\r\n        prompt.Enabled = false\r\n        rod.Parent = temp\r\n        local ok, result = pcall(function() return remote:InvokeServer(rod, bench) end)\r\n        if not (ok and type(result) == 'table' and result.Success) and rod.Parent == temp then\r\n            task.wait(0.5); rod.Parent = inventory\r\n        end\r\n        local function restore()\r\n            bench:SetAttribute('LocalUpgrading', nil)\r\n            prompt.Enabled = true\r\n        end\r\n        if bench:GetAttribute('Upgrading') then\r\n            local connection\r\n            connection = bench:GetAttributeChangedSignal('Upgrading'):Connect(function()\r\n                connection:Disconnect(); restore()\r\n            end)\r\n        else restore() end\r\n        return ok and type(result) == 'table' and result.Success == true\r\n    end\r\n    function F.StartUpgrade(value)\r\n        F.UpgradeRun += 1\r\n        local run = F.UpgradeRun\r\n        F.UpgradeOn = value == true\r\n        F.SetUpgradeStatus(F.UpgradeOn and 'Preparing the upgrade worker' or 'Rod upgrades are paused')\r\n        if not F.UpgradeOn then return end\r\n        task.spawn(function()\r\n            local cooldown = setmetatable({}, {__mode = 'k'})\r\n            local watch\r\n            local clientModule\r\n            pcall(function()\r\n                local tools = _ReplicatedStorage:FindFirstChild('Tools')\r\n                local rodModule = tools and tools:FindFirstChild('Fishing Rod')\r\n                local module = rodModule and require(rodModule)\r\n                clientModule = module and module.FishingUpgradeClient\r\n            end)\r\n            while F.UpgradeOn and F.UpgradeRun == run and KixHubSession.Alive do\r\n                local ok, err = pcall(function()\r\n                    local function active() return F.UpgradeOn and F.UpgradeRun == run and KixHubSession.Alive end\r\n                    if F.PriorityActionActive() then\r\n                        F.SetUpgradeStatus('Paused for combat or chopping')\r\n                        return\r\n                    end\r\n                    if watch then\r\n                        F.SetUpgradeStatus('Collecting upgraded rod: ' .. watch.Name)\r\n                        if F.StepUpgradePickup(watch, active) then\r\n                            watch = nil\r\n                            if F.FishOn and KixHubSession.Alive then\r\n                                F.EnsureHeldRod(function()\r\n                                    return F.FishOn and KixHubSession.Alive\r\n                                end)\r\n                            end\r\n                        end\r\n                    else\r\n                        local rod = F.FindOwnedRod(UpgradeNames)\r\n                        local character = _LocalPlayer.Character\r\n                        local root = character and character:FindFirstChild('HumanoidRootPart')\r\n                        if rod and root and F.RodReady(rod) and (not cooldown[rod] or os.clock() - cooldown[rod] >= 5) then\r\n                            F.SetUpgradeStatus('Searching for a nearby rod station')\r\n                            local collection = game:GetService('CollectionService')\r\n                            local best, bestDistance, bestPrompt\r\n                            local budget = 0\r\n                            for _, bench in ipairs(collection:GetTagged('Interaction')) do\r\n                                budget += 1\r\n                                if budget >= 32 then budget = 0; task.wait() end\r\n                                if not active() then return end\r\n                                if bench:IsA('Model') and bench:IsDescendantOf(_Workspace) and bench.PrimaryPart then\r\n                                    local interaction = bench:GetAttribute('Interaction')\r\n                                    local attachment = bench.PrimaryPart:FindFirstChild('ProximityAttachment')\r\n                                    local prompt = attachment and attachment:FindFirstChild('ProximityInteraction')\r\n                                    if (interaction == 'FishingRodUpgrade' or interaction == 'ToolUpgradeBench')\r\n                                        and prompt and prompt.Enabled and not bench:GetAttribute('Upgrading')\r\n                                        and not bench:GetAttribute('LocalUpgrading') then\r\n                                        local distance = (root.Position - bench.PrimaryPart.Position).Magnitude\r\n                                        if not bestDistance or distance < bestDistance then best, bestDistance, bestPrompt = bench, distance, prompt end\r\n                                    end\r\n                                end\r\n                            end\r\n                            if best and active() and F.RodReady(rod) then\r\n                                cooldown[rod] = os.clock()\r\n                                watch = F.WatchUpgrade(best, rod, character)\r\n                                F.SetUpgradeStatus('Sending rod upgrade request')\r\n                                if not F.RequestUpgrade(clientModule, best, rod, bestPrompt) then watch = nil end\r\n                            end\r\n                        else\r\n                            F.SetUpgradeStatus('Waiting for a rod to reach its XP cap')\r\n                        end\r\n                    end\r\n                end)\r\n                if not ok then warn('[Fishing] Auto Upgrade: ' .. tostring(err)) end\r\n                task.wait(1)\r\n            end\r\n        end)\r\n    end\r\n\r\n-- ==================== FISHING & TAMING FULL BAR ====================\r\nTabs.Fishing:Section({Title = 'Minigame Helpers', Icon = 'target'})\r\n\r\ngetgenv().MinigameFullBarEnabled = getgenv().MinigameFullBarEnabled or false\r\n\r\ngetgenv().SetMinigameFullBar = function(val)\r\n    getgenv().MinigameFullBarEnabled = val\r\n    if getgenv().MinigameFullBarToggle and getgenv().MinigameFullBarToggle.SetValue then\r\n        pcall(function()\r\n            getgenv().MinigameFullBarToggle:SetValue(val)\r\n        end)\r\n    end\r\nend\r\n\r\ngetgenv().MinigameFullBarToggle = Tabs.Fishing:Toggle({\r\n    Title = 'Fishing & Taming Full Green Bar',\r\n    Value = getgenv().MinigameFullBarEnabled or false,\r\n    Callback = function(val)\r\n        getgenv().MinigameFullBarEnabled = val\r\n        local player = game:GetService(\"Players\").LocalPlayer\r\n        local RunService = game:GetService(\"RunService\")\r\n        \r\n        if val then\r\n            -- Auto Bring: Seret 1 Old Rod dan 1 Old Taming Flute dari map ke player\r\n            task.spawn(function()\r\n                pcall(function()\r\n                    local hrp = _LocalPlayer.Character and _LocalPlayer.Character:FindFirstChild(\"HumanoidRootPart\")\r\n                    local itemsFolder = (_Workspace:FindFirstChild(\"Items\") or workspace:FindFirstChild(\"items\"))\r\n                    if hrp and itemsFolder then\r\n                        local gotRod, gotFlute = false, false\r\n                        for _, item in ipairs(itemsFolder:GetChildren()) do\r\n                            if gotRod and gotFlute then break end\r\n                            if not gotRod and item.Name == \"Old Rod\" then\r\n                                dragItemSmooth(item, hrp.Position)\r\n                                gotRod = true\r\n                                task.wait(0.1)\r\n                            elseif not gotFlute and item.Name == \"Old Taming Flute\" then\r\n                                dragItemSmooth(item, hrp.Position)\r\n                                gotFlute = true\r\n                                task.wait(0.1)\r\n                            end\r\n                        end\r\n                    end\r\n                end)\r\n            end)\r\n\r\n            if not getgenv().MinigameBarLoop then\r\n                getgenv().MinigameBarLoop = RunService.RenderStepped:Connect(function()\r\n                    if not getgenv().MinigameFullBarEnabled then return end\r\n                    \r\n                    local pg = player:FindFirstChild(\"PlayerGui\")\r\n                    local interface = pg and pg:FindFirstChild(\"Interface\")\r\n                    if not interface then return end\r\n                    \r\n\r\n                    local fishFrame = interface:FindFirstChild(\"FishingCatchFrame\")\r\n                    if fishFrame and fishFrame.Visible then\r\n                        local successArea = fishFrame:FindFirstChild(\"SuccessArea\", true)\r\n                        if successArea then\r\n                            successArea.Size = UDim2.new(1, 0, 1, 0)\r\n                            successArea.Position = UDim2.new(0.5, 0, 0.5, 0)\r\n                            successArea.AnchorPoint = Vector2.new(0.5, 0.5)\r\n                            successArea.BackgroundColor3 = Color3.fromRGB(0, 255, 0)\r\n                        end\r\n                    end\r\n                    \r\n\r\n                    local tamingFrame = interface:FindFirstChild(\"TamingFluteFrame\")\r\n                    if tamingFrame and tamingFrame.Visible then\r\n                        local successArea = tamingFrame:FindFirstChild(\"SuccessArea\", true)\r\n                        if successArea then\r\n                            successArea.Size = UDim2.new(1, 0, 1, 0)\r\n                            successArea.Position = UDim2.new(0.5, 0, 0.5, 0)\r\n                            successArea.AnchorPoint = Vector2.new(0.5, 0.5)\r\n                            successArea.BackgroundColor3 = Color3.fromRGB(0, 255, 0)\r\n                        end\r\n                    end\r\n                end)\r\n            end\r\n        else\r\n            \r\n            if getgenv().MinigameBarLoop then\r\n                getgenv().MinigameBarLoop:Disconnect()\r\n                getgenv().MinigameBarLoop = nil\r\n            end\r\n        end\r\n    end\r\n})\r\n\r\n\r\n    F.FishStatusUI = Tabs.Fishing:Paragraph({Title = 'Fishing Status', Desc = F.FishStatus})\r\n    F.FishToggle = Tabs.Fishing:Toggle({Title = 'Auto Fish Everywhere',\r\n        Desc = 'Auto equips an owned rod when available and resumes after eating or combat; rod upgrades run in the background.',\r\n        Value = false, Callback = F.StartFish})\r\n    Tabs.Fishing:Dropdown({Title = 'Water Zone', Desc = 'Choose the water area for fishing.',\r\n        Values = {'Small Pond', 'Rocky Pond', 'Bone Pond (Huge Fish)', 'Cold Pond', 'Lava Pond (Rare Items)'},\r\n        Value = 'Lava Pond (Rare Items)', Callback = function(value)\r\n            local map = {['Small Pond'] = 1, ['Rocky Pond'] = 2, ['Bone Pond (Huge Fish)'] = 3,\r\n                ['Cold Pond'] = 101, ['Lava Pond (Rare Items)'] = 103}\r\n            F.SetPond(map[type(value) == 'table' and (value[1] or '') or value])\r\n        end})\r\n    F.TrashFishToggle = Tabs.Fishing:Toggle({\r\n        Title = 'Auto Trash All Fish',\r\n        Desc = 'Sends every caught fish to Void (Trash), including raw and cooked fish.',\r\n        Value = false,\r\n        Callback = function(value)\r\n            F.TrashAllFish = value == true\r\n        end\r\n    })\r\n    F.SetFishStatus('Auto Fish is off')\r\n    F.SetUpgradeStatus('Waiting for an equipped tool with full XP')\r\n    task.spawn(function()\r\n        local previousFish\r\n        while KixHubSession.Alive do\r\n            local fishStatus = F.FishStatusText()\r\n            if fishStatus ~= previousFish then F.SetFishStatus(fishStatus); previousFish = fishStatus end\r\n            task.wait(0.2)\r\n        end\r\n        F.FishRun += 1; F.UpgradeRun += 1\r\n        F.FishOn = false; F.UpgradeOn = false\r\n        F.StartMedicinePickup(false)\r\n        F.CancelCatch(); F.RestoreGuards(); F.ClearSpots()\r\n    end)\r\nend)() end\r\n\r\n-- Combined Animal Taming: native flute upgrade and taming automation share one toggle.\r\ndo (function()\r\n    local enabled, runId, acquiring = false, 0, false\r\n    local fluteRetryAt = 0\r\n    local originalStart, tamingModule, tamingPatch\r\n    local fluteNames = {['Old Taming Flute'] = true, ['Good Taming Flute'] = true}\r\n    local nextFlute = {['Old Taming Flute'] = 'Good Taming Flute', ['Good Taming Flute'] = 'Strong Taming Flute'}\r\n    local status\r\n\r\n    local function setStatus(text)\r\n        if status then pcall(function() status:SetDesc(text) end) end\r\n    end\r\n    local function active(id)\r\n        return enabled and runId == id and KixHubSession.Alive\r\n    end\r\n    local function hasFlute()\r\n        for _, container in ipairs({_LocalPlayer:FindFirstChild('Inventory'), _LocalPlayer:FindFirstChild('Backpack'), _LocalPlayer.Character}) do\r\n            local found = container and container:FindFirstChild('Taming Flute')\r\n            if found then return found end\r\n            if container then\r\n                for _, item in ipairs(container:GetChildren()) do\r\n                    if item:GetAttribute('ToolName') == 'Taming Flute' then return item end\r\n                end\r\n            end\r\n        end\r\n        return nil\r\n    end\r\n    local function collectFluteCoins(isActive)\r\n        local coins = tonumber(_LocalPlayer:GetAttribute('Coins')) or 0\r\n        if coins >= 20 then return true end\r\n        local items = _Workspace:FindFirstChild('Items')\r\n        local remotes = _ReplicatedStorage:FindFirstChild('RemoteEvents')\r\n        local collect = remotes and remotes:FindFirstChild('RequestCollectCoints')\r\n        if not items or not collect then return false end\r\n        for _ = 1, 3 do\r\n            if not isActive() then return false end\r\n            coins = tonumber(_LocalPlayer:GetAttribute('Coins')) or 0\r\n            if coins >= 20 then return true end\r\n            local stacks, checked = {}, 0\r\n            for _, item in ipairs(items:GetChildren()) do\r\n                checked += 1\r\n                if checked % 64 == 0 then task.wait() end\r\n                local amount = tonumber(item:GetAttribute('CoinAmount'))\r\n                local localToPlayer = item:GetAttribute('LocalToPlayer')\r\n                if item.Name == 'Coin Stack' and amount and amount > 0\r\n                    and (localToPlayer == nil or tonumber(localToPlayer) == _LocalPlayer.UserId) then\r\n                    table.insert(stacks, {Item = item, Amount = amount})\r\n                end\r\n            end\r\n            table.sort(stacks, function(a, b) return a.Amount < b.Amount end)\r\n            local selected, total = {}, 0\r\n            for _, entry in ipairs(stacks) do\r\n                if total >= 20 - coins then break end\r\n                table.insert(selected, entry.Item)\r\n                total += entry.Amount\r\n            end\r\n            if total < 20 - coins then return false end\r\n            for _, stack in ipairs(selected) do\r\n                if not isActive() then return false end\r\n                if stack.Parent == items then\r\n                    pcall(function()\r\n                        if collect:IsA('RemoteFunction') then collect:InvokeServer(stack)\r\n                        elseif collect:IsA('RemoteEvent') then collect:FireServer(stack) end\r\n                    end)\r\n                end\r\n            end\r\n            local deadline = os.clock() + 3\r\n            repeat\r\n                coins = tonumber(_LocalPlayer:GetAttribute('Coins')) or 0\r\n                if coins >= 20 then return true end\r\n                task.wait(0.1)\r\n            until os.clock() >= deadline or not isActive()\r\n        end\r\n        return (tonumber(_LocalPlayer:GetAttribute('Coins')) or 0) >= 20\r\n    end\r\n    local function ensureFlute(isActive)\r\n        if hasFlute() then return true end\r\n        if acquiring then return false end\r\n        acquiring = true\r\n        local got = false\r\n        pcall(function()\r\n            local character = _LocalPlayer.Character\r\n            local root = character and character:FindFirstChild('HumanoidRootPart')\r\n            local items = _Workspace:FindFirstChild('Items')\r\n            local remotes = _ReplicatedStorage:FindFirstChild('RemoteEvents')\r\n            local pickup = remotes and remotes:FindFirstChild('RequestHotbarItem')\r\n            if root and items and pickup then\r\n                for _, item in ipairs(items:GetChildren()) do\r\n                    if not isActive() then break end\r\n                    local owner = item:GetAttribute('Owner')\r\n                    if item.Name == 'Old Taming Flute' and item:GetAttribute('Interaction') == 'Tool'\r\n                        and (owner == nil or owner == _LocalPlayer.UserId)\r\n                        and item:GetAttribute('Locked') ~= true and item:GetAttribute('IceBlock') ~= true\r\n                        and _G.KixItemTransportSystem and _G.KixItemTransportSystem.CanTeleport(item) then\r\n                        setStatus('Collecting an Old Taming Flute...')\r\n                        local moved = _G.KixItemTransportSystem.Move(item, root.CFrame, isActive)\r\n                        if moved and isActive() then\r\n                            task.wait(0.1)\r\n                            pcall(function() pickup:InvokeServer(item) end)\r\n                            local deadline = os.clock() + 3\r\n                            repeat\r\n                                if hasFlute() then got = true; break end\r\n                                task.wait(0.1)\r\n                            until os.clock() >= deadline or not isActive()\r\n                        end\r\n                        if got then break end\r\n                    end\r\n                end\r\n            end\r\n            if not got and isActive() then\r\n                setStatus('Collecting enough coins for an Old Taming Flute...')\r\n                if not collectFluteCoins(isActive) then return end\r\n                local purchase = remotes and remotes:FindFirstChild('RequestPurchaseTool')\r\n                if purchase then\r\n                    setStatus('Buying an Old Taming Flute...')\r\n                    pcall(function()\r\n                        if purchase:IsA('RemoteFunction') then purchase:InvokeServer('Old Taming Flute')\r\n                        elseif purchase:IsA('RemoteEvent') then purchase:FireServer('Old Taming Flute') end\r\n                    end)\r\n                    local deadline = os.clock() + 3\r\n                    repeat\r\n                        if hasFlute() then got = true; break end\r\n                        task.wait(0.1)\r\n                    until os.clock() >= deadline or not isActive()\r\n                end\r\n            end\r\n        end)\r\n        acquiring = false\r\n        return got or hasFlute() ~= nil\r\n    end\r\n    local function ensureFluteWithRetry(id)\r\n        if hasFlute() then fluteRetryAt = 0; return true end\r\n        if not active(id) or os.clock() < fluteRetryAt then return false end\r\n        local ok, acquired = pcall(ensureFlute, function() return active(id) end)\r\n        if ok and (acquired or hasFlute()) then\r\n            fluteRetryAt = 0\r\n            setStatus('Taming Flute ready')\r\n            return true\r\n        end\r\n        fluteRetryAt = os.clock() + 5\r\n        if not ok then warn('[Taming] Flute acquisition: ' .. tostring(acquired)) end\r\n        setStatus('Searching for an Old Taming Flute or enough coins...')\r\n        return false\r\n    end\r\n\r\n    local function installTaming(id)\r\n        if tamingModule and tamingPatch then return true end\r\n        local tools = _ReplicatedStorage:FindFirstChild('Tools')\r\n        local source = tools and tools:FindFirstChild('Taming Flute')\r\n        if not source then return false end\r\n        local ok, module = pcall(require, source)\r\n        if not active(id) or not ok or type(module) ~= 'table' or type(module.StartTamingMinigame) ~= 'function' then\r\n            return false\r\n        end\r\n        tamingModule, originalStart = module, module.StartTamingMinigame\r\n        tamingPatch = function(controller, animal)\r\n            if not active(id) then return originalStart(controller, animal) end\r\n            task.spawn(function()\r\n                pcall(function()\r\n                    local remotes = _ReplicatedStorage:FindFirstChild('RemoteEvents')\r\n                    local neutral = remotes and remotes:FindFirstChild('RequestTame_Neutral')\r\n                    local hungry = remotes and remotes:FindFirstChild('RequestTame_Hungry')\r\n                    local feed = remotes and remotes:FindFirstChild('RequestTame_Feed')\r\n                    local realAnimal = controller and controller.RealModel\r\n                    local function valid()\r\n                        return active(id) and animal and animal.Parent ~= nil and realAnimal and realAnimal.Parent ~= nil\r\n                    end\r\n                    if not neutral or not hungry or not valid() then return end\r\n                    neutral:FireServer(animal, realAnimal)\r\n                    task.wait(0.05)\r\n                    if not valid() then return end\r\n                    local clientModule\r\n                    pcall(function() clientModule = require(_LocalPlayer.PlayerScripts.Client) end)\r\n                    local head = _LocalPlayer.Character and _LocalPlayer.Character:FindFirstChild('Head')\r\n                    if head and clientModule and clientModule.Sound and type(clientModule.Sound.Play) == 'function' then\r\n                        pcall(clientModule.Sound.Play, 'FluteAlert', {\r\n                            Volume = 0.45, Replicate = true,\r\n                            ReplicationProperties = {Volume = 0.35, Instance = head}\r\n                        })\r\n                    end\r\n                    hungry:FireServer(animal, realAnimal)\r\n                    for _ = 1, 15 do\r\n                        if not valid() then return end\r\n                        if animal:GetAttribute('CurrentTamingState') == 'Hungry' then break end\r\n                        task.wait(0.1)\r\n                    end\r\n                    if not valid() or animal:GetAttribute('CurrentTamingState') ~= 'Hungry' then return end\r\n                    local items = _Workspace:FindFirstChild('Items')\r\n                    local inventory = _LocalPlayer:FindFirstChild('Inventory')\r\n                    local character = _LocalPlayer.Character\r\n                    for index = 1, 4 do\r\n                        if not valid() then return end\r\n                        local foodName = animal:GetAttribute('Food' .. index .. 'Type')\r\n                        if type(foodName) == 'string' and foodName ~= '' and animal:GetAttribute('Food' .. index .. 'Done') ~= true then\r\n                            local food = (items and items:FindFirstChild(foodName))\r\n                                or (character and character:FindFirstChild(foodName))\r\n                                or (inventory and inventory:FindFirstChild(foodName))\r\n                                or (items and items:FindFirstChild('Cooked ' .. foodName))\r\n                                or (character and character:FindFirstChild('Cooked ' .. foodName))\r\n                                or (inventory and inventory:FindFirstChild('Cooked ' .. foodName))\r\n                            if food and feed and feed:IsA('RemoteFunction') then\r\n                                pcall(function() feed:InvokeServer(animal, food, index) end)\r\n                            end\r\n                        end\r\n                    end\r\n                end)\r\n            end)\r\n            pcall(function() controller:StopTamingMinigame() end)\r\n        end\r\n        module.StartTamingMinigame = tamingPatch\r\n        return true\r\n    end\r\n\r\n    local function restoreTaming()\r\n        if tamingModule and tamingPatch and tamingModule.StartTamingMinigame == tamingPatch then\r\n            tamingModule.StartTamingMinigame = originalStart\r\n        end\r\n        tamingModule, tamingPatch, originalStart = nil, nil, nil\r\n    end\r\n\r\n    local function equippedFlute()\r\n        local client\r\n        pcall(function() client = require(_LocalPlayer.PlayerScripts.Client) end)\r\n        local handler = client and client.InventoryHandler\r\n        local getter = handler and handler.GetCurrentlyEquippedClass\r\n        if type(getter) ~= 'function' then return nil end\r\n        local ok, result = pcall(getter)\r\n        local model = ok and result and result.Model\r\n        if model and fluteNames[model.Name] and model:GetAttribute('ToolName') == 'Taming Flute' then return model end\r\n        return nil\r\n    end\r\n    local function fluteReady(flute)\r\n        local xp, cap = flute and flute:GetAttribute('XP'), flute and flute:GetAttribute('LevelUpXP')\r\n        return flute and fluteNames[flute.Name] and flute:GetAttribute('ToolName') == 'Taming Flute'\r\n            and type(xp) == 'number' and type(cap) == 'number' and cap > 0 and xp >= cap\r\n    end\r\n    local function upgradeFlute(id)\r\n        if isAnyCombatActive() or _G.KixHubAuraLock\r\n            or _G.AutoChopSelectedTreesActive or _G.AutoChopSelectedTreesRunning then return false end\r\n        local flute = equippedFlute()\r\n        if not fluteReady(flute) then return false end\r\n        local character = _LocalPlayer.Character\r\n        local root = character and character:FindFirstChild('HumanoidRootPart')\r\n        if not root then return false end\r\n        local collection = game:GetService('CollectionService')\r\n        local best, distance, prompt\r\n        local checked = 0\r\n        for _, bench in ipairs(collection:GetTagged('Interaction')) do\r\n            checked += 1\r\n            if checked % 32 == 0 then task.wait() end\r\n            if not active(id) then return false end\r\n            if bench:IsA('Model') and bench:IsDescendantOf(_Workspace) and bench.PrimaryPart then\r\n                local kind = bench:GetAttribute('Interaction')\r\n                local attachment = bench.PrimaryPart:FindFirstChild('ProximityAttachment')\r\n                local candidatePrompt = attachment and attachment:FindFirstChild('ProximityInteraction')\r\n                if (kind == 'TamingFluteUpgrade' or kind == 'ToolUpgradeBench') and candidatePrompt\r\n                    and candidatePrompt.Enabled and not bench:GetAttribute('Upgrading')\r\n                    and not bench:GetAttribute('LocalUpgrading') then\r\n                    local d = (root.Position - bench.PrimaryPart.Position).Magnitude\r\n                    if not distance or d < distance then best, distance, prompt = bench, d, candidatePrompt end\r\n                end\r\n            end\r\n        end\r\n        if not best or not active(id) or not fluteReady(flute) then return false end\r\n        local items = _Workspace:FindFirstChild('Items')\r\n        local targetName = nextFlute[flute.Name]\r\n        local spawnedFlute, itemConnection\r\n        local function matches(item)\r\n            return active(id) and item and item.Parent == items and item.Name == targetName\r\n                and item:GetAttribute('ToolName') == 'Taming Flute' and item:GetAttribute('Interaction') == 'Tool'\r\n                and (item:GetAttribute('Owner') == nil or item:GetAttribute('Owner') == _LocalPlayer.UserId)\r\n                and item:GetAttribute('L