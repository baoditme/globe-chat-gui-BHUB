ocal value = getHungerPercent()\r\n                    return type(value) == \"number\" and value >= 0 and value or nil\r\n                end\r\n                local function needsFood(hunger, character)\r\n                    if trackedCharacter ~= character then\r\n                        trackedCharacter, refilling = character, false\r\n                    end\r\n                    if type(hunger) ~= \"number\" or not character then\r\n                        refilling = false\r\n                    elseif hunger >= FOOD_TARGET then\r\n                        refilling = false\r\n                    elseif hunger <= FOOD_THRESHOLD then\r\n                        refilling = true\r\n                    end\r\n                    return refilling\r\n                end\r\n                local function canTeleportFood(item, folder, allowUnselected)\r\n                    if not item or item.Parent ~= folder or not item:IsA(\"Model\") then return false end\r\n                    local primary = item.PrimaryPart\r\n                    if not primary or item:GetAttribute(\"Interaction\") == nil then return false end\r\n                    if item:GetAttribute(\"Locked\") == true or item:GetAttribute(\"IceBlock\") == true then return false end\r\n                    if item:GetAttribute(\"FoodRot\") == true\r\n                        or (not allowUnselected and not selectedLookup[item.Name]) then return false end\r\n                    local owner = item:GetAttribute(\"Owner\")\r\n                    if owner ~= nil and owner ~= player.UserId then return false end\r\n                    if primary.Anchored and primary.CanCollide == false\r\n                        and primary.CanQuery == false and primary.CanTouch == false then\r\n                        for _, part in ipairs(item:GetDescendants()) do\r\n                            if part:IsA(\"BasePart\") and not (part.Anchored and part.CanCollide == false\r\n                                and part.CanQuery == false and part.CanTouch == false) then\r\n                                return true\r\n                            end\r\n                        end\r\n                        return false\r\n                    end\r\n                    return true\r\n                end\r\n                local function findFood(folder, stillActive)\r\n                    -- Selected Carrot Cake keeps its existing priority.\r\n                    local cakes = buckets[\"Carrot Cake\"]\r\n                    if selectedLookup[\"Carrot Cake\"] and cakes\r\n                        and os.clock() >= (tonumber(_G.KixAutoEatCarrotCakeRetryUntil) or 0) then\r\n                        for item in pairs(cakes) do\r\n                            if not budget() or not stillActive() then return nil end\r\n                            if canTeleportFood(item, folder)\r\n                                and os.clock() >= (retryAt[item] or 0)\r\n                                and not isItemHeldByAnotherPlayer(item, true) then\r\n                                return item\r\n                            end\r\n                        end\r\n                    end\r\n                    for _, name in ipairs(selectedFoods) do\r\n                        local bucket = buckets[name]\r\n                        if bucket then\r\n                            for item in pairs(bucket) do\r\n                                if not budget() or not stillActive() then return nil end\r\n                                if canTeleportFood(item, folder) and os.clock() >= (retryAt[item] or 0)\r\n                                    and not isItemHeldByAnotherPlayer(item, true) then\r\n                                    return item\r\n                                end\r\n                            end\r\n                        end\r\n                    end\r\n                    return nil\r\n                end\r\n                local function teleportFood(item, destination, folder, stillActive)\r\n                    local remotes = _ReplicatedStorage:FindFirstChild(\"RemoteEvents\")\r\n                    local startDrag = remotes and remotes:FindFirstChild(\"RequestStartDraggingItem\")\r\n                    local stopDrag = remotes and remotes:FindFirstChild(\"StopDraggingItem\")\r\n                    if not (startDrag and stopDrag) or not canTeleportFood(item, folder) then return false end\r\n                    if busyItems[item] then return false end\r\n                    busyItems[item] = true\r\n                    local itemParent, primary = item.Parent, item.PrimaryPart\r\n                    local started = pcall(function() startDrag:FireServer(item) end)\r\n                    local function valid()\r\n                        return started and stillActive() and item.Parent == itemParent and item.Parent == folder\r\n                            and item.PrimaryPart == primary and primary:IsDescendantOf(item)\r\n                            and canTeleportFood(item, folder)\r\n                    end\r\n                    local function ownershipConfirmed()\r\n                        if not valid() or primary.Anchored or item:GetAttribute(\"Owner\") ~= player.UserId then\r\n                            return false\r\n                        end\r\n                        local assemblies = {}\r\n                        for _, part in ipairs(item:GetDescendants()) do\r\n                            if part:IsA(\"BasePart\") then\r\n                                local assemblyRoot = part.AssemblyRootPart\r\n                                if not assemblyRoot or assemblyRoot.Anchored\r\n                                    or not assemblyRoot:IsDescendantOf(item) then\r\n                                    return false\r\n                                end\r\n                                if not assemblies[assemblyRoot] then\r\n                                    assemblies[assemblyRoot] = true\r\n                                    for _, connected in ipairs(part:GetConnectedParts(true)) do\r\n                                        if not connected:IsDescendantOf(item) then return false end\r\n                                    end\r\n                                    if type(getnetworkowner) == \"function\" then\r\n                                        local ownerOk, isLocalOwner = pcall(getnetworkowner, assemblyRoot)\r\n                                        if not ownerOk or isLocalOwner ~= true then return false end\r\n                                    end\r\n                                end\r\n                            end\r\n                        end\r\n                        return true\r\n                    end\r\n                    local deadline = os.clock() + 2\r\n                    local acquired = false\r\n                    while stillActive() and os.clock() < deadline do\r\n                        if ownershipConfirmed() then\r\n                            acquired = true\r\n                            break\r\n                        end\r\n                        task.wait(0.05)\r\n                    end\r\n                    local moved = false\r\n                    if acquired and valid() then\r\n                        moved = pcall(function() item:PivotTo(destination) end)\r\n                        if moved then task.wait(0.15) end\r\n                    end\r\n                    pcall(function() stopDrag:FireServer(item) end)\r\n                    busyItems[item] = nil\r\n                    return moved and valid()\r\n                end\r\n                local function cleanup()\r\n                    for _, connection in ipairs(folderConnections) do disconnect(connection) end\r\n                    for item, connection in pairs(itemConnections) do\r\n                        disconnect(connection)\r\n                        itemConnections[item] = nil\r\n                    end\r\n                    table.clear(buckets)\r\n                end\r\n\r\n                local remotes = _ReplicatedStorage:FindFirstChild(\"RemoteEvents\")\r\n                local consume = remotes and remotes:FindFirstChild(\"RequestConsumeItem\")\r\n                while active() and not consume do\r\n                    setFoodStatus(\"Waiting for RequestConsumeItem remote\")\r\n                    if not wait(0.5) then break end\r\n                    remotes = _ReplicatedStorage:FindFirstChild(\"RemoteEvents\")\r\n                    consume = remotes and remotes:FindFirstChild(\"RequestConsumeItem\")\r\n                end\r\n                while active() do\r\n                    if _G.KixAutoEatMode ~= \"Food\" then\r\n                        if _G.KixAutoEatMode == \"Switching\" or _G.KixAutoEatMode == \"Idle\" then\r\n                            _G.IsEating = false\r\n                        end\r\n                        if not wait(0.5) then break end\r\n                        continue\r\n                    end\r\n                    local currentFolder = workspace:FindFirstChild(\"Items\")\r\n                    if currentFolder ~= itemFolder then bindFolder(currentFolder) end\r\n                    local character = player.Character\r\n                    local root = character and character:FindFirstChild(\"HumanoidRootPart\")\r\n                    local hunger = getHunger()\r\n                    local shouldEat = needsFood(hunger, character)\r\n                    if type(hunger) ~= \"number\" or not root then\r\n                        setFoodStatus(\"Waiting for character and hunger data\")\r\n                    elseif not shouldEat then\r\n                        setFoodStatus(string.format(\"Hunger: %d%%\", hunger))\r\n                    elseif not itemFolder then\r\n                        setFoodStatus(\"Waiting for loaded food items\")\r\n                    else\r\n                        local function stillActive()\r\n                            return active() and player.Character == character and root.Parent ~= nil\r\n                                and _G.KixAutoEatMode == \"Food\"\r\n                                and workspace:FindFirstChild(\"Items\") == itemFolder\r\n                                and needsFood(getHunger(), character)\r\n                        end\r\n                        local food = findFood(itemFolder, stillActive)\r\n                        if food and stillActive() then\r\n                            setFoodStatus(\"Moving and consuming \" .. food.Name)\r\n                            _G.IsEating = true\r\n                            local moved = teleportFood(food, root.CFrame, itemFolder, stillActive)\r\n                            if moved and stillActive() and consume then\r\n                                local consumeOk, result = pcall(function()\r\n                                    if consume:IsA(\"RemoteFunction\") then return consume:InvokeServer(food) end\r\n                                    if consume:IsA(\"RemoteEvent\") then consume:FireServer(food); return true end\r\n                                    return false\r\n                                end)\r\n                                if consumeOk and (result == true or (type(result) == \"table\" and result.Success == true)) then\r\n                                    retryAt[food] = nil\r\n                                    if food.Name == \"Carrot Cake\" then\r\n                                        _G.KixAutoEatCarrotCakeRetryUntil = os.clock() + 1.5\r\n                                    end\r\n                                    setFoodStatus(\"Consumed \" .. food.Name .. \" | Hunger: \" .. tostring(getHunger() or \"--\") .. \"%\")\r\n                                else\r\n                                    retryAt[food] = os.clock() + 1.5\r\n                                    if food.Name == \"Carrot Cake\" then\r\n                                        _G.KixAutoEatCarrotCakeRetryUntil = os.clock() + 1.5\r\n                                    end\r\n                                    _G.KixPerfDebug.Count(\"AutoEatFoodConsumeFailed\")\r\n                                end\r\n                            else\r\n                                retryAt[food] = os.clock() + 1.5\r\n                                if food.Name == \"Carrot Cake\" then\r\n                                    _G.KixAutoEatCarrotCakeRetryUntil = os.clock() + 1.5\r\n                                end\r\n                                _G.KixPerfDebug.Count(\"AutoEatFoodMoveFailed\")\r\n                            end\r\n                            if _G.KixAutoEatMode == \"Food\" then _G.IsEating = false end\r\n                            if not wait(0.5) then break end\r\n                        else\r\n                            setFoodStatus(string.format(\"No eligible selected food | Hunger: %d%%\", hunger))\r\n                            if not wait(0.5) then break end\r\n                        end\r\n                    end\r\n                    if not wait(0.5) then break end\r\n                end\r\n                cleanup()\r\n                if _G.KixAutoEatMode == \"Food\" then _G.IsEating = false end\r\n            end)\r\n        end\r\n\r\n        _G.KixEngines.AutoEatFood = setAutoEatFood\r\n        _G.KixAdapters = _G.KixAdapters or {}\r\n        _G.KixAdapters.AutoEatFood = {\r\n            IsEnabled = function() return foodEnabled == true end,\r\n            SetState = setAutoEatFood,\r\n        }\r\n    end\r\n    INIT_AUTO_EAT_FRESH_FOOD()\r\nend\r\n\r\n-- One visible Auto Eat switch owns both modes and serializes them by inventory.\r\ndo\r\n    local function INIT_AUTO_EAT_COORDINATOR()\r\n        local stewEngine = _G.KixEngines.AutoEat\r\n        local coordinatorEnabled, coordinatorToken, activeMode = false, 0, \"Idle\"\r\n        _G.KixEngines.AutoEatStew = stewEngine\r\n\r\n        local function hasStewInInventoryOrHotbar()\r\n            local ok, keyCode, foodItem = pcall(getAutoEatFoodSlot)\r\n            return ok and (keyCode ~= nil or foodItem ~= nil)\r\n        end\r\n\r\n        local function hasEligibleCarrotCakeOnGround()\r\n            if not AUTO_EAT_SELECTED_ITEMS[\"Carrot Cake\"] then return false end\r\n            if os.clock() < (tonumber(_G.KixAutoEatCarrotCakeRetryUntil) or 0) then return false end\r\n            local items = workspace:FindFirstChild(\"Items\")\r\n            if not items then return false end\r\n            for _, cake in ipairs(items:GetChildren()) do\r\n                if cake.Name == \"Carrot Cake\" and cake:IsA(\"Model\") and cake.PrimaryPart\r\n                    and cake:GetAttribute(\"Interaction\") ~= nil and cake:GetAttribute(\"FoodRot\") ~= true\r\n                    and cake:GetAttribute(\"Locked\") ~= true and cake:GetAttribute(\"IceBlock\") ~= true then\r\n                    local owner = cake:GetAttribute(\"Owner\")\r\n                    if owner == nil or owner == _LocalPlayer.UserId then\r\n                        local held = false\r\n                        pcall(function() held = isItemHeldByAnotherPlayer(cake, true) end)\r\n                        if not held then return true end\r\n                    end\r\n                end\r\n            end\r\n            return false\r\n        end\r\n\r\n        local function setUnifiedAutoEat(value)\r\n            value = value == true\r\n            if value == coordinatorEnabled\r\n                and (not value or (_G.KixEngines.TaskCounts.AutoEatCoordinator or 0) > 0) then return end\r\n            coordinatorToken = coordinatorToken + 1\r\n            local token = coordinatorToken\r\n            coordinatorEnabled = value\r\n            autoEatEnabled = value\r\n\r\n            if not value then\r\n                activeMode = \"Idle\"\r\n                _G.KixAutoEatMode = \"Idle\"\r\n                _G.KixEngines.AutoEatFood(false)\r\n                stewEngine(false)\r\n                AutoEatStatus:SetDesc(\"Status: Disabled | Hunger: --\")\r\n                return\r\n            end\r\n\r\n            activeMode = \"Idle\"\r\n            _G.KixAutoEatMode = \"Idle\"\r\n            _G.KixEngines.AutoEatFood(true)\r\n            _G.KixEngines.Spawn(\"AutoEatCoordinator\", function()\r\n                while coordinatorEnabled and coordinatorToken == token do\r\n                    local nextMode\r\n                    if hasEligibleCarrotCakeOnGround() then\r\n                        nextMode = \"Food\"\r\n                    else\r\n                        nextMode = hasStewInInventoryOrHotbar() and \"Stew\" or \"Food\"\r\n                    end\r\n                    if nextMode ~= activeMode then\r\n                        _G.KixAutoEatMode = \"Switching\"\r\n                        if activeMode == \"Stew\" then stewEngine(false) end\r\n                        activeMode = nextMode\r\n                        _G.KixAutoEatMode = nextMode\r\n                        if nextMode == \"Stew\" then\r\n                            _G.IsEating = false\r\n                            stewEngine(true)\r\n                        end\r\n                    end\r\n                    task.wait(0.5)\r\n                end\r\n                if coordinatorToken == token then\r\n                    activeMode = \"Idle\"\r\n                    _G.KixAutoEatMode = \"Idle\"\r\n                    _G.KixEngines.AutoEatFood(false)\r\n                    stewEngine(false)\r\n                end\r\n            end)\r\n        end\r\n\r\n        _G.KixEngines.AutoEat = setUnifiedAutoEat\r\n        _G.KixAdapters = _G.KixAdapters or {}\r\n        _G.KixAdapters.AutoEat = {\r\n            IsEnabled = function() return coordinatorEnabled == true end,\r\n            SetState = setUnifiedAutoEat,\r\n        }\r\n    end\r\n    INIT_AUTO_EAT_COORDINATOR()\r\nend\r\n\r\nautoPickStewEnabled = false\r\n\r\n_G.KixEngines.AutoPickStew = function(val)\r\n    val = val == true\r\n    if val == (autoPickStewEnabled == true)\r\n        and (not val or (_G.KixEngines.TaskCounts.AutoPickStew or 0) > 0) then return end\r\n    _G.KixEngines.Errors.AutoPickStew = nil\r\n    _G.KixEngines.Tokens.AutoPickStew = (_G.KixEngines.Tokens.AutoPickStew or 0) + 1\r\n    local token = _G.KixEngines.Tokens.AutoPickStew\r\n    autoPickStewEnabled = val\r\n    if not val then return end\r\n\r\n    _G.KixEngines.Spawn(\"AutoPickStew\", function()\r\n        -- Indexed target discovery with a direct inventory pickup check.\r\n        -- A stew becomes eligible five seconds after its first observed spawn.\r\n        local firstSeenAt = setmetatable({}, {__mode = \"k\"})\r\n        local retryAfter = setmetatable({}, {__mode = \"k\"})\r\n        local orderedNames = {\"Stew\", \"Hearty Stew\", \"Pumpkin Soup\", \"Seafood Chowder\"}\r\n        local nameRank = {Stew = 1, [\"Hearty Stew\"] = 2, [\"Pumpkin Soup\"] = 3, [\"Seafood Chowder\"] = 4}\r\n        local stations, nextStationScan = {}, 0\r\n\r\n        local function isOwned(item)\r\n            if not item or not item.Parent then return false end\r\n            local player = _LocalPlayer\r\n            local character = player.Character\r\n            local inventory = player:FindFirstChild(\"Inventory\")\r\n            local backpack = player:FindFirstChild(\"Backpack\")\r\n            local itemBag = player:FindFirstChild(\"ItemBag\")\r\n            return (character and item:IsDescendantOf(character))\r\n                or (inventory and item:IsDescendantOf(inventory))\r\n                or (backpack and item:IsDescendantOf(backpack))\r\n                or (itemBag and item:IsDescendantOf(itemBag)) or false\r\n        end\r\n\r\n        local function ownerAllows(item)\r\n            local owner = item:GetAttribute(\"Owner\")\r\n            return owner == nil or owner == \"\" or owner == 0 or owner == \"0\"\r\n                or owner == _LocalPlayer.UserId\r\n                or tostring(owner) == tostring(_LocalPlayer.UserId)\r\n        end\r\n\r\n        local function validStew(item, allowPotChild)\r\n            if not item or not item.Parent or not item:IsA(\"Model\")\r\n                or not KixStewPickupNames[item.Name]\r\n                or item:GetAttribute(\"FoodRot\") == true\r\n                or item:GetAttribute(\"Locked\") == true\r\n                or item:GetAttribute(\"IceBlock\") == true\r\n                or not ownerAllows(item) then return false end\r\n            if _LocalPlayer:GetAttribute(\"Class\") == \"Bunny\"\r\n                and item:GetAttribute(\"HasMeat\") == true then return false end\r\n            if not allowPotChild then\r\n                local canMove = _G.KixItemTransportSystem and _G.KixItemTransportSystem.CanTeleport\r\n                if type(canMove) ~= \"function\" then return false end\r\n                local ok, result = pcall(canMove, item)\r\n                if not ok or result ~= true then return false end\r\n            end\r\n            return true\r\n        end\r\n\r\n        local function activeFor(item, parent)\r\n            return KixHubSession.Alive\r\n                and autoPickStewEnabled\r\n                and token == _G.KixEngines.Tokens.AutoPickStew\r\n                and not _G.KixRescueBusy\r\n                and not _G.KixHalloweenTrickBusy\r\n                and not _G.KixStewSpawnPending\r\n                and item.Parent == parent\r\n                and validStew(item, parent ~= workspace:FindFirstChild(\"Items\"))\r\n                and not isItemHeldByAnotherPlayer(item, true)\r\n        end\r\n\r\n        local function remember(item)\r\n            local now = os.clock()\r\n            local origin = KixStewSpawnOrigins[item]\r\n            if origin and origin.Ready == false then return nil end\r\n            local firstSeen = firstSeenAt[item]\r\n            if origin and origin.Ready and type(origin.Since) == \"number\" then\r\n                firstSeen = origin.Since\r\n                firstSeenAt[item] = firstSeen\r\n            elseif not firstSeen then\r\n                firstSeen = now\r\n                firstSeenAt[item] = firstSeen\r\n            end\r\n            return firstSeen\r\n        end\r\n\r\n        local function refreshStations()\r\n            if os.clock() < nextStationScan then return end\r\n            nextStationScan = os.clock() + 5\r\n            stations = {}\r\n            local collection = game:GetService(\"CollectionService\")\r\n            for _, station in ipairs(collection:GetTagged(\"Crockpot\")) do\r\n                local touchZone = station:FindFirstChild(\"TouchZone\")\r\n                if station:IsDescendantOf(workspace) and touchZone and touchZone:IsA(\"BasePart\")\r\n                    and (station.Name ~= \"Chefs Station\" or _LocalPlayer:GetAttribute(\"Class\") == \"Chef\") then\r\n                    stations[#stations + 1] = station\r\n                end\r\n            end\r\n        end\r\n\r\n        local function findCandidates(itemsFolder)\r\n            local candidates, seen = {}, setmetatable({}, {__mode = \"k\"})\r\n            local examined = 0\r\n            for _, name in ipairs(orderedNames) do\r\n                local bucket = _G.KixItemsIndex.GetByName(name)\r\n                for _, item in ipairs(bucket and bucket.Items or {}) do\r\n                    examined += 1\r\n                    if item.Parent == itemsFolder and validStew(item, false) then\r\n                        local since = remember(item)\r\n                        if since and not seen[item] then\r\n                            seen[item] = true\r\n                            candidates[#candidates + 1] = {\r\n                                Item = item, Parent = itemsFolder, Loose = true, Since = since\r\n                            }\r\n                        end\r\n                    end\r\n                    if examined % 48 == 0 then task.wait() end\r\n                    if not autoPickStewEnabled or token ~= _G.KixEngines.Tokens.AutoPickStew then\r\n                        return candidates\r\n                    end\r\n                end\r\n            end\r\n\r\n            refreshStations()\r\n            for _, station in ipairs(stations) do\r\n                for _, item in ipairs(station:GetDescendants()) do\r\n                    examined += 1\r\n                    if item:IsA(\"Model\") and KixStewPickupNames[item.Name]\r\n                        and validStew(item, true) then\r\n                        local since = remember(item)\r\n                        if since and not seen[item] then\r\n                            seen[item] = true\r\n                            candidates[#candidates + 1] = {\r\n                                Item = item, Parent = item.Parent, Loose = false, Since = since\r\n                            }\r\n                        end\r\n                    end\r\n                    if examined % 48 == 0 then task.wait() end\r\n                    if not autoPickStewEnabled or token ~= _G.KixEngines.Tokens.AutoPickStew then\r\n                        return candidates\r\n                    end\r\n                end\r\n            end\r\n            table.sort(candidates, function(a, b)\r\n                if a.Since ~= b.Since then return a.Since < b.Since end\r\n                return (nameRank[a.Item.Name] or 99) < (nameRank[b.Item.Name] or 99)\r\n            end)\r\n            return candidates\r\n        end\r\n\r\n        local function requestPickup(target, root, remote)\r\n            local item, parent = target.Item, target.Parent\r\n            local character = _LocalPlayer.Character\r\n            if not validStew(item, not target.Loose) or isOwned(item) then return false end\r\n            local function allowed()\r\n                return activeFor(item, parent)\r\n                    and _LocalPlayer.Character == character\r\n                    and root.Parent == character\r\n            end\r\n            local origin\r\n            pcall(function() origin = item:GetPivot() end)\r\n            target.Origin = origin\r\n            if target.Loose then\r\n                if not allowed() or not origin then return false end\r\n                local bring = _G.KixItemTransportSystem and _G.KixItemTransportSystem.Move\r\n                if type(bring) ~= \"function\" then return false end\r\n                local movedOk, moved = pcall(bring, item, root.CFrame, allowed)\r\n                if not movedOk or moved ~= true then return false end\r\n            end\r\n            if not allowed() then return false end\r\n\r\n            local before = setmetatable({}, {__mode = \"k\"})\r\n            local inventory = _LocalPlayer:FindFirstChild(\"Inventory\")\r\n            if inventory then\r\n                for _, held in ipairs(inventory:GetChildren()) do before[held] = true end\r\n            end\r\n\r\n            local callOk, result = pcall(function() return remote:InvokeServer(item) end)\r\n            local accepted = callOk and (result == true\r\n                or (type(result) == \"table\" and result.Success == true))\r\n            if not accepted then return false end\r\n\r\n            local deadline = os.clock() + 3\r\n            while os.clock() < deadline do\r\n                if isOwned(item) then return true end\r\n                if inventory then\r\n                    for _, held in ipairs(inventory:GetChildren()) do\r\n                        if held.Name == target.Item.Name and not before[held] then return true end\r\n                    end\r\n                end\r\n                if not autoPickStewEnabled or token ~= _G.KixEngines.Tokens.AutoPickStew then break end\r\n                task.wait(0.1)\r\n            end\r\n            return isOwned(item)\r\n        end\r\n\r\n        while autoPickStewEnabled and token == _G.KixEngines.Tokens.AutoPickStew do\r\n            local ok, err = pcall(function()\r\n                local itemsFolder = workspace:FindFirstChild(\"Items\")\r\n                local remoteEvents = _ReplicatedStorage:FindFirstChild(\"RemoteEvents\")\r\n                local requestHotbar = remoteEvents and remoteEvents:FindFirstChild(\"RequestHotbarItem\")\r\n                local character = _LocalPlayer.Character\r\n                local root = character and character:FindFirstChild(\"HumanoidRootPart\")\r\n                if not itemsFolder or not root or not requestHotbar\r\n                    or not requestHotbar:IsA(\"RemoteFunction\")\r\n                    or _G.KixRescueBusy or _G.KixHalloweenTrickBusy then return end\r\n\r\n                local now = os.clock()\r\n                for _, target in ipairs(findCandidates(itemsFolder)) do\r\n                    if not autoPickStewEnabled or token ~= _G.KixEngines.Tokens.AutoPickStew then break end\r\n                    local item = target.Item\r\n                    if item.Parent == target.Parent\r\n                        and now - target.Since >= 5\r\n                        and now >= (retryAfter[item] or 0)\r\n                        and not isOwned(item)\r\n                        and not isItemHeldByAnotherPlayer(item, true) then\r\n                        retryAfter[item] = now + 3\r\n                        _G.KixPerfDebug.Count(\"StewPickupAttempt\")\r\n                        local picked = requestPickup(target, root, requestHotbar)\r\n                        if picked then\r\n                            firstSeenAt[item] = nil\r\n                            retryAfter[item] = nil\r\n                            local origin = KixStewSpawnOrigins[item]\r\n                            if origin then\r\n                                origin.Ready = false\r\n                                origin.LastCollected = true\r\n                            end\r\n                            _G.KixPerfDebug.Count(\"StewPickupConfirmed\")\r\n                            break\r\n                        end\r\n                        _G.KixPerfDebug.Count(\"StewPickupRetry\")\r\n                        if target.Loose and item.Parent == itemsFolder and not isOwned(item) then\r\n                            -- The bring helper may have moved the bowl before the\r\n                            -- server rejected pickup; return it to its original spot.\r\n                            if target.Origin then\r\n                                local bring = _G.KixItemTransportSystem and _G.KixItemTransportSystem.Move\r\n                                if type(bring) == \"function\" then\r\n                                    pcall(bring, item, target.Origin, function()\r\n                                        return autoPickStewEnabled\r\n                                            and token == _G.KixEngines.Tokens.AutoPickStew\r\n                                            and item.Parent == itemsFolder\r\n                                            and ownerAllows(item)\r\n                                            and not isItemHeldByAnotherPlayer(item, true)\r\n                                    end)\r\n                                end\r\n                            end\r\n                        end\r\n                    end\r\n                end\r\n            end)\r\n            if not ok then\r\n                warn(\"[AutoPickStew] \" .. tostring(err))\r\n            end\r\n            task.wait(1)\r\n        end\r\n    end)\r\nend\r\n\r\n_G.KixStartupFeatures.Toggles.AutoPickStew = Tabs.Auto:Toggle({\r\n    Title = 'Auto Collect Stew',\r\n    Desc = 'Picks up Stew five seconds after they appear.',\r\n    Value = false,\r\n    Callback = function(value)\r\n        _G.KixStartupFeatures.Set(\"AutoPickStew\", value)\r\n    end\r\n})\r\n_G.KixStartupFeatures.Status.AutoPickStew = nil\r\n_G.KixAdapters.AutoPickStew = {\r\n    IsEnabled = function()\r\n        return autoPickStewEnabled == true\r\n    end,\r\n    SetState = function(state)\r\n        return _G.KixEngines.AutoPickStew(state)\r\n    end\r\n}\r\n\r\n\r\nTabs.Auto:Section({Title = 'Stronghold Auto-Farming', Icon = 'castle'})\r\n\r\ncustomReturnPos = customReturnPos or (KixHubSavedState and KixHubSavedState.customReturnPos)\r\n\r\nshTimerUI = Tabs.Auto:Paragraph({\r\n    Title = \"Stronghold Countdown\",\r\n    Desc = \"Status: Calculating...\"\r\n})\r\n\r\nlocal autoStrongholdToggle\r\nautoStrongholdToggle=Tabs.Auto:Toggle({\r\n    Title='💎 Auto Raid Stronghold',\r\n    Desc='Auto Raid Stronghold to get Diamonds and Auto clears Cultist attacks.',\r\n    Value=false,\r\n    Callback = function(value)\r\n        local controller = _G.KixFullAuto\r\n        if value == false and controller then\r\n            controller.Owned[\"AutoStronghold\"] = nil\r\n            if controller.Suspended then controller.Suspended[\"AutoStronghold\"] = nil end\r\n        end\r\n        return _G.KixEngines.AutoStronghold(value)\r\n    end\r\n})\r\n_G.AutoStrongholdToggle = autoStrongholdToggle\r\n\r\n_G.StrongholdReadySince = nil\r\n_G.StrongholdCountdownModel = nil\r\n_G.StrongholdCountdownSeen = false\r\n_G.StrongholdCountdownExpired = false\r\n_G.StrongholdCountdownAbsentReady = false\r\n_G.KixStrongholdMayStart = function()\r\n    local now = os.time()\r\n    local timerTick = tonumber(_G.LastStrongholdTimerTick)\r\n    local timerValue = tonumber(_G.LastStrongholdTimer)\r\n    local timerAge = timerTick and (now - timerTick) or math.huge\r\n    local stronghold = _Workspace:FindFirstChild(\"Map\")\r\n        and _Workspace.Map:FindFirstChild(\"Landmarks\")\r\n        and _Workspace.Map.Landmarks:FindFirstChild(\"Stronghold\")\r\n\r\n    -- Honour any observed cooldown. If this loaded model has no countdown,\r\n    -- the monitor may instead approve a stable, closed FinalGate state.\r\n    if not stronghold or _G.IsStrongholdRaidActive == true\r\n        or _G.StrongholdPreparingRaid == true or _G.StrongholdTransition == true\r\n        or _G.StrongholdCountdownModel ~= stronghold\r\n        or not ((_G.StrongholdCountdownSeen == true and _G.StrongholdCountdownExpired == true)\r\n            or _G.StrongholdCountdownAbsentReady == true) then\r\n        _G.ForceStrongholdRaid = false\r\n        _G.ManualStrongholdAttack = false\r\n        return false\r\n    end\r\n\r\n    if _G.StrongholdCountdownSeen == true then\r\n        if timerValue and timerAge >= 0 and timerAge <= 3.5 then\r\n            local remaining = timerValue - timerAge\r\n            if remaining > 0 then\r\n                _G.ForceStrongholdRaid = false\r\n                _G.ManualStrongholdAttack = false\r\n                return false\r\n            end\r\n        else\r\n            _G.ForceStrongholdRaid = false\r\n            _G.ManualStrongholdAttack = false\r\n            return false\r\n        end\r\n    end\r\n\r\n    return _G.StrongholdReadyToAttack == true\r\n        and type(_G.StrongholdReadySince) == \"number\"\r\n        and os.clock() - _G.StrongholdReadySince >= 1.5\r\n        and type(_G.StrongholdReadyStatusTick) == \"number\"\r\n        and os.clock() - _G.StrongholdReadyStatusTick <= 2.5\r\nend\r\n\r\nTabs.Auto:Button({\r\n    Title = \"Teleport to Diamond Chest\",\r\n    Callback = function()\r\n        local door = workspace:FindFirstChild('Map') and workspace.Map:FindFirstChild('Landmarks') and workspace.Map.Landmarks:FindFirstChild('Stronghold')\r\n        local hrp = _LocalPlayer.Character and _LocalPlayer.Character:FindFirstChild(\"HumanoidRootPart\")\r\n        if door and hrp then\r\n            local offset = CFrame.new(38.94384765625, 50.49998982651367, 83.10482788085938) * CFrame.Angles(3.624660962486814e-07, 1.52613555638504028, -3.836555171092687e-07)\r\n            hrp.CFrame = door:GetPivot() * offset\r\n            if WindUI then WindUI:Notify({Title=\"Teleport\", Content=\"Teleported to Diamond Chest location!\", Duration=3}) end\r\n        else\r\n            if WindUI then WindUI:Notify({Title=\"Error\", Content=\"Stronghold has not loaded yet!\", Duration=3}) end\r\n        end\r\n    end\r\n})\r\n\r\ntask.spawn(function()\r\n    while KixHubSession.Alive and task.wait(1) do\r\n        pcall(function()\r\n            local statusText = \"Gate is Closed (Visit the Stronghold to Load the Map)\"\r\n            local stronghold = _Workspace:FindFirstChild(\"Map\") and _Workspace.Map:FindFirstChild(\"Landmarks\") and _Workspace.Map.Landmarks:FindFirstChild(\"Stronghold\")\r\n            local raidInProgress = _G.IsStrongholdRaidActive == true\r\n                or _G.StrongholdPreparingRaid == true or _G.StrongholdTransition == true\r\n\r\n            if _G.StrongholdCountdownModel ~= stronghold then\r\n                _G.StrongholdCountdownModel = stronghold\r\n                _G.StrongholdCountdownSeen = false\r\n                _G.StrongholdCountdownExpired = false\r\n                _G.StrongholdCountdownAbsentReady = false\r\n                _G.LastStrongholdTimer = nil\r\n                _G.LastStrongholdTimerTick = nil\r\n                _G.StrongholdReadyToAttack = false\r\n                _G.StrongholdReadySince = nil\r\n            end\r\n\r\n            if raidInProgress then\r\n                _G.StrongholdCountdownSeen = false\r\n                _G.StrongholdCountdownExpired = false\r\n                _G.StrongholdCountdownAbsentReady = false\r\n                _G.LastStrongholdTimer = nil\r\n                _G.LastStrongholdTimerTick = nil\r\n                _G.StrongholdReadyToAttack = false\r\n                _G.StrongholdReadySince = nil\r\n                statusText = \"RAIDING\"\r\n            end\r\n            \r\n            if stronghold and not raidInProgress then\r\n                local foundTimer = false\r\n                local countdownValue = nil\r\n                for _, v in ipairs(stronghold:GetDescendants()) do\r\n                    if v:IsA(\"TextLabel\") and v.Visible and (string.match(v.Text, \"%d+m\") or string.match(v.Text, \"%d+s\")) and not string.match(v.Text, \"%d+h\") then\r\n                        local parentGUI = v:FindFirstAncestorWhichIsA(\"BillboardGui\") or v:FindFirstAncestorWhichIsA(\"SurfaceGui\")\r\n                        if parentGUI and not parentGUI.Enabled then continue end\r\n                        \r\n                        local totalSecs = nil\r\n                        local mStr, sStr = string.match(v.Text, \"(%d+)m.*(%d+)s\")\r\n                        if mStr and sStr then\r\n                            totalSecs = tonumber(mStr) * 60 + tonumber(sStr)\r\n                        else\r\n                            local sOnly = string.match(v.Text, \"(%d+)s\")\r\n                            local mOnly = string.match(v.Text, \"(%d+)m\")\r\n                            if sOnly then\r\n                                totalSecs = tonumber(sOnly)\r\n                            elseif mOnly then\r\n                                totalSecs = tonumber(mOnly) * 60\r\n                            end\r\n                        end\r\n                        \r\n                        if totalSecs then\r\n                            foundTimer = true\r\n                            countdownValue = totalSecs\r\n                            _G.StrongholdCountdownSeen = true\r\n                            _G.StrongholdCountdownExpired = totalSecs <= 0\r\n                            _G.StrongholdCountdownAbsentReady = false\r\n                            _G.LastStrongholdTimer = totalSecs\r\n                            _G.LastStrongholdTimerTick = os.time()\r\n                            if totalSecs <= 1 then\r\n                                if not _G.GateOpenTime or (os.time() - _G.GateOpenTime > 370) then\r\n                                    _G.GateOpenTime = os.time()\r\n                                end\r\n                            elseif totalSecs > 1 then\r\n                                _G.GateOpenTime = nil\r\n                            end\r\n                        end\r\n                        break\r\n                    end\r\n                end\r\n\r\n                local cachedRemaining = nil\r\n                if _G.StrongholdCountdownSeen == true\r\n                    and _G.StrongholdCountdownModel == stronghold\r\n                    and _G.LastStrongholdTimer\r\n                    and _G.LastStrongholdTimerTick then\r\n                    cachedRemaining = math.max(0, _G.LastStrongholdTimer - (os.time() - _G.LastStrongholdTimerTick))\r\n                    _G.LastStrongholdTimer = cachedRemaining\r\n                    _G.LastStrongholdTimerTick = os.time()\r\n                    _G.StrongholdCountdownExpired = cachedRemaining <= 0\r\n                end\r\n\r\n                if foundTimer and countdownValue and countdownValue > 0 then\r\n                    statusText = string.format(\"Opens in: %dm %ds\", math.floor(countdownValue / 60), countdownValue % 60)\r\n                else\r\n                    local functional = stronghold:FindFirstChild(\"Functional\")\r\n                    local finalGate = functional and functional:FindFirstChild(\"FinalGate\")\r\n                    local gateCheckOK, gateIsOpen = false, false\r\n                    if finalGate then\r\n                        gateCheckOK, gateIsOpen = pcall(function()\r\n                            local relativeCF = stronghold:GetPivot():ToObjectSpace(finalGate:GetPivot())\r\n                            return relativeCF.Position.Y >= 58.5\r\n                        end)\r\n                    end\r\n\r\n                    if gateCheckOK and gateIsOpen then\r\n                        _G.StrongholdCountdownAbsentReady = false\r\n                        statusText = \"STRONGHOLD CLEAR! Waiting...\"\r\n                        if not _G.StrongholdClearAmmoTimerStarted then\r\n                            _G.StrongholdClearAmmoTimerStarted = true\r\n                            _G.StrongholdClearAmmoDeadline = os.clock() + 600\r\n                        end\r\n                    elseif _G.StrongholdCountdownSeen == true\r\n                        and _G.StrongholdCountdownExpired == true\r\n                        and cachedRemaining ~= nil then\r\n                        _G.StrongholdClearAmmoTimerStarted = false\r\n                        statusText = \"STRONGHOLD READY TO ATTACK!\"\r\n                    elseif _G.StrongholdCountdownSeen == true and cachedRemaining then\r\n                        statusText = string.format(\"Opens in: %dm %ds\", math.floor(cachedRemaining / 60), cachedRemaining % 60)\r\n                    else\r\n                        if finalGate and gateCheckOK and not gateIsOpen then\r\n                            _G.StrongholdCountdownAbsentReady = true\r\n                            _G.StrongholdClearAmmoTimerStarted = false\r\n                            statusText = \"STRONGHOLD READY TO ATTACK!\"\r\n                        else\r\n                            _G.StrongholdCountdownAbsentReady = false\r\n                            statusText = finalGate and \"Waiting for Stronghold countdown...\" or \"Visit the Stronghold to Load the Map\"\r\n                        end\r\n                    end\r\n                end\r\n            elseif not stronghold then\r\n                statusText = \"None\"\r\n            end\r\n            \r\n            getgenv().HUD_Stronghold_Text = statusText\r\n            local readyNow = statusText == \"STRONGHOLD READY TO ATTACK!\"\r\n            if readyNow then\r\n                if _G.StrongholdReadyToAttack ~= true then\r\n                    _G.StrongholdReadySince = os.clock()\r\n                end\r\n            else\r\n                _G.StrongholdReadySince = nil\r\n                _G.GateOpenTime = nil\r\n            end\r\n            _G.StrongholdReadyToAttack = readyNow\r\n            _G.StrongholdReadyStatusTick = os.clock()\r\n            if shTimerUI and shTimerUI.SetDesc then\r\n                shTimerUI:SetDesc(statusText)\r\n            end\r\n        end)\r\n    end\r\nend)\r\n\r\nTabs.Auto:Button({\r\n    Title = '📍 Set Return Position', \r\n    Desc = 'Where to wait & return to after looting Diamonds. Default: Campfire', \r\n    Callback = function()\r\n        local hrp = _LocalPlayer.Character and _LocalPlayer.Character:FindFirstChild(\"HumanoidRootPart\")\r\n        if hrp then \r\n            customReturnPos = hrp.Position\r\n            KixHubSavedState.customReturnPos = customReturnPos\r\n            WindUI:Notify({Title=\"Saved\", Content=\"Return position saved successfully!\"}) \r\n        end\r\n    end\r\n})\r\n\r\ngetgenv().KixHub_Stronghold_ToggleID = 0\r\n\r\nTabs.Auto:Button({\r\n    Title = '⚔️ Instant Attack When Ready',\r\n\r\n    Desc = 'Use this to Force Raid Stronghold when STRONGHOLD READY TO ATTACK. Turn on Auto Raid Stronghold first before using this feature.',\r\n\r\n    Callback = function()\r\n\r\n        -- =====================================================\r\n        -- RESET MANUAL FLAGS\r\n        -- =====================================================\r\n\r\n        _G.ForceStrongholdRaid = false\r\n        _G.ManualStrongholdAttack = false\r\n\r\n        -- =====================================================\r\n        -- 1. FIND STRONGHOLD\r\n        -- =====================================================\r\n\r\n        local map =\r\n            _Workspace:FindFirstChild(\"Map\")\r\n\r\n        local landmarks =\r\n            map\r\n            and map:FindFirstChild(\"Landmarks\")\r\n\r\n        local stronghold =\r\n            landmarks\r\n            and landmarks:FindFirstChild(\"Stronghold\")\r\n\r\n        if not stronghold then\r\n\r\n            if WindUI then\r\n                WindUI:Notify({\r\n                    Title = \"Stronghold Not Loaded\",\r\n                    Content = \"Please visit the Stronghold first to load its map, then try Instant Attack again.\",\r\n                    Duration = 15\r\n                })\r\n            end\r\n\r\n            return\r\n        end\r\n\r\n        -- ===================================