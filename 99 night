n return false end\r\n        local ok, descendants = pcall(function() return model:GetDescendants() end)\r\n        if not ok then return false end\r\n        for _, item in ipairs(descendants) do\r\n            if item:IsA(\"BasePart\") and not processed(item) then return false end\r\n        end\r\n        return true\r\n    end\r\n    local function scrapperPosition()\r\n        local map = workspace:FindFirstChild(\"Map\")\r\n        local campground = map and map:FindFirstChild(\"Campground\")\r\n        local scrapper = campground and campground:FindFirstChild(\"Scrapper\")\r\n        if scrapper then local ok, pivot = pcall(function() return scrapper:GetPivot() end); if ok then return pivot.Position end end\r\n        return nil\r\n    end\r\n    local function setDigestingScrap(on)\r\n        digestEnabled = on == true\r\n        digestToken += 1\r\n        local token = digestToken\r\n        if not digestEnabled then\r\n            if digestConnection then digestConnection:Disconnect(); digestConnection = nil end\r\n            return\r\n        end\r\n        local items = workspace:FindFirstChild(\"Items\")\r\n        task.spawn(function()\r\n            while alive() and digestEnabled and token == digestToken and not items do task.wait(1); items = workspace:FindFirstChild(\"Items\") end\r\n            if not items or not alive() or token ~= digestToken then return end\r\n            local function inspect(model, retryAllowed)\r\n                task.delay(retryAllowed and 0.2 or 0, function()\r\n                    if not alive() or not digestEnabled or token ~= digestToken or not model.Parent then return end\r\n                    local center = scrapperPosition()\r\n                    local ok, pivot = pcall(function() return model:GetPivot() end)\r\n                    if not center or not ok then return end\r\n                    local delta = pivot.Position - center\r\n                    if Vector3.new(delta.X, 0, delta.Z).Magnitude > 12 then return end\r\n                    if isDigesting(model) then\r\n                        pcall(function() model:Destroy() end)\r\n                    elseif retryAllowed then\r\n                        inspect(model, false)\r\n                    end\r\n                end)\r\n            end\r\n            digestConnection = items.ChildAdded:Connect(function(model) inspect(model, true) end)\r\n            local count = 0\r\n            for _, model in ipairs(items:GetChildren()) do\r\n                if not alive() or token ~= digestToken then return end\r\n                inspect(model, false); count += 1\r\n                if count % 64 == 0 then task.wait() end\r\n            end\r\n        end)\r\n    end\r\n\r\n    -- Muting rain keeps the emitter alive and restores its original Rate when disabled.\r\n    local rainEnabled, rainRoot, rainConnection = false, nil, nil\r\n    local rainState, rainFolderConnections = setmetatable({}, {__mode = \"k\"}), {}\r\n    local function restoreRainEmitter(emitter)\r\n        local state = rainState[emitter]\r\n        if not state then return end\r\n        rainState[emitter] = nil\r\n        if state.rateConnection then pcall(function() state.rateConnection:Disconnect() end) end\r\n        if state.ancestryConnection then pcall(function() state.ancestryConnection:Disconnect() end) end\r\n        pcall(function() emitter.Rate = state.rate end)\r\n    end\r\n    local function stopRainRoot()\r\n        if rainConnection then rainConnection:Disconnect(); rainConnection = nil end\r\n        for emitter in pairs(rainState) do restoreRainEmitter(emitter) end\r\n        rainRoot = nil\r\n    end\r\n    local function bindRainEmitter(emitter)\r\n        if not rainEnabled or not emitter:IsA(\"ParticleEmitter\") or rainState[emitter] then return end\r\n        local parent, grand = emitter.Parent, emitter.Parent and emitter.Parent.Parent\r\n        local valid = grand and grand.Name == \"RainEmitter\" and grand == rainRoot\r\n            and ((parent.Name == \"RainEmitter\" and emitter.Name:sub(1, 5) == \"Rain_\")\r\n                or (parent.Name == \"RainEmitterOLD\" and emitter.Name == \"ParticleEmitterRain\"))\r\n        if not valid then return end\r\n        local state = {rate = emitter.Rate}; rainState[emitter] = state\r\n        state.rateConnection = emitter:GetPropertyChangedSignal(\"Rate\"):Connect(function()\r\n            if rainEnabled and rainState[emitter] == state and emitter.Rate ~= 0 then state.rate = emitter.Rate; emitter.Rate = 0; emitter:Clear() end\r\n        end)\r\n        state.ancestryConnection = emitter.AncestryChanged:Connect(function()\r\n            if not emitter.Parent or not rainRoot or not emitter:IsDescendantOf(rainRoot) then restoreRainEmitter(emitter) end\r\n        end)\r\n        emitter.Rate = 0; emitter:Clear()\r\n    end\r\n    local function bindRainRoot(root)\r\n        if root == rainRoot then return end\r\n        stopRainRoot(); rainRoot = root\r\n        if not root then return end\r\n        rainConnection = root.DescendantAdded:Connect(bindRainEmitter)\r\n        for _, item in ipairs(root:GetDescendants()) do bindRainEmitter(item) end\r\n    end\r\n    local function setHideRain(on)\r\n        rainEnabled = on == true\r\n        if not rainEnabled then\r\n            stopRainRoot()\r\n            for _, c in ipairs(rainFolderConnections) do c:Disconnect() end\r\n            table.clear(rainFolderConnections)\r\n            return\r\n        end\r\n        local function findRoot() bindRainRoot(workspace:FindFirstChild(\"Particles\")) end\r\n        table.insert(rainFolderConnections, workspace.ChildAdded:Connect(function(child) if child.Name == \"Particles\" then findRoot() end end))\r\n        table.insert(rainFolderConnections, workspace.ChildRemoved:Connect(function(child) if child == rainRoot then findRoot() end end))\r\n        findRoot()\r\n    end\r\n\r\n    -- Graphics toggles use property snapshots and only revert a property if it still has our applied value.\r\n    local function setGraphics(key, on)\r\n        local category = \"Graphics:\" .. key\r\n        graphicsEnabled[key] = on == true\r\n        if not on then\r\n            if key == \"stop3DRendering\" then pcall(function() RunService:Set3dRenderingEnabled(true) end) end\r\n            for _, c in ipairs(graphicsLinks[key] or {}) do pcall(function() c:Disconnect() end) end\r\n            graphicsLinks[key] = nil\r\n            restoreCategory(category)\r\n            return\r\n        end\r\n        if key == \"disableShadows\" then\r\n            patchProperty(Lighting, \"GlobalShadows\", false, category)\r\n        elseif key == \"removePostEffects\" then\r\n            local function apply(instance)\r\n                if not graphicsEnabled[key] then return end\r\n                for _, className in ipairs({\"BloomEffect\", \"BlurEffect\", \"SunRaysEffect\", \"DepthOfFieldEffect\"}) do\r\n                    if safeIs(instance, className) then\r\n                        patchProperty(instance, className == \"BloomEffect\" and \"Intensity\" or \"Enabled\", className == \"BloomEffect\" and 0 or false, category)\r\n                        return\r\n                    end\r\n                end\r\n            end\r\n            local function bindRoot(root)\r\n                if not root then return end\r\n                for _, item in ipairs(root:GetChildren()) do apply(item) end\r\n                table.insert(graphicsLinks[key], root.ChildAdded:Connect(apply))\r\n            end\r\n            graphicsLinks[key] = {}\r\n            bindRoot(Lighting); bindRoot(workspace.CurrentCamera)\r\n            table.insert(graphicsLinks[key], workspace:GetPropertyChangedSignal(\"CurrentCamera\"):Connect(function()\r\n                if not graphicsEnabled[key] then return end\r\n                for _, c in ipairs(graphicsLinks[key] or {}) do pcall(function() c:Disconnect() end) end\r\n                graphicsLinks[key] = {}\r\n                bindRoot(Lighting); bindRoot(workspace.CurrentCamera)\r\n            end))\r\n        elseif key == \"simpleLighting\" then\r\n            if type(sethiddenproperty) == \"function\" or pcall(function() return Lighting.Technology end) then\r\n                patchProperty(Lighting, \"Technology\", Enum.Technology.Voxel, category, type(sethiddenproperty) == \"function\" and \"hidden\" or \"normal\")\r\n            end\r\n        elseif key == \"lowestGraphicsQuality\" then\r\n            pcall(function() patchProperty(settings():GetService(\"Rendering\"), \"QualityLevel\", Enum.QualityLevel.Level01, category) end)\r\n            pcall(function() patchProperty(UserSettings():GetService(\"UserGameSettings\"), \"SavedQualityLevel\", Enum.SavedQualitySetting.QualityLevel1, category) end)\r\n        elseif key == \"stop3DRendering\" then\r\n            pcall(function() RunService:Set3dRenderingEnabled(true) end)\r\n            pcall(function() RunService:Set3dRenderingEnabled(false) end)\r\n        end\r\n    end\r\n\r\n    local function optionSet(value)\r\n        local result = {}\r\n        if type(value) == \"table\" then for _, name in ipairs(value) do if name == \"All\" then for _, item in ipairs(optionValues) do if item ~= \"All\" then result[item] = true end end; return result elseif table.find(optionValues, name) and name ~= \"All\" then result[name] = true end end end\r\n        return result\r\n    end\r\n    local function applies(instance, option)\r\n        if option == \"Shadows\" then return safeIs(instance, \"BasePart\") end\r\n        if option == \"Materials\" then return safeIs(instance, \"BasePart\") end\r\n        if option == \"Mesh Fidelity\" then return safeIs(instance, \"MeshPart\") end\r\n        if option == \"Post Effects\" then return safeIs(instance, \"PostEffect\") end\r\n        if option == \"Atmosphere\" then return safeIs(instance, \"Atmosphere\") end\r\n        if option == \"Water\" then return safeIs(instance, \"Terrain\") end\r\n        return option == \"Particles\" and (safeIs(instance, \"ParticleEmitter\") or safeIs(instance, \"Trail\") or safeIs(instance, \"Beam\") or safeIs(instance, \"Fire\") or safeIs(instance, \"Smoke\") or safeIs(instance, \"Sparkles\"))\r\n    end\r\n    local function applyBoosterInstance(instance, options)\r\n        if not instance or not instance.Parent or (_LocalPlayer.Character and (instance == _LocalPlayer.Character or instance:IsDescendantOf(_LocalPlayer.Character))) then return end\r\n        for option in pairs(options) do\r\n            if applies(instance, option) then\r\n                local category = \"Booster:\" .. option\r\n                if option == \"Shadows\" then patchProperty(instance, \"CastShadow\", false, category)\r\n                elseif option == \"Materials\" then patchProperty(instance, \"Material\", Enum.Material.SmoothPlastic, category); patchProperty(instance, \"Reflectance\", 0, category)\r\n                elseif option == \"Mesh Fidelity\" then patchProperty(instance, \"RenderFidelity\", Enum.RenderFidelity.Performance, category)\r\n                elseif option == \"Post Effects\" then patchProperty(instance, safeIs(instance, \"BloomEffect\") and \"Intensity\" or \"Enabled\", safeIs(instance, \"BloomEffect\") and 0 or false, category)\r\n                elseif option == \"Atmosphere\" then patchProperty(instance, \"Density\", 0, category); patchProperty(instance, \"Haze\", 0, category); patchProperty(instance, \"Glare\", 0, category)\r\n                elseif option == \"Water\" then patchProperty(instance, \"WaterWaveSize\", 0, category); patchProperty(instance, \"WaterWaveSpeed\", 0, category); patchProperty(instance, \"WaterReflectance\", 0, category); patchProperty(instance, \"WaterTransparency\", 1, category)\r\n                elseif option == \"Particles\" then patchProperty(instance, \"Enabled\", false, category) end\r\n            end\r\n        end\r\n    end\r\n    local function setQualityForBooster(on)\r\n        if on and selectedOptions[\"Graphics Quality\"] then\r\n            patchProperty(settings():GetService(\"Rendering\"), \"QualityLevel\", Enum.QualityLevel.Level01, \"Booster:Graphics Quality\")\r\n            patchProperty(UserSettings():GetService(\"UserGameSettings\"), \"SavedQualityLevel\", Enum.SavedQualitySetting.QualityLevel1, \"Booster:Graphics Quality\")\r\n        else restoreCategory(\"Booster:Graphics Quality\") end\r\n    end\r\n    local function queueBoosterScan(generation)\r\n        for _, c in ipairs(boosterLinks) do pcall(function() c:Disconnect() end) end\r\n        table.clear(boosterLinks)\r\n        local count, started, running = 0, os.clock(), false\r\n        local roots = {workspace, Lighting}\r\n        local queue, head, tail = {}, 1, 0\r\n        local queued = setmetatable({}, {__mode = \"k\"})\r\n        local startWorker\r\n        local function enqueue(instance)\r\n            if not instance or queued[instance] then return end\r\n            queued[instance] = true; tail += 1; queue[tail] = instance\r\n            if startWorker then startWorker() end\r\n        end\r\n        startWorker = function()\r\n            if running or not alive() or not boosterEnabled or boosterGeneration ~= generation then return end\r\n            running = true\r\n            task.spawn(function()\r\n                while head <= tail and alive() and boosterEnabled and boosterGeneration == generation do\r\n                    local item = queue[head]; queue[head] = nil; head += 1\r\n                    applyBoosterInstance(item, selectedOptions)\r\n                    local ok, children = pcall(function() return item:GetChildren() end)\r\n                    if ok then for _, child in ipairs(children) do enqueue(child) end end\r\n                    count += 1\r\n                    if count % 64 == 0 or os.clock() - started >= 0.002 then\r\n                        setStatus(string.format(\"Scanning world: %d instances checked\", count)); task.wait(); started = os.clock()\r\n                    end\r\n                end\r\n                running = false\r\n                if head <= tail and alive() and boosterEnabled and boosterGeneration == generation then startWorker() end\r\n                if head > tail and alive() and boosterEnabled and boosterGeneration == generation then\r\n                    setStatus(string.format(\"Done: %d instances checked; new instances are handled as they appear\", count))\r\n                end\r\n            end)\r\n        end\r\n        for _, root in ipairs(roots) do table.insert(boosterLinks, root.DescendantAdded:Connect(enqueue)) end\r\n        for _, root in ipairs(roots) do enqueue(root) end\r\n    end\r\n    local function setBooster(on)\r\n        boosterEnabled = on == true; boosterGeneration += 1\r\n        local generation = boosterGeneration\r\n        for _, c in ipairs(boosterLinks) do pcall(function() c:Disconnect() end) end\r\n        table.clear(boosterLinks)\r\n        if not boosterEnabled then\r\n            for _, option in ipairs(optionValues) do if option ~= \"All\" then restoreCategory(\"Booster:\" .. option) end end\r\n            setStatus(\"Off — visual changes restored\")\r\n            return\r\n        end\r\n        for _, option in ipairs(optionValues) do if option ~= \"All\" and not selectedOptions[option] then restoreCategory(\"Booster:\" .. option) end end\r\n        setQualityForBooster(true)\r\n        local hasWorldReduction = false\r\n        for option in pairs(selectedOptions) do if option ~= \"Graphics Quality\" then hasWorldReduction = true; break end end\r\n        if not hasWorldReduction then setStatus(\"On: no world reductions selected\"); return end\r\n        setStatus(\"Queued: applying reductions\")\r\n        queueBoosterScan(generation)\r\n    end\r\n    local function setBoosterOptions(value)\r\n        local nextOptions = optionSet(value)\r\n        for option in pairs(selectedOptions) do if not nextOptions[option] then restoreCategory(\"Booster:\" .. option) end end\r\n        selectedOptions = nextOptions\r\n        if boosterEnabled then setQualityForBooster(true); setBooster(true) end\r\n    end\r\n\r\n    local fpsOriginal, fpsApplied = nil, nil\r\n    local function setFPSCap(value)\r\n        value = tonumber(value) or 0\r\n        value = value <= 0 and 0 or math.clamp(math.floor(value + 0.5), 10, 240)\r\n        if value == 0 then\r\n            if fpsApplied and type(setfpscap) == \"function\" then pcall(setfpscap, fpsOriginal or 60) end\r\n            fpsApplied, fpsOriginal = nil, nil\r\n            return\r\n        end\r\n        if type(setfpscap) ~= \"function\" then setStatus(\"FPS Cap unavailable: executor has no setfpscap\"); return end\r\n        if not fpsApplied and type(getfpscap) == \"function\" then local ok, old = pcall(getfpscap); if ok and type(old) == \"number\" then fpsOriginal = old end end\r\n        if pcall(setfpscap, value) then fpsApplied = value; setStatus(\"FPS cap set to \" .. value) else setStatus(\"FPS Cap failed: executor blocked setfpscap\") end\r\n    end\r\n\r\n    Tabs.Optimization:Section({Title = \"Game Code\", Desc = \"Hentikan beberapa pekerjaan berulang milik game.\", Icon = \"cpu\"})\r\n    Tabs.Optimization:Toggle({Title = \"Stop Light Flicker\", Desc = \"Matikan worker lampu berkedip lewat tag FlickeringPart. Default ON.\", Value = true, Callback = setLightFlicker})\r\n    Tabs.Optimization:Toggle({Title = \"Stop Windmill Spin\", Desc = \"Hentikan animasi bilah windmill dengan tag game; tag dipulihkan saat toggle dimatikan. Default: ON.\", Value = true, Callback = setWindmill})\r\n    Tabs.Optimization:Toggle({Title = \"Skip Unused Light Check\", Desc = \"Unbind pemeriksaan UpdatePlayerInLight dan mencoba lagi setelah 15 detik. Perubahan game bisa memerlukan rejoin. Default: ON.\", Value = true, Callback = setSkipLightCheck})\r\n    Tabs.Optimization:Toggle({Title = \"Hide Costume Outlines\", Desc = \"Matikan scan outline kostum lewat tag HighlightedCostumePiece. Default: ON.\", Value = true, Callback = setCostumeOutlines})\r\n    Tabs.Optimization:Toggle({Title = \"Delete Digesting Scrap\", Desc = \"Hapus duplikat scrap yang terdeteksi sedang diproses di sekitar Scrapper; scrap hasil tetap dihitung. Default: ON.\", Value = true, Callback = setDigestingScrap})\r\n    Tabs.Optimization:Section({Title = \"Graphics\", Desc = \"Perubahan visual lokal yang dapat dikembalikan saat dimatikan.\", Icon = \"sun-dim\"})\r\n    Tabs.Optimization:Toggle({Title = \"Disable Shadows\", Desc = \"Matikan GlobalShadows. Default: OFF.\", Value = false, Callback = function(v) setGraphics(\"disableShadows\", v) end})\r\n    Tabs.Optimization:Toggle({Title = \"Remove Post Effects\", Desc = \"Nonaktifkan Bloom, Blur, Sun Rays, dan Depth of Field, termasuk efek baru. Default: OFF.\", Value = false, Callback = function(v) setGraphics(\"removePostEffects\", v) end})\r\n    Tabs.Optimization:Toggle({Title = \"Simple Lighting\", Desc = \"Ubah Lighting Technology ke Voxel bila executor mengizinkan. Nilai awal dipulihkan saat dimatikan. Default: OFF.\", Value = false, Callback = function(v) setGraphics(\"simpleLighting\", v) end})\r\n    Tabs.Optimization:Toggle({Title = \"Lowest Graphics Quality\", Desc = \"Turunkan level kualitas Roblox ke 1 dan pulihkan nilai awal saat dimatikan. Default: OFF.\", Value = false, Callback = function(v) setGraphics(\"lowestGraphicsQuality\", v) end})\r\n    Tabs.Optimization:Toggle({Title = \"Stop 3D Rendering\", Desc = \"Hentikan gambar dunia 3D untuk penggunaan AFK; menu tetap terlihat. Default: OFF.\", Value = false, Callback = function(v) setGraphics(\"stop3DRendering\", v) end})\r\n    Tabs.Optimization:Slider({Title = \"FPS Cap\", Desc = \"0 = off; 10–240 membatasi FPS jika executor mendukung setfpscap.\", Step = 1, IsTextbox = true, Value = {Min = 0, Max = 240, Default = 0}, Callback = setFPSCap})\r\n    Tabs.Optimization:Section({Title = \"Rendering\", Desc = \"Kurangi efek visual dan proses berdasarkan batch kecil.\", Icon = \"monitor\"})\r\n    Tabs.Optimization:Toggle({Title = \"Hide Rain\", Desc = \"Hentikan particle hujan muncul; Rate awal emitter dipulihkan saat dimatikan. Default: OFF; aktifkan manual bila perlu.\", Value = false, Callback = setHideRain})\r\n    boosterStatus = Tabs.Optimization:Paragraph({Title = \"FPS Booster Status\", Desc = \"Off\"})\r\n    Tabs.Optimization:Toggle({Title = \"FPS Booster / Anti Lag\", Desc = \"Pindai bertahap, menangani instance baru, dan pulihkan properti ketika dimatikan. Default: OFF.\", Value = false, Callback = setBooster})\r\n    Tabs.Optimization:Dropdown({Title = \"FPS Reductions\", Desc = \"Pilih All atau kategori efek yang ingin dikurangi.\", Values = optionValues, Value = {\"Shadows\", \"Post Effects\", \"Atmosphere\", \"Particles\", \"Water\"}, Multi = true, AllowNone = true, Callback = setBoosterOptions})\r\n\r\n    -- Match startup defaults for its game-code and rain switches; booster and graphics remain off.\r\n    if not isLobby then\r\n        setLightFlicker(true); setWindmill(true); setSkipLightCheck(true); setCostumeOutlines(true); setDigestingScrap(true)\r\n    end\r\n    local previousCleanup = getgenv().KixHubCleanup\r\n    getgenv().KixHubCleanup = function()\r\n        boosterEnabled = false; boosterGeneration += 1\r\n        setBooster(false); setFPSCap(0)\r\n        stopTagOptimization(\"flicker\", true); stopTagOptimization(\"windmill\", true); stopTagOptimization(\"costume\", true)\r\n        lightCheckToken += 1; setDigestingScrap(false)\r\n        setHideRain(false)\r\n        for _, key in ipairs({\"disableShadows\", \"removePostEffects\", \"simpleLighting\", \"lowestGraphicsQuality\", \"stop3DRendering\"}) do setGraphics(key, false) end\r\n        for _, category in ipairs({\"Booster:Shadows\", \"Booster:Post Effects\", \"Booster:Atmosphere\", \"Booster:Particles\", \"Booster:Materials\", \"Booster:Mesh Fidelity\", \"Booster:Water\", \"Booster:Graphics Quality\"}) do restoreCategory(category) end\r\n        if previousCleanup then pcall(previousCleanup) end\r\n    end\r\nend)()\r\n\r\nif isLobby then\r\n    task.spawn(function()\r\n        task.wait(2)\r\n        WindUI:Notify({\r\n            Title = \"Lobby Mode Active\",\r\n            Content = \"Game-specific tabs (Combat, Auto, etc.) are hidden to prevent lag and errors while in the Lobby.\",\r\n            Duration = 6,\r\n            Icon = \"shield-alert\"\r\n        })\r\n    end)\r\nend\r\n\r\n-- [ UI UPGRADES (HEARTBEAT & ELEGANT BLUE) ]\r\nlocal function UpgradeToggle(tog)\r\n    if not tog or tog.__type ~= \"Toggle\" then return end\r\n    pcall(function()\r\n        local container = tog.ToggleFrame.UIElements.Container\r\n        local switch = tog.ToggleFrame.UIElements.Main:FindFirstChild(\"ToggleFrame\", true)\r\n        if container and switch then\r\n            -- Mencegah container sink input dari slider/elemen lain saat scroll/drag\r\n            container.Active = false\r\n\r\n           -- =====================================================\r\n            -- CLICKABLE CONTAINER\r\n            -- PC  : sekali klik\r\n            -- HP  : TAP saja, scroll langsung dibatalkan\r\n            -- =====================================================\r\n\r\n            local UIS = game:GetService(\"UserInputService\")\r\n\r\n            local touchInput = nil\r\n            local touchStart = nil\r\n            local touchCancelled = false\r\n\r\n            -- Sengaja kecil.\r\n            -- Bergerak sedikit saja sudah dianggap scroll/drag.\r\n            local TOUCH_THRESHOLD = 2\r\n\r\n            container.InputBegan:Connect(function(input)\r\n\r\n                -- =================================================\r\n                -- PC\r\n                -- =================================================\r\n                if input.UserInputType == Enum.UserInputType.MouseButton1 then\r\n                    tog:Set(not tog.Value)\r\n                    return\r\n                end\r\n\r\n                -- =================================================\r\n                -- MOBILE\r\n                -- =================================================\r\n                if input.UserInputType ~= Enum.UserInputType.Touch then\r\n                    return\r\n                end\r\n\r\n                -- Jangan ambil touch kalau sedang dipakai elemen lain\r\n                if touchInput then\r\n                    return\r\n                end\r\n\r\n                -- -----------------------------------------------\r\n                -- Cek apakah user menekan switch kecil\r\n                -- Switch punya handler sendiri.\r\n                -- -----------------------------------------------\r\n                local switch = tog.ToggleFrame.UIElements.Main:FindFirstChild(\"ToggleFrame\", true)\r\n\r\n                if switch then\r\n                    local p = input.Position\r\n                    local pos = switch.AbsolutePosition\r\n                    local size = switch.AbsoluteSize\r\n\r\n                    local insideSwitch =\r\n                        p.X >= pos.X\r\n                        and p.X <= pos.X + size.X\r\n                        and p.Y >= pos.Y\r\n                        and p.Y <= pos.Y + size.Y\r\n\r\n                    if insideSwitch then\r\n                        return\r\n                    end\r\n                end\r\n\r\n                touchInput = input\r\n                touchStart = input.Position\r\n                touchCancelled = false\r\n            end)\r\n\r\n\r\n            -- =====================================================\r\n            -- GLOBAL TOUCH MOVEMENT\r\n            -- Ini sengaja pakai UIS, bukan container.\r\n            -- Jadi walaupun jari keluar dari card, tetap terdeteksi.\r\n            -- =====================================================\r\n\r\n            UIS.InputChanged:Connect(function(input)\r\n\r\n                if not touchInput then\r\n                    return\r\n                end\r\n\r\n                if input ~= touchInput then\r\n                    return\r\n                end\r\n\r\n                local delta = input.Position - touchStart\r\n\r\n                -- Gerak sedikit saja = BATAL\r\n                if delta.Magnitude >= TOUCH_THRESHOLD then\r\n                    touchCancelled = true\r\n                end\r\n            end)\r\n\r\n\r\n            -- =====================================================\r\n            -- TOUCH END\r\n            -- HANYA toggle kalau benar-benar TAP.\r\n            -- =====================================================\r\n\r\n            UIS.InputEnded:Connect(function(input)\r\n\r\n                if not touchInput then\r\n                    return\r\n                end\r\n\r\n                if input ~= touchInput then\r\n                    return\r\n                end\r\n\r\n                local cancelled = touchCancelled\r\n\r\n                touchInput = nil\r\n                touchStart = nil\r\n                touchCancelled = false\r\n\r\n                -- Scroll / geser sedikit saja = JANGAN TOGGLE\r\n                if cancelled then\r\n                    return\r\n                end\r\n\r\n                -- Benar-benar tap\r\n                tog:Set(not tog.Value)\r\n            end)\r\n            \r\n            -- 2. Lightning/Pulse Icon & Elegant Blue Active Color\r\n            local bar = switch:FindFirstChild(\"Bar\", true)\r\n            local layer = switch:FindFirstChild(\"Layer\", true)\r\n            \r\n            if layer then \r\n                -- Hapus atribut Theme bawaan agar kita bisa custom warnanya\r\n                layer:SetAttribute(\"ThemeTag\", nil)\r\n                layer.ImageColor3 = Color3.fromRGB(59, 130, 246) -- Warna Biru Elegant saat aktif\r\n            end\r\n            \r\n            if bar then\r\n                local icon = Instance.new(\"ImageLabel\")\r\n                icon.Size = UDim2.new(0.65, 0, 0.65, 0)\r\n                icon.AnchorPoint = Vector2.new(0.5, 0.5)\r\n                icon.Position = UDim2.new(0.5, 0, 0.5, 0)\r\n                icon.BackgroundTransparency = 1\r\n                icon.ZIndex = 9999 -- Wajib agar tidak tertutup frame kaca WindUI\r\n                \r\n                -- Menggunakan Icon Love (Heart) Solid Material Design\r\n                icon.Image = \"rbxassetid://7733715400\"\r\n                \r\n                -- Warna default pas mati\r\n                icon.ImageColor3 = Color3.fromRGB(150, 150, 150)\r\n                \r\n                icon.Parent = bar\r\n                \r\n                -- Animasi\r\n                task.spawn(function()\r\n                    local ts = game:GetService(\"TweenService\")\r\n                    local isAnimating = false\r\n                    \r\n                    while icon.Parent do\r\n                        if tog.Value then\r\n                            -- WARNA HARUS BIRU/GELAP KARENA LINGKARANNYA PUTIH!\r\n                            icon.ImageColor3 = Color3.fromRGB(59, 130, 246) \r\n                            if not isAnimating then\r\n                                isAnimating = true\r\n                                ts:Create(icon, TweenInfo.new(0.3, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, 0, true), {Size = UDim2.new(0.9, 0, 0.9, 0)}):Play()\r\n                            end\r\n                            task.wait(0.6)\r\n                            isAnimating = false\r\n                        else\r\n                            icon.ImageColor3 = Color3.fromRGB(150, 150, 150)\r\n                            icon.Size = UDim2.new(0.65, 0, 0.65, 0)\r\n                            isAnimating = false\r\n                            task.wait(0.5)\r\n                        end\r\n                    end\r\n                end)\r\n            end\r\n        end\r\n    end)\r\nend\r\n\r\n-- Hook fungsi Toggle di semua Tab\r\nfor _, tab in pairs(Tabs) do\r\n    if type(tab) == \"table\" and tab.Toggle then\r\n        local oldToggle = tab.Toggle\r\n        tab.Toggle = function(self, args)\r\n            local tog = oldToggle(self, args)\r\n            UpgradeToggle(tog)\r\n            return tog\r\n        end\r\n    end\r\nend\r\n\r\n-- [ UTILITY FUNCTIONS ]\r\n-- (dragItemSmooth dipindah ke atas untuk EARLY INIT)\r\n\r\nlocal function isItemInIceTemple(item)\r\n    if not item then return false end\r\n    local map = workspace:FindFirstChild(\"Map\")\r\n    if not map then return false end\r\n    local landmarks = map:FindFirstChild(\"Landmarks\")\r\n    if not landmarks then return false end\r\n    local iceTemple = landmarks:FindFirstChild(\"Ice Temple\")\r\n    if not iceTemple then return false end\r\n    return (item:GetPivot().Position - iceTemple:GetPivot().Position).Magnitude <= 300\r\nend\r\n\r\n-- isItemHeldByAnotherPlayer dipindah ke atas (EARLY INIT)\r\n\r\n-- WEAPON / AXE PRIORITY\r\n--========================================================--\r\n\r\nlocal weaponPriority = {\r\n    'Admin Axe',\r\n    'Poison Claws',\r\n    'Infernal Sword',\r\n    'Morningstar',\r\n    'Flamethrower',\r\n    \"Happy's Scythe\",\r\n    'Obsidiron Hammer',\r\n    'Laser Sword',\r\n    'Ice Sword',\r\n    'Katana',\r\n    'Scythe',\r\n    'Vampire Scythe',\r\n    'Trident',\r\n    'Poison Spear',\r\n    'Spear',\r\n    'Woodsman\\'s Axe',\r\n    'Chainsaw',\r\n    'Strong Axe',\r\n    'Corrupted Axe',\r\n    'Ice Axe',\r\n    'Good Axe',\r\n    'Old Axe'\r\n}\r\n\r\nlocal axePriority = {\r\n    'Admin Axe',\r\n    'Woodsman\\'s Axe',\r\n    'Chainsaw',\r\n    'Strong Axe',\r\n    'Corrupted Axe',\r\n    'Ice Axe',\r\n    'Good Axe',\r\n    'Old Axe'\r\n}\r\n\r\n\r\n--========================================================--\r\n-- GET BEST AXE\r\n--\r\n-- Digunakan oleh COMBAT AUTOMATION.\r\n-- Boleh mengambil axe dari Inventory.\r\n--========================================================--\r\n\r\nlocal function getBestAxe()\r\n    -- Jika player sedang memegang axe, gunakan axe tersebut terlebih dahulu.\r\n    local char = _LocalPlayer.Character\r\n\r\n    if char then\r\n        local toolHandle = char:FindFirstChild('ToolHandle')\r\n\r\n        if toolHandle\r\n            and toolHandle:GetAttribute('WeaponResourceDamage') then\r\n\r\n            local originalItem = toolHandle:FindFirstChild('OriginalItem')\r\n\r\n            if originalItem\r\n                and originalItem:IsA('ObjectValue')\r\n                and originalItem.Value then\r\n\r\n                return originalItem.Value, 'dummy'\r\n            end\r\n        end\r\n    end\r\n\r\n    -- Combat automation boleh menggunakan axe dari Inventory.\r\n    local inv = _LocalPlayer:FindFirstChild('Inventory')\r\n\r\n    if not inv then\r\n        return nil, nil\r\n    end\r\n\r\n    for _, name in ipairs(axePriority) do\r\n        local item = inv:FindFirstChild(name)\r\n\r\n        if item then\r\n            return item, toolEquipData[name]\r\n        end\r\n    end\r\n\r\n    return nil, nil\r\nend\r\n\r\n\r\n--========================================================--\r\n-- GET BEST WEAPON\r\n--\r\n-- Digunakan oleh COMBAT AUTOMATION.\r\n-- Boleh mengambil weapon dari Inventory.\r\n--========================================================--\r\n\r\nlocal function getBestWeapon()\r\n    -- Jika player sedang memegang weapon, gunakan weapon tersebut terlebih dahulu.\r\n    local char = _LocalPlayer.Character\r\n\r\n    if char then\r\n        local toolHandle = char:FindFirstChild('ToolHandle')\r\n\r\n        if toolHandle\r\n            and toolHandle:GetAttribute('WeaponDamage') then\r\n\r\n            local originalItem = toolHandle:FindFirstChild('OriginalItem')\r\n\r\n            if originalItem\r\n                and originalItem:IsA('ObjectValue')\r\n                and originalItem.Value then\r\n\r\n                return originalItem.Value, 'dummy'\r\n            end\r\n        end\r\n    end\r\n\r\n    -- Combat automation boleh menggunakan weapon dari Inventory.\r\n    local inv = _LocalPlayer:FindFirstChild('Inventory')\r\n\r\n    if not inv then\r\n        return nil, nil\r\n    end\r\n\r\n    for _, name in ipairs(weaponPriority) do\r\n        local item = inv:FindFirstChild(name)\r\n\r\n        if item then\r\n            return item, toolEquipData[name]\r\n        end\r\n    end\r\n\r\n    return nil, nil\r\nend\r\n\r\n\r\n--========================================================--\r\n-- GET HELD WEAPON\r\n--\r\n-- KHUSUS NORMAL / MANUAL MODE.\r\n--\r\n-- Tidak pernah mengambil item dari Inventory.\r\n-- Kalau tidak ada ToolHandle weapon -> nil.\r\n--========================================================--\r\n\r\nlocal function getHeldWeapon()\r\n    local char = _LocalPlayer.Character\r\n\r\n    if not char then\r\n        return nil, nil\r\n    end\r\n\r\n    local toolHandle = char:FindFirstChild('ToolHandle')\r\n\r\n    if not toolHandle then\r\n        return nil, nil\r\n    end\r\n\r\n    if not toolHandle:GetAttribute('WeaponDamage') then\r\n        return nil, nil\r\n    end\r\n\r\n    local originalItem = toolHandle:FindFirstChild('OriginalItem')\r\n\r\n    if originalItem\r\n        and originalItem:IsA('ObjectValue')\r\n        and originalItem.Value then\r\n        return originalItem.Value, 'dummy'\r\n    end\r\n\r\n    return nil, nil\r\nend\r\n\r\nlocal function getBestNonEnergyAuraWeapon()\r\n    local char = _LocalPlayer.Character\r\n    local toolHandle = char and char:FindFirstChild('ToolHandle')\r\n    local originalItem = toolHandle and toolHandle:FindFirstChild('OriginalItem')\r\n    local held = originalItem and originalItem:IsA('ObjectValue') and originalItem.Value\r\n    if held and toolHandle:GetAttribute('WeaponDamage')\r\n        and held:GetAttribute('AmmoType') ~= 'Energy' then\r\n        return held, 'dummy'\r\n    end\r\n    local inventory = _LocalPlayer:FindFirstChild('Inventory')\r\n    if not inventory then return nil, nil end\r\n    for _, name in ipairs(weaponPriority) do\r\n        local item = inventory:FindFirstChild(name)\r\n        if item and item:GetAttribute('AmmoType') ~= 'Energy' then\r\n            return item, toolEquipData[name]\r\n        end\r\n    end\r\n    return nil, nil\r\nend\r\n\r\n\r\n--========================================================--\r\n-- GET HELD AXE\r\n--\r\n-- KHUSUS NORMAL / MANUAL MODE.\r\n--\r\n-- Tidak pernah mengambil item dari Inventory.\r\n-- Kalau tidak ada ToolHandle axe -> nil.\r\n--========================================================--\r\n\r\nlocal function getHeldAxe()\r\n    local char = _LocalPlayer.Character\r\n\r\n    if not char then\r\n        return nil, nil\r\n    end\r\n\r\n    local toolHandle = char:FindFirstChild('ToolHandle')\r\n\r\n    if not toolHandle then\r\n        return nil, nil\r\n    end\r\n\r\n    if not toolHandle:GetAttribute('WeaponResourceDamage') then\r\n        return nil, nil\r\n    end\r\n\r\n    local originalItem = toolHandle:FindFirstChild('OriginalItem')\r\n\r\n    if originalItem\r\n        and originalItem:IsA('ObjectValue')\r\n        and originalItem.Value then\r\n\r\n        return originalItem.Value, 'dummy'\r\n    end\r\n\r\n    return nil, nil\r\nend\r\n\r\n\r\n--========================================================--\r\n-- COMBAT STATE\r\n--\r\n-- Satu sumber pengecekan combat.\r\n--========================================================--\r\n\r\nlocal function isAnyCombatActive()\r\n    return (\r\n        _G.CampfireCombatActive\r\n        or _G.IsStrongholdRaidActive\r\n        or _G.CorruptedCombatActive\r\n        or _G.MossyCombatActive\r\n        or _G.TurkeyCombatActive\r\n        or _G.BearCombatActive\r\n        or _G.GlobalCultistCombatActive\r\n        or _G.NinjaAssistActive\r\n        or _G.PiggybackAssistActive\r\n        or _G.FrogCombatActive\r\n        or _G.CustomHuntCombatActive\r\n    )\r\nend\r\n\r\n\r\n--========================================================--\r\n-- TOOL SYNC\r\n--========================================================--\r\n\r\nlocal lastAuraToolSyncName = nil\r\nlocal lastAuraToolSyncAt = 0\r\n\r\nlocal function equipToolHotbar(toolName, forceEquip)\r\n    if not forceEquip then\r\n        return false\r\n    end\r\n\r\n    local inventory = _LocalPlayer:FindFirstChild('Inventory')\r\n    local tool = inventory and inventory:FindFirstChild(toolName)\r\n\r\n    if not tool then\r\n        return false\r\n    end\r\n\r\n    local now = os.clock()\r\n\r\n    if lastAuraToolSyncName == toolName\r\n        and now - lastAuraToolSyncAt < 0.35 then\r\n\r\n        return true, false\r\n    end\r\n\r\n    local remoteEvents = _ReplicatedStorage:FindFirstChild('RemoteEvents')\r\n    local equipRemote = remoteEvents\r\n        and remoteEvents:FindFirstChild('EquipItemHandle')\r\n\r\n    if equipRemote then\r\n        local ok = pcall(function()\r\n            equipRemote:FireServer('FireAllClients', tool)\r\n        end)\r\n\r\n        if ok then\r\n            lastAuraToolSyncName = toolName\r\n            lastAuraToolSyncAt = now\r\n        end\r\n\r\n        return ok, ok\r\n    end\r\n\r\n    return false\r\nend\r\n\r\n\r\n--========================================================--\r\n-- SYNC AURA DAMAGE TOOL\r\n--\r\n-- Dipakai ketika COMBAT.\r\n-- Tidak dipakai untuk memaksa aura normal aktif.\r\n--========================================================--\r\n\r\nlocal function syncAuraDamageTool(kind, explicitTool)\r\n\r\n    local tool = explicitTool\r\n\r\n    if not tool then\r\n        if kind == 'axe' then\r\n            tool = getBestAxe()\r\n        else\r\n            tool = getBestWeapon()\r\n        end\r\n    end\r\n\r\n    local synced, didSync = false, false\r\n\r\n    if tool then\r\n        synced, didSync = equipToolHotbar(tool.Name, true)\r\n    end\r\n\r\n    if synced then\r\n\r\n        if didSync then\r\n            task.wait(0.06)\r\n        end\r\n\r\n        return true\r\n    end\r\n\r\n    return false\r\nend\r\n\r\n-- ==================== HOME TAB ====================\r\nTabs.Home:Section({Title = 'System', Icon = 'settings'})\r\nantiAfkExecuted = getgenv().KixAntiAFKActive == true\r\n    and getgenv().KixAntiAFKSession == KixHubSession\r\n\r\nlocal function startProtectedAntiAFK()\r\n  local VirtualInputManager = game:GetService(\"VirtualInputManager\")\r\n  -- Bypass 1: Network / Idled Signal\r\n  if type(getconnections) == \"function\" then\r\n    local idledConnections = getconnections(_LocalPlayer.Idled)\r\n    for _, connection in pairs(idledConnections) do\r\n      if type(connection.Disable) == \"function\" then\r\n        connection:Disable()\r\n      end\r\n    end\r\n  else\r\n    local previousConnection = getgenv().KixAntiAFKIdledConnection\r\n    if previousConnection then pcall(function() previousConnection:Disconnect() end) end\r\n    getgenv().KixAntiAFKIdledConnection = _LocalPlayer.Idled:Connect(function()\r\n      VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, nil, 0)\r\n      task.wait(0.1)\r\n      VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, nil, 0)\r\n    end)\r\n  end\r\n\r\n  -- Bypass 2: Virtual Click (Safe Mode, Zero Movement / No Jump)\r\n  task.spawn(function()\r\n    while KixHubSession.Alive do\r\n      -- Jeda 15 Menit\r\n      task.wait(900)\r\n      \r\n      -- Kirim klik mouse ke OS secara silent tanpa menggerakkan karakter\r\n      pcall(function()\r\n        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, nil, 0)\r\n        task.wait(0.1)\r\n        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, nil, 0)\r\n      end)\r\n    end\r\n  end)\r\n  print(\"ANTI AFK ACTIVE in BACKGROUND\")\r\nend\r\n\r\n_G.KixEnableAntiAFK = function()\r\n  if antiAfkExecuted and getgenv().KixAntiAFKSession == KixHubSession then\r\n    antiAfkExecuted = true\r\n    return \"already-active\"\r\n  end\r\n\r\n  local ok, err = pcall(startProtectedAntiAFK)\r\n  if not ok then\r\n    warn(\"[AntiAFK] Failed to start:\", err)\r\n    return \"failed\"\r\n  end\r\n\r\n  antiAfkExecuted = true\r\n  getgenv().KixAntiAFKActive = true\r\n  getgenv().KixAntiAFKSession = KixHubSession\r\n  return \"started\"\r\nend\r\n\r\nlocal antiAfkStartupResult = _G.KixEnableAntiAFK()\r\nif antiAfkStartupResult == \"failed\" then\r\n  warn(\"[AntiAFK] Automatic startup failed; see the error above.\")\r\nend\r\n\r\n-- ============================================\r\n-- KIXHUB | SCRIPT STATISTICS\r\n-- ============================================\r\n\r\ndo\r\n    local S = {}\r\n\r\n    S.HttpService = game:GetService(\"HttpService\")\r\n    S.Player = game:GetService(\"Players\").LocalPlayer\r\n    S.FileName = \"KixHub_Stats.json\"\r\n    S.StartTime = os.time()\r\n\r\n    -- Prevent duplicate trackers and refresh loops\r\n    if _G.KixDiamondStatsConnection then\r\n        pcall(function()\r\n            _G.KixDiamondStatsConnection:Disconnect()\r\n        end)\r\n    end\r\n\r\n    _G.KixStatsSaveToken = (_G.KixStatsSaveToken or 0) + 1\r\n    S.Token = _G.KixStatsSaveToken\r\n\r\n    _G.TotalDiamonds = math.max(\r\n        0,\r\n        tonumber(_G.TotalDiamonds) or 0\r\n    )\r\n\r\n    _G.SavedPlaytime = math.max(\r\n        0,\r\n        tonumber(_G.SavedPlaytime) or 0\r\n    )\r\n\r\n    -- ========================================\r\n    -- BASE64 ENCODING\r\n    -- ========================================\r\n\r\n    S.Base64Characters =\r\n        \"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/\"\r\n\r\n    function S.Encode(data)\r\n        return (\r\n            (data:gsub(\".\", function(character)\r\n                local result = \"\"\r\n                local byte = character:byte()\r\n\r\n                for bit = 8, 1, -1 do\r\n                    result = result .. (\r\n                        byte % 2^bit - byte % 2^(bit - 1) > 0\r\n                        and \"1\" or \"0\"\r\n                    )\r\n                end\r\n\r\n                return result\r\n            end) .. \"0000\"):gsub(\"%d%d%d?%d?%d?%d?\", function(bits)\r\n                if #bits < 6 then\r\n                    return \"\"\r\n                end\r\n\r\n                local value = 0\r\n\r\n                for bit = 1, 6 do\r\n                    value = value + (\r\n                        bits:sub(bit, bit) == \"1\"\r\n                        and 2^(6 - bit) or 0\r\n                    )\r\n                end\r\n\r\n                return S.Base64Characters:sub(value + 1, value + 1)\r\n            end) .. ({ \"\", \"==\", \"=\" })[#data % 3 + 1]\r\n        )\r\n    end\r\n\r\n    function S.Decode(data)\r\n        data = data:gsub(\"[^\" .. S.Base64Characters .. \"=]\", \"\")\r\n\r\n        return (data:gsub(\".\", function(character)\r\n            if character == \"=\" then\r\n                return \"\"\r\n            end\r\n\r\n            local position = S.Base64Characters:find(character)\r\n\r\n            if not position then\r\n                return \"\"\r\n            end\r\n\r\n            local result = \"\"\r\n            local value = position - 1\r\n\r\n            for bit = 6, 1, -1 do\r\n                result = result .. (\r\n                    value % 2^bit - value % 2^(bit - 1) > 0\r\n                    and \"1\" or \"0\"\r\n                )\r\n            end\r\n\r\n            return result\r\n        end):gsub(\"%d%d%d?%d?%d?%d?%d?%d?\", function(bits)\r\n            if #bits ~= 8 then\r\n                return \"\"\r\n            end\r\n\r\n            local value = 0\r\n\r\n            for bit = 1, 8 do\r\n                value = value + (\r\n                    bits:sub(bit, bit) == \"1\"\r\n                    and 2^(8 - bit) or 0\r\n                )\r\n            end\r\n\r\n            return string.char(value)\r\n        end))\r\n    end\r\n\r\n    -- ========================================\r\n    -- LOAD SAVED DATA\r\n    -- ========================================\r\n\r\n    function S.Load()\r\n        local success, err = pcall(function()\r\n            if type(isfile) ~= \"function\"\r\n                or type(readfile) ~= \"function\"\r\n                or not isfile(S.FileName) then\r\n                return\r\n            end\r\n\r\n            local rawData = readfile(S.FileName)\r\n\r\n            if type(rawData) ~= \"string\" or rawData == \"\" then\r\n                return\r\n            end\r\n\r\n            -- Support legacy plain JSON and Base64 files\r\n            if rawData:match(\"^%s*(.)\") ~= \"{\" then\r\n                rawData = S.Decode(rawData)\r\n            end\r\n\r\n            local savedData = S.HttpService:JSONDecode(rawData)\r\n\r\n            if type(savedData) ~= \"table\" then\r\n                return\r\n            end\r\n\r\n            _G.TotalDiamonds = math.max(\r\n                0,\r\n                tonumber(savedData.TotalDiamonds) or 0\r\n            )\r\n\r\n            _G.SavedPlaytime = math.max(\r\n                0,\r\n                tonumber(savedData.SavedPlaytime) or 0\r\n            )\r\n        end)\r\n\r\n        if not success then\r\n            warn(\"[KixHub] Failed to load statistics:\", err)\r\n        end\r\n    end\r\n\r\n    -- ========================================\r\n    -- SAVE STATISTICS\r\n    -- ========================================\r\n\r\n    function S.Save()\r\n        local success, err = pcall(function()\r\n            if type(writefile) ~= \"function\" then\r\n                return\r\n            end\r\n\r\n            local currentSessionTime = math.max(\r\n                0,\r\n                os.time() - S.StartTime\r\n            )\r\n\r\n            local savedData = {\r\n                TotalDiamonds = _G.TotalDiamonds or 0,\r\n                SavedPlaytime =\r\n                    (_G.SavedPlaytime or 0) + currentSessionTime\r\n            }\r\n\r\n            local jsonData = S.HttpService:JSONEncode(savedData)\r\n            writefile(S.FileName, S.Encode(jsonData))\r\n        end)\r\n\r\n        if not success then\r\n            warn(\"[KixHub] Failed to save statistics:\", err)\r\n        end\r\n    end\r\n\r\n    -- ========================================\r\n    -- PLAYTIME FORMAT\r\n    -- ========================================\r\n\r\n    function S.FormatTime(seconds)\r\n        seconds = math.max(0, math.floor(seconds))\r\n\r\n        return string.format(\r\n            \"%02d:%02d:%02d\",\r\n            math.floor(seconds / 3600),\r\n            math.floor((seconds % 3600) / 60),\r\n            seconds % 60\r\n        )\r\n    end\r\n\r\n    -- ========================================\r\n    -- STATISTICS INTERFACE\r\n    -- ========================================\r\n\r\n    S.Load()\r\n\r\n    S.RunService = game:GetService(\"RunService\")\r\n    S.FrameCount = 0\r\n    S.CurrentFPS = 0\r\n    S.LastFPSUpdate = os.clock()\r\n\r\n    -- Prevent duplicate FPS tracking connections\r\n    if _G.KixStatsFPSConnection then\r\n        pcall(function()\r\n            _G.KixStatsFPSConnection:Disconnect()\r\n        end)\r\n    end\r\n\r\n    -- Track actual rendered frames\r\n    _G.KixStatsFPSConnection = S.RunService.RenderStepped:Connect(function()\r\n        S.FrameCount = S.FrameCount + 1\r\n\r\n        local now = os.clock()\r\n        local elapsed = now - S.LastFPSUpdate\r\n\r\n        if elapsed >= 1 then\r\n            S.CurrentFPS = math.floor(\r\n                S.FrameCount / elapsed + 0.5\r\n            )\r\n\r\n            S.FrameCount = 0\r\n            S.LastFPSUpdate = now\r\n        end\r\n    end)\r\n\r\n    -- Read current network ping\r\n    function S.GetPing()\r\n        local success, pingSeconds = pcall(function()\r\n            return S.Player:GetNetworkPing()\r\n        end)\r\n\r\n        if success and type(pingSeconds) == \"number\" then\r\n            return math.floor(pingSeconds * 1000 + 0.5)\r\n        end\r\n\r\n        return 0\r\n    end\r\n\r\n    -- Create statistics paragraph\r\n    S.Paragraph = Tabs.Home:Paragraph({\r\n        Title = \"Script Statistics\",\r\n\r\n        Desc = string.format(\r\n            \"Total Playtime: 00:00:00\\n\" ..\r\n            \"FPS: %d\\n\" ..\r\n            \"Ping: %d ms\\n\\n\" ..\r\n            \"Total Diamonds Collected: %d\",\r\n\r\n            S.CurrentFPS,\r\n            S.GetPing(),\r\n            _G.TotalDiamonds or 0\r\n        )\r\n    })\r\n\r\n    -- Refresh statistics display\r\n    function S.Refresh()\r\n        if not S.Paragraph then\r\n            return\r\n        end\r\n\r\n        local currentPlaytime = math.max(\r\n            0,\r\n            os.time() - S.StartTime\r\n        )\r\n\r\n        local currentFPS = tonumber(S.CurrentFPS) or 0\r\n        local currentPing = S.GetPing()\r\n\r\n        S.Paragraph:SetDesc(string.format(\r\n            \"Total Playtime: %s\\n\" ..\r\n            \"FPS: %d\\n\" ..\r\n            \"Ping: %d ms\\n\\n\" ..\r\n            \"Total Diamonds Collected: %d\",\r\n\r\n            S.FormatTime(currentPlaytime),\r\n            currentFPS,\r\n            currentPing,\r\n            math.max(0, math.floor(\r\n                tonumber(_G.TotalDiamonds) or 0\r\n            ))\r\n        ))\r\n    end\r\n\r\n    -- ========================================\r\n    -- DIAMOND BALANCE TRACKER\r\n    -- ========================================\r\n\r\n    S.LastBalance = tonumber(\r\n        S.Player:GetAttribute(\"Diamonds\")\r\n    )\r\n\r\n    function S.OnDiamondChanged()\r\n        local currentBalance = tonumber(\r\n            S.Player:GetAttribute(\"Diamonds\")\r\n        )\r\n\r\n        if currentBalance == nil then\r\n            return\r\n        end\r\n\r\n        if S.LastBalance == nil then\r\n            S.LastBalance = currentBalance\r\n            S.Refresh()\r\n            return\r\n        end\r\n\r\n        local difference = currentBalance - S.LastBalance\r\n        S.LastBalance = currentBalance\r\n\r\n        -- Count positive balance changes only\r\n        if difference > 0 then\r\n            _G.TotalDiamonds =\r\n                (_G.TotalDiamonds or 0) + difference\r\n\r\n            S.Refresh()\r\n            S.Save()\r\n        end\r\n    end\r\n\r\n    _G.KixDiamondStatsConnection =\r\n        S.Player:GetAttributeChangedSignal(\"Diamonds\"):Connect(\r\n            S.OnDiamondChanged\r\n        )\r\n\r\n    -- ========================================\r\n    -- GLOBAL SAVE FUNCTION\r\n    -- ========================================\r\n\r\n    _G.SaveScriptStats = S.Save\r\n\r\n    -- ========================================\r\n    -- AUTOMATIC REFRESH AND AUTOSAVE\r\n    -- ========================================\r\n\r\n    task.spawn(function()\r\n        while _G.KixStatsSaveToken == S.Token do\r\n            task.wait(1)\r\n\r\n            if _G.KixStatsSaveToken ~= S.Token then\r\n                break\r\n            end\r\n\r\n            pcall(S.Refresh)\r\n        end\r\n    end)\r\n\r\n    task.spawn(function()\r\n        while _G.KixStatsSaveToken == S.Token do\r\n            task.wait(30)\r\n\r\n            if _G.KixStatsSaveToken ~= S.Token then\r\n                break\r\n            end\r\n\r\n            S.Save()\r\n        end\r\n    end)\r\n\r\n    S.Refresh()\r\n    S.Save()\r\n\r\n    print(\"[KixHub] Statistics tracker initialized.\")\r\n    print(\"[KixHub] Total Diamonds:\", _G.TotalDiamonds)\r\nend  \r\n\r\nlocal selfReviveBusy = false\r\n\r\nTabs.Home:Button({\r\n    Title = \"🛡️ Self Revive\",\r\n    Desc = \"Revive yourself Now, Works if there is at least ONE OTHER PLAYER inside the server!\",\r\n    Callback = function()\r\n        -- Anti-Spam: Cegah klik berulang saat proses revive masih berlangsung\r\n        if selfReviveBusy then return end\r\n        selfReviveBusy = true\r\n\r\n        task.spawn(function()\r\n            local success, err = pcall(function()\r\n                -- =====================================================\r\n                -- 1. DETEKSI STATUS DOWNED & RAGDOLL BADAN (PERTAMA KALI)\r\n                -- =====================================================\r\n                local pg = _LocalPlayer:FindFirstChild(\"PlayerGui\")\r\n                local interface = pg and pg:FindFirstChild(\"Interface\")\r\n                local deadFrame = interface and interface:FindFirstChild(\"DeadFrame\")\r\n                local isDowned = deadFrame and deadFrame.Visible\r\n\r\n                -- Fallback check status karakter jika DeadFrame belum tampak\r\n                if not isDowned then\r\n                    local char = _LocalPlayer.Character\r\n                    local hum = char and char:FindFirstChildOfClass(\"Humanoid\")\r\n                    if hum and hum.Health <= 0 then\r\n                        isDowned = true\r\n                    end\r\n                end\r\n\r\n                if not isDowned then\r\n                    return\r\n                end\r\n\r\n                -- Cari ragdoll badan pemain (myBody)\r\n                local myBody = nil\r\n\r\n                -- CARA 1: Gunakan Camera Subject (Paling akurat saat mati)\r\n                local cam = workspace.CurrentCamera\r\n                if cam and cam.CameraSubject and cam.CameraSubject:IsA(\"Humanoid\") and cam.CameraSubject.Parent then\r\n                    local subjectParent = cam.CameraSubject.Parent\r\n                    if subjectParent:FindFirstChild(\"ReviveBillboard\") or subjectParent.Name:match(\" Body$\") then\r\n                        myBody = subjectParent\r\n                    end\r\n                end\r\n\r\n                -- CARA 2: Pengecekan aman menggunakan Attribute PlayerBody\r\n                local charsFolder = workspace:FindFirstChild(\"Characters\")\r\n                if not myBody and charsFolder then\r\n                    for _, char in ipairs(charsFolder:GetChildren()) do\r\n                        if char:GetAttribute(\"PlayerBody\") == _LocalPlayer.UserId then\r\n                            myBody = char\r\n                            break\r\n                        end\r\n                    end\r\n                end\r\n\r\n                -- CARA 3: Gunakan DisplayName / Name\r\n                if not myBody and charsFolder then\r\n                    myBody = charsFolder:FindFirstChild(_LocalPlayer.DisplayName .. \" Body\") or \r\n                             charsFolder:FindFirstChild(_LocalPlayer.Name .. \" Body\")\r\n                end\r\n\r\n                -- Jeda singkat jika ragdoll baru saja di-spawn oleh server\r\n                if not myBody and charsFolder then\r\n                    for _ = 1, 5 do\r\n                        task.wait(0.1)\r\n                        for _, char in ipairs(charsFolder:GetChildren()) do\r\n                            if char:GetAttribute(\"PlayerBody\") == _LocalPlayer.UserId then\r\n                                myBody = char\r\n                                break\r\n                            end\r\n                        end\r\n                        if not myBody then\r\n                            myBody = charsFolder:FindFirstChild(_LocalPlayer.DisplayName .. \" Body\") or \r\n                                     charsFolder:FindFirstChild(_LocalPlayer.Name .. \" Body\")\r\n                        end\r\n                        if myBody then break end\r\n                    end\r\n                end\r\n\r\n                if not myBody then\r\n                    return\r\n                end\r\n\r\n                -- Notifikasi 1: Progress waiting (tepat 1 notifikasi awal, durasi 10 detik)\r\n                if WindUI then\r\n                    WindUI:Notify({\r\n                        Title = \"Self Revive\",\r\n                        Content = \"Progress waiting 10 second...\",\r\n                        Duration = 10\r\n                    })\r\n                end\r\n\r\n                -- =====================================================\r\n                -- 2. PENGECEKAN & PENGAMBILAN OBAT (MAX 1 - 1.5 DETIK)\r\n                -- =====================================================\r\n                local function checkHealItem()\r\n                    local inv = _LocalPlayer:FindFirstChild(\"Inventory\")\r\n                    local item = inv and (inv:FindFirstChild(\"Bandage\") or inv:FindFirstChild(\"MedKit\") or inv:FindFirstChild(\"Medkit\"))\r\n                    if item then return item end\r\n\r\n                    local char = _LocalPlayer.Character\r\n                    local inChar = char and (char:FindFirstChild(\"Bandage\") or char:FindFirstChild(\"MedKit\") or char:FindFirstChild(\"Medkit\"))\r\n                    if inChar then return inChar end\r\n\r\n                    local bp = _LocalPlayer:FindFirstChild(\"Backpack\")\r\n                    local inBp = bp and (bp:FindFirstChild(\"Bandage\") or bp:FindFirstChild(\"MedKit\") or bp:FindFirstChild(\"Medkit\"))\r\n                    if inBp then return inBp end\r\n\r\n                    return nil\r\n                end\r\n\r\n                local healItem = checkHealItem()\r\n\r\n                -- Jika belum punya, tarik dari map (cek tiap 0.2s, max 1.2 detik)\r\n                if not healItem then\r\n                    if type(grabMedicine) == \"function\" then\r\n                        task.spawn(grabMedicine)\r\n                    end\r\n\r\n                    for _ = 1, 6 do\r\n                        task.wait(0.2)\r\n                        healItem = checkHealItem()\r\n                        if healItem then\r\n                            break\r\n                        end\r\n                    end\r\n                end\r\n\r\n                -- =====================================================\r\n                -- 3. MODE DARURAT: BELI BANDAGE JIKA BELUM ADA\r\n                -- =====================================================\r\n                if not healItem then\r\n                    -- Beli 1 Bandage via remote resmi game\r\n                    pcall(function()\r\n                        local bought = false\r\n                        local okClient, Client = pcall(function() return require(_LocalPlayer.PlayerScripts.Client) end)\r\n                        if okClient and Client and Client.Events and Client.Events.RequestPurchaseExtra then\r\n                            Client.Events.RequestPurchaseExtra:FireServer(\"Bandage\")\r\n                            bought = true\r\n                        end\r\n\r\n                        if not bought then\r\n                            local remoteEvents = game:GetService(\"ReplicatedStorage\"):FindFirstChild(\"RemoteEvents\")\r\n                            local reqExtra = remoteEvents and remoteEvents:FindFirstChild(\"RequestPurchaseExtra\")\r\n                            if reqExtra then\r\n                                if reqExtra:IsA(\"RemoteEvent\") then\r\n                                    reqExtra:FireServer(\"Bandage\")\r\n                                elseif reqExtra:IsA(\"RemoteFunction\") then\r\n                                    reqExtra:InvokeServer(\"Bandage\")\r\n                                end\r\n                                bought = true\r\n                            end\r\n                        end\r\n\r\n                        if okClient and Client and Client.Sound then\r\n                            pcall(function() Client.Sound.Play(\"BuyItem\") end)\r\n                        end\r\n                    end)\r\n\r\n                    -- Tunggu Bandage hasil beli masuk ke inventory (max 1.5 detik)\r\n                    local checkStart = os.clock()\r\n                    while (os.clock() - checkStart) < 1.5 do\r\n                        healItem = checkHealItem()\r\n                        if healItem then\r\n                            break\r\n                        end\r\n                        task.wait(0.1)\r\n                    end\r\n                end\r\n\r\n                -- =====================================================\r\n                -- 4. EKSEKUSI REVIVE\r\n                -- =====================================================\r\n                healItem = checkHealItem()\r\n                if healItem and myBody then\r\n                    local remoteEvents = game:GetService(\"ReplicatedStorage\"):FindFirstChild(\"RemoteEvents\")\r\n                    local reviveRemote = remoteEvents and remoteEvents:FindFirstChild(\"RequestRevivePlayer\")\r\n                    if reviveRemote then\r\n                        pcall(function()\r\n                            reviveRemote:FireServer(myBody)\r\n                        end)\r\n\r\n                        -- Notifikasi 2: Selesai revive (tepat 1 notifikasi akhir)\r\n                        if WindUI then\r\n                            WindUI:Notify({\r\n                                Title = \"Self Revive\",\r\n                                Content = \"Done Revived!\",\r\n                                Duration = 4\r\n                            })\r\n                        end\r\n\r\n                        -- Safety re-fire jika server lag\r\n                        for i = 1, 2 do\r\n                            task.wait(1.5)\r\n                            local checkPg = _LocalPlayer:FindFirstChild(\"PlayerGui\")\r\n                            local checkIface = checkPg and checkPg:FindFirstChild(\"Interface\")\r\n                            local checkDf = checkIface and checkIface:FindFirstChild(\"DeadFrame\")\r\n                            if checkDf and checkDf.Visible then\r\n                                pcall(function() reviveRemote:FireServer(myBody) end)\r\n                            else\r\n                                break\r\n                            end\r\n                        end\r\n                    end\r\n                end\r\n            end)\r\n\r\n            -- Buka kembali kunci anti-spam setelah proses selesai\r\n            selfReviveBusy = false\r\n        end)\r\n    end\r\n})\r\n\r\n-- Full Automation lives directly below Self Revive in the single Home/System section.\r\n_G.FullAutoToggle = Tabs.Home:Toggle({\r\n    Title = \"⚡ Enable Full Automation\",\r\n    Desc = \"Prepares the fire and rescues kids, Auto Eat, Auto Scrap, Semi God Mode, reveals map, opens chests, chops tree, runs Sacrifice and Cultist combat, delivers gems, auto farm corrupted, starts buying/building, auto equips costume clothes, then auto Stronghold.\",\r\n    Value = false,\r\n    Callback = function(val)\r\n        local controller = _G.KixFullAuto\r\n        if not controller then\r\n            if val then\r\n                WindUI:Notify({\r\n                    Title = \"Full Automation\",\r\n                    Content = \"Controller belum siap. Jalankan hub di game yang didukung, lalu execute ulang script.\",\r\n                    Duration = 5\r\n                })\r\n            end\r\n            return\r\n        end\r\n\r\n        if val then\r\n            controller.Start()\r\n        else\r\n            controller.Stop()\r\n        end\r\n    end\r\n})\r\n\r\n_G.KixFullAutomationSkipActivities = {}\r\n_G.KixFullAutomationSkipRevision = 0\r\n_G.FullAutomationSkipDropdown = CreateMultiDropdown(Tabs.Home, {\r\n    Title = \"Activities to Skip\",\r\n    Desc = \"Choose steps Full Automation should leave out.\",\r\n    Values = {\r\n        \"Skip Rescue Kids\",\r\n        \"Skip Map Reveal\",\r\n        \"Skip Auto Chop Tree\",\r\n        \"Skip Auto Kill Cultist Global\",\r\n        \"Skip Auto Sacrifice\",\r\n        \"Skip Auto Scrap\",\r\n        \"Skip Auto Skip Nights\",\r\n        \"Skip Weather Machine\",\r\n        \"Skip Revive Player\",\r\n    },\r\n    Multi = true,\r\n    Value = {},\r\n    Callback = function(values)\r\n        local selected = {}\r\n        if type(values) == \"table\" then\r\n            for _, value in ipairs(values) do\r\n                if value == \"Skip Rescue Kids\" then selected[\"Rescue Kids\"] = true end\r\n                if value == \"Skip Map Reveal\" then selected[\"Map Reveal\"] = true end\r\n                if value == \"Skip Auto Chop Tree\" then selected[\"Auto Chop Tree\"] = true end\r\n                if value == \"Skip Auto Kill Cultist Global\" then selected[\"Auto Kill Cultist Global\"] = true end\r\n                if value == \"Skip Auto Sacrifice\" then selected[\"Auto Sacrifice\"] = true end\r\n                if value == \"Skip Auto Scrap\" then selected[\"Auto Scrap\"] = true end\r\n                if value == \"Skip Auto Skip Nights\" then selected[\"Auto Skip Nights\"] = true end\r\n                if value == \"Skip Weather Machine\" then selected[\"Weather Machine\"] = true end\r\n                if value == \"Skip Revive Player\" then selected[\"Revive Player\"] = true end\r\n            end\r\n        end\r\n        _G.KixFullAutomationSkipActivities = selected\r\n        _G.KixFullAutomationSkipRevision = (_G.KixFullAutomationSkipRevision or 0) + 1\r\n        local controller = _G.KixFullAuto\r\n        if controller and type(controller.ApplySkipSelection) == \"function\" then\r\n            pcall(controller.ApplySkipSelection)\r\n        end\r\n        if type(_G.KixWakeAutoPlacement) == \"function\" then\r\n            pcall(_G.KixWakeAutoPlacement)\r\n        end\r\n    end,\r\n})\r\n\r\ngetgenv().scriptStartTime = os.time()\r\nlocal scriptStartTime = getgenv().scriptStartTime\r\n\r\nframes = 0\r\nlocal lastFpsUpdate = os.clock()\r\nlocal currentFps = 60\r\n\r\n-- Lightweight visual FPS counter\r\nlocal rsConn = game:GetService(\"RunService\").RenderStepped:Connect(function()\r\n    frames = frames + 1\r\n    local now = os.clock()\r\n    if now - lastFpsUpdate >= 0.5 then\r\n        currentFps = math.floor(frames / (now - lastFpsUpdate))\r\n        frames = 0\r\n        lastFpsUpdate = now\r\n    end\r\nend)\r\n\r\ntask.spawn(function()\r\n        while KixHubSession.Alive do\r\n        local runTime = os.time() - scriptStartTime\r\n\r\n        local ping = 0\r\n        pcall(function() ping = math.round(_LocalPlayer:GetNetworkPing() * 1000) end)\r\n\r\n        local hungerText = \"Unknown\"\r\n        pcall(function()\r\n            local pg = _LocalPlayer:FindFirstChild(\"PlayerGui\")\r\n            if pg then\r\n                local bar = pg:FindFirstChild(\"Interface\") and pg.Interface:FindFirstChild(\"StatBars\") and pg.Interface.StatBars:FindFirstChild(\"HungerBar\") and pg.Interface.StatBars.HungerBar:FindFirstChild(\"Bar\")\r\n                if bar then\r\n                    local scale = bar.Size.X.Scale\r\n                    hungerText = tostring(math.floor(scale * 100)) .. \"%\"\r\n                end\r\n            end\r\n        end)\r\n\r\n        local currentDay = 0\r\n        pcall(function()\r\n            local dayLabel = _LocalPlayer:FindFirstChild(\"PlayerGui\") and _LocalPlayer.PlayerGui:FindFirstChild(\"Interface\") and _LocalPlayer.PlayerGui.Interface:FindFirstChild(\"DayCounter\")\r\n            if dayLabel and dayLabel.Text then\r\n                local num = dayLabel.Text:match(\"%d+\")\r\n                if num then\r\n                    currentDay = tonumber(num)\r\n                    \r\n                    if currentDay == 1 and not getgenv().DayOneResetDone then\r\n                        getgenv().DayOneResetDone = true\r\n                        _G.SavedPlaytime = 0\r\n                        _G.SessionDiamonds = 0\r\n                    elseif currentDay > 1 then\r\n                        getgenv().DayOneResetDone = true\r\n                    end\r\n                    \r\n                    if currentDay > _G.MaxDayReach then\r\n                        _G.MaxDayReach = currentDay\r\n                        if _G.SaveScriptStats then _G.SaveScriptStats() end\r\n                    end\r\n                end\r\n            end\r\n        end)\r\n        \r\n        local totalRunTime = runTime + (_G.SavedPlaytime or 0)\r\n        local hours = math.floor(totalRunTime / 3600)\r\n        local mins = math.floor((totalRunTime % 3600) / 60)\r\n        local secs = totalRunTime % 60\r\n\r\n        if statsParagraph and statsParagraph.SetDesc then\r\n            pcall(function() statsParagraph:SetDesc(string.format(\"Playtime: %02d:%02d:%02d\\nFPS: %d\\nPing: %d ms\\n\\nTotal Diamond Collected: %d\\nDiamond Collected this Session: %d\\nTotal Coin Collected: %d\\nMax Day Reach: %d\", hours, mins, secs, currentFps, ping, _G.TotalDiamonds, _G.SessionDiamonds or 0, _G.TotalCoins, _G.MaxDayReach)) end)\r\n        end\r\n        task.wait(0.25)\r\n    end\r\nend)\r\n\r\n-- Anti AFK starts during script initialization and stays hidden from Home.\r\n\r\n-- Worker & Performance Debug toggle hidden for the published UI.\r\n\r\n-- Status paragraph intentionally hidden from the Home tab.\r\n_G.FullAutoStatusParagraph = nil\r\n\r\n-- Progress paragraph intentionally hidden with the Full Automation status display.\r\n_G.FullAutoProgressParagraph = nil\r\n\r\n-- ⏸️ Pause / Resume control hidden; controller methods retained.\r\n\r\n\r\n-- 🔄 Restart Sequence control hidden; controller methods retained.\r\n\r\n\r\nNoFogToggle = Tabs.Home:Toggle({\r\n    Title = '☀️ No Fog (Bright)',\r\n    Desc = 'Turn off in cave to avoid blinking',\r\n    Value = false,\r\n    Callback = function(state)\r\n        NoFogEnabled = state\r\n        if state then\r\n            applyNoFog()\r\n            startTick()\r\n        else\r\n            stopTick()\r\n            restoreFog()\r\n        end\r\n    end\r\n})\r\n\r\n_G.KixEngines.InstantInteract = function(val)\r\n        InstantInteractEnabled = val\r\nend\r\n\r\nInstantInteractToggle = Tabs.Home:Toggle({\r\n    Title = '⚡️ Instant Interact',\r\n    Desc = 'Open Chest Instantly',\r\n    Value = false,\r\n    Callback = function(value)\r\n        local controller = _G.KixFullAuto\r\n        if value == false and controller then\r\n            controller.Owned[\"InstantInteract\"] = nil\r\n            if controller.Suspended then controller.Suspended[\"InstantInteract\"] = nil end\r\n        end\r\n        return _G.KixEngines.InstantInteract(value)\r\n    end\r\n})\r\n\r\nAutoBuyCraftingBenchToggle = Tabs.Home:Toggle({\r\n    Title = \"🛒 Auto Buy on Crafting Bench\",\r\n    Desc = \"Auto buys blueprints and upgrades Crafting Bench when materials are available.\",\r\n    Value = false,\r\n    Callback = function(val)\r\n        if _G.ToggleAutoBuyCraftingBench then\r\n            _G.ToggleAutoBuyCraftingBench(val)\r\n        end\r\n    end\r\n})\r\n\r\nAutoStructurePlacementToggle = Tabs.Home:Toggle({\r\n    Title = \"🏗️ Auto Structure Placement\",\r\n    Desc = \"Automatically places Farm Plots, Crock Pot, and other blueprints.\",\r\n    Value = false,\r\n    Callback = function(val)\r\n        if _G.ToggleAutoStructurePlacement then\r\n            _G.ToggleAutoStructurePlacement(val)\r\n        end\r\n    end\r\n})\r\n\r\nTabs.Shop:Section({Title = 'Global Shops', Icon = 'shopping-cart'})\r\n\r\nTabs.Shop:Button({\r\n    Title = 'Crafting Bench',\r\n    Desc = 'Open the blueprint purchase menu from anywhere.',\r\n    Callback = function()\r\n        local lp = game:GetService(\"Players\").LocalPlayer\r\n        local success, CraftingTableClient = pcall(function() return require(lp.PlayerScripts.Client.CampsiteModules.CraftingTableClient) end)\r\n        if success and CraftingTableClient and CraftingTableClient.OpenCraftingBench then\r\n            CraftingTableClient.OpenCraftingBench()\r\n        else\r\n            -- Fallback: Tampilkan manual\r\n            local ui = lp.PlayerGui:FindFirstChild(\"Interface\")\r\n            if ui and ui:FindFirstChild(\"CraftingTable\") then\r\n                ui.CraftingTable.Visible = true\r\n                game:GetService(\"StarterGui\"):SetCoreGuiEnabled(Enum.CoreGuiType.Chat, false)\r\n            end\r\n        end\r\n    end\r\n})\r\n\r\nhasInteractedToolSmith = false\r\ntask.spawn(function()\r\n    local lp = game:GetService(\"Players\").LocalPlayer\r\n    local ui = lp:WaitForChild(\"PlayerGui\"):WaitForChild(\"Interface\", 10)\r\n    if ui and ui:FindFirstChild(\"ToolSmith\") then\r\n        if ui.ToolSmith.Visible then hasInteractedToolSmith = true end\r\n        ui.ToolSmith:GetPropertyChangedSignal(\"Visible\"):Connect(function()\r\n            if ui.ToolSmith.Visible then\r\n                hasInteractedToolSmith = true\r\n            end\r\n        end)\r\n    end\r\nend)\r\n\r\nTabs.Shop:Button({\r\n    Title = 'Upgrade Tools (ToolTrader)',\r\n    Desc = 'Opens the ToolSmith UI. (Hammer, Bandage, Taming Flute, Rod)',\r\n    Callback = function()\r\n        local lp = game:GetService(\"Players\").LocalPlayer\r\n        local success, Client = pcall(function() return require(lp.PlayerScripts:FindFirstChild(\"Client\")) end)\r\n        if success and Client and Client.Interface and Client.Interface.ToolSmith then\r\n            Client.Sound.Play(\"CloseButton\")\r\n            Client.Interface.ToolSmith.Visible = not Client.Interface.ToolSmith.Visible\r\n        else\r\n            local ui = lp.PlayerGui:FindFirstChild(\"Interface\")\r\n            if ui and ui:FindFirstChild(\"ToolSmith\") then\r\n                ui.ToolSmith.Visible = not ui.ToolSmith.Visible\r\n            end\r\n        end\r\n    end\r\n})\r\n\r\nTabs.Shop:Button({\r\n    Title = 'Beekeepers Shop House',\r\n    Desc = 'Open the Beekeeper Shop to buy honey-related items from anywhere.',\r\n    Callback = function()\r\n        local lp = game:GetService(\"Players\").LocalPlayer\r\n        local success, BeekeeperShopClient = pcall(function() return require(lp.PlayerScripts.Client.BeeBiomeModules.BeekeeperShopClient) end)\r\n        if success and BeekeeperShopClient and BeekeeperShopClient.OpenShop then\r\n            BeekeeperShopClient.OpenShop()\r\n        else\r\n            -- Fallback\r\n            local ui = lp.PlayerGui:FindFirstChild(\"Interface\")\r\n            if ui and ui:FindFirstChild(\"Beekeeper\") then\r\n                ui.Beekeeper.Visible = true\r\n            end\r\n        end\r\n    end\r\n})\r\n\r\nTabs.Shop:Button({\r\n    Title = 'Fairy Shop House',\r\n    Desc = 'Open the Fairy Shop to buy magical items and blueprints from anywhere.',\r\n    Callback = function()\r\n        local lp = game:GetService(\"Players\").LocalPlayer\r\n        local success, Client = pcall(function() return require(lp.PlayerScripts.Client) end)\r\n        if success and Client and Client.Interface and Client.Interface.Flower then\r\n            Client.Sound.Play(\"CloseButton\")\r\n            Client.Interface.Flower.Visible = true\r\n        else\r\n            -- Fallback\r\n            local ui = lp.PlayerGui:FindFirstChild(\"Interface\")\r\n            if ui and ui:FindFirstChild(\"Flower\") then\r\n                ui.Flower.Visible = true\r\n            end\r\n        end\r\n    end\r\n})\r\n\r\n-- =========================================================\r\n-- FURNITURE TRADER\r\n-- =========================================================\r\n\r\nlocal function openFurnitureTrader()\r\n    local lp = _LocalPlayer\r\n\r\n    local success, Client = pcall(function()\r\n        return require(lp.PlayerScripts.Client)\r\n    end)\r\n\r\n    if success and Client then\r\n        -- Gunakan interface asli game\r\n        if Client.Interface and Client.Interface.Furniture then\r\n\r\n            pcall(function()\r\n                Client.Sound.Play(\"CloseButton\")\r\n            end)\r\n\r\n            Client.Interface.Furniture.Visible = true\r\n            return true\r\n        end\r\n    end\r\n\r\n    -- Fallback ke PlayerGui asli game\r\n    local pg = lp:FindFirstChild(\"PlayerGui\")\r\n\r\n    if pg then\r\n        local interface = pg:FindFirstChild(\"Interface\")\r\n\r\n        if interface then\r\n            local furniture = interface:FindFirstChild(\"Furniture\")\r\n\r\n            if furniture then\r\n                furniture.Visible = true\r\n                return true\r\n            end\r\n        end\r\n    end\r\n\r\n    return false\r\nend\r\n\r\nlocal function openHalloweenFurniture()\r\n    local lp = _LocalPlayer\r\n\r\n    local success, Client = pcall(function()\r\n        return require(lp.PlayerScripts.Client)\r\n    end)\r\n\r\n    -- 1. Coba melalui InteractionHandler jika terdaftar di client\r\n    if success and Client and Client.InteractionHandler then\r\n        local fired = false\r\n        pcall(function()\r\n            local ih = Client.InteractionHandler\r\n            if ih.Interactions and ih.Interactions[\"OpenHalloweenFurniture\"] then\r\n                ih.Interactions[\"OpenHalloweenFurniture\"]()\r\n                fired = true\r\n            elseif ih.TriggerInteraction then\r\n                ih.TriggerInteraction(\"OpenHalloweenFurniture\")\r\n                fired = true\r\n            elseif ih.FireInteraction then\r\n                ih.FireInteraction(\"OpenHalloweenFurniture\")\r\n                fired = true\r\n            end\r\n        end)\r\n        if fired then return true end\r\n    end\r\n\r\n    -- 2. Gunakan interface asli game (Client.Interface.HalloweenFurniture)\r\n    if success and Client and Client.Interface and Client.Interface:FindFirstChild(\"HalloweenFurniture\") then\r\n        local hf = Client.Interface.HalloweenFurniture\r\n        if hf.Visible then\r\n            hf.Visible = false\r\n            pcall(function()\r\n                game:GetService(\"GuiService\").TouchControlsEnabled = true\r\n                game:GetService(\"StarterGui\"):SetCoreGuiEnabled(Enum.CoreGuiType.Chat, true)\r\n                if Client.Sound then Client.Sound.Play(\"CloseButton\") end\r\n            end)\r\n        else\r\n            hf.Visible = true\r\n            pcall(function()\r\n                game:GetService(\"GuiService\").TouchControlsEnabled = false\r\n                game:GetService(\"StarterGui\"):SetCoreGuiEnabled(Enum.CoreGuiType.Chat, false)\r\n                if Client.Sound then Client.Sound.Play(\"PosterOpen\") end\r\n            end)\r\n        end\r\n        return true\r\n    end\r\n\r\n    -- 3. Fallback via PlayerGui asli\r\n    local pg = lp:FindFirstChild(\"PlayerGui\")\r\n    local interface = pg and pg:FindFirstChild(\"Interface\")\r\n    local hf = interface and interface:FindFirstChild(\"HalloweenFurniture\")\r\n    if hf then\r\n        hf.Visible = not hf.Visible\r\n        pcall(function()\r\n            if not hf.Visible then\r\n                game:GetService(\"GuiService\").TouchControlsEnabled = true\r\n                game:GetService(\"StarterGui\"):SetCoreGuiEnabled(Enum.CoreGuiType.Chat, true)\r\n            else\r\n                game:GetService(\"GuiService\").TouchControlsEnabled = false\r\n                game:GetService(\"StarterGui\"):SetCoreGuiEnabled(Enum.CoreGuiType.Chat, false)\r\n            end\r\n        end)\r\n        return true\r\n    end\r\n\r\n    return false\r\nend\r\n\r\n\r\n-- =========================================================\r\n-- FURNITURE TRADER HOTKEY\r\n-- Y = OPEN / CLOSE\r\n-- =========================================================\r\ntask.spawn(function()\r\n    local UserInputService=game:GetService(\"UserInputService\")\r\n\r\n    UserInputService.InputBegan:Connect(function(input,gameProcessed)\r\n        if input.KeyCode~=Enum.KeyCode.Y then\r\n            return\r\n        end\r\n\r\n        task.defer(function()\r\n            local playerGui=_LocalPlayer:FindFirstChild(\"PlayerGui\")\r\n            if not playerGui then\r\n                return\r\n            end\r\n\r\n            local interface=playerGui:FindFirstChild(\"Interface\")\r\n            local topRight=interface and interface:FindFirstChild(\"TopRight\")\r\n            local frame=topRight and topRight:FindFirstChild(\"Frame\")\r\n            local furniture=frame and frame:FindFirstChild(\"Furniture\")\r\n\r\n            if not furniture or not furniture:IsA(\"GuiButton\") then\r\n                return\r\n            end\r\n\r\n            -- Pertahankan behavior lama:\r\n            -- jika Furniture dari awal tersembunyi, tampilkan dulu.\r\n            if not furniture.Visible then\r\n                furniture.Visible=true\r\n            end\r\n\r\n            -- Jalankan handler tombol bawaan game.\r\n            pcall(function()\r\n                furniture:Activate()\r\n            end)\r\n        end)\r\n    end)\r\nend)\r\n\r\n-- =========================================================\r\n-- SHOP BUTTON\r\n-- =========================================================\r\n\r\nTabs.Shop:Button({\r\n    Title = \"Furniture Trader\",\r\n    Desc = \"Open the Furniture Trader to buy decorative items from anywhere.\",\r\n\r\n    Callback = function()\r\n        openFurnitureTrader()\r\n    end\r\n})\r\n\r\n_G.KixHiddenHalloweenFurnitureButton = Tabs.Shop:Button({\r\n    Title = \"Halloween Furniture\",\r\n    Desc = \"Open the Halloween Furniture shop to buy spooky Halloween decorations from anywhere.\",\r\n\r\n    Callback = function()\r\n        openHalloweenFurniture()\r\n    end\r\n})\r\npcall(function()\r\n    local frame = _G.KixHiddenHalloweenFurnitureButton\r\n        and _G.KixHiddenHalloweenFurnitureButton.ButtonFrame\r\n        and _G.KixHiddenHalloweenFurnitureButton.ButtonFrame.UIElements\r\n        and _G.KixHiddenHalloweenFurnitureButton.ButtonFrame.UIElements.Main\r\n    if frame then frame.Visible = false; frame.Size = UDim2.new(0, 0, 0, 0) end\r\nend)\r\n\r\n_G.KixHiddenAlienTraderButton = Tabs.Shop:Button({\r\n    Title = \"Alien Trader\",\r\n    Desc = \"Open the Alien Trader shop to claim special alien equipment from anywhere.\",\r\n\r\n    Callback = function()\r\n        local lp = _LocalPlayer\r\n        local pg = lp and lp:FindFirstChild(\"PlayerGui\")\r\n        local interface = pg and pg:FindFirstChild(\"Interface\")\r\n        local atGui = interface and interface:FindFirstChild(\"AlienTrader\")\r\n\r\n        -- 0. Toggle close jika GUI Alien Trader sedang terbuka\r\n        if atGui and atGui.Visible then\r\n            atGui.Visible = false\r\n            pcall(function()\r\n                local okClient, Client = pcall(function() return require(lp.PlayerScripts.Client) end)\r\n                if okClient and Client and Client.Sound then\r\n                    Client.Sound.Play(\"KeyPress\", { Duplicate = true })\r\n                end\r\n            end)\r\n            return\r\n        end\r\n\r\n        -- Cari NPC Alien Trader\r\n        local trader = nil\r\n        local chars = _Workspace:FindFirstChild(\"Characters\")\r\n        if chars then\r\n            trader = chars:FindFirstChild(\"Alien Trader\") or chars:FindFirstChild(\"AlienTrader\")\r\n        end\r\n        if not trader then\r\n            local npcs = _Workspace:FindFirstChild(\"NPCs\")\r\n            if npcs then\r\n                trader = npcs:FindFirstChild(\"Alien Trader\") or npcs:FindFirstChild(\"AlienTrader\")\r\n            end\r\n        end\r\n        if not trader then\r\n            local map = _Workspace:FindFirstChild(\"Map\")\r\n            if map then\r\n                local lm = map:FindFirstChild(\"Landmarks\")\r\n                trader = (lm and (lm:FindFirstChild(\"Alien Trader\") or lm:FindFirstChild(\"AlienTrader\")))\r\n                    or map:FindFirstChild(\"Alien Trader\", true)\r\n                    or map:FindFirstChild(\"AlienTrader\", true)\r\n            end\r\n        end\r\n        if not trader then\r\n            trader = _Workspace:FindFirstChild(\"Alien Trader\")\r\n                or _Workspace:FindFirstChild(\"AlienTrader\")\r\n                or _Workspace:FindFirstChild(\"Alien Trader\", true)\r\n                or _Workspace:FindFirstChild(\"AlienTrader\", true)\r\n        end\r\n        if not trader and chars then\r\n            for _, child in ipairs(chars:GetChildren()) do\r\n                if child:IsA(\"Model\") and string.find(string.lower(child.Name), \"alien\") and string.find(string.lower(child.Name), \"trader\") then\r\n                    trader = child\r\n                    break\r\n                end\r\n            end\r\n        end\r\n\r\n        -- 1. Coba melalui AlienTraderClient bawaan game\r\n        local opened = false\r\n        local okMod, AlienTraderClient = pcall(function()\r\n            local ps = lp:FindFirstChild(\"PlayerScripts\")\r\n            local clientFolder = ps and ps:FindFirstChild(\"Client\")\r\n            if not clientFolder then return nil end\r\n\r\n            local arm = clientFolder:FindFirstChild(\"AlienRevengeModules\")\r\n            local mod = arm and arm:FindFirstChild(\"AlienTraderClient\")\r\n            if mod then return require(mod) end\r\n            return require(clientFolder.AlienRevengeModules.AlienTraderClient)\r\n        end)\r\n\r\n        if okMod and AlienTraderClient and type(AlienTraderClient.OpenShop) == \"function\" then\r\n            local ok = pcall(function()\r\n                AlienTraderClient.OpenShop(trader)\r\n            end)\r\n            if ok then\r\n                if atGui and not atGui.Visible then\r\n                    atGui.Visible = true\r\n                end\r\n                opened = true\r\n            end\r\n        end\r\n\r\n        -- 2. Fallback via Client.Interface.AlienTrader\r\n        if not opened then\r\n            local okClient, Client = pcall(function() return require(lp.PlayerScripts.Client) end)\r\n            if okClient and Client and Client.Interface and Client.Interface:FindFirstChild(\"AlienTrader\") then\r\n                local at = Client.Interface.AlienTrader\r\n                at.Visible = not at.Visible\r\n                opened = true\r\n            end\r\n        end\r\n\r\n        -- 3. Fallback via PlayerGui\r\n        if not opened and atGui then\r\n            atGui.Visible = not atGui.Visible\r\n            opened = true\r\n        end\r\n\r\n        if not opened and WindUI then\r\n            WindUI:Notify({\r\n                Title = \"Alien Trader\",\r\n                Content = \"Alien Trader interface not found!\",\r\n                Duration = 3\r\n            })\r\n        end\r\n    end\r\n})\r\npcall(function()\r\n    local frame = _G.KixHiddenAlienTraderButton\r\n        and _G.KixHiddenAlienTraderButton.ButtonFrame\r\n        and _G.KixHiddenAlienTraderButton.ButtonFrame.UIElements\r\n        and _G.KixHiddenAlienTraderButton.ButtonFrame.UIElements.Main\r\n    if frame then frame.Visible = false; frame.Size = UDim2.new(0, 0, 0, 0) end\r\nend)\r\n\r\n\r\n-- =========================================================\r\n-- ORIGINAL GAME FURNITURE BUTTON\r\n-- =========================================================\r\n\r\ntask.spawn(function()\r\n\r\n    local pg = _LocalPlayer:WaitForChild(\"PlayerGui\")\r\n    local interface = pg:WaitForChild(\"Interface\")\r\n    local topRight = interface:WaitForChild(\"TopRight\")\r\n    local frame = topRight:WaitForChild(\"Frame\")\r\n    local furnitureButton = frame:WaitForChild(\"Furniture\")\r\n\r\n    furnitureButton.Activated:Connect(function()\r\n\r\n        local characters = _Workspace:FindFirstChild(\"Characters\")\r\n        local trader = characters and\r\n            characters:FindFirstChild(\"Furniture Trader\")\r\n\r\n        if not trader then\r\n            furnitureButton.Visible = false\r\n            return\r\n        end\r\n\r\n        openFurnitureTrader()\r\n\r\n    end)\r\n\r\nend)\r\n\r\n\r\n-- =========================================================\r\n-- FURNITURE TRADER VISIBILITY\r\n-- =========================================================\r\n\r\nlocal function updateFurnitureTraderButton()\r\n\r\n    local pg = _LocalPlayer:FindFirstChild(\"PlayerGui\")\r\n    if not pg then\r\n        return\r\n    end\r\n\r\n    local interface = pg:FindFirstChild(\"Interface\")\r\n    if not interface then\r\n        return\r\n    end\r\n\r\n    local topRight = interface:FindFirstChild(\"TopRight\")\r\n    local frame = topRight and topRight:FindFirstChild(\"Frame\")\r\n    local furnitureButton =\r\n        frame and frame:FindFirstChild(\"Furniture\")\r\n\r\n    if not furnitureButton then\r\n        return\r\n    end\r\n\r\n    local characters = _Workspace:FindFirstChild(\"Characters\")\r\n\r\n    local trader = characters and\r\n        characters:FindFirstChild(\"Furniture Trader\")\r\n\r\n    furnitureButton.Visible = trader ~= nil\r\nend\r\n\r\n\r\ntask.spawn(function()\r\n\r\n    while KixHubSession.Alive and task.wait(0.5) do\r\n        pcall(updateFurnitureTraderButton)\r\n    end\r\n\r\nend)\r\n\r\n\r\n-- ==================== COMBAT TAB ====================\r\nlocal auraRadius = 150\r\nlocal killAuraEnabled = KixHubSavedState.KillAura or false\r\nlocal alienTechFinisherEnabled = false\r\nlocal chopAuraEnabled = KixHubSavedState.ChopAura or false\r\nlocal killAuraToggle\r\n\r\nTabs.Combat:Section({Title = 'Immortality', Icon = 'shield'})\r\n\r\n-- =========================================================\r\n-- SEMI GOD MODE (ORIGINAL RESTORED - RESPAWN SAFE)\r\n-- Kompatibel dengan nama variabel / API KixEngines sebelumnya.\r\n-- Setelah mati / void / respawn: otomatis OFF; bisa ON lagi.\r\n-- =========================================================\r\ndo -- Private protection scope: release outer registers before later tabs.\r\nlocal _running = false\r\nlocal _connections = {}\r\nlocal protectionDisposed = false\r\n\r\n_G.KixEngines = _G.KixEngines or {}\r\n_G.KixEngines.Tokens = _G.KixEngines.Tokens or {}\r\n\r\n-- Variabel tambahan internal; tidak mengganti variabel yang sudah ada.\r\nlocal _semiGodHooks = {remote = false, damage = false, joints = false}\r\nlocal _semiGodRespawnConnections = {}\r\nlocal _semiGodHealthSnapshots = setmetatable({}, {__mode = \"k\"})\r\nlocal _semiGodAppliedEntities = setmetatable({}, {__mode = \"k\"})\r\nlocal _semiGodSyncingToggle = false\r\n\r\nlocal SPOOFED_REMOTES = {\r\n    \"DamagePlayer\",\r\n    \"NPCProjectileDamagePlayer\",\r\n    \"ClientTriggerNPCAttack\",\r\n    \"HitByBatScream\",\r\n    \"JungleSpikeTrapDamage\",\r\n    \"CheckLightningDamage\",\r\n    \"RamChargePlayer\",\r\n    \"PoisonBorderFlash\",\r\n    \"TriggerArrowTrap\",\r\n    \"EatRottenEgg\"\r\n}\r\nlocal _semiGodBlockedRemoteNames = {}\r\nfor _, name in ipairs(SPOOFED_REMOTES) do\r\n    _semiGodBlockedRemoteNames[name] = true\r\nend\r\n\r\nlocal function semiGodNotify(content)\r\n    pcall(function()\r\n        WindUI:Notify({Title = \"God Mode\", Content = content, Duration = 3})\r\n    end)\r\nend\r\n\r\nlocal function syncSemiGodToggle(state)\r\n    if _semiGodSyncingToggle then return end\r\n    local toggle = _G.SemiGodModeToggle\r\n    if not toggle then return end\r\n    _semiGodSyncingToggle = true\r\n    pcall(function()\r\n        if type(toggle.Set) == \"function\" then\r\n            toggle:Set(state, false, true) -- WindUI: tanpa callback rekursif\r\n        elseif type(toggle.SetValue) == \"function\" then\r\n            toggle:SetValue(state)\r\n        end\r\n    end)\r\n    _semiGodSyncingToggle = false\r\nend\r\n\r\nlocal function isSemiGodPlayerEntity(inst)\r\n    if typeof(inst) ~= \"Instance\" then return false end\r\n    local char = _LocalPlayer.Character\r\n    if char and (inst == char or inst:IsDescendantOf(char)) then\r\n        return true\r\n    end\r\n    local folder = workspace:FindFirstChild(\"Characters\")\r\n    if folder then\r\n        local current = inst\r\n        while current and current ~= folder do\r\n            if current:GetAttribute(\"PlayerBody\") == _LocalPlayer.UserId then\r\n                return true\r\n            end\r\n            current = current.Parent\r\n        end\r\n    end\r\n    return false\r\nend\r\n\r\n-- Satu hook global untuk Semi God dan Block Lava.\r\n-- Remote asli TIDAK di-rename, dihapus, atau diganti instance palsu.\r\nlocal function installSemiGodRemoteHook()\r\n    if _semiGodHooks.remote then return end\r\n    if type(hookmetamethod) ~= \"function\" or\r\n       type(getnamecallmethod) ~= \"function\" then\r\n        warn(\"[SemiGod] hookmetamethod/getnamecallmethod unavailable; remote interception disabled\")\r\n        return\r\n    end\r\n\r\n    local ok, err = pcall(function()\r\n        local oldNamecall\r\n        local handler = function(self, ...)\r\n            if typeof(self) == \"Instance\" then\r\n                local method = getnamecallmethod()\r\n                if method == \"FireServer\" or method == \"InvokeServer\" then\r\n                    if _running and\r\n                       _semiGodBlockedRemoteNames[self.Name] and\r\n                       self:IsA(\"RemoteEvent\") then\r\n                        local folder = _ReplicatedStorage:FindFirstChild(\"RemoteEvents\")\r\n                        if folder and self:IsDescendantOf(folder) then\r\n                            return nil\r\n                        end\r\n                    end\r\n\r\n                end\r\n            end\r\n            return oldNamecall(self, ...)\r\n        end\r\n        if type(newcclosure) == \"function\" then\r\n            handler = newcclosure(handler)\r\n        end\r\n        oldNamecall = hookmetamethod(game, \"__namecall\", handler)\r\n    end)\r\n    if ok then\r\n        _semiGodHooks.remote = true\r\n    else\r\n        warn(\"[SemiGod] Remote hook failed:\", err)\r\n    end\r\nend\r\n\r\n-- hookfunction dipasang maksimal satu kali per metode sepanjang script hidup.\r\nlocal function installSemiGodFunctionHooks()\r\n    if type(hookfunction) ~= \"function\" then\r\n        warn(\"[SemiGod] hookfunction unavailable; function hooks disabled\")\r\n        return\r\n    end\r\n\r\n    if not _semiGodHooks.damage then\r\n        local ok, err = pcall(function()\r\n            local dummyHumanoid = Instance.new(\"Humanoid\")\r\n            local oldTakeDamage\r\n            local handler = function(self, amount)\r\n                if _running and isSemiGodPlayerEntity(self) then\r\n                    return nil\r\n                end\r\n                return oldTakeDamage(self, amount)\r\n            end\r\n            if type(newcclosure) == \"function\" then\r\n                handler = newcclosure(handler)\r\n            end\r\n            oldTakeDamage = hookfunction(dummyHumanoid.TakeDamage, handler)\r\n            dummyHumanoid:Destroy()\r\n        end)\r\n        _semiGodHooks.damage = ok\r\n        if not ok then warn(\"[SemiGod] TakeDamage hook failed:\", err) end\r\n    end\r\n\r\n    if not _semiGodHooks.joints then\r\n        local ok, err = pcall(function()\r\n            local dummyModel = Instance.new(\"Model\")\r\n            local oldBreakJoints\r\n            local handler = function(self, ...)\r\n                if _running and isSemiGodPlayerEntity(self) then\r\n                    return nil\r\n                end\r\n                return oldBreakJoints(self, ...)\r\n            end\r\n            if type(newcclosure) == \"function\" then\r\n                handler = newcclosure(handler)\r\n            end\r\n            oldBreakJoints = hookfunction(dummyModel.BreakJoints, handler)\r\n            dummyModel:Destroy()\r\n        end)\r\n        _semiGodHooks.joints = ok\r\n        if not ok then warn(\"[SemiGod] BreakJoints hook failed:\", err) end\r\n    end\r\nend\r\n\r\nlocal function saveSemiGodHumanoid(hum)\r\n    if not hum or _semiGodHealthSnapshots[hum] then return end\r\n    _semiGodHealthSnapshots[hum] = {\r\n        MaxHealth = hum.MaxHealth,\r\n        Dead = hum:GetStateEnabled(Enum.HumanoidStateType.Dead),\r\n        Physics = hum:GetStateEnabled(Enum.HumanoidStateType.Physics)\r\n    }\r\nend\r\n\r\nlocal function restoreSemiGodHumanoids()\r\n    for hum, original in pairs(_semiGodHealthSnapshots) do\r\n        if hum and hum.Parent then\r\n            pcall(function()\r\n                -- Saat karakter sudah mati jangan paksa Health=100.\r\n                -- State Dead dipulihkan agar respawn tidak tersangkut.\r\n                hum:SetStateEnabled(Enum.HumanoidStateType.Dead, true)\r\n                hum:SetStateEnabled(Enum.HumanoidStateType.Physics, original.Physics)\r\n                if hum.Health > 0 and original.MaxHealth > 0 then\r\n                    hum.MaxHealth = original.MaxHealth\r\n                    if hum.Health > hum.MaxHealth then\r\n                        hum.Health = hum.MaxHealth\r\n                    end\r\n                end\r\n            end)\r\n        end\r\n        _semiGodHealthSnapshots[hum] = nil\r\n    end\r\nend\r\n\r\nlocal function clearSemiGodConnections()\r\n    for _, conn in pairs(_connections) do\r\n        if typeof(conn) == \"RBXScriptConnection\" then\r\n            pcall(function() conn:Disconnect() end)\r\n        end\r\n    end\r\n    _connections = {}\r\n    _semiGodAppliedEntities = setmetatable({}, {__mode = \"k\"})\r\nend\r\n\r\n-- Proteksi diulang hanya untuk entity baru; tugas lama dibatalkan via token.\r\nlocal function applySemiGodEntity(char, engineToken)\r\n    if not _running or not char or not char.Parent then return end\r\n    if _G.KixEngines.Tokens.SemiGodMode ~= engineToken then return end\r\n    if _semiGodAppliedEntities[char] then return end\r\n    _semiGodAppliedEntities[char] = true\r\n\r\n    task.spawn(function()\r\n        local hum = char:FindFirstChildOfClass(\"Humanoid\") or\r\n                    char:WaitForChild(\"Humanoid\", 5)\r\n        if not _running or\r\n           _G.KixEngines.Tokens.SemiGodMode ~= engineToken or\r\n           not char.Parent then\r\n            return\r\n        end\r\n        if not hum or hum.Health <= 0 then\r\n            _semiGodAppliedEntities[char] = nil\r\n            return\r\n        end\r\n        saveSemiGodHumanoid(hum)\r\n\r\n        -- Tetap memakai setupEntity lama jika tersedia di script utama.\r\n        -- Fallback lokal disediakan bila setupEntity tidak didefinisikan.\r\n        if type(setupEntity) == \"function\" then\r\n            local ok, err = pcall(function()\r\n                setupEntity(char)\r\n            end)\r\n            if not ok then\r\n                warn(\"[SemiGod] setupEntity failed:\", err)\r\n            end\r\n        else\r\n            pcall(function()\r\n                hum.MaxHealth = math.max(hum.MaxHealth, 1e9)\r\n                hum.Health = hum.MaxHealth\r\n            end)\r\n        end\r\n\r\n        if not _running or\r\n           _G.KixEngines.Tokens.SemiGodMode ~= engineToken or\r\n           not hum.Parent then\r\n            return\r\n        end\r\n\r\n        -- Jangan mengunci Dead=false: mati karena void tetap harus bisa.\r\n        pcall(function()\r\n            hum:SetStateEnabled(Enum.HumanoidStateType.Dead, true)\r\n        end)\r\n\r\n        -- Cadangan bila setupEntity/fallback hanya menaikkan MaxHealth.\r\n        local connHealth = hum.HealthChanged:Connect(function(health)\r\n            if not _running or\r\n               _G.KixEngines.Tokens.SemiGodMode ~= engineToken then return end\r\n            if health > 0 and health < hum.MaxHealth then\r\n                pcall(function() hum.Health = hum.MaxHealth end)\r\n            end\r\n        end)\r\n        table.insert(_connections, connHealth)\r\n    end)\r\nend\r\n\r\n_G.KixEngines.SemiGodMode = function(val)\r\n    val = (val == true)\r\n    if val and protectionDisposed then return end\r\n    if val == (_running == true) then return end\r\n\r\n    -- Tidak mengaktifkan pada karakter mati / sedang belum tersedia.\r\n    if val then\r\n        local char = _LocalPlayer.Character\r\n        local hum = char and char:FindFirstChildOfClass(\"Humanoid\")\r\n        if not char or not char.Parent or not hum or hum.Health <= 0 then\r\n            semiGodNotify(\"Wait until respawn is complete\")\r\n            syncSemiGodToggle(false)\r\n            return\r\n        end\r\n    end\r\n\r\n    local engineTokens = _G.KixEngines.Tokens\r\n    engineTokens.SemiGodMode = (engineTokens.SemiGodMode or 0) + 1\r\n    local engineToken = engineTokens.SemiGodMode\r\n    _running = val\r\n\r\n    if val then\r\n        -- 1. Intercept remotes tanpa merusak referensi RemoteEvents.\r\n        installSemiGodRemoteHook()\r\n\r\n        -- 2. Global hooks (sekali saja, tidak ditumpuk tiap ON).\r\n        installSemiGodFunctionHooks()\r\n\r\n        -- Tangkap karakter utama sekarang; tidak auto-ON saat respawn.\r\n        if _LocalPlayer.Character then\r\n            applySemiGodEntity(_LocalPlayer.Character, engineToken)\r\n        end\r\n\r\n        -- Tangkap custom body dari PlayerBodyModule.\r\n        local function watchCharactersFolder(charactersFolder)\r\n            if not _running or engineTokens.SemiGodMode ~= engineToken then\r\n                return\r\n            end\r\n\r\n            local function watchChild(child)\r\n                if child:GetAttribute(\"PlayerBody\") == _LocalPlayer.UserId then\r\n                    applySemiGodEntity(child, engineToken)\r\n                end\r\n                local attrConn = child:GetAttributeChangedSignal(\"PlayerBody\"):Connect(function()\r\n                    if _running and engineTokens.SemiGodMode == engineToken and\r\n                       child:GetAttribute(\"PlayerBody\") == _LocalPlayer.UserId then\r\n                        applySemiGodEntity(child, engineToken)\r\n                    end\r\n                end)\r\n                table.insert(_connections, attrConn)\r\n            end\r\n\r\n            for _, child in ipairs(charactersFolder:GetChildren()) do\r\n                watchChild(child)\r\n            end\r\n            local connCharAdded = charactersFolder.ChildAdded:Connect(watchChild)\r\n            table.insert(_connections, connCharAdded)\r\n        end\r\n\r\n        local charactersFolder = workspace:FindFirstChild(\"Characters\")\r\n        if charactersFolder then\r\n            watchCharactersFolder(charactersFolder)\r\n        else\r\n            _connections.charactersFolderAdded = workspace.ChildAdded:Connect(function(child)\r\n                if child.Name == \"Characters\" then\r\n                    watchCharactersFolder(child)\r\n                end\r\n            end)\r\n        end\r\n\r\n        -- 5. Keep CoreGui HealthBar removed while active.\r\n        task.spawn(function()\r\n            local coreGui = game:GetService(\"CoreGui\")\r\n            while _running and engineTokens.SemiGodMode == engineToken do\r\n                pcall(function()\r\n                    local topBarApp = coreGui:FindFirstChild(\"TopBarApp\")\r\n                    local topBarAppInner = topBarApp and topBarApp:FindFirstChild(\"TopBarApp\")\r\n                    local unibarLeftFrame = topBarAppInner and topBarAppInner:FindFirstChild(\"UnibarLeftFrame\")\r\n                    local healthBar = unibarLeftFrame and unibarLeftFrame:FindFirstChild(\"HealthBar\")\r\n                    if healthBar then healthBar:Destroy() end\r\n                end)\r\n                task.wait(0.5)\r\n            end\r\n        end)\r\n\r\n        syncSemiGodToggle(true)\r\n        semiGodNotify(\"Active\")\r\n    else\r\n        -- Cleanup ON/OFF / mati / respawn: token sudah di-invalidate.\r\n        _running = false\r\n        clearSemiGodConnections()\r\n        restoreSemiGodHumanoids()\r\n        -- Tidak perlu destroy/rename remote atau mencopot hook global.\r\n        syncSemiGodToggle(false)\r\n        semiGodNotify(\"OFF\")\r\n    end\r\nend\r\n\r\n-- Listener PERMANEN: tidak disimpan di _connections (yang dibersihkan saat OFF).\r\n-- Died + HealthChanged + CharacterRemoving mencakup mati normal/void/reset.\r\nlocal function watchSemiGodDeath(char)\r\n    for _, conn in pairs(_semiGodRespawnConnections) do\r\n        if typeof(conn) == \"RBXScriptConnection\" then\r\n            -- Listener CharacterAdded/Removing dipertahankan.\r\n            if _semiGodRespawnConnections.died == conn or\r\n               _semiGodRespawnConnections.health == conn then\r\n                conn:Disconnect()\r\n            end\r\n        end\r\n    end\r\n    _semiGodRespawnConnections.died = nil\r\n    _semiGodRespawnConnections.health = nil\r\n\r\n    task.spawn(function()\r\n        local hum = char:FindFirstChildOfClass(\"Humanoid\") or char:WaitForChild(\"Humanoid\", 10)\r\n        if protectionDisposed or not hum or _LocalPlayer.Character ~= char then return end\r\n\r\n        local function stopOnDeath()\r\n            -- Confirm death after the game has had time to finish a Frog morph.\r\n            task.delay(1, function()\r\n                if _running and _LocalPlayer.Character == char\r\n                    and char.Name ~= \"Frog\" and hum.Health <= 0 then\r\n                    _G.KixEngines.SemiGodMode(false)\r\n                    syncSemiGodToggle(false)\r\n                end\r\n            end)\r\n        end\r\n\r\n        _semiGodRespawnConnections.died = hum.Died:Connect(stopOnDeath)\r\n        _semiGodRespawnConnections.health = hum.HealthChanged:Connect(function(health)\r\n            if health <= 0 then stopOnDeath() end\r\n        end)\r\n        if hum.Health <= 0 then stopOnDeath() end\r\n    end)\r\nend\r\n\r\n_semiGodRespawnConnections.removing = _LocalPlayer.CharacterRemoving:Connect(function(char)\r\n    _semiGodRespawnConnections.transitionToken = (_semiGodRespawnConnections.transitionToken or 0) + 1\r\n    local transitionToken = _semiGodRespawnConnections.transitionToken\r\n    _semiGodRespawnConnections.removedCharacterName = char and char.Name or nil\r\n    if not _running then return end\r\n\r\n    -- CharacterRemoving also fires when Trick-or-Treat swaps the avatar for Frog.\r\n    -- Defer shutdown until the replacement character is known.\r\n    task.delay(2, function()\r\n        if not _running or _semiGodRespawnConnections.transitionToken ~= transitionToken then return end\r\n        local currentChar = _LocalPlayer.Character\r\n        if (char and char.Name == \"Frog\") or (currentChar and currentChar.Name == \"Frog\") then return end\r\n        _G.KixEngines.SemiGodMode(false)\r\n        syncSemiGodToggle(false)\r\n    end)\r\nend)\r\n\r\n_semiGodRespawnConnections.added = _LocalPlayer.CharacterAdded:Connect(function(char)\r\n    _semiGodRespawnConnections.transitionToken = (_semiGodRespawnConnections.transitionToken or 0) + 1\r\n    local previousName = _semiGodRespawnConnections.removedCharacterName\r\n    _semiGodRespawnConnections.removedCharacterName = nil\r\n    if _running then\r\n        if char.Name == \"Frog\" or previousName == \"Frog\" then\r\n            applySemiGodEntity(char, _G.KixEngines.Tokens.SemiGodMode)\r\n            syncSemiGodToggle(true)\r\n        else\r\n            _G.KixEngines.SemiGodMode(false)\r\n            syncSemiGodToggle(false)\r\n        end\r\n    end\r\n    watchSemiGodDeath(char)\r\nend)\r\n\r\nif _LocalPlayer.Character then\r\n    watchSemiGodDeath(_LocalPlayer.Character)\r\nend\r\n\r\n_G.SemiGodModeToggle = Tabs.Combat:Toggle({\r\n    Title = 'Semi God Mode',\r\n    Desc = 'Infinite Health but Not Infinite Hunger, You Need Activate Auto Eat!',\r\n    Value = true,\r\n    Callback = function(value)\r\n        local controller = _G.KixFullAuto\r\n        if value == false and controller then\r\n            controller.Owned[\"SemiGodMode\"] = nil\r\n            if controller.Suspended then controller.Suspended[\"SemiGodMode\"] = nil end\r\n        end\r\n        return _G.KixEngines.SemiGodMode(value)\r\n    end\r\n})\r\n\r\n_G.KixAdapters = _G.KixAdapters or {}\r\n_G.KixAdapters.SemiGodMode = {\r\n    IsEnabled = function()\r\n        return _running == true\r\n    end,\r\n    SetState = function(state)\r\n        return _G.KixEngines.SemiGodMode(state)\r\n    end,\r\n    VerifyActive = function()\r\n        if not _running then return false end\r\n        local char = _LocalPlayer and _LocalPlayer.Character\r\n        local hum = char and char:FindFirstChildOfClass(\"Humanoid\")\r\n        if hum and hum.MaxHealth >= 1e8 then return true end\r\n        return _running\r\n    end\r\n}\r\n\r\n-- =========================================================\r\n-- VOLCANO LAVA CONTACT FILTER\r\n-- Volcanic sacrifice lava stays active so NPC corpses can be consumed.\r\n-- =========================================================\r\ndo\r\n    local blockLavaEnabled = false\r\n    local revision = 0\r\n    local globalConnections = {}\r\n    local originals = setmetatable({}, {__mode = 'k'})\r\n    local propertyConnections = setmetatable({}, {__mode = 'k'})\r\n    local queued = setmetatable({}, {__mode = 'k'})\r\n    local CollectionService = game:GetService('CollectionService')\r\n\r\n    local function getVolcanoLava()\r\n        local map = workspace:FindFirstChild('Map')\r\n        local landmarks = map and map:FindFirstChild('Landmarks')\r\n        local volcano = landmarks and landmarks:FindFirstChild('Volcano')\r\n        local functional = volcano and volcano:FindFirstChild('Functional')\r\n        local lava = functional and functional:FindFirstChild('Lava')\r\n        return lava and lava:IsA('BasePart') and lava or nil\r\n    end\r\n\r\n    local function normalizeLegacyLava(part)\r\n        if part:GetAttribute('NoItemBurning') ~= true then return end\r\n        pcall(function()\r\n            -- Keep the lava contact filter scoped to this handler.\r\n            part.CanTouch = true\r\n            part:SetAttribute('NoItemBurning', nil)\r\n        end)\r\n    end\r\n\r\n    local function applyWorldPatch(part, token)\r\n        if not blockLavaEnabled or revision ~= token or not part\r\n            or not part:IsA('BasePart') or not part:IsDescendantOf(workspace)\r\n            or not CollectionService:HasTag(part, 'OnFirePart') then\r\n            return\r\n        end\r\n\r\n        local volcanoLava = getVolcanoLava()\r\n        normalizeLegacyLava(part)\r\n        if part == volcanoLava then\r\n            -- This path is deliberately excluded from the non-volcano lava filter.\r\n            return\r\n        end\r\n\r\n        if originals[part] == nil then\r\n            originals[part] = part.CanTouch\r\n            propertyConnections[part] = part:GetPropertyChangedSignal('CanTouch'):Connect(function()\r\n                if blockLavaEnabled and revision == token and part.Parent and part.CanTouch then\r\n                    part.CanTouch = false\r\n                end\r\n            end)\r\n        end\r\n        if part.CanTouch then part.CanTouch = false end\r\n    end\r\n\r\n    local function queueWorldPatch(part, token)\r\n        if not blockLavaEnabled or revision ~= token or not part or queued[part] then return end\r\n        queued[part] = true\r\n        task.defer(function()\r\n            queued[part] = nil\r\n            applyWorldPatch(part, token)\r\n        end)\r\n    end\r\n\r\n    local function restoreWorldPatch()\r\n        for _, connection in ipairs(globalConnections) do\r\n            pcall(function() connection:Disconnect() end)\r\n        end\r\n        table.clear(globalConnections)\r\n        for part, connection in pairs(propertyConnections) do\r\n            pcall(function() connection:Disconnect() end)\r\n            propertyConnections[part] = nil\r\n        end\r\n        for part, originalCanTouch in pairs(originals) do\r\n            if part and part.Parent then\r\n                pcall(function() part.CanTouch = originalCanTouch end)\r\n            end\r\n            originals[part] = nil\r\n        end\r\n        queued = setmetatable({}, {__mode = 'k'})\r\n    end\r\n\r\n    local function setBlockLavaState(value)\r\n        value = value == true\r\n        if value == blockLavaEnabled then return end\r\n        if value and protectionDisposed then return end\r\n\r\n        revision += 1\r\n        local token = revision\r\n        blockLavaEnabled = value\r\n        if not value then\r\n            restoreWorldPatch()\r\n            return\r\n        end\r\n\r\n        local function isCurrent()\r\n            return blockLavaEnabled and revision == token and KixHubSession.Alive\r\n        end\r\n        table.insert(globalConnections, CollectionService:GetInstanceAddedSignal('OnFirePart'):Connect(function(instance)\r\n            queueWorldPatch(instance, token)\r\n        end))\r\n        table.insert(globalConnections, workspace.DescendantAdded:Connect(function(instance)\r\n            if CollectionService:HasTag(instance, 'OnFirePart') then\r\n                queueWorldPatch(instance, token)\r\n            end\r\n        end))\r\n\r\n        task.spawn(function()\r\n            local taggedParts = CollectionService:GetTagged('OnFirePart')\r\n            for index, part in ipairs(taggedParts) do\r\n                if not isCurrent() then return end\r\n                queueWorldPatch(part, token)\r\n                if index % 32 == 0 then task.wait() end\r\n            end\r\n        end)\r\n    end\r\n\r\n    _G.SetBlockLavaState = setBlockLavaState\r\n\r\n    -- Preserve KixDev's existing default-on behavior; cleanup turns it off cleanly.\r\n    task.spawn(function()\r\n        task.wait(0.1)\r\n        if not protectionDisposed then setBlockLavaState(true) end\r\n    end)\r\nend\r\n_G.KixEngines.CleanupProtection = function()\r\n    protectionDisposed = true\r\n    _G.KixEngines.SemiGodMode(false)\r\n    if _G.SetBlockLavaState then _G.SetBlockLavaState(false) end\r\n    for _, connection in pairs(_semiGodRespawnConnections) do\r\n        if typeof(connection) == \"RBXScriptConnection\" then connection:Disconnect() end\r\n    end\r\n    table.clear(_semiGodRespawnConnections)\r\nend\r\n\r\nend -- Private protection scope\r\n\r\n--========================================================--\r\n-- KILL AURA\r\n--========================================================--\r\nlocal ALIEN_TECH_COMBAT_RANGE = 5\r\nlocal ALIEN_TECH_SIDE_OFFSET = 3\r\n\r\nlocal function setCombatTargetPose(root, target, defaultVerticalOffset)\r\n    if not root or not target or not target.Parent then return false end\r\n    local model = target:IsA('Model') and target or target:FindFirstAncestorOfClass('Model')\r\n    local targetRoot = target:IsA('BasePart') and target\r\n        or (model and model:FindFirstChild('HumanoidRootPart'))\r\n    if not targetRoot then return false end\r\n\r\n    if _G.AlienTechCombatEnabled then\r\n        local rotation = targetRoot.CFrame.Rotation\r\n        local sidePosition = targetRoot.Position\r\n            + (targetRoot.CFrame.RightVector * ALIEN_TECH_SIDE_OFFSET)\r\n        root.CFrame = CFrame.new(sidePosition) * rotation\r\n    else\r\n        local pos = targetRoot.Position\r\n        root.CFrame = CFrame.new(pos.X, pos.Y + (defaultVerticalOffset or 0), pos.Z)\r\n    end\r\n    return true\r\nend\r\n\r\n_G.KixSetNativeCameraSubject = function(subject)\r\n    local camera = workspace.CurrentCamera\r\n    if not camera or typeof(subject) ~= \"Instance\" or not subject.Parent then\r\n        return false\r\n    end\r\n    if not (subject:IsA(\"Humanoid\") or subject:IsA(\"BasePart\")) then\r\n        return false\r\n    end\r\n    if _G.AlienTechCombatEnabled then\r\n        local subjectModel = subject:IsA('Humanoid') and subject.Parent\r\n            or subject:FindFirstAncestorOfClass('Model')\r\n        local characters = workspace:FindFirstChild('Characters')\r\n        if subjectModel and characters and subjectModel:IsDescendantOf(characters) then\r\n            local ownCharacter = _LocalPlayer and _LocalPlayer.Character\r\n            local ownHumanoid = ownCharacter and ownCharacter:FindFirstChildOfClass('Humanoid')\r\n            if ownHumanoid and camera.CameraType ~= Enum.CameraType.Scriptable then\r\n                camera.CameraType = Enum.CameraType.Custom\r\n                camera.CameraSubject = ownHumanoid\r\n            end\r\n            return false\r\n        end\r\n    end\r\n    -- Leave Scriptable camera owners, especially Auto Stronghold, untouched.\r\n    if camera.CameraType == Enum.CameraType.Scriptable then return false end\r\n    if camera.CameraType ~= Enum.CameraType.Custom then\r\n        camera.CameraType = Enum.CameraType.Custom\r\n    end\r\n    if camera.CameraSubject ~= subject then\r\n        camera.CameraSubject = subject\r\n    end\r\n    return true\r\nend\r\n\r\nTabs.Combat:Section({\r\n    Title = 'Aura',\r\n    Icon = 'star'\r\n})\r\n\r\nlocal killAuraExclude = {}\r\n\r\nlocal toggleChopAura\r\n\r\nlocal killAuraLoopRunning = false\r\nlocal killAuraObservedMaxHealth = setmetatable({}, {__mode = 'k'})\r\n\r\nlocal function getKillAuraHealthRatio(target)\r\n    if not target then return nil end\r\n    local health = target:GetAttribute('Health')\r\n    local maxHealth = target:GetAttribute('MaxHealth')\r\n    local npcHealth = target:FindFirstChild('NPC')\r\n    local humanoid = npcHealth and npcHealth:IsA('Humanoid')\r\n        and npcHealth or target:FindFirstChildWhichIsA('Humanoid')\r\n    if humanoid then\r\n        health = humanoid.Health\r\n        maxHealth = humanoid.MaxHealth\r\n    end\r\n    if type(health) ~= 'number' and humanoid then health = humanoid.Health end\r\n    if type(maxHealth) ~= 'number' and humanoid then maxHealth = humanoid.MaxHealth end\r\n    local healthValue = target:FindFirstChild('Health')\r\n    if healthValue and (healthValue:IsA('IntValue') or healthValue:IsA('NumberValue')) then\r\n        health = healthValue.Value\r\n    end\r\n    if type(health) ~= 'number' then return nil end\r\n    local observedMax = killAuraObservedMaxHealth[target]\r\n    if type(observedMax) ~= 'number' or health > observedMax then observedMax = health end\r\n    killAuraObservedMaxHealth[target] = observedMax\r\n    if type(maxHealth) ~= 'number' or maxHealth < health then\r\n        maxHealth = humanoid and humanoid.MaxHealth or nil\r\n    end\r\n    if type(maxHealth) ~= 'number' or maxHealth < health then maxHealth = observedMax end\r\n    if maxHealth <= 0 then return nil end\r\n    return math.clamp(health / maxHealth, 0, 1)\r\nend\r\n\r\nlocal function findKillAuraEnergyWeapon(character)\r\n    local handle = character and character:FindFirstChild('ToolHandle')\r\n    local original = handle and handle:FindFirstChild('OriginalItem')\r\n    local held = original and original:IsA('ObjectValue') and original.Value\r\n    if held and (held.Name == 'Raygun' or held.Name == 'Laser Cannon')\r\n        and held:GetAttribute('ToolName') == 'Firearm'\r\n        and held:GetAttribute('AmmoType') == 'Energy' then\r\n        return held\r\n    end\r\n    local inventory = _LocalPlayer:FindFirstChild('Inventory')\r\n    if not inventory then return nil end\r\n    for _, item in ipairs(inventory:GetChildren()) do\r\n        if item:GetAttribute('ToolName') == 'Firearm'\r\n            and item:GetAttribute('AmmoType') == 'Energy'\r\n            and (item.Name == 'Raygun' or item.Name == 'Laser Cannon') then\r\n            return item\r\n        end\r\n    end\r\n    return nil\r\nend\r\n\r\nlocal function fireKillAuraEnergyWeapon(model, target)\r\n    local inventoryHandler = Client and Client.InventoryHandler\r\n    local getEquippedClass = inventoryHandler and inventoryHandler.GetCurrentlyEquippedClass\r\n    if type(getEquippedClass) ~= 'function' then return false end\r\n    local ok, equippedClass = pcall(getEquippedClass)\r\n    local toolClass = ok and equippedClass and equippedClass.Tool\r\n    if not (ok and equippedClass and equippedClass.Model == model\r\n        and type(toolClass) == 'table' and type(toolClass.Fire) == 'function') then\r\n        return false\r\n    end\r\n    local barrel = toolClass.Model:FindFirstChild('Barrel')\r\n    pcall(function()\r\n        local firstPerson = Client and Client.FirstPer