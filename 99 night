volcano =\r\n                    landmarks\r\n                    and landmarks:FindFirstChild(\"Volcano\")\r\n\r\n                local functional =\r\n                    volcano\r\n                    and volcano:FindFirstChild(\"Functional\")\r\n\r\n                local lava =\r\n                    functional\r\n                    and functional:FindFirstChild(\"Lava\")\r\n\r\n                if\r\n                    lava\r\n                    and lava:IsA(\"BasePart\")\r\n                then\r\n\r\n                    return\r\n                        lava.Position\r\n                        + Vector3.new(0, 1.5, 0)\r\n                end\r\n\r\n                return nil\r\n            end)\r\n\r\n        if ok and targetPos then\r\n            _G.CachedVolcanoPos = targetPos\r\n            return targetPos\r\n        end\r\n\r\n        return nil\r\n    end\r\n\r\n    -- =========================================================\r\n    -- COLLECT CORPSES\r\n    -- =========================================================\r\n\r\n    local function getAvailableCorpses()\r\n\r\n        local corpses = {}\r\n\r\n        -- =============================================\r\n        -- CHARACTERS\r\n        -- =============================================\r\n\r\n        local chars =\r\n            _Workspace:FindFirstChild(\"Characters\")\r\n\r\n        if chars then\r\n\r\n            for _, c in ipairs(chars:GetChildren()) do\r\n\r\n                if\r\n                    c:IsA(\"Model\")\r\n                    and c.Name ~= _LocalPlayer.Name\r\n                    and isEnemy(c.Name)\r\n                    and isDeadCorpse(c)\r\n                    and c:GetAttribute(\"Interaction\") ~= nil\r\n                    and not c:GetAttribute(\"Burning\")\r\n                    and isSacrificeAllowed(c.Name)\r\n                then\r\n\r\n                    table.insert(\r\n                        corpses,\r\n                        c\r\n                    )\r\n                end\r\n            end\r\n        end\r\n\r\n        -- =============================================\r\n        -- ITEMS\r\n        -- =============================================\r\n\r\n        local itemsFolder =\r\n            (\r\n                _Workspace:FindFirstChild(\"Items\")\r\n                or _Workspace:FindFirstChild(\"items\")\r\n            )\r\n\r\n        if itemsFolder then\r\n\r\n            for _, c in ipairs(\r\n                itemsFolder:GetChildren()\r\n            ) do\r\n\r\n                if\r\n                    c:IsA(\"Model\")\r\n                    and isEnemy(c.Name)\r\n                    and isDeadCorpse(c)\r\n                    and c:GetAttribute(\"Interaction\") ~= nil\r\n                    and not c:GetAttribute(\"Burning\")\r\n                    and isSacrificeAllowed(c.Name)\r\n                then\r\n\r\n                    table.insert(\r\n                        corpses,\r\n                        c\r\n                    )\r\n                end\r\n            end\r\n        end\r\n\r\n        return corpses\r\n    end\r\n\r\n    -- =========================================================\r\n    -- THROW TO VOLCANO\r\n    -- =========================================================\r\n\r\n    local function sacrificeCorpsesToVolcano()\r\n\r\n        local targetPos =\r\n            getVolcanoTarget()\r\n\r\n        if not targetPos then\r\n            return false\r\n        end\r\n\r\n        local corpses =\r\n            getAvailableCorpses()\r\n\r\n        if #corpses == 0 then\r\n            return true\r\n        end\r\n\r\n        local oldAntiVoid =\r\n            _G.AntiVoidItemsEnabled\r\n\r\n        _G.AntiVoidItemsEnabled = false\r\n        local allHandled = true\r\n\r\n        for _, corpse in ipairs(corpses) do\r\n            if not KixHubSession.Alive then\r\n                allHandled = false\r\n                break\r\n            end\r\n            if corpse and corpse.Parent then\r\n                local moveOk, moved = pcall(dragItemSmooth, corpse, targetPos)\r\n                if moveOk and moved then\r\n                    local burnDeadline = os.clock() + 3\r\n                    while corpse.Parent and corpse:IsDescendantOf(_Workspace)\r\n                        and corpse:GetAttribute(\"Burning\") ~= true\r\n                        and os.clock() < burnDeadline do\r\n                        task.wait(0.1)\r\n                    end\r\n                    if corpse.Parent and corpse:IsDescendantOf(_Workspace)\r\n                        and corpse:GetAttribute(\"Burning\") ~= true then\r\n                        allHandled = false\r\n                    end\r\n                elseif corpse.Parent then\r\n                    allHandled = false\r\n                end\r\n                if not allHandled then task.wait(0.4) end\r\n            end\r\n        end\r\n\r\n        _G.AntiVoidItemsEnabled =\r\n            oldAntiVoid\r\n\r\n        return allHandled\r\n    end\r\n\r\n    -- =========================================================\r\n    -- VISIT VOLCANO ONCE AND RESTORE PLAYER POSITION\r\n    -- =========================================================\r\n\r\n    local function visitVolcanoAndReturn()\r\n        local map = workspace:FindFirstChild(\"Map\")\r\n        local landmarks = map and map:FindFirstChild(\"Landmarks\")\r\n        local volcano = landmarks and landmarks:FindFirstChild(\"Volcano\")\r\n        if not volcano and landmarks then\r\n            volcano = landmarks:WaitForChild(\"Volcano\", 2)\r\n        end\r\n        if not volcano then return false end\r\n\r\n        local character = _LocalPlayer.Character\r\n        local hrp = character and character:FindFirstChild(\"HumanoidRootPart\")\r\n        if not hrp then return false end\r\n        local originCFrame = hrp.CFrame\r\n        local originVelocity = hrp.AssemblyLinearVelocity\r\n        local originAngularVelocity = hrp.AssemblyAngularVelocity\r\n\r\n        local offset = CFrame.new(133.83309936523438, -3.1000030040740967, 124.9095458984375)\r\n            * CFrame.Angles(-3.1415927410125732, 0.009690151549875736, 3.141592502593994)\r\n        local volcanoCFrame\r\n        local targetResolved = pcall(function()\r\n            volcanoCFrame = volcano:GetPivot() * offset\r\n        end)\r\n        if not targetResolved then return false end\r\n        local teleported = pcall(function()\r\n            hrp.CFrame = volcanoCFrame\r\n        end)\r\n        if not teleported then return false end\r\n        pcall(function()\r\n            hrp.AssemblyLinearVelocity = Vector3.zero\r\n            hrp.AssemblyAngularVelocity = Vector3.zero\r\n        end)\r\n\r\n        if WindUI then\r\n            pcall(function()\r\n                WindUI:Notify({Title = \"Volcano\", Content = \"Volcano unavailable; visiting it and retrying once...\", Duration = 3})\r\n            end)\r\n        end\r\n        task.wait(1)\r\n\r\n        local returnRoot = hrp.Parent and hrp\r\n        if not returnRoot then\r\n            local currentCharacter = _LocalPlayer.Character\r\n            returnRoot = currentCharacter and currentCharacter:FindFirstChild(\"HumanoidRootPart\")\r\n        end\r\n        if not returnRoot then return false end\r\n\r\n        local restored = pcall(function()\r\n            returnRoot.CFrame = originCFrame\r\n            returnRoot.AssemblyLinearVelocity = originVelocity\r\n            returnRoot.AssemblyAngularVelocity = originAngularVelocity\r\n        end)\r\n        if restored then task.wait(0.15) end\r\n        return restored\r\n    end\r\n\r\n    -- =========================================================\r\n    -- FALLBACK CAMPFIRE\r\n    -- =========================================================\r\n\r\n    local function bringCorpsesToCampfire()\r\n\r\n        local corpses =\r\n            getAvailableCorpses()\r\n\r\n        if #corpses == 0 then\r\n            return true\r\n        end\r\n\r\n        local campfire = nil\r\n        local campfirePivot = nil\r\n        local campfireTouchZone = nil\r\n        local fireOk = pcall(function()\r\n            local map = _Workspace:FindFirstChild(\"Map\")\r\n            local campground = map and map:FindFirstChild(\"Campground\")\r\n            campfire = campground and campground:FindFirstChild(\"MainFire\")\r\n            if campfire and (campfire:IsA(\"Model\") or campfire:IsA(\"BasePart\")) then\r\n                campfirePivot = campfire:GetPivot()\r\n                campfireTouchZone = campfire:FindFirstChild(\"InnerTouchZone\")\r\n            end\r\n        end)\r\n\r\n        if not fireOk or not campfire or not campfirePivot\r\n            or not campfireTouchZone or not campfireTouchZone:IsA(\"BasePart\") then\r\n            if WindUI and not _G.KixSacrificeCampfireWarned then\r\n                _G.KixSacrificeCampfireWarned = true\r\n                pcall(function()\r\n                    WindUI:Notify({\r\n                        Title = \"Campfire\",\r\n                        Content = \"Campfire burn zone is not loaded; corpses were left in place.\",\r\n                        Duration = 4\r\n                    })\r\n                end)\r\n            end\r\n            return false\r\n        end\r\n        _G.KixSacrificeCampfireWarned = false\r\n\r\n        if not _G.KixCampfireCorpseRetryAt then\r\n            _G.KixCampfireCorpseRetryAt = setmetatable({}, {__mode = \"k\"})\r\n        end\r\n\r\n        local moved = 0\r\n        for index, corpse in ipairs(corpses) do\r\n            if not KixHubSession.Alive then break end\r\n\r\n            if corpse and corpse.Parent then\r\n                local lastAttempt = _G.KixCampfireCorpseRetryAt[corpse]\r\n                if corpse:GetAttribute(\"Burning\") == true then\r\n                    _G.KixCampfireCorpseRetryAt[corpse] = nil\r\n                elseif type(lastAttempt) == \"number\" and os.clock() - lastAttempt < 8 then\r\n                    -- Wait for the unresolved body before sending another into the zone.\r\n                    break\r\n                elseif corpse:GetAttribute(\"Locked\") ~= true\r\n                    and corpse:GetAttribute(\"IceBlock\") ~= true then\r\n                    local originalParent = corpse.Parent\r\n                    -- Match the established touch-zone drop: place above the inner\r\n                    -- burn volume, settle briefly, then let the game's fire physics run.\r\n                    local targetCFrame = CFrame.new(campfireTouchZone.Position\r\n                        + Vector3.new(0, campfireTouchZone.Size.Y / 2 + 8, 0))\r\n                    local settleStarted = 0\r\n                    local settleCount = 0\r\n                    local deliveredToFire = false\r\n                    local didMove = false\r\n\r\n                    if _G.KixItemTransportSystem\r\n                        and type(_G.KixItemTransportSystem.Move) == \"function\" then\r\n                        local moveOk, moveResult = pcall(function()\r\n                            return _G.KixItemTransportSystem.Move(\r\n                                corpse,\r\n                                targetCFrame,\r\n                                function()\r\n                                    return KixHubSession.Alive\r\n                                        and corpse.Parent == originalParent\r\n                                        and corpse:GetAttribute(\"Locked\") ~= true\r\n                                        and corpse:GetAttribute(\"IceBlock\") ~= true\r\n                                        and campfire.Parent ~= nil\r\n                                        and campfireTouchZone.Parent == campfire\r\n                                        and campfire:IsDescendantOf(_Workspace)\r\n                                end,\r\n                                function()\r\n                                    deliveredToFire = true\r\n                                    settleStarted = os.clock()\r\n                                end,\r\n                                function(item)\r\n                                    local elapsed = os.clock() - settleStarted\r\n                                    local primary = item.PrimaryPart\r\n                                    if not primary or not campfire.Parent\r\n                                        or campfireTouchZone.Parent ~= campfire then\r\n                                        return false\r\n                                    end\r\n                                    if elapsed < 0.25 or settleCount < 3 then\r\n                                        settleCount += 1\r\n                                        item:PivotTo(targetCFrame)\r\n                                        primary.AssemblyLinearVelocity = Vector3.zero\r\n                                        return true\r\n                                    end\r\n                                    return elapsed < 0.85\r\n                                        or primary.AssemblyLinearVelocity.Magnitude > 1\r\n                                end,\r\n                                true\r\n                            )\r\n                        end)\r\n                        -- The server may consume/reparent the corpse during delivery,\r\n                        -- which invalidates transport ownership after the drop began.\r\n                        didMove = moveOk and (moveResult == true or deliveredToFire)\r\n                    end\r\n\r\n                    if didMove then\r\n                        local burnDeadline = os.clock() + 3\r\n                        while corpse.Parent and corpse:IsDescendantOf(_Workspace)\r\n                            and corpse:GetAttribute(\"Burning\") ~= true\r\n                            and os.clock() < burnDeadline do\r\n                            task.wait(0.1)\r\n                        end\r\n                        if not corpse.Parent or not corpse:IsDescendantOf(_Workspace)\r\n                            or corpse:GetAttribute(\"Burning\") == true then\r\n                            moved += 1\r\n                            _G.KixCampfireCorpseRetryAt[corpse] = nil\r\n                        else\r\n                            _G.KixCampfireCorpseRetryAt[corpse] = os.clock()\r\n                            break\r\n                        end\r\n                    else\r\n                        _G.KixCampfireCorpseRetryAt[corpse] = os.clock()\r\n                        break\r\n                    end\r\n                end\r\n            end\r\n\r\n            if index < #corpses then task.wait(0.4) end\r\n        end\r\n\r\n        return moved > 0\r\n    end\r\n\r\n    _G.KixBringCorpsesToCampfire = bringCorpsesToCampfire\r\n\r\n    -- =========================================================\r\n    -- BACKGROUND LOOP\r\n    -- =========================================================\r\n\r\n    while KixHubSession.Alive do\r\n\r\n        -- =====================================================\r\n        -- CORPSE\r\n        -- EVERY 30 MINUTES\r\n        -- =====================================================\r\n\r\n        if\r\n            _G.AutoBringCorpseToCampfireEnabled\r\n            and (\r\n                os.time() - lastCorpseRun\r\n            ) >= corpseCycleSeconds\r\n        then\r\n\r\n            lastCorpseRun =\r\n                os.time()\r\n\r\n            task.spawn(function()\r\n\r\n                -- =============================================\r\n                -- PRIORITY 1: VOLCANO\r\n                -- =============================================\r\n\r\n                local volcanoSuccess =\r\n                    sacrificeCorpsesToVolcano()\r\n\r\n                if not volcanoSuccess and _G.AutoBringCorpseToCampfireEnabled then\r\n                    if visitVolcanoAndReturn() then\r\n                        volcanoSuccess = sacrificeCorpsesToVolcano()\r\n                    end\r\n                end\r\n\r\n                -- =============================================\r\n                -- FALLBACK: CAMPFIRE\r\n                -- =============================================\r\n\r\n                if\r\n                    not volcanoSuccess\r\n                    and _G.AutoBringCorpseToCampfireEnabled\r\n                then\r\n\r\n                    bringCorpsesToCampfire()\r\n                end\r\n\r\n            end)\r\n        end\r\n\r\n        -- Check setiap 30 detik\r\n        task.wait(30)\r\n    end\r\nend)\r\n\r\nTabs.Home:Toggle({\r\n    Title = '📊 HUD (FPS, Ping, Stats)',\r\n    Desc = 'Shows FPS, Ping, Campfire, and Stronghold in the top right corner.',\r\n    Value = _G.HUDOn,\r\n    Callback = function(state)\r\n        _G.HUDOn = state\r\n        hudFps.Visible = state\r\n        hudPing.Visible = state\r\n        hudCampfire.Visible = state\r\n        hudStronghold.Visible = state\r\n    end\r\n})\r\n\r\n-- ==================== INFORMATION TAB ====================\r\nTabs.Info:Section({Title = 'KIX HUB'})\r\nTabs.Info:Paragraph({\r\n    Title = 'Main Founder',\r\n    Desc = 'Script Made by Kixdev using WindUI'\r\n})\r\n\r\nTabs.Info:Paragraph({\r\n    Title = 'KIXDEV HUB 99 Nights in the Forest'\r\n})\r\nTabs.Info:Paragraph({\r\n    Title = 'Discord',\r\n    Desc = 'Join our discord for more Information!',\r\n    Buttons = {\r\n        {\r\n            Icon = 'copy',\r\n            Title = 'Copy Link',\r\n            Callback = function()\r\n                setclipboard('https://discord.gg/9FgdcXq8vQ')\r\n                WindUI:Notify({Title=\"Discord\", Content=\"Link Copied!\", Duration=3})\r\n            end,\r\n        },\r\n    },\r\n})\r\n\r\n-- ==================== MAP REVEAL ====================\r\nAutoMapReveal = {\r\n    State = {\r\n        IsScanning = false,\r\n        IsCompleting = false,\r\n        Is4LayersMode = false,\r\n        CurrentIndex = 0,\r\n        TotalWaypoints = 0,\r\n        Speed = 100,     -- Default reveal speed (studs/s)\r\n        Height = 90,\r\n        Step = 80,       -- Jarak Z antar baris (2 cell * 40)\r\n        ElapsedSeconds = 0,\r\n        ResumePos = nil\r\n    },\r\n    ThreeLayersState = {\r\n        ResumePos = nil,\r\n        ResumeCFrame = nil,\r\n        CurrentIndex = 0,\r\n        TotalWaypoints = 0,\r\n        ElapsedSeconds = 0,\r\n        Waypoints = {}\r\n    },\r\n    Waypoints = {},\r\n    TweenInstance = nil,\r\n    CampfirePos = Vector3.new(0.43, 15.77, -1.88)\r\n}\r\n\r\nfunction AutoMapReveal.BeginPoseLock(rotation)\r\n    local character = _LocalPlayer.Character\r\n    local humanoid = character and character:FindFirstChildOfClass(\"Humanoid\")\r\n    local root = character and character:FindFirstChild(\"HumanoidRootPart\")\r\n    if not character or not humanoid or not root then return false end\r\n\r\n    local animateScript = character:FindFirstChild(\"Animate\")\r\n    local animateDisabled\r\n    if animateScript and animateScript:IsA(\"LocalScript\") then animateDisabled = animateScript.Disabled end\r\n    local runningSound = root:FindFirstChild(\"Running\")\r\n    AutoMapReveal.PoseLockSnapshot = {\r\n        Character = character,\r\n        Humanoid = humanoid,\r\n        Animate = animateScript,\r\n        AnimateDisabled = animateDisabled,\r\n        AutoRotate = humanoid.AutoRotate,\r\n        PlatformStand = humanoid.PlatformStand,\r\n        RunningEnabled = humanoid:GetStateEnabled(Enum.HumanoidStateType.Running),\r\n        ClimbingEnabled = humanoid:GetStateEnabled(Enum.HumanoidStateType.Climbing),\r\n        FallingDownEnabled = humanoid:GetStateEnabled(Enum.HumanoidStateType.FallingDown),\r\n        FreefallEnabled = humanoid:GetStateEnabled(Enum.HumanoidStateType.Freefall),\r\n        RunningVolume = runningSound and runningSound:IsA(\"Sound\") and runningSound.Volume or nil,\r\n        RunningSound = runningSound,\r\n    }\r\n\r\n    local poseRotation = typeof(rotation) == \"CFrame\" and rotation.Rotation or root.CFrame.Rotation\r\n    AutoMapReveal.State.PoseRotation = poseRotation\r\n    _G.KixMapRevealPoseLock = true\r\n    humanoid.AutoRotate = false\r\n    humanoid.PlatformStand = true\r\n\r\n    if animateScript and animateScript:IsA(\"LocalScript\") then\r\n        animateScript.Disabled = true\r\n    end\r\n\r\n    local animator = humanoid:FindFirstChildOfClass(\"Animator\")\r\n    if animator then\r\n        for _, track in ipairs(animator:GetPlayingAnimationTracks()) do\r\n            pcall(function() track:Stop(0) end)\r\n        end\r\n        if AutoMapReveal.PoseAnimationConnection then\r\n            AutoMapReveal.PoseAnimationConnection:Disconnect()\r\n        end\r\n        AutoMapReveal.PoseAnimationConnection = animator.AnimationPlayed:Connect(function(track)\r\n            pcall(function() track:Stop(0) end)\r\n        end)\r\n    end\r\n\r\n    if MyCustomAnimator then MyCustomAnimator:Stop() end\r\n    local poseJoints = {}\r\n    for _, descendant in ipairs(character:GetDescendants()) do\r\n        if descendant:IsA(\"Motor6D\") then\r\n            poseJoints[#poseJoints + 1] = descendant\r\n            descendant.Transform = CFrame.new()\r\n        end\r\n    end\r\n    if AutoMapReveal.PoseEnforceConnection then\r\n        AutoMapReveal.PoseEnforceConnection:Disconnect()\r\n    end\r\n    local enforceConnection\r\n    enforceConnection = _RunService.RenderStepped:Connect(function()\r\n        if not _G.KixMapRevealPoseLock or _LocalPlayer.Character ~= character or not character.Parent then\r\n            enforceConnection:Disconnect()\r\n            if AutoMapReveal.PoseEnforceConnection == enforceConnection then\r\n                AutoMapReveal.PoseEnforceConnection = nil\r\n            end\r\n            return\r\n        end\r\n        for _, joint in ipairs(poseJoints) do\r\n            if joint.Parent then joint.Transform = CFrame.new() end\r\n        end\r\n        local currentRoot = character:FindFirstChild(\"HumanoidRootPart\")\r\n        if currentRoot then\r\n            currentRoot.AssemblyLinearVelocity = Vector3.zero\r\n            currentRoot.AssemblyAngularVelocity = Vector3.zero\r\n        end\r\n    end)\r\n    AutoMapReveal.PoseEnforceConnection = enforceConnection\r\n    return true\r\nend\r\n\r\nfunction AutoMapReveal.ReleasePoseLock()\r\n    _G.KixMapRevealPoseLock = false\r\n    AutoMapReveal.State.PoseRotation = nil\r\n    if AutoMapReveal.PoseEnforceConnection then\r\n        AutoMapReveal.PoseEnforceConnection:Disconnect()\r\n        AutoMapReveal.PoseEnforceConnection = nil\r\n    end\r\n    if AutoMapReveal.PoseAnimationConnection then\r\n        AutoMapReveal.PoseAnimationConnection:Disconnect()\r\n        AutoMapReveal.PoseAnimationConnection = nil\r\n    end\r\n    if MyCustomAnimator then MyCustomAnimator:Stop() end\r\n\r\n    local snapshot = AutoMapReveal.PoseLockSnapshot\r\n    AutoMapReveal.PoseLockSnapshot = nil\r\n    if not snapshot then return end\r\n    pcall(function()\r\n        local humanoid = snapshot.Humanoid\r\n        if humanoid and humanoid.Parent then\r\n            humanoid:SetStateEnabled(Enum.HumanoidStateType.Running, snapshot.RunningEnabled)\r\n            humanoid:SetStateEnabled(Enum.HumanoidStateType.Climbing, snapshot.ClimbingEnabled)\r\n            humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, snapshot.FallingDownEnabled)\r\n            humanoid:SetStateEnabled(Enum.HumanoidStateType.Freefall, snapshot.FreefallEnabled)\r\n            humanoid.AutoRotate = snapshot.AutoRotate\r\n            humanoid.PlatformStand = snapshot.PlatformStand\r\n        end\r\n        if snapshot.Animate and snapshot.Animate.Parent then\r\n            snapshot.Animate.Disabled = snapshot.AnimateDisabled\r\n        end\r\n        if snapshot.RunningSound and snapshot.RunningSound.Parent and snapshot.RunningVolume ~= nil then\r\n            snapshot.RunningSound.Volume = snapshot.RunningVolume\r\n        end\r\n    end)\r\nend\r\n\r\nfunction AutoMapReveal.PoseCFrame(position)\r\n    local rotation = AutoMapReveal.State.PoseRotation\r\n    return CFrame.new(position) * (rotation or CFrame.new())\r\nend\r\n\r\nfunction AutoMapReveal.GetCenterPosition()\r\n    local ok, pos = pcall(function()\r\n        local map = (_Workspace and _Workspace:FindFirstChild(\"Map\")) or workspace:FindFirstChild(\"Map\")\r\n        local landmarks = map and map:FindFirstChild(\"Landmarks\")\r\n        local campfire = landmarks and (landmarks:FindFirstChild(\"Campfire\") or landmarks:FindFirstChild(\"CampFire\"))\r\n        if campfire then\r\n            if campfire:IsA(\"BasePart\") then return campfire.Position end\r\n            if campfire:IsA(\"Model\") then return campfire:GetPivot().Position end\r\n        end\r\n        return nil\r\n    end)\r\n    if ok and pos then return pos end\r\n    return AutoMapReveal.CampfirePos or Vector3.new(0.43, 15.77, -1.88)\r\nend\r\n\r\n-- =========================================================\r\n-- 1. GRID WAYPOINTS (METODE KOTAK STANDAR)\r\n-- =========================================================\r\nfunction AutoMapReveal.GenerateWaypoints()\r\n    AutoMapReveal.Waypoints = {}\r\n    local height = AutoMapReveal.State.Height\r\n    local stepZ = AutoMapReveal.State.Step\r\n    if stepZ < 40 then stepZ = 40 end\r\n\r\n    -- Standard Grid Scan covers the full map to its outer wall (~1385 studs).\r\n    -- The separate circular reveal mode remains capped at the Orange ring.\r\n    local safeRadius = 1385\r\n    local rSquared = safeRadius * safeRadius\r\n    \r\n    local goRight = true\r\n    for z = -safeRadius, safeRadius, stepZ do\r\n        local maxX = math.sqrt(rSquared - (z * z))\r\n        local minX = -maxX\r\n        \r\n        if goRight then\r\n            table.insert(AutoMapReveal.Waypoints, Vector3.new(minX, height, z))\r\n            table.insert(AutoMapReveal.Waypoints, Vector3.new(maxX, height, z))\r\n        else\r\n            table.insert(AutoMapReveal.Waypoints, Vector3.new(maxX, height, z))\r\n            table.insert(AutoMapReveal.Waypoints, Vector3.new(minX, height, z))\r\n        end\r\n        goRight = not goRight\r\n    end\r\n    \r\n    AutoMapReveal.State.TotalWaypoints = #AutoMapReveal.Waypoints\r\nend\r\n\r\n-- =========================================================\r\n-- 2. 3 LAYERS CIRCULAR WAYPOINTS (METODE 3 LINGKARAN)\r\n-- Urutan: Merah (350) -> Biru Muda (700) -> Oren (1050)\r\n-- Altitude: 100 | Speed: 150\r\n-- =========================================================\r\nfunction AutoMapReveal.Generate3LayersWaypoints()\r\n    AutoMapReveal.Waypoints = {}\r\n    local height = 100 -- Ketinggian Altitude set ke 100 sesuai permintaan\r\n    local center = AutoMapReveal.GetCenterPosition()\r\n    local cx = center.X\r\n    local cz = center.Z\r\n\r\n    -- Three allowed concentric radii; Orange at 1050 is the hard maximum.\r\n    -- Layer 1: Merah (Paling dekat Main Fire) = 350 studs\r\n    -- Layer 2: Biru Muda (Ring tengah dalam)   = 700 studs\r\n    -- Layer 3: Oren (Ring tengah luar)        = 1050 studs\r\n    local layers = {\r\n        { Name = \"🔴 (Layer 1)\", Radius = 350 },\r\n        { Name = \"🔵 (Layer 2)\", Radius = 700 },\r\n        { Name = \"🟠 (Layer 3)\", Radius = 1050 }\r\n    }\r\n\r\n    local pointsPerCircle = 36 -- Tiap 10 derajat agar lengkungan lingkaran presisi dan mulus\r\n\r\n    for layerIdx, layer in ipairs(layers) do\r\n        local r = layer.Radius\r\n        for i = 0, pointsPerCircle do\r\n            local angle = math.rad(i * (360 / pointsPerCircle))\r\n            local x = cx + (r * math.cos(angle))\r\n            local z = cz + (r * math.sin(angle))\r\n            table.insert(AutoMapReveal.Waypoints, {\r\n                Pos = Vector3.new(x, height, z),\r\n                LayerName = layer.Name,\r\n                LayerIndex = layerIdx\r\n            })\r\n        end\r\n    end\r\n\r\n    AutoMapReveal.State.TotalWaypoints = #AutoMapReveal.Waypoints\r\nend\r\n-- Keep the legacy name available to existing callers; it now generates only 3 rings.\r\nAutoMapReveal.Generate4LayersWaypoints = AutoMapReveal.Generate3LayersWaypoints\r\n\r\nfunction AutoMapReveal.UpdateProgress(text)\r\n    if AutoMapReveal.ProgressLabel then\r\n        AutoMapReveal.ProgressLabel:SetDesc(text)\r\n    end\r\nend\r\n\r\nfunction AutoMapReveal.MoveTo(targetPosition, customSpeed)\r\n    local character = _LocalPlayer.Character\r\n    local root = character and character:FindFirstChild(\"HumanoidRootPart\")\r\n    if not character or not root then return false end\r\n\r\n    local target = (type(targetPosition) == \"table\" and targetPosition.Pos) or targetPosition\r\n    if typeof(target) ~= \"Vector3\" then return false end\r\n\r\n    local speed = customSpeed or AutoMapReveal.State.Speed or 100\r\n    local startPosition = root.Position\r\n    local startRootCFrame = root.CFrame\r\n    local rootToPivot = character:GetPivot():ToObjectSpace(startRootCFrame)\r\n    local rotation = AutoMapReveal.State.PoseRotation or startRootCFrame.Rotation\r\n    local duration = math.max((target - startPosition).Magnitude / math.max(speed, 1), 0.05)\r\n    local startedAt = os.clock()\r\n    AutoMapReveal.TweenInstance = nil\r\n\r\n    repeat\r\n        if not AutoMapReveal.State.IsScanning or _LocalPlayer.Character ~= character\r\n            or not root.Parent then\r\n            return false\r\n        end\r\n        local alpha = math.clamp((os.clock() - startedAt) / duration, 0, 1)\r\n        local rootCFrame = CFrame.new(startPosition:Lerp(target, alpha)) * rotation\r\n        local modelPivot = rootCFrame * rootToPivot:Inverse()\r\n        local moved = pcall(function()\r\n            character:PivotTo(modelPivot)\r\n            root.AssemblyLinearVelocity = Vector3.zero\r\n            root.AssemblyAngularVelocity = Vector3.zero\r\n        end)\r\n        if not moved then return false end\r\n        if alpha >= 1 then return AutoMapReveal.State.IsScanning end\r\n        _RunService.Heartbeat:Wait()\r\n    until false\r\nend\r\n\r\nfunction AutoMapReveal.ReturnToCampfire(isAborted, is3Layers)\r\n    AutoMapReveal.UpdateProgress(\"Returning to Campfire...\")\r\n    AutoMapReveal.State.IsCompleting = true\r\n    AutoMapReveal.State.IsScanning = false\r\n    AutoMapReveal.State.Is4LayersMode = false\r\n    \r\n    -- Matikan Fly Mode dan sinkronkan UI DULU sebelum teleport\r\n    if type(stopFlying) == \"function\" then pcall(stopFlying) end\r\n    if FlyToggle then\r\n        pcall(function()\r\n            if type(FlyToggle.SetValue) == \"function\" then FlyToggle:SetValue(false) end\r\n            if type(FlyToggle.SetState) == \"function\" then FlyToggle:SetState(false) end\r\n        end)\r\n    end\r\n\r\n    if AutoLayersToggle then\r\n        pcall(function()\r\n            if type(AutoLayersToggle.SetValue) == \"function\" then AutoLayersToggle:SetValue(false) end\r\n            if type(AutoLayersToggle.SetState) == \"function\" then AutoLayersToggle:SetState(false) end\r\n        end)\r\n    end\r\n    if AutoFourLayersToggle then\r\n        pcall(function()\r\n            if type(AutoFourLayersToggle.SetValue) == \"function\" then AutoFourLayersToggle:SetValue(false) end\r\n            if type(AutoFourLayersToggle.SetState) == \"function\" then AutoFourLayersToggle:SetState(false) end\r\n        end)\r\n    end\r\n    \r\n    -- Beri jeda agar fisika terbang benar-benar mati sebelum pindah posisi\r\n                            task.wait(0.75)\r\n    \r\n    local char = _LocalPlayer.Character\r\n    if char then\r\n        local hrp = char:FindFirstChild(\"HumanoidRootPart\")\r\n        if hrp then hrp.CFrame = CFrame.new(AutoMapReveal.CampfirePos) end\r\n    end\r\n    AutoMapReveal.ReleasePoseLock()\r\n    \r\n    if not isAborted then\r\n        AutoMapReveal.State.CurrentIndex = 0\r\n        AutoMapReveal.State.ResumePos = nil\r\n        if AutoMapReveal.ThreeLayersState then\r\n            AutoMapReveal.ThreeLayersState.ResumePos = nil\r\n            AutoMapReveal.ThreeLayersState.ResumeCFrame = nil\r\n            AutoMapReveal.ThreeLayersState.CurrentIndex = 0\r\n            AutoMapReveal.ThreeLayersState.ElapsedSeconds = 0\r\n        end\r\n        AutoMapReveal.State.IsCompleted = true\r\n        AutoMapReveal.State.LastCompletedTime = os.time()\r\n        AutoMapReveal.UpdateProgress(\"Scan finished successfully.\")\r\n        if WindUI then\r\n            pcall(function()\r\n                WindUI:Notify({\r\n                    Title = \"Scan Complete\",\r\n                    Content = is3Layers and \"3-layer reveal completed.\" or \"Grid scan completed.\",\r\n                    Duration = 2.5,\r\n                    Icon = \"check\"\r\n                })\r\n            end)\r\n        end\r\n    else\r\n        local total = AutoMapReveal.State.TotalWaypoints or 1\r\n        local cur = AutoMapReveal.State.CurrentIndex or 0\r\n        local pct = math.floor((cur / math.max(1, total)) * 100)\r\n        local m = math.floor((AutoMapReveal.State.ElapsedSeconds or 0) / 60)\r\n        local s = (AutoMapReveal.State.ElapsedSeconds or 0) % 60\r\n        local timeStr = string.format(\"%02d:%02d\", m, s)\r\n        AutoMapReveal.UpdateProgress(string.format(\"Scan paused at %d%% (%s)\", pct, timeStr))\r\n        if WindUI then\r\n            pcall(function()\r\n                WindUI:Notify({\r\n                    Title = \"Scan Paused\",\r\n                    Content = string.format(\"Paused at %d%%. Re-engage toggle to resume.\", pct),\r\n                    Duration = 2.5,\r\n                    Icon = \"pause\"\r\n                })\r\n            end)\r\n        end\r\n    end\r\n    AutoMapReveal.State.IsCompleting = false\r\nend\r\n\r\n-- =========================================================\r\n-- START 4 LAYERS SCAN (SPEED 250, ALTITUDE 100) DENGAN SISTEM RESUME / PAUSE\r\n-- =========================================================\r\nfunction AutoMapReveal.Start4LayersScan()\r\n    if AutoMapReveal.State.IsScanning or AutoMapReveal.State.IsCompleting then return end\r\n    if _G.KixRescueBusy or _G.KixRescuePending then\r\n        AutoMapReveal.State.IsPausedForRescue = true\r\n        return\r\n    end\r\n    if _G.KixAdapters and _G.KixAdapters.AutoRescue and type(_G.KixAdapters.AutoRescue.IsCarryingKid) == \"function\" then\r\n        if _G.KixAdapters.AutoRescue.IsCarryingKid() then\r\n            AutoMapReveal.State.IsPausedForRescue = true\r\n            return\r\n        end\r\n    end\r\n    AutoMapReveal.State.IsScanning = true\r\n    AutoMapReveal.State.Is4LayersMode = true\r\n\r\n    -- Default to 100; the manual chest flow can temporarily override speed.\r\n    AutoMapReveal.State.Speed = tonumber(AutoMapReveal.State.SpeedOverride) or 100\r\n    AutoMapReveal.State.Height = 100\r\n\r\n    local isResuming = false\r\n    if AutoMapReveal.ThreeLayersState\r\n        and AutoMapReveal.ThreeLayersState.ResumePos ~= nil\r\n        and AutoMapReveal.ThreeLayersState.CurrentIndex ~= nil\r\n        and AutoMapReveal.ThreeLayersState.CurrentIndex > 0\r\n        and AutoMapReveal.ThreeLayersState.CurrentIndex <= (AutoMapReveal.ThreeLayersState.TotalWaypoints or 0) then\r\n        isResuming = true\r\n    end\r\n\r\n    if isResuming then\r\n        -- RESUME MODE: Muat kembali waypoints dan posisi yang tersimpan\r\n        AutoMapReveal.Waypoints = AutoMapReveal.ThreeLayersState.Waypoints or {}\r\n        if #AutoMapReveal.Waypoints == 0 then\r\n            AutoMapReveal.Generate3LayersWaypoints()\r\n            AutoMapReveal.ThreeLayersState.Waypoints = AutoMapReveal.Waypoints\r\n        end\r\n        AutoMapReveal.State.TotalWaypoints = AutoMapReveal.ThreeLayersState.TotalWaypoints or #AutoMapReveal.Waypoints\r\n        AutoMapReveal.State.CurrentIndex = AutoMapReveal.ThreeLayersState.CurrentIndex\r\n        AutoMapReveal.State.ElapsedSeconds = AutoMapReveal.ThreeLayersState.ElapsedSeconds or 0\r\n\r\n        local pct = math.floor((AutoMapReveal.State.CurrentIndex / math.max(1, AutoMapReveal.State.TotalWaypoints)) * 100)\r\n        AutoMapReveal.UpdateProgress(string.format(\"Resuming 4-layer reveal from %d%%...\", pct))\r\n        if WindUI then\r\n            pcall(function()\r\n                WindUI:Notify({\r\n                    Title = \"Scan Resumed\",\r\n                    Content = string.format(\"Resuming from %d%%.\", pct),\r\n                    Duration = 2,\r\n                    Icon = \"play\"\r\n                })\r\n            end)\r\n        end\r\n    else\r\n        -- FRESH SCAN MODE: Mulai baru dari 0%\r\n        AutoMapReveal.State.ElapsedSeconds = 0\r\n        AutoMapReveal.State.CurrentIndex = 1\r\n        AutoMapReveal.Generate3LayersWaypoints()\r\n        AutoMapReveal.ThreeLayersState = {\r\n            ResumePos = nil,\r\n            ResumeCFrame = nil,\r\n            CurrentIndex = 1,\r\n            TotalWaypoints = AutoMapReveal.State.TotalWaypoints,\r\n            ElapsedSeconds = 0,\r\n            Waypoints = AutoMapReveal.Waypoints\r\n        }\r\n        AutoMapReveal.UpdateProgress(string.format(\r\n            \"Starting 3-Layer Reveal (Orange max 1050, Speed %d, Alt 100)...\",\r\n            AutoMapReveal.State.Speed\r\n        ))\r\n    end\r\n\r\n    local resumeCFrame = AutoMapReveal.ThreeLayersState\r\n        and AutoMapReveal.ThreeLayersState.ResumeCFrame\r\n    AutoMapReveal.BeginPoseLock(isResuming and resumeCFrame or nil)\r\n\r\n    if type(startFlying) == \"function\" then startFlying() end\r\n    if FlyToggle then\r\n        pcall(function()\r\n            if type(FlyToggle.SetValue) == \"function\" then FlyToggle:SetValue(true) end\r\n            if type(FlyToggle.SetState) == \"function\" then FlyToggle:SetState(true) end\r\n        end)\r\n    end\r\n\r\n    -- Tracker Loop\r\n    task.spawn(function()\r\n        while AutoMapReveal.State.IsScanning and AutoMapReveal.State.Is4LayersMode do\r\n            task.wait(1)\r\n            if AutoMapReveal.State.IsScanning and AutoMapReveal.State.Is4LayersMode then\r\n                AutoMapReveal.State.ElapsedSeconds = AutoMapReveal.State.ElapsedSeconds + 1\r\n                if AutoMapReveal.ThreeLayersState then\r\n                    AutoMapReveal.ThreeLayersState.ElapsedSeconds = AutoMapReveal.State.ElapsedSeconds\r\n                end\r\n                local pct = 0\r\n                if AutoMapReveal.State.TotalWaypoints > 0 then\r\n                    pct = math.floor((AutoMapReveal.State.CurrentIndex / AutoMapReveal.State.TotalWaypoints) * 100)\r\n                end\r\n                local m = math.floor(AutoMapReveal.State.ElapsedSeconds / 60)\r\n                local s = AutoMapReveal.State.ElapsedSeconds % 60\r\n                local timeStr = string.format(\"%02d:%02d\", m, s)\r\n                \r\n                local currentWP = AutoMapReveal.Waypoints[AutoMapReveal.State.CurrentIndex]\r\n                local layerInfo = (currentWP and type(currentWP) == \"table\" and currentWP.LayerName) and (\" [\" .. currentWP.LayerName .. \"]\") or \"\"\r\n                AutoMapReveal.UpdateProgress(string.format(\"3-Layers: %d%%%s (Time: %s)\", pct, layerInfo, timeStr))\r\n            end\r\n        end\r\n    end)\r\n\r\n    -- Flight Runner Loop\r\n    task.spawn(function()\r\n        local char = _LocalPlayer.Character\r\n        local hrp = char and char:FindFirstChild(\"HumanoidRootPart\")\r\n\r\n        local startIndex = AutoMapReveal.State.CurrentIndex or 1\r\n        local startWaypoint = AutoMapReveal.Waypoints[startIndex]\r\n        local activeLayerIndex = type(startWaypoint) == \"table\" and startWaypoint.LayerIndex or nil\r\n\r\n        if isResuming and AutoMapReveal.ThreeLayersState and AutoMapReveal.ThreeLayersState.ResumePos then\r\n            -- Teleport langsung ke tempat semula persis saat dihentikan\r\n            if hrp then\r\n                local resumeCF = AutoMapReveal.ThreeLayersState.ResumeCFrame or CFrame.new(AutoMapReveal.ThreeLayersState.ResumePos)\r\n                hrp.CFrame = resumeCF\r\n                hrp.AssemblyLinearVelocity = Vector3.zero\r\n                hrp.AssemblyAngularVelocity = Vector3.zero\r\n                task.wait(0.2)\r\n            end\r\n            -- Bersihkan ResumePos yang baru saja dipakai\r\n            AutoMapReveal.ThreeLayersState.ResumePos = nil\r\n            AutoMapReveal.ThreeLayersState.ResumeCFrame = nil\r\n        else\r\n            -- Titik awal scan fresh\r\n            local firstTarget = AutoMapReveal.Waypoints[1]\r\n            local firstPos = (type(firstTarget) == \"table\" and firstTarget.Pos) or firstTarget\r\n            if hrp and firstPos then\r\n                hrp.CFrame = AutoMapReveal.PoseCFrame(firstPos)\r\n                hrp.AssemblyLinearVelocity = Vector3.zero\r\n                hrp.AssemblyAngularVelocity = Vector3.zero\r\n                task.wait(0.2)\r\n            end\r\n        end\r\n\r\n        for i = startIndex, #AutoMapReveal.Waypoints do\r\n            if not AutoMapReveal.State.IsScanning or not AutoMapReveal.State.Is4LayersMode then break end\r\n            AutoMapReveal.State.CurrentIndex = i\r\n            if AutoMapReveal.ThreeLayersState then\r\n                AutoMapReveal.ThreeLayersState.CurrentIndex = i\r\n            end\r\n\r\n            local wp = AutoMapReveal.Waypoints[i]\r\n            local layerIndex = type(wp) == \"table\" and wp.LayerIndex or nil\r\n            if activeLayerIndex and layerIndex and layerIndex > activeLayerIndex then\r\n                AutoMapReveal.UpdateProgress(string.format(\r\n                    \"Layer %d complete. Continuing directly to Layer %d...\",\r\n                    activeLayerIndex,\r\n                    layerIndex\r\n                ))\r\n            end\r\n            if layerIndex then\r\n                activeLayerIndex = layerIndex\r\n            end\r\n\r\n            local targetPos = (type(wp) == \"table\" and wp.Pos) or wp\r\n            local layerInfo = (type(wp) == \"table\" and wp.LayerName) and (\" [\" .. wp.LayerName .. \"]\") or \"\"\r\n            local pct = math.floor((i / AutoMapReveal.State.TotalWaypoints) * 100)\r\n            local m = math.floor(AutoMapReveal.State.ElapsedSeconds / 60)\r\n            local s = AutoMapReveal.State.ElapsedSeconds % 60\r\n            local timeStr = string.format(\"%02d:%02d\", m, s)\r\n            AutoMapReveal.UpdateProgress(string.format(\"3-Layers: %d%%%s (Time: %s)\", pct, layerInfo, timeStr))\r\n\r\n            local success = AutoMapReveal.MoveTo(targetPos, AutoMapReveal.State.Speed or 100)\r\n            if not success then\r\n                if AutoMapReveal.State.IsPausedForRescue then\r\n                    -- Movement cleanly paused for rescue; do not flag failure\r\n                    return\r\n                end\r\n                if AutoMapReveal.State.IsScanning then\r\n                    AutoMapReveal.PauseForRescue()\r\n                    AutoMapReveal.State.Failure = \"Movement interrupted; Resume to retry current waypoint\"\r\n                end\r\n                return\r\n            end\r\n        end\r\n\r\n        if AutoMapReveal.State.IsScanning and AutoMapReveal.State.Is4LayersMode then\r\n            -- Selesai 100%! Bersihkan status resume\r\n            if AutoMapReveal.ThreeLayersState then\r\n                AutoMapReveal.ThreeLayersState.ResumePos = nil\r\n                AutoMapReveal.ThreeLayersState.ResumeCFrame = nil\r\n                AutoMapReveal.ThreeLayersState.CurrentIndex = 0\r\n                AutoMapReveal.ThreeLayersState.ElapsedSeconds = 0\r\n            end\r\n            AutoMapReveal.ReturnToCampfire(false, true)\r\n        end\r\n    end)\r\nend\r\nAutoMapReveal.Start3LayersScan = AutoMapReveal.Start4LayersScan\r\n\r\n-- =========================================================\r\n-- START GRID SCAN (METODE STANDAR)\r\n-- =========================================================\r\nfunction AutoMapReveal.StartScan()\r\n    if AutoMapReveal.State.IsScanning or AutoMapReveal.State.IsCompleting then return end\r\n    AutoMapReveal.State.IsScanning = true\r\n    AutoMapReveal.State.Is4LayersMode = false\r\n\r\n    local character = _LocalPlayer.Character\r\n    local root = character and character:FindFirstChild(\"HumanoidRootPart\")\r\n    AutoMapReveal.BeginPoseLock(root and root.CFrame or nil)\r\n    \r\n    if type(startFlying) == \"function\" then startFlying() end\r\n    if FlyToggle then\r\n        pcall(function()\r\n            if type(FlyToggle.SetValue) == \"function\" then FlyToggle:SetValue(true) end\r\n            if type(FlyToggle.SetState) == \"function\" then FlyToggle:SetState(true) end\r\n        end)\r\n    end\r\n    \r\n    task.spawn(function()\r\n        while AutoMapReveal.State.IsScanning and not AutoMapReveal.State.Is4LayersMode do\r\n            task.wait(1)\r\n            if AutoMapReveal.State.IsScanning and not AutoMapReveal.State.Is4LayersMode then\r\n                AutoMapReveal.State.ElapsedSeconds = AutoMapReveal.State.ElapsedSeconds + 1\r\n                local pct = 0\r\n                if AutoMapReveal.State.TotalWaypoints > 0 then\r\n                    pct = math.floor((AutoMapReveal.State.CurrentIndex / AutoMapReveal.State.TotalWaypoints) * 100)\r\n                end\r\n                local m = math.floor(AutoMapReveal.State.ElapsedSeconds / 60)\r\n                local s = AutoMapReveal.State.ElapsedSeconds % 60\r\n                local timeStr = string.format(\"%02d:%02d\", m, s)\r\n                AutoMapReveal.UpdateProgress(string.format(\"Grid Scan: %d%% (Time: %s)\", pct, timeStr))\r\n            end\r\n        end\r\n    end)\r\n    \r\n    task.spawn(function()\r\n        if AutoMapReveal.State.CurrentIndex == 0 or AutoMapReveal.State.CurrentIndex > AutoMapReveal.State.TotalWaypoints or #AutoMapReveal.Waypoints == 0 then\r\n            AutoMapReveal.State.ElapsedSeconds = 0\r\n            AutoMapReveal.GenerateWaypoints()\r\n            AutoMapReveal.State.CurrentIndex = 1\r\n            AutoMapReveal.State.ResumePos = nil\r\n            AutoMapReveal.UpdateProgress(\"Waypoints Generated. Starting Flight...\")\r\n            local char = _LocalPlayer.Character\r\n            if char then\r\n                local hrp = char:FindFirstChild(\"HumanoidRootPart\")\r\n                if hrp and AutoMapReveal.Waypoints[1] then\r\n                    local targetPos = (type(AutoMapReveal.Waypoints[1]) == \"table\" and AutoMapReveal.Waypoints[1].Pos) or AutoMapReveal.Waypoints[1]\r\n                    hrp.CFrame = AutoMapReveal.PoseCFrame(targetPos)\r\n                    task.wait(0.2)\r\n                end\r\n            end\r\n        else\r\n            AutoMapReveal.UpdateProgress(\"Resuming Flight...\")\r\n            local char = _LocalPlayer.Character\r\n            if char then\r\n                local hrp = char:FindFirstChild(\"HumanoidRootPart\")\r\n                local targetPos = AutoMapReveal.State.ResumePos or AutoMapReveal.Waypoints[AutoMapReveal.State.CurrentIndex]\r\n                targetPos = (type(targetPos) == \"table\" and targetPos.Pos) or targetPos\r\n                if hrp and targetPos then\r\n                    hrp.CFrame = AutoMapReveal.PoseCFrame(targetPos)\r\n                    task.wait(0.2)\r\n                end\r\n            end\r\n        end\r\n        \r\n        for i = AutoMapReveal.State.CurrentIndex, #AutoMapReveal.Waypoints do\r\n            local wp = AutoMapReveal.Waypoints[i]\r\n            if not AutoMapReveal.State.IsScanning or AutoMapReveal.State.Is4LayersMode then break end\r\n            AutoMapReveal.State.CurrentIndex = i\r\n            local targetPos = (type(wp) == \"table\" and wp.Pos) or wp\r\n            local pct = math.floor((i / AutoMapReveal.State.TotalWaypoints) * 100)\r\n            local m = math.floor(AutoMapReveal.State.ElapsedSeconds / 60)\r\n            local s = AutoMapReveal.State.ElapsedSeconds % 60\r\n            local timeStr = string.format(\"%02d:%02d\", m, s)\r\n            AutoMapReveal.UpdateProgress(string.format(\"Grid Scan: %d%% (Time: %s)\", pct, timeStr))\r\n            \r\n            local success = AutoMapReveal.MoveTo(targetPos)\r\n            if not success then\r\n                if AutoMapReveal.State.IsScanning then\r\n                    AutoMapReveal.PauseForRescue()\r\n                    AutoMapReveal.State.Failure = \"Movement interrupted; Resume to retry current waypoint\"\r\n                end\r\n                return\r\n            end\r\n            AutoMapReveal.State.ResumePos = nil\r\n        end\r\n        \r\n        if AutoMapReveal.State.IsScanning and not AutoMapReveal.State.Is4LayersMode then\r\n            AutoMapReveal.ReturnToCampfire(false, false)\r\n        end\r\n    end)\r\nend\r\n\r\nfunction AutoMapReveal.PauseForRescue()\r\n    if not AutoMapReveal.State.IsScanning then return end\r\n    local was3Layers = AutoMapReveal.State.Is4LayersMode == true\r\n    AutoMapReveal.State.IsScanning = false\r\n    AutoMapReveal.State.Is4LayersMode = false\r\n    AutoMapReveal.State.IsPausedForRescue = true\r\n\r\n    -- Hentikan gerak PivotTo agar posisi freeze\r\n    if AutoMapReveal.TweenInstance then\r\n        pcall(function() AutoMapReveal.TweenInstance:Cancel() end)\r\n    end\r\n\r\n    local char = _LocalPlayer.Character\r\n    local hrp = char and char:FindFirstChild(\"HumanoidRootPart\")\r\n    if hrp then\r\n        local currentPos = hrp.Position\r\n        local currentCF = hrp.CFrame\r\n        AutoMapReveal.State.ResumePos = currentPos\r\n\r\n        if AutoMapReveal.ThreeLayersState then\r\n            AutoMapReveal.ThreeLayersState.ResumePos = currentPos\r\n            AutoMapReveal.ThreeLayersState.ResumeCFrame = currentCF\r\n            AutoMapReveal.ThreeLayersState.CurrentIndex = AutoMapReveal.State.CurrentIndex\r\n            AutoMapReveal.ThreeLayersState.TotalWaypoints = AutoMapReveal.State.TotalWaypoints\r\n            AutoMapReveal.ThreeLayersState.ElapsedSeconds = AutoMapReveal.State.ElapsedSeconds\r\n            AutoMapReveal.ThreeLayersState.Waypoints = AutoMapReveal.Waypoints\r\n        end\r\n    end\r\n\r\n    -- Hentikan flight physics dahulu, lalu pulihkan animasi dan status humanoid.\r\n    if type(stopFlying) == \"function\" then pcall(stopFlying) end\r\n    AutoMapReveal.ReleasePoseLock()\r\n    task.wait(0.1)\r\nend\r\n\r\nfunction AutoMapReveal.ResumeAfterRescue()\r\n    if _G.KixFullAuto and _G.KixFullAuto.Active and _G.KixFullAuto.IsPaused then return end\r\n    if _G.KixRescueBusy or _G.KixRescuePending then return end\r\n    if _G.KixAdapters and _G.KixAdapters.AutoRescue and type(_G.KixAdapters.AutoRescue.IsCarryingKid) == \"function\" then\r\n        if _G.KixAdapters.AutoRescue.IsCarryingKid() then return end\r\n    end\r\n\r\n    -- In Full Automation, rescuing the final child only releases the reveal\r\n    -- worker. Keep scanning until the configured layer-3 route reaches 100%.\r\n    AutoMapReveal.State.IsPausedForRescue = false\r\n    AutoMapReveal.Start3LayersScan()\r\nend\r\n\r\nfunction AutoMapReveal.StopScan()\r\n    if not AutoMapReveal.State.IsScanning then return end\r\n    local was3Layers = AutoMapReveal.State.Is4LayersMode == true\r\n    AutoMapReveal.State.IsScanning = false\r\n    AutoMapReveal.State.Is4LayersMode = false\r\n    \r\n    -- 1. Hentikan gerak PivotTo agar posisi freeze tepat saat dihentikan\r\n    if AutoMapReveal.TweenInstance then\r\n        pcall(function() AutoMapReveal.TweenInstance:Cancel() end)\r\n    end\r\n\r\n    -- 2. Catat koordinat dan CFrame persis saat dihentikan\r\n    local char = _LocalPlayer.Character\r\n    local hrp = char and char:FindFirstChild(\"HumanoidRootPart\")\r\n    if hrp then\r\n        local currentPos = hrp.Position\r\n        local currentCF = hrp.CFrame\r\n        AutoMapReveal.State.ResumePos = currentPos\r\n\r\n        if was3Layers and AutoMapReveal.ThreeLayersState then\r\n            AutoMapReveal.ThreeLayersState.ResumePos = currentPos\r\n            AutoMapReveal.ThreeLayersState.ResumeCFrame = currentCF\r\n            AutoMapReveal.ThreeLayersState.CurrentIndex = AutoMapReveal.State.CurrentIndex\r\n            AutoMapReveal.ThreeLayersState.TotalWaypoints = AutoMapReveal.State.TotalWaypoints\r\n            AutoMapReveal.ThreeLayersState.ElapsedSeconds = AutoMapReveal.State.ElapsedSeconds\r\n            AutoMapReveal.ThreeLayersState.Waypoints = AutoMapReveal.Waypoints\r\n        end\r\n    end\r\n    \r\n    task.spawn(function()\r\n        task.wait(0.1) -- Beri waktu langkah gerak berhenti sebelum teleport balik\r\n        AutoMapReveal.ReturnToCampfire(true, was3Layers)\r\n    end)\r\nend\r\n\r\n-- =========================================================\r\n-- TAB UI: 3 LAYERS CIRCULAR REVEAL & SETTINGS\r\n-- =========================================================\r\nTabs.MapReveal:Section({Title = \"Auto Reveal 3 Layers\", Icon = \"disc\"})\r\n\r\n_G.KixAdapters = _G.KixAdapters or {}\r\n_G.KixAdapters.AutoReveal = {\r\n    IsScanning = function()\r\n        return AutoMapReveal and AutoMapReveal.State and AutoMapReveal.State.IsScanning == true\r\n    end,\r\n    IsCompleting = function()\r\n        return AutoMapReveal and AutoMapReveal.State and AutoMapReveal.State.IsCompleting == true\r\n    end,\r\n    IsPausedForRescue = function()\r\n        return AutoMapReveal and AutoMapReveal.State and AutoMapReveal.State.IsPausedForRescue == true\r\n    end,\r\n    IsCompleted = function()\r\n        return AutoMapReveal and AutoMapReveal.State and AutoMapReveal.State.IsCompleted == true\r\n    end,\r\n    GetProgress = function()\r\n        if AutoMapReveal and AutoMapReveal.State and AutoMapReveal.State.TotalWaypoints and AutoMapReveal.State.TotalWaypoints > 0 then\r\n            local cur = AutoMapReveal.State.CurrentIndex or 0\r\n            return math.clamp(math.floor((cur / AutoMapReveal.State.TotalWaypoints) * 100), 0, 100)\r\n        end\r\n        return 0\r\n    end,\r\n    Start = function()\r\n        if AutoMapReveal then\r\n            AutoMapReveal.State.IsCompleted = false\r\n            if AutoMapReveal.Start4LayersScan then\r\n                AutoMapReveal.Start4LayersScan()\r\n            elseif AutoMapReveal.Start3LayersScan then\r\n                AutoMapReveal.Start3LayersScan()\r\n            end\r\n        end\r\n    end,\r\n    Stop = function()\r\n        if AutoMapReveal and AutoMapReveal.StopScan then\r\n            AutoMapReveal.StopScan()\r\n        end\r\n    end\r\n}\r\n\r\nAutoLayersToggle = Tabs.MapReveal:Toggle({\r\n    Title = \"🌀 Auto Reveal 3 Layers (Circle)\",\r\n    Desc = \"Fly in 3 circular layers (Red 350 -> Blue 700 -> Orange 1050 max) | Speed 150, Alt 100\",\r\n    Value = false,\r\n    Callback = function(val)\r\n        if val then\r\n            AutoMapReveal.Start4LayersScan()\r\n        else\r\n            AutoMapReveal.StopScan()\r\n        end\r\n    end\r\n})\r\nAutoFourLayersToggle = AutoLayersToggle\r\n\r\nAutoMapReveal.ProgressLabel = Tabs.MapReveal:Paragraph({\r\n    Title = \"Status\",\r\n    Desc = \"Ready to scan.\"\r\n})\r\n\r\nTabs.MapReveal:Section({Title = \"Grid Scan Settings (Standard)\", Icon = \"settings\"})\r\n\r\nTabs.MapReveal:Slider({\r\n    Title = \"Flight Speed\",\r\n    Desc = \"Speed of tween flight (studs per second)\",\r\n    Value = {Min = 50, Max = 500, Default = AutoMapReveal.State.Speed},\r\n    Callback = function(val)\r\n        AutoMapReveal.State.Speed = val\r\n    end\r\n})\r\n\r\nTabs.MapReveal:Slider({\r\n    Title = \"Flight Height\",\r\n    Desc = \"Altitude above the map\",\r\n    Value = {Min = 20, Max = 200, Default = AutoMapReveal.State.Height},\r\n    Callback = function(val)\r\n        AutoMapReveal.State.Height = val\r\n    end\r\n})\r\n\r\nTabs.MapReveal:Button({\r\n    Title = \"Start Grid Scan\",\r\n    Callback = function()\r\n        AutoMapReveal.StartScan()\r\n    end\r\n})\r\n\r\nTabs.MapReveal:Button({\r\n    Title = \"Stop Grid Scan\",\r\n    Callback = function()\r\n        AutoMapReveal.StopScan()\r\n    end\r\n})\r\n\r\nTabs.MapReveal:Button({\r\n    Title = \"Clear Memory (Anti-Lag)\",\r\n    Callback = function()\r\n        local hrp = _LocalPlayer.Character and _LocalPlayer.Character:FindFirstChild(\"HumanoidRootPart\")\r\n        if hrp then\r\n            WindUI:Notify({Title=\"Memory Cleaner\", Content=\"Teleporting to space to flush map memory...\", Duration=3})\r\n            hrp.CFrame = CFrame.new(0, 100000, 0)\r\n            hrp.Anchored = true\r\n            task.wait(3.5)\r\n            hrp.Anchored = false\r\n            hrp.CFrame = CFrame.new(AutoMapReveal.CampfirePos)\r\n            WindUI:Notify({Title=\"Memory Cleaner\", Content=\"Memory flushed! Returned to base.\", Duration=3})\r\n        end\r\n    end\r\n})\r\n\r\n_G.KixRunFullAutoMemoryClear = function(duration, shouldContinue)\r\n    duration = math.max(0, tonumber(duration) or 10)\r\n    local character = _LocalPlayer.Character\r\n    local hrp = character and character:FindFirstChild(\"HumanoidRootPart\")\r\n    if not hrp then return false end\r\n\r\n    local savedPos = (KixHubSavedState and KixHubSavedState.customReturnPos) or customReturnPos\r\n    local returnPos\r\n    if typeof(savedPos) == \"Vector3\" then\r\n        returnPos = savedPos\r\n    elseif typeof(savedPos) == \"CFrame\" then\r\n        returnPos = savedPos.Position\r\n    else\r\n        returnPos = AutoMapReveal.GetCenterPosition() + Vector3.new(0, 2.5, 0)\r\n    end\r\n\r\n    if WindUI then\r\n        pcall(function()\r\n            WindUI:Notify({\r\n                Title = \"Memory Cleaner\",\r\n                Content = string.format(\"Giant Bed placed. Clearing map memory for %d seconds; returning to your saved position or Campfire.\", math.ceil(duration)),\r\n                Duration = duration\r\n            })\r\n        end)\r\n    end\r\n\r\n    local moved = pcall(function()\r\n        hrp.CFrame = CFrame.new(0, 100000, 0)\r\n        hrp.Anchored = true\r\n    end)\r\n    if not moved then return false end\r\n\r\n    local deadline = os.clock() + duration\r\n    while os.clock() < deadline do\r\n        if shouldContinue then\r\n            local ok, active = pcall(shouldContinue)\r\n            if not ok or not active then break end\r\n        end\r\n        task.wait(math.min(0.1, deadline - os.clock()))\r\n    end\r\n\r\n    local currentCharacter = _LocalPlayer.Character\r\n    local currentRoot = currentCharacter and currentCharacter:FindFirstChild(\"HumanoidRootPart\")\r\n    pcall(function()\r\n        hrp.Anchored = false\r\n        if currentRoot and currentRoot.Parent then\r\n            currentRoot.Anchored = false\r\n            currentRoot.AssemblyLinearVelocity = Vector3.zero\r\n            currentRoot.AssemblyAngularVelocity = Vector3.zero\r\n            currentRoot.CFrame = CFrame.new(returnPos)\r\n        elseif hrp.Parent then\r\n            hrp.AssemblyLinearVelocity = Vector3.zero\r\n            hrp.AssemblyAngularVelocity = Vector3.zero\r\n            hrp.CFrame = CFrame.new(returnPos)\r\n        end\r\n    end)\r\n\r\n    if WindUI then\r\n        pcall(function()\r\n            WindUI:Notify({Title = \"Memory Cleaner\", Content = \"Memory cleanup complete. Returned to your saved position or Campfire.\", Duration = 3})\r\n        end)\r\n    end\r\n    return true\r\nend\r\n\r\n-- ==================== SPECTATE TAB ====================\r\nTabs.Spectate:Section({Title = 'Spectate Player', Icon = 'eye'})\r\n\r\n_G.KixSpectateIndex = 1\r\n_G.IsSpectating = false\r\n_G.NinjaAssistActive = false\r\nlastSpectatedPlayer = nil\r\n\r\n-- Loop Utama Spectate & Ninja Assist\r\n_G.KixSpectateHeartbeat = _RunService.Heartbeat:Connect(function()\r\n    if not _G.IsSpectating or not lastSpectatedPlayer then return end\r\n    if _G.IsStrongholdRaidActive or _G.CampfireCombatActive or _G.GlobalCultistCombatActive or _G.CorruptedCombatActive or _G.MossyCombatActive or _G.TurkeyCombatActive or _G.BearCombatActive then return end\r\n    \r\n    pcall(function()\r\n        -- 1. Manajemen Kamera & Status (Update Otomatis saat target mati/hidup)\r\n        local targetChar = lastSpectatedPlayer.Character\r\n        local targetHum = targetChar and targetChar:FindFirstChild(\"Humanoid\")\r\n        local targetHRP = targetChar and targetChar:FindFirstChild(\"HumanoidRootPart\")\r\n        \r\n        local currentCamSubject = workspace.CurrentCamera.CameraSubject\r\n        \r\n        if targetHum and targetHum.Health > 0 then\r\n            if currentCamSubject ~= targetHum then\r\n                _G.KixSetNativeCameraSubject(targetHum)\r\n                SpectateStatus:SetDesc(\"Spectating: \" .. lastSpectatedPlayer.DisplayName .. \" (@\" .. lastSpectatedPlayer.Name .. \")\")\r\n            end\r\n        else\r\n            -- Cari dead body\r\n            local charsFolder = workspace:FindFirstChild(\"Characters\")\r\n            if charsFolder then\r\n                local deadBody = charsFolder:FindFirstChild(lastSpectatedPlayer.Name .. \" Body\") \r\n                              or charsFolder:FindFirstChild(lastSpectatedPlayer.DisplayName .. \" Body\")\r\n                \r\n                local bodyHum = deadBody and deadBody:FindFirstChild(\"Humanoid\")\r\n                local bodyPart = deadBody and (deadBody:FindFirstChild(\"HumanoidRootPart\") or deadBody:FindFirstChild(\"Torso\") or deadBody.PrimaryPart)\r\n                \r\n                if bodyHum then\r\n                    if currentCamSubject ~= bodyHum then\r\n                        _G.KixSetNativeCameraSubject(bodyHum)\r\n                        SpectateStatus:SetDesc(\"Spectating: \" .. lastSpectatedPlayer.DisplayName .. \" (@\" .. lastSpectatedPlayer.Name .. \") [DEAD BODY]\")\r\n                    end\r\n                elseif bodyPart then\r\n                    if currentCamSubject ~= bodyPart then\r\n                        _G.KixSetNativeCameraSubject(bodyPart)\r\n                        SpectateStatus:SetDesc(\"Spectating: \" .. lastSpectatedPlayer.DisplayName .. \" (@\" .. lastSpectatedPlayer.Name .. \") [DEAD BODY]\")\r\n                    end\r\n                else\r\n                    SpectateStatus:SetDesc(\"Target character/body not found: \" .. lastSpectatedPlayer.DisplayName)\r\n                end\r\n            end\r\n        end\r\n        \r\n        -- 2. Manajemen Ninja Assist (Follow di bawah tanah)\r\n        if _G.NinjaAssistActive then\r\n            local myChar = _LocalPlayer.Character\r\n            local hrp = myChar and myChar:FindFirstChild(\"HumanoidRootPart\")\r\n            if hrp then\r\n                -- Matikan collision & jatuhkan velocity agar tidak nyangkut/jatuh\r\n                hrp.Velocity = Vector3.new(0,0,0)\r\n                \r\n                -- Optimization: Hanya panggil GetChildren() untuk part utama, tidak perlu GetDescendants() tiap frame\r\n                for _, part in ipairs(myChar:GetChildren()) do\r\n                    if part:IsA(\"BasePart\") then part.CanCollide = false end\r\n                end\r\n                \r\n                if targetHRP and targetHum and targetHum.Health > 0 then\r\n                    -- Gunakan world-space offset agar tidak miring mengikuti rotasi target\r\n                    hrp.CFrame = CFrame.new(targetHRP.Position - Vector3.new(0, 25, 0)) * targetHRP.CFrame.Rotation\r\n                else\r\n                    local charsFolder = workspace:FindFirstChild(\"Characters\")\r\n                    if charsFolder then\r\n                        local deadBody = charsFolder:FindFirstChild(lastSpectatedPlayer.Name .. \" Body\") \r\n                                      or charsFolder:FindFirstChild(lastSpectatedPlayer.DisplayName .. \" Body\")\r\n                        local bodyPart = deadBody and (deadBody:FindFirstChild(\"HumanoidRootPart\") or deadBody:FindFirstChild(\"Torso\") or deadBody.PrimaryPart)\r\n                        if bodyPart then\r\n                            -- Pastikan rotasi default (tegak lurus) karena dead body posisinya ragdoll (telentang/telungkup)\r\n                            hrp.CFrame = CFrame.new(bodyPart.Position.X, bodyPart.Position.Y - 25, bodyPart.Position.Z)\r\n                        end\r\n                    end\r\n                end\r\n            end\r\n        end\r\n    end)\r\nend)\r\n\r\nSpectateStatus = Tabs.Spectate:Paragraph({\r\n    Title = 'Current Target',\r\n    Desc = 'Not spectating anyone.'\r\n})\r\n\r\n_G.KixUpdateSpectateTarget = function()\r\n    local allPlayers = _Players:GetPlayers()\r\n    if #allPlayers <= 1 then\r\n        SpectateStatus:SetDesc(\"No other players found.\")\r\n        return\r\n    end\r\n    \r\n    if _G.KixSpectateIndex > #allPlayers then _G.KixSpectateIndex = 1 end\r\n    if _G.KixSpectateIndex < 1 then _G.KixSpectateIndex = #allPlayers end\r\n    \r\n    local target = allPlayers[_G.KixSpectateIndex]\r\n    if target == _LocalPlayer then\r\n        _G.KixSpectateIndex = _G.KixSpectateIndex + 1\r\n        if _G.KixSpectateIndex > #allPlayers then _G.KixSpectateIndex = 1 end\r\n        target = allPlayers[_G.KixSpectateIndex]\r\n    end\r\n    \r\n    lastSpectatedPlayer = target\r\n    _G.IsSpectating = true\r\nend\r\n\r\nTabs.Spectate:Button({\r\n    Title = 'Previous Player',\r\n    Callback = function()\r\n            _G.KixSpectateIndex = _G.KixSpectateIndex - 1\r\n            _G.KixUpdateSpectateTarget()\r\n    end\r\n})\r\n\r\nTabs.Spectate:Button({\r\n    Title = 'Next Player',\r\n    Callback = function()\r\n            _G.KixSpectateIndex = _G.KixSpectateIndex + 1\r\n            _G.KixUpdateSpectateTarget()\r\n    end\r\n})\r\n\r\n-- =========================================================\r\n-- REVIVE CURRENT SPECTATE TARGET\r\n-- =========================================================\r\n\r\nTabs.Spectate:Button({\r\n    Title = 'Revive Current Target',\r\n    Desc = 'Revives the currently spectated player if their dead body is available.',\r\n    Icon = 'heart',\r\n    Callback = function()\r\n\r\n        -- Pastikan ada target\r\n        if not lastSpectatedPlayer then\r\n            WindUI:Notify({\r\n                Title = \"Revive\",\r\n                Content = \"No current target selected!\",\r\n                Duration = 3\r\n            })\r\n            return\r\n        end\r\n\r\n        local target = lastSpectatedPlayer\r\n\r\n        pcall(function()\r\n\r\n            local charsFolder = workspace:FindFirstChild(\"Characters\")\r\n\r\n            if not charsFolder then\r\n                WindUI:Notify({\r\n                    Title = \"Revive\",\r\n                    Content = \"Characters folder not found!\",\r\n                    Duration = 3\r\n                })\r\n                return\r\n            end\r\n\r\n            -- =====================================================\r\n            -- CARI DEAD BODY TARGET\r\n            -- =====================================================\r\n\r\n            local deadBody = nil\r\n\r\n            -- Prioritas berdasarkan UserId dari PlayerBody\r\n            for _, body in ipairs(charsFolder:GetChildren()) do\r\n\r\n                if body:IsA(\"Model\") and body.Name:match(\" Body$\") then\r\n\r\n                    local bodyUserId = body:GetAttribute(\"PlayerBody\")\r\n\r\n                    if bodyUserId\r\n                        and tonumber(bodyUserId) == target.UserId then\r\n\r\n                        deadBody = body\r\n                        break\r\n                    end\r\n                end\r\n            end\r\n\r\n            -- =====================================================\r\n            -- FALLBACK BERDASARKAN NAMA BODY\r\n            -- =====================================================\r\n\r\n            if not deadBody then\r\n\r\n                local possibleNames = {\r\n                    target.Name .. \" Body\",\r\n                    target.DisplayName .. \" Body\"\r\n                }\r\n\r\n                for _, bodyName in ipairs(possibleNames) do\r\n                    local candidate = charsFolder:FindFirstChild(bodyName)\r\n\r\n                    if candidate\r\n                        and candidate:IsA(\"Model\")\r\n                        and candidate.Name:match(\" Body$\") then\r\n\r\n                        deadBody = candidate\r\n                        break\r\n                    end\r\n                end\r\n            end\r\n\r\n            -- =====================================================\r\n            -- BODY TIDAK DITEMUKAN\r\n            -- =====================================================\r\n\r\n            if not deadBody then\r\n                WindUI:Notify({\r\n                    Title = \"Revive\",\r\n                    Content = \"Dead body of \" .. target.DisplayName .. \" not found!\",\r\n                    Duration = 3\r\n                })\r\n                return\r\n            end\r\n\r\n            -- =====================================================\r\n            -- REQUEST REVIVE\r\n            -- =====================================================\r\n\r\n            local remote =\r\n                _ReplicatedStorage:FindFirstChild(\"RemoteEvents\")\r\n                and _ReplicatedStorage.RemoteEvents:FindFirstChild(\"RequestRevivePlayer\")\r\n\r\n            if not remote then\r\n                WindUI:Notify({\r\n                    Title = \"Revive\",\r\n                    Content = \"RequestRevivePlayer remote not found!\",\r\n                    Duration = 3\r\n                })\r\n                return\r\n            end\r\n\r\n            remote:FireServer(deadBody)\r\n\r\n            WindUI:Notify({\r\n                Title = \"Revive\",\r\n                Content = \"Revive request sent to \" .. target.DisplayName .. \"!\",\r\n                Duration = 3\r\n            })\r\n\r\n        end)\r\n    end\r\n})\r\n\r\n_G.KixWasKillAuraBeforeNinja = false\r\n\r\nTabs.Spectate:Toggle({\r\n    Title = 'Ninja Assist Target (Underground)',\r\n    Desc = 'Physically follow the target from 25 studs underground. Automatically activates Kill Aura using your best weapon to secretly help them fight!',\r\n    Value = false,\r\n    Callback = function(val)\r\n        _G.NinjaAssistActive = val\r\n        \r\n        if val then\r\n            _G.KixWasKillAuraBeforeNinja = killAuraEnabled\r\n            if not _G.KixWasKillAuraBeforeNinja then\r\n                toggleKillAura(true)\r\n            end\r\n            syncAuraDamageTool(\"weapon\")\r\n        else\r\n            -- Ketika Ninja Assist dimatikan, stop spectating & pulang diam-diam\r\n            _G.IsSpectating = false\r\n            \r\n            if not _G.KixWasKillAuraBeforeNinja then\r\n                toggleKillAura(false)\r\n            end\r\n            \r\n            local myChar = _LocalPlayer.Character\r\n            local hrp = myChar and myChar:FindFirstChild(\"HumanoidRootPart\")\r\n            if hrp then\r\n                local fallbackPos = customReturnPos or campfirePos\r\n                hrp.Anchored = true\r\n                hrp.CFrame = CFrame.new(fallbackPos.X, fallbackPos.Y + 3, fallbackPos.Z)\r\n                task.wait(0.3)\r\n                hrp.Anchored = false\r\n                \r\n                if myChar:FindFirstChild(\"Humanoid\") then\r\n                    workspace.CurrentCamera.CameraSubject = myChar.Humanoid\r\n                end\r\n            end\r\n            SpectateStatus:SetDesc(\"Not spectating anyone.\")\r\n            WindUI:Notify({Title=\"Ninja Assist\", Content=\"Assistance ended. Teleported back secretly.\", Duration=3})\r\n        end\r\n    end\r\n})\r\n\r\nTabs.Spectate:Button({\r\n    Title = 'Teleport to Current Target Spectate',\r\n    Callback = function()\r\n        local targetPlayer = lastSpectatedPlayer\r\n        if not targetPlayer or targetPlayer == _LocalPlayer or not targetPlayer.Parent then\r\n            WindUI:Notify({Title=\"Error\", Content=\"No valid target in memory! Please spectate a player first.\", Duration=3})\r\n            return\r\n        end\r\n        \r\n        local myChar = _LocalPlayer.Character\r\n        local hrp = myChar and myChar:FindFirstChild(\"HumanoidRootPart\")\r\n        if not hrp then return end\r\n\r\n        local targetChar = targetPlayer.Character\r\n        local targetHRP = targetChar and targetChar:FindFirstChild(\"HumanoidRootPart\")\r\n\r\n        if targetHRP then\r\n            _G.IsSpectating = false\r\n            hrp.Anchored = true\r\n            hrp.CFrame = targetHRP.CFrame * CFrame.new(0, 0, -3)\r\n            task.wait(0.3)\r\n            hrp.Anchored = false\r\n            \r\n            WindUI:Notify({Title=\"Teleport\", Content=\"Teleported to \" .. targetPlayer.Name .. \"!\", Duration=3})\r\n            if _LocalPlayer.Character and _LocalPlayer.Character:FindFirstChild(\"Humanoid\") then\r\n                workspace.CurrentCamera.CameraSubject = _LocalPlayer.Character.Humanoid\r\n            end\r\n            SpectateStatus:SetDesc(\"Not spectating anyone.\")\r\n        else\r\n            local charsFolder = workspace:FindFirstChild(\"Characters\")\r\n            if charsFolder then\r\n                local deadBody = charsFolder:FindFirstChild(targetPlayer.Name .. \" Body\") \r\n                              or charsFolder:FindFirstChild(targetPlayer.Name)\r\n                              or charsFolder:FindFirstChild(targetPlayer.DisplayName .. \" Body\") \r\n                              or charsFolder:FindFirstChild(targetPlayer.DisplayName)\r\n                \r\n                local bodyPart = deadBody and (deadBody:FindFirstChild(\"HumanoidRootPart\") or deadBody:FindFirstChild(\"Torso\") or deadBody.PrimaryPart)\r\n                \r\n                if bodyPart then\r\n                    _G.IsSpectating = false\r\n                    hrp.Anchored = true\r\n                    hrp.CFrame = bodyPart.CFrame * CFrame.new(0, 3, 0)\r\n                    task.wait(0.3)\r\n                    hrp.Anchored = false\r\n                    \r\n                    WindUI:Notify({Title=\"Teleport\", Content=\"Teleported to \" .. targetPlayer.Name .. \"'s body!\", Duration=3})\r\n                    if _LocalPlayer.Character and _LocalPlayer.Character:FindFirstChild(\"Humanoid\") then\r\n                        workspace.CurrentCamera.CameraSubject = _LocalPlayer.Character.Humanoid\r\n                    end\r\n                    SpectateStatus:SetDesc(\"Not spectating anyone.\")\r\n                else\r\n                    WindUI:Notify({Title=\"Not Found\", Content=\"Could not find player or their body.\", Duration=3})\r\n                end\r\n            else\r\n                WindUI:Notify({Title=\"Not Found\", Content=\"Could not find player or their body.\", Duration=3})\r\n            end\r\n        end\r\n    end\r\n})\r\n\r\nTabs.Spectate:Button({\r\n    Title = 'Stop Spectating',\r\n    Callback = function()\r\n        _G.IsSpectating = false\r\n        if _LocalPlayer.Character and _LocalPlayer.Character:FindFirstChild(\"Humanoid\") then\r\n            workspace.CurrentCamera.CameraSubject = _LocalPlayer.Character.Humanoid\r\n        end\r\n        SpectateStatus:SetDesc(\"Not spectating anyone.\")\r\n    end\r\n})\r\n\r\nTabs.Spectate:Section({Title = 'Bring Item to Current Target', Icon = 'package'})\r\n\r\nspecBringItemName = \"\"\r\n_G.KixSpecBringAmount = 1\r\nspecSelectedPlayerStr = \"\"\r\n\r\nTabs.Spectate:Input({\r\n    Title = 'Item Name',\r\n    Desc = 'Type the exact or partial name (e.g. \"stew\"). Ignores spaces & case.',\r\n    Value = '',\r\n    Callback = function(val)\r\n        specBringItemName = val\r\n    end\r\n})\r\n\r\nTabs.Spectate:Slider({\r\n    Title = 'Amount',\r\n    Desc = 'Slide to select how many items to bring',\r\n    Value = {Min = 1, Max = 100, Default = 1},\r\n    Callback = function(val)\r\n        _G.KixSpecBringAmount = val\r\n    end\r\n})\r\n\r\nTabs.Spectate:Button({\r\n    Title = 'Bring Item Now',\r\n    Callback = function()\r\n        if specBringItemName == \"\" then\r\n            if WindUI then WindUI:Notify({Title=\"Error\", Content=\"Please enter an item name!\", Duration=3}) end\r\n            return\r\n        end\r\n        \r\n        local targetPlayer = lastSpectatedPlayer\r\n        if not targetPlayer or targetPlayer == _LocalPlayer or not targetPlayer.Parent then\r\n            if WindUI then WindUI:Notify({Title=\"Error\", Content=\"Please spectate a player first!\", Duration=3}) end\r\n            return\r\n        end\r\n        \r\n        if not targetPlayer.Character or not targetPlayer.Character:FindFirstChild(\"HumanoidRootPart\") then\r\n            if WindUI then WindUI:Notify({Title=\"Error\", Content=\"Target player character not found! Are they dead?\", Duration=3}) end\r\n            return\r\n        end\r\n        \r\n        task.spawn(function()\r\n            -- Destination is 5 studs in front of target and 5 studs above\r\n            local destPos = targetPlayer.Character.HumanoidRootPart.Position + (targetPlayer.Character.HumanoidRootPart.CFrame.LookVector * 5) + Vector3.new(0, 5, 0)\r\n            \r\n            local itemsFolder = (_Workspace:FindFirstChild(\"Items\") or workspace:FindFirstChild(\"items\"))\r\n            if not itemsFolder then return end\r\n            \r\n            local brought = 0\r\n            local searchName = string.lower(string.gsub(specBringItemName, \"%s+\", \"\"))\r\n            \r\n            for _, item in ipairs(itemsFolder:GetChildren()) do\r\n                if brought >= _G.KixSpecBringAmount then break end\r\n                \r\n                local itemName = string.lower(string.gsub(item.Name, \"%s+\", \"\"))\r\n                \r\n                if string.find(itemName, searchName, 1, true) then\r\n                    task.spawn(function() dragItemSmooth(item, destPos) end)\r\n                    brought = brought + 1\r\n                    task.wait(0.05)\r\n                end\r\n            end\r\n            \r\n            if WindUI then \r\n                WindUI:Notify({Title=\"Custom Bring\", Content=\"Brought \" .. brought .. \" item(s) to \" .. targetPlayer.DisplayName, Duration=3}) \r\n            end\r\n        end)\r\n    end\r\n})\r\n\r\n;(function()\r\n    local function getBringDestination(destination)\r\n        if destination == \"Player\" then\r\n            local character = _LocalPlayer.Character\r\n            local head = character and character:FindFirstChild(\"Head\")\r\n            local root = character and character:FindFirstChild(\"HumanoidRootPart\")\r\n            local part = head or root\r\n            return part and (part.CFrame + Vector3.new(0, 5, 0)) or nil\r\n        elseif destination == \"Scrap Machine\" then\r\n            local map = _Workspace:FindFirstChild(\"Map\")\r\n            local camp = map and map:FindFirstChild(\"Campground\")\r\n            local scrapper = camp and camp:FindFirstChild(\"Scrapper\")\r\n            if scrapper then\r\n                local ok, pivot = pcall(function() return scrapper:GetPivot() end)\r\n                if ok and pivot then return pivot * CFrame.new(0, 10, 0) end\r\n            end\r\n            return CFrame.new(scrapMachinePos + Vector3.new(0, 10, 0))\r\n        elseif destination == \"Fire\" then\r\n            local map = _Workspace:FindFirstChild(\"Map\")\r\n            local camp = map and map:FindFirstChild(\"Campground\")\r\n            local fire = camp and camp:FindFirstChild(\"MainFire\")\r\n            if fire then\r\n                local ok, pivot = pcall(function() return fire:GetPivot() end)\r\n                if ok and pivot then return pivot + Vector3.new(0, 30, 0) end\r\n            end\r\n            return CFrame.new(campfirePos + Vector3.new(0, 30, 0))\r\n        elseif destination == \"Void (Trash)\" then\r\n            return CFrame.new(getVoidDropPosition())\r\n        end\r\n        return nil\r\n    end\r\n\r\n    local function bringCandidates(names, destination, totalLimit, queryMode)\r\n        local folder, snapshot = _G.KixItemsIndex.Get()\r\n        if not folder or type(snapshot) ~= \"table\" then return 0 end\r\n        local wanted, normalized, blocked = {}, {}, _G.KixBringBlockedKeywords or {\"chest\", \"structures\", \"building\", \"trap\"}\r\n        for _, name in ipairs(names) do\r\n            if type(name) == \"string\" then\r\n                wanted[name] = true\r\n                normalized[#normalized + 1] = string.gsub(string.lower(name), \"%s+\", \"\")\r\n            end\r\n        end\r\n        local candidates, perName, grouped, order, sourceParents = {}, {}, {}, {}, {}\r\n        local function eligible(item, parent)\r\n            if item.Parent ~= parent or not _G.KixItemTransportSystem.CanTeleport(item)\r\n                or (_G.KixIsBringBlacklistedItem and _G.KixIsBringBlacklistedItem(item))\r\n                or isItemHeldByAnotherPlayer(item) then return false end\r\n            if queryMode then\r\n                local itemName = string.gsub(string.lower(item.Name), \"%s+\", \"\")\r\n                for _, query in ipairs(normalized) do\r\n                    if query ~= \"\" and (itemName == query or (not string.find(query, \"%s\") and string.find(itemName, query, 1, true))) then\r\n                        for _, keyword in ipairs(blocked) do\r\n                            if string.find(itemName, string.gsub(string.lower(keyword), \"%s+\", \"\"), 1, true) then return false end\r\n                        end\r\n                        return true\r\n                    end\r\n                end\r\n                return false\r\n            end\r\n            return wanted[item.Name] == true\r\n        end\r\n        local function addToGroup(item, parent, groupName)\r\n            local count = perName[groupName] or 0\r\n            if count >= bringAmount then return end\r\n            perName[groupName] = count + 1\r\n            local group = grouped[groupName]\r\n            if not group then group = {}; grouped[groupName] = group; order[#order + 1] = groupName end\r\n            group[#group + 1] = item\r\n            sourceParents[item] = parent\r\n        end\r\n        local enemyNames = {\"Cultist\", \"Crossbow Cultist\", \"Juggernaut Cultist\", \"Cultist King\", \"Mega Cultist\", \"Wolf\", \"Alpha Wolf\", \"Bear\", \"Polar Bear\", \"Alien\", \"Alien Trooper\", \"Alien Engineer\", \"Alien Scout\", \"Alien Commander\", \"Arctic Fox\", \"Frog\", \"Scorpion\", \"Hellephant\", \"Meteor Crab\", \"Shadow Cultist\", \"Brutal Cultist\", \"Darkstring Cultist\", \"Boar\", \"Jungle Cultist\", \"Mammoth\", \"Mossy Mammoth\"}\r\n        local function isBringCorpse(item)\r\n            if not item:IsA(\"Model\") or item:GetAttribute(\"Interaction\") == nil or item:GetAttribute(\"Burning\") then return false end\r\n            local lowerName = string.lower(item.Name)\r\n            for _, enemyName in ipairs(enemyNames) do\r\n                if string.find(lowerName, string.lower(enemyName), 1, true) then return true end\r\n            end\r\n            return false\r\n        end\r\n        for _, item in ipairs(snapshot) do\r\n            if item and eligible(item, folder) then\r\n                local groupName = queryMode and item.Name\r\n                    or (wanted[\"Corpse\"] and isBringCorpse(item) and \"Corpse\" or item.Name)\r\n                if queryMode or wanted[groupName] then addToGroup(item, folder, groupName) end\r\n            end\r\n        end\r\n        if not queryMode and wanted[\"Corpse\"] then\r\n            local characters = _Workspace:FindFirstChild(\"Characters\")\r\n            if characters then\r\n                for _, item in ipairs(characters:GetChildren()) do\r\n                    if item.Name ~= _LocalPlayer.Name and isBringCorpse(item) and eligible(item, characters) then\r\n                        addToGroup(item, characters, \"Corpse\")\r\n                    end\r\n                end\r\n            end\r\n        end\r\n        if queryMode then\r\n            local index = 1\r\n            while #candidates < totalLimit and #order > 0 do\r\n                if index > #order then index = 1 end\r\n                local group = grouped[order[index]]\r\n                if group and #group > 0 then\r\n                    candidates[#candidates + 1] = table.remove(group, 1)\r\n                    index = index + 1\r\n                else\r\n                    table.remove(order, index)\r\n                end\r\n            end\r\n        else\r\n            for _, groupName in ipairs(order) do\r\n                for _, item in ipairs(grouped[groupName]) do\r\n                    candidates[#candidates + 1] = item\r\n                end\r\n            end\r\n        end\r\n        if #candidates == 0 then return 0 end\r\n        local target = getBringDestination(destination)\r\n        if not target then return 0 end\r\n        local oldAntiVoid = _G.AntiVoidItemsEnabled\r\n        local isVoid = destination == \"Void (Trash)\"\r\n        if isVoid then _G.AntiVoidItemsEnabled = false end\r\n        local moved = _G.KixItemTransportSystem.Batch(candidates, function(item)\r\n            return _G.KixItemTransportSystem.Move(item, target, function()\r\n                return KixHubSession.Alive and item.Parent == sourceParents[item]\r\n                    and not (_G.KixIsBringBlacklistedItem and _G.KixIsBringBlacklistedItem(item))\r\n                    and not isItemHeldByAnotherPlayer(item)\r\n            end)\r\n        end, {active = function() return KixHubSession.Alive end})\r\n        if isVoid then\r\n            if not _G.VoidTrashTimer or _G.VoidTrashTimer <= 0 then _G.VoidTrashOriginalAntiVoid = oldAntiVoid end\r\n            _G.VoidTrashTimer = 30\r\n            if not _G.VoidTrashActive then\r\n                _G.VoidTrashActive = true\r\n                task.spawn(function()\r\n                    while KixHubSession.Alive and (_G.VoidTrashTimer or 0) > 0 do\r\n                        task.wait(1)\r\n                        _G.VoidTrashTimer -= 1\r\n                    end\r\n                    _G.VoidTrashActive = false\r\n                    _G.AntiVoidItemsEnabled = _G.VoidTrashOriginalAntiVoid\r\n                end)\r\n            end\r\n        end\r\n        return moved\r\n    end\r\n\r\n    -- Reuse the Bring tab's Void (Trash) delivery path for a specific freshly caught item.\r\n    _G.KixMoveItemsToVoid = function(items, isActive)\r\n        if type(items) ~= 'table' or not _G.KixItemTransportSystem then return 0 end\r\n        local target = getBringDestination('Void (Trash)')\r\n        if not target then return 0 end\r\n        local candidates, sourceParents = {}, {}\r\n        for _, item in ipairs(items) do\r\n            local parent = item and item.Parent\r\n            if parent and _G.KixItemTransportSystem.CanTeleport(item)\r\n                and not (_G.KixIsBringBlacklistedItem and _G.KixIsBringBlacklistedItem(item))\r\n                and not isItemHeldByAnotherPlayer(item)\r\n                and (not isActive or isActive()) then\r\n                candidates[#candidates + 1] = item\r\n                sourceParents[item] = parent\r\n            end\r\n        end\r\n        if #candidates == 0 then return 0 end\r\n\r\n        local trashSet = _G.KixVoidTrashItems\r\n        if type(trashSet) ~= 'table' then\r\n            trashSet = setmetatable({}, {__mode = 'k'})\r\n            _G.KixVoidTrashItems = trashSet\r\n        end\r\n        for _, item in ipairs(candidates) do trashSet[item] = true end\r\n\r\n        local function moveActive(item)\r\n            return KixHubSession.Alive and (not isActive or isActive())\r\n                and item.Parent == sourceParents[item]\r\n                and not (_G.KixIsBringBlacklistedItem and _G.KixIsBringBlacklistedItem(item))\r\n                and not isItemHeldByAnotherPlayer(item)\r\n        end\r\n        local function isAtVoid(item)\r\n            if not item or not item.Parent then return true end\r\n            if item.Parent ~= sourceParents[item] then return false end\r\n            local ok, pivot = pcall(function() return item:GetPivot() end)\r\n            return ok and pivot.Position.Y <= target.Position.Y + 100\r\n        end\r\n\r\n        local oldAntiVoid = _G.AntiVoidItemsEnabled\r\n        _G.AntiVoidItemsEnabled = false\r\n        local pending = candidates\r\n        for attempt = 1, 3 do\r\n            if #pending == 0 or (isActive and not isActive()) then break end\r\n            _G.KixItemTransportSystem.Batch(pending, function(item)\r\n                return _G.KixItemTransportSystem.Move(item, target, function() return moveActive(item) end)\r\n            end, {active = function() return KixHubSession.Alive and (not isActive or isActive()) end})\r\n            task.wait(0.1)\r\n            local retry = {}\r\n            for _, item in ipairs(pending) do\r\n                if item.Parent == sourceParents[item] and not isAtVoid(item) then\r\n                    retry[#retry + 1] = item\r\n                end\r\n            end\r\n            pending = retry\r\n        end\r\n        _G.AntiVoidItemsEnabled = oldAntiVoid\r\n\r\n        local discarded = 0\r\n        for _, item in ipairs(candidates) do\r\n            if isAtVoid(item) then\r\n                discarded += 1\r\n            else\r\n                trashSet[item] = nil\r\n            end\r\n        end\r\n        return discarded\r\n    end\r\n\r\n    local function executeBring(selections, forcedDestination)\r\n        if type(selections) ~= \"table\" or #selections == 0 then\r\n            if WindUI then WindUI:No