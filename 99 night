ild(realName)\r\n        if not targetPlayer then \r\n            WindUI:Notify({Title=\"Error\", Content=\"Player left the game!\", Duration=3})\r\n            return\r\n        end\r\n        \r\n        local myChar = _LocalPlayer.Character\r\n        local hrp = myChar and myChar:FindFirstChild(\"HumanoidRootPart\")\r\n        if not hrp then return end\r\n\r\n        local targetChar = targetPlayer.Character\r\n        local targetHRP = targetChar and targetChar:FindFirstChild(\"HumanoidRootPart\")\r\n\r\n        if targetHRP then\r\n            hrp.CFrame = targetHRP.CFrame * CFrame.new(0, 0, -3)\r\n            WindUI:Notify({Title=\"Teleport\", Content=\"Teleported to \" .. targetPlayer.Name .. \"!\", Duration=3})\r\n        else\r\n            local charsFolder = workspace:FindFirstChild(\"Characters\")\r\n            if charsFolder then\r\n                local deadBody = charsFolder:FindFirstChild(targetPlayer.Name .. \" Body\") \r\n                              or charsFolder:FindFirstChild(targetPlayer.Name)\r\n                              or charsFolder:FindFirstChild(targetPlayer.DisplayName .. \" Body\") \r\n                              or charsFolder:FindFirstChild(targetPlayer.DisplayName)\r\n                \r\n                local bodyPart = deadBody and (deadBody:FindFirstChild(\"HumanoidRootPart\") or deadBody:FindFirstChild(\"Torso\") or deadBody.PrimaryPart)\r\n                \r\n                if bodyPart then\r\n                    hrp.CFrame = bodyPart.CFrame * CFrame.new(0, 3, 0)\r\n                    WindUI:Notify({Title=\"Teleport\", Content=\"Teleported to \" .. targetPlayer.Name .. \"'s body!\", Duration=3})\r\n                else\r\n                    WindUI:Notify({Title=\"Not Found\", Content=\"Could not find player or their body.\", Duration=3})\r\n                end\r\n            else\r\n                WindUI:Notify({Title=\"Not Found\", Content=\"Could not find player or their body.\", Duration=3})\r\n            end\r\n        end\r\n    end\r\n})\r\n\r\nTabs.Teleport:Section({Title = 'Missing Kid', Icon = 'user'})\r\nchildrenList = {}\r\nselectedChild = nil\r\nChildDrop = Tabs.Teleport:Dropdown({\r\n    Title = 'Select Kid',\r\n    Values = {\"Refresh First\"},\r\n    Callback = function(val) selectedChild = val[1] or val end\r\n})\r\nTabs.Teleport:Button({\r\n    Title = 'Refresh List',\r\n    Callback = function()\r\n        childrenList = {}\r\n        local names = {}\r\n        local kidNameMap = {\r\n            [\"Lost Child\"] = \"Dino Kid (1)\",\r\n            [\"Lost Child1\"] = \"Dino Kid (1)\",\r\n            [\"Lost Child2\"] = \"Kraken Kid (2)\",\r\n            [\"Lost Child3\"] = \"Squid Kid (3)\",\r\n            [\"Lost Child4\"] = \"Koala Kid (4)\"\r\n        }\r\n        for _, c in ipairs(workspace.Characters:GetChildren()) do\r\n            if c.Name:match(\"^Lost Child\") and c:GetAttribute(\"Lost\") == true then\r\n                table.insert(childrenList, c)\r\n                local displayName = kidNameMap[c.Name] or c.Name\r\n                table.insert(names, displayName)\r\n            end\r\n        end\r\n        if #names == 0 then ChildDrop:Refresh({\"No kid found\"}) else ChildDrop:Refresh(names) selectedChild=names[1] end\r\n    end\r\n})\r\nTabs.Teleport:Button({\r\n    Title = 'Teleport to Kid',\r\n    Callback = function()\r\n        local kidNameMapReverse = {\r\n            [\"Dino Kid (1)\"] = \"Lost Child\",\r\n            [\"Kraken Kid (2)\"] = \"Lost Child2\",\r\n            [\"Squid Kid (3)\"] = \"Lost Child3\",\r\n            [\"Koala Kid (4)\"] = \"Lost Child4\"\r\n        }\r\n        local actualName = kidNameMapReverse[selectedChild] or selectedChild\r\n        for _, c in ipairs(childrenList) do\r\n            if c.Name == actualName or (selectedChild == \"Dino Kid (1)\" and c.Name:match(\"^Lost Child1?$\")) then\r\n                local hrp = _LocalPlayer.Character and _LocalPlayer.Character:FindFirstChild(\"HumanoidRootPart\")\r\n                if hrp then hrp.CFrame = c:GetPivot() + Vector3.new(0,5,0) end\r\n                break\r\n            end\r\n        end\r\n    end\r\n})\r\n\r\nTabs.Teleport:Section({Title = 'Kiwi Stump'})\r\n\r\nTabs.Teleport:Button({\r\n    Title = 'Teleport to Kiwi Stump',\r\n    Callback = function()\r\n        local hrp = _LocalPlayer.Character and _LocalPlayer.Character:FindFirstChild(\"HumanoidRootPart\")\r\n        if not hrp then return end\r\n        \r\n        local map = workspace:FindFirstChild(\"Map\")\r\n        local landmarks = map and map:FindFirstChild(\"Landmarks\")\r\n        local chars = workspace:FindFirstChild(\"Characters\")\r\n        if not landmarks or not chars then return end\r\n        \r\n        local validStumps = {}\r\n        for _, lm in ipairs(landmarks:GetChildren()) do\r\n            if string.find(lm.Name, \"Kiwi Stump\") then\r\n                local stumpPos = lm:GetPivot().Position\r\n                local hasKiwi = false\r\n                for _, c in ipairs(chars:GetChildren()) do\r\n                    if string.find(c.Name, \"Kiwi\") and c:FindFirstChild(\"HumanoidRootPart\") then\r\n                        local hum = c:FindFirstChildWhichIsA(\"Humanoid\")\r\n                        if not hum or (hum and hum.Health > 0) then\r\n                            local dist = (c.HumanoidRootPart.Position - stumpPos).Magnitude\r\n                            if dist < 150 then\r\n                                hasKiwi = true\r\n                                break\r\n                            end\r\n                        end\r\n                    end\r\n                end\r\n                \r\n                if hasKiwi then\r\n                    table.insert(validStumps, {\r\n                        Stump = lm,\r\n                        Distance = (stumpPos - hrp.Position).Magnitude\r\n                    })\r\n                end\r\n            end\r\n        end\r\n        \r\n        if #validStumps == 0 then\r\n            if WindUI then WindUI:Notify({Title = \"Kiwi Stump\", Content = \"No living Kiwi found near any stump!\", Duration = 3}) end\r\n            return\r\n        end\r\n        \r\n        table.sort(validStumps, function(a, b) return a.Distance < b.Distance end)\r\n        \r\n        local targetStump = nil\r\n        for _, data in ipairs(validStumps) do\r\n            if data.Distance > 50 then\r\n                targetStump = data.Stump\r\n                break\r\n            end\r\n        end\r\n        \r\n        if not targetStump then targetStump = validStumps[1].Stump end\r\n        \r\n        hrp.CFrame = targetStump:GetPivot() + Vector3.new(0, 3, 0)\r\n    end\r\n})\r\n\r\n-- ==================== EVENT TAB ====================\r\ndo local function INIT_EVENT_TAB()\r\nlocal teleportToReturnPosition\r\n\r\nTabs.Event:Section({Title = 'Halloween Event', Icon = 'ghost'})\r\n\r\nlocal HALLOWEEN_HOUSES = {\r\n    {\r\n        index = 1,\r\n        title = \"1. Halloween House Cracky\",\r\n        path = {\"Halloween House Cracky\"},\r\n        searchNames = {\"Halloween House Cracky\", \"Cracky\", \"Halloween House Cranky\", \"Cranky\", \"House Cracky\", \"House Cranky\"},\r\n        offset = CFrame.new(\r\n            0.7309417724609375,\r\n            4.556628227233887,\r\n            -9.325103759765625\r\n        ) * CFrame.Angles(\r\n            3.1415927410125732,\r\n            0.078328787764072418,\r\n            3.1415927410125732\r\n        ),\r\n        worldCF = nil\r\n    },\r\n    {\r\n        index = 2,\r\n        title = \"2. Halloween House Viridial\",\r\n        path = {\"Halloween House Viridial\"},\r\n        searchNames = {\"Halloween House Viridial\", \"Viridial\", \"House Viridial\"},\r\n        offset = CFrame.new(\r\n            0.0304412841796875,\r\n            4.55662727355957,\r\n            -12.15142822265625\r\n        ) * CFrame.Angles(\r\n            3.141592502593994,\r\n            -0.005539861042052507,\r