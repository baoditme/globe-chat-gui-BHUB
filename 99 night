y = loadAnim(282574440)\r\n        end)\r\n        if character:FindFirstChild(\"Animate\") then character.Animate.Disabled = true end\r\n        for _, track in ipairs(humanoid.Animator:GetPlayingAnimationTracks()) do\r\n            track:Stop()\r\n        end\r\n        humanoid:SetStateEnabled(Enum.HumanoidStateType.Running, false)\r\n        humanoid:SetStateEnabled(Enum.HumanoidStateType.Climbing, false)\r\n        humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)\r\n        humanoid:SetStateEnabled(Enum.HumanoidStateType.Freefall, false)\r\n        humanoid:ChangeState(Enum.HumanoidStateType.Physics)\r\n        humanoid.PlatformStand = true\r\n        \r\n        if hrp:FindFirstChild(\"Running\") then hrp.Running.Volume = 0 end\r\n        \r\n        currentR6Track = nil\r\n        \r\n        if not FlySound then\r\n            FlySound = Instance.new(\"Sound\")\r\n            FlySound.SoundId = \"rbxassetid://3308152153\"\r\n            FlySound.Volume = 0.2\r\n            FlySound.Looped = true\r\n            FlySound.Parent = hrp\r\n        end\r\n        FlySound:Play()\r\n    else\r\n        -- Setup Authentic Animations\r\n        hasAnims = setupFlyAnimations()\r\n        if hasAnims then\r\n            if character:FindFirstChild(\"Animate\") then character.Animate.Disabled = true end\r\n            for _, track in ipairs(humanoid.Animator:GetPlayingAnimationTracks()) do\r\n                track:Stop()\r\n            end\r\n            humanoid:SetStateEnabled(Enum.HumanoidStateType.Running, false)\r\n            humanoid:SetStateEnabled(Enum.HumanoidStateType.Climbing, false)\r\n            humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)\r\n            humanoid:SetStateEnabled(Enum.HumanoidStateType.Freefall, false)\r\n            humanoid:ChangeState(Enum.HumanoidStateType.Physics)\r\n            humanoid.PlatformStand = true\r\n            \r\n            if hrp:FindFirstChild(\"Running\") then hrp.Running.Volume = 0 end\r\n            \r\n            if not FlySound then\r\n                FlySound = Instance.new(\"Sound\")\r\n                FlySound.SoundId = \"rbxassetid://3308152153\"\r\n                FlySound.Volume = 0.2\r\n                FlySound.Looped = true\r\n                FlySound.Parent = hrp\r\n            end\r\n            FlySound:Play()\r\n            if not MyCustomAnimator then\r\n                MyCustomAnimator = CustomAnimator.new(character)\r\n            end\r\n            if not _G.KixMapRevealPoseLock then\r\n                MyCustomAnimator:Play(ParsedHoverAnim)\r\n            end\r\n        end\r\n    end\r\n\r\n    local gyro = Instance.new(\"BodyGyro\")\r\n    gyro.Name = \"FlyGyro\"\r\n    gyro.P = 9e4\r\n    gyro.MaxTorque = Vector3.new(9e9, 9e9, 9e9)\r\n    gyro.CFrame = workspace.CurrentCamera.CFrame\r\n    gyro.Parent = hrp\r\n\r\n    local velocity = Instance.new(\"BodyVelocity\")\r\n    velocity.Name = \"FlyVelocity\"\r\n    velocity.MaxForce = Vector3.new(9e9, 9e9, 9e9)\r\n    velocity.Parent = hrp\r\n\r\n    flyConnection = _RunService.RenderStepped:Connect(function()\r\n        if not flying then return end\r\n\r\n        local character = _LocalPlayer.Character\r\n        if not character then return end\r\n\r\n        local hrp = character:FindFirstChild(\"HumanoidRootPart\")\r\n        local humanoid = character:FindFirstChild(\"Humanoid\")\r\n        local camera = workspace.CurrentCamera\r\n\r\n        if not hrp or not humanoid or not camera then return end\r\n\r\n        -- Biar sistem gerak & rotasi bawaan Roblox ga rebutan sama BodyVelocity/BodyGyro kita\r\n        humanoid.AutoRotate = false\r\n        if humanoid:GetState() ~= Enum.HumanoidStateType.Physics then\r\n            humanoid:ChangeState(Enum.HumanoidStateType.Physics)\r\n        end\r\n\r\n        local camCF = camera.CFrame\r\n\r\n        if _G.KixMapRevealPoseLock then\r\n            velocity.Velocity = Vector3.zero\r\n            local poseRotation = AutoMapReveal and AutoMapReveal.State\r\n                and AutoMapReveal.State.PoseRotation\r\n            gyro.CFrame = CFrame.new(hrp.Position) * (poseRotation or hrp.CFrame.Rotation)\r\n            if currentR6Track then\r\n                currentR6Track:Stop(0)\r\n                currentR6Track = nil\r\n            end\r\n            if MyCustomAnimator and MyCustomAnimator.ActiveTrack then\r\n                MyCustomAnimator:Stop()\r\n            end\r\n            return\r\n        end\r\n\r\n        local speed = 50\r\n\r\n        if WalkSpeedEnabled and TargetWalkSpeed ~= 16 then\r\n            speed = TargetWalkSpeed\r\n        end\r\n\r\n        --==================================================\r\n        -- INPUT GERAK (PC / Mobile / Gamepad - satu jalur lewat MoveDirection)\r\n        --==================================================\r\n\r\n        local lookXZ = Vector3.new(camCF.LookVector.X, 0, camCF.LookVector.Z)\r\n        local rightXZ = Vector3.new(camCF.RightVector.X, 0, camCF.RightVector.Z)\r\n\r\n        local flatLook = lookXZ.Magnitude > 0.001 and lookXZ.Unit or Vector3.new(0, 0, -1)\r\n        local flatRight = rightXZ.Magnitude > 0.001 and rightXZ.Unit or Vector3.new(1, 0, 0)\r\n\r\n        -- MoveDirection sudah otomatis terisi dari WASD, joystick mobile, maupun gamepad,\r\n        -- jadi ini satu-satunya sumber input gerak horizontal yang kita baca\r\n        local moveDir = humanoid.MoveDirection\r\n\r\n        -- Uraikan jadi \"seberapa maju\" & \"seberapa nyamping\" relatif kamera (versi datar dulu)\r\n        local forwardAmount = moveDir:Dot(flatLook)\r\n        local strafeAmount = moveDir:Dot(flatRight)\r\n\r\n        -- Baru disusun ulang pakai LookVector/RightVector kamera yang PUNYA kemiringan,\r\n        -- biar nunduk/dongak kamera beneran bikin badan turun/naik kayak terbang asli\r\n        local moveVec = (camCF.LookVector * forwardAmount) + (camCF.RightVector * strafeAmount)\r\n\r\n        --==================================================\r\n        -- NAIK / TURUN\r\n        --==================================================\r\n\r\n        if _UserInputService:IsKeyDown(Enum.KeyCode.Space) then\r\n            moveVec = moveVec + Vector3.new(0, 1, 0)\r\n        end\r\n\r\n        if _UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then\r\n            moveVec = moveVec - Vector3.new(0, 1, 0)\r\n        end\r\n\r\n        --==================================================\r\n        -- APPLY MOVEMENT\r\n        --==================================================\r\n\r\n        if moveVec.Magnitude > 0.01 then\r\n            velocity.Velocity = moveVec.Unit * speed\r\n        else\r\n            velocity.Velocity = Vector3.new(\r\n                0,\r\n                math.sin(time() * 3) * 1.5,\r\n                0\r\n            )\r\n        end\r\n\r\n        --==================================================\r\n        -- FOLLOW CAMERA\r\n        --==================================================\r\n\r\n        gyro.CFrame = camCF\r\n\r\n        if hrp:FindFirstChild(\"Running\") then\r\n            hrp.Running.Volume = 0\r\n        end\r\n\r\n        --==================================================\r\n        -- ANIMATION\r\n        --==================================================\r\n\r\n        if isR6Avatar then\r\n\r\n            -- Default: TIDAK ADA ANIMASI saat diam\r\n            local desiredTrack = nil\r\n\r\n            -- Saat bergerak: selalu gunakan pose Super Hero\r\n            if moveVec.Magnitude > 0.05 then\r\n                desiredTrack = R6Tracks.FastFly\r\n            end\r\n\r\n            -- Ganti track hanya jika memang berubah\r\n            if currentR6Track ~= desiredTrack then\r\n\r\n                if currentR6Track then\r\n                    currentR6Track:Stop()\r\n                end\r\n\r\n                currentR6Track = desiredTrack\r\n\r\n                if currentR6Track then\r\n                    currentR6Track:Play()\r\n                end\r\n            end\r\n\r\n        elseif hasAnims and MyCustomAnimator then\r\n\r\n            if moveVec.Magnitude > 0.05 then\r\n\r\n                if MyCustomAnimator.ActiveTrack ~= ParsedFlyAnim then\r\n                    MyCustomAnimator:Play(ParsedFlyAnim)\r\n                end\r\n\r\n            else\r\n\r\n                if MyCustomAnimator.ActiveTrack ~= ParsedHoverAnim then\r\n                    MyCustomAnimator:Play(ParsedHoverAnim)\r\n                end\r\n\r\n            end\r\n        end\r\n    end)\r\n    \r\n    armConnection = _RunService.Stepped:Connect(function()\r\n        if not flying or not isR6Avatar then\r\n            return\r\n        end\r\n\r\n        local character = _LocalPlayer.Character\r\n        if not character then\r\n            return\r\n        end\r\n\r\n        local torso = character:FindFirstChild(\"Torso\")\r\n        if not torso then\r\n            return\r\n        end\r\n\r\n        local rs = torso:FindFirstChild(\"Right Shoulder\")\r\n        local ls = torso:FindFirstChild(\"Left Shoulder\")\r\n        local rh = torso:FindFirstChild(\"Right Hip\")\r\n        local lh = torso:FindFirstChild(\"Left Hip\")\r\n        local neck = torso:FindFirstChild(\"Neck\")\r\n\r\n        -- =====================================================\r\n        -- HOVER / IDLE\r\n        -- =====================================================\r\n        if currentR6Track == nil then\r\n\r\n            -- Tangan static\r\n            if rs then\r\n                rs.Transform = CFrame.Angles(math.rad(15), 0, 0)\r\n            end\r\n\r\n            if ls then\r\n                ls.Transform = CFrame.Angles(math.rad(15), 0, 0)\r\n            end\r\n\r\n            -- Kaki static / lurus\r\n            if rh then\r\n                rh.Transform = CFrame.new()\r\n            end\r\n\r\n            if lh then\r\n                lh.Transform = CFrame.new()\r\n            end\r\n\r\n            -- Kepala static\r\n            if neck then\r\n                neck.Transform = CFrame.new()\r\n            end\r\n        end\r\n    end)\r\nend\r\n\r\nlocal function stopFlying()\r\n    flying = false\r\n    if flyConnection then\r\n        flyConnection:Disconnect()\r\n        flyConnection = nil\r\n    end\r\n    if armConnection then\r\n        armConnection:Disconnect()\r\n        armConnection = nil\r\n    end\r\n    \r\n    if currentR6Track then currentR6Track:Stop() currentR6Track = nil end\r\n    if FlyAnimTrack then FlyAnimTrack:Stop() end\r\n    if HoverAnimTrack then HoverAnimTrack:Stop() end\r\n    if FlySound then FlySound:Stop() end\r\n\r\n    -- Destroy langsung instance yang dipakai pas terbang (bukan nyari lewat class),\r\n    -- biar pasti kena walaupun parent-nya bukan di HumanoidRootPart, dan ga ikut\r\n    -- ngehapus BodyVelocity/BodyGyro punya sistem lain kalau kebetulan ada di part yang sama\r\n    if velocity then\r\n        velocity:Destroy()\r\n        velocity = nil\r\n    end\r\n\r\n    if gyro then\r\n        gyro:Destroy()\r\n        gyro = nil\r\n    end\r\n    \r\n    local character = _LocalPlayer.Character\r\n    if character and character:FindFirstChild(\"HumanoidRootPart\") then\r\n        local hrp = character.HumanoidRootPart\r\n        local humanoid = character:FindFirstChild(\"Humanoid\")\r\n\r\n        -- Jaring pengaman kalau-kalau masih ada sisa BodyGyro/BodyVelocity nyangkut\r\n        for _, v in ipairs(hrp:GetChildren()) do\r\n            if v:IsA(\"BodyGyro\") or v:IsA(\"BodyVelocity\") then\r\n                v:Destroy()\r\n            end\r\n        end\r\n        \r\n        if humanoid then\r\n            humanoid:SetStateEnabled(Enum.HumanoidStateType.Running, true)\r\n            humanoid:SetStateEnabled(Enum.HumanoidStateType.Climbing, true)\r\n            humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)\r\n            humanoid:SetStateEnabled(Enum.HumanoidStateType.Freefall, true)\r\n            \r\n            if character:FindFirstChild(\"Animate\") then character.Animate.Disabled = false end\r\n            if hrp:FindFirstChild(\"Running\") then hrp.Running.Volume = 1 end\r\n\r\n            -- Ini yang kelewat sebelumnya: AutoRotate harus dibalikin true,\r\n            -- soalnya di render-stepped kita set false pas mulai terbang\r\n            humanoid.AutoRotate = true\r\n            humanoid.PlatformStand = false\r\n            humanoid:ChangeState(Enum.HumanoidStateType.Freefall)\r\n        end\r\n    end\r\nend\r\n\r\n_LocalPlayer.CharacterAdded:Connect(function(char)\r\n    if flying then\r\n        task.wait(0.5) -- Wait for humanoid to load\r\n        flying = false -- reset internal state\r\n        startFlying()\r\n    end\r\nend)\r\n\r\n\r\n-- NO FOG\r\nlocal function getAtmospheres()\r\n    local t = {}\r\n    for _, v in ipairs(_Lighting:GetChildren()) do\r\n        if v:IsA(\"Atmosphere\") then table.insert(t, v) end\r\n    end\r\n    return t\r\nend\r\n\r\nlocal function cacheAtmosphere(a)\r\n    if DEFAULT_LIGHTING.Atmosphere[a] then return end\r\n    DEFAULT_LIGHTING.Atmosphere[a] = {\r\n        Density = a.Density,\r\n        Haze = a.Haze,\r\n    }\r\nend\r\n\r\nmapTilesContainers = {}\r\nmapIconsContainers = {}\r\nmapContainersCached = false\r\ncachedBoundaries = {}\r\n\r\nlocal function cacheMapContainers()\r\n    if mapContainersCached then return end\r\n    pcall(function()\r\n        local PlayerGui = _LocalPlayer:WaitForChild(\"PlayerGui\")\r\n        for _, gui in ipairs(PlayerGui:GetDescendants()) do\r\n            if gui.Name == \"Tiles\" and gui.Parent and (gui.Parent.Name == \"Map\" or gui.Parent.Name == \"CaveMap\") then\r\n                table.insert(mapTilesContainers, gui)\r\n            end\r\n            if gui.Name == \"Icons\" and gui.Parent and (gui.Parent.Name == \"Map\" or gui.Parent.Name == \"CaveMap\") then\r\n                table.insert(mapIconsContainers, gui)\r\n            end\r\n        end\r\n        if #mapTilesContainers > 0 then mapContainersCached = true end\r\n    end)\r\nend\r\n\r\nlocal function applyNoFog()\r\n    _Lighting.FogStart = 1e7\r\n    _Lighting.FogEnd   = 1e7 + 1000\r\n    for _, a in ipairs(getAtmospheres()) do\r\n        cacheAtmosphere(a)\r\n        a.Density = 0\r\n        a.Haze = 0\r\n    end\r\n    \r\n    local cc = _Lighting:FindFirstChild(\"ColorCorrection\") or _Lighting:FindFirstChildWhichIsA(\"ColorCorrectionEffect\")\r\n    if cc then\r\n        cc.Enabled = true\r\n        cc.Brightness = 0\r\n        cc.Contrast = 0\r\n        cc.Saturation = -0.05\r\n        cc.TintColor = Color3.fromRGB(255, 255, 255)\r\n    end\r\n    \r\n    local boundaries = workspace:FindFirstChild(\"Map\") and workspace.Map:FindFirstChild(\"Boundaries\")\r\n    if boundaries then\r\n        for _, part in ipairs(boundaries:GetChildren()) do\r\n            if part:IsA(\"BasePart\") then\r\n                if not cachedBoundaries[part] then\r\n                    cachedBoundaries[part] = part.Transparency\r\n                end\r\n                if part.Transparency ~= 1 then\r\n                    part.Transparency = 1\r\n                end\r\n            end\r\n        end\r\n    end\r\n    \r\n    -- Clear 2D Map Fog (Poster Map) & Reveal Icons (CACHED - NO LAG)\r\n    cacheMapContainers()\r\n    pcall(function()\r\n        for _, tiles in ipairs(mapTilesContainers) do\r\n            tiles.Visible = false\r\n        end\r\n        for _, icons in ipairs(mapIconsContainers) do\r\n            for _, icon in ipairs(icons:GetChildren()) do\r\n                if icon:IsA(\"ImageLabel\") then icon.Visible = true end\r\n            end\r\n        end\r\n    end)\r\nend\r\n\r\nlocal function restoreFog()\r\n    _Lighting.FogStart = DEFAULT_LIGHTING.FogStart\r\n    _Lighting.FogEnd   = DEFAULT_LIGHTING.FogEnd\r\n    for a, d in pairs(DEFAULT_LIGHTING.Atmosphere) do\r\n        if a and a.Parent then\r\n            a.Density = d.Density\r\n            a.Haze = d.Haze\r\n        end\r\n    end\r\n    \r\n    for part, origTrans in pairs(cachedBoundaries) do\r\n        if part and part.Parent then\r\n            part.Transparency = origTrans\r\n        end\r\n    end\r\n    cachedBoundaries = {}\r\n    \r\n    -- Restore 2D Map Fog\r\n    pcall(function()\r\n        for _, tiles in ipairs(mapTilesContainers) do\r\n            tiles.Visible = true\r\n        end\r\n    end)\r\nend\r\n\r\n_Lighting.ChildAdded:Connect(function(child)\r\n    if NoFogEnabled and child:IsA(\"Atmosphere\") then\r\n        task.delay(0.1, applyNoFog)\r\n    end\r\nend)\r\n\r\n_Lighting:GetPropertyChangedSignal(\"FogEnd\"):Connect(function()\r\n    if NoFogEnabled then task.delay(0.1, applyNoFog) end\r\nend)\r\n\r\nlocal function startTick()\r\n    if tickConn then return end\r\n    tickConn = task.spawn(function()\r\n        while NoFogEnabled do\r\n            applyNoFog()\r\n            task.wait(1.2)\r\n        end\r\n    end)\r\nend\r\n\r\nlocal function stopTick()\r\n    if tickConn then\r\n        task.cancel(tickConn)\r\n        tickConn = nil\r\n    end\r\nend\r\n\r\n-- INTERACT & JUMP HOOKS\r\n_ProximityPromptService.PromptShown:Connect(function(p)\r\n    if InstantInteractEnabled then \r\n        p.HoldDuration = 0 \r\n    end\r\nend)\r\n\r\n_UserInputService.JumpRequest:Connect(function()\r\n    if InfiniteJumpEnabled and humanoid then\r\n        humanoid:ChangeState(Enum.HumanoidStateType.Jumping)\r\n    end\r\nend)\r\n\r\n\r\n-- ==================== UTILITY VARIABLES ====================\r\nlocal toolEquipData = {\r\n    ['Old Axe'] = '3_7367831688',\r\n    ['Good Axe'] = '112_7367831688',\r\n    ['Woodsman\\'s Axe'] = '116_7367831688',\r\n    ['Strong Axe'] = '116_7367831688',\r\n    ['Corrupted Axe'] = '116_7367831688',\r\n    ['Ice Axe'] = '116_7367831688',\r\n    ['Admin Axe'] = '116_7367831688',\r\n    ['Infernal Sword'] = '116_7367831688',\r\n    ['Obsidiron Hammer'] = '116_7367831688',\r\n    Morningstar = '116_7367831688',\r\n    ['Laser Sword'] = '116_7367831688',\r\n    ['Ice Sword'] = '116_7367831688',\r\n    Katana = '116_7367831688',\r\n    Trident = '116_7367831688',\r\n    ['Poison Spear'] = '116_7367831688',\r\n    Chainsaw = '647_8992824875',\r\n    Spear = '196_8999010016',\r\n    Scythe = '116_7367831688',\r\n    ['Vampire Scythe'] = '116_7367831688',\r\n    ['Poison Claws'] = '116_7367831688',\r\n    [\"Happy's Scythe\"] = '116_7367831688',\r\n    ['Flamethrower'] = '116_7367831688',\r\n    ['Laser Cannon'] = '116_7367831688',\r\n}\r\n\r\nlistFood = {'Cake', 'Cooked Steak', 'Cooked Morsel', 'Ribs', 'Salmon', 'Cooked Salmon', 'Cooked Ribs', 'Mackerel', 'Cooked Mackerel', 'Steak', 'Morsel', 'Berry', 'Carrot', 'Stew', 'Hearty Stew', 'Corn', 'Pumpkin', 'Meat? Sandwich', 'Seafood Chowder', 'Steak Dinner', 'Pumpkin Soup', 'BBQ Ribs', 'Carrot Cake', 'Jar o\\' Jelly', 'Clownfish', 'Swordfish', 'Jellyfish', 'Char', 'Eel', 'Shark', 'Cooked Clownfish', 'Cooked Swordfish', 'Cooked Jellyfish', 'Cooked Char', 'Cooked Eel', 'Cooked Shark'}\r\nlistCampfireUpgrades = {'Coal', 'Fuel Canister', 'Oil Barrel', 'Biofuel'}\r\nlistFuel = {'Log', 'Chair', 'Coal', 'Fuel Canister', 'Oil Barrel', 'Corpse'}\r\nlistPelt = {'Bunny Foot', 'Wolf Pelt', 'Alpha Wolf Pelt', 'Bear Pelt'}\r\nlistScrap = {'Log', 'Chair', 'Bolt', 'Sheet Metal', 'UFO Junk', 'UFO Component', 'Broken Fan', 'Old Radio', 'Gears', 'Broken Microwave', 'Tyre', 'Metal Chair', 'Old Car Engine', 'Washing Machine', 'Cultist Experiment', 'Cultist Prototype', 'UFO Scrap', 'Cultist Gem', 'Gem of the Forest Fragment', 'Gem of the Forest'}\r\nlistEquipment = {\"Happy's Scythe\", 'Infernal Sword', 'Infernal Sack', 'Infernal Crossbow', 'Giant Sack', 'Woodsman\\'s Axe', 'Strong Axe', 'Corrupted Axe', 'Chainsaw', 'Spear', 'Poison Spear', 'Poison Claws', 'Morningstar', 'Poison Armour', 'Alien Armour', 'Thorn Body', 'Iron Body', 'Laser Cannon', 'Strong Flashlight', 'Ice Sword', 'Tactical Shotgun', 'Scythe', 'Vampire Cloak', 'Kunai', 'Infernal Helmet', 'Polar Bear Hat', 'Mammoth Helmet', 'Dynamite', 'Impact Grenade', 'Revolver', 'Rifle', 'Revolver Ammo', 'Rifle Ammo', 'Good Sack', 'Good Axe', 'Frozen Shuriken', 'Snowball', 'Leather Body', 'Riot Shield', 'Red Key', 'Blue Key', 'Yellow Key', 'Grey Key', 'Frog Key', 'Chili Seeds', 'Flower Seeds', 'Berry Seeds', 'Firefly Seeds', 'Old Rod', 'Good Rod', 'Strong Rod', 'Old Taming Flute', 'Old Flashlight', 'Laser Sword'}\r\nlistMeteor = {'Meteor Shard', 'Gold Shard', 'Raw Obsidiron Ore', 'Scalding Obsidiron Ingot', 'Obsidiron Ingot'}\r\nlistDinoKid = {\"Dino Kid's Lunchbox\", \"Dino Kid's Yoyo\", \"Dino Kid's Crayon\"}\r\nbringAmount = 10\r\nbringDestination = 'Player'\r\nbringSelections = {Fuel = {}, Food = {}, Medicine = {}, Scrap = {}, Equipment = {}, Pelt = {}, Meteor = {}, DinoKid = {}}\r\nlistCookFood = {'Morsel', 'Steak', 'Ribs', 'Salmon', 'Mackerel'}\r\n\r\nRAW_FOOD_NAMES = {\r\n    ['Morsel'] = true, ['Steak'] = true, ['Ribs'] = true, ['Salmon'] = true, ['Mackerel'] = true,\r\n    ['Clownfish'] = true, ['Swordfish'] = true, ['Jellyfish'] = true, ['Char'] = true,\r\n    ['Eel'] = true, ['Shark'] = true, ['Lava Eel'] = true, ['Lionfish'] = true,\r\n    ['Raw Meat'] = true, ['Raw Fish'] = true, ['Raw Morsel'] = true, ['Raw Steak'] = true,\r\n    ['Raw Ribs'] = true, ['Raw Salmon'] = true\r\n}\r\n\r\nfunction isRawFood(name)\r\n    if not name or type(name) ~= \"string\" then return false end\r\n    if RAW_FOOD_NAMES[name] then return true end\r\n    local lower = string.lower(name)\r\n    if string.find(lower, \"raw\") then return true end\r\n    return false\r\nend\r\n\r\n-- Auto States\r\nlocal campfireUpgradeTarget = {\"Coal\", \"Fuel Canister\", \"Oil Barrel\"}\r\nscrapTarget = {}\r\ncookFoodTargets = {}\r\nautoStrongholdChest = false\r\n\r\nlocal campfirePos = Vector3.new(0, 19, 0)\r\nlocal scrapMachinePos = Vector3.new(21, 20, -5)\r\nlocal customReturnPos = (KixHubSavedState and KixHubSavedState.customReturnPos)\r\n\r\nlocal function getVoidDropPosition()\r\n    local ok, pos = pcall(function()\r\n        local map = _Workspace:FindFirstChild(\"Map\") or workspace:FindFirstChild(\"Map\")\r\n        local spawnLoc = map and map:FindFirstChild(\"SpawnLocation\")\r\n        if not spawnLoc then\r\n            spawnLoc = _Workspace:FindFirstChild(\"SpawnLocation\") or workspace:FindFirstChild(\"SpawnLocation\")\r\n        end\r\n        if spawnLoc then\r\n            local spawnPosition\r\n            if spawnLoc:IsA(\"BasePart\") then\r\n                spawnPosition = spawnLoc.Position\r\n            elseif spawnLoc:IsA(\"Model\") then\r\n                spawnPosition = spawnLoc:GetPivot().Position\r\n            end\r\n            if spawnPosition then\r\n                -- SpawnLocation may sit above ground; place trash well below the world floor.\r\n                return Vector3.new(spawnPosition.X, math.min(spawnPosition.Y - 500, -500), spawnPosition.Z)\r\n            end\r\n        end\r\n        return nil\r\n    end)\r\n    if ok and pos then\r\n        return pos\r\n    end\r\n    return Vector3.new(0, -500, 0)\r\nend\r\n\r\n-- style item transport: validate, claim drag ownership, move, then release.\r\ndo\r\n    local activeItems = setmetatable({}, {__mode = \"k\"})\r\n    local cachedStartDrag, cachedStopDrag, cachedRemoteFolder\r\n    local function getDragRemotes()\r\n        local folder = _ReplicatedStorage:FindFirstChild(\"RemoteEvents\")\r\n        if folder ~= cachedRemoteFolder or not cachedStartDrag or not cachedStopDrag then\r\n            cachedRemoteFolder = folder\r\n            cachedStartDrag = folder and folder:FindFirstChild(\"RequestStartDraggingItem\")\r\n            cachedStopDrag = folder and folder:FindFirstChild(\"StopDraggingItem\")\r\n        end\r\n        return cachedStartDrag, cachedStopDrag\r\n    end\r\n    local function canTeleport(item)\r\n        if not item or not item:IsA(\"Model\") or not item.PrimaryPart\r\n            or item:GetAttribute(\"Interaction\") == nil\r\n            or item:GetAttribute(\"Locked\") == true\r\n            or item:GetAttribute(\"IceBlock\") == true then\r\n            return false\r\n        end\r\n        local primary = item.PrimaryPart\r\n        if primary.Anchored and not primary.CanCollide and not primary.CanQuery and not primary.CanTouch then\r\n            for _, part in ipairs(item:GetDescendants()) do\r\n                if part:IsA(\"BasePart\") and not (part.Anchored and not part.CanCollide and not part.CanQuery and not part.CanTouch) then\r\n                    return true\r\n                end\r\n            end\r\n            return false\r\n        end\r\n        return true\r\n    end\r\n    local function move(item, target, active, afterMove, waitWhile, pivotWholeModel)\r\n        if not item or activeItems[item] or not canTeleport(item) or (active and not active()) then return false end\r\n        local startDrag, stopDrag = getDragRemotes()\r\n        if not startDrag or not stopDrag then return false end\r\n        local originalParent, primary = item.Parent, item.PrimaryPart\r\n        local localPlayer = _LocalPlayer\r\n        local knownCorpse = string.sub(item.Name, -7) == \" Corpse\"\r\n            and item:GetAttribute(\"Dead\") ~= false and primary.Name == \"HumanoidRootPart\"\r\n            and item:FindFirstChildWhichIsA(\"BallSocketConstraint\", true) ~= nil\r\n        local isRagdoll = knownCorpse\r\n            or item:GetAttribute(\"RagdollBody\") == true and item:GetAttribute(\"Dead\") == true\r\n        local function valid()\r\n            return originalParent ~= nil and item.Parent == originalParent and item.PrimaryPart == primary\r\n                and primary:IsDescendantOf(item) and item:GetAttribute(\"Locked\") ~= true\r\n                and item:GetAttribute(\"IceBlock\") ~= true and (not active or active())\r\n        end\r\n        local function owned()\r\n            if not valid() or primary.Anchored or item:GetAttribute(\"Owner\") ~= localPlayer.UserId then return false end\r\n            local roots = {}\r\n            for _, part in ipairs(item:GetDescendants()) do\r\n                if part:IsA(\"BasePart\") then\r\n                    local root = part.AssemblyRootPart\r\n                    if not root or root.Anchored or not root:IsDescendantOf(item) then return false end\r\n                    if not roots[root] then\r\n                        roots[root] = true\r\n                        for _, connected in ipairs(part:GetConnectedParts(true)) do\r\n                            if not connected:IsDescendantOf(item) then return false end\r\n                        end\r\n                    end\r\n                end\r\n            end\r\n            if type(getnetworkowner) == \"function\" then\r\n                for root in pairs(roots) do\r\n                    if not isRagdoll or root == primary.AssemblyRootPart then\r\n                        local ok, isLocal = pcall(getnetworkowner, root)\r\n                        if not ok or isLocal ~= true then return false end\r\n                    end\r\n                end\r\n            end\r\n            return true\r\n        end\r\n        activeItems[item] = true\r\n        local moved = false\r\n        local ok = pcall(function()\r\n            startDrag:FireServer(item)\r\n            local deadline = os.clock() + 2\r\n            while valid() and not owned() and os.clock() < deadline do task.wait(0.05) end\r\n            if not valid() or not owned() then return end\r\n            local targetCFrame = typeof(target) == \"Vector3\" and CFrame.new(target) or target\r\n            if typeof(targetCFrame) ~= \"CFrame\" then return end\r\n            if isRagdoll and not pivotWholeModel then\r\n                primary.CFrame = targetCFrame * item:GetPivot():ToObjectSpace(primary.CFrame)\r\n            else\r\n                item:PivotTo(targetCFrame)\r\n            end\r\n            if afterMove then afterMove(item) end\r\n            task.wait(0.15)\r\n         