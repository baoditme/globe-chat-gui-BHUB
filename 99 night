= {\"Halloween House Foryxe\", \"Foryxe\", \"Halloween House Foxy\", \"Foxy\", \"House Foryxe\", \"House Foxy\"},\r\n        offset = CFrame.new(\r\n            -0.4961090087890625,\r\n            4.5566277503967285,\r\n            -9.657791137695312\r\n        ) * CFrame.Angles(\r\n            -3.1415927410125732,\r\n            -0.07617498934268951,\r\n            -3.1415927410125732\r\n        ),\r\n        worldCF = nil\r\n    },\r\n    {\r\n        index = 7,\r\n        title = \"7. Halloween House Alien\",\r\n        path = {\"Halloween House Alien\"},\r\n        searchNames = {\"Halloween House Alien\", \"Alien\", \"House Alien\"},\r\n        offset = CFrame.new(\r\n            19.120140075683594,\r\n            6.556628227233887,\r\n            -8.63946533203125\r\n        ) * CFrame.Angles(\r\n            3.141592502593994,\r\n            0.018698617815971375,\r\n            -3.141592502593994\r\n        ),\r\n        worldCF = nil\r\n    },\r\n    {\r\n        index = 8,\r\n        title = \"8. Halloween House Pelt Trader\",\r\n        path = {\"Halloween House Pelt Trader\"},\r\n        searchNames = {\"Halloween House Pelt Trader\", \"Pelt Trader\", \"House Pelt Trader\"},\r\n        offset = CFrame.new(\r\n            20.129119873046875,\r\n            6.556628704071045,\r\n            8.292144775390625\r\n        ) * CFrame.Angles(\r\n            -3.141592502593994,\r\n            0.035031866282224655,\r\n            3.141592502593994\r\n        ),\r\n        worldCF = nil\r\n    },\r\n    {\r\n        index = 9,\r\n        title = \"9. Halloween House Furniture Trader\",\r\n        path = {\"Halloween House Furniture Trader\"},\r\n        searchNames = {\"Halloween House Furniture Trader\", \"Furniture Trader\", \"House Furniture Trader\"},\r\n        offset = CFrame.new(\r\n            0.0143044130640625,\r\n            4.55662727355957,\r\n            -10.040283203125\r\n        ) * CFrame.Angles(\r\n            3.141592502593994,\r\n            -0.043484777212142944,\r\n            3.1415927410125732\r\n        ),\r\n        worldCF = nil\r\n    }\r\n}\r\n\r\nlocal function findHalloweenTarget(houseInfo)\r\n    local map = workspace:FindFirstChild(\"Map\")\r\n    local landmarks = map and map:FindFirstChild(\"Landmarks\")\r\n    local characters = workspace:FindFirstChild(\"Characters\")\r\n    \r\n    -- 0. Direct specific path under Landmarks if specified\r\n    if houseInfo.path and landmarks then\r\n        local current = landmarks\r\n        for _, seg in ipairs(houseInfo.path) do\r\n            if current then\r\n                current = current:FindFirstChild(seg)\r\n            else\r\n                break\r\n            end\r\n        end\r\n        if current then return current end\r\n    end\r\n    \r\n    -- 1. Landmarks folder (recursive search using FindFirstChild with true)\r\n    if landmarks then\r\n        for _, name in ipairs(houseInfo.searchNames) do\r\n            local found = landmarks:FindFirstChild(name, true)\r\n            if found then return found end\r\n        end\r\n    end\r\n    \r\n    -- 2. Characters folder (recursive)\r\n    if characters then\r\n        for _, name in ipairs(houseInfo.searchNames) do\r\n            local found = characters:FindFirstChild(name, true)\r\n            if found then return found end\r\n        end\r\n    end\r\n    \r\n    -- 3. Global search\r\n    for _, name in ipairs(houseInfo.searchNames) do\r\n        local found = workspace:FindFirstChild(name, true)\r\n        if found and found ~= _LocalPlayer.Character and not found:IsDescendantOf(_LocalPlayer.Character) then\r\n            return found\r\n        end\r\n    end\r\n    \r\n    return nil\r\nend\r\n\r\nlocal function getHalloweenHouseCFrame(houseInfo)\r\n    local target = findHalloweenTarget(houseInfo)\r\n    if target then\r\n        local functional = target:FindFirstChild(\"Functional\")\r\n        local playerPart = functional and functional:FindFirstChild(\"PlayerPart\")\r\n        if playerPart and playerPart:IsA(\"BasePart\") then\r\n            return playerPart.CFrame, target\r\n        end\r\n        return target:GetPivot() * houseInfo.offset, target\r\n    elseif houseInfo.worldCF then\r\n        return houseInfo.worldCF * houseInfo.offset, nil\r\n    end\r\n    return nil, nil\r\nend\r\n\r\nlocal function teleportPlayerToHalloweenHouse(cframe)\r\n    if _G.IsStrongholdRaidActive or _G.StrongholdTransition or _G.StrongholdPreparingRaid then\r\n        return false\r\n    end\r\n    local char = _LocalPlayer.Character\r\n    local hrp = char and char:FindFirstChild(\"HumanoidRootPart\")\r\n    if not hrp then return false end\r\n    \r\n    hrp.AssemblyLinearVelocity = Vector3.zero\r\n    hrp.AssemblyAngularVelocity = Vector3.zero\r\n    hrp.CFrame = cframe\r\n    task.wait(0.05)\r\n    hrp.AssemblyLinearVelocity = Vector3.zero\r\n    hrp.AssemblyAngularVelocity = Vector3.zero\r\n    return true\r\nend\r\n\r\nlocal function findHouseDoor(targetModel)\r\n    if not targetModel then return nil end\r\n    local functional = targetModel:FindFirstChild(\"Functional\")\r\n    if functional then\r\n        local door = functional:FindFirstChild(\"Door\")\r\n        if door then return door end\r\n        for _, child in ipairs(functional:GetChildren()) do\r\n            if child:FindFirstChild(\"ProximityAttachment\", true) or child:FindFirstChild(\"ProximityInteraction\", true) then\r\n                return child\r\n            end\r\n        end\r\n    end\r\n    for _, desc in ipairs(targetModel:GetDescendants()) do\r\n        if desc.Name == \"ProximityInteraction\" and desc:IsA(\"ProximityPrompt\") then\r\n            local p = desc.Parent\r\n            while p and p.Parent ~= targetModel and p.Parent ~= (functional or targetModel) do\r\n                p = p.Parent\r\n            end\r\n            if p then return p end\r\n        end\r\n    end\r\n    return nil\r\nend\r\n\r\nlocal function collectAllHalloweenCandies(hrp)\r\n    local okC, CandyClient = pcall(function()\r\n        return require(_LocalPlayer.PlayerScripts.Client.HalloweenModules.CandyClient)\r\n    end)\r\n    local okClient, Client = pcall(function()\r\n        return require(_LocalPlayer.PlayerScripts.Client)\r\n    end)\r\n\r\n    local candyFolders = {\r\n        workspace:FindFirstChild(\"Halloween\") and workspace.Halloween:FindFirstChild(\"Candy\"),\r\n        workspace:FindFirstChild(\"Candy\"),\r\n        workspace:FindFirstChild(\"Items\")\r\n    }\r\n\r\n    for _, folder in ipairs(candyFolders) do\r\n        if folder then\r\n            for _, item in ipairs(folder:GetChildren()) do\r\n                if item.Name == \"Candy\" or item:GetAttribute(\"CandySource\") ~= nil then\r\n                    -- 1. Tarik/pindahkan fisik permen ke posisi player di base jika ada HRP\r\n                    if hrp then\r\n                        pcall(function()\r\n                            if item:IsA(\"BasePart\") then\r\n                                item.CFrame = hrp.CFrame\r\n                                item.AssemblyLinearVelocity = Vector3.zero\r\n                            elseif item:IsA(\"Model\") then\r\n                                item:PivotTo(hrp.CFrame)\r\n                            end\r\n                        end)\r\n                    end\r\n\r\n                    -- 2. Panggil modul resmi CandyClient.TakeClient\r\n                    if okC and CandyClient and type(CandyClient.TakeClient) == \"function\" then\r\n                        pcall(function() CandyClient.TakeClient(item) end)\r\n                    end\r\n\r\n                    -- 3. Panggil remote event RequestCollectCandy\r\n                    if okClient and Client and Client.Events then\r\n                        if Client.Events.RequestCollectCandy then\r\n                            pcall(function()\r\n                                local src = item:GetAttribute(\"CandySource\") or \"House\"\r\n                                Client.Events.RequestCollectCandy:FireServer(1, src)\r\n                            end)\r\n                        end\r\n                        local sId = item:GetAttribute(\"FloatingSpawnId\")\r\n                        local fIdx = item:GetAttribute(\"FloatingIndex\")\r\n                        if sId and Client.Events.RequestCollectFloatingCandy then\r\n                            pcall(function()\r\n                                Client.Events.RequestCollectFloatingCandy:FireServer(sId, fIdx)\r\n                            end)\r\n                        end\r\n                    end\r\n\r\n                    -- 4. Panggil ProximityPrompt jika ada\r\n                    local prompt = item:FindFirstChildWhichIsA(\"ProximityPrompt\", true)\r\n                    if prompt and prompt.Enabled then\r\n                        pcall(function()\r\n                            if fireproximityprompt then\r\n                                fireproximityprompt(prompt, 1)\r\n                            end\r\n                        end)\r\n                    end\r\n                end\r\n            end\r\n        end\r\n    end\r\nend\r\n\r\nlocal function autoInteractHalloweenHouse(targetModel)\r\n    local hrp = _LocalPlayer.Character and _LocalPlayer.Character:FindFirstChild(\"HumanoidRootPart\")\r\n    if not targetModel then return false, \"NoTarget\", 0 end\r\n    \r\n    -- Cek jika sudah visited malam ini agar tidak kena penolakan\r\n    if targetModel:GetAttribute(\"Visited_\" .. _LocalPlayer.UserId) then\r\n        return false, \"AlreadyVisited\", 0\r\n    end\r\n\r\n    local functional = targetModel:FindFirstChild(\"Functional\")\r\n    local candyPart = functional and functional:FindFirstChild(\"CandyPart\")\r\n    local door = findHouseDoor(targetModel)\r\n\r\n    -- STAY AT BASE: Karakter TIDAK diteleportasikan ke rumah sama sekali!\r\n    -- Semua eksekusi knock dan pengambilan permen dilakukan secara remote langsung ke HRP player.\r\n\r\n    -- 1. Panggil remote event resmi cutscene & knock\r\n    local okClient, Client = pcall(function() return require(_LocalPlayer.PlayerScripts.Client) end)\r\n    local knockSuccess = false\r\n    local resultType = \"Treat\"\r\n    local candyCount = 0\r\n\r\n    if okClient and Client and Client.Events then\r\n        pcall(function()\r\n            Client.Events.TrickOrTreatCutsceneStarted:FireServer(targetModel)\r\n        end)\r\n        task.wait(0.15)\r\n\r\n        if door and Client.Events.RequestKnockOnDoor then\r\n            pcall(function()\r\n                local res = Client.Events.RequestKnockOnDoor:InvokeServer(door)\r\n                if res and res.Success then\r\n                    knockSuccess = true\r\n                    resultType = res.TrickOrTreat or \"Treat\"\r\n                    candyCount = res.Candy or 0\r\n\r\n                    -- Spawn Candy langsung di posisi player (atau candyPart)\r\n                    if candyCount > 0 and Client.CandyClient and Client.CandyClient.SpawnCandy then\r\n                        for _ = 1, candyCount do\r\n                            pcall(function()\r\n                                Client.CandyClient.SpawnCandy(hrp or candyPart)\r\n                            end)\r\n                            task.wait(0.02)\r\n                        end\r\n                    end\r\n                end\r\n            end)\r\n        end\r\n    end\r\n\r\n    -- 2. Fallback: Gunakan ProximityPrompt bawaan game jika remote direct tidak merespon\r\n    if not knockSuccess then\r\n        for _, obj in ipairs(targetModel:GetDescendants()) do\r\n            if obj:IsA(\"ProximityPrompt\") and obj.Enabled then\r\n                pcall(function() fireproximityprompt(obj) end)\r\n                knockSuccess = true\r\n                break\r\n            end\r\n        end\r\n    end\r\n\r\n    -- 3. Sedot & ambil permen Treat yang jatuh (langsung ditarik ke HRP di base)\r\n    task.wait(0.15)\r\n    collectAllHalloweenCandies(hrp)\r\n\r\n    return knockSuccess, resultType, candyCount\r\nend\r\n\r\nlocal halloweenAutoTeleportActive = false\r\nlocal halloweenAutoCollectEnabled = true\r\nlocal halloweenHouseDelay = 2\r\nlocal halloweenRunningTask = nil\r\nlocal halloweenAutoToggle = nil\r\nlocal isProgrammaticHalloweenToggle = false\r\nlocal halloweenStatusPara\r\n_G.KixHalloweenTrickBusy = false\r\n\r\nlocal halloweenTrickAutomation = {}\r\n\r\nfunction halloweenTrickAutomation.IsActive()\r\n    local character = _LocalPlayer.Character\r\n    if character and character.Name == \"Frog\" then return true end\r\n\r\n    local effects = _LocalPlayer:FindFirstChild(\"HalloweenEffects\")\r\n    if effects then\r\n        for _, effect in ipairs(effects:GetChildren()) do\r\n            if effect:IsA(\"Folder\") and effect:GetAttribute(\"EffectType\") == \"Trick\" then\r\n                return true\r\n            end\r\n        end\r\n    end\r\n\r\n    local playerGui = _LocalPlayer:FindFirstChild(\"PlayerGui\")\r\n    local interface = playerGui and playerGui:FindFirstChild(\"Interface\")\r\n    local pumpkinOverlay = interface and interface:FindFirstChild(\"PumpkinOverlay\", true)\r\n    return pumpkinOverlay ~= nil and pumpkinOverlay:IsA(\"GuiObject\") and pumpkinOverlay.Visible\r\nend\r\n\r\nfunction halloweenTrickAutomation.WaitForRecovery(forceWait)\r\n    local graceUntil = os.clock() + (forceWait and 2 or 0)\r\n    local observedEffect = forceWait == true\r\n    local clearSince = nil\r\n    if forceWait then _G.KixHalloweenTrickBusy = true end\r\n\r\n    while halloweenAutoTeleportActive do\r\n        if halloweenTrickAutomation.IsActive() then\r\n            observedEffect = true\r\n            _G.KixHalloweenTrickBusy = true\r\n            clearSince = nil\r\n            pcall(function()\r\n                if halloweenStatusPara then\r\n                    halloweenStatusPara:SetDesc(\"Waiting for Trick effect and character to recover...\")\r\n                end\r\n            end)\r\n        elseif os.clock() >= graceUntil then\r\n            if not observedEffect then\r\n                _G.KixHalloweenTrickBusy = false\r\n                return true\r\n            end\r\n            if not clearSince then\r\n                clearSince = os.clock()\r\n            elseif os.clock() - clearSince >= 0.75 then\r\n                _G.KixHalloweenTrickBusy = false\r\n                return true\r\n            end\r\n        end\r\n        task.wait(0.25)\r\n    end\r\n\r\n    _G.KixHalloweenTrickBusy = false\r\n    return false\r\nend\r\n\r\nlocal HALLOWEEN_COSTUMES = {\"Astronaut\", \"Dinosaur\", \"Lobster\", \"Mummy\", \"Pirate\", \"Spider\", \"Werewolf\"}\r\nlocal COSTUME_SLOTS = {\"Head\", \"Torso\", \"Foot\", \"Accessory\"}\r\nlocal lastEquippedCostume = nil\r\nlocal lastEquippedMixedSummary = nil\r\nlocal autoCostumeEnabled = true\r\n\r\nlocal function getPieceInfo(piece)\r\n    if not piece then return nil, nil end\r\n    \r\n    local rawSlot = piece:GetAttribute(\"CostumeSlot\") \r\n        or piece:GetAttribute(\"Slot\") \r\n        or piece:GetAttribute(\"PieceSlot\")\r\n        or piece:GetAttribute(\"Type\")\r\n        \r\n    local costumeId = piece:GetAttribute(\"CostumeId\") \r\n        or piece:GetAttribute(\"Costume\") \r\n        or piece:GetAttribute(\"Set\")\r\n        \r\n    local normSlot = nil\r\n    if rawSlot then\r\n        local s = string.lower(tostring(rawSlot))\r\n        if string.find(s, \"head\") or string.find(s, \"hat\") or string.find(s, \"hood\") or string.find(s, \"helmet\") or string.find(s, \"mask\") then\r\n            normSlot = \"Head\"\r\n        elseif string.find(s, \"torso\") or string.find(s, \"shirt\") or string.find(s, \"suit\") or string.find(s, \"top\") or string.find(s, \"body\") then\r\n            normSlot = \"Torso\"\r\n        elseif string.find(s, \"foot\") or string.find(s, \"pant\") or string.find(s, \"leg\") or string.find(s, \"bottom\") or string.find(s, \"feet\") or string.find(s, \"shoe\") then\r\n            normSlot = \"Foot\"\r\n        elseif string.find(s, \"acc\") or string.find(s, \"bowtie\") or string.find(s, \"wing\") or string.find(s, \"tail\") or string.find(s, \"cape\") then\r\n            normSlot = \"Accessory\"\r\n        end\r\n    end\r\n    \r\n    local pName = string.lower(piece.Name)\r\n    if not normSlot then\r\n        if string.find(pName, \"head\") or string.find(pName, \"hat\") or string.find(pName, \"helmet\") or string.find(pName, \"hood\") or string.find(pName, \"mask\") then\r\n            normSlot = \"Head\"\r\n        elseif string.find(pName, \"torso\") or string.find(pName, \"shirt\") or string.find(pName, \"suit\") or string.find(pName, \"top\") or string.find(pName, \"body\") then\r\n            normSlot = \"Torso\"\r\n        elseif string.find(pName, \"foot\") or string.find(pName, \"pant\") or string.find(pName, \"leg\") or string.find(pName, \"bottom\") or string.find(pName, \"feet\") then\r\n            normSlot = \"Foot\"\r\n        elseif string.find(pName, \"acc\") or string.find(pName, \"bowtie\") or string.find(pName, \"wing\") or string.find(pName, \"tail\") or string.find(pName, \"cape\") then\r\n            normSlot = \"Accessory\"\r\n        end\r\n    end\r\n    \r\n    if not costumeId then\r\n        for _, cid in ipairs(HALLOWEEN_COSTUMES) do\r\n            if string.find(pName, string.lower(cid)) then\r\n                costumeId = cid\r\n                break\r\n            end\r\n        end\r\n    end\r\n    \r\n    return normSlot, costumeId\r\nend\r\n\r\nlocal HALLOWEEN_COMBOS = {\r\n    Lobster = { Astronaut = true, Dinosaur = true, Mummy = true, Pirate = true, Werewolf = true },\r\n    Astronaut = { Lobster = true, Dinosaur = true, Mummy = true, Pirate = true, Werewolf = true },\r\n    Dinosaur = { Lobster = true, Astronaut = true, Mummy = true, Pirate = true, Werewolf = true },\r\n    Mummy = { Lobster = true, Astronaut = true, Dinosaur = true, Pirate = true, Werewolf = true },\r\n    Pirate = { Lobster = true, Astronaut = true, Dinosaur = true, Mummy = true, Werewolf = true },\r\n    Werewolf = { Lobster = true, Astronaut = true, Dinosaur = true, Mummy = true, Pirate = true }\r\n}\r\n\r\n-- =========================================================\r\n-- OUTFIT SOLVER: SATU PINTU SATU GANTI BAJU + VERIFIKATOR DETEKSI\r\n-- (Rotasi set/combo berbeda tiap pintu untuk maksimalkan Treat & minimalkan Trick)\r\n-- =========================================================\r\nlocal function findBestCostumeOutfit(excludeCostumeId)\r\n    local costumeFolder = _LocalPlayer:FindFirstChild(\"Costume\")\r\n    local closetFolder = _LocalPlayer:FindFirstChild(\"CostumeCloset\")\r\n    if not costumeFolder or not closetFolder then return nil, nil, false end\r\n\r\n    -- 1. Scan semua piece yang kita miliki di Costume (worn) dan CostumeCloset\r\n    local inv = {}\r\n    for _, cid in ipairs(HALLOWEEN_COSTUMES) do\r\n        inv[cid] = {}\r\n    end\r\n\r\n    local function scan(folder, isWorn)\r\n        if not folder then return end\r\n        for _, child in ipairs(folder:GetChildren()) do\r\n            local slot, cid = getPieceInfo(child)\r\n            if slot and cid and inv[cid] then\r\n                if not inv[cid][slot] or isWorn then\r\n                    inv[cid][slot] = { instance = child, isWorn = isWorn, costumeId = cid, slot = slot }\r\n                end\r\n            end\r\n        end\r\n    end\r\n\r\n    scan(costumeFolder, true)\r\n    scan(closetFolder, false)\r\n\r\n    -- 2. Temukan semua Full Sets (4/4) yang kita miliki\r\n    local fullSets = {}\r\n    for _, cid in ipairs(HALLOWEEN_COSTUMES) do\r\n        local pieces = inv[cid]\r\n        if pieces and pieces.Head and pieces.Torso and pieces.Foot and pieces.Accessory then\r\n            table.insert(fullSets, cid)\r\n        end\r\n    end\r\n\r\n    -- 3. JIKA PUNYA FULL SET (4/4) -> MEGABOOST\r\n    if #fullSets > 0 then\r\n        local chosenSet = nil\r\n\r\n        -- Jika pemain punya lebih dari 1 full set, utamakan yang BERBEDA dari pintu sebelumnya (excludeCostumeId)\r\n        if excludeCostumeId and #fullSets > 1 then\r\n            local candidates = {}\r\n            for _, s in ipairs(fullSets) do\r\n                if s ~= excludeCostumeId and not string.find(excludeCostumeId, s, 1, true) then\r\n                    table.insert(candidates, s)\r\n                end\r\n            end\r\n            if #candidates > 0 then\r\n                chosenSet = candidates[math.random(1, #candidates)]\r\n            end\r\n        end\r\n\r\n        -- Jika hanya punya 1 full set, coba rotasikan dengan variasi 3+1 Combo jika ada piece lain di lemari\r\n        if not chosenSet then\r\n            if #fullSets == 1 and excludeCostumeId and fullSets[1] == excludeCostumeId then\r\n                local mainSet = fullSets[1]\r\n                local altComboPlan = nil\r\n                local altComboName = nil\r\n\r\n                for subSet, valid in pairs(HALLOWEEN_COMBOS[mainSet] or {}) do\r\n                    if valid and inv[subSet] then\r\n                        for _, slot in ipairs(COSTUME_SLOTS) do\r\n                            if inv[subSet][slot] then\r\n                                local plan = {}\r\n                                for _, s in ipairs(COSTUME_SLOTS) do\r\n                                    if s == slot then\r\n                                        plan[s] = inv[subSet][slot]\r\n                                    else\r\n                                        plan[s] = inv[mainSet][s]\r\n                                    end\r\n                                end\r\n                                altComboPlan = plan\r\n                                altComboName = string.format(\"%s Combo (%s %s)\", mainSet, subSet, slot)\r\n                                break\r\n                            end\r\n                        end\r\n                    end\r\n                    if altComboPlan then break end\r\n                end\r\n\r\n                if altComboPlan and altComboName ~= excludeCostumeId then\r\n                    return altComboName, altComboPlan, false\r\n                end\r\n            end\r\n\r\n            chosenSet = fullSets[1]\r\n        end\r\n\r\n        local outfitPlan = {}\r\n        for _, slot in ipairs(COSTUME_SLOTS) do\r\n            outfitPlan[slot] = inv[chosenSet][slot]\r\n        end\r\n        return chosenSet, outfitPlan, true -- true = MegaBoost!\r\n    end\r\n\r\n    -- 4. JIKA TIDAK PUNYA 4/4 LENGKAP -> CARI COMBO 3+1 RESMI SESUAI TABEL T10 (BOOST)\r\n    local comboCandidates = {}\r\n    for _, mainSet in ipairs(HALLOWEEN_COSTUMES) do\r\n        local mainPieces = inv[mainSet] or {}\r\n        local ownedSlots = {}\r\n        local missingSlot = nil\r\n        for _, slot in ipairs(COSTUME_SLOTS) do\r\n            if mainPieces[slot] then\r\n                table.insert(ownedSlots, slot)\r\n            else\r\n                missingSlot = slot\r\n            end\r\n        end\r\n\r\n        if #ownedSlots == 3 and missingSlot then\r\n            for subSet, valid in pairs(HALLOWEEN_COMBOS[mainSet] or {}) do\r\n                if valid and inv[subSet] and inv[subSet][missingSlot] then\r\n                    local outfitPlan = {}\r\n                    for _, s in ipairs(ownedSlots) do\r\n                        outfitPlan[s] = mainPieces[s]\r\n                    end\r\n                    outfitPlan[missingSlot] = inv[subSet][missingSlot]\r\n                    local name = string.format(\"%s Combo (%s)\", mainSet, subSet)\r\n                    table.insert(comboCandidates, { name = name, plan = outfitPlan })\r\n                end\r\n            end\r\n        end\r\n    end\r\n\r\n    if #comboCandidates > 0 then\r\n        -- Pilih combo yang berbeda dari excludeCostumeId jika memungkinkan\r\n        for _, c in ipairs(comboCandidates) do\r\n            if c.name ~= excludeCostumeId then\r\n                return c.name, c.plan, false\r\n            end\r\n        end\r\n        return comboCandidates[1].name, comboCandidates[1].plan, false\r\n    end\r\n\r\n    -- 5. FALLBACK: Cari set dengan piece terbanyak\r\n    local bestSet = HALLOWEEN_COSTUMES[1]\r\n    local maxCount = 0\r\n    for _, cid in ipairs(HALLOWEEN_COSTUMES) do\r\n        local c = 0\r\n        for _, slot in ipairs(COSTUME_SLOTS) do\r\n            if inv[cid] and inv[cid][slot] then c = c + 1 end\r\n        end\r\n        if c > maxCount then\r\n            maxCount = c\r\n            bestSet = cid\r\n        end\r\n    end\r\n\r\n    local outfitPlan = {}\r\n    for _, slot in ipairs(COSTUME_SLOTS) do\r\n        if inv[bestSet] and inv[bestSet][slot] then\r\n            outfitPlan[slot] = inv[bestSet][slot]\r\n        end\r\n    end\r\n    return bestSet, outfitPlan, false\r\nend\r\n\r\nlocal function equipMixedCostume(excludeCostumeId)\r\n    local success = false\r\n    local mixedSummary = \"\"\r\n    local isMegaBoost = false\r\n    local isVerified = false\r\n    \r\n    pcall(function()\r\n        local Client = require(_LocalPlayer.PlayerScripts.Client)\r\n        local costumeFolder = _LocalPlayer:FindFirstChild(\"Costume\")\r\n        local closetFolder = _LocalPlayer:FindFirstChild(\"CostumeCloset\")\r\n        if not costumeFolder or not closetFolder or not Client or not Client.Events then return end\r\n        \r\n        local outfitName, outfitPlan, mega = findBestCostumeOutfit(excludeCostumeId or lastEquippedCostume)\r\n        if not outfitPlan then return end\r\n        isMegaBoost = mega or false\r\n        \r\n        -- Kumpulkan piece yang sedang dipakai yang TIDAK ada di rencana outfit\r\n        local toStore = {}\r\n        for _, child in ipairs(costumeFolder:GetChildren()) do\r\n            local slot, cid = getPieceInfo(child)\r\n            if slot then\r\n                local planned = outfitPlan[slot]\r\n                if not planned or planned.instance ~= child then\r\n                    table.insert(toStore, child)\r\n                end\r\n            end\r\n        end\r\n\r\n        -- Kumpulkan piece rencana yang belum dipakai (masih di closet/inventory)\r\n        local toWear = {}\r\n        for _, slot in ipairs(COSTUME_SLOTS) do\r\n            local planned = outfitPlan[slot]\r\n            if planned and planned.instance and planned.instance.Parent ~= costumeFolder then\r\n                table.insert(toWear, planned.instance)\r\n            end\r\n        end\r\n\r\n        -- Jika outfit yang diinginkan sudah 100% terpasang sempurna\r\n        if #toStore == 0 and #toWear == 0 then\r\n            success = true\r\n            isVerified = true\r\n            mixedSummary = outfitName .. (isMegaBoost and \" (MegaBoost 100%)\" or \"\")\r\n            lastEquippedCostume = outfitName\r\n            lastEquippedMixedSummary = mixedSummary\r\n            return\r\n        end\r\n\r\n        -- 1. Lepas piece yang tidak sesuai\r\n        for _, piece in ipairs(toStore) do\r\n            if Client.Events.RequestStoreWornCostumePiece then\r\n                pcall(function()\r\n                    Client.Events.RequestStoreWornCostumePiece:InvokeServer(piece)\r\n                end)\r\n                task.wait(0.03)\r\n            end\r\n        end\r\n\r\n        -- 2. Pakai piece kostum yang baru\r\n        if #toWear > 0 and Client.Events.RequestWearCostumePieces then\r\n            pcall(function()\r\n                Client.Events.RequestWearCostumePieces:InvokeServer(toWear)\r\n            end)\r\n            task.wait(0.06)\r\n        end\r\n\r\n        -- 3. VERIFIKATOR DETEKSI: Tunggu & pastikan seluruh piece baru sudah terdeteksi di folder Costume\r\n        local startCheck = os.clock()\r\n        while os.clock() - startCheck < 1.2 do\r\n            local curCostume = _LocalPlayer:FindFirstChild(\"Costume\")\r\n            if curCostume then\r\n                local allPresent = true\r\n                for _, slot in ipairs(COSTUME_SLOTS) do\r\n                    local planned = outfitPlan[slot]\r\n                    if planned and planned.instance then\r\n                        if planned.instance.Parent ~= curCostume then\r\n                            allPresent = false\r\n                            break\r\n                        end\r\n                    end\r\n                end\r\n                if allPresent then\r\n                    isVerified = true\r\n                    break\r\n                end\r\n            end\r\n            task.wait(0.04)\r\n        end\r\n\r\n        success = true\r\n        mixedSummary = outfitName .. (isMegaBoost and \" (MegaBoost 100%)\" or \"\")\r\n        lastEquippedCostume = outfitName\r\n        lastEquippedMixedSummary = mixedSummary\r\n    end)\r\n    \r\n    return success, mixedSummary, isMegaBoost, isVerified\r\nend\r\n\r\nlocal equipCostume = equipMixedCostume\r\n\r\nhalloweenStatusPara = Tabs.Event:Paragraph({\r\n    Title = 'Status',\r\n    Desc = 'Idle - Ready'\r\n})\r\n\r\n-- Keep the Halloween grass cleanup available to return/stop actions.\r\n-- This lives on _G to avoid consuming another top-level local register.\r\n_G.KixCleanHalloweenHouseGrass = function()\r\n    pcall(function()\r\n        local map = workspace:FindFirstChild(\"Map\")\r\n        local landmarks = map and map:FindFirstChild(\"Landmarks\")\r\n        if not landmarks then return end\r\n\r\n        for _, house in ipairs(landmarks:GetChildren()) do\r\n            local houseName = string.lower(house.Name)\r\n            local isHalloweenHouse = string.find(houseName, \"halloween house\", 1, true)\r\n                or houseName == \"pelt trader\"\r\n\r\n            if isHalloweenHouse then\r\n                for _, obj in ipairs(house:GetDescendants()) do\r\n                    if obj:IsA(\"BasePart\") then\r\n                        local partName = string.lower(obj.Name)\r\n                        local isGrassPart = string.find(partName, \"grass\", 1, true) ~= nil\r\n                            or (_G.KixIsPeltTraderGrassAsset\r\n                                and _G.KixIsPeltTraderGrassAsset(obj))\r\n\r\n                        if isGrassPart then\r\n                            obj.Transparency = 1\r\n                            for _, visual in ipairs(obj:GetDescendants()) do\r\n                                if visual:IsA(\"Decal\") or visual:IsA(\"Texture\") then\r\n                                    visual.Transparency = 1\r\n                                end\r\n                            end\r\n                        end\r\n                    end\r\n                end\r\n            end\r\n        end\r\n    end)\r\nend\r\n\r\n\r\nteleportToReturnPosition = function(force)\r\n    pcall(function()\r\n        -- JANGAN PERNAH TELEPORT JIKA SEDANG RAID STRONGHOLD ATAU TRANSITION!\r\n        if _G.IsStrongholdRaidActive or _G.StrongholdTransition or _G.StrongholdPreparingRaid then\r\n            return\r\n        end\r\n        \r\n        local myChar = _LocalPlayer.Character\r\n        local hrp = myChar and myChar:FindFirstChild(\"HumanoidRootPart\")\r\n        local hum = myChar and myChar:FindFirstChildWhichIsA(\"Humanoid\")\r\n        if not hrp or not hum or hum.Health <= 0 then return end\r\n        \r\n        if not force and (_G.CampfireCombatActive or _G.GlobalCultistCombatActive or _G.CorruptedCombatActive or _G.MossyCombatActive or _G.TurkeyCombatActive) then\r\n            return\r\n        end\r\n        \r\n        -- 1. Bersihkan semua BodyMovers yang bisa menimbulkan dorongan/terpental pada HRP\r\n        for _, child in ipairs(hrp:GetChildren()) do\r\n            if child:IsA(\"BodyVelocity\") or child:IsA(\"BodyGyro\") or child:IsA(\"BodyPosition\") or child:IsA(\"BodyForce\") or child:IsA(\"LinearVelocity\") or child:IsA(\"VectorForce\") then\r\n                pcall(function() child:Destroy() end)\r\n            end\r\n        end\r\n        \r\n        -- 2. Tentukan target CFrame\r\n        local targetCF\r\n        local returnPos = (KixHubSavedState and KixHubSavedState.customReturnPos) or customReturnPos\r\n        if returnPos then\r\n            -- customReturnPos adalah koordinat HRP saat player berdiri aman di darat.\r\n            -- Gunakan CFrame langsung tanpa modifikasi Y agar tidak menyebabkan raycast nyangkut di atap atau kaki tembus tanah.\r\n            targetCF = CFrame.new(returnPos.X, returnPos.Y, returnPos.Z)\r\n        else\r\n            -- Fallback ke MainFire campground atau campfirePos\r\n            local mainFire = workspace:FindFirstChild(\"Map\") and workspace.Map:FindFirstChild(\"Campground\") and workspace.Map.Campground:FindFirstChild(\"MainFire\")\r\n            if mainFire and mainFire.PrimaryPart then\r\n                targetCF = CFrame.new(mainFire.PrimaryPart.Position + Vector3.new(5, 2.5, 0))\r\n            else\r\n                local baseCamp = campfirePos or Vector3.new(0, 19, 0)\r\n                targetCF = CFrame.new(baseCamp.X, baseCamp.Y + 2.5, baseCamp.Z)\r\n            end\r\n        end\r\n        \r\n        -- 3. Teleportasi bersih identik dengan teleportPlayerToHalloweenHouse (tanpa mengubah CanCollide limb)\r\n        hrp.AssemblyLinearVelocity = Vector3.zero\r\n        hrp.AssemblyAngularVelocity = Vector3.zero\r\n        hrp.Velocity = Vector3.zero\r\n        hrp.RotVelocity = Vector3.zero\r\n        \r\n        hrp.CFrame = targetCF\r\n        \r\n        task.wait(0.05)\r\n        \r\n        hrp.AssemblyLinearVelocity = Vector3.zero\r\n        hrp.AssemblyAngularVelocity = Vector3.zero\r\n        hrp.Velocity = Vector3.zero\r\n        hrp.RotVelocity = Vector3.zero\r\n        \r\n        _G.KixCleanHalloweenHouseGrass()\r\n    end)\r\nend\r\n\r\nlocal function runPostHalloweenActions()\r\n    task.spawn(function()\r\n        task.wait(0.5)\r\n        _G.KixCleanHalloweenHouseGrass()\r\n    end)\r\nend\r\n\r\nlocal function stopHalloweenLoop(manualUserStop)\r\n    local wasRunning = halloweenAutoTeleportActive\r\n    halloweenAutoTeleportActive = false\r\n    if halloweenRunningTask then\r\n        task.cancel(halloweenRunningTask)\r\n        halloweenRunningTask = nil\r\n    end\r\n    pcall(function()\r\n        if halloweenStatusPara then\r\n            halloweenStatusPara:SetDesc(\"Idle - Stopped (Will start from House 1 on next run)\")\r\n        end\r\n    end)\r\n    if manualUserStop and wasRunning then\r\n        -- Hapus teleportasi di akhir, player tetap berada di posisinya saat ini\r\n        runPostHalloweenActions()\r\n    end\r\nend\r\n\r\nlocal function isHalloweenNightTime()\r\n    local wsState = workspace:GetAttribute(\"State\")\r\n    if wsState ~= nil then\r\n        return wsState == \"Night\"\r\n    end\r\n    local lighting = game:GetService(\"Lighting\")\r\n    local ct = lighting and lighting.ClockTime or 12\r\n    return (ct < 6.5 or ct > 17.5)\r\nend\r\n\r\nlocal function isHigherPriorityTeleportActive()\r\n    if _G.KixHalloweenTrickBusy then\r\n        return true, \"Halloween Trick Recovery\"\r\n    end\r\n    -- 1. Auto Stronghold (Saat RAIDING, TRANSITION, atau sedang mempersiapkan raid)\r\n    if _G.IsStrongholdRaidActive or _G.StrongholdTransition or _G.StrongholdPreparingRaid then\r\n        return true, \"Stronghold Raid Active\"\r\n    end\r\n    -- 2. Kill Cultist Near Campfire (Hanya saat SEDANG AKTIF menyerang/combat dengan cultist di campfire)\r\n    if _G.CampfireCombatActive then\r\n        return true, \"Campfire Cultist Combat\"\r\n    end\r\n    -- 3. Auto Farm Hardcore (Hanya saat sedang aktif combat wolf atau menebang corrupted tree)\r\n    if _G.CorruptedCombatActive or _G.CorruptedChopActive then\r\n        return true, \"Hardcore Farm Active\"\r\n    end\r\n    -- 4. Auto Chop Tree (Hanya saat sedang aktif menebang pohon)\r\n    if _G.AutoChopSelectedTreesRunning then\r\n        return true, \"Auto Chop Running\"\r\n    end\r\n    -- 5. Global Cultist Combat\r\n    if _G.GlobalCultistCombatActive then\r\n        return true, \"Global Cultist Combat\"\r\n    end\r\n    -- 6. Other Combat / Farming (Mossy, Turkey, Chest, Campfire)\r\n    if _G.MossyCombatActive then\r\n        return true, \"Mossy Wolf Combat\"\r\n    end\r\n    if _G.TurkeyCombatActive then\r\n        return true, \"Turkey Combat\"\r\n    end\r\n    if _G.AutoChestRunning then\r\n        return true, \"Auto Chest Running\"\r\n    end\r\n    if _G.AutoFeedCampfireRunning then\r\n        return true, \"Auto Feed Campfire\"\r\n    end\r\n    return false, nil\r\nend\r\n\r\nlocal function ensureCostumeClosetAtBase()\r\n    -- 1. Cek apakah di base / map sudah ada Costume Closet\r\n    local structures = _Workspace:FindFirstChild(\"Structures\") or workspace:FindFirstChild(\"Structures\")\r\n    if structures then\r\n        for _, obj in ipairs(structures:GetChildren()) do\r\n            local oNameLower = string.lower(obj.Name)\r\n            if string.find(oNameLower, \"costume closet\") or string.find(oNameLower, \"custome closet\") or string.find(oNameLower, \"costumecloset\") then\r\n                return -- Sudah terpasang di map / base\r\n            end\r\n        end\r\n    end\r\n\r\n    -- 2. CEK INVENTORY / BACKPACK / KARAKTER TERLEBIH DAHULU!\r\n    -- Jika pemain SUDAH memegang atau memiliki Costume Closet Blueprint, langsung lompat ke placement!\r\n    local function findCostumeClosetBlueprint()\r\n        local bpNames = {\r\n            \"Costume Closet Blueprint\",\r\n            \"Custome Closet Blueprint\",\r\n            \"Costume Closet\",\r\n            \"Custome Closet\"\r\n        }\r\n        local containers = {\r\n            _LocalPlayer:FindFirstChild(\"Inventory\"),\r\n            _LocalPlayer:FindFirstChild(\"Backpack\"),\r\n            _LocalPlayer.Character\r\n        }\r\n        for _, container in ipairs(containers) do\r\n            if container then\r\n                for _, n in ipairs(bpNames) do\r\n                    local bp = container:FindFirstChild(n)\r\n                    if bp then return bp end\r\n                end\r\n                for _, child in ipairs(container:GetChildren()) do\r\n                    local cNameLower = string.lower(child.Name)\r\n                    if string.find(cNameLower, \"costume closet\") or string.find(cNameLower, \"custome closet\") then\r\n                        return child\r\n                    end\r\n                end\r\n            end\r\n        end\r\n        return nil\r\n    end\r\n\r\n    local blueprint = findCostumeClosetBlueprint()\r\n\r\n    -- 3. JIKA BELUM PUNYA BLUEPRINT: Baru coba beli dari Crafting Table jika ada stok & kayu cukup\r\n    if not blueprint then\r\n        local cTable = _ReplicatedStorage:FindFirstChild(\"Crafting Table\")\r\n        local itemFolder = cTable and (cTable:FindFirstChild(\"Costume Closet\") or cTable:FindFirstChild(\"Custome Closet\"))\r\n        \r\n        -- Jika ada di crafting table dan belum SoldOut, cek material dan beli\r\n        if itemFolder and itemFolder:GetAttribute(\"SoldOut\") ~= true then\r\n            local woodPrice = itemFolder:GetAttribute(\"WoodPrice\") or 3\r\n            local map = _Workspace:FindFirstChild(\"Map\") or workspace:FindFirstChild(\"Map\")\r\n            local campground = map and map:FindFirstChild(\"Campground\")\r\n            local totalWood = (campground and campground:GetAttribute(\"TotalWood\")) or 0\r\n\r\n            if totalWood >= woodPrice then\r\n                local craftRemote = (_ReplicatedStorage:FindFirstChild(\"RemoteEvents\") and _ReplicatedStorage.RemoteEvents:FindFirstChild(\"CraftItem\"))\r\n                if not craftRemote then\r\n                    pcall(function()\r\n                        local Client = require(_LocalPlayer.PlayerScripts.Client)\r\n                        craftRemote = Client and Client.Events and Client.Events.CraftItem\r\n                    end)\r\n                end\r\n\r\n                if craftRemote then\r\n                    pcall(function()\r\n                        craftRemote:InvokeServer(itemFolder.Name)\r\n                    end)\r\n                end\r\n\r\n                -- Tunggu blueprint masuk ke inventory (maksimal 1.5 detik)\r\n                for _ = 1, 15 do\r\n                    task.wait(0.1)\r\n                    blueprint = findCostumeClosetBlueprint()\r\n                    if blueprint then break end\r\n                end\r\n            end\r\n        end\r\n    end\r\n\r\n    -- Jika tetap tidak ada blueprint (misal kayu kurang atau belum beli), langsung skip gpp\r\n    if not blueprint then return end\r\n\r\n    -- Cek sekali lagi apakah sudah ditaruh orang lain di map saat proses\r\n    if structures then\r\n        for _, obj in ipairs(structures:GetChildren()) do\r\n            local oNameLower = string.lower(obj.Name)\r\n            if string.find(oNameLower, \"costume closet\") or string.find(oNameLower, \"custome closet\") or string.find(oNameLower, \"costumecloset\") then\r\n                return\r\n            end\r\n        end\r\n    end\r\n\r\n    -- 4. PLACE COSTUME CLOSET OTOMATIS SESUAI KOORDINAT\r\n    -- Target CFrame dari PlacementData[\"Costume Closet\"]:\r\n    local targetCFrame = CFrame.new(\r\n        22.5, 7.45524979, -30,\r\n        0, 0, 1,\r\n        0, 1, 0,\r\n        -1, 0, 0\r\n    )\r\n\r\n    local groundPos = targetCFrame.Position\r\n    pcall(function()\r\n        local map = _Workspace:FindFirstChild(\"Map\") or workspace:FindFirstChild(\"Map\")\r\n        local ground = map and map:FindFirstChild(\"Ground\")\r\n        if ground then\r\n            local grassParts = {}\r\n            for _, part in ipairs(ground:GetChildren()) do\r\n                if part:IsA(\"BasePart\") and part.Name == \"Grass\" then\r\n                    table.insert(grassParts, part)\r\n                end\r\n            end\r\n            if #grassParts > 0 then\r\n                local rayParams = RaycastParams.new()\r\n                rayParams.FilterType = Enum.RaycastFilterType.Include\r\n                rayParams.FilterDescendantsInstances = grassParts\r\n                local origin = Vector3.new(targetCFrame.Position.X, targetCFrame.Position.Y + 10, targetCFrame.Position.Z)\r\n                local result = _Workspace:Raycast(origin, Vector3.new(0, -30, 0), rayParams)\r\n                if result then\r\n                    groundPos = result.Position\r\n                end\r\n            end\r\n        end\r\n    end)\r\n\r\n    if GlobalSettings and GlobalSettings.GridOffset then\r\n        groundPos = groundPos + GlobalSettings.GridOffset\r\n    end\r\n\r\n    local heightOffset = 0\r\n    pcall(function()\r\n        local attr = blueprint:GetAttribute(\"StructureHeightOffset\")\r\n        if typeof(attr) == \"number\" then\r\n            heightOffset = attr\r\n        else\r\n            local cf, s = blueprint:GetBoundingBox()\r\n            if cf and s then\r\n                local bottomY = cf.Position.Y - (s.Y / 2)\r\n                local pivotY = (blueprint.PrimaryPart and blueprint.PrimaryPart.Position.Y) or cf.Position.Y\r\n                heightOffset = pivotY - bottomY\r\n            end\r\n        end\r\n    end)\r\n\r\n    local rotation = targetCFrame - targetCFrame.Position\r\n    local finalCFrame = rotation + groundPos + Vector3.new(0, heightOffset, 0)\r\n    local placeAnywhere = blueprint:GetAttribute(\"PlaceAnywhere\")\r\n\r\n    local placementResult = {\r\n        Valid = true,\r\n        Position = finalCFrame.Position,\r\n        CFrame = finalCFrame,\r\n        ErrorType = nil\r\n    }\r\n\r\n    local placeRemote = nil\r\n    pcall(function()\r\n        local Client = require(_LocalPlayer.PlayerScripts.Client)\r\n        placeRemote = Client and Client.Events and Client.Events.RequestPlaceStructure\r\n    end)\r\n    if not placeRemote then\r\n        placeRemote = _ReplicatedStorage:FindFirstChild(\"RequestPlaceStructure\", true)\r\n    end\r\n\r\n    if placeRemote then\r\n        local ok, res = pcall(function()\r\n            return placeRemote:InvokeServer(blueprint, placementResult, rotation, placeAnywhere)\r\n        end)\r\n        if ok then\r\n            if WindUI then\r\n                WindUI:Notify({\r\n                    Title = \"Costume Closet\",\r\n                    Content = \"Costume Closet auto placed at base!\",\r\n                    Duration = 3\r\n                })\r\n            end\r\n        else\r\n            warn(\"[CostumeCloset] Failed to place: \" .. tostring(res))\r\n        end\r\n    end\r\nend\r\n\r\nlocal function startHalloweenLoop()\r\n    if halloweenAutoTeleportActive then return end\r\n    halloweenAutoTeleportActive = true\r\n    \r\n    -- Cek & beli/place Costume Closet otomatis di base secara asynchronous (tanpa menahan alur farm)\r\n    task.spawn(function()\r\n        pcall(ensureCostumeClosetAtBase)\r\n        task.wait(1)\r\n        local s = _Workspace:FindFirstChild(\"Structures\") or workspace:FindFirstChild(\"Structures\")\r\n        if s and not (s:FindFirstChild(\"Costume Closet\") or s:FindFirstChild(\"Custome Closet\")) then\r\n            pcall(ensureCostumeClosetAtBase)\r\n        end\r\n    end)\r\n    \r\n    halloweenRunningTask = task.spawn(function()\r\n        while halloweenAutoTeleportActive do\r\n            -- 1. WAIT UNTIL NIGHT TIME (Do not move during day)\r\n            local wasDaytime = false\r\n            while halloweenAutoTeleportActive and not isHalloweenNightTime() do\r\n                wasDaytime = true\r\n                pcall(function()\r\n                    if halloweenStatusPara then\r\n                        halloweenStatusPara:SetDesc(\"Waiting for Night... (Daytime - Next round starts at House 1)\")\r\n                    end\r\n                end)\r\n                task.wait(1.5)\r\n            end\r\n            if not halloweenAutoTeleportActive then break end\r\n            \r\n            -- JEDA 10 DETIK SAAT TRANSISI DARI SIANG KE MALAM\r\n            if wasDaytime then\r\n                for remaining = 10, 1, -1 do\r\n                    if not halloweenAutoTeleportActive or not isHalloweenNightTime() then break end\r\n                    pcall(function()\r\n                        if halloweenStatusPara then\r\n                            halloweenStatusPara:SetDesc(string.format(\"Night arrived! Starting from House 1 in %ds...\", remaining))\r\n                        end\r\n                    end)\r\n                    task.wait(1)\r\n                end\r\n                if not halloweenAutoTeleportActive then break end\r\n            end\r\n            \r\n            if not isHalloweenNightTime() then continue end\r\n            \r\n            -- MULAI SATU PUTARAN MALAM INI: SELALU DARI RUMAH 1 KE 9\r\n            local idx = 1\r\n            local completedAllHouses = false\r\n            \r\n            while halloweenAutoTeleportActive and idx <= #HALLOWEEN_HOUSES do\r\n                -- 1. WAIT UNTIL NO HIGHER-PRIORITY TELEPORT TASK IS ACTIVE (e.g. Stronghold Raid)\r\n                local isBusy, reason = isHigherPriorityTeleportActive()\r\n                while halloweenAutoTeleportActive and isBusy do\r\n                    pcall(function()\r\n                        if halloweenStatusPara then\r\n                            halloweenStatusPara:SetDesc(string.format(\"Waiting for priority task (%s)...\", tostring(reason or \"Busy\")))\r\n                        end\r\n                    end)\r\n                    task.wait(1.5)\r\n                    isBusy, reason = isHigherPriorityTeleportActive()\r\n                end\r\n                if not halloweenAutoTeleportActive then break end\r\n\r\n                -- 2. CEK WAKTU SIANG: Jika sudah siang di tengah jalan, abort putaran dan reset ke Rumah 1!\r\n                if not isHalloweenNightTime() then\r\n                    pcall(function()\r\n                        if halloweenStatusPara then\r\n                            halloweenStatusPara:SetDesc(string.format(\"Daytime arrived at [%d/%d]! Round aborted & reset to House 1.\", idx, #HALLOWEEN_HOUSES))\r\n                        end\r\n                    end)\r\n                    break -- KELUAR DARI PUTARAN RUMAH, RESET KE RUMAH 1!\r\n                end\r\n                \r\n                -- 3. TELEPORT TO CURRENT HOUSE\r\n                local house = HALLOWEEN_HOUSES[idx]\r\n                pcall(function()\r\n                    if halloweenStatusPara then\r\n                        halloweenStatusPara:SetDesc(string.format(\"Checking [%d/%d]: %s\", idx, #HALLOWEEN_HOUSES, house.title))\r\n                    end\r\n                end)\r\n                \r\n                local targetModel = findHalloweenTarget(house)\r\n                if not targetModel then\r\n                    local _, m = getHalloweenHouseCFrame(house)\r\n                    targetModel = m\r\n                end\r\n\r\n                if targetModel then\r\n                    -- CEK 1: Lewati jika rumah ini sudah dikunjungi malam ini\r\n                    if targetModel:GetAttribute(\"Visited_\" .. _LocalPlayer.UserId) then\r\n                        pcall(function()\r\n                            if halloweenStatusPara then\r\n                                halloweenStatusPara:SetDesc(string.format(\"[%d/%d] %s (Already Visited) -> Skip\", idx, #HALLOWEEN_HOUSES, house.title))\r\n                            end\r\n                        end)\r\n                        task.wait(0.1)\r\n                        idx = idx + 1\r\n                        continue\r\n                    end\r\n\r\n                    -- CEK 2: SATU PINTU SATU GANTI BAJU + VERIFIKATOR TERVERIFIKASI SEBELUM NGETUK!\r\n                    local outfitText = \"\"\r\n                    if autoCostumeEnabled then\r\n                        -- Minta kostum baru yang BERBEDA dari pintu sebelumnya (exclude lastEquippedCostume)\r\n                        local okOutfit, summary, isMega, isVerified = equipMixedCostume(lastEquippedCostume)\r\n                        outfitText = summary or \"\"\r\n                        \r\n                        pcall(function()\r\n                            if halloweenStatusPara then\r\n                                local verifTag = isVerified and \" [Verified OK]\" or \" [Detecting...]\"\r\n                                local costInfo = (outfitText and #outfitText > 0) and (\" | Outfit: \" .. outfitText .. verifTag) or \"\"\r\n                                halloweenStatusPara:SetDesc(string.format(\"[%d/%d] %s%s (Knocking from Base...)\", idx, #HALLOWEEN_HOUSES, house.title, costInfo))\r\n                            end\r\n                        end)\r\n                        \r\n                        -- Jeda ekstra mikro untuk memastikan server game meregistrasi perubahan outfit\r\n                        task.wait(0.08)\r\n                    end\r\n                    \r\n                    -- CEK 3: Eksekusi interaksi Trick-or-Treat langsung dari Base (STATIONARY / NO TELEPORT!)\r\n                    if halloweenAutoCollectEnabled then\r\n                        local okKnock, resType, candies = autoInteractHalloweenHouse(targetModel)\r\n                        local forceTrickWait = string.lower(tostring(resType)) == \"trick\"\r\n                        if not halloweenTrickAutomation.WaitForRecovery(forceTrickWait) then break end\r\n                        \r\n                        pcall(function()\r\n                            if halloweenStatusPara then\r\n                                local resInfo = okKnock and string.format(\"Result: %s (+%d Candy)\", tostring(resType), candies or 0) or \"Interacted\"\r\n                                halloweenStatusPara:SetDesc(string.format(\"[%d/%d] %s | %s (Stay at Base)\", idx, #HALLOWEEN_HOUSES, house.title, resInfo))\r\n                            end\r\n                        end)\r\n                    end\r\n                    \r\n                    -- Jeda antar rumah (cepat, mulus, dan efisien)\r\n                    local waitDuration = math.max(0.3, halloweenHouseDelay or 1)\r\n                    local elapsed = 0\r\n                    while elapsed < waitDuration do\r\n                        if not halloweenAutoTeleportActive then break end\r\n                        if not isHalloweenNightTime() then break end\r\n                        if isHigherPriorityTeleportActive() then break end\r\n                        task.wait(0.1)\r\n                        elapsed = elapsed + 0.1\r\n                    end\r\n                else\r\n                    pcall(function()\r\n                        if halloweenStatusPara then\r\n                            halloweenStatusPara:SetDesc(string.format(\"[%d/%d] %s (Model Not Found) -> Skip\", idx, #HALLOWEEN_HOUSES, house.title))\r\n                        end\r\n                    end)\r\n                    task.wait(0.2)\r\n                end\r\n                \r\n                if not halloweenAutoTeleportActive then break end\r\n                if not isHalloweenNightTime() then break end\r\n                \r\n                idx = idx + 1\r\n            end\r\n            \r\n            if not halloweenAutoTeleportActive then break end\r\n            \r\n            -- Selesai putaran rumah (apakah selesai penuh 1-9 atau terpotong karena siang):\r\n            completedAllHouses = (idx > #HALLOWEEN_HOUSES)\r\n            \r\n            -- Jika masih ada tugas prioritas (seperti kill cultist campfire atau stronghold) yang sedang aktif, tunggu sampai benar-benar selesai\r\n            while halloweenAutoTeleportActive and isHigherPriorityTeleportActive() do\r\n                task.wait(1)\r\n            end\r\n            \r\n            if not halloweenAutoTeleportActive then break end\r\n            \r\n            -- Pemain tetap diam di Base sepanjang waktu, jalankan post halloween actions\r\n            runPostHalloweenActions()\r\n            \r\n            if completedAllHouses then\r\n                WindUI:Notify({\r\n                    Title = \"Halloween Event\",\r\n                    Content = \"Round 1-9 finished for tonight! All candy collected while staying at base.\",\r\n                    Duration = 4\r\n                })\r\n                pcall(function()\r\n                    if halloweenStatusPara then\r\n                        halloweenStatusPara:SetDesc(\"Round 1-9 completed (Stay at Base)! Waiting for night to end...\")\r\n                    end\r\n                end)\r\n                \r\n                -- Tunggu sisa malam ini habis sampai siang tiba\r\n                while halloweenAutoTeleportActive and isHalloweenNightTime() do\r\n                    -- Jika ada tugas prioritas (seperti Stronghold Raid atau Campfire Combat) aktif selagi standby:\r\n                    if isHigherPriorityTeleportActive() then\r\n                        while halloweenAutoTeleportActive and isHigherPriorityTeleportActive() do\r\n                            task.wait(1)\r\n                        end\r\n                    else\r\n                        -- Active Anti-Fling Guard HANYA ketika standby di base dan tidak ada tugas prioritas yang aktif:\r\n                        pcall(function()\r\n                            local myChar = _LocalPlayer.Character\r\n                            local hrp = myChar and myChar:FindFirstChild(\"HumanoidRootPart\")\r\n                            if hrp and not isHigherPriorityTeleportActive() and not (_G.IsStrongholdRaidActive or _G.StrongholdTransition or _G.StrongholdPreparingRaid) then\r\n                                if hrp.AssemblyLinearVelocity.Magnitude > 40 or math.abs(hrp.AssemblyLinearVelocity.Y) > 25 then\r\n                                    hrp.AssemblyLinearVelocity = Vector3.zero\r\n                                    hrp.AssemblyAngularVelocity = Vector3.zero\r\n                                    hrp.Velocity = Vector3.zero\r\n                                    hrp.RotVelocity = Vector3.zero\r\n                                end\r\n                            end\r\n                        end)\r\n                    end\r\n                    task.wait(1)\r\n                end\r\n            else\r\n                pcall(function()\r\n                    if halloweenStatusPara then\r\n                        halloweenStatusPara:SetDesc(string.format(\"Night ended at house %d/9! Reset to House 1 for next night.\", math.min(idx, #HALLOWEEN_HOUSES)))\r\n                    end\r\n                end)\r\n            end\r\n            \r\n            -- Loop akan otomatis kembali ke atas (Tunggu siang berlalu, countdown 10s, mulai RUMAH 1)!\r\n        end\r\n        \r\n        -- Loop berakhir (karena toggle dimatikan manual)\r\n        halloweenAutoTeleportActive = false\r\n        halloweenRunningTask = nil\r\n    end)\r\nend\r\n\r\nhalloweenAutoToggle = Tabs.Event:Toggle({\r\n    Title = '🎃 Auto Farm Candy (Stay at Base)',\r\n    Desc = 'Runs at Night. Collects all 9 houses remotely while you stay at base, sweeps all Candy directly to you',\r\n    Value = false,\r\n    Callback = function(state)\r\n        if isProgrammaticHalloweenToggle then return end\r\n        if state then\r\n            startHalloweenLoop()\r\n        else\r\n            stopHalloweenLoop(true)\r\n        end\r\n    end\r\n})\r\n\r\nTabs.Event:Slider({\r\n    Title = 'Delay Per House',\r\n    Value = {Min = 0.3, Max = 10, Default = 1},\r\n    Callback = function(val)\r\n        halloweenHouseDelay = val\r\n    end\r\n})\r\n\r\n-- =========================================================\r\n-- AUTO STORE COSTUMES TO CLOSET - EVENT DRIVEN / LOW CPU\r\n-- Tempel menggantikan blok `do` Auto Store lama sampai akhir file.\r\n-- Bagian di atas blok ini (Halloween Event/Slider) tidak perlu diubah.\r\n-- =========================================================\r\ndo\r\n    local autoStoreCostumeDropsEnabled = false\r\n    local costumeClosetCollectorToken = 0\r\n\r\n    local CollectionService = game:GetService(\"CollectionService\")\r\n    local SCAN_BATCH = 50\r\n    local STORE_GAP = 0.15\r\n    local MAX_ATTEMPTS = 3\r\n\r\n    local KEYWORDS = {\r\n        \"pirate\", \"werewolf\", \"astronaut\", \"dinosaur\",\r\n        \"lobster\", \"mummy\", \"spider\"\r\n    }\r\n    local EXCLUDED = {\r\n        \"box\", \"crate\", \"chest\", \"present\", \"coin\", \"blueprint\"\r\n    }\r\n\r\n    local cachedCostumeDropNames = {}\r\n    local namesReady = false\r\n    local cachedCloset = nil\r\n    local cachedStoreRemote = nil\r\n    local cachedRemoteEvents = nil\r\n\r\n    local itemsFolder = nil\r\n    local itemsAddedConn = nil\r\n    local workspaceAddedConn = nil\r\n    local structuresAddedConn = nil\r\n    local closetTagConn = nil\r\n    local pendingClosetWake = false\r\n\r\n    local queue = {}\r\n    local queueHead, queueTail = 1, 0\r\n    local workerToken = nil\r\n    local waitingForCloset = false\r\n    local queued = setmetatable({}, {__mode = \"k\"})\r\n    local attempted = setmetatable({}, {__mode = \"k\"})\r\n    local nextRetry = setmetatable({}, {__mode = \"k\"})\r\n    local warnCount = 0\r\n\r\n    local function active(token)\r\n        return autoStoreCostumeDropsEnabled\r\n            and costumeClosetCollectorToken == token\r\n    end\r\n\r\n    local function logProblem(item, why)\r\n        warnCount = warnCount + 1\r\n        if warnCount <= 10 then\r\n            warn(\"[CostumeCloset] \" .. tostring(item and item.Name or \"?\")\r\n                .. \": \" .. tostring(why))\r\n        elseif warnCount == 11 then\r\n            warn(\"[CostumeCloset] More errors suppressed to avoid log spam\")\r\n        end\r\n    end\r\n\r\n    local function isCostumePiece(item)\r\n        if not item or not item.Parent then return false end\r\n        local n = string.lower(item.Name)\r\n        for _, word in ipairs(EXCLUDED) do\r\n            if string.find(n, word, 1, true) then return false end\r\n        end\r\n        if item:GetAttribute(\"Interaction\") == \"Costume\"\r\n            or item:GetAttribute(\"CostumeId\") ~= nil\r\n            or item:GetAttribute(\"CostumeSlot\") ~= nil then\r\n            return true\r\n        end\r\n        if cachedCostumeDropNames[item.Name] then return true end\r\n        for _, word in ipairs(KEYWORDS) do\r\n            if string.find(n, word, 1, true) then return true end\r\n        end\r\n        return false\r\n    end\r\n\r\n    local function isCostumeHeldByOther(item)\r\n        if not item or not item.Parent then return true end\r\n        for _, player in ipairs(_Players:GetPlayers()) do\r\n            if player ~= _LocalPlayer and player.Character\r\n                and item:IsDescendantOf(player.Character) then\r\n                return true\r\n            end\r\n        end\r\n        return false\r\n    end\r\n\r\n    local function eligible(item)\r\n        if not item or item.Parent ~= itemsFolder then return false end\r\n        if not isCostumePiece(item) then return false end\r\n        if _G.KixIsLoggingCampItem\r\n            and _G.KixIsLoggingCampItem(item) then return false end\r\n        return not isCostumeHeldByOther(item)\r\n    end\r\n\r\n    -- One-time incremental cache scan; no GetDescendants().\r\n    local function buildCostumeNames(token)\r\n        local assets = _ReplicatedStorage:FindFirstChild(\"Assets\")\r\n        local root = assets and assets:FindFirstChild(\"CostumeModels\")\r\n        if not root then return end\r\n\r\n        local stack = {root}\r\n        local n = 0\r\n        while #stack > 0 and active(token) do\r\n            local parent = table.remove(stack)\r\n            for _, child in ipairs(parent:GetChildren()) do\r\n                if child:IsA(\"Model\") then\r\n                    cachedCostumeDropNames[child.Name] = true\r\n                end\r\n                if child:IsA(\"Model\") or child:IsA(\"Folder\") then\r\n                    stack[#stack + 1] = child\r\n                end\r\n                n = n + 1\r\n                if n % SCAN_BATCH == 0 then\r\n                    task.wait()\r\n                    if not active(token) then return end\r\n                end\r\n            end\r\n        end\r\n        if active(token) then namesReady = true end\r\n    end\r\n\r\n    local function findCostumeCloset()\r\n        if cachedCloset and cachedCloset.Parent then\r\n            local zone = cachedCloset:FindFirstChild(\"AddItemZone\")\r\n            if zone then return cachedCloset, zone end\r\n        end\r\n        cachedCloset = nil\r\n        for _, closet in ipairs(CollectionService:GetTagged(\"CostumeCloset\")) do\r\n            if closet:FindFirstChild(\"AddItemZone\") then\r\n                cachedCloset = closet\r\n                return closet, closet.AddItemZone\r\n            end\r\n        end\r\n        local structures = _Workspace:FindFirstChild(\"Structures\")\r\n        if structures then\r\n            local closet = structures:FindFirstChild(\"Costume Closet\")\r\n                or structures:FindFirstChild(\"Custome Closet\")\r\n                or structures:FindFirstChild(\"CostumeCloset\")\r\n            if closet and closet:FindFirstChild(\"AddItemZone\") then\r\n                cachedCloset = closet\r\n                return closet, closet.AddItemZone\r\n            end\r\n        end\r\n        return nil, nil\r\n    end\r\n\r\n    -- IMPORTANT: Do not require :IsA('RemoteFunction') here.\r\n    -- Client.Events may return a remote wrapper with InvokeServer.\r\n    local function getStoreRemote()\r\n        if cachedStoreRemote then\r\n            if typeof(cachedStoreRemote) ~= \"Instance\"\r\n                or cachedStoreRemote.Parent then\r\n                return cachedStoreRemote\r\n            end\r\n            cachedStoreRemote = nil\r\n        end\r\n        local ok, client = pcall(function()\r\n            return require(_LocalPlayer.PlayerScripts.Client)\r\n        end)\r\n        if ok and client and client.Events\r\n            and client.Events.RequestStoreCostumePiece then\r\n            cachedStoreRemote = client.Events.RequestStoreCostumePiece\r\n            return cachedStoreRemote\r\n        end\r\n        local remotes = _ReplicatedStorage:FindFirstChild(\"RemoteEvents\")\r\n        return remotes and remotes:FindFirstChild(\"RequestStoreCostumePiece\")\r\n    end\r\n\r\n    local function getDragRemotes()\r\n        if not cachedRemoteEvents or not cachedRemoteEvents.Parent then\r\n            cachedRemoteEvents = _ReplicatedStorage:FindFirstChild(\"RemoteEvents\")\r\n        end\r\n        local folder = cachedRemoteEvents\r\n        if not folder then return nil, nil end\r\n        return folder:FindFirstChild(\"RequestStartDraggingItem_REAL\")\r\n                or folder:FindFirstChild(\"RequestStartDraggingItem\"),\r\n            folder:FindFirstChild(\"StopDraggingItem_REAL\")\r\n                or folder:FindFirstChild(\"StopDraggingItem\")\r\n    end\r\n\r\n    -- Restore the exact verified sequence from the original working version.\r\n    -- The Main.DraggingAttachment is an attachment used by the game's drag\r\n    -- implementation; it is not the remote parameter and is not moved here.\r\n    local function storeCostumeToCloset(targetItem, closet, addItemZone, token)\r\n        local folder = itemsFolder or _Workspace:FindFirstChild(\"Items\")\r\n        if not folder then return false, \"Items missing\" end\r\n        local item = targetItem\r\n        if typeof(item) == \"string\" then item = folder:FindFirstChild(item) end\r\n        if not item or item.Parent ~= folder then\r\n            return false, \"Item no longer on ground\"\r\n        end\r\n        if _G.KixIsLoggingCampItem\r\n            and _G.KixIsLoggingCampItem(item) then\r\n            return false, \"Item reserved by camp logger\"\r\n        end\r\n        if not closet then closet, addItemZone = findCostumeCloset() end\r\n        if not closet then return false, \"Closet missing\" end\r\n\r\n        local reqStartDrag, reqStopDrag = getDragRemotes()\r\n        local storeRemote = getStoreRemote()\r\n        if not storeRemote then return false, \"Store remote missing\" end\r\n        -- The original working code treated drag remotes as optional.\r\n        -- Always try the store request even if a drag remote was renamed.\r\n        if reqStartDrag then\r\n            pcall(function() reqStartDrag:FireServer(item) end)\r\n        end\r\n        task.wait(0.08)\r\n\r\n        if token and not active(token) then\r\n            if reqStopDrag then\r\n                pcall(function() reqStopDrag:FireServer(item) end)\r\n            end\r\n            return false, \"Collector disabled\"\r\n        end\r\n\r\n        local ok, response = pcall(function()\r\n            return storeRemote:InvokeServer(item, closet)\r\n        end)\r\n        task.wait(0.08)\r\n        if reqStopDrag then\r\n            pcall(function() reqStopDrag:FireServer(item) end)\r\n        end\r\n\r\n        if not ok then\r\n            cachedStoreRemote = nil -- resolve again on retry\r\n            return false, \"InvokeServer error: \" .. tostring(response)\r\n        end\r\n        if response == false then return false, \"Server returned false\" end\r\n        if type(response) == \"table\" then\r\n            if response.Success == false or response.success == false then\r\n                return false, \"Server rejected store\"\r\n            end\r\n            if response.Success == true or response.success == true then\r\n                return true, \"Server confirmed\"\r\n            end\r\n        end\r\n        if response == true then return true, \"Server confirmed\" end\r\n\r\n        -- Some game remotes return nil even on success.\r\n        -- Check source Instance after a small replication grace period.\r\n        if item.Parent ~= folder then return true, \"Item moved\" end\r\n        task.wait(0.2)\r\n        if item.Parent ~= folder then return true, \"Item moved\" end\r\n        return false, \"No confirmation; item still in workspace.Items\"\r\n    end\r\n\r\n    local enqueueCostume, startWorker\r\n\r\n    startWorker = function(token)\r\n        if not active(token) or workerToken == token\r\n            or waitingForCloset or queueHead > queueTail then\r\n            return\r\n        end\r\n        workerToken = token\r\n        task.spawn(function()\r\n            while active(token) and queueHead <= queueTail do\r\n                if _G.IsStrongholdRaidActive == true\r\n                    or _G.StrongholdTransition == true\r\n                    or _G.StrongholdPreparingRaid == true then\r\n                    task.wait(0.7)\r\n                    continue\r\n                end\r\n\r\n                local closet, zone = findCostumeCloset()\r\n                if not closet then\r\n                    waitingForCloset = true\r\n                    break -- retain queue; reawaken via structure/tag events\r\n                end\r\n\r\n                local item = queue[queueHead]\r\n                queue[queueHead] = nil\r\n                queueHead = queueHead + 1\r\n                if item then\r\n                    queued[item] = nil\r\n                    if eligible(item) then\r\n                        local ok, success, reason = pcall(\r\n                            storeCostumeToCloset, item, closet, zone, token\r\n                        )\r\n                        if active(token) then\r\n                            if ok and success then\r\n                                attempted[item] = nil\r\n                                nextRetry[item] = nil\r\n                            elseif item.Parent == itemsFolder then\r\n                                local attempts = (attempted[item] or 0) + 1\r\n                                attempted[item] = attempts\r\n                                logProblem(item, ok and reason or success)\r\n                                if attempts < MAX_ATTEMPTS then\r\n                                    local seconds = attempts == 1 and 5 or 15\r\n                                    nextRetry[item] = os.clock() + seconds\r\n                                    task.delay(seconds, function()\r\n                                        if active(token) and item.Parent == itemsFolder then\r\n                                            enqueueCostume(item, token)\r\n                                        end\r\n                                    end)\r\n                                end\r\n                            end\r\n                        end\r\n                    end\r\n                end\r\n                if queueHead <= queueTail then task.wait(STORE_GAP) end\r\n            end\r\n\r\n            if workerToken == token then\r\n                workerToken = nil\r\n                if queueHead > queueTail then\r\n                    queue = {}\r\n                    queueHead, queueTail = 1, 0\r\n                elseif active(token) and not waitingForCloset then\r\n                    task.defer(function() startWorker(token) end)\r\n                end\r\n            end\r\n        end)\r\n    end\r\n\r\n    enqueueCostume = function(item, token)\r\n        if not active(token) or not item or queued[item] then return end\r\n        if (attempted[item] or 0) >= MAX_ATTEMPTS then return end\r\n        if nextRetry[item] and os.clock() < nextRetry[item] then return end\r\n        if not eligible(item) then return end\r\n        queued[item] = true\r\n        queueTail = queueTail + 1\r\n        queue[queueTail] = item\r\n        startWorker(token)\r\n    end\r\n\r\n    local function scanExistingItems(token)\r\n        local folder = itemsFolder\r\n        if not folder then return end\r\n        task.spawn(function()\r\n            local children = folder:GetChildren()\r\n            for i, item in ipairs(children) do\r\n                if not active(token) or itemsFolder ~= folder then return end\r\n                enqueueCostume(item, token)\r\n                if i % SCAN_BATCH == 0 then task.wait() end\r\n            end\r\n        end)\r\n    end\r\n\r\n    local function attachItems(folder, token)\r\n        if itemsAddedConn then\r\n            itemsAddedConn:Disconnect()\r\n            itemsAddedConn = nil\r\n        end\r\n        itemsFolder = folder\r\n        if not folder then return end\r\n        itemsAddedConn = folder.ChildAdded:Connect(function(item)\r\n            if active(token) then enqueueCostume(item, token) end\r\n        end)\r\n        scanExistingItems(token)\r\n    end\r\n\r\n    local function wakeWhenClosetAppears(token)\r\n        if not active(token) then return end\r\n        cachedCloset = nil\r\n        waitingForCloset = false\r\n        startWorker(token)\r\n        -- One deferred check for AddItemZone when the model is newly built.\r\n        if not pendingClosetWake then\r\n            pendingClosetWake = true\r\n            task.delay(1.2, function()\r\n                pendingClosetWake = false\r\n                if active(token) then\r\n                    waitingForCloset = false\r\n                    startWorker(token)\r\n                end\r\n            end)\r\n        end\r\n    end\r\n\r\n    local function attachStructures(structures, token)\r\n        if structuresAddedConn then\r\n            structuresAddedConn:Disconnect()\r\n            structuresAddedConn = nil\r\n        end\r\n        if structures then\r\n            structuresAddedConn = structures.ChildAdded:Connect(function(child)\r\n                local lower = string.lower(child.Name)\r\n                if string.find(lower, \"costume\", 1, true)\r\n                    or string.find(lower, \"custome\", 1, true) then\r\n                    wakeWhenClosetAppears(token)\r\n                end\r\n            end)\r\n        end\r\n    end\r\n\r\n    local function startCostumeDropClosetCollector()\r\n        costumeClosetCollectorToken = costumeClosetCollectorToken + 1\r\n        local token = costumeClosetCollectorToken\r\n        waitingForCloset = false\r\n        warnCount = 0\r\n\r\n        attachItems(_Workspace:FindFirstChild(\"Items\"), token)\r\n        attachStructures(_Workspace:FindFirstChild(\"Structures\"), token)\r\n\r\n        workspaceAddedConn = _Workspace.ChildAdded:Connect(function(child)\r\n            if not active(token) then return end\r\n            if child.Name == \"Items\" then\r\n                attachItems(child, token)\r\n            elseif child.Name == \"Structures\" then\r\n                attachStructures(child, token)\r\n                wakeWhenClosetAppears(token)\r\n            end\r\n        end)\r\n        closetTagConn = CollectionService:GetInstanceAddedSignal(\r\n            \"CostumeCloset\"\r\n        ):Connect(function()\r\n            wakeWhenClosetAppears(token)\r\n        end)\r\n\r\n        if not namesReady then\r\n            task.spawn(function()\r\n                buildCostumeNames(token)\r\n                if active(token) then scanExistingItems(token) end\r\n            end)\r\n        end\r\n    end\r\n\r\n    local function stopCostumeDropClosetCollector()\r\n        costumeClosetCollectorToken = costumeClosetCollectorToken + 1\r\n        if itemsAddedConn then itemsAddedConn:Disconnect() end\r\n        if workspaceAddedConn then workspaceAddedConn:Disconnect() end\r\n        if structuresAddedConn then structuresAddedConn:Disconnect() end\r\n        if closetTagConn then closetTagConn:Disconnect() end\r\n        itemsAddedConn = nil\r\n        workspaceAddedConn = nil\r\n        structuresAddedConn = nil\r\n        closetTagConn = nil\r\n        itemsFolder = nil\r\n        workerToken = nil\r\n        waitingForCloset = false\r\n        queue = {}\r\n        queueHead, queueTail = 1, 0\r\n        queued = setmetatable({}, {__mode = \"k\"})\r\n        attempted = setmetatable({}, {__mode = \"k\"})\r\n        nextRetry = setmetatable({}, {__mode = \"k\"})\r\n    end\r\n\r\n    _G.KixEngines.AutoStoreCostumesToCloset = function(value)\r\n        value = value == true\r\n        if value == (autoStoreCostumeDropsEnabled == true) then return end\r\n        autoStoreCostumeDropsEnabled = value\r\n        if value then\r\n            startCostumeDropClosetCollector()\r\n        else\r\n            stopCostumeDropClosetCollector()\r\n        end\r\n    end\r\n\r\n    _G.KixHubStopCostumeCollector = function()\r\n        _G.KixEngines.AutoStoreCostumesToCloset(false)\r\n    end\r\n\r\n    _G.KixStartupFeatures.Toggles.AutoStoreCostumesToCloset =\r\n        Tabs.Event:Toggle({\r\n            Title = \"📥 Auto Store Costumes to Closet\",\r\n            Desc = \"Stores costume clothes\",\r\n            Value = true,\r\n            Callback = function(value)\r\n                _G.KixStartupFeatures.Set(\r\n                    \"AutoStoreCostumesToCloset\", value\r\n                )\r\n            end\r\n        })\r\n    -- Start the worker and force the visual switch on. Some WindUI builds do\r\n    -- not invoke the callback or retain the declared initial Value consistently.\r\n    _G.KixStartupFeatures.Set(\"AutoStoreCostumesToCloset\", true)\r\n    pcall(function()\r\n        local toggle = _G.KixStartupFeatures.Toggles.AutoStoreCostumesToCloset\r\n        if toggle and type(toggle.Set) == \"function\" then\r\n            toggle:Set(true, false, true)\r\n        elseif toggle and type(toggle.SetValue) == \"function\" then\r\n            toggle:SetValue(true)\r\n        elseif toggle and type(toggle.SetState) == \"function\" then\r\n            toggle:SetState(true)\r\n        end\r\n    end)\r\n    -- Reapply once after the window finishes its initial layout/state setup.\r\n    task.defer(function()\r\n        if not KixHubSession.Alive then return end\r\n        pcall(_G.KixStartupFeatures.Set, \"AutoStoreCostumesToCloset\", true)\r\n        pcall(function()\r\n            local toggle = _G.KixStartupFeatures.Toggles.AutoStoreCostumesToCloset\r\n            if toggle and type(toggle.Set) == \"function\" then\r\n                toggle:Set(true, false, true)\r\n            elseif toggle and type(toggle.SetValue) == \"function\" then\r\n                toggle:SetValue(true)\r\n            elseif toggle and type(toggle.SetState) == \"function\" then\r\n                toggle:SetState(true)\r\n            end\r\n        end)\r\n    end)\r\n\r\n    -- Existing Halloween environment functionality stays unchanged.\r\n    autoRemoveHalloweenGrassEnabled = true\r\n    if type(startHalloweenGrassWatcher) == \"function\" then\r\n        pcall(startHalloweenGrassWatcher)\r\n    end\r\nend\r\n\r\nlocal origCleanupHalloween = getgenv().KixHubCleanup\r\ngetgenv().KixHubCleanup = function()\r\n    stopHalloweenLoop()\r\n    if _G.KixHubStopCostumeCollector then\r\n        _G.KixHubStopCostumeCollector()\r\n    end\r\n    if halloweenGrassConn then\r\n        halloweenGrassConn:Disconnect()\r\n        halloweenGrassConn = nil\r\n    end\r\n    if origCleanupHalloween then origCleanupHalloween() end\r\nend\r\n\r\n-- Outer closures from the original full script:\r\nend; INIT_EVENT_TAB() end\r\n\r\n-- ==================== INVENTORY TAB ====================\r\nTabs.Inventory:Section({Title = 'Player Inventory Scanner', Icon = 'scan'})\r\n\r\ninvPlayersList = {\"Refresh First\"}\r\ninvSelectedPlayer = \"Refresh First\"\r\ninvPlayerMap = {}\r\nInvPlayerDrop = Tabs.Inventory:Dropdown({\r\n    Title = 'Select Player',\r\n    Values = invPlayersList,\r\n    Callback = function(val) invSelectedPlayer = val[1] or val end\r\n})\r\n\r\nTabs.Inventory:Button({\r\n    Title = 'Refresh List',\r\n    Callback = function()\r\n        local list, map = GetPlayerDisplayListAndMap()\r\n        invPlayerMap = map\r\n        if #list == 0 then\r\n            InvPlayerDrop:Refresh({\"No players found\"})\r\n            invSelectedPlayer = \"No players found\"\r\n        else\r\n            InvPlayerDrop:Refresh(list)\r\n            invSelectedPlayer = list[1]\r\n        end\r\n    end\r\n})\r\n\r\nlocal InvOutput\r\n\r\nTabs.Inventory:Button({\r\n    Title = 'Scan Inventory',\r\n    Callback = function()\r\n        if invSelectedPlayer == \"Refresh First\" or invSelectedPlayer == \"No players found\" then\r\n            if InvOutput then InvOutput:Set({Title = \"Scan Output\", Desc = \"Please refresh and select a valid player first.\"}) end\r\n            return\r\n        end\r\n        \r\n        local realName = invPlayerMap[invSelectedPlayer]\r\n        local targetPlayer = realName and game:GetService(\"Players\"):FindFirstChild(realName)\r\n        if not targetPlayer then\r\n            if InvOutput then InvOutput:Set({Title = \"Scan Output\", Desc = \"Player \" .. invSelectedPlayer .. \" not found in server.\"}) end\r\n            return\r\n        end\r\n        \r\n        local pName = targetPlayer.Name\r\n        local dName = targetPlayer.DisplayName\r\n        \r\n        local outText = \"Inventory of \" .. pName .. \" (\" .. dName .. \"):\\n\"\r\n        \r\n        local armourFolder = targetPlayer:FindFirstChild(\"Armour\")\r\n        if armourFolder then\r\n            local armourParts = armourFolder:GetChildren()\r\n            if #armourParts > 0 then\r\n                for _, arm in ipairs(armourParts) do\r\n                    outText = outText .. \"Armour : \" .. arm.Name .. \"\\n\"\r\n                end\r\n            else\r\n                outText = outText .. \"Armour : None\\n\"\r\n            end\r\n        end\r\n        \r\n        local invFolder = targetPlayer:FindFirstChild(\"Inventory\")\r\n        local bagFolder = targetPlayer:FindFirstChild(\"ItemBag\")\r\n        \r\n        if invFolder or bagFolder then\r\n            local itemCounts = {}\r\n            \r\n            local function scanFolder(folder)\r\n                if not folder then return end\r\n                for _, item in ipairs(folder:GetChildren()) do\r\n                    local amnt = 1\r\n                    if item:IsA(\"IntValue\") or item:IsA(\"NumberValue\") then\r\n                        amnt = item.Value\r\n                    end\r\n                    itemCounts[item.Name] = (itemCounts[item.Name] or 0) + amnt\r\n                end\r\n            end\r\n            \r\n            scanFolder(invFolder)\r\n            scanFolder(bagFolder)\r\n            \r\n            local sortedItems = {}\r\n            for k, _ in pairs(itemCounts) do table.insert(sortedItems, k) end\r\n            table.sort(sortedItems)\r\n            \r\n            for _, itemName in ipairs(sortedItems) do\r\n                local count = itemCounts[itemName]\r\n                if count > 0 then\r\n                    if count > 1 then\r\n                        outText = outText .. \"- \" .. itemName .. \" : \" .. tostring(count) .. \"\\n\"\r\n                    else\r\n                        outText = outText .. \"- \" .. itemName .. \"\\n\"\r\n                    end\r\n                end\r\n            end\r\n        else\r\n            outText = outText .. \"\\n(Inventory and ItemBag not found for this player)\"\r\n        end\r\n        \r\n\r\n        \r\n        if InvOutput and type(InvOutput.ParagraphFrame) == \"table\" and InvOutput.ParagraphFrame.UIElements and InvOutput.ParagraphFrame.UIElements.Main then\r\n            for _, ui in ipairs(InvOutput.ParagraphFrame.UIElements.Main:GetDescendants()) do\r\n                if ui:IsA(\"TextLabel\") then\r\n                    if ui.Name == \"Title\" or ui.Text:match(\"Scan Output\") then\r\n                        ui.Text = \"Scan Output: \" .. pName\r\n                    elseif ui.Name == \"Desc\" or ui.Name == \"Description\" or string.len(ui.Text) > 15 then\r\n                        ui.Text = outText\r\n                    end\r\n                end\r\n            end\r\n        end\r\n    end\r\n})\r\n\r\nInvOutput = Tabs.Inventory:Paragraph({\r\n    Title = \"Scan Output\",\r\n    Desc = \"Select a player and press Scan Inventory to see results.\"\r\n})\r\n\r\n-- ==================== STRUCTURE FALLBACK SYSTEM (HALLOWEEN / SPOOKY VARIANTS) ====================\r\nlocal STRUCTURE_FALLBACK_MAP = {\r\n    [\"Torch\"] = {\"Spooky Torch\"},\r\n    [\"Spooky Torch\"] = {\"Torch\"},\r\n    \r\n    [\"Giant Bed\"] = {\"Spooky Giant Bed\"},\r\n    [\"Spooky Giant Bed\"] = {\"Giant Bed\"},\r\n    \r\n    [\"Old Bed\"] = {\"Spooky Old Bed\"},\r\n    [\"Spooky Old Bed\"] = {\"Old Bed\"},\r\n    \r\n    [\"Regular Bed\"] = {\"Spooky Regular Bed\", \"Spooky Reguler Bed\", \"Reguler Bed\"},\r\n    [\"Reguler Bed\"] = {\"Regular Bed\", \"Spooky Reguler Bed\", \"Spooky Regular Bed\"},\r\n    [\"Spooky Regular Bed\"] = {\"Regular Bed\", \"Reguler Bed\", \"Spooky Reguler Bed\"},\r\n    [\"Spooky Reguler Bed\"] = {\"Regular Bed\", \"Reguler Bed\", \"Spooky Regular Bed\"},\r\n    \r\n    [\"Good Bed\"] = {\"Spooky Good Bed\"},\r\n    [\"Spooky Good Bed\"] = {\"Good Bed\"},\r\n    \r\n    [\"Log Wall\"] = {\"Spooky Log Wall\"},\r\n    [\"Spooky Log Wall\"] = {\"Log Wall\"},\r\n    \r\n    [\"Log Gate\"] = {\"Spooky Log Gate\"},\r\n    [\"Spooky Log Gate\"] = {\"Log Gate\"},\r\n}\r\n\r\nlocal function getStructureCandidateNames(name)\r\n    if not name or type(name) ~= \"string\" or name == \"\" then\r\n        return {name}\r\n    end\r\n    local candidates = {name}\r\n    local seen = {[name] = true}\r\n    \r\n    local fallbacks = STRUCTURE_FALLBACK_MAP[name]\r\n    if fallbacks then\r\n        for _, fb in ipairs(fallbacks) do\r\n            if not seen[fb] then\r\n                seen[fb] = true\r\n                table.insert(candidates, fb)\r\n            end\r\n        end\r\n    end\r\n    \r\n    if name:sub(1, 7) == \"Spooky \" then\r\n        local base = name:sub(8)\r\n        if not seen[base] then\r\n            seen[base] = true\r\n            table.insert(candidates, base)\r\n        end\r\n    else\r\n        local spooky = \"Spooky \" .. name\r\n        if not seen[spooky] then\r\n            seen[spooky] = true\r\n            table.insert(candidates, spooky)\r\n        end\r\n    end\r\n    \r\n    return candidates\r\nend\r\n_G.GetStructureCandidateNames = getStructureCandidateNames\r\n\r\n    -- ==================== SKY BASE (EXTERNAL BUILDER) ====================\r\n    local skyBaseExecuting = false\r\n    local function executeSkyBase()\r\n        if skyBaseExecuting then return end\r\n        skyBaseExecuting = true\r\n        \r\n        task.spawn(function()\r\n            pcall(function()\r\n                -- 1. Anti-Double: Cleanup instance lama jika jendela external sudah terbuka\r\n                if getgenv().SkyBaseCleanup and type(getgenv().SkyBaseCleanup) == \"function\" then\r\n                    pcall(getgenv().SkyBaseCleanup)\r\n                    getgenv().SkyBaseCleanup = nil\r\n                end\r\n                if getgenv().SkyBaseScreenGui and getgenv().SkyBaseScreenGui.Parent then\r\n                    pcall(function() getgenv().SkyBaseScreenGui:Destroy() end)\r\n                    getgenv().SkyBaseScreenGui = nil\r\n                end\r\n                \r\n                -- Cari dan bersihkan ScreenGui lama di CoreGui, gethui, dan PlayerGui\r\n                local containers = {}\r\n                local okCore, coreGui = pcall(function() return game:GetService(\"CoreGui\") end)\r\n                if okCore and coreGui then table.insert(containers, coreGui) end\r\n                \r\n                local okHui, hui = pcall(function() return type(gethui) == \"function\" and gethui() end)\r\n                if okHui and hui and not table.find(containers, hui) then table.insert(containers, hui) end\r\n                \r\n                local playerGui = _LocalPlayer and _LocalPlayer:FindFirstChild(\"PlayerGui\")\r\n                if playerGui and not table.find(containers, playerGui) then table.insert(containers, playerGui) end\r\n                \r\n                for _, container in ipairs(containers) do\r\n                    for _, child in ipairs(container:GetChildren()) do\r\n                        if child:IsA(\"ScreenGui\") then\r\n                            local lowerName = string.lower(child.Name)\r\n                            if string.find(lowerName, \"skybase\", 1, true) or string.find(lowerName, \"sky base\", 1, true) or string.find(lowerName, \"sky_base\", 1, true) then\r\n                                pcall(function() child:Destroy() end)\r\n                            end\r\n                        end\r\n                    end\r\n                end\r\n                \r\n                -- Catat daftar ScreenGui yang sudah ada sebelum eksekusi\r\n                local beforeGuis = {}\r\n                for _, container in ipairs(containers) do\r\n                    for _, child in ipairs(container:GetChildren()) do\r\n                        if child:IsA(\"ScreenGui\") then\r\n                            beforeGuis[child] = true\r\n                        end\r\n                    end\r\n                end\r\n                \r\n                WindUI:Notify({\r\n                    Title = \"Sky Base\",\r\n                    Content = \"Executing Sky Base external script...\",\r\n                    Duration = 2.5\r\n                })\r\n                \r\n                -- 2. Eksekusi script external dari URL yang diminta\r\n                local skyBaseUrl = \"https://rawcdn.githack.com/Kixdev/99NITF/c6c1af90c7af36c67f9d073aa6a2540ad853f79c/sky-base\"\r\n                local loadSuccess, loadErr = pcall(function()\r\n                    loadstring(game:HttpGet(skyBaseUrl))()\r\n                end)\r\n                \r\n                if not loadSuccess then\r\n                    WindUI:Notify({\r\n                        Title = \"Sky Base Error\",\r\n                        Content = \"Failed to execute: \" .. tostring(loadErr),\r\n                        Duration = 4\r\n                    })\r\n                else\r\n                    -- 3. Deteksi ScreenGui baru yang di-spawn agar bisa di-replace jika tombol ditekan kembali\r\n                    task.delay(0.2, function()\r\n                        for _, container in ipairs(containers) do\r\n                            for _, child in ipairs(container:GetChildren()) do\r\n                                if child:IsA(\"ScreenGui\") and not beforeGuis[child] then\r\n                                    getgenv().SkyBaseScreenGui = child\r\n                                    break\r\n                                end\r\n                            end\r\n                        end\r\n                    end)\r\n                end\r\n            end)\r\n            \r\n            task.wait(1)\r\n            skyBaseExecuting = false\r\n        end)\r\n    end\r\n\r\n    Tabs.Base:Section({Title = 'Sky Base', Icon = 'cloud'})\r\n    Tabs.Base:Button({\r\n        Title = 'Execute Sky Base',\r\n        Desc = 'Build structures at custom sky height (Hide UI Press Comma)',\r\n        Icon = 'external-link',\r\n        Callback = executeSkyBase\r\n    })\r\n\r\n-- ==================== BASE TAB (UNIVERSAL BUILDER) ====================\r\ndo local function INIT_UNIVERSAL_BUILDER()\r\n    Tabs.Base:Section({Title = 'Universal Builder', Icon = 'hammer'})\r\n    Tabs.Base:Paragraph({\r\n        Title = 'Information',\r\n        Desc = 'Automatically builds structures based on blueprints with geometric precision.'\r\n    })\r\n\r\n    local Config = {\r\n        targetBlueprint = \"Log Wall\",\r\n        centerMode = \"Campfire\",\r\n        shape = \"Cross\",\r\n        radius = 50,\r\n        layers = 1,\r\n        spacing = 3,\r\n        wallLength = 14,\r\n        plantDelay = 0.01,\r\n        previewEnabled = false,\r\n        itemRotation = 0,\r\n        skyHeight = 0,\r\n        verticalLayers = 1,\r\n        verticalSpacing = 14\r\n    }\r\n\r\n    -- Variabel penampung elemen UI agar bisa dipaksa sinkronisasi (Force Update)\r\n    local UI_BlueprintInput, UI_CenterMode, UI_Shape, UI_ShapeRotation, UI_Rotation\r\n    local UI_Radius, UI_WallWidth, UI_TotalLayers, UI_LayerSpacing, UI_BuildDelay, UI_SkyHeight, UI_VerticalLayers, UI_VerticalSpacing\r\n    local pendingBlueprintName = Config.targetBlueprint\r\n\r\n    local selectedTemplate = \"- Select -\"\r\n\r\n    Tabs.Base:Dropdown({\r\n        Title = 'Quick Template',\r\n        Values = {\r\n            \"- Select -\",\r\n            \"Cross Wall\",\r\n            \"Cross Wall Big (10 Torch)\",\r\n            \"Wooden Bookshelf (10 Torch)\",\r\n            \"Lantern Cross (10 Torch)\",\r\n            \"Wood Rain Storage\",\r\n            \"Circle Wall\",\r\n            \"Stakes\"\r\n        },\r\n        Value = \"- Select -\",\r\n        Callback = function(val)\r\n            selectedTemplate = val[1] or val\r\n            if selectedTemplate ~= \"- Select -\" and Config.applySelectedTemplate then\r\n                Config.applySelectedTemplate()\r\n            end\r\n        end\r\n    })\r\n\r\n    -- Apply template from the dropdown callback so selection updates config and preview together.\r\n    Config.applySelectedTemplate = function()\r\n            if selectedTemplate == \"- Select -\" then\r\n                WindUI:Notify({Title=\"Template\", Content=\"Please select a template first!\", Duration=3})\r\n                return\r\n            end\r\n\r\n            -- Fungsi cerdas untuk memaksa UI berubah menyesuaikan Library WindUI\r\n            local function forceUpdateUI(uiElement, val, isDropdown)\r\n                if not uiElement then return end\r\n                pcall(function()\r\n                    if isDropdown then\r\n                        if uiElement.SetValue then uiElement:SetValue({val}) end\r\n                        if uiElement.Set then uiElement:Set({val}) end\r\n                    else\r\n                        if uiElement.SetValue then uiElement:SetValue(val) end\r\n                        if uiElement.Set then uiElement:Set(val) end\r\n                    end\r\n                end)\r\n            end\r\n\r\n            local function applyAndSync(\r\n                bp,\r\n                center,\r\n                shape,\r\n                shapeRot,\r\n                rot,\r\n                rad,\r\n                wall,\r\n                layer,\r\n                space,\r\n                delay,\r\n                skyHeight,\r\n                verticalLayers,\r\n                verticalSpacing\r\n            )\r\n\r\n                -- =====================================================\r\n                -- CORE CONFIG\r\n                -- =====================================================\r\n\r\n                Config.targetBlueprint = bp\r\n                pendingBlueprintName = bp\r\n                Config.centerMode = center\r\n                Config.shape = shape\r\n                Config.shapeRotation = shapeRot\r\n                Config.itemRotation = tonumber(\r\n                    rot:match(\"%d+\")\r\n                )\r\n                Config.radius = rad\r\n                Config.wallLength = wall\r\n                Config.layers = layer\r\n                Config.spacing = space\r\n                Config.plantDelay = delay\r\n\r\n\r\n                -- =====================================================\r\n                -- OPTIONAL TEMPLATE VALUES\r\n                -- Default untuk template lama\r\n                -- =====================================================\r\n\r\n                Config.skyHeight =\r\n                    skyHeight ~= nil\r\n                    and skyHeight\r\n                    or 0\r\n\r\n                Config.verticalLayers =\r\n                    verticalLayers ~= nil\r\n                    and verticalLayers\r\n                    or 1\r\n\r\n                Config.verticalSpacing =\r\n                    verticalSpacing ~= nil\r\n                    and verticalSpacing\r\n                    or 14\r\n\r\n\r\n                -- =====================================================\r\n                -- UPDATE UI\r\n                -- =====================================================\r\n\r\n                forceUpdateUI(\r\n                    UI_BlueprintInput,\r\n                    bp,\r\n                    false\r\n                )\r\n\r\n                forceUpdateUI(\r\n                    UI_CenterMode,\r\n                    center,\r\n                    true\r\n                )\r\n\r\n                forceUpdateUI(\r\n                    UI_Shape,\r\n                    shape,\r\n                    true\r\n                )\r\n\r\n                forceUpdateUI(\r\n                    UI_ShapeRotation,\r\n                    shapeRot,\r\n                    false\r\n                )\r\n\r\n                forceUpdateUI(\r\n                    UI_Rotation,\r\n                    rot,\r\n                    true\r\n                )\r\n\r\n                forceUpdateUI(\r\n                    UI_Radius,\r\n                    rad,\r\n                    false\r\n                )\r\n\r\n                forceUpdateUI(\r\n                    UI_WallWidth,\r\n                    wall,\r\n                    false\r\n                )\r\n\r\n                forceUpdateUI(\r\n                    UI_TotalLayers,\r\n                    layer,\r\n                    false\r\n                )\r\n\r\n                forceUpdateUI(\r\n                    UI_LayerSpacing,\r\n                    space,\r\n                    false\r\n                )\r\n\r\n                forceUpdateUI(\r\n                    UI_BuildDelay,\r\n                    delay * 10,\r\n                    false\r\n                )\r\n\r\n                -- =====================================================\r\n                -- SKY HEIGHT\r\n                -- =====================================================\r\n\r\n                forceUpdateUI(\r\n                    UI_SkyHeight,\r\n                    Config.skyHeight,\r\n                    false\r\n                )\r\n\r\n                -- =====================================================\r\n                -- VERTICAL LAYERS\r\n                -- =====================================================\r\n\r\n                forceUpdateUI(\r\n                    UI_VerticalLayers,\r\n                    Config.verticalLayers,\r\n                    false\r\n                )\r\n\r\n                -- =====================================================\r\n                -- VERTICAL SPACING\r\n                -- =====================================================\r\n\r\n                forceUpdateUI(\r\n                    UI_VerticalSpacing,\r\n                    Config.verticalSpacing,\r\n                    false\r\n                )\r\n\r\n\r\n                if Config.syncBuilderSession then\r\n                    Config.syncBuilderSession()\r\n                end\r\n\r\n\r\n                -- =====================================================\r\n                -- NOTIFY\r\n                -- =====================================================\r\n\r\n                WindUI:Notify({\r\n                    Title = \"Template Applied\",\r\n\r\n                    Content =\r\n                        selectedTemplate\r\n                        .. \" applied and synced successfully!\",\r\n\r\n                    Duration = 3,\r\n\r\n                    Icon = \"check\"\r\n                })\r\n\r\n                if Config.setBuilderPreview then\r\n                    Config.setBuilderPreview(true)\r\n                end\r\n\r\n            end\r\n\r\n            if selectedTemplate == \"Cross Wall\" then\r\n                applyAndSync(\"Log Wall\", \"Campfire\", \"Cross\", 0, \"0°\", 50, 14, 1, 3, 0.25)\r\n            elseif selectedTemplate == \"Cross Wall Big (10 Torch)\" then\r\n                applyAndSync(\"Log Wall\", \"Campfire\", \"Cross\", 0, \"0°\", 96, 14, 1, 3, 0.25)\r\n            elseif selectedTemplate == \"Wood Rain Storage\" then\r\n                applyAndSync(\"Wood Rain Storage\", \"Campfire\", \"Circle\", 0, \"180°\", 53, 8, 1, 3, 0.25)\r\n            elseif selectedTemplate == \"Circle Wall\" then\r\n                applyAndSync(\"Log Wall\", \"Campfire\", \"Circle\", 0, \"0°\", 53, 13, 1, 3, 0.25)\r\n            elseif selectedTemplate == \"Wooden Bookshelf (10 Torch)\" then\r\n                applyAndSync(\"Wooden Bookshelf\", \"Campfire\", \"Cross\", 0, \"180°\", 89, 7, 1, 3, 0.25)\r\n            elseif selectedTemplate == \"Lantern Cross (10 Torch)\" then\r\n\r\n                applyAndSync(\r\n                    \"Stone Lantern\",\r\n                    \"Campfire\",\r\n                    \"Cross\",\r\n                    0,\r\n                    \"0°\",\r\n                    84,\r\n                    21,\r\n                    1,\r\n                    1,\r\n                    1,\r\n                    2,   -- Sky Height\r\n                    1,   -- Vertical Layers\r\n                    14   -- Vertical Spacing\r\n                )\r\n\r\n            elseif selectedTemplate == \"Stakes\" then\r\n\r\n                applyAndSync(\r\n                    \"Stakes\",\r\n                    \"Player\",\r\n                    \"Line\",\r\n                    180,\r\n                    \"0°\",\r\n                    18,\r\n                    2,\r\n                    2,\r\n                    1,\r\n                    1\r\n                )\r\n\r\n            end\r\n        end\r\n\r\n    local previewTask = nil\r\n    local previewParts = {}\r\n    local currentPreviewName = \"\"\r\n    local isBuilding = false\r\n    local updatePreviewFunction\r\n\r\n    Config.setBuilderPreview = function(v)\r\n            Config.previewEnabled = v\r\n            if Config.previewEnabled then\r\n                if not previewTask then\r\n                    previewTask = task.spawn(function()\r\n                        while Config.previewEnabled do\r\n                            if updatePreviewFunction then updatePreviewFunction() end\r\n                            task.wait(0.75)\r\n                        end\r\n                    end)\r\n                end\r\n            else\r\n                if previewTask then task.cancel(previewTask); previewTask = nil end\r\n                if Config.clearBuilderPreview then\r\n                    Config.clearBuilderPreview()\r\n                else\r\n                    for _, part in ipairs(previewParts) do pcall(function() part:Destroy() end) end\r\n                    previewParts = {}\r\n                end\r\n            end\r\n    end\r\n\r\n    Tabs.Base:Button({\r\n        Title = 'Stop Preview Blueprint',\r\n        Desc = 'Stops the current blueprint preview. Selecting another template starts its preview again.',\r\n        Icon = 'eye-off',\r\n        Callback = function()\r\n            if Config.setBuilderPreview then Config.setBuilderPreview(false) end\r\n        end\r\n    })\r\n\r\n\r\n\r\n    local startBuildingFunc\r\n    Tabs.Base:Button({\r\n        Title = 'Start Building',\r\n        Desc = 'Builds the structure based on the current preview. Click again to stop. Resume for Wooden Bookshelf Building',\r\n        Callback = function() if startBuildingFunc then startBuildingFunc() end end\r\n    })\r\n\r\n    Tabs.Base:Button({\r\n        Title = 'Resume Building (Locked Center)',\r\n        Desc = 'Resume the previous build using its saved coordinates.',\r\n        Callback = function()\r\n            if Config.resumeBuilding then Config.resumeBuilding() end\r\n        end\r\n    })\r\n\r\n    BuilderStatus = Tabs.Base:Paragraph({\r\n        Title = \"Builder Status\",\r\n        Desc = \"Total: 0 | Needed: 0\"\r\n    })\r\n\r\n    UI_Radius = Tabs.Base:Slider({\r\n        Title = 'Radius / Length',\r\n        Step = 1,\r\n        Increment = 1,\r\n        Value = {Min = 5, Max = 150, Default = Config.radius, Step = 1},\r\n        Callback = function(val) Config.radius = math.floor(val + 0.5) end\r\n    })\r\n\r\n    UI_BlueprintInput = Tabs.Base:Input({\r\n        Title = 'Structures by Name',\r\n        Default = Config.targetBlueprint,\r\n        Placeholder = 'e.g. Log Wall',\r\n        Callback = function(v)\r\n            if v and v ~= \"\" then pendingBlueprintName = v end\r\n        end\r\n    })\r\n\r\n    Tabs.Base:Button({\r\n        Title = 'Apply Structures by Name',\r\n        Desc = 'Use the entered structure name for preview and building.',\r\n        Icon = 'check',\r\n        Callback = function()\r\n            local name = tostring(pendingBlueprintName or \"\"):match(\"^%s*(.-)%s*$\")\r\n            if name == \"\" then\r\n                WindUI:Notify({Title = 'Builder', Content = 'Enter a structure name first.', Duration = 3})\r\n                return\r\n            end\r\n            Config.targetBlueprint = name\r\n            pendingBlueprintName = name\r\n            if Config.syncBuilderSession then Config.syncBuilderSession() end\r\n            if Config.setBuilderPreview then\r\n                Config.setBuilderPreview(true)\r\n            elseif Config.previewEnabled and updatePreviewFunction then\r\n                updatePreviewFunction()\r\n            end\r\n        end\r\n    })\r\n\r\n    Tabs.Base:Section({Title = 'Configuration', Icon = 'settings'})\r\n\r\n    UI_ShapeRotation = Tabs.Base:Slider({\r\n        Title = 'Rotate Structure (°)',\r\n        Step = 1,\r\n        Increment = 1,\r\n        Value = {Min = 0, Max = 360, Default = 0, Step = 1},\r\n        Callback = function(val) Config.shapeRotation = val end\r\n    })    \r\n\r\n    UI_SkyHeight = Tabs.Base:Slider({\r\n        Title = 'Height (Y Offset)',\r\n        Step = 1,\r\n        Increment = 1,\r\n        Value = {Min = -50, Max = 300, Default = 0, Step = 1},\r\n        Callback = function(val) Config.skyHeight = val end\r\n    })    \r\n\r\n    UI_WallWidth = Tabs.Base:Slider({\r\n        Title = 'Align Structures',\r\n        Step = 1,\r\n        Increment = 1,\r\n        Value = {Min = 2, Max = 50, Default = Config.wallLength, Step = 1},\r\n        Callback = function(val) Config.wallLength = math.floor(val + 0.5) end\r\n    })    \r\n\r\n    UI_CenterMode = Tabs.Base:Dropdown({\r\n        Title = 'Center Mode',\r\n        Values = {\"Campfire\", \"Player\"},\r\n        Value = Config.centerMode,\r\n        Callback = function(val) Config.centerMode = val[1] or val end\r\n    })\r\n\r\n    Tabs.Base:Dropdown({\r\n        Title = \"Build Side\",\r\n        Desc = \"Choose which part of the generated structure will be built.\",\r\n        Values = {\r\n            \"Both\",\r\n            \"Left Half Only\",\r\n            \"Right Half Only\",\r\n            \"Left Half -> Right Half\",\r\n            \"Right Half -> Left Half\"\r\n        },\r\n        Value = \"Normal\",\r\n\r\n        Callback = function(val)\r\n            Config.buildOrder = val[1] or val\r\n        end\r\n    })\r\n\r\n    UI_Shape = Tabs.Base:Dropdown({\r\n        Title = 'Shape',\r\n        Values = {\"Circle\", \"Square\", \"Cross\", \"Star\", \"Triangle\", \"Line\"},\r\n        Value = Config.shape,\r\n        Callback = function(val) Config.shape = val[1] or val end\r\n    })\r\n\r\n    UI_Rotation = Tabs.Base:Dropdown({\r\n        Title = 'Item Rotation',\r\n        Values = {\"0°\", \"90°\", \"180°\", \"270°\"},\r\n        Value = \"0°\",\r\n        Callback = function(val)\r\n            local v = val[1] or val\r\n            Config.itemRotation = tonumber(v:match(\"%d+\"))\r\n        end\r\n    })\r\n\r\n    UI_TotalLayers = Tabs.Base:Slider({\r\n        Title = 'Horizontal Layers (Width)',\r\n        Value = {Min = 1, Max = 10, Default = Config.layers},\r\n        Callback = function(val) Config.layers = val end\r\n    })\r\n\r\n    UI_LayerSpacing = Tabs.Base:Slider({\r\n        Title = 'Horizontal Spacing',\r\n        Value = {Min = 1, Max = 20, Default = Config.spacing},\r\n        Callback = function(val) Config.spacing = val end\r\n    })\r\n    \r\n    UI_VerticalLayers = Tabs.Base:Slider({\r\n        Title = 'Vertical Layers (Tower Height)',\r\n        Desc = 'Automatically stacks the structure on top of each other X times.',\r\n        Value = {Min = 1, Max = 20, Default = Config.verticalLayers},\r\n        Callback = function(val) Config.verticalLayers = val end\r\n    })\r\n    \r\n    UI_VerticalSpacing = Tabs.Base:Slider({\r\n        Title = 'Vertical Spacing (Y Offset per Layer)',\r\n        Desc = 'Height difference between each vertical stack (usually 14 for walls).',\r\n        Value = {Min = 1, Max = 30, Default = Config.verticalSpacing},\r\n        Callback = function(val) Config.verticalSpacing = val end\r\n    })\r\n\r\n    UI_BuildDelay = Tabs.Base:Slider({\r\n        Title = 'Build Delay (s)',\r\n        Value = {Min = 0, Max = 10, Default = Config.plantDelay * 10},\r\n        Callback = function(val) Config.plantDelay = val / 10 end\r\n    })\r\n\r\n    Tabs.Base:Section({Title = 'Execution', Icon = 'zap'})\r\n\r\n    local builtMemory = {}\r\n\r\n    Tabs.Base:Button({\r\n        Title = 'Reset Memory',\r\n        Desc = 'Completely clears all builder sessions, saved coordinates, and previous build memory.',\r\n        Icon = 'trash',\r\n        Callback = function()\r\n\r\n            -- Stop building jika sedang berjalan\r\n            isBuilding = false\r\n\r\n            -- Clear memory lokal\r\n            table.clear(builtMemory)\r\n\r\n            -- Clear semua session Quick Template\r\n            _G.BuilderSessions = {}\r\n\r\n            -- Hapus active session\r\n            _G.ActiveBuilderSession = nil\r\n            _G.LastBuilderSession = nil\r\n\r\n            -- Hapus compatibility memory lama\r\n            _G.LastBuilderGeoms = nil\r\n\r\n            -- Optional: reset counter/session references\r\n            _G.LastBuilderSessionKey = nil\r\n\r\n            WindUI:Notify({\r\n                Title = \"Memory Reset\",\r\n                Content = \"All builder memory, sessions, and saved coordinates have been completely cleared!\",\r\n                Duration = 4\r\n            })\r\n        end\r\n    })\r\n\r\n    -- Geometry & Builder Logic\r\n    local function clearPreview()\r\n        for _, part in ipairs(previewParts) do pcall(function() part:Destroy() end) end\r\n        previewParts = {}\r\n        local container = _Workspace:FindFirstChild(\"KixPreviewContainer\")\r\n        if container then pcall(function() container:Destroy() end) end\r\n    end\r\n    Config.clearBuilderPreview = clearPreview\r\n\r\n    local function getCenterPos()\r\n        if Config.centerMode == \"Campfire\" then\r\n            local campfire = _Workspace:FindFirstChild(\"Map\") \r\n            if campfire then campfire = campfire:FindFirstChild(\"Campground\") end\r\n            if campfire then campfire = campfire:FindFirstChild(\"MainFire\") end\r\n            if campfire and campfire:IsA(\"Model\") and campfire.PrimaryPart then\r\n                return campfire.PrimaryPart.Position\r\n            end\r\n            return Vector3.new(0, 0, 0)\r\n        else\r\n            if _LocalPlayer.Character and _LocalPlayer.Character:FindFirstChild(\"HumanoidRootPart\") then\r\n                return _LocalPlayer.Character.HumanoidRootPart.Position\r\n            end\r\n            return Vector3.new(0, 0, 0)\r\n        end\r\n    end\r\n\r\n    local function getGroundY(xzPos, defaultY)\r\n        local isLantern = (Config.targetBlueprint == \"Stone Lantern\" or Config.targetBlueprint == \"Brick Lantern\")\r\n        local origin = Vector3.new(xzPos.X, (defaultY or xzPos.Y) + (isLantern and 10 or 200), xzPos.Z)\r\n        local rp = RaycastParams.new()\r\n        \r\n        if isLantern then\r\n            rp.FilterType = Enum.RaycastFilterType.Exclude\r\n            local ignoreList = {}\r\n            if _LocalPlayer.Character then table.insert(ignoreList, _LocalPlayer.Character) end\r\n            local previewContainer = _Workspace:FindFirstChild(\"KixPreviewContainer\")\r\n            if previewContainer then table.insert(ignoreList, previewContainer) end\r\n            rp.FilterDescendantsInstances = ignoreList\r\n        else\r\n            rp.FilterType = Enum.RaycastFilterType.Include\r\n            local includeList = {}\r\n            local groundFolder = _Workspace:FindFirstChild(\"Map\")\r\n            if groundFolder then\r\n                local g = groundFolder:FindFirstChild(\"Ground\")\r\n                local s = groundFolder:FindFirstChild(\"Snow\")\r\n                if g then table.insert(includeList, g) end\r\n                if s then table.insert(includeList, s) end\r\n            end\r\n            table.insert(includeList, _Workspace.Terrain)\r\n            rp.FilterDescendantsInstances = includeList\r\n        end\r\n\r\n        local res = _Workspace:Raycast(origin, Vector3.new(0, isLantern and -20 or -600, 0), rp)\r\n        if res then return res.Position.Y end\r\n        return defaultY or xzPos.Y\r\n    end\r\n\r\n    local function generatePositions()\r\n        local results = {}\r\n        local center = getCenterPos()\r\n        local wallLength = Config.wallLength\r\n\r\n        for layer = 0, Config.layers - 1 do\r\n            local r = Config.radius\r\n            if Config.shape == \"Circle\" or Config.shape == \"Star\" then\r\n                r = r + (layer * Config.spacing)\r\n            else\r\n                r = r + (layer * Config.wallLength)\r\n            end\r\n            \r\n            if Config.shape == \"Circle\" then\r\n                local circumference = 2 * math.pi * r\r\n                -- FIX: math.ceil polos (tanpa faktor overlap) agar jumlah dinding hanya\r\n                -- naik 1 dari pembulatan floor. Menutup celah seam tanpa membuat dinding\r\n                -- menumpuk padat yang justru ditolak oleh checkOccupied (radius 2 studs).\r\n                local numItems = math.max(4, math.ceil(circumference / wallLength))\r\n                local angleStep = (2 * math.pi) / numItems\r\n                \r\n                for i = 1, numItems do\r\n                    local angle = (i - 1) * angleStep\r\n                    local posX = center.X + math.cos(angle) * r\r\n                    local posZ = center.Z + math.sin(angle) * r\r\n                    local posY = getGroundY(Vector3.new(posX, center.Y, posZ), center.Y)\r\n                    \r\n                    local pos = Vector3.new(posX, posY, posZ)\r\n                    local outwardPos = pos + (pos - Vector3.new(center.X, posY, center.Z)).Unit * 10\r\n                    local cframe = CFrame.lookAt(pos, outwardPos)\r\n                    table.insert(results, {Position = pos, CFrame = cframe})\r\n                end\r\n            elseif Config.shape == \"Line\" then\r\n                local numItems = math.max(1, math.round(r / wallLength))\r\n                for i = 0, numItems - 1 do\r\n                    local offset = (i + 0.5) * wallLength\r\n                    local posX = center.X + offset\r\n                    local posY = getGroundY(Vector3.new(posX, center.Y, center.Z), center.Y)\r\n                    local pos = Vector3.new(posX, posY, center.Z)\r\n                    local cframe = CFrame.new(pos)\r\n                    table.insert(results, {Position = pos, CFrame = cframe})\r\n                end\r\n            elseif Config.shape == \"Square\" then\r\n                local numPerSide = math.max(1, math.round((r * 2) / wallLength))\r\n                local halfSide = (numPerSide * wallLength) / 2\r\n                \r\n                local function addSide(startPos, endPos, items, lookAngle)\r\n                    local direction = (endPos - startPos).Unit\r\n                    for i = 0, items - 1 do\r\n                        local p = startPos + direction * (wallLength * (i + 0.5))\r\n                        local posY = getGroundY(Vector3.new(p.X, center.Y, p.Z), center.Y)\r\n                        local pos = Vector3.new(p.X, posY, p.Z)\r\n                        local cframe = CFrame.new(pos) * CFrame.Angles(0, lookAngle, 0)\r\n                        table.insert(results, {Position = pos, CFrame = cframe})\r\n                    end\r\n                end\r\n                \r\n                local tl = center + Vector3.new(-halfSide, 0, -halfSide)\r\n                local tr = center + Vector3.new(halfSide, 0, -halfSide)\r\n                local br = center + Vector3.new(halfSide, 0, halfSide)\r\n                local bl = center + Vector3.new(-halfSide, 0, halfSide)\r\n                \r\n                addSide(tl, tr, numPerSide, 0)\r\n                addSide(tr, br, numPerSide, -math.pi/2)\r\n                addSide(br, bl, numPerSide, math.pi)\r\n                addSide(bl, tl, numPerSide, math.pi/2)\r\n            elseif Config.shape == \"Triangle\" then\r\n                local numPerSide = math.max(1, math.round((r * 2) / wallLength))\r\n                local sideLength = numPerSide * wallLength\r\n                local h = sideLength * math.sqrt(3) / 2\r\n                local p1 = center + Vector3.new(0, 0, -h/2)\r\n                local p2 = center + Vector3.new(-sideLength/2, 0, h/2)\r\n                local p3 = center + Vector3.new(sideLength/2, 0, h/2)\r\n                \r\n                local function addSide(startPos, endPos, items)\r\n                    local direction = (endPos - startPos).Unit\r\n                    for i = 0, items - 1 do\r\n                        local p = startPos + direction * (wallLength * (i + 0.5))\r\n                        local posY = getGroundY(Vector3.new(p.X, center.Y, p.Z), center.Y)\r\n                        local pos = Vector3.new(p.X, posY, p.Z)\r\n                        local cframe = CFrame.lookAt(pos, pos + direction) * CFrame.Angles(0, math.pi/2, 0)\r\n                        table.insert(results, {Position = pos, CFrame = cframe})\r\n                    end\r\n                end\r\n                \r\n                addSide(p1, p2, numPerSide)\r\n                addSide(p2, p3, numPerSide)\r\n                addSide(p3, p1, numPerSide)\r\n            elseif Config.shape == \"Cross\" then\r\n                local O = math.max(1, math.round((r * 1.2) / wallLength))\r\n                local I = math.max(1, math.round(O * 0.4))\r\n                \r\n                local w = (O * wallLength) / 2\r\n                local d = w + (I * wallLength)\r\n                \r\n                local vertices = {\r\n                    Vector3.new(-w, 0, -d), Vector3.new(w, 0, -d), Vector3.new(w, 0, -w),\r\n                    Vector3.new(d, 0, -w), Vector3.new(d, 0, w), Vector3.new(w, 0, w),\r\n                    Vector3.new(w, 0, d), Vector3.new(-w, 0, d), Vector3.new(-w, 0, w),\r\n                    Vector3.new(-d, 0, w), Vector3.new(-d, 0, -w), Vector3.new(-w, 0, -w)\r\n                }\r\n                local function addSide(startPos, endPos)\r\n                    local length = (endPos - startPos).Magnitude\r\n                    local numItems = math.round(length / wallLength)\r\n                    local direction = (endPos - startPos).Unit\r\n                    for i = 0, numItems - 1 do\r\n                        local p = startPos + direction * (wallLength * (i + 0.5))\r\n                        local posY = getGroundY(Vector3.new(p.X, center.Y, p.Z), center.Y)\r\n                        local pos = Vector3.new(p.X, posY, p.Z)\r\n                        local cframe = CFrame.lookAt(pos, pos + direction) * CFrame.Angles(0, -math.pi/2, 0)\r\n                        table.insert(results, {Position = pos, CFrame = cframe})\r\n                    end\r\n                end\r\n                for i = 1, #vertices do\r\n                    local nextIdx = (i % #vertices) + 1\r\n                    addSide(center + vertices[i], center + vertices[nextIdx])\r\n                end\r\n            elseif Config.shape == \"Star\" then\r\n                local points = 5\r\n                local outerRadius = r\r\n                local innerRadius = r * 0.4\r\n                local vertices = {}\r\n                for i = 0, points * 2 - 1 do\r\n                    local radius = (i % 2 == 0) and outerRadius or innerRadius\r\n                    local angle = i * math.pi / points\r\n                    local p = center + Vector3.new(math.sin(angle) * radius, 0, -math.cos(angle) * radius)\r\n                    table.insert(vertices, p)\r\n                end\r\n                \r\n                local function addSide(startPos, endPos)\r\n                    local length = (endPos - startPos).Magnitude\r\n                    local numItems = math.max(1, math.floor(length / wallLength))\r\n                    local stepVec = (endPos - startPos) / numItems\r\n                    local direction = (endPos - startPos).Unit\r\n                    for i = 0, numItems - 1 do\r\n                        local p = startPos + (stepVec * i)\r\n                        local posY = getGroundY(Vector3.new(p.X, center.Y, p.Z), center.Y)\r\n                        local pos = Vector3.new(p.X, posY, p.Z)\r\n                        local cframe = CFrame.lookAt(pos, pos + direction) * CFrame.Angles(0, math.pi/2, 0)\r\n                        table.insert(results, {Position = pos, CFrame = cframe})\r\n                    end\r\n                end\r\n                \r\n                for i = 1, #vertices do\r\n                    local nextIdx = (i % #vertices) + 1\r\n                    addSide(vertices[i], vertices[nextIdx])\r\n                end\r\n            end\r\n        end\r\n        \r\n        local shapeRotRad = math.rad(Config.shapeRotation or 0)\r\n        if shapeRotRad ~= 0 then\r\n            for i, geom in ipairs(results) do\r\n                local dx = geom.Position.X - center.X\r\n                local dz = geom.Position.Z - center.Z\r\n                local newX = center.X + (dx * math.cos(shapeRotRad) - dz * math.sin(shapeRotRad))\r\n                local newZ = center.Z + (dx * math.sin(shapeRotRad) + dz * math.cos(shapeRotRad))\r\n                \r\n                local posY = getGroundY(Vector3.new(newX, center.Y, newZ), center.Y)\r\n                local newPos = Vector3.new(newX, posY, newZ)\r\n                \r\n                local newCF = CFrame.new(newPos) * CFrame.Angles(0, -shapeRotRad, 0) * (geom.CFrame - geom.CFrame.Position)\r\n                \r\n                results[i] = {Position = newPos, CFrame = newCF}\r\n            end\r\n        end\r\n        \r\n        local rotRad = math.rad(Config.itemRotation)\r\n        if rotRad ~= 0 then\r\n            for _, geom in ipairs(results) do\r\n                geom.CFrame = geom.CFrame * CFrame.Angles(0, rotRad, 0)\r\n            end\r\n        end\r\n        \r\n        if Config.verticalLayers and Config.verticalLayers > 1 then\r\n            local newResults = {}\r\n            for v = 0, Config.verticalLayers - 1 do\r\n                local yOff = v * (Config.verticalSpacing or 14)\r\n                for _, geom in ipairs(results) do\r\n                    local nPos = geom.Position + Vector3.new(0, yOff, 0)\r\n                    local nCF = geom.CFrame + Vector3.new(0, yOff, 0)\r\n                    table.insert(newResults, {Position = nPos, CFrame = nCF})\r\n                end\r\n            end\r\n            results = newResults\r\n        end\r\n        \r\n        if Config.skyHeight and Config.skyHeight ~= 0 then\r\n            for _, geom in ipairs(results) do\r\n                geom.Position = geom.Position + Vector3.new(0, Config.skyHeight, 0)\r\n                geom.CFrame = geom.CFrame + Vector3.new(0, Config.skyHeight, 0)\r\n            end\r\n        end\r\n        \r\n        return results\r\n    end\r\n    \r\n\r\n    local function getTemplateModel()\r\n        local candidateNames = getStructureCandidateNames(Config.targetBlueprint)\r\n        local inv = _LocalPlayer:FindFirstChild(\"Inventory\")\r\n        local structNames = { Config.targetBlueprint }\r\n        local seenNames = { [tostring(Config.targetBlueprint):lower()] = true }\r\n\r\n        local function addStructureName(value)\r\n            if type(value) ~= \"string\" then return end\r\n            value = value:match(\"^%s*(.-)%s*$\")\r\n            if value == \"\" then return end\r\n            local key = value:lower()\r\n            if not seenNames[key] then\r\n                seenNames[key] = true\r\n                table.insert(structNames, value)\r\n            end\r\n            for _, candidate in ipairs(getStructureCandidateNames(value)) do\r\n                local candidateKey = tostring(candidate):lower()\r\n                if candidate ~= \"\" and not seenNames[candidateKey] then\r\n                    seenNames[candidateKey] = true\r\n                    table.insert(structNames, candidate)\r\n                end\r\n            end\r\n        end\r\n\r\n        for _, candidate in ipairs(candidateNames) do\r\n            addStructureName(candidate)\r\n        end\r\n\r\n        if inv then\r\n            for _, cand in ipairs(candidateNames) do\r\n                local bp = inv:FindFirstChild(cand .. \" Blueprint\")\r\n                if bp then\r\n                    local structureName = bp:GetAttribute(\"StructureName\")\r\n                    local valueObject = bp:FindFirstChild(\"StructureName\")\r\n                    if valueObject and valueObject:IsA(\"StringValue\") then\r\n                        structureName = valueObject.Value\r\n                    end\r\n                    addStructureName(structureName)\r\n                end\r\n            end\r\n        end\r\n\r\n        local templateDir = _ReplicatedStorage:FindFirstChild(\"Assets\")\r\n        if templateDir then templateDir = templateDir:FindFirstChild(\"StructureTemplates\") end\r\n        if templateDir then\r\n            for _, name in ipairs(structNames) do\r\n                local tmpl = templateDir:FindFirstChild(name)\r\n                if tmpl and tmpl:IsA(\"Model\") then return tmpl end\r\n            end\r\n\r\n            -- Some game versions change capitalisation or add a canonical name\r\n            -- to the template model; resolve those without requiring an owned tool.\r\n            for _, tmpl in ipairs(templateDir:GetChildren()) do\r\n                if tmpl:IsA(\"Model\") then\r\n                    local canonicalName = tmpl:GetAttribute(\"StructureName\")\r\n                    local namesToMatch = { tmpl.Name, canonicalName }\r\n                    for _, modelName in ipairs(namesToMatch) do\r\n                        if type(modelName) == \"string\" and seenNames[modelName:lower()] then\r\n                            return tmpl\r\n                        end\r\n                    end\r\n                end\r\n            end\r\n        end\r\n\r\n        -- A previously placed copy can supply the same model geometry when this\r\n        -- structure is not owned and its template is not currently replicated.\r\n        local placedStructures = _Workspace:FindFirstChild(\"Structures\")\r\n        if placedStructures then\r\n            for _, model in ipairs(placedStructures:GetChildren()) do\r\n                if model:IsA(\"Model\") then\r\n                    local canonicalName = model:GetAttribute(\"StructureName\")\r\n                    if type(canonicalName) == \"string\" and seenNames[canonicalName:lower()] then\r\n                        return model\r\n                    end\r\n                    if seenNames[model.Name:lower()] then\r\n                        return model\r\n                    end\r\n                end\r\n            end\r\n        end\r\n        return nil\r\n    end\r\n\r\n    local function isPhysicallyPlaced(pos, yOffset, candidateLookups)\r\n        local overlap = OverlapParams.new()\r\n        overlap.FilterType = Enum.RaycastFilterType.Exclude\r\n\r\n        local ignoreList = {}\r\n\r\n        if _LocalPlayer.Character then\r\n            table.insert(ignoreList, _LocalPlayer.Character)\r\n        end\r\n\r\n        local previewContainer = _Workspace:FindFirstChild(\"KixPreviewContainer\")\r\n        if previewContainer then\r\n            table.insert(ignoreList, previewContainer)\r\n        end\r\n\r\n        local charsFolder = _Workspace:FindFirstChild(\"Characters\")\r\n        if charsFolder then\r\n            table.insert(ignoreList, charsFolder)\r\n        end\r\n\r\n        overlap.FilterDescendantsInstances = ignoreList\r\n\r\n        local checkPos = pos + Vector3.new(0, yOffset, 0)\r\n\r\n        local searchRadius = 2.5\r\n\r\n        local parts = _Workspace:GetPartBoundsInRadius(\r\n            checkPos,\r\n            searchRadius,\r\n            overlap\r\n        )\r\n\r\n        if not candidateLookups then\r\n            local tmpl = getTemplateModel()\r\n            candidateLookups = {}\r\n            for _, candidateName in ipairs(getStructureCandidateNames(Config.targetBlueprint)) do\r\n                candidateLookups[candidateName:lower()] = true\r\n            end\r\n            if tmpl then candidateLookups[tmpl.Name:lower()] = true end\r\n        end\r\n\r\n        for _, p in ipairs(parts) do\r\n            local model = p:FindFirstAncestorOfClass(\"Model\")\r\n\r\n            if model and model.Name ~= \"BuilderPreview\" then\r\n\r\n                local modelName = model.Name:lower()\r\n\r\n                local isTargetStructure = false\r\n                for candLower in pairs(candidateLookups) do\r\n                    if modelName:find(candLower, 1, true) or candLower:find(modelName, 1, true) then\r\n                        isTargetStructure = true\r\n                        break\r\n                    end\r\n                end\r\n\r\n                if isTargetStructure then\r\n\r\n                    local structurePos\r\n\r\n                    if model.PrimaryPart then\r\n                        structurePos = model.PrimaryPart.Position\r\n                    else\r\n                        local cf = model:GetBoundingBox()\r\n                        structurePos = cf.Position\r\n                    end\r\n\r\n                    local distance = (structurePos - checkPos).Magnitude\r\n\r\n                    if distance <= 4 then\r\n                        return true\r\n                    end\r\n                end\r\n            end\r\n        end\r\n\r\n        return false\r\n    end\r\n\r\n    local function isBuildSlotBlocked(pos, yOffset)\r\n        local overlap = OverlapParams.new()\r\n        overlap.FilterType = Enum.RaycastFilterType.Exclude\r\n\r\n        local ignoreList = {}\r\n\r\n        if _LocalPlayer.Character then\r\n            table.insert(ignoreList, _LocalPlayer.Character)\r\n        end\r\n\r\n        local previewContainer = _Workspace:FindFirstChild(\"KixPreviewContainer\")\r\n        if previewContainer then\r\n            table.insert(ignoreList, previewContainer)\r\n        end\r\n\r\n        local charsFolder = _Workspace:FindFirstChild(\"Characters\")\r\n        if charsFolder then\r\n            table.insert(ignoreList, charsFolder)\r\n        end\r\n\r\n        overlap.FilterDescendantsInstances = ignoreList\r\n\r\n        local checkPos = pos + Vector3.new(0, yOffset, 0)\r\n\r\n        local parts = _Workspace:GetPartBoundsInRadius(\r\n            checkPos,\r\n            2.5,\r\n            overlap\r\n        )\r\n\r\n        local tmpl = getTemplateModel()\r\n\r\n        local targetName = tostring(Config.targetBlueprint or \"\"):lower()\r\n        local tmplName = tmpl and tmpl.Name:lower() or \"\"\r\n\r\n        for _, part in ipairs(parts) do\r\n            local model = part:FindFirstAncestorOfClass(\"Model\")\r\n\r\n            if model\r\n                and model.Name ~= \"BuilderPreview\"\r\n                and model ~= _LocalPlayer.Character then\r\n\r\n                local modelName = model.Name:lower()\r\n\r\n                local isTargetStructure =\r\n                    (targetName ~= \"\" and modelName:find(targetName, 1, true))\r\n                    or\r\n                    (tmplName ~= \"\" and modelName:find(tmplName, 1, true))\r\n\r\n                -- Kalau structure target → slot sudah terisi.\r\n                if isTargetStructure then\r\n                    return false\r\n                end\r\n\r\n                -- Ada object/model lain di titik build.\r\n                return true\r\n            end\r\n        end\r\n\r\n        -- Tidak ada object sama sekali.\r\n        return false\r\n    end\r\n\r\n    local function isResumeSlotOccupied(pos, yOffset)\r\n        -- Historical session memory only records that a slot was built once.\r\n        -- The structure may since have been picked up, so Resume checks the\r\n        -- live world below and rebuilds the slot when it is empty.\r\n        local checkPos = pos + Vector3.new(0, yOffset, 0)\r\n        local structuresFolder = _Workspace:FindFirstChild(\"Structures\")\r\n        local targetName = tostring(Config.targetBlueprint or \"\"):lower()\r\n        local templateModel = getTemplateModel()\r\n        local templateName = templateModel and templateModel.Name:lower() or \"\"\r\n        local candidateNames = getStructureCandidateNames(Config.targetBlueprint)\r\n        if structuresFolder then\r\n            for _, structure in ipairs(structuresFolder:GetChildren()) do\r\n                if structure:IsA(\"Model\") then\r\n                    local modelName = structure.Name:lower()\r\n                    local isTarget = (targetName ~= \"\" and modelName:find(targetName, 1, true) ~= nil)\r\n                        or (templateName ~= \"\" and modelName:find(templateName, 1, true) ~= nil)\r\n                    if not isTarget then\r\n                        for _, candidateName in ipairs(candidateNames) do\r\n                            local candidateLower = tostring(candidateName):lower()\r\n                            if candidateLower ~= \"\" and modelName:find(candidateLower, 1, true) then\r\n                                isTarget = true\r\n                                break\r\n                            end\r\n                        end\r\n                    end\r\n                    if isTarget then\r\n                        local ok, structurePos = pcall(function()\r\n                            return structure.PrimaryPart and structure.PrimaryPart.Position or structure:GetPivot().Position\r\n                        end)\r\n                        if ok and structurePos and (structurePos - checkPos).Magnitude <= 1.75 then\r\n                            return true\r\n                        end\r\n                    end\r\n                end\r\n            end\r\n        end\r\n\r\n        -- =========================================================\r\n        -- PRIORITAS 2:\r\n        -- Cek structure secara lebih ketat.\r\n        -- Jangan menggunakan radius besar seperti checkOccupied().\r\n        -- =========================================================\r\n\r\n        local overlap = OverlapParams.new()\r\n        overlap.FilterType = Enum.RaycastFilterType.Exclude\r\n\r\n        local ignoreList = {}\r\n\r\n        if _LocalPlayer.Character then\r\n            table.insert(ignoreList, _LocalPlayer.Character)\r\n        end\r\n\r\n        local previewContainer = _Workspace:FindFirstChild(\"KixPreviewContainer\")\r\n        if previewContainer then\r\n            table.insert(ignoreList, previewContainer)\r\n        end\r\n\r\n        local charsFolder = _Workspace:FindFirstChild(\"Characters\")\r\n        if charsFolder then\r\n            table.insert(ignoreList, charsFolder)\r\n        end\r\n\r\n        overlap.FilterDescendantsInstances = ignoreList\r\n\r\n        -- KECILKAN radius supaya structure tetangga\r\n        -- tidak dianggap sebagai slot ini.\r\n        local parts = _Workspace:GetPartBoundsInRadius(\r\n            checkPos,\r\n            1.15,\r\n            overlap\r\n        )\r\n\r\n        local tmpl = getTemplateModel()\r\n\r\n        local targetName = tostring(Config.targetBlueprint or \"\"):lower()\r\n        local tmplName = tmpl and tmpl.Name:lower() or \"\"\r\n\r\n        for _, part in ipairs(parts) do\r\n            local model = part:FindFirstAncestorOfClass(\"Model\")\r\n\r\n            if model\r\n                and model.Name ~= \"BuilderPreview\"\r\n                and model ~= _LocalPlayer.Character then\r\n\r\n                local modelName = model.Name:lower()\r\n\r\n                local isTargetStructure =\r\n                    (targetName ~= \"\" and modelName:find(targetName, 1, true))\r\n                    or\r\n                    (tmplName ~= \"\" and modelName:find(tmplName, 1, true))\r\n\r\n                if isTargetStructure then\r\n                    local structurePos\r\n\r\n                    if model.PrimaryPart then\r\n                        structurePos = model.PrimaryPart.Position\r\n                    else\r\n                        local cf = model:GetBoundingBox()\r\n                        structurePos = cf.Position\r\n                    end\r\n\r\n                    -- JAUH LEBIH KETAT daripada versi sebelumnya.\r\n                    if (structurePos - checkPos).Magnitude <= 1.5 then\r\n                        return true\r\n                    end\r\n                end\r\n            end\r\n        end\r\n\r\n        return false\r\n    end\r\n\r\n    Config.scanResumeOccupiedSlots = function(geoms, yOffset)\r\n        local occupied = {}\r\n        local structuresFolder = _Workspace:FindFirstChild(\"Structures\")\r\n        if not structuresFolder or not geoms or #geoms == 0 then return occupied end\r\n\r\n        local targetName = tostring(Config.targetBlueprint or \"\"):lower()\r\n        local templateModel = getTemplateModel()\r\n        local templateName = templateModel and templateModel.Name:lower() or \"\"\r\n        local candidateNames = getStructureCandidateNames(Config.targetBlueprint)\r\n\r\n        for _, structure in ipairs(structuresFolder:GetChildren()) do\r\n            if structure:IsA(\"Model\") then\r\n                local modelName = structure.Name:lower()\r\n                local isTarget = (targetName ~= \"\" and modelName:find(targetName, 1, true) ~= nil)\r\n                    or (templateName ~= \"\" and modelName:find(templateName, 1, true) ~= nil)\r\n                if not isTarget then\r\n                    for _, candidateName in ipairs(candidateNames) do\r\n                        local candidateLower = tostring(candidateName):lower()\r\n                        if candidateLower ~= \"\" and modelName:find(candidateLower, 1, true) then\r\n                            isTarget = true\r\n                            break\r\n                        end\r\n                    end\r\n                end\r\n\r\n                if isTarget then\r\n                    local ok, structurePos = pcall(function()\r\n                        return structure.PrimaryPart and structure.PrimaryPart.Position or structure:GetPivot().Position\r\n                    end)\r\n                    if ok and structurePos then\r\n                        local nearestIndex = nil\r\n                        local nearestDistance = math.huge\r\n                        local secondDistance = math.huge\r\n                        for index, geom in ipairs(geoms) do\r\n                            local slotPos = geom.Position + Vector3.new(0, yOffset, 0)\r\n                            local distance = (structurePos - slotPos).Magnitude\r\n                            if distance < nearestDistance then\r\n                                secondDistance = nearestDistance\r\n                                nearestDistance = distance\r\n                                nearestIndex = index\r\n                            elseif distance < secondDistance then\r\n                                secondDistance = distance\r\n                            end\r\n                        end\r\n\r\n                        -- Match only a live structure close to this exact slot;\r\n                        -- old session data must not keep removed structures occupied.\r\n                        local matchRadius = math.min(1.75, math.max(1.25, secondDistance * 0.35))\r\n                        if nearestIndex and nearestDistance <= matchRadius then\r\n                            occupied[nearestIndex] = true\r\n                        end\r\n                    end\r\n                end\r\n            end\r\n        end\r\n\r\n        return occupied\r\n    end\r\n\r\n    local function checkOccupied(pos, yOffset, candidateLookups)\r\n        local memThreshold = (Config.centerMode == \"Player\") and 0.2 or 1.5\r\n\r\n        for _, memPos in ipairs(builtMemory) do\r\n            if (pos - memPos).Magnitude < memThreshold then\r\n                return true\r\n            end\r\n        end\r\n\r\n        return isPhysicallyPlaced(pos, yOffset, candidateLookups)\r\n    end\r\n\r\n    updatePreviewFunction = function()\r\n        local success, err = pcall(function()\r\n            if not Config.previewEnabled then clearPreview(); return end\r\n            \r\n            if currentPreviewName ~= Config.targetBlueprint then\r\n                clearPreview()\r\n                currentPreviewName = Config.targetBlueprint\r\n            end\r\n        \r\n        local geoms = generatePositions()\r\n        local templateModel = getTemplateModel()\r\n        local previewCandidateLookups = {}\r\n        for _, candidateName in ipairs(getStructureCandidateNames(Config.targetBlueprint)) do\r\n            previewCandidateLookups[candidateName:lower()] = true\r\n        end\r\n        if templateModel then previewCandidateLookups[templateModel.Name:lower()] = true end\r\n        \r\n        local previewModelContainer = _Workspace:FindFirstChild(\"KixPreviewContainer\")\r\n        if not previewModelContainer then\r\n            previewModelContainer = Instance.new(\"Model\")\r\n            previewModelContainer.Name = \"KixPreviewContainer\"\r\n            previewModelContainer.Parent = _Workspace\r\n            \r\n            local hl = Instance.new(\"Highlight\")\r\n            hl.FillColor = Color3.fromRGB(0, 255, 0)\r\n            hl.FillTransparency = 0.6\r\n            hl.OutlineColor = Color3.fromRGB(0, 255, 0)\r\n            hl.OutlineTransparency = 0.2\r\n            hl.Parent = previewModelContainer\r\n        end\r\n        \r\n        while #previewParts < #geoms do\r\n            local p\r\n            if templateModel and templateModel:IsA(\"Model\") then\r\n                p = templateModel:Clone()\r\n                p.Name = \"BuilderPreview\"\r\n                \r\n                for _, child in ipairs(p:GetDescendants()) do\r\n                    if child:IsA(\"Script\") or child:IsA(\"LocalScript\") then\r\n                        pcall(function() child:Destroy() end)\r\n                    elseif child:IsA(\"BasePart\") then\r\n                        child.Anchored = true\r\n                        child.CanCollide = false\r\n                        child.CanTouch = false\r\n                        child.CanQuery = false\r\n                        \r\n                        -- FIX: Sembunyikan Hitbox/Part tak terlihat yang bikin kotak raksasa\r\n                        if child.Transparency >= 0.95 or child.Name:lower():find(\"hitbox\") or child.Name == \"Interaction\" then\r\n                            child.Transparency = 1\r\n                        else\r\n                            -- Keep original material and color to maintain details\r\n                            -- Just make it slightly transparent so the Highlight tint does the work\r\n                            child.Transparency = 0.3\r\n                        end\r\n                    end\r\n                end\r\n            else\r\n                p = Instance.new(\"Part\")\r\n                p.Size = Vector3.new(Config.wallLength, 4, 1)\r\n                p.Anchored = true\r\n                p.CanCollide = false\r\n                p.Name = \"BuilderPreview\"\r\n                p.Material = Enum.Material.SmoothPlastic\r\n                p.Color = Color3.fromRGB(0, 255, 0)\r\n                p.Transparency = 0.5\r\n            end\r\n            p.Parent = previewModelContainer\r\n            table.insert(previewParts, p)\r\n        end\r\n        while #previewParts > #geoms do pcall(function() table.remove(previewParts):Destroy() end) end\r\n        \r\n        local yOffset = 2.5\r\n        if templateModel and templateModel:IsA(\"Model\") then\r\n            if templateModel:GetAttribute(\"StructureHeightOffset\") then\r\n                yOffset = templateModel:GetAttribute(\"StructureHeightOffset\")\r\n            else\r\n                local cframe, size = templateModel:GetBoundingBox()\r\n                local bottomY = cframe.Position.Y - (size.Y / 2)\r\n                local primaryY = templateModel.PrimaryPart and templateModel.PrimaryPart.Position.Y or cframe.Position.Y\r\n                yOffset = primaryY - bottomY\r\n            end\r\n        end\r\n        \r\n        local missingCount = 0\r\n        \r\n        for i, geom in ipairs(geoms) do \r\n            local targetCFrame = geom.CFrame + Vector3.new(0, yOffset, 0)\r\n            local part = previewParts[i]\r\n            \r\n            if checkOccupied(geom.Position, yOffset, previewCandidateLookups) then\r\n                part.Parent = nil\r\n            else\r\n                missingCount = missingCount + 1\r\n                part.Parent = previewModelContainer\r\n                if part:IsA(\"Model\") then\r\n                    part:PivotTo(targetCFrame)\r\n                else\r\n                    part.CFrame = targetCFrame\r\n                end\r\n            end\r\n        end\r\n        \r\n            BuilderStatus:SetDesc(\"Total: \" .. #geoms .. \" | Needed: \" .. missingCount)\r\n        end)\r\n        if not success then\r\n            BuilderStatus:SetDesc(\"ERROR: \" .. tostring(err))\r\n            pcall(function() writefile(\"kix_error.txt\", \"Preview Error: \" .. tostring(err)) end)\r\n        end\r\n    end\r\n\r\n    local cachedPlaceRemote = nil\r\n\r\n    local function findRemote()\r\n\r\n        if cachedPlaceRemote\r\n            and cachedPlaceRemote.Parent\r\n        then\r\n            return cachedPlaceRemote\r\n        end\r\n\r\n        local remoteEvents =\r\n            _ReplicatedStorage:FindFirstChild(\"RemoteEvents\")\r\n\r\n        if not remoteEvents then\r\n            return nil\r\n        end\r\n\r\n        local remote =\r\n            remoteEvents:FindFirstChild(\r\n                \"RequestPlaceStructure\"\r\n            )\r\n\r\n        if remote and remote:IsA(\"RemoteFunction\") then\r\n            cachedPlaceRemote = remote\r\n            return remote\r\n        end\r\n\r\n        return nil\r\n    end\r\n\r\n    local function findBlueprintTool()\r\n        local candidateNames = getStructureCandidateNames(Config.targetBlueprint)\r\n        local containers = {\r\n            _LocalPlayer:FindFirstChild(\"Inventory\"),\r\n            _LocalPlayer.Character,\r\n            _LocalPlayer:FindFirstChild(\"Backpack\")\r\n        }\r\n        for _, cand in ipairs(candidateNames) do\r\n            local bpName = cand .. \" Blueprint\"\r\n            for _, container in ipairs(containers) do\r\n                if container then\r\n                    for _, obj in ipairs(container:GetChildren()) do\r\n                        if obj.Name == bpName then return obj end\r\n                    end\r\n                end\r\n            end\r\n        end\r\n        return nil\r\n    end\r\n\r\n    -- =========================================================\r\n    -- BUILDER SESSION MEMORY\r\n    -- =========================================================\r\n\r\n    _G.BuilderSessions = _G.BuilderSessions or {}\r\n\r\n    local function getBuilderSessionKey(geoms)\r\n        if not geoms or #geoms == 0 then\r\n            return nil\r\n        end\r\n\r\n        local blueprintName = tostring(Config.targetBlueprint or \"Unknown\")\r\n        local points = {}\r\n\r\n        for _, geom in ipairs(geoms) do\r\n            if geom and geom.Position then\r\n                local p = geom.Position\r\n\r\n                local look = geom.CFrame and geom.CFrame.LookVector or Vector3.new(0, 0, -1)\r\n                table.insert(points, string.format(\r\n                    \"%.2f,%.2f,%.2f,%.3f,%.3f\",\r\n                    p.X,\r\n                    p.Y,\r\n                    p.Z,\r\n                    look.X,\r\n                    look.Z\r\n                ))\r\n            end\r\n        end\r\n\r\n        table.sort(points)\r\n\r\n        return blueprintName .. \"|\" .. table.concat(points, \";\")\r\n    end\r\n\r\n    local function getOrCreateBuilderSession(geoms)\r\n        local key = getBuilderSessionKey(geoms)\r\n        if not key then return nil end\r\n\r\n        if not _G.BuilderSessions[key] then\r\n            _G.BuilderSessions[key] = {\r\n                Geoms = geoms,\r\n                BuiltPositions = {},\r\n                BuiltCount = 0,\r\n                Total = #geoms,\r\n                TargetBlueprint = tostring(Config.targetBlueprint or \"\"),\r\n                LastUsed = os.time()\r\n            }\r\n        else\r\n            _G.BuilderSessions[key].Geoms = geoms\r\n            _G.BuilderSessions[key].Total = #geoms\r\n            _G.BuilderSessions[key].TargetBlueprint = tostring(Config.targetBlueprint or \"\")\r\n        end\r\n\r\n        return _G.BuilderSessions[key]\r\n    end\r\n\r\n    local function loadSessionMemory(session)\r\n        table.clear(builtMemory)\r\n\r\n        if not session then return end\r\n\r\n        for _, pos in ipairs(session.BuiltPositions or {}) do\r\n            table.insert(builtMemory, pos)\r\n        end\r\n    end\r\n\r\n    local function saveBuiltPosition(session, pos)\r\n        if not session or not pos then return end\r\n\r\n        for _, existingPos in ipairs(session.BuiltPositions) do\r\n            if (existingPos - pos).Magnitude < 0.5 then\r\n                return\r\n            end\r\n        end\r\n\r\n        table.insert(session.BuiltPositions, pos)\r\n        session.BuiltCount = #session.BuiltPositions\r\n        session.LastUsed = os.time()\r\n    end\r\n\r\n    local function getSessionRemaining(session)\r\n        if not session then return 0 end\r\n\r\n        return math.max(\r\n            0,\r\n            session.Total - #session.BuiltPositions\r\n        )\r\n    end\r\n\r\n    Config.syncBuilderSession = function()\r\n        local templateGeoms = generatePositions()\r\n        if not templateGeoms or #templateGeoms == 0 then return end\r\n\r\n        local session = getOrCreateBuilderSession(templateGeoms)\r\n        if not session then return end\r\n\r\n        _G.ActiveBuilderSession = session\r\n        _G.LastBuilderSession = session\r\n        _G.LastBuilderSessionKey = getBuilderSessionKey(templateGeoms)\r\n        _G.LastBuilderGeoms = session.Geoms\r\n        loadSessionMemory(session)\r\n\r\n        local remaining = getSessionRemaining(session)\r\n        if BuilderStatus then\r\n            pcall(function()\r\n                BuilderStatus:SetDesc(\"Total: \" .. tostring(session.Total) .. \" | Needed: \" .. tostring(remaining))\r\n            end)\r\n        end\r\n    end\r\n\r\n    -- =========================================================\r\n    -- PICK UP SYSTEM\r\n    -- =========================================================\r\n\r\n    Config.pickupBlueprint = Config.pickupBlueprint or \"\"\r\n    getgenv().RevertPickupMemory = getgenv().RevertPickupMemory or {}\r\n\r\n    local failedPickupDebounce = {}\r\n\r\n    \r\n    -- =========================================================\r\n    -- HAMMER STATE CHECK\r\n    -- =========================================================\r\n\r\n    local function getEquippedHammer()\r\n        local char = _LocalPlayer.Character\r\n        if not char then\r\n            return nil\r\n        end\r\n\r\n        for _, child in ipairs(char:GetChildren()) do\r\n            if child:IsA(\"Tool\")\r\n                and string.find(string.lower(child.Name), \"hammer\") then\r\n                return child\r\n            end\r\n        end\r\n\r\n        return nil\r\n    end\r\n\r\n    local function isHammerEquipped()\r\n        return getEquippedHammer() ~= nil\r\n    end\r\n\r\n\r\n    local function pickupSingleStructure(object)\r\n        if not object or not object:IsDescendantOf(workspace) then\r\n            return false\r\n        end\r\n\r\n        local now = os.clock()\r\n        if failedPickupDebounce[object] and now < failedPickupDebounce[object] then\r\n            return false\r\n        end\r\n\r\n        if object:GetAttribute(\"Driver\") then\r\n            return false\r\n        end\r\n        if object:HasTag(\"Turret\") and object:GetAttribute(\"Owner\") ~= _LocalPlayer.UserId then\r\n            return false\r\n        end\r\n        if not getgenv().IsSelfAdmin and getgenv().IsAdmin(object:GetAttribute(\"BuiltBy\")) then\r\n            return false\r\n        end\r\n\r\n        local myChar = _LocalPlayer.Character\r\n        local hrp = myChar and myChar:FindFirstChild(\"HumanoidRootPart\")\r\n        if not hrp then return false end\r\n\r\n        local objPos = object:GetPivot().Position\r\n        local dist = (hrp.Position - objPos).Magnitude\r\n        -- Jarak server maksimal untuk pickup adalah ~15-18 stud. Jika lebih jauh, skip langsung tanpa sentuh Parent agar tidak flicker!\r\n        if dist > 18 then\r\n            return false\r\n        end\r\n        \r\n        -- Require the Hammer to be manually equipped.\r\n        if not isHammerEquipped() then\r\n            return false, \"no_hammer\"\r\n        end\r\n\r\n\r\n        local prePivot = object:GetPivot()\r\n        local preBoxCF, preSize\r\n        pcall(function()\r\n            preBoxCF, preSize = object:GetBoundingBox()\r\n        end)\r\n\r\n        local tempStorage = _ReplicatedStorage:FindFirstChild(\"TempStorage\")\r\n        local oldParent = object.Parent\r\n\r\n        -- Sembunyikan secara responsif di client seperti tool hammer resmi game\r\n        if tempStorage then\r\n            pcall(function() object.Parent = tempStorage end)\r\n        end\r\n\r\n        \r\n        -- Stop pickup if the Hammer was unequipped.\r\n        if not isHammerEquipped() then\r\n            pcall(function()\r\n                if object and tempStorage and object.Parent == tempStorage then\r\n                    object.Parent = oldParent\r\n                end\r\n            end)\r\n\r\n            return false, \"no_hammer\"\r\n        end\r\n\r\n\r\n        local success, result = false, nil\r\n        pcall(function()\r\n            if object:HasTag(\"FoliageNearFire\") and (oldParent == workspace:FindFirstChild(\"Map\") and oldParent:FindFirstChild(\"Foliage\")) then\r\n                local destroyRemote = (Client and Client.Events and Client.Events.RequestDestroyFoliage)\r\n                    or (_ReplicatedStorage:FindFirstChild(\"RemoteEvents\") and _ReplicatedStorage.RemoteEvents:FindFirstChild(\"RequestDestroyFoliage\"))\r\n                if destroyRemote then\r\n                    result = destroyRemote:InvokeServer(object)\r\n                    success = true\r\n                end\r\n            else\r\n                local remotePickup = (Client and Client.Events and Client.Events.RequestPickUpStructure)\r\n                    or (_ReplicatedStorage:FindFirstChild(\"RemoteEvents\") and _ReplicatedStorage.RemoteEvents:FindFirstChild(\"RequestPickUpStructure\"))\r\n                if remotePickup then\r\n                    result = remotePickup:InvokeServer(object)\r\n                    success = true\r\n                end\r\n            end\r\n        end)\r\n\r\n        local isSuccess = false\r\n        if success then\r\n            if result == true then\r\n                isSuccess = true\r\n            elseif type(result) == \"table\" and (result.Success == true or result.success == true) then\r\n                isSuccess = true\r\n            elseif not object or not object.Parent or object:GetAttribute(\"Destroyed\") ~= nil then\r\n                isSuccess = true\r\n            end\r\n        end\r\n\r\n        if isSuccess then\r\n            pcall(function()\r\n                if Client and Client.Sound and Client.Sound.Play then\r\n                    Client.Sound.Play(\"HammerBreak\")\r\n                end\r\n            end)\r\n            if prePivot then\r\n                local hOffset = preSize and (preSize.Y / 2) or 0\r\n                table.insert(getgenv().RevertPickupMemory, {Name = object.Name, CFrame = prePivot, HeightOffset = hOffset, BoxCF = preBoxCF, BoxSize = preSize})\r\n            end\r\n            return true\r\n        else\r\n            -- Jika server menolak, kembalikan ke workspace dan pasang debounce agar tidak flicker terus-menerus\r\n            pcall(function()\r\n                if object and tempStorage and object.Parent == tempStorage then\r\n                    object.Parent = oldParent\r\n                end\r\n            end)\r\n            failedPickupDebounce[object] = now + 1.5\r\n            return false\r\n        end\r\n    end\r\n\r\n    local function instantPickupByBlueprint(blueprintName, filterFunction)\r\n        if not blueprintName or blueprintName:gsub(\"%s+\", \"\") == \"\" then\r\n            WindUI:Notify({\r\n                Title = \"Pickup Failed\",\r\n                Content = \"Please enter a blueprint name.\",\r\n                Duration = 3\r\n            })\r\n            return\r\n        end\r\n        \r\n        if not isHammerEquipped() then\r\n            WindUI:Notify({\r\n                Title = \"Hammer Required\",\r\n                Content = \"Please equip your Hammer manually before picking up structures.\",\r\n                Duration = 4,\r\n                Icon = \"hammer\"\r\n            })\r\n            return\r\n        end\r\n\r\n\r\n        local candidateNames = getStructureCandidateNames(blueprintName)\r\n        local candidateLookup = {}\r\n        for _, c in ipairs(candidateNames) do\r\n            candidateLookup[string.lower(c)] = true\r\n        end\r\n        local targets = {}\r\n        local seen = {}\r\n\r\n        local function addCandidate(obj)\r\n            if obj and not seen[obj] and obj:IsDescendantOf(workspace) and not obj:GetAttribute(\"Driver\") and candidateLookup[string.lower(obj.Name)] then\r\n                if obj:HasTag(\"Turret\") and obj:GetAttribute(\"Owner\") ~= _LocalPlayer.UserId then\r\n                    return\r\n                end\r\n                if not getgenv().IsSelfAdmin and getgenv().IsAdmin(obj:GetAttribute(\"BuiltBy\")) then\r\n                    if not getgenv().AdminNotifyDebounce then\r\n                        getgenv().AdminNotifyDebounce = true\r\n                        if WindUI then WindUI:Notify({Title=\"Admin Protection\", Content=\"YOU CAN'T PICK UP ADMIN STRUCTURES!\", Duration=30}) end\r\n                        task.delay(30, function() getgenv().AdminNotifyDebounce = false end)\r\n                    end\r\n                    return\r\n                end\r\n                seen[obj] = true\r\n                table.insert(targets, obj)\r\n            end\r\n        end\r\n\r\n        local allStructures = game:GetService(\"CollectionService\"):GetTagged(\"CanBePickedUp\")\r\n        for _, structure in ipairs(allStructures) do\r\n            addCandidate(structure)\r\n        end\r\n\r\n        local structuresFolder = workspace:FindFirstChild(\"Structures\")\r\n        if structuresFolder then\r\n            for _, structure in ipairs(structuresFolder:GetChildren()) do\r\n                addCandidate(structure)\r\n            end\r\n        end\r\n\r\n        local deployablesFolder = workspace:FindFirstChild(\"Deployables\")\r\n        if deployablesFolder then\r\n            for _, structure in ipairs(deployablesFolder:GetChildren()) do\r\n                addCandidate(structure)\r\n            end\r\n        end\r\n\r\n        if #targets == 0 then\r\n            WindUI:Notify({\r\n                Title = \"Pickup\",\r\n                Content = \"No '\" .. blueprintName .. \"' found in workspace.\",\r\n                Duration = 3\r\n            })\r\n            return\r\n        end\r\n\r\n        local hrp = _LocalPlayer.Character and _LocalPlayer.Character:FindFirstChild(\"HumanoidRootPart\")\r\n        if hrp then\r\n            table.sort(targets, function(a, b)\r\n                return (hrp.Position - a:GetPivot().Position).Magnitude < (hrp.Position - b:GetPivot().Position).Magnitude\r\n            end)\r\n        end\r\n\r\n        WindUI:Notify({\r\n            Title = \"Pickup\",\r\n            Content = \"Found \" .. #targets .. \" \" .. blueprintName .. \". Picking up nearby...\",\r\n            Duration = 3\r\n        })\r\n\r\n        task.spawn(function()\r\n            local pickedUp = 0\r\n            local failed = 0\r\n            local tooFar = 0\r\n\r\n            for _, structure in ipairs(targets) do\r\n                if not structure or not structure.Parent then continue end\r\n\r\n                local dist = hrp and (hrp.Position - structure:GetPivot().Position).Magnitude or 999\r\n                if dist > 18 then\r\n                    tooFar = tooFar + 1\r\n                    continue\r\n                end\r\n\r\n                local ok = pickupSingleStructure(structure)\r\n                if ok then\r\n                    pickedUp = pickedUp + 1\r\n                    task.wait(0.04)\r\n                else\r\n                    failed = failed + 1\r\n                end\r\n            end\r\n\r\n            local resultText = \"Picked up: \" .. pickedUp\r\n            if tooFar > 0 then\r\n                resultText = resultText .. \" | Too far (>18s): \" .. tooFar\r\n            end\r\n            if failed > 0 then\r\n                resultText = resultText .. \" | Failed: \" .. failed\r\n            end\r\n\r\n            WindUI:Notify({\r\n                Title = \"Pickup Result\",\r\n                Content = resultText,\r\n                Duration = 4\r\n            })\r\n        end)\r\n    end\r\n\r\n\r\n    -- =========================================================\r\n    -- START BUILDING\r\n    -- =========================================================\r\n    startBuildingFunc = function()\r\n        if isBuilding then\r\n            isBuilding = false\r\n            Config.buildRunId = (Config.buildRunId or 0) + 1\r\n            WindUI:Notify({\r\n                Title=\"Builder\",\r\n                Content=\"Stopping build...\",\r\n                Duration=2\r\n            })\r\n            return\r\n        end\r\n        local remote = findRemote()\r\n        if not remote then \r\n            WindUI:Notify({\r\n                Title=\"Error\",\r\n                Content=\"Remote not found!\",\r\n                Duration=3\r\n            }) \r\n            return \r\n        end\r\n        if not findBlueprintTool() then\r\n            WindUI:Notify({\r\n                Title=\"Blueprint Required\",\r\n                Content=\"You do not own this blueprint yet. Preview remains available; building has been skipped.\",\r\n                Duration=4\r\n            })\r\n            return\r\n        end\r\n        Config.buildRunId = (Config.buildRunId or 0) + 1\r\n        local runId = Config.buildRunId\r\n        isBuilding = true\r\n        WindUI:Notify({\r\n            Title=\"Builder\",\r\n            Content=\"Building started...\",\r\n            Duration=3\r\n        })\r\n        local geoms = generatePositions()\r\n        local buildGeoms = {}\r\n        for i, geom in ipairs(geoms) do\r\n            buildGeoms[i] = geom\r\n        end\r\n        -- =========================================================\r\n        -- BUILD SIDE / BUILD ORDER\r\n        -- =========================================================\r\n        local center = getCenterPos()\r\n        local leftGeoms = {}\r\n        local rightGeoms = {}\r\n        local centerGeoms = {}\r\n        for _, geom in ipairs(buildGeoms) do\r\n            if geom and geom.Position then\r\n                if geom.Position.X < center.X then\r\n                    table.insert(leftGeoms, geom)\r\n                elseif geom.Position.X > center.X then\r\n                    table.insert(rightGeoms, geom)\r\n                else\r\n                    table.insert(centerGeoms, geom)\r\n                end\r\n            end\r\n        end\r\n        if Config.buildOrder == \"Left Half Only\" then\r\n            buildGeoms = {}\r\n            for _, geom in ipairs(leftGeoms) do\r\n                table.insert(buildGeoms, geom)\r\n            end\r\n        elseif Config.buildOrder == \"Right Half Only\" then\r\n            buildGeoms = {}\r\n            for _, geom in ipairs(rightGeoms) do\r\n                table.insert(buildGeoms, geom)\r\n            end\r\n        elseif Config.buildOrder == \"Left Half -> Right Half\" then\r\n            buildGeoms = {}\r\n            for _, geom in ipairs(leftGeoms) do\r\n                table.insert(buildGeoms, geom)\r\n            end\r\n            for _, geom in ipairs(centerGeoms) do\r\n                table.insert(buildGeoms, geom)\r\n            end\r\n            for _, geom in ipairs(rightGeoms) do\r\n                table.insert(buildGeoms, geom)\r\n            end\r\n        elseif Config.buildOrder == \"Right Half -> Left Half\" then\r\n            buildGeoms = {}\r\n            for _, geom in ipairs(rightGeoms) do\r\n                table.insert(buildGeoms, geom)\r\n            end\r\n            for _, geom in ipairs(centerGeoms) do\r\n                table.insert(buildGeoms, geom)\r\n            end\r\n            for _, geom in ipairs(leftGeoms) do\r\n                table.insert(buildGeoms, geom)\r\n            end\r\n        end\r\n        local session = getOrCreateBuilderSession(geoms)\r\n        -- =========================================================\r\n        -- REGISTER POSISI UNIVERSAL BUILDER\r\n        -- =========================================================\r\n        _G.UniversalBuilderProtectedPositions = {}\r\n        for _, geom in ipairs(geoms) do\r\n            if geom and geom.Position then\r\n                table.insert(\r\n                    _G.UniversalBuilderProtectedPositions,\r\n                    geom.Position\r\n                )\r\n            end\r\n        end\r\n        if session and session.Geoms then\r\n            for _, geom in ipairs(session.Geoms) do\r\n                if geom and geom.Position then\r\n                    table.insert(\r\n                        _G.UniversalBuilderProtectedPositions,\r\n                        geom.Position\r\n                    )\r\n                end\r\n            end\r\n        end\r\n        -- =========================================================\r\n        -- CREATE / LOAD SESSION\r\n        -- =========================================================\r\n        if not session then\r\n            isBuilding = false\r\n            WindUI:Notify({\r\n                Title=\"Builder Error\",\r\n                Content=\"Unable to create build session!\",\r\n                Duration=4\r\n            })\r\n            return\r\n        end\r\n        loadSessionMemory(session)\r\n        _G.LastBuilderGeoms = session.Geoms\r\n        _G.ActiveBuilderSession = session\r\n        _G.LastBuilderSession = session\r\n        _G.LastBuilderSessionKey = getBuilderSessionKey(geoms)\r\n        task.spawn(function()\r\n            local bSuccess, bErr = pcall(function()\r\n                local built = 0\r\n                local skipped = 0\r\n                local tmpl = getTemplateModel()\r\n                local yOffset = 2.5\r\n                if tmpl then\r\n                    if tmpl:GetAttribute(\"StructureHeightOffset\") then\r\n                        yOffset = tmpl:GetAttribute(\"StructureHeightOffset\")\r\n                    elseif tmpl:IsA(\"Model\") then\r\n                        local cframe, size = tmpl:GetBoundingBox()\r\n                        local bottomY = cframe.Position.Y - (size.Y / 2)\r\n                        local primaryY = tmpl.PrimaryPart and tmpl.PrimaryPart.Position.Y or cframe.Position.Y\r\n                        yOffset = primaryY - bottomY\r\n                    else\r\n                        yOffset = (tmpl.Size and tmpl.Size.Y / 2) or 2.5\r\n                    end\r\n                end\r\n                session.TargetBlueprint = tostring(Config.targetBlueprint or \"\")\r\n                session.YOffset = yOffset\r\n                local outOfBlueprints = false\r\n                for i = 1, #buildGeoms do\r\n                    if not isBuilding or runId ~= Config.buildRunId then break end\r\n                    local geom = buildGeoms[i]\r\n                    if checkOccupied(geom.Position, yOffset) then\r\n                        saveBuiltPosition(session, geom.Position)\r\n                        skipped = skipped + 1\r\n                        continue\r\n                    end\r\n                    local bp = findBlueprin