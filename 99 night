        local interaction = item:GetAttribute(\"Interaction\")\r\n                        local hasDeadMarker = item:GetAttribute(\"Dead\") == true\r\n                            or item:GetAttribute(\"Died\") == true\r\n                            or item:GetAttribute(\"IsDead\") == true\r\n                        local hasDeadHumanoid = false\r\n                        if item:IsA(\"Model\") then\r\n                            local humanoid = item:FindFirstChildOfClass(\"Humanoid\")\r\n                            hasDeadHumanoid = humanoid ~= nil and humanoid.Health <= 0\r\n                        end\r\n                        local isEnemyCorpse = interaction ~= nil and isEnemy(itemName)\r\n                        local isBodyModel = string.find(lowerItemName, \"body\", 1, true) ~= nil\r\n                            and interaction ~= nil\r\n                        if isCultist or hasDeadMarker or hasDeadHumanoid or isEnemyCorpse or isBodyModel then\r\n                            continue\r\n                        end\r\n                        \r\n                        -- Exclude sampah item (Rifle, Ammo, Senter, Dynamite, Crystal Skull Key, Cake) agar tidak menumpuk di Campfire\r\n                        if string.find(itemName, \"Rifle\") or itemName == \"Old Flashlight\" or string.find(itemName, \"Dynamite\") or string.find(itemName, \"Crystal Skull Key\") or string.find(itemName, \"Cake\") then\r\n                            continue\r\n                        end\r\n                        \r\n                        local pivotCFrame\r\n                        if item:IsA(\"Tool\") then\r\n                            local handle = item:FindFirstChild(\"Handle\") or item:FindFirstChildWhichIsA(\"BasePart\", true)\r\n                            if handle then pivotCFrame = handle.CFrame else continue end\r\n                        else\r\n                            pivotCFrame = item:GetPivot()\r\n                        end\r\n                        local pivot = pivotCFrame\r\n                        \r\n                        -- Skip items near Jungle Structures\r\n                        local nearJungle = false\r\n                        for _, pos in ipairs(jungleLandmarks) do\r\n                            local dx = pivot.Position.X - pos.X\r\n                            local dz = pivot.Position.Z - pos.Z\r\n                            if math.sqrt(dx*dx + dz*dz) < 250 then\r\n                                nearJungle = true\r\n                                break\r\n                            end\r\n                        end\r\n                        if nearJungle then continue end\r\n                        \r\n                        -- PENGECUALIAN THE HOLLOW: Jangan tarik item di The Hollow ke Campfire\r\n                        local hollowMap = _Workspace:FindFirstChild(\"HollowMap\")\r\n                        if hollowMap then\r\n                            local boundary = hollowMap:FindFirstChild(\"HollowBoundary\")\r\n                            local hasBoundary = boundary and boundary:FindFirstChildWhichIsA(\"BasePart\") ~= nil\r\n                            if (hasBoundary or pivot.Position.Z > 5000) and pivot.Position.Y < -50 then\r\n                                continue\r\n                            end\r\n                        end\r\n\r\n                        -- Jika Y berada di bawah zona aman (Gua/Void) ATAU mode Auto Chest sedang aktif (sapu bersih seluruh ketinggian map)\r\n                        if pivot.Position.Y < ITEM_VOID_Y or _G.AutoChestAntiVoidMode then\r\n                            -- JIKA ITEM SUDAH BERADA DI SEKITAR CAMPFIRE (radius 35 studs & ketinggian normal), JANGAN TARIK LAGI!\r\n                            local distToCampfire = (Vector3.new(pivot.Position.X, 0, pivot.Position.Z) - Vector3.new(campfirePos.X, 0, campfirePos.Z)).Magnitude\r\n                            if distToCampfire < 35 and pivot.Position.Y > (campfirePos.Y - 20) then\r\n                                continue\r\n                            end\r\n                            \r\n                            -- PENGECUALIAN SAFE ZONE: Jangan tarik item yang sedang ditampung oleh Auto Chest lama di Safe Zone (-50 studs)\r\n                            -- KECUALI jika kita sedang dalam mode Auto Chest baru (yang butuh ditarik)\r\n                            if not _G.AutoChestAntiVoidMode and math.abs(pivot.Position.Y - (campfirePos.Y - 48)) < 6 then\r\n                                continue\r\n                            end\r\n                            \r\n                            local yPos = 2.5\r\n                            if string.find(itemName, \"Grenade\") then yPos = 1.5 end\r\n                            local rescuePos = Vector3.new(campfirePos.X + math.random(-15, 15), yPos, campfirePos.Z + math.random(-15, 15))\r\n                            \r\n                            -- Langsung selamatkan (Instant Rescue) seperti versi lama\r\n                            task.spawn(function()\r\n                                dragItemSmooth(item, rescuePos)\r\n                            end)\r\n                        end\r\n                    end\r\n                end\r\n            end)\r\n        end\r\n    end)\r\n    \r\n    local origCleanup2 = getgenv().KixHubCleanup\r\n    getgenv().KixHubCleanup = function()\r\n        antiVoidItemsLoop = false\r\n        if origCleanup2 then origCleanup2() end\r\n    end\r\nend)() end\r\n\r\n-- ==================== ANTI VOID SENSOR (STRUCTURES) ====================\r\n-- Menjaga semua structure di workspace.Structures agar tidak jatuh ke void.\r\ndo (function()\r\n    _G.AntiVoidStructuresEnabled =\r\n        _G.AntiVoidStructuresEnabled == nil\r\n        and false\r\n        or _G.AntiVoidStructuresEnabled\r\n\r\n    local STRUCTURE_VOID_Y = campfirePos.Y - 30\r\n\r\n    local antiVoidStructuresLoop = true\r\n\r\n    task.spawn(function()\r\n        while KixHubSession.Alive and task.wait(0.5) do\r\n                            if not _G.AntiVoidStructuresEnabled\r\n                or not antiVoidStructuresLoop\r\n            then\r\n                continue\r\n            end\r\n\r\n            pcall(function()\r\n\r\n                local structures =\r\n                    workspace:FindFirstChild(\"Structures\")\r\n\r\n                if not structures then\r\n                    return\r\n                end\r\n\r\n                for _, structure in ipairs(structures:GetChildren()) do\r\n\r\n                    if not structure\r\n                        or not structure.Parent\r\n                    then\r\n                        continue\r\n                    end\r\n\r\n                    -- Jangan rescue structure yang sengaja dipindahkan oleh Bring All\r\n                    if _G.AntiVoidIgnoreStructures\r\n                        and _G.AntiVoidIgnoreStructures[structure]\r\n                    then\r\n                        continue\r\n                    end\r\n\r\n                    if not (\r\n                        structure:IsA(\"Model\")\r\n                        or structure:IsA(\"BasePart\")\r\n                    ) then\r\n                        continue\r\n                    end\r\n\r\n                    local pivotCFrame\r\n\r\n                    pcall(function()\r\n                        pivotCFrame = structure:GetPivot()\r\n                    end)\r\n\r\n                    if not pivotCFrame then\r\n                        continue\r\n                    end\r\n\r\n                    local position = pivotCFrame.Position\r\n\r\n                    -- PENGECUALIAN THE HOLLOW: Jangan rescue structure yang berada di The Hollow\r\n                    local hollowMap = _Workspace:FindFirstChild(\"HollowMap\")\r\n                    if hollowMap then\r\n                        local boundary = hollowMap:FindFirstChild(\"HollowBoundary\")\r\n                        local hasBoundary = boundary and boundary:FindFirstChildWhichIsA(\"BasePart\") ~= nil\r\n                        if (hasBoundary or position.Z > 5000) and position.Y < -50 then\r\n                            continue\r\n                        end\r\n                    end\r\n\r\n                    -- Structure sudah berada di bawah batas void\r\n                    if position.Y < STRUCTURE_VOID_Y then\r\n\r\n                        -- =========================================\r\n                        -- RESCUE STRUCTURE\r\n                        -- =========================================\r\n\r\n                        local rescuePosition =\r\n                            Vector3.new(\r\n                                campfirePos.X,\r\n                                campfirePos.Y + 3,\r\n                                campfirePos.Z\r\n                            )\r\n\r\n                        pcall(function()\r\n\r\n                            if structure:IsA(\"Model\") then\r\n                                structure:PivotTo(\r\n                                    CFrame.new(rescuePosition)\r\n                                )\r\n                            elseif structure:IsA(\"BasePart\") then\r\n                                structure.CFrame =\r\n                                    CFrame.new(rescuePosition)\r\n                            end\r\n\r\n                        end)\r\n                    end\r\n                end\r\n            end)\r\n        end\r\n    end)\r\n\r\n    local previousCleanup =\r\n        getgenv().KixHubCleanup\r\n\r\n    getgenv().KixHubCleanup = function()\r\n\r\n        antiVoidStructuresLoop = false\r\n\r\n        if previousCleanup then\r\n            previousCleanup()\r\n        end\r\n\r\n    end\r\nend)() end\r\n\r\n-- FULL AUTOMATION V2: direct engines, cancellable checkpoints, bounded jobs.\r\n-- Embedded in the hub by apply_fullauto_v2.py; not a separate runtime dependency.\r\ndo (function()\r\n    local F = {\r\n        Active = false, IsPaused = false, State = \"IDLE\", Stage = 1,\r\n        RunToken = 0, Owned = {}, Jobs = {}, Connections = {},\r\n        Results = {}, MapRevealSkipActive = false, FuelBatchSize = 8,\r\n        ChestMonitorStarted = false, ChestMonitorDone = false, PreparationReadyForChest = false,\r\n        StopAfterChestLoot = false, ManualChestCompleted = false, StartPending = false,\r\n        FuelConcurrency = 4, FuelPending = 0, Status = \"Ready\",\r\n        Adapters = _G.KixAdapters, Engines = _G.KixEngines,\r\n        ToggleRefs = {\r\n            InstantInteract = InstantInteractToggle,\r\n            SemiGodMode = _G.SemiGodModeToggle,\r\n            AutoBuy = AutoBuyCraftingBenchToggle,\r\n            AutoStructure = AutoStructurePlacementToggle,\r\n            AutoBiofuel = _G.KixStartupFeatures.Toggles.AutoBiofuel,\r\n            AutoCookCrockPot = _G.KixStartupFeatures.Toggles.AutoCookCrockPot,\r\n            AutoEat = _G.AutoEatToggle,\r\n            AutoPickStew = _G.KixStartupFeatures.Toggles.AutoPickStew,\r\n            AutoSkipNight = _G.AutoSkipNightToggle,\r\n            AutoWeatherMachine = _G.AutoWeatherMachineToggle,\r\n            AutoRecycler = _G.AutoRecyclerToggle,\r\n            AutoScrap = AutoScrapToggle,\r\n            AutoStronghold = _G.AutoStrongholdToggle,\r\n            AutoChopTrees = _G.AutoChopTreesToggle,\r\n            AutoKillCultist = _G.AutoKillCultistToggle,\r\n            AutoFarmCorrupted = _G.AutoFarmCorruptedToggle,\r\n            AutoSacrifice = _G.AutoSacrificeToggle,\r\n            AutoSpawnCultistKing = _G.AutoSpawnCultistKingToggle,\r\n            AutoReviveOthers = _G.KixStartupFeatures.Toggles.AutoReviveOthers,\r\n            AutoBringDeadBodies = _G.KixStartupFeatures.Toggles.AutoBringDeadBodies,\r\n            AutoStoreCostumesToCloset = _G.KixStartupFeatures.Toggles.AutoStoreCostumesToCloset,\r\n            AutoCompleteCrystalSkullKey = _G.KixStartupFeatures.Toggles.AutoCompleteCrystalSkullKey,\r\n            AutoBefriendKids = _G.KixStartupFeatures.Toggles.AutoBefriendKids,\r\n        },\r\n    }\r\n    _G.KixFullAuto = F\r\n\r\n    function F.SetStatus(state, detail)\r\n        if F.State ~= state then _G.KixPerfDebug.Event(\"STAGE\", tostring(F.Stage) .. \" \" .. state .. \" | \" .. tostring(detail)) end\r\n        F.State, F.Status = state, detail\r\n        local text = state .. \" | \" .. detail\r\n        if text ~= F.LastText then\r\n            F.LastText = text\r\n            -- Keep internal status/progress tracking without a visible paragraph.\r\n        end\r\n        pcall(function()\r\n            local progress = string.format(\"Fire: %s/6 | Kids: %d/4 | Reveal: %s | Chest: %s | Gems: %s\",\r\n                tostring(F.Adapters.UpgradeFire.GetLevel()), F.TentCount(),\r\n                F.Results.Reveal and \"Done\" or \"Pending\",\r\n                F.Results.Chest and \"Done\" or \"Pending\",\r\n                F.Results.Gems and \"Delivered\" or \"Pending\")\r\n            if progress ~= F.LastProgress then\r\n                F.LastProgress = progress\r\n                -- Keep computed progress internally without a visible paragraph.\r\n            end\r\n        end)\r\n    end\r\n\r\n    function F.Valid(token)\r\n        return F.Active and F.RunToken == token\r\n    end\r\n\r\n    function F.IsSkipped(activity)\r\n        return _G.KixFullAutomationSkipActivities\r\n            and _G.KixFullAutomationSkipActivities[activity] == true\r\n    end\r\n\r\n    function F.StopForSkip(name, restoreKey)\r\n        local adapter = F.Adapters[name]\r\n        if F.Owned[name] then\r\n            F[restoreKey] = \"Owned\"\r\n            F.StopOwned(name)\r\n        elseif adapter and adapter.IsEnabled and adapter.IsEnabled() then\r\n            F[restoreKey] = \"Manual\"\r\n            pcall(F.Engines[name], false)\r\n            F.SyncToggle(name, false)\r\n        end\r\n    end\r\n\r\n    function F.RestoreSkippedEngine(name, restoreKey, resumeOwned)\r\n        local restore = F[restoreKey]\r\n        F[restoreKey] = nil\r\n        if restore == \"Manual\" then\r\n            local adapter = F.Adapters[name]\r\n            if adapter and adapter.IsEnabled and not adapter.IsEnabled() then\r\n                pcall(F.Engines[name], true)\r\n                F.SyncToggle(name, true)\r\n            end\r\n        elseif restore == \"Owned\" and resumeOwned and F.Active and not F.IsPaused then\r\n            pcall(F.Ensure, name)\r\n        end\r\n    end\r\n\r\n    function F.StopRevealForSkip()\r\n        F.Owned.AutoReveal = nil\r\n        if AutoMapReveal and AutoMapReveal.State.IsScanning\r\n            and not F.MapRevealStopPending then\r\n            F.MapRevealStopPending = true\r\n            local stopToken = F.RunToken\r\n            AutoMapReveal.StopScan()\r\n            task.delay(1.25, function()\r\n                if F.RunToken == stopToken then F.MapRevealStopPending = false end\r\n            end)\r\n        end\r\n    end\r\n\r\n    function F.ShouldSkipStructure(name)\r\n        if name == \"Temporal Accelerometer\" then\r\n            return F.IsSkipped(\"Auto Skip Nights\")\r\n        elseif name == \"Weather Machine\" then\r\n            return F.IsSkipped(\"Weather Machine\")\r\n        end\r\n        return false\r\n    end\r\n\r\n    function F.ApplySkipSelection()\r\n        if not F.Active then return end\r\n\r\n        if F.IsSkipped(\"Map Reveal\") then\r\n            F.MapRevealSkipActive = true\r\n            F.Results.Reveal = true\r\n            F.StopRevealForSkip()\r\n        elseif F.MapRevealSkipActive then\r\n            F.MapRevealSkipActive = false\r\n            F.Results.Reveal = F.Adapters.AutoReveal.IsCompleted() == true\r\n            if F.Active and F.Stage == 1 and not F.Results.Reveal\r\n                and not F.Adapters.AutoReveal.IsScanning()\r\n                and not F.Adapters.AutoReveal.IsCompleting()\r\n                and not F.Adapters.AutoReveal.IsPausedForRescue()\r\n                and not F.MapRevealStopPending then\r\n                F.Owned.AutoReveal = true\r\n                F.Adapters.AutoReveal.Start()\r\n            end\r\n        end\r\n\r\n        if F.IsSkipped(\"Rescue Kids\") then\r\n            F.StopForSkip(\"AutoRescue\", \"SkipRescueRestore\")\r\n            F.StopForSkip(\"AutoBefriendKids\", \"SkipBefriendRestore\")\r\n            F.StructureFeatureTriggered.AutoBefriendKids = nil\r\n            if AutoMapReveal.State.IsPausedForRescue and not _G.KixRescueBusy and not F.Results.Reveal then\r\n                pcall(AutoMapReveal.ResumeAfterRescue)\r\n            end\r\n        else\r\n            F.RestoreSkippedEngine(\"AutoRescue\", \"SkipRescueRestore\", F.Stage == 1)\r\n            F.RestoreSkippedEngine(\"AutoBefriendKids\", \"SkipBefriendRestore\", false)\r\n            if not F.StopAfterChestLoot and F.Stage == 1 then\r\n                pcall(F.Ensure, \"AutoRescue\")\r\n            end\r\n            F.StructureFeatureTriggered.AutoBefriendKids = nil\r\n        end\r\n\r\n        if F.IsSkipped(\"Auto Skip Nights\") then\r\n            F.StopForSkip(\"AutoSkipNight\", \"SkipAutoSkipNightRestore\")\r\n            F.StructureFeatureTriggered.AutoSkipNight = nil\r\n        else\r\n            F.RestoreSkippedEngine(\"AutoSkipNight\", \"SkipAutoSkipNightRestore\", false)\r\n            F.StructureFeatureTriggered.AutoSkipNight = nil\r\n        end\r\n        if F.IsSkipped(\"Weather Machine\") then\r\n            F.StopForSkip(\"AutoWeatherMachine\", \"SkipWeatherMachineRestore\")\r\n            F.StructureFeatureTriggered.AutoWeatherMachine = nil\r\n        else\r\n            F.RestoreSkippedEngine(\"AutoWeatherMachine\", \"SkipWeatherMachineRestore\", false)\r\n            F.StructureFeatureTriggered.AutoWeatherMachine = nil\r\n        end\r\n\r\n        if F.IsSkipped(\"Auto Chop Tree\") then\r\n            F.StopForSkip(\"AutoChopTrees\", \"SkipAutoChopRestore\")\r\n            _G.KixAutoChopHold = false\r\n        else\r\n            F.RestoreSkippedEngine(\"AutoChopTrees\", \"SkipAutoChopRestore\",\r\n                F.Stage == 2 and not F.Results.Chop)\r\n        end\r\n\r\n        if F.IsSkipped(\"Auto Kill Cultist Global\") then\r\n            local cultistAdapter = F.Adapters.AutoKillCultist\r\n            if cultistAdapter and cultistAdapter.IsEnabled and cultistAdapter.IsEnabled() then\r\n                if F.Owned.AutoKillCultist then\r\n                    F.SkipCultistRestore = \"Owned\"\r\n                    F.StopOwned(\"AutoKillCultist\")\r\n                else\r\n                    F.SkipCultistRestore = \"Manual\"\r\n                    pcall(F.Engines.AutoKillCultist, false)\r\n                    F.SyncToggle(\"AutoKillCultist\", false)\r\n                end\r\n            end\r\n        else\r\n            local restoreCultist = F.SkipCultistRestore\r\n            F.SkipCultistRestore = nil\r\n            if restoreCultist == \"Manual\" then\r\n                pcall(F.Engines.AutoKillCultist, true)\r\n                F.SyncToggle(\"AutoKillCultist\", true)\r\n            elseif restoreCultist == \"Owned\" and F.Active and not F.IsPaused\r\n                and F.Stage == 3 and not F.Results.CultistVolcanoVisit then\r\n                pcall(F.Ensure, \"AutoKillCultist\")\r\n            end\r\n        end\r\n\r\n        if F.IsSkipped(\"Auto Sacrifice\") then\r\n            F.StopForSkip(\"AutoSacrifice\", \"SkipAutoSacrificeRestore\")\r\n        else\r\n            F.RestoreSkippedEngine(\"AutoSacrifice\", \"SkipAutoSacrificeRestore\",\r\n                F.Stage >= 3 and not F.Results.Preparation)\r\n        end\r\n\r\n        if F.IsSkipped(\"Auto Scrap\") then\r\n            local scrapAdapter = F.Adapters.AutoScrap\r\n            if scrapAdapter and scrapAdapter.IsEnabled and scrapAdapter.IsEnabled() then\r\n                if F.Owned.AutoScrap then\r\n                    F.SkipScrapRestore = \"Owned\"\r\n                    F.StopOwned(\"AutoScrap\")\r\n                else\r\n                    F.SkipScrapRestore = \"Manual\"\r\n                    pcall(F.Engines.AutoScrap, false)\r\n                    F.SyncToggle(\"AutoScrap\", false)\r\n                end\r\n            end\r\n        else\r\n            local restoreScrap = F.SkipScrapRestore\r\n            F.SkipScrapRestore = nil\r\n            if restoreScrap == \"Manual\" then\r\n                pcall(F.Engines.AutoScrap, true)\r\n                F.SyncToggle(\"AutoScrap\", true)\r\n            elseif F.Active and not F.IsPaused and F.Stage >= 3\r\n                and F.Results.CultistVolcanoVisit then\r\n                pcall(F.Ensure, \"AutoScrap\")\r\n            end\r\n        end\r\n\r\n        local reviveAdapter = F.Adapters.AutoReviveOthers\r\n        if F.IsSkipped(\"Revive Player\") then\r\n            if reviveAdapter and reviveAdapter.IsEnabled and reviveAdapter.IsEnabled() then\r\n                if F.Owned.AutoReviveOthers then\r\n                    F.SkipReviveRestore = \"Owned\"\r\n                    F.StopOwned(\"AutoReviveOthers\")\r\n                else\r\n                    F.SkipReviveRestore = \"Manual\"\r\n                    pcall(F.Engines.AutoReviveOthers, false)\r\n                    F.SyncToggle(\"AutoReviveOthers\", false)\r\n                end\r\n            end\r\n        else\r\n            local restore = F.SkipReviveRestore\r\n            F.SkipReviveRestore = nil\r\n            if restore == \"Manual\" then\r\n                pcall(F.Engines.AutoReviveOthers, true)\r\n                F.SyncToggle(\"AutoReviveOthers\", true)\r\n            elseif F.Active and not F.StopAfterChestLoot then\r\n                pcall(F.Ensure, \"AutoReviveOthers\")\r\n            end\r\n        end\r\n    end\r\n\r\n    function F.Wait(token, seconds)\r\n        local elapsed = 0\r\n        repeat\r\n            if not F.Valid(token) then return false end\r\n            if F.Jobs.GiantBedMemoryClear then\r\n                task.wait(0.1)\r\n            elseif not F.IsPaused then\r\n                if elapsed >= seconds then return true end\r\n                elapsed = elapsed + task.wait(math.min(0.1, seconds - elapsed))\r\n            else\r\n                task.wait(0.1)\r\n            end\r\n        until false\r\n    end\r\n\r\n    function F.HRP()\r\n        local char = _LocalPlayer.Character\r\n        return char and char:FindFirstChild(\"HumanoidRootPart\")\r\n    end\r\n\r\n    function F.SyncToggle(name, value)\r\n        local toggle = F.ToggleRefs[name]\r\n        if not toggle then return false end\r\n        local ok, err = pcall(function()\r\n            if type(toggle.Set) == \"function\" then\r\n                toggle:Set(value, false, true)\r\n            elseif type(toggle.SetValue) == \"function\" then\r\n                toggle:SetValue(value)\r\n            elseif type(toggle.SetState) == \"function\" then\r\n                toggle:SetState(value)\r\n            else\r\n                error(\"Toggle has no supported setter\")\r\n            end\r\n        end)\r\n        if not ok then warn(\"[FullAuto toggle sync \" .. name .. \"] \" .. tostring(err)) end\r\n        return ok\r\n    end\r\n\r\n    function F.SyncActiveToggles()\r\n        F.SyncToggle(\"InstantInteract\", InstantInteractEnabled == true)\r\n        for name in pairs(F.ToggleRefs) do\r\n            if name ~= \"InstantInteract\" then\r\n                local adapter = F.Adapters[name]\r\n                local enabled = adapter and type(adapter.IsEnabled) == \"function\" and adapter.IsEnabled()\r\n                if enabled == nil then enabled = _G.KixStartupFeatures.States[name] end\r\n                if enabled ~= nil then F.SyncToggle(name, enabled == true) end\r\n            end\r\n        end\r\n    end\r\n\r\n    function F.Ensure(name)\r\n        local adapter = F.Adapters[name]\r\n        assert(adapter and type(adapter.IsEnabled) == \"function\", \"Missing engine state: \" .. name)\r\n        if adapter.IsEnabled() == true then\r\n            -- A manually enabled worker already has an owner. Leave both its\r\n            -- worker and UI toggle untouched instead of replaying its callback.\r\n            return false\r\n        end\r\n\r\n        F.Engines.Errors[name] = nil\r\n        F.Owned[name] = true\r\n        assert(type(F.Engines[name]) == \"function\", \"Missing engine: \" .. name)\r\n        F.Engines[name](true)\r\n        assert(adapter.IsEnabled(), \"Engine did not start: \" .. name)\r\n        F.SyncToggle(name, true)\r\n        return true\r\n    end\r\n\r\n    function F.WatchPlacedStructureFeatures(token)\r\n        if F.StructureFeatureWatchToken == token then return end\r\n        F.StructureFeatureWatchToken = token\r\n        F.StructureFeatureTriggered = {}\r\n        task.spawn(function()\r\n            local targets = {\r\n                {Structure = \"Temporal Accelerometer\", Feature = \"AutoSkipNight\"},\r\n                {Structure = \"Weather Machine\", Feature = \"AutoWeatherMachine\"},\r\n                {Structure = \"Recycler\", Feature = \"AutoRecycler\"},\r\n                {Structure = \"Giant Bed\", Feature = \"AutoBefriendKids\"},\r\n            }\r\n            while F.Valid(token) do\r\n                local structures = workspace:FindFirstChild(\"Structures\")\r\n                if structures then\r\n                    for _, target in ipairs(targets) do\r\n                        if not F.Valid(token) then break end\r\n                        local adapter = F.Adapters[target.Feature]\r\n                        local featureSkipped = (target.Feature == \"AutoSkipNight\" and F.IsSkipped(\"Auto Skip Nights\"))\r\n                            or (target.Feature == \"AutoWeatherMachine\" and F.IsSkipped(\"Weather Machine\"))\r\n                            or (target.Feature == \"AutoBefriendKids\" and F.IsSkipped(\"Rescue Kids\"))\r\n                        if not featureSkipped\r\n                            and not F.StructureFeatureTriggered[target.Feature]\r\n                            and structures:FindFirstChild(target.Structure)\r\n                            and adapter and type(adapter.IsEnabled) == \"function\" then\r\n                            local ok, err = pcall(F.Ensure, target.Feature)\r\n                            if ok then\r\n                                F.StructureFeatureTriggered[target.Feature] = true\r\n                                _G.KixPerfDebug.Event(\"STRUCTURE_WORKER\", target.Structure .. \" -> \" .. target.Feature)\r\n                            else\r\n                                warn(\"[FullAuto structure worker \" .. target.Feature .. \"] \" .. tostring(err))\r\n                            end\r\n                        end\r\n                    end\r\n                end\r\n                task.wait(1)\r\n            end\r\n            if F.StructureFeatureWatchToken == token then\r\n                F.StructureFeatureWatchToken = nil\r\n            end\r\n        end)\r\n    end\r\n\r\n    function F.StopOwned(name)\r\n        if F.Owned[name] then\r\n            F.Owned[name] = nil\r\n            if name == \"AutoChopTrees\" then F.StoppingAutoChop = true end\r\n            local ok, err = pcall(F.Engines[name], false)\r\n            if not ok then warn(\"[FullAuto stop \" .. name .. \"] \" .. tostring(err)) end\r\n            F.SyncToggle(name, false)\r\n            if name == \"AutoChopTrees\" then F.StoppingAutoChop = false end\r\n        end\r\n    end\r\n\r\n    function F.SetChopStatus(text)\r\n        if _G.KixSetAutoChopStatus then _G.KixSetAutoChopStatus(text) end\r\n    end\r\n\r\n    function F.PickupInfernalSword(item, token)\r\n        if not F.Valid(token) or not item or item.Name ~= \"Infernal Sword\" then return end\r\n        if F.InfernalSwordPicked or F.InfernalSwordBusy or F.InfernalSwordSeen[item] then return end\r\n        if _G.KixIsLoggingCampItem and _G.KixIsLoggingCampItem(item) then return end\r\n        F.InfernalSwordSeen[item] = true\r\n\r\n        _G.TempEquippedCache = _G.TempEquippedCache or {}\r\n        if hasInventoryItem(\"Infernal Sword\") then\r\n            F.InfernalSwordPicked = true\r\n            _G.TempEquippedCache[\"Infernal Sword\"] = true\r\n            return\r\n        end\r\n\r\n        F.InfernalSwordBusy = item\r\n        local previousCache = _G.TempEquippedCache[\"Infernal Sword\"]\r\n        _G.TempEquippedCache[\"Infernal Sword\"] = true\r\n        task.spawn(function()\r\n            local picked = false\r\n            local hrp = F.HRP()\r\n            local remoteEvents = _ReplicatedStorage:FindFirstChild(\"RemoteEvents\")\r\n            local requestHotbarItem = remoteEvents and remoteEvents:FindFirstChild(\"RequestHotbarItem\")\r\n\r\n            if F.Valid(token) and hrp and item.Parent and requestHotbarItem then\r\n                pcall(function() dragItemSmooth(item, hrp.Position) end)\r\n                task.wait(0.1)\r\n                if hasInventoryItem(\"Infernal Sword\") then\r\n                    picked = true\r\n                elseif F.Valid(token) and item.Parent then\r\n                    local ok, result = pcall(function()\r\n                        if requestHotbarItem:IsA(\"RemoteFunction\") then\r\n                            return requestHotbarItem:InvokeServer(item)\r\n                        end\r\n                        requestHotbarItem:FireServer(item)\r\n                        return true\r\n                    end)\r\n                    picked = ok and ((type(result) == \"table\" and result.Success == true) or result == true)\r\n                end\r\n            end\r\n\r\n            task.wait(0.15)\r\n            if hasInventoryItem(\"Infernal Sword\") then picked = true end\r\n            if picked then\r\n                F.InfernalSwordPicked = true\r\n                _G.TempEquippedCache[\"Infernal Sword\"] = true\r\n            else\r\n                _G.TempEquippedCache[\"Infernal Sword\"] = previousCache\r\n            end\r\n            if F.InfernalSwordBusy == item then F.InfernalSwordBusy = nil end\r\n        end)\r\n    end\r\n\r\n    function F.WatchInfernalSword(token)\r\n        F.InfernalSwordSeen = F.InfernalSwordSeen or setmetatable({}, {__mode = \"k\"})\r\n        local function attachItemsFolder(folder)\r\n            if not folder or folder.Name ~= \"Items\" or F.InfernalSwordItemsFolder == folder then return end\r\n            if F.InfernalSwordItemsConnection then F.InfernalSwordItemsConnection:Disconnect() end\r\n            F.InfernalSwordItemsFolder = folder\r\n            F.InfernalSwordItemsConnection = folder.ChildAdded:Connect(function(item)\r\n                if item.Name == \"Infernal Sword\" and F.Active then\r\n                    F.PickupInfernalSword(item, F.RunToken)\r\n                end\r\n            end)\r\n            table.insert(F.Connections, F.InfernalSwordItemsConnection)\r\n        end\r\n\r\n        if not F.InfernalSwordWorkspaceConnection then\r\n            F.InfernalSwordWorkspaceConnection = workspace.ChildAdded:Connect(function(child)\r\n                if child.Name == \"Items\" then attachItemsFolder(child) end\r\n            end)\r\n            table.insert(F.Connections, F.InfernalSwordWorkspaceConnection)\r\n        end\r\n\r\n        local itemsFolder = workspace:FindFirstChild(\"Items\")\r\n        if itemsFolder then\r\n            attachItemsFolder(itemsFolder)\r\n            local sword = itemsFolder:FindFirstChild(\"Infernal Sword\")\r\n            if sword then F.PickupInfernalSword(sword, token) end\r\n        end\r\n    end\r\n\r\n    -- ONE-TIME CHOP TOOL PICKUP (before the first Auto Chop Trees window).\r\n    -- Search until a supported tool is owned; leave slot selection to the user.\r\n    function F.PickupChopToolOnce(token)\r\n        if not F.Valid(token) then return false end\r\n        if F.IsSkipped(\"Auto Chop Tree\") then return true end\r\n        _G.TempEquippedCache = _G.TempEquippedCache or {}\r\n\r\n        local chopToolNames = {\"Strong Axe\", \"Chainsaw\", \"Woodsman's Axe\"}\r\n        local chopToolIcons = {\r\n            [\"Strong Axe\"] = \"116_7367831688\",\r\n            [\"Chainsaw\"] = \"647_8992824875\",\r\n            [\"Woodsman's Axe\"] = \"116_7367831688\",\r\n        }\r\n\r\n        local function hotbarHasTool(name)\r\n            local playerGui = _LocalPlayer:FindFirstChild(\"PlayerGui\")\r\n            local interface = playerGui and playerGui:FindFirstChild(\"Interface\")\r\n            local hotbar = interface and interface:FindFirstChild(\"Hotbar\")\r\n            local button = hotbar and hotbar:FindFirstChild(\"Button\" .. name)\r\n            if not button then return false end\r\n\r\n            -- Use the exact button name as identity and check the mapped asset ID\r\n            -- when the GUI exposes its icon. Axe icon IDs may be shared.\r\n            local expected = chopToolIcons[name]\r\n            local assetId = expected and expected:match(\"_(%d+)$\")\r\n            if assetId then\r\n                for _, child in ipairs(button:GetDescendants()) do\r\n                    if (child:IsA(\"ImageLabel\") or child:IsA(\"ImageButton\"))\r\n                        and tostring(child.Image or \"\"):find(assetId, 1, true) then\r\n                        return true\r\n                    end\r\n                end\r\n            end\r\n            -- Some builds omit/update the image lazily; an exact named tool button\r\n            -- still confirms ownership as described by the Hotbar hierarchy.\r\n            return true\r\n        end\r\n\r\n        local function ownedTool()\r\n            for _, name in ipairs(chopToolNames) do\r\n                if hasInventoryItem(name) or hotbarHasTool(name) then return name end\r\n            end\r\n            return nil\r\n        end\r\n\r\n        local function confirmOwnedTool(name)\r\n            -- Pickup only. Do not request equip or send hotbar key input.\r\n            return name ~= nil and (hasInventoryItem(name) or hotbarHasTool(name))\r\n        end\r\n\r\n        local owned = ownedTool()\r\n        if owned then\r\n            while F.Valid(token) do\r\n                if confirmOwnedTool(owned) then\r\n                    F.ChopToolPicked = owned\r\n                    _G.TempEquippedCache[owned] = true\r\n                    _G.KixPerfDebug.Event(\"CHOP_TOOL\", \"Already owned; left unequipped: \" .. owned)\r\n                    return true\r\n                end\r\n                F.SetStatus(\"PICKUP_CHOP_TOOL\", \"Confirming \" .. owned .. \" in inventory\")\r\n                if not F.Wait(token, 0.5) then return false end\r\n            end\r\n            return false\r\n        end\r\n        -- Do not trust stale successful-remote flags; only the actual\r\n        -- backpack, inventory, or equipped character item counts as acquired.\r\n        F.ChopToolPicked = nil\r\n\r\n        local remotes = _ReplicatedStorage:FindFirstChild(\"RemoteEvents\")\r\n        local pickup = remotes and remotes:FindFirstChild(\"RequestHotbarItem\")\r\n        if not pickup then\r\n            repeat\r\n                if not F.Wait(token, 0.5) then return false end\r\n                remotes = _ReplicatedStorage:FindFirstChild(\"RemoteEvents\")\r\n                pickup = remotes and remotes:FindFirstChild(\"RequestHotbarItem\")\r\n            until pickup or not F.Valid(token)\r\n            if not pickup then return false end\r\n        end\r\n\r\n        local function dragCandidate(item, destination)\r\n            local inItemsFolder = false\r\n            local ancestor = item.Parent\r\n            while ancestor and ancestor ~= workspace do\r\n                if ancestor.Name == \"Items\" then\r\n                    inItemsFolder = true\r\n                    break\r\n                end\r\n                ancestor = ancestor.Parent\r\n            end\r\n            local isKnownChopDrop = inItemsFolder and table.find(chopToolNames, item.Name) ~= nil\r\n            if not isKnownChopDrop or not item.Parent\r\n                or (_G.KixIsBringBlacklistedItem and _G.KixIsBringBlacklistedItem(item)) then\r\n                return false\r\n            end\r\n\r\n            -- The general drag path protects logging-camp area assets. This narrow\r\n            -- path permits only the three requested tools inside an Items folder,\r\n            -- while preserving the explicit Bring blacklist check above.\r\n            local remoteEvents = _ReplicatedStorage:FindFirstChild(\"RemoteEvents\")\r\n            local startDrag = remoteEvents and (remoteEvents:FindFirstChild(\"RequestStartDraggingItem_REAL\")\r\n                or remoteEvents:FindFirstChild(\"RequestStartDraggingItem\"))\r\n            local stopDrag = remoteEvents and (remoteEvents:FindFirstChild(\"StopDraggingItem_REAL\")\r\n                or remoteEvents:FindFirstChild(\"StopDraggingItem\"))\r\n            if not (startDrag and stopDrag) then return false end\r\n\r\n            local ok, moved = pcall(function()\r\n                if not item.Parent or isItemHeldByAnotherPlayer(item, true) then return false end\r\n                startDrag:FireServer(item)\r\n                task.wait(0.05)\r\n                if not item.Parent then\r\n                    stopDrag:FireServer(item)\r\n                    return false\r\n                end\r\n                if item:IsA(\"Model\") then\r\n                    item:PivotTo(CFrame.new(destination))\r\n                elseif item:IsA(\"Tool\") then\r\n                    local handle = item:FindFirstChild(\"Handle\") or item:FindFirstChildWhichIsA(\"BasePart\", true)\r\n                    if handle then handle.CFrame = CFrame.new(destination) end\r\n                elseif item:IsA(\"BasePart\") then\r\n                    item.CFrame = CFrame.new(destination)\r\n                end\r\n                task.wait(0.1)\r\n                stopDrag:FireServer(item)\r\n                return true\r\n            end)\r\n            return ok and moved == true\r\n        end\r\n\r\n        local function findCandidate(name)\r\n            local folders = {}\r\n            local mainItems = workspace:FindFirstChild(\"Items\") or workspace:FindFirstChild(\"items\")\r\n            if mainItems then folders[#folders + 1] = mainItems end\r\n            local map = workspace:FindFirstChild(\"Map\")\r\n            local landmarks = map and map:FindFirstChild(\"Landmarks\")\r\n            if landmarks then\r\n                for _, landmark in ipairs(landmarks:GetChildren()) do\r\n                    local itemsFolder = landmark:FindFirstChild(\"Items\")\r\n                    if itemsFolder then folders[#folders + 1] = itemsFolder end\r\n                end\r\n            end\r\n            for _, folder in ipairs(folders) do\r\n                if folder then\r\n                    for _, item in ipairs(folder:GetChildren()) do\r\n                        if item.Name == name and item.Parent == folder\r\n                            and not (_G.KixIsBringBlacklistedItem and _G.KixIsBringBlacklistedItem(item))\r\n                            and not isItemHeldByAnotherPlayer(item, true) then\r\n                            return item\r\n                        end\r\n                        -- Some game builds group world drops one level below Items.\r\n                        if item:IsA(\"Folder\") or item:IsA(\"Model\") then\r\n                            local nested = item:FindFirstChild(name)\r\n                            if nested\r\n                                and not (_G.KixIsBringBlacklistedItem and _G.KixIsBringBlacklistedItem(nested))\r\n                                and not isItemHeldByAnotherPlayer(nested, true) then\r\n                                return nested\r\n                            end\r\n                        end\r\n                    end\r\n                end\r\n            end\r\n            return nil\r\n        end\r\n\r\n        -- Keep searching/equipping while this Full Automation run is active.\r\n        while F.Valid(token) and not F.IsSkipped(\"Auto Chop Tree\") do\r\n            if not F.Valid(token) then return false end\r\n            owned = ownedTool()\r\n            if owned then\r\n                if confirmOwnedTool(owned) then\r\n                    F.ChopToolPicked = owned\r\n                    _G.TempEquippedCache[owned] = true\r\n                    return true\r\n                end\r\n                F.SetStatus(\"PICKUP_CHOP_TOOL\", \"Confirming \" .. owned .. \" in inventory\")\r\n                if not F.Wait(token, 0.5) then return false end\r\n                continue\r\n            end\r\n            for _, name in ipairs(chopToolNames) do\r\n                local item = findCandidate(name)\r\n                if item then\r\n                    F.SetStatus(\"PICKUP_CHOP_TOOL\", \"Collecting \" .. name .. \" before Auto Chop Trees\")\r\n                    for attempt = 1, 2 do\r\n                        if not F.Valid(token) then return false end\r\n                        if F.IsSkipped(\"Auto Chop Tree\") then return true end\r\n                        if ownedTool() then break end\r\n                        local hrp = F.HRP()\r\n                        if not hrp or not item.Parent\r\n                            or (_G.KixIsBringBlacklistedItem and _G.KixIsBringBlacklistedItem(item))\r\n                            or isItemHeldByAnotherPlayer(item, true) then break end\r\n\r\n                        local dragOk = false\r\n                        local ok, err = pcall(function()\r\n                            dragOk = dragCandidate(item, hrp.Position)\r\n                        end)\r\n                        if not ok then\r\n                            warn(\"[FullAuto ChopTool] Drag error: \" .. tostring(err))\r\n                        end\r\n                        if not F.Wait(token, 0.12) then return false end\r\n\r\n                        -- Match Infernal Sword: trust actual inventory first,\r\n                        -- then make its same pickup request if drag left the item in-world.\r\n                        owned = ownedTool()\r\n                        if owned then\r\n                            if confirmOwnedTool(owned) then\r\n                                F.ChopToolPicked = owned\r\n                                _G.TempEquippedCache[owned] = true\r\n                                _G.KixPerfDebug.Event(\"CHOP_TOOL\", \"Pickup confirmed; left unequipped: \" .. owned)\r\n                                return true\r\n                            end\r\n                            break\r\n                        else\r\n                            local nearby = false\r\n                            pcall(function()\r\n                                local position = item:IsA(\"Model\") and item:GetPivot().Position\r\n                                    or item:IsA(\"BasePart\") and item.Position\r\n                                    or (item:FindFirstChildWhichIsA(\"BasePart\", true)\r\n                                        and item:FindFirstChildWhichIsA(\"BasePart\", true).Position)\r\n                                nearby = position ~= nil and (position - hrp.Position).Magnitude <= 15\r\n                            end)\r\n                            if F.Valid(token) and item.Parent and (dragOk or nearby)\r\n                                and not F.IsSkipped(\"Auto Chop Tree\")\r\n                                and not isItemHeldByAnotherPlayer(item, true) then\r\n                            local pickedOk, pickupErr = pcall(function()\r\n                                if pickup:IsA(\"RemoteFunction\") then\r\n                                    pickup:InvokeServer(item)\r\n                                else\r\n                                    pickup:FireServer(item)\r\n                                end\r\n                            end)\r\n                            if not pickedOk then\r\n                                warn(\"[FullAuto ChopTool] Pickup error: \" .. tostring(pickupErr))\r\n                            end\r\n                            end\r\n                        end\r\n                        if not F.Wait(token, 0.15) then return false end\r\n                        owned = ownedTool()\r\n                        if owned then\r\n                            if confirmOwnedTool(owned) then\r\n                                F.ChopToolPicked = owned\r\n                                _G.TempEquippedCache[owned] = true\r\n                                _G.KixPerfDebug.Event(\"CHOP_TOOL\", \"Pickup confirmed; left unequipped: \" .. owned)\r\n                                return true\r\n                            end\r\n                            break\r\n                        end\r\n                        if not F.Wait(token, 0.15) then return false end\r\n                    end\r\n                end\r\n            end\r\n            if not F.Wait(token, 0.5) then return false end\r\n        end\r\n        return F.IsSkipped(\"Auto Chop Tree\") == true\r\n    end\r\n\r\n    -- Reuse the Strong Axe world-drop pickup flow during Full Auto chest progress.\r\n    -- This only stores the axe in inventory/Hotbar; it never selects or equips it.\r\n    function F.TryPickupStrongAxeDrop(token, item)\r\n        local function validPickup()\r\n            return token == nil and KixHubSession.Alive or F.Valid(token)\r\n        end\r\n        local function waitPickup(seconds)\r\n            if token ~= nil then return F.Wait(token, seconds) end\r\n            task.wait(seconds or 0)\r\n            return KixHubSession.Alive\r\n        end\r\n        if not validPickup() or not item or item.Name ~= \"Strong Axe\" or not item.Parent then return false end\r\n        if hasInventoryItem(\"Strong Axe\") then return true end\r\n\r\n        local playerGui = _LocalPlayer:FindFirstChild(\"PlayerGui\")\r\n        local interface = playerGui and playerGui:FindFirstChild(\"Interface\")\r\n        local hotbar = interface and interface:FindFirstChild(\"Hotbar\")\r\n        if hotbar and hotbar:FindFirstChild(\"ButtonStrong Axe\") then return true end\r\n\r\n        local inItemsFolder = false\r\n        local ancestor = item.Parent\r\n        while ancestor and ancestor ~= workspace do\r\n            if ancestor.Name == \"Items\" then\r\n                inItemsFolder = true\r\n                break\r\n            end\r\n            ancestor = ancestor.Parent\r\n        end\r\n        if not inItemsFolder\r\n            or (_G.KixIsBringBlacklistedItem and _G.KixIsBringBlacklistedItem(item))\r\n            or isItemHeldByAnotherPlayer(item, true) then\r\n            return false\r\n        end\r\n\r\n        local remotes = _ReplicatedStorage:FindFirstChild(\"RemoteEvents\")\r\n        local startDrag = remotes and (remotes:FindFirstChild(\"RequestStartDraggingItem_REAL\")\r\n            or remotes:FindFirstChild(\"RequestStartDraggingItem\"))\r\n        local stopDrag = remotes and (remotes:FindFirstChild(\"StopDraggingItem_REAL\")\r\n            or remotes:FindFirstChild(\"StopDraggingItem\"))\r\n        local pickup = remotes and remotes:FindFirstChild(\"RequestHotbarItem\")\r\n        local hrp = F.HRP()\r\n        if not (startDrag and stopDrag and pickup and hrp) then return false end\r\n\r\n        for attempt = 1, 2 do\r\n            if not validPickup() or not item.Parent or hasInventoryItem(\"Strong Axe\") then break end\r\n            if (_G.KixIsBringBlacklistedItem and _G.KixIsBringBlacklistedItem(item))\r\n                or isItemHeldByAnotherPlayer(item, true) then\r\n                return false\r\n            end\r\n\r\n            local dragOk = false\r\n            local ok = pcall(function()\r\n                startDrag:FireServer(item)\r\n                task.wait(0.05)\r\n                if not item.Parent then\r\n                    stopDrag:FireServer(item)\r\n                    return\r\n                end\r\n                local destination = hrp.Position\r\n                if item:IsA(\"Model\") then\r\n                    item:PivotTo(CFrame.new(destination))\r\n                elseif item:IsA(\"Tool\") then\r\n                    local handle = item:FindFirstChild(\"Handle\") or item:FindFirstChildWhichIsA(\"BasePart\", true)\r\n                    if handle then handle.CFrame = CFrame.new(destination) end\r\n                elseif item:IsA(\"BasePart\") then\r\n                    item.CFrame = CFrame.new(destination)\r\n                end\r\n                task.wait(0.1)\r\n                stopDrag:FireServer(item)\r\n                dragOk = true\r\n            end)\r\n            if not ok then pcall(function() stopDrag:FireServer(item) end) end\r\n\r\n            if not hasInventoryItem(\"Strong Axe\") and item.Parent then\r\n                local nearby = false\r\n                pcall(function()\r\n                    local position = item:IsA(\"Model\") and item:GetPivot().Position\r\n                        or item:IsA(\"BasePart\") and item.Position\r\n                        or (item:FindFirstChildWhichIsA(\"BasePart\", true)\r\n                            and item:FindFirstChildWhichIsA(\"BasePart\", true).Position)\r\n                    nearby = position ~= nil and (position - hrp.Position).Magnitude <= 15\r\n                end)\r\n                if dragOk or nearby then\r\n                    pcall(function()\r\n                        if pickup:IsA(\"RemoteFunction\") then\r\n                            pickup:InvokeServer(item)\r\n                        else\r\n                            pickup:FireServer(item)\r\n                        end\r\n                    end)\r\n                end\r\n            end\r\n\r\n            if not waitPickup(0.15) then return false end\r\n            if hasInventoryItem(\"Strong Axe\") then return true end\r\n            if hotbar and hotbar:FindFirstChild(\"ButtonStrong Axe\") then return true end\r\n        end\r\n        return false\r\n    end\r\n\r\n\r\n    function F.ChopPauseReason()\r\n        if _G.KixHalloweenTrickBusy then return \"Halloween Trick recovery\", false end\r\n        if _G.IsStrongholdRaidActive or _G.StrongholdTransition or _G.ForceStrongholdRaid\r\n            or _G.StrongholdPreparingRaid or _G.CampfireCombatStrongholdPaused then\r\n            return \"Stronghold activity\", true\r\n        end\r\n        if _G.CampfireCombatActive or _G.CampfireCombatPaused or _G.CorruptedCombatActive or _G.MossyCombatActive\r\n            or _G.TurkeyCombatActive or _G.BearCombatActive or _G.GlobalCultistCombatActive\r\n            or _G.MammothCombatActive or _G.FrogCombatActive or _G.CustomHuntCombatActive then\r\n            return \"Combat event\", false\r\n        end\r\n        if _G.AutoChestRunning or _G.KixRescueBusy then return \"Another active task\", false end\r\n        if F.ChopWindowActive and F.ChopUserPaused then return \"Auto Chop manually paused\", false end\r\n        return nil, false\r\n    end\r\n\r\n    function F.RunChopWindow(token, seconds)\r\n        if F.IsSkipped(\"Auto Chop Tree\") then\r\n            F.StopOwned(\"AutoChopTrees\")\r\n            F.ChopWindowActive = false\r\n            _G.KixAutoChopHold = false\r\n            F.SetChopStatus(\"Skipped by Full Automation selection\")\r\n            return true\r\n        end\r\n        F.ChopWindowActive = true\r\n        _G.KixAutoChopHold = false\r\n\r\n        local wasEnabled = F.Adapters.AutoChopTrees.IsEnabled()\r\n        F.Ensure(\"AutoChopTrees\")\r\n        if not wasEnabled then F.Owned.AutoChopTrees = true end\r\n        local remaining = seconds\r\n        local lastTick = os.clock()\r\n        F.SetChopStatus(\"Chopping Small Trees first; \" .. math.ceil(remaining) .. \" active seconds remaining\")\r\n\r\n        while F.Valid(token) and remaining > 0 and not F.IsSkipped(\"Auto Chop Tree\") do\r\n            if not F.Wait(token, 0.25) then\r\n                return false\r\n            end\r\n            local now = os.clock()\r\n            local delta = math.min(math.max(now - lastTick, 0), 0.35)\r\n            lastTick = now\r\n            local reason, strongholdBusy = F.ChopPauseReason()\r\n\r\n            if not reason then remaining = math.max(0, remaining - delta) end\r\n            if reason then\r\n                F.SetChopStatus(\"Paused: \" .. tostring(reason) .. \" | \" .. math.ceil(remaining) .. \" chop seconds remaining\")\r\n            elseif not _G.AutoChopSelectedTreesRunning then\r\n                F.SetChopStatus(\"Auto Chop active; waiting for an available tree | \" .. math.ceil(remaining) .. \" seconds\")\r\n            else\r\n                F.SetChopStatus(\"Chopping Small Trees first; \" .. math.ceil(remaining) .. \" active seconds remaining\")\r\n            end\r\n        end\r\n\r\n        if not F.Valid(token) then return false end\r\n        F.StopOwned(\"AutoChopTrees\")\r\n        F.ChopWindowActive = false\r\n        F.ChopUserPaused = false\r\n        -- A pre-existing manual Auto Chop is not Full Automation-owned and stays on.\r\n        -- Do not wait for its long-running worker to exit before advancing to Stage 3.\r\n        if not wasEnabled then\r\n            while (F.Engines.TaskCounts.AutoChopTrees or 0) > 0 do\r\n                if not F.Wait(token, 0.1) then return false end\r\n            end\r\n        end\r\n        if F.IsSkipped(\"Auto Chop Tree\") then\r\n            F.SetChopStatus(\"Skipped by Full Automation selection\")\r\n        elseif F.Adapters.AutoChopTrees.IsEnabled() then\r\n            F.SetChopStatus(\"Initial chop window complete; manually enabled Auto Chop remains on\")\r\n        else\r\n            F.SetChopStatus(\"Initial 40-second chop complete\")\r\n        end\r\n        return true\r\n    end\r\n\r\n    function F.InitTents()\r\n        local key = tostring(game.PlaceId) .. \":\" .. tostring(game.JobId)\r\n        local memory = getgenv().KixFullAutoTentMemory\r\n        if type(memory) ~= \"table\" or memory.Key ~= key then memory = {Key = key} end\r\n        getgenv().KixFullAutoTentMemory = memory\r\n        F.Tents = memory\r\n        local function observe(item)\r\n            for _, kind in ipairs({\"Dino\", \"Kraken\", \"Koala\", \"Squid\"}) do\r\n                if item.Name:match(\"^Tent\" .. kind .. \"Kid%d*$\") or item.Name == \"Tent\" .. kind then\r\n                    memory[kind] = true\r\n                end\r\n            end\r\n        end\r\n        local function bind(folder)\r\n            if folder.Name ~= \"Structures\" or folder == F.Structures then return end\r\n            if F.TentConnection then F.TentConnection:Disconnect() end\r\n            F.Structures = folder\r\n            F.TentConnection = folder.ChildAdded:Connect(observe)\r\n            for _, item in ipairs(folder:GetChildren()) do observe(item) end\r\n        end\r\n        table.insert(F.Connections, workspace.ChildAdded:Connect(bind))\r\n        local folder = workspace:FindFirstChild(\"Structures\")\r\n        if folder then bind(folder) end\r\n    end\r\n\r\n    function F.TentCount()\r\n        local count = 0\r\n        for _, kind in ipairs({\"Dino\", \"Kraken\", \"Koala\", \"Squid\"}) do\r\n            if F.Tents and F.Tents[kind] then count = count + 1 end\r\n        end\r\n        return count\r\n    end\r\n\r\n    function F.MoveItem(item, position)\r\n        if not item or not item.Parent or isItemHeldByAnotherPlayer(item) then return false end\r\n        dragItemSmooth(item, position)\r\n        if not item.Parent then return true end -- consumed/removed; no claim about awarded currency\r\n        local ok, pivot = pcall(function() return item:GetPivot() end)\r\n        return ok and (pivot.Position - position).Magnitude < 15\r\n    end\r\n\r\n    function F.StartFuel(token)\r\n        local fireLevel = tonumber(F.Adapters.UpgradeFire.GetLevel()) or 0\r\n        local function setFire(state)\r\n            if _G.UpgradeFireToggle and type(_G.UpgradeFireToggle.Set) == \"function\" then\r\n                _G.UpgradeFireToggle:Set(state)\r\n            else\r\n                F.Adapters.UpgradeFire.SetState(state)\r\n            end\r\n        end\r\n\r\n        if F.StopAfterChestLoot and fireLevel >= 6 then\r\n            -- Manual chest runs do not need fuel once the fire is maxed. Also\r\n            -- stop a previously enabled feeder so it cannot keep consuming fuel.\r\n            if F.Adapters.UpgradeFire.IsEnabled() then\r\n                pcall(setFire, false)\r\n            end\r\n            F.FuelStatus = \"Campfire is max level; skipping fire fuel upgrade\"\r\n            return\r\n        end\r\n        if F.Jobs.Fuel or fireLevel >= 6 then return end\r\n        -- Reuse the original Auto Upgrade Level Fire feeder; no batch delivery.\r\n        if F.Adapters.UpgradeFire.IsEnabled() then return end\r\n        F.Jobs.Fuel = true\r\n        F.FuelError = nil\r\n        task.spawn(function()\r\n            local ok, err = xpcall(function()\r\n                setFire(true)\r\n                assert(F.Adapters.UpgradeFire.IsEnabled(), \"Original fire feeder did not start\")\r\n                F.FuelStatus = \"Using original Auto Upgrade Level Fire\"\r\n                while F.Valid(token) and F.Adapters.UpgradeFire.GetLevel() < 6 do\r\n                    task.wait(0.25)\r\n                end\r\n            end, function(e) return tostring(e) end)\r\n            local stopped, stopError = pcall(setFire, false)\r\n            F.Jobs.Fuel = nil\r\n            if not ok or not stopped then\r\n                F.FuelError = tostring(not ok and err or stopError)\r\n                warn(\"[FullAuto fuel] \" .. F.FuelError)\r\n            end\r\n        end)\r\n    end\r\n\r\n    function F.StartChestMonitor(token)\r\n        if F.ChestMonitorStarted then return true end\r\n        F.ChestMonitorStarted = true\r\n        F.ChestMonitorDone = false\r\n        F.ChestMonitorResult = nil\r\n        F.ChestAntiVoidOriginal = nil\r\n        F.ChestDeliveryActivated = false\r\n        F.Jobs.Chest = true\r\n        autoChestRunning = true\r\n        _G.AutoChestStatus = \"monitoring\"\r\n\r\n        task.spawn(function()\r\n            while F.Valid(token) and (_G.KixAutoChestCore.Running or _G.AutoChestRunning) do\r\n                if not F.Wait(token, 0.2) then break end\r\n            end\r\n            local ownsDeliveryMode = false\r\n            if F.Valid(token) then\r\n                F.ChestAntiVoidOriginal = _G.AntiVoidItemsEnabled\r\n                _G.AutoChestAntiVoidOriginal = F.ChestAntiVoidOriginal\r\n                ownsDeliveryMode = true\r\n            end\r\n            while F.Valid(token) and not includeHighTierChests and not includeLowTierChests do\r\n                setAutoChestStatus(\"Status: Waiting for a chest tier selection.\")\r\n                if not F.Wait(token, 0.5) then break end\r\n            end\r\n\r\n            local opened, detail = false, \"cancelled\"\r\n            if F.Valid(token) and (includeHighTierChests or includeLowTierChests) then\r\n                _G.TempEquippedCache = _G.TempEquippedCache or {}\r\n                opened, detail = _G.KixAutoChestCore.Run(\r\n                    function() return F.Valid(token) end,\r\n                    function(text) setAutoChestStatus(\"Status: \" .. tostring(text)) end,\r\n                    function(seconds) return F.Wait(token, seconds or 0) end,\r\n                    -- Stop chest scanning at the actual Layer 3 reveal completion,\r\n                    -- not at the later Full Automation preparation gate.\r\n                    function() return F.Results.Reveal == true end,\r\n                    true,\r\n                    function() F.ChestDeliveryActivated = true end\r\n                )\r\n            end\r\n\r\n            F.ChestMonitorResult, F.ChestMonitorDetail = opened == true, detail\r\n            F.ChestMonitorDone = true\r\n            if not F.Valid(token) or not opened then\r\n                if ownsDeliveryMode and F.ChestDeliveryActivated then\r\n                    _G.AutoChestAntiVoidMode = false\r\n                    _G.AntiVoidItemsEnabled = F.ChestAntiVoidOriginal == true\r\n                    _G.AutoChestRunning = false\r\n                    autoChestRunning = false\r\n                end\r\n                if ownsDeliveryMode and not F.ChestDeliveryActivated then autoChestRunning = false end\r\n                F.Jobs.Chest = nil\r\n            end\r\n        end)\r\n        return true\r\n    end\r\n\r\n    function F.TeleportToCampfire(token)\r\n        local hrp = F.HRP()\r\n        if not hrp then return false end\r\n        local target = AutoMapReveal and AutoMapReveal.CampfirePos\r\n            or Vector3.new(0.43, 15.77, -1.88)\r\n        local ok, err = pcall(function()\r\n            hrp.CFrame = CFrame.new(target)\r\n            hrp.AssemblyLinearVelocity = Vector3.zero\r\n            hrp.AssemblyAngularVelocity = Vector3.zero\r\n        end)\r\n        if not ok then\r\n            warn(\"[FullAuto Campfire Return] \" .. tostring(err))\r\n            return false\r\n        end\r\n        return true\r\n    end\r\n\r\n    function F.Prepare(token)\r\n        F.PreparationReadyForChest = false\r\n        F.SetStatus(\"ENABLE_SUPPORT\", \"Instant Interact, Auto Eat and Semi God Mode\")\r\n        if F.InstantBefore == nil then F.InstantBefore = InstantInteractEnabled end\r\n        F.Engines.InstantInteract(true)\r\n        F.SyncToggle(\"InstantInteract\", true)\r\n        F.Ensure(\"AutoEat\")\r\n        F.Ensure(\"SemiGodMode\")\r\n        while not F.HRP() do\r\n            F.SetStatus(\"WAITING\", \"Waiting for character\")\r\n            if not F.Wait(token, 0.5) then return false end\r\n        end\r\n        F.StartFuel(token)\r\n        -- The manual chest shortcut leaves kid rescue to its dedicated toggle.\r\n        -- Full Automation still owns and runs rescue through this same prepare path.\r\n        if not F.StopAfterChestLoot and not F.IsSkipped(\"Rescue Kids\") then\r\n            F.Ensure(\"AutoRescue\")\r\n        end\r\n        if F.IsSkipped(\"Map Reveal\") then\r\n            F.MapRevealSkipActive = true\r\n            F.Results.Reveal = true\r\n            F.StopRevealForSkip()\r\n        end\r\n        -- Begin chest opening before Map Reveal; this worker does not move the player.\r\n        F.StartChestMonitor(token)\r\n        if not F.IsSkipped(\"Map Reveal\") and F.Adapters.AutoReveal.IsCompleted() then\r\n            F.Results.Reveal = true\r\n        end\r\n        if not F.IsSkipped(\"Map Reveal\") and not F.Results.Reveal\r\n            and not F.Adapters.AutoReveal.IsScanning()\r\n            and not F.Adapters.AutoReveal.IsCompleting()\r\n            and not F.Adapters.AutoReveal.IsPausedForRescue()\r\n            and not F.MapRevealStopPending then\r\n            F.Owned.AutoReveal = true\r\n            F.Adapters.AutoReveal.Start()\r\n        end\r\n        while F.Valid(token) do\r\n            if not F.Wait(token, 0.25) then return false end\r\n            if F.IsSkipped(\"Map Reveal\") then\r\n                F.Results.Reveal = true\r\n                F.StopRevealForSkip()\r\n            elseif not F.Results.Reveal and F.Adapters.AutoReveal.IsCompleted() then\r\n                F.Results.Reveal = true\r\n            elseif not F.Results.Reveal\r\n                and not F.MapRevealStopPending\r\n                and not F.Adapters.AutoReveal.IsCompleting()\r\n                and not F.Adapters.AutoReveal.IsScanning()\r\n                and not F.Adapters.AutoReveal.IsPausedForRescue() then\r\n                F.Owned.AutoReveal = true\r\n                F.Adapters.AutoReveal.Start()\r\n            end\r\n            if F.IsSkipped(\"Rescue Kids\")\r\n                and AutoMapReveal.State.IsPausedForRescue\r\n                and not _G.KixRescueBusy\r\n                and not F.Results.Reveal then\r\n                pcall(AutoMapReveal.ResumeAfterRescue)\r\n            end\r\n            if F.ChestMonitorDone and not F.ChestMonitorResult then\r\n                error(\"Auto Chest monitor: \" .. tostring(F.ChestMonitorDetail))\r\n            end\r\n            local rescueScanReady = type(_G.KixRescueFindTarget) == \"function\"\r\n            local remainingKid = rescueScanReady and _G.KixRescueFindTarget()\r\n            if F.FuelError then error(\"Fuel: \" .. F.FuelError) end\r\n            if not F.IsSkipped(\"Map Reveal\") and AutoMapReveal.State.Failure then\r\n                error(AutoMapReveal.State.Failure)\r\n            end\r\n            if not F.IsSkipped(\"Rescue Kids\") and tostring(_G.KixRescueStatus):match(\"^error:\") then error(_G.KixRescueStatus) end\r\n            -- Reveal still completes its full layer-3 route. Skipping rescue\r\n            -- removes the 4/4 kid gate but keeps the fire-level requirement.\r\n            if F.Adapters.AutoReveal.IsCompleted() then F.Results.Reveal = true end\r\n            if not F.StopAfterChestLoot\r\n                and not F.IsSkipped(\"Rescue Kids\")\r\n                and F.TentCount() >= 4\r\n                and rescueScanReady\r\n                and not remainingKid\r\n                and not _G.KixRescueBusy\r\n                and not F.Adapters.AutoRescue.IsCarryingKid()\r\n            then\r\n                F.StopOwned(\"AutoRescue\")\r\n                if F.Adapters.AutoReveal.IsPausedForRescue() and not F.Results.Reveal then AutoMapReveal.ResumeAfterRescue() end\r\n            end\r\n            local fireReady = F.Adapters.UpgradeFire.GetLevel() >= 6\r\n            local rescueReady = F.StopAfterChestLoot or F.IsSkipped(\"Rescue Kids\")\r\n                or (F.TentCount() >= 4\r\n                    and rescueScanReady\r\n                    and not remainingKid\r\n                    and not _G.KixRescueBusy\r\n                    and not F.Adapters.AutoRescue.IsCarryingKid())\r\n            if F.Results.Reveal and fireReady and rescueReady then\r\n                while F.Jobs.Fuel do if not F.Wait(token, 0.1) then return false end end\r\n                F.PreparationReadyForChest = true\r\n                return true\r\n            end\r\n            local rescueSkipped = F.StopAfterChestLoot or F.IsSkipped(\"Rescue Kids\")\r\n            local detail = F.FuelStatus or (rescueSkipped\r\n                and \"Exploring and preparing fire; kid rescue skipped\"\r\n                or \"Exploring and rescuing children\")\r\n            if not rescueSkipped and not F.Adapters.AutoRescue.HasSack() and F.TentCount() < 4 then detail = \"Waiting for Sack (inventory/character)\"\r\n            elseif _G.KixRescueBusy then detail = \"Rescue owns movement; reveal paused\"\r\n            elseif not rescueSkipped and F.Results.Reveal and F.TentCount() < 4 then detail = \"Waiting for remaining rescue / tent placement\"\r\n            elseif not F.HRP() then detail = \"Waiting for character\" end\r\n            F.SetStatus(F.StopAfterChestLoot and \"PREPARE_AND_REVEAL\" or \"EXPLORE_AND_RESCUE\", detail)\r\n        end\r\n        return false\r\n    end\r\n\r\n    function F.Chests(token)\r\n        while not includeHighTierChests and not includeLowTierChests do\r\n            F.SetStatus(\"WAITING\", \"Select at least one chest tier in Auto\")\r\n            if not F.Wait(token, 0.5) then return false end\r\n        end\r\n        if not F.ChestMonitorStarted then\r\n            F.PreparationReadyForChest = true\r\n            F.StartChestMonitor(token)\r\n        end\r\n        F.SetStatus(\"CHEST_WAIT\", \"Closing chest monitor after Map Reveal\")\r\n        while not F.ChestMonitorDone do\r\n            if not F.Valid(token) then return false end\r\n            task.wait() -- Yield so the concurrent chest monitor can finish cleanup.\r\n        end\r\n        if not F.ChestMonitorResult then\r\n            error(\"Auto Chest monitor: \" .. tostring(F.ChestMonitorDetail))\r\n        end\r\n\r\n        local success = false\r\n        F.Jobs.Chest = true\r\n        autoChestRunning, _G.AutoChestRunning = true, true\r\n        local ok, err = xpcall(function()\r\n            local hrp = F.HRP()\r\n            while not hrp do\r\n                if not F.Wait(token, 0.2) then return end\r\n                hrp = F.HRP()\r\n            end\r\n            success = _G.KixAutoChestCore.FinalizeCampfireLoot(\r\n                function() return F.Valid(token) end,\r\n                function(seconds) return F.Wait(token, seconds or 0) end,\r\n                function(stage, detail) F.SetStatus(stage, detail) end,\r\n                function() return F.TeleportToCampfire(token) end\r\n            )\r\n        end, function(e) return tostring(e) end)\r\n\r\n        _G.AutoChestAntiVoidMode = false\r\n        if _G.AutoChestAntiVoidOriginal ~= nil then\r\n            _G.AntiVoidItemsEnabled = _G.AutoChestAntiVoidOriginal\r\n        end\r\n        _G.FailedEquipCache = {}\r\n        _G.AutoChestRunning, autoChestRunning = false, false\r\n        F.Jobs.Chest = nil\r\n        _G.AutoChestStatus = not ok and \"failed\" or success and \"completed\" or \"cancelled\"\r\n        if success then _G.AutoChestLastCompletedTime = os.time() end\r\n\r\n        if not ok then error(err) end\r\n        if not success then return false end\r\n        autoChestHasRun = true\r\n\r\n        return true\r\n    end\r\n\r\n    function F.VisitVolcanoAfterCultists(token)\r\n        if F.Results.CultistVolcanoVisit then return true end\r\n        local map = workspace:FindFirstChild(\"Map\")\r\n        local landmarks = map and map:FindFirstChild(\"Landmarks\")\r\n        local volcano = landmarks and landmarks:FindFirstChild(\"Volcano\")\r\n        local hrp = F.HRP()\r\n        if not volcano or not hrp then\r\n            if WindUI then WindUI:Notify({Title=\"Error\", Content=\"Volcano has not loaded yet in this server!\", Duration=4}) end\r\n            return F.Wait(token, 3)\r\n        end\r\n        local original = hrp.CFrame\r\n        local offset = CFrame.new(133.83309936523438, -3.1000030040740967, 124.9095458984375)\r\n            * CFrame.Angles(-3.1415927410125732, 0.009690151549875736, 3.141592502593994)\r\n        local function restorePosition()\r\n            if hrp == F.HRP() then hrp.CFrame = original; hrp.AssemblyLinearVelocity = Vector3.zero end\r\n        end\r\n        F.SetStatus(\"VISIT_VOLCANO\", \"Visiting Volcano; keeping Global Cultist active while streamed cultists are cleared\")\r\n        hrp.CFrame = volcano:GetPivot() * offset\r\n        hrp.AssemblyLinearVelocity = Vector3.zero\r\n        if WindUI then WindUI:Notify({Title=\"Teleport\", Content=\"Teleported to Volcano successfully!\", Duration=3}) end\r\n        -- Allow the Volcano landing to settle, then start the podium worker.\r\n        if not F.Wait(token, 2) then restorePosition(); return false end\r\n        F.Ensure(\"AutoSpawnCultistKing\")\r\n        -- Let Volcano-area NPCs stream in before starting the no-target confirmation window.\r\n        if not F.Wait(token, 5) then restorePosition(); return false end\r\n        local clearOk, clearResult = pcall(F.WaitForCultists, token)\r\n        restorePosition()\r\n        if not clearOk then error(clearResult) end\r\n        if not clearResult then return false end\r\n\r\n        -- Recheck after returning to Campfire. Streamed/global targets can appear\r\n        -- during the return trip, so keep the cultist worker active until the\r\n        -- area has again stayed clear for five continuous seconds.\r\n        F.SetStatus(\"VERIFY_CULTISTS_AT_CAMPFIRE\", \"Back at Campfire; confirming no cultists for 5 seconds\")\r\n        local campfireClearOk, campfireClear = pcall(F.WaitForCultists, token)\r\n        if not campfireClearOk then error(campfireClear) end\r\n        if not campfireClear then return false end\r\n\r\n        F.Results.CultistVolcanoVisit = true\r\n        return true\r\n    end\r\n\r\n    function F.WaitForCultists(token)\r\n        local clearSince = nil\r\n        while F.Valid(token) do\r\n            if F.IsSkipped(\"Auto Kill Cultist Global\") then return true end\r\n            if not F.Wait(token, 0.5) then return false end\r\n            if not F.Adapters.AutoKillCultist.IsEnabled() then\r\n                error(\"Global Cultist disabled before clearance; enable it then Resume\")\r\n            end\r\n            if F.Engines.Errors.AutoKillCultist then error(F.Engines.Errors.AutoKillCultist) end\r\n            local chars = workspace:FindFirstChild(\"Characters\")\r\n            local hrp = F.HRP()\r\n            local found = false\r\n            if chars and hrp then\r\n                -- Match the existing Global Cultist engine's target eligibility.\r\n                for _, cultist in ipairs(chars:GetChildren()) do\r\n                    if string.find(cultist.Name, \"Cultist\")\r\n                        and not string.find(cultist.Name, \"Resurrected\")\r\n                        and tostring(cultist:GetAttribute(\"NPCType\")) ~= \"Thanksgiving Guest\"\r\n                        and not IsCultistInIceBlock(cultist)\r\n                        and cultist:FindFirstChild(\"HumanoidRootPart\") then\r\n                        local hum = cultist:FindFirstChildWhichIsA(\"Humanoid\")\r\n                        if not hum or hum.Health > 0 then found = true; break end\r\n                    end\r\n                end\r\n            end\r\n            if not chars or not hrp or found or _G.GlobalCultistCombatActive then\r\n                clearSince = nil\r\n                F.SetStatus(\"CLEAR_CULTISTS\", found and \"Waiting for remaining eligible cultists\" or \"Waiting for character / combat cleanup\")\r\n            else\r\n                clearSince = clearSince or os.clock()\r\n                F.SetStatus(\"CLEAR_CULTISTS\", \"Confirming no remaining cultists for 5 seconds\")\r\n                if os.clock() - clearSince >= 5 then return true end\r\n            end\r\n        end\r\n        return false\r\n    end\r\n\r\n    function F.Sequence(token)\r\n        while F.Valid(token) do\r\n            if not F.Wait(token, 0) then return end\r\n            for name in pairs(F.Owned) do\r\n                if F.Engines.Errors[name] then error(name .. \": \" .. F.Engines.Errors[name]) end\r\n            end\r\n            if F.Stage == 1 then\r\n                if not F.Prepare(token) then return end\r\n            elseif F.Stage == 2 then\r\n                if not F.Results.Chest then\r\n                    if not F.Chests(token) then return end\r\n                    F.Results.Chest = true\r\n                end\r\n                if F.StopAfterChestLoot then\r\n                    F.SetStatus(\"MANUAL_CHEST_DONE\", \"Map Reveal, chest looting, coins, and Tool Trader complete\")\r\n                    setAutoChestStatus(\"Status: Manual sequence complete — stopped after Tool Trader.\")\r\n                    F.ManualChestCompleted = true\r\n                    -- These two support features stay active after the one-shot\r\n                    -- manual sequence, and their UI switches must remain on.\r\n                    F.Owned.AutoEat = nil\r\n                    F.Owned.SemiGodMode = nil\r\n                    F.SyncToggle(\"AutoEat\", true)\r\n                    F.SyncToggle(\"SemiGodMode\", true)\r\n                    if WindUI then\r\n                        pcall(function()\r\n                            WindUI:Notify({Title = \"Auto Chest\", Content = \"Map Reveal, chest looting, Coin collection, and Tool Trader are complete.\", Duration = 5})\r\n                        end)\r\n                    end\r\n                    F.Stop()\r\n                    return\r\n                end\r\n                if F.Results.Chest and not F.ChestDisabledForChop then\r\n                    while _G.KixAutoChestCore and _G.KixAutoChestCore.Running do\r\n                        if not F.Wait(token, 0.1) then return end\r\n                    end\r\n                    autoChestRunning, _G.AutoChestRunning = false, false\r\n                    F.Jobs.Chest = nil\r\n                    _G.AutoChestStatus = \"disabled_before_auto_chop\"\r\n                    setAutoChestStatus(\"Status: Off - Full Automation entering Auto Chop\")\r\n                    F.ChestDisabledForChop = true\r\n                end\r\n                if F.IsSkipped(\"Auto Chop Tree\") then\r\n                    F.StopOwned(\"AutoChopTrees\")\r\n                    F.ChopWindowActive = false\r\n                    _G.KixAutoChopHold = false\r\n                    F.Results.ChopToolCheck, F.Results.Chop = true, true\r\n                    F.SetChopStatus(\"Skipped by Full Automation selection\")\r\n                    F.SetStatus(\"CHOP_SKIPPED\", \"Auto Chop Tree skipped by selection\")\r\n                else\r\n                    if not F.Results.ChopToolCheck then\r\n                        if not F.PickupChopToolOnce(token) then return end\r\n                        F.Results.ChopToolCheck = true\r\n                    end\r\n                    F.SetStatus(\"CHOP_SMALL_TREES\", \"Small Tree priority: 40 seconds\")\r\n                    if not F.RunChopWindow(token, 40) then return end\r\n                    F.Results.Chop = true\r\n                end\r\n            elseif F.Stage == 3 then\r\n                F.SetStatus(\"ENABLE_CONTINUOUS_COMBAT\", F.IsSkipped(\"Auto Sacrifice\")\r\n                    and \"Auto Sacrifice skipped; continuing the sequence\"\r\n                    or (F.IsSkipped(\"Auto Kill Cultist Global\")\r\n                        and \"Starting sacrifice; Global Cultist is skipped\"\r\n                        or \"Starting sacrifice and global cultist engines\"))\r\n                if not F.IsSkipped(\"Auto Sacrifice\") then F.Ensure(\"AutoSacrifice\") end\r\n                if not F.IsSkipped(\"Auto Kill Cultist Global\") then\r\n                    F.Ensure(\"AutoKillCultist\")\r\n                    if not F.WaitForCultists(token) then return end\r\n                end\r\n                -- Skipping Global Cultist leaves the separate Volcano visit and\r\n                -- Cultist King podium feature in the normal sequence.\r\n                if not F.VisitVolcanoAfterCultists(token) then return end\r\n                -- Hand combat over to the later stages after the initial global\r\n                -- clear; Stronghold manages its own cultist combat when started.\r\n                F.Engines.AutoKillCultist(false)\r\n                F.Owned.AutoKillCultist = nil\r\n                F.SyncToggle(\"AutoKillCultist\", false)\r\n                while (F.Engines.TaskCounts.AutoKillCultist or 0) > 0 do\r\n                    if not F.Wait(token, 0.1) then return end\r\n                end\r\n                if F.IsSkipped(\"Auto Scrap\") then\r\n                    F.SetStatus(\"AUTO_SCRAP_SKIPPED\", \"Auto Scrap skipped by selection\")\r\n                else\r\n                    F.SetStatus(\"ENABLE_AUTO_SCRAP\", F.IsSkipped(\"Auto Kill Cultist Global\")\r\n                        and \"Global Cultist skipped; enabling Auto Scrap\"\r\n                        or \"Global Cultist clear confirmed; enabling Auto Scrap\")\r\n                    F.Ensure(\"AutoScrap\")\r\n                end\r\n            elseif F.Stage == 4 then\r\n                F.SetStatus(F.IsSkipped(\"Auto Scrap\") and \"AUTO_SCRAP_SKIPPED\" or \"AUTO_SCRAP_GEMS\",\r\n                    F.IsSkipped(\"Auto Scrap\") and \"Auto Scrap remains skipped\" or \"Auto Scrap handles Cultist Gems and Forest fragments\")\r\n                F.Results.Gems = true\r\n            elseif F.Stage == 5 then\r\n                F.SetStatus(\"ENABLE_BUILD_SYSTEMS\", \"Starting Crafting Bench purchases and structure placement\")\r\n                if not F.Results.BuyStarted then\r\n                    F.Ensure(\"AutoBuy\")\r\n                    F.Results.BuyStarted = true\r\n                end\r\n                F.Ensure(\"AutoStructure\")\r\n            elseif F.Stage == 6 then\r\n                F.SetStatus(\"STRUCTURE_BUILD_ACTIVE\", \"Build systems active; continuing preparation\")\r\n            else\r\n                if not F.Results.Preparation then\r\n                    F.SetStatus(\"FINALIZE_PREPARATION\", \"Finishing Global Cultist; enabling Stronghold\")\r\n                    -- Never leave Global Cultist as a gate in front of Stronghold.\r\n                    -- Its initial clearance already ran in Stage 3; turn it off\r\n                    -- before handing combat and movement to Auto Stronghold.\r\n                    F.Engines.AutoKillCultist(false)\r\n                    F.Owned.AutoKillCultist = nil\r\n                    F.SyncToggle(\"AutoKillCultist\", false)\r\n                    while (F.Engines.TaskCounts.AutoKillCultist or 0) > 0 do\r\n                        if not F.Wait(token, 0.1) then return end\r\n                    end\r\n                    F.Ensure(\"AutoStronghold\")\r\n                    F.Results.Preparation = true\r\n                end\r\n                F.SetStatus(\"CONTINUOUS\", \"Preparation complete; continuous engines active\")\r\n                if not F.Wait(token, 1) then return end\r\n                continue\r\n            end\r\n            F.Stage = F.Stage + 1\r\n        end\r\n    end\r\n\r\n    function F.Start()\r\n        if F.Worker or F.Active or F.Resuming or F.Disposed then return end\r\n        if F.Stopping then\r\n            if not F.StartPending then\r\n                F.StartPending = true\r\n                task.spawn(function()\r\n                    while F.StartPending and F.Stopping and not F.Disposed do\r\n                        task.wait(0.1)\r\n                    end\r\n                    if F.StartPending