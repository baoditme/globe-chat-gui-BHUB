ePositions()\r\n        if KixNameConfig.text == \"\" or string.match(KixNameConfig.text, \"^%s*$\") then return {} end\r\n        local theme = FONT_THEMES[KixNameConfig.theme] or FONT_THEMES[\"Block 5x7\"]\r\n        local map = theme.map\r\n        local cols = theme.cols\r\n        local rows = theme.rows\r\n        local thickness = theme.thickness\r\n        local ds = KixNameConfig.dotSpacing\r\n        local cg = KixNameConfig.charGap\r\n        local lg = KixNameConfig.lineGap\r\n    \r\n        local words = split(KixNameConfig.text, \" \")\r\n        local lines = {}\r\n        if KixNameConfig.layoutMode == \"Single\" then\r\n            lines = {KixNameConfig.text}\r\n        else\r\n            local currentLine = {}\r\n            for i, w in ipairs(words) do\r\n                table.insert(currentLine, w)\r\n                if #currentLine >= KixNameConfig.wordsPerLine or i == #words then\r\n                    table.insert(lines, table.concat(currentLine, \" \"))\r\n                    currentLine = {}\r\n                end\r\n            end\r\n        end\r\n    \r\n        local positions = {}\r\n        \r\n        local center = KixNameConfig.lockedCenter\r\n        local right = KixNameConfig.lockedRight\r\n        local forward = KixNameConfig.lockedForward\r\n\r\n        if not center then\r\n            center = getTargetCenter()\r\n            local char = _LocalPlayer.Character\r\n            local hrp = char and char:FindFirstChild(\"HumanoidRootPart\")\r\n            if not hrp then return {} end\r\n            local r = hrp.CFrame.RightVector\r\n            local f = hrp.CFrame.LookVector\r\n            right = Vector3.new(r.X, 0, r.Z).Unit\r\n            forward = Vector3.new(f.X, 0, f.Z).Unit\r\n        end\r\n    \r\n        local totalHeightCells = #lines * (rows + lg) - lg\r\n        local startRow = -totalHeightCells / 2\r\n    \r\n        for li, line in ipairs(lines) do\r\n            local lineWidthCells = #line * (cols + cg) - cg\r\n            local startCol = -lineWidthCells / 2\r\n            local rowOffset = (li - 1) * (rows + lg)\r\n    \r\n            for ci = 1, #line do\r\n                local ch = string.upper(line:sub(ci, ci))\r\n                local glyph = map[ch] or map[\" \"]\r\n                local charColBase = startCol + (ci - 1) * (cols + cg)\r\n    \r\n                for _, dot in ipairs(glyph) do\r\n                    -- Thickness support:\r\n                    for dx = 0, thickness - 1 do\r\n                        for dy = 0, thickness - 1 do\r\n                            local localCol = charColBase + dot[1] + dx\r\n                            local localRow = startRow + rowOffset + dot[2] + dy\r\n                            \r\n                            local tx = localCol * ds\r\n                            local ty = localRow * ds\r\n                            \r\n                            -- Menggunakan rotasi menghadap player (kanan & depan):\r\n                            local worldXZ = center + (right * tx) - (forward * ty)\r\n                            local wy = getGroundY(worldXZ, center.Y)\r\n                            \r\n                            local pos = Vector3.new(worldXZ.X, wy, worldXZ.Z)\r\n                            \r\n                            -- Dedup (cegah titik tumpang tindih krn thickness)\r\n                            local isDuplicate = false\r\n                            for _, p in ipairs(positions) do\r\n                                if (p - pos).Magnitude < ds * 0.5 then\r\n                                    isDuplicate = true\r\n                                    break\r\n                                end\r\n                            end\r\n                            \r\n                            if not isDuplicate then\r\n                                table.insert(positions, pos)\r\n                            end\r\n                        end\r\n                    end\r\n                end\r\n            end\r\n        end\r\n        return positions\r\n    end\r\n    \r\n    local function clearNamePreview()\r\n        for _, p in ipairs(namePreviewParts) do if p and p.Parent then p:Destroy() end end\r\n        namePreviewParts = {}\r\n    end\r\n    \r\n    local function updateNamePreview()\r\n        if not namePreviewEnabled then clearNamePreview(); return end\r\n        local positions = generateNamePositions()\r\n        while #namePreviewParts < #positions do\r\n            local p = Instance.new(\"Part\")\r\n            p.Size = Vector3.new(1.2, 0.2, 1.2)\r\n            p.Anchored = true; p.CanCollide = false\r\n            p.Transparency = 0.4; p.Material = Enum.Material.Neon\r\n            p.Color = Color3.fromRGB(0, 150, 255)   -- biru\r\n            p.Name = \"SaplingNamePreview\"\r\n            p.Parent = workspace\r\n            table.insert(namePreviewParts, p)\r\n        end\r\n        while #namePreviewParts > #positions do table.remove(namePreviewParts):Destroy() end\r\n        for i, pos in ipairs(positions) do namePreviewParts[i].CFrame = CFrame.new(pos + Vector3.new(0,0.2,0)) end\r\n    end\r\n    \r\n    local function countSaplingsOnMap()\r\n        local n = 0\r\n        local function scan(container)\r\n            if container then\r\n                for _, c in ipairs(container:GetChildren()) do\r\n                    if c.Name:lower():find(\"sapling\") then n = n + 1 end\r\n                end\r\n            end\r\n        end\r\n        scan(workspace:FindFirstChild(\"Items\"))\r\n        scan(_LocalPlayer:FindFirstChild(\"Inventory\"))\r\n        scan(_LocalPlayer:FindFirstChild(\"ItemBag\"))\r\n        return n\r\n    end\r\n    \r\n    local function startRealtimePlant()\r\n        local remote = _ReplicatedStorage:FindFirstChild(\"RemoteEvents\") and _ReplicatedStorage.RemoteEvents:FindFirstChild(\"RequestPlantItem\") or _ReplicatedStorage:FindFirstChild(\"RequestPlantItem\")\r\n        if not remote then\r\n            WindUI:Notify({Title=\"Realtime Plant\", Content=\"Remote RequestPlantItem not found!\", Duration=3})\r\n            return\r\n        end\r\n        \r\n        plantRemoteMode = nil\r\n        realtimePlantActive = true\r\n        task.spawn(function()\r\n            while realtimePlantActive do\r\n                local char = _LocalPlayer.Character\r\n                local hrp = char and char:FindFirstChild(\"HumanoidRootPart\")\r\n                if not hrp then task.wait(0.1); continue end\r\n                \r\n                local footPos = hrp.Position\r\n                local y = getGroundY(footPos, footPos.Y)\r\n                local plantPos = Vector3.new(footPos.X, y, footPos.Z)\r\n                \r\n                local sapling = findSapling()\r\n                if not sapling then\r\n                    WindUI:Notify({Title=\"Realtime Plant\", Content=\"No saplings left!\", Duration=3, Icon=\"alert-triangle\"})\r\n                    realtimePlantActive = false\r\n                    break\r\n                end\r\n                \r\n                robustPlantCall(remote, sapling, plantPos)\r\n                task.wait()\r\n            end\r\n        end)\r\n    end\r\n    \r\n    local function stopRealtimePlant()\r\n        realtimePlantActive = false\r\n    end\r\n    \r\n    local function startAutoPlantName()\r\n        if autoPlantNameActive then\r\n            autoPlantNameActive = false\r\n            WindUI:Notify({Title=\"Name Design\", Content=\"Auto Plant Name Stopped.\", Duration=3})\r\n            return\r\n        end\r\n        \r\n        local remote = _ReplicatedStorage:FindFirstChild(\"RemoteEvents\") and _ReplicatedStorage.RemoteEvents:FindFirstChild(\"RequestPlantItem\") or _ReplicatedStorage:FindFirstChild(\"RequestPlantItem\")\r\n        if not remote then return end\r\n\r\n        plantRemoteMode = nil\r\n        \r\n        local positions = generateNamePositions()\r\n        if #positions == 0 then\r\n            WindUI:Notify({Title=\"Name Design\", Content=\"Name is empty!\", Duration=3})\r\n            return\r\n        end\r\n        \r\n        autoPlantNameActive = true\r\n        task.spawn(function()\r\n            local skippedCount = 0\r\n            for i = 1, #positions do\r\n                if not autoPlantNameActive then break end\r\n                local pos = positions[i]\r\n                \r\n                if isPositionOccupied(pos) then\r\n                    skippedCount = skippedCount + 1\r\n                    continue\r\n                end\r\n                \r\n                local sapling = findSapling()\r\n                if not sapling then\r\n                    WindUI:Notify({Title=\"Name Design\", Content=\"No saplings left! Stopping.\", Duration=3, Icon=\"alert-triangle\"})\r\n                    break\r\n                end\r\n                \r\n                createMarker(pos)\r\n                robustPlantCall(remote, sapling, pos)\r\n                task.wait(KixTreeConfig.plantDelay)\r\n            end\r\n            local msg = \"Planting name complete!\"\r\n            if skippedCount > 0 then msg = msg .. \" (Skipped \" .. skippedCount .. \" occupied spots)\" end\r\n            WindUI:Notify({Title=\"Name Design\", Content=msg, Duration=4, Icon=\"check\"})\r\n            autoPlantNameActive = false\r\n        end)\r\n    end\r\n    -- =========================================================================\r\n    \r\n    Tabs.Tree:Paragraph({\r\n        Title = 'Information Auto Plant Trees',\r\n        Desc = 'Please note that you must already have saplings available on the server (which can be obtained by chopping down trees) for this feature to work.'\r\n    })\r\n    \r\n    Tabs.Tree:Section({Title = 'Target Selection', Icon = 'target'})\r\n    \r\n    Tabs.Tree:Toggle({\r\n        Title = 'Enable Preview',\r\n        Default = false,\r\n        Callback = function(v)\r\n            previewEnabled = v\r\n            if previewEnabled then\r\n                if not previewTask then\r\n                    previewTask = task.spawn(function()\r\n                        while previewEnabled do\r\n                            updatePreview()\r\n                            task.wait(0.1) -- Lightweight 10 FPS preview\r\n                        end\r\n                    end)\r\n                end\r\n            else\r\n                if previewTask then task.cancel(previewTask); previewTask = nil end\r\n                clearPreview()\r\n            end\r\n        end\r\n    })\r\n    \r\n    Tabs.Tree:Dropdown({\r\n        Title = 'Center Mode',\r\n        Values = {'Campfire', 'Player'},\r\n        Value = KixTreeConfig.centerMode,\r\n        Callback = function(v) KixTreeConfig.centerMode = v end\r\n    })\r\n    \r\n    local UI_Layers, UI_Spacing, UI_Radius, UI_Height, UI_Amount\r\n\r\n    Tabs.Tree:Dropdown({\r\n        Title = 'Shape',\r\n        Values = {'Circle', 'Square', 'Triangle', 'Star', 'Line', 'Roof'},\r\n        Value = KixTreeConfig.shape,\r\n        Callback = function(v) \r\n            KixTreeConfig.shape = v \r\n            if v == \"Roof\" then\r\n                task.spawn(function()\r\n                    local function safeSet(slider, val)\r\n                        if not slider then return end\r\n                        pcall(function()\r\n                            if slider.SetValue then slider:SetValue(val)\r\n                            elseif slider.Set then slider:Set(val)\r\n                            elseif slider.SetState then slider:SetState(val) end\r\n                        end)\r\n                    end\r\n                    safeSet(UI_Layers, 9)\r\n                    safeSet(UI_Spacing, 1)\r\n                    safeSet(UI_Radius, 5)\r\n                    safeSet(UI_Height, 13)\r\n                    safeSet(UI_Amount, 12)\r\n                end)\r\n            end\r\n        end\r\n    })\r\n    \r\n    Tabs.Tree:Section({Title = 'Geometry Settings', Icon = 'ruler'})\r\n    \r\n    UI_Layers = Tabs.Tree:Slider({\r\n        Title = 'Total Layers',\r\n        Step = 1,\r\n        Value = {Min = 1, Max = 20, Default = KixTreeConfig.layers},\r\n        Callback = function(v) KixTreeConfig.layers = v end\r\n    })\r\n    \r\n    UI_Spacing = Tabs.Tree:Slider({\r\n        Title = 'Layer Spacing',\r\n        Step = 1,\r\n        Value = {Min = 1, Max = 50, Default = KixTreeConfig.layerSpacing},\r\n        Callback = function(v) KixTreeConfig.layerSpacing = v end\r\n    })\r\n    \r\n    UI_Radius = Tabs.Tree:Slider({\r\n        Title = 'Base Radius',\r\n        Step = 1,\r\n        Value = {Min = 0, Max = 150, Default = KixTreeConfig.circleRadius},\r\n        Callback = function(v) KixTreeConfig.circleRadius = v end\r\n    })\r\n    \r\n    UI_Height = Tabs.Tree:Slider({\r\n        Title = 'Sky Height (0 = Ground)',\r\n        Step = 1,\r\n        Value = {Min = -10, Max = 300, Default = KixTreeConfig.plantHeight},\r\n        Callback = function(v) KixTreeConfig.plantHeight = v end\r\n    })\r\n    \r\n    Tabs.Tree:Section({Title = 'Execution Settings', Icon = 'zap'})\r\n    \r\n    UI_Amount = Tabs.Tree:Slider({\r\n        Title = 'Amount per Layer',\r\n        Step = 1,\r\n        Value = {Min = 1, Max = 1000, Default = KixTreeConfig.amountPerLayer},\r\n        Callback = function(v) KixTreeConfig.amountPerLayer = v end\r\n    })\r\n    \r\n    Tabs.Tree:Input({\r\n        Title = 'Plant Delay (s)',\r\n        Default = tostring(KixTreeConfig.plantDelay),\r\n        Callback = function(v) \r\n            local n = tonumber(v)\r\n            if n then KixTreeConfig.plantDelay = n end\r\n        end\r\n    })\r\n    \r\n    Tabs.Tree:Button({\r\n        Title = 'Auto Plant (Shape)',\r\n        Desc = 'Plant saplings following the selected shape & geometry above.',\r\n        Icon = 'play',\r\n        Callback = function()\r\n            if autoPlantTreeActive then\r\n                autoPlantTreeActive = false\r\n                WindUI:Notify({Title=\"Auto Plant\", Content=\"Stopped.\", Duration=3})\r\n                return\r\n            end\r\n            local remote = _ReplicatedStorage:FindFirstChild(\"RemoteEvents\") and _ReplicatedStorage.RemoteEvents:FindFirstChild(\"RequestPlantItem\") or _ReplicatedStorage:FindFirstChild(\"RequestPlantItem\")\r\n            if not remote then\r\n                WindUI:Notify({Title=\"Auto Plant\", Content=\"Remote RequestPlantItem not found!\", Duration=3, Icon=\"alert-triangle\"})\r\n                return\r\n            end\r\n            local positions = generatePositions()\r\n            if #positions == 0 then\r\n                WindUI:Notify({Title=\"Auto Plant\", Content=\"No positions generated!\", Duration=3})\r\n                return\r\n            end\r\n\r\n            plantRemoteMode = nil\r\n            autoPlantTreeActive = true\r\n            task.spawn(function()\r\n                local skippedCount = 0\r\n                for i = 1, #positions do\r\n                    if not autoPlantTreeActive then break end\r\n                    local pos = positions[i]\r\n                    if isPositionOccupied(pos) then\r\n                        skippedCount = skippedCount + 1\r\n                        continue\r\n                    end\r\n                    local sapling = findSapling()\r\n                    if not sapling then\r\n                        WindUI:Notify({Title=\"Auto Plant\", Content=\"No saplings left! Stopping.\", Duration=3, Icon=\"alert-triangle\"})\r\n                        break\r\n                    end\r\n                    createMarker(pos)\r\n                    robustPlantCall(remote, sapling, pos)\r\n                    task.wait(KixTreeConfig.plantDelay)\r\n                end\r\n                local msg = \"Planting complete!\"\r\n                if skippedCount > 0 then msg = msg .. \" (Skipped \" .. skippedCount .. \" occupied spots)\" end\r\n                WindUI:Notify({Title=\"Auto Plant\", Content=msg, Duration=4, Icon=\"check\"})\r\n                autoPlantTreeActive = false\r\n            end)\r\n        end\r\n    })\r\n    \r\n    ShapeStatus = Tabs.Tree:Paragraph({\r\n        Title = 'Sapling Status',\r\n        Desc = 'Total: 0 | Needed: 0'\r\n    })\r\n    \r\n    local function refreshShapeStatus()\r\n        local total = countSaplingsOnMap()\r\n        local needed = #generatePositions()\r\n        ShapeStatus:SetDesc('Total Saplings: ' .. total .. ' | Needed: ' .. needed)\r\n    end\r\n    \r\n    Tabs.Tree:Button({\r\n        Title = 'Refresh Sapling Status',\r\n        Callback = refreshShapeStatus\r\n    })\r\n    \r\n\r\n    \r\n    -- ==================== AUTO PLANT REALTIME UI ====================\r\n    Tabs.Tree:Section({Title = 'Auto Plant Realtime'})\r\n    \r\n\r\n    \r\n    Tabs.Tree:Button({\r\n        Title = 'Start Realtime Plant',\r\n        Desc = 'Plants saplings at your feet as you move. Walk/run to draw.',\r\n        Callback = function()\r\n            if realtimePlantActive then\r\n                WindUI:Notify({Title=\"Realtime Plant\", Content=\"Already running.\", Duration=2})\r\n                return\r\n            end\r\n            startRealtimePlant()\r\n            WindUI:Notify({Title=\"Realtime Plant\", Content=\"Started! Walk to draw.\", Duration=3})\r\n        end\r\n    })\r\n    \r\n    Tabs.Tree:Button({\r\n        Title = 'Stop Realtime Plant',\r\n        Callback = function()\r\n            stopRealtimePlant()\r\n            WindUI:Notify({Title=\"Realtime Plant\", Content=\"Stopped.\", Duration=2})\r\n        end\r\n    })\r\n    \r\n    -- ==================== AUTO PLANT NAME DESIGN UI ====================\r\n    Tabs.Tree:Section({Title = 'Auto Plant Name Design'})\r\n    \r\n    Tabs.Tree:Input({\r\n        Title = 'Name Text',\r\n        Default = KixNameConfig.text,\r\n        Placeholder = 'example: KIX IS VERY HANDSOME',\r\n        Callback = function(v) KixNameConfig.text = v end\r\n    })\r\n    \r\n    Tabs.Tree:Dropdown({\r\n        Title = 'Font Theme',\r\n        Values = {'Block 5x7', 'Bold 5x7', 'Thin 3x5', 'Outline 5x7'},\r\n        Value = KixNameConfig.theme,\r\n        Callback = function(v) KixNameConfig.theme = v end\r\n    })\r\n    \r\n    Tabs.Tree:Dropdown({\r\n        Title = 'Layout Mode',\r\n        Values = {'Single', 'Top'},\r\n        Value = KixNameConfig.layoutMode,\r\n        Callback = function(v) KixNameConfig.layoutMode = v end\r\n    })\r\n    \r\n    Tabs.Tree:Slider({\r\n        Title = 'Words Per Line (Mode Top)',\r\n        Step = 1,\r\n        Value = {Min = 1, Max = 5, Default = KixNameConfig.wordsPerLine},\r\n        Callback = function(v) KixNameConfig.wordsPerLine = v end\r\n    })\r\n    \r\n    Tabs.Tree:Slider({\r\n        Title = 'Text Size (stud/dot)',\r\n        Step = 1,\r\n        Value = {Min = 2, Max = 150, Default = KixNameConfig.dotSpacing},\r\n        Callback = function(v) KixNameConfig.dotSpacing = v end\r\n    })\r\n    \r\n    Tabs.Tree:Slider({\r\n        Title = 'Letter Spacing (dot gap)',\r\n        Step = 1,\r\n        Value = {Min = 1, Max = 50, Default = KixNameConfig.charGap},\r\n        Callback = function(v) KixNameConfig.charGap = v end\r\n    })\r\n    \r\n    Tabs.Tree:Slider({\r\n        Title = 'Line Spacing (dot gap)',\r\n        Step = 1,\r\n        Value = {Min = 1, Max = 50, Default = KixNameConfig.lineGap},\r\n        Callback = function(v) KixNameConfig.lineGap = v end\r\n    })\r\n    \r\n    Tabs.Tree:Toggle({\r\n        Title = 'Set Name (Preview)',\r\n        Desc = 'Toggles name preview (blue blocks). Can be active alongside shape preview.',\r\n        Default = false,\r\n        Callback = function(v)\r\n            namePreviewEnabled = v\r\n            if namePreviewEnabled then\r\n                if not namePreviewTask then\r\n                    namePreviewTask = task.spawn(function()\r\n                        while namePreviewEnabled do updateNamePreview(); task.wait(0.1) end\r\n                    end)\r\n                end\r\n            else\r\n                if namePreviewTask then task.cancel(namePreviewTask); namePreviewTask = nil end\r\n                clearNamePreview()\r\n                KixNameConfig.lockedCenter = nil -- clear lock\r\n            end\r\n        end\r\n    })\r\n    \r\n    NameStatus = Tabs.Tree:Paragraph({\r\n        Title = 'Sapling Status',\r\n        Desc = 'Total: 0 | Needed: 0'\r\n    })\r\n    \r\n    local function refreshNameStatus()\r\n        local total = countSaplingsOnMap()\r\n        local needed = #generateNamePositions()\r\n        NameStatus:SetDesc('Total Saplings: ' .. total .. ' | Needed: ' .. needed)\r\n    end\r\n    \r\n    Tabs.Tree:Button({\r\n        Title = 'Apply Auto Plant Name Design',\r\n        Desc = 'Locks preview to your current position, applies settings, and updates status.',\r\n        Callback = function()\r\n            local center = getTargetCenter()\r\n            local char = _LocalPlayer.Character\r\n            local hrp = char and char:FindFirstChild(\"HumanoidRootPart\")\r\n            if hrp then\r\n                local right = hrp.CFrame.RightVector\r\n                local forward = hrp.CFrame.LookVector\r\n                KixNameConfig.lockedCenter = center\r\n                KixNameConfig.lockedRight = Vector3.new(right.X, 0, right.Z).Unit\r\n                KixNameConfig.lockedForward = Vector3.new(forward.X, 0, forward.Z).Unit\r\n            else\r\n                KixNameConfig.lockedCenter = nil\r\n            end\r\n\r\n            namePreviewEnabled = true\r\n            if not namePreviewTask then\r\n                namePreviewTask = task.spawn(function()\r\n                    while namePreviewEnabled do updateNamePreview(); task.wait(0.1) end\r\n                end)\r\n            end\r\n            refreshNameStatus()\r\n            WindUI:Notify({Title=\"Name Design\", Content=\"Applied! Preview Locked ON.\", Duration=3})\r\n        end\r\n    })\r\n    \r\n    Tabs.Tree:Button({\r\n        Title = 'Refresh Sapling Status',\r\n        Callback = refreshNameStatus\r\n    })\r\n    \r\n    Tabs.Tree:Button({\r\n        Title = 'Start Auto Plant Name',\r\n        Desc = 'Starts planting the name text, centered at the locked position.',\r\n        Callback = startAutoPlantName\r\n    })\r\n    \r\n\r\n    local origCleanupTree = getgenv().KixHubCleanup\r\n    getgenv().KixHubCleanup = function()\r\n        realtimePlantActive = false\r\n        autoPlantNameActive = false\r\n        namePreviewEnabled = false\r\n        if namePreviewTask then task.cancel(namePreviewTask); namePreviewTask = nil end\r\n        clearNamePreview()\r\n        if origCleanupTree then origCleanupTree() end\r\n    end\r\n    \r\nend)\r\n-- ==================== ANTI VOID SENSOR ====================\r\n-- Smart: Raycast ke bawah untuk cek apakah ada lantai (cave aman, void = no ground)\r\ndo (function()\r\n    _G.AntiVoidEnabled = _G.AntiVoidEnabled == nil and true or _G.AntiVoidEnabled\r\n    local antiVoidCooldown = false\r\n    local VOID_Y_MIN = campfirePos.Y - 30 -- Batas minimum Y sebelum mulai cek void\r\n    local RAYCAST_DISTANCE = 200 -- Jarak raycast ke bawah untuk cari lantai\r\n    local FALL_SPEED_THRESHOLD = -50 -- Hanya trigger jika jatuh dengan kecepatan tinggi\r\n    local lastSafePos = campfirePos -- Posisi aman terakhir (fallback = campfire)\r\n    \r\n    local rayParams = RaycastParams.new()\r\n    rayParams.FilterType = Enum.RaycastFilterType.Exclude\r\n    \r\n    -- [OPTIMASI POINT 3]: Anti-Void berjalan menggunakan task.wait(0.1) daripada Heartbeat (60 FPS)\r\n    task.spawn(function()\r\n    while KixHubSession.Alive do\r\n        task.wait(0.1)\r\n        if not KixHubSession.Alive then break end\r\n        if not _G.AntiVoidEnabled then continue end\r\n        if antiVoidCooldown then continue end\r\n        \r\n        pcall(function()\r\n            local char = _LocalPlayer.Character\r\n            if not char then return end\r\n            local hrp = char:FindFirstChild(\"HumanoidRootPart\")\r\n            if not hrp then return end\r\n            \r\n            -- Whitelist Alien Command Ship\r\n            local shipCF = workspace:GetAttribute(\"AlienCommandShipCF\")\r\n            if shipCF and (hrp.Position - shipCF.Position).Magnitude < 2000 then\r\n                -- Player berada di area Alien Command Ship, abaikan anti-void\r\n                lastSafePos = hrp.Position\r\n                return\r\n            end\r\n\r\n            -- =====================================================\r\n            -- WHITELIST THE HOLLOW / HOLLOWMAP\r\n            -- Ditandai dengan adanya Part di workspace.HollowMap.HollowBoundary\r\n            -- atau posisi berada di area The Hollow (Y < -50 dan Z > 5000)\r\n            -- =====================================================\r\n            local hollowMap = _Workspace:FindFirstChild(\"HollowMap\")\r\n            if hollowMap then\r\n                local hollowBoundary = hollowMap:FindFirstChild(\"HollowBoundary\")\r\n                local hasBoundaryParts = hollowBoundary and hollowBoundary:FindFirstChildWhichIsA(\"BasePart\") ~= nil\r\n                local inHollowArea = hrp.Position.Y < -50 and hrp.Position.Z > 5000\r\n                \r\n                if hasBoundaryParts or inHollowArea then\r\n                    -- Player sedang di The Hollow: Matikan Anti Void sepenuhnya agar tidak diteleport ke Campfire!\r\n                    lastSafePos = hrp.Position\r\n                    return\r\n                end\r\n            end\r\n            \r\n            -- Dual Threshold: Normal = -11 (30 studs bawah campfire), Combat = -80 (batas darurat ngebug)\r\n            local isInCombat = _G.CampfireCombatActive or _G.IsStrongholdRaidActive or (_G.IsSpectating and _G.NinjaAssistActive)\r\n            local COMBAT_EMERGENCY_Y = campfirePos.Y - 100 -- 100 studs dibawah campfire = pasti ngebug\r\n            \r\n            if isInCombat then\r\n                -- Saat combat: hanya selamatkan jika jatuh SANGAT jauh (ngebug)\r\n                if hrp.Position.Y >= COMBAT_EMERGENCY_Y then return end\r\n            else\r\n                -- Normal: batas standar\r\n                if hrp.Position.Y >= VOID_Y_MIN then\r\n                    -- Masih aman! Simpan posisi ini sebagai titik aman terakhir\r\n                    lastSafePos = hrp.Position\r\n                    return\r\n                end\r\n            end\r\n            \r\n            -- Cek apakah ada lantai di bawah (cave = ada lantai, void = tidak ada)\r\n            rayParams.FilterDescendantsInstances = {char}\r\n            local rayResult = workspace:Raycast(hrp.Position, Vector3.new(0, -RAYCAST_DISTANCE, 0), rayParams)\r\n            \r\n            if rayResult then\r\n                -- Ada lantai di bawah = player di dalam cave, AMAN! Jangan ganggu.\r\n                lastSafePos = hrp.Position\r\n                return\r\n            end\r\n            \r\n            -- Tidak ada lantai sama sekali DAN player jatuh cepat = VOID!\r\n            local fallSpeed = hrp.Velocity.Y\r\n            if fallSpeed > FALL_SPEED_THRESHOLD then return end -- Belum jatuh cukup cepat\r\n            \r\n            antiVoidCooldown = true\r\n            \r\n            -- Jika Noclip aktif, matikan paksa agar tidak tembus tanah lagi setelah diselamatkan\r\n            if NoclipEnabled then\r\n                if type(stopNoclip) == \"function\" then stopNoclip() end\r\n                if NoclipToggle and type(safeToggle) == \"function\" then safeToggle(NoclipToggle, false) end\r\n                WindUI:Notify({Title = 'System', Content = 'Noclip auto-disabled by Anti Void!', Duration = 3})\r\n            end\r\n            \r\n            -- Hentikan momentum jatuh\r\n            hrp.Velocity = Vector3.new(0, 0, 0)\r\n            if hrp:FindFirstChild(\"BodyVelocity\") then hrp.BodyVelocity:Destroy() end\r\n            \r\n            -- Teleport: Kembali ke X & Z posisi terakhir, tapi ketinggian Y dipatok sejajar dengan Campfire\r\n            hrp.Anchored = true\r\n            hrp.CFrame = CFrame.new(lastSafePos.X, 15.77 + 5, lastSafePos.Z)\r\n            task.wait(0.2)\r\n            hrp.Anchored = false\r\n            \r\n            WindUI:Notify({\r\n                Title = \"Anti Void\",\r\n                Content = \"You were saved from falling into the void!\",\r\n                Duration = 3\r\n            })\r\n            \r\n            task.delay(2, function() antiVoidCooldown = false end)\r\n        end)\r\n    end\r\n    end)\r\n    \r\n    -- Register ke cleanup agar bisa di-disconnect saat re-execute\r\n    \r\n\r\nlocal origCleanup = getgenv().KixHubCleanup\r\n    getgenv().KixHubCleanup = function()\r\n        _G.AntiVoidEnabled = false\r\n        if antiVoidConn then antiVoidConn:Disconnect() end\r\n        if origCleanup then origCleanup() end\r\n    end\r\n\r\nend)() end\r\n-- ==================== ANTI VOID SENSOR (ITEMS) ====================\r\n-- Mencegah item jatuh ke void dengan memberikan platform penyangga selama 15 detik sebelum dilempar ke Campfire.\r\ndo (function()\r\n    _G.AntiVoidItemsEnabled = _G.AntiVoidItemsEnabled == nil and false or _G.AntiVoidItemsEnabled\r\n    _G.KixVoidTrashItems = _G.KixVoidTrashItems or setmetatable({}, {__mode = \"k\"})\r\n    local ITEM_VOID_Y = campfirePos.Y - 30 -- Batas jatuh item (Dinaikkan agar mendeteksi goa)\r\n    \r\n    local voidItemTimers = {}\r\n    local antiVoidItemsLoop = true\r\n    \r\n    task.spawn(function()\r\n        while KixHubSession.Alive and task.wait(0.5) do\r\n                                if not _G.AntiVoidItemsEnabled or not antiVoidItemsLoop then continue end\r\n            \r\n            pcall(function()\r\n                local itemsFolder = workspace:FindFirstChild(\"Items\") or workspace:FindFirstChild(\"items\")\r\n                if not itemsFolder then return end\r\n                \r\n                -- Cleanup timer untuk item yang sudah diambil player atau hilang\r\n                for item, _ in pairs(voidItemTimers) do\r\n                    if not item or not item.Parent or not item:IsDescendantOf(workspace) then\r\n                        voidItemTimers[item] = nil\r\n                    end\r\n                end\r\n                -- Cache landmark positions for performance to skip Jungle drops\r\n                local jungleLandmarks = {}\r\n                local map = workspace:FindFirstChild(\"Map\")\r\n                local landmarks = map and map:FindFirstChild(\"Landmarks\")\r\n                if landmarks then\r\n                    local names = {\r\n                        \"Jungle Fight Pit\", \"Jungle MiniTemple1\", \"Jungle MiniTemple2\", \"Jungle MiniTemple3\", \"Jungle MiniTemple4\",\r\n                        \"Polar Bear Den1\", \"Polar Bear Den2\", \"Jail Cellar1\", \"Jail Cellar2\", \"Jail Cellar3\", \"Jail Cellar4\", \"FrogCave\",\r\n                        \"Volcano\", \"AlienMothership\"\r\n                    }\r\n                    for _, name in ipairs(names) do\r\n                        local lm = landmarks:FindFirstChild(name)\r\n                        if lm then table.insert(jungleLandmarks, lm:GetPivot().Position) end\r\n                    end\r\n                end\r\n                \r\n                for _, item in ipairs(itemsFolder:GetChildren()) do\r\n                    if item:IsA(\"Model\") or item:IsA(\"BasePart\") or item:IsA(\"Tool\") then\r\n                        if (_G.KixVoidTrashItems and _G.KixVoidTrashItems[item])\r\n                            or (_G.KixGarbageCollectorItems and _G.KixGarbageCollectorItems[item]) then\r\n                            continue\r\n                        end\r\n                        -- Exclude chests and structures that are legitimately underground\r\n                        local itemName = item.Name\r\n                        if string.find(itemName, \"Chest\") or string.find(itemName, \"chest\") or string.find(itemName, \"Stronghold\") or string.find(itemName, \"Rift\") then\r\n                            continue\r\n                        end\r\n                        \r\n                        -- ==================== MODE KHUSUS AUTO CHEST ====================\r\n                        if _G.AutoChestAntiVoidMode then\r\n                            local isMedicineItem = itemName == \"Bandage\" or itemName == \"MedKit\" or itemName == \"Medkit\"\r\n                            local isWhitelisted = not isMedicineItem and (table.find(autoChestBringItems, itemName)\r\n                                or SinglePriorityLoot[itemName]\r\n                                or UnlimitedPriorityLoot[itemName])\r\n                                \r\n                            if not isWhitelisted then\r\n                                continue\r\n                            end\r\n                            \r\n                            -- FILTER LIMIT (SESUAI JUMLAH PLAYER)\r\n                            -- Strong Axe dan barang super langka (Prioritas 1) & Medicine tidak dibatasi agar bisa bawa banyak sekaligus!\r\n                            local isLimitExempt = SinglePriorityLoot[itemName] or UnlimitedPriorityLoot[itemName] or itemName == \"Strong Axe\" or itemName == \"Bandage\" or itemName == \"MedKit\" or string.find(itemName, \"Defense Blueprint\")\r\n                            \r\n                            -- Khusus Iron Body: dikesampingkan (dibatasi maksimal 1 saja agar markas tidak penuh)\r\n                            if itemName == \"Iron Body\" then\r\n                                _G.AutoChestBroughtCounts = _G.AutoChestBroughtCounts or {}\r\n                                local count = _G.AutoChestBroughtCounts[\"Iron Body\"] or 0\r\n                                if count >= 3 then\r\n                                    continue -- Sudah