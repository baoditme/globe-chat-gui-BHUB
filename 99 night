\n                                                    )\r\n                                                end)\r\n                                                if rapidMelee then\r\n                                                    rapidMeleeRequests[enemy] = nil\r\n                                                end\r\n                                            end)\r\n                                        end\r\n                                    end\r\n                                end\r\n                            end\r\n                        end\r\n                    end\r\n                end\r\n\r\n\r\n                if foundEnemy then\r\n                    if needsKillBodyAura then\r\n                        task.wait(0.05)\r\n                        _G.KixHubAuraLock = false\r\n                    end\r\n                end\r\n                local attackDelay=0.55\r\n                local cd=actualWeapon:GetAttribute(\"ToolCooldown\")\r\n\r\n                if cd then\r\n                    attackDelay=cd+0.01\r\n                else\r\n                    local toolHandle=\r\n                        char:FindFirstChild(\"ToolHandle\")\r\n                        or char:FindFirstChild(actualWeapon.Name)\r\n\r\n                    local heldCooldown=\r\n                        toolHandle\r\n                        and toolHandle:GetAttribute(\"ToolCooldown\")\r\n\r\n                    if heldCooldown then\r\n                        attackDelay=heldCooldown+0.01\r\n                    end\r\n                end\r\n\r\n                if actualWeapon.Name==\"Flamethrower\" then\r\n                    attackDelay=cd and cd or 0.1\r\n                end\r\n\r\n                -- These melee weapons benefit from rapid aura retries. Keep only\r\n                -- one outstanding request per target to avoid stacking remotes.\r\n                if rapidMelee then\r\n                    attackDelay = math.min(attackDelay, 0.05)\r\n                end\r\n\r\n                task.wait(attackDelay)\r\n            end\r\n\r\n        end)\r\n\r\n    end\r\nend\r\n\r\n-- Pause Kill Aura while a Taming Flute or supported Sack is held. Detection is event-driven;\r\n-- only the equipped character and ToolHandle's OriginalItem reference are inspected.\r\ndo (function()\r\n    local state = {Equipped = false, Resume = false, CharConnections = {}, HandleConnections = {}, PlayerConnection = nil}\r\n    local pauseToolNames = {\r\n        [\"Taming Flute\"] = true,\r\n        [\"Old Taming Flute\"] = true,\r\n        [\"Good Taming Flute\"] = true,\r\n        [\"Strong Taming Flute\"] = true,\r\n        [\"Old Sack\"] = true,\r\n        [\"Good Sack\"] = true,\r\n        [\"Giant Sack\"] = true\r\n    }\r\n\r\n    local function isPauseTool(item)\r\n        if not item then return false end\r\n        local toolName = item:GetAttribute(\"ToolName\")\r\n        return toolName == \"Taming Flute\"\r\n            or pauseToolNames[item.Name] == true\r\n    end\r\n\r\n    local function syncToggle(value)\r\n        if alienTechFinisherEnabled and value == true then value = false end\r\n        local toggle = _G.KillAuraToggle\r\n        if toggle and type(toggle.Set) == \"function\" then\r\n            pcall(function() toggle:Set(value, false, true) end)\r\n        end\r\n    end\r\n\r\n    local function setEquipped(value)\r\n        value = value == true\r\n        if state.Equipped == value then return end\r\n\r\n        if value then\r\n            state.Resume = killAuraEnabled == true\r\n            state.Equipped = true\r\n            killAuraEnabled = false\r\n            syncToggle(false)\r\n            return\r\n        end\r\n\r\n        local shouldResume = state.Resume\r\n        state.Resume = false\r\n        state.Equipped = false\r\n        if shouldResume then\r\n            toggleKillAura(true)\r\n            syncToggle(true)\r\n        else\r\n            killAuraEnabled = false\r\n            syncToggle(false)\r\n        end\r\n    end\r\n\r\n    function state.Refresh()\r\n        local character = _LocalPlayer.Character\r\n        if not character then\r\n            setEquipped(false)\r\n            return\r\n        end\r\n\r\n        local held = false\r\n        for _, child in ipairs(character:GetChildren()) do\r\n            if isPauseTool(child) then held = true; break end\r\n        end\r\n        if not held then\r\n            local handle = character:FindFirstChild(\"ToolHandle\")\r\n            local original = handle and handle:FindFirstChild(\"OriginalItem\")\r\n            held = original and original:IsA(\"ObjectValue\") and isPauseTool(original.Value) or false\r\n        end\r\n        setEquipped(held)\r\n    end\r\n\r\n    function state.Request(value)\r\n        state.Refresh()\r\n        if state.Equipped then\r\n            state.Resume = value == true\r\n            -- Defer the visual sync so it also wins over automation code that\r\n            -- updates the toggle immediately after requesting Kill Aura.\r\n            task.defer(function() syncToggle(false) end)\r\n            return false\r\n        end\r\n        return value == true\r\n    end\r\n\r\n    function state.IsEquipped()\r\n        return state.Equipped\r\n    end\r\n\r\n    local function disconnect(list)\r\n        for _, connection in ipairs(list) do\r\n            pcall(function() connection:Disconnect() end)\r\n        end\r\n        table.clear(list)\r\n    end\r\n\r\n    local function bindCharacter(character)\r\n        disconnect(state.CharConnections)\r\n        disconnect(state.HandleConnections)\r\n        if not character then state.Refresh(); return end\r\n\r\n        local watchedHandle\r\n        local function bindHandle(handle)\r\n            if not handle or watchedHandle == handle then return end\r\n            disconnect(state.HandleConnections)\r\n            watchedHandle = handle\r\n            table.insert(state.HandleConnections, handle.ChildAdded:Connect(function(child)\r\n                if child.Name == \"OriginalItem\" and child:IsA(\"ObjectValue\") then\r\n                    table.insert(state.HandleConnections, child:GetPropertyChangedSignal(\"Value\"):Connect(state.Refresh))\r\n                end\r\n                state.Refresh()\r\n            end))\r\n            table.insert(state.HandleConnections, handle.ChildRemoved:Connect(state.Refresh))\r\n            local original = handle:FindFirstChild(\"OriginalItem\")\r\n            if original and original:IsA(\"ObjectValue\") then\r\n                table.insert(state.HandleConnections, original:GetPropertyChangedSignal(\"Value\"):Connect(state.Refresh))\r\n            end\r\n        end\r\n\r\n        table.insert(state.CharConnections, character.ChildAdded:Connect(function(child)\r\n            if child.Name == \"ToolHandle\" then bindHandle(child) end\r\n            state.Refresh()\r\n        end))\r\n        table.insert(state.CharConnections, character.ChildRemoved:Connect(function(child)\r\n            if child == watchedHandle then\r\n                disconnect(state.HandleConnections)\r\n                watchedHandle = nil\r\n            end\r\n            state.Refresh()\r\n        end))\r\n        bindHandle(character:FindFirstChild(\"ToolHandle\"))\r\n        state.Refresh()\r\n    end\r\n\r\n    state.Stop = function()\r\n        disconnect(state.CharConnections)\r\n        disconnect(state.HandleConnections)\r\n        if state.PlayerConnection then state.PlayerConnection:Disconnect(); state.PlayerConnection = nil end\r\n    end\r\n\r\n    _G.KixAuraEquipPause = state\r\n    state.PlayerConnection = _LocalPlayer.CharacterAdded:Connect(bindCharacter)\r\n    bindCharacter(_LocalPlayer.Character)\r\nend)() end\r\n\r\n\r\n--========================================================--\r\n-- KILL AURA TOGGLE\r\n--========================================================--\r\nlocal setAlienTechCombatState\r\nkillAuraToggle = Tabs.Combat:Toggle({\