dRootPart\r\n                                        local dist=(eHrp.Position-currentPos).Magnitude\r\n\r\n                                        if dist<minDistance then\r\n                                            minDistance=dist\r\n                                            target=cultist\r\n                                            tp=eHrp.Position\r\n                                        end\r\n                                    end\r\n                                end\r\n                            end\r\n\r\n                            if target\r\n                                and tostring(target:GetAttribute(\"NPCType\"))==\"Thanksgiving Guest\" then\r\n                                target=nil\r\n                                tp=nil\r\n                                continue\r\n                            end\r\n\r\n                            if target then\r\n                                lastCultistName=target.Name\r\n                                local targetHRP=target:FindFirstChild(\"HumanoidRootPart\")\r\n\r\n                                if targetHRP then\r\n                                    lastCultistDeathPosition=targetHRP.Position\r\n                                elseif tp then\r\n                                    lastCultistDeathPosition=tp\r\n                                end\r\n                            end\r\n\r\n                            if not target or not tp then\r\n                                local isSpecialCultist=false\r\n\r\n                                if lastCultistName then\r\n                                    isSpecialCultist=\r\n                                        lastCultistName==\"Shadow Cultist\"\r\n                                        or lastCultistName==\"Darkstring Cultist\"\r\n                                        or lastCultistName==\"Brutal Cultist\"\r\n                                end\r\n\r\n                                if isSpecialCultist then\r\n                                    local waited=0\r\n                                    local foundRespawn=false\r\n\r\n                                    while waited<100\r\n                                        and _G.AutoKillGlobalCultistActive\r\n                                        and not _G.IsStrongholdRaidActive\r\n                                        and not _G.CampfireCombatActive\r\n                                        and not shouldYieldGlobalCultistToCampfire(chars) do\r\n\r\n                                        task.wait(0.1)\r\n                                        waited=waited+1\r\n\r\n                                        for _,cultist in ipairs(chars:GetChildren()) do\r\n                                            if string.find(cultist.Name,\"Cultist\")\r\n                                                and not string.find(cultist.Name,\"Resurrected\")\r\n                                                and tostring(cultist:GetAttribute(\"NPCType\"))~=\"Thanksgiving Guest\"\r\n                                                and not IsCultistInIceBlock(cultist)\r\n                                                and cultist:FindFirstChild(\"HumanoidRootPart\") then\r\n\r\n                                                local eHum=cultist:FindFirstChildWhichIsA(\"Humanoid\")\r\n\r\n                                                if not eHum or eHum.Health>0 then\r\n                                                    foundRespawn=true\r\n                                                    break\r\n                                                end\r\n                                            end\r\n                                        end\r\n\r\n                                        if foundRespawn then\r\n                                            break\r\n                                        end\r\n                                    end\r\n\r\n                                    if foundRespawn then\r\n                                        continue\r\n                                    else\r\n                                        break\r\n                                    end\r\n                                else\r\n                                    break\r\n                                end\r\n                            end\r\n\r\n                            if IsCultistInIceBlock(target)\r\n                                or tostring(target:GetAttribute(\"NPCType\"))==\"Thanksgiving Guest\" then\r\n                                target=nil\r\n                                tp=nil\r\n                                continue\r\n                            end\r\n\r\n                            if target\r\n                                and target:FindFirstChild(\"HumanoidRootPart\") then\r\n                                lastCultistDeathPosition=\r\n                                    target.HumanoidRootPart.Position\r\n                            elseif tp then\r\n                                lastCultistDeathPosition=tp\r\n                            end\r\n\r\n                            local cultistAimPart = target:FindFirstChild('HumanoidRootPart')\r\n                                or target:FindFirstChild('Head')\r\n                            local destPos\r\n                            if _G.AlienTechCombatEnabled and cultistAimPart then\r\n                                destPos = cultistAimPart.Position\r\n                                    + (cultistAimPart.CFrame.RightVector * ALIEN_TECH_SIDE_OFFSET)\r\n                            else\r\n                                destPos = Vector3.new(tp.X, tp.Y - 14, tp.Z)\r\n                            end\r\n                            local startPos=hrp.Position\r\n                            local jumpDist=(destPos-startPos).Magnitude\r\n\r\n                            if jumpDist>1500 then\r\n                                local steps=math.ceil(jumpDist/1500)\r\n\r\n                                for i=1,steps do\r\n                                    if not _G.AutoKillGlobalCultistActive then\r\n                                        break\r\n                                    end\r\n\r\n                                    local lerpPos=startPos:Lerp(destPos,i/steps)\r\n                                    hrp.CFrame=CFrame.new(lerpPos)\r\n                                    task.wait(0.05)\r\n                                end\r\n                            else\r\n                                hrp.CFrame=CFrame.new(destPos)\r\n                            end\r\n\r\n                            if target\r\n                                and tostring(target:GetAttribute(\"NPCType\"))~=\"Thanksgiving Guest\" then\r\n\r\n                                local targetHum=\r\n                                    target:FindFirstChildWhichIsA(\"Humanoid\")\r\n\r\n                                if targetHum then\r\n                                    _G.KixSetNativeCameraSubject(targetHum)\r\n                                end\r\n                            else\r\n                                target=nil\r\n                                tp=nil\r\n                                continue\r\n                            end\r\n\r\n                            local map=_Workspace:FindFirstChild(\"Map\")\r\n                            local iceTemple=\r\n                                map\r\n                                and map:FindFirstChild(\"Landmarks\")\r\n                                and map.Landmarks:FindFirstChild(\"Ice Temple\")\r\n\r\n                            local isAtIceTemple=false\r\n\r\n                            if iceTemple and target and tp then\r\n                                local dist=\r\n                                    (tp-iceTemple:GetPivot().Position).Magnitude\r\n\r\n                                if dist<250 then\r\n                                    isAtIceTemple=true\r\n                                end\r\n                            end\r\n\r\n                            if isAtIceTemple then\r\n                                _G.GlobalCultistCombatActive=false\r\n                                _G.CultistIceChopActive=true\r\n                                syncAuraDamageTool(\"axe\")\r\n\r\n                                local wasChop=chopAuraEnabled\r\n\r\n                                if not wasChop then\r\n                                    toggleChopAura(true)\r\n                                end\r\n\r\n                                task.wait(3.5)\r\n\r\n                                _G.CultistIceChopActive=false\r\n                                _G.GlobalCultistCombatActive=true\r\n\r\n                                if not wasChop then\r\n                                    toggleChopAura(false)\r\n                                end\r\n                            end\r\n\r\n                            task.wait(0.1)\r\n                        end\r\n\r\n                        if noclipGlobalCultist then\r\n                            noclipGlobalCultist:Disconnect()\r\n                        end\r\n\r\n                        for part,state in pairs(savedCollisions) do\r\n                            if part and part.Parent then\r\n                                part.CanCollide=state\r\n                            end\r\n                        end\r\n\r\n                        if hum then\r\n                            hum.WalkSpeed=origWalkSpeed\r\n                            hum.JumpPower=origJumpPower\r\n                            hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll,true)\r\n                            hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown,true)\r\n                            hum:SetStateEnabled(Enum.HumanoidStateType.Physics,true)\r\n                            hum:SetStateEnabled(Enum.HumanoidStateType.Flying,true)\r\n                            hum:SetStateEnabled(Enum.HumanoidStateType.Freefall,true)\r\n                        end\r\n\r\n                        if hum then\r\n                            workspace.CurrentCamera.CameraSubject=hum\r\n                        end\r\n\r\n                        _G.GlobalCultistCombatActive=false\r\n\r\n                        if not _G.IsStrongholdRaidActive\r\n                            and not _G.CampfireCombatActive\r\n                            and not _G.CorruptedCombatActive\r\n                            and not _G.MossyCombatActive\r\n                            and not _G.TurkeyCombatActive\r\n                            and not _G.BearCombatActive then\r\n                            _G.AllowBodyAura=false\r\n                        end\r\n\r\n                        local staticFlyNode=hrp:FindFirstChild(\"CombatStaticFly\")\r\n                        if staticFlyNode then\r\n                            staticFlyNode:Destroy()\r\n                        end\r\n\r\n                        if not wasFlying then\r\n                            stopFlying()\r\n                        end\r\n\r\n                        if not wasKillAura then\r\n                            toggleKillAura(false)\r\n                        end\r\n\r\n                        local fallbackPos = (KixHubSavedState and KixHubSavedState.customReturnPos) or customReturnPos or campfirePos or Vector3.new(0, 19, 0)\r\n                        local returnCF = originalPos\r\n\r\n                        if returnToCampfire or not returnCF or returnCF.Position.Y < 5 then\r\n                            returnCF = CFrame.new(\r\n                                fallbackPos.X,\r\n                                fallbackPos.Y + 3,\r\n                                fallbackPos.Z\r\n                            )\r\n                        end\r\n\r\n                        hrp.Anchored=true\r\n                        hrp.CFrame=returnCF\r\n                        task.wait(0.3)\r\n                        hrp.Anchored=false\r\n\r\n                        if wasFlying then\r\n                            task.wait(0.1)\r\n                            startFlying()\r\n                        end\r\n                    end\r\n                end)\r\n            end\r\n        end)\r\n    end\r\nend\r\n\r\n_G.KixAdapters = _G.KixAdapters or {}\r\n_G.KixEngines.AutoKillCultist = function(value)\r\n    if (_G.AutoKillGlobalCultistActive == true) ~= value then _G.KixToggleAutoKillGlobalCultist(value) end\r\nend\r\n_G.KixAdapters.AutoKillCultist = {\r\n    IsEnabled = function()\r\n        return _G.AutoKillGlobalCultistActive == true\r\n    end,\r\n    SetState = function(state)\r\n        return _G.KixEngines.AutoKillCultist(state)\r\n    end\r\n}\r\n\r\n--========================================================--\r\n-- AUTO KILL CULTIST CAMPFIRE\r\n--========================================================--\r\n\r\n_G.CampfireCombatToken = _G.CampfireCombatToken or 0\r\n_G.StrongholdTransition = _G.StrongholdTransition or false\r\n_G.CampfireCombatPaused = _G.CampfireCombatPaused or false\r\n_G.CampfireCombatStrongholdPaused =\r\n    _G.CampfireCombatStrongholdPaused or false\r\n\r\nlocal function toggleAutoKillCampfire(\r\n    val,\r\n    fromAutoStronghold\r\n)\r\n\r\n    if\r\n        val\r\n        and _G.DisableAutoKillCampfire\r\n        and not fromAutoStronghold\r\n    then\r\n        return\r\n    end\r\n\r\n    -- =====================================================\r\n    -- STOP TOTAL\r\n    -- =====================================================\r\n\r\n    if not val then\r\n\r\n        _G.AutoKillCampfireActive = false\r\n\r\n        _G.CampfireCombatToken =\r\n            (_G.CampfireCombatToken or 0) + 1\r\n\r\n        _G.CampfireCombatActive = false\r\n\r\n        return\r\n    end\r\n\r\n    -- =====================================================\r\n    -- START\r\n    -- =====================================================\r\n\r\n    _G.AutoKillCampfireActive = true\r\n\r\n    _G.CampfireCombatToken =\r\n        (_G.CampfireCombatToken or 0) + 1\r\n\r\n    local myCampfireToken =\r\n        _G.CampfireCombatToken\r\n\r\n    -- =====================================================\r\n    -- RESET INTERNAL STRONGHOLD PAUSE\r\n    -- Hanya kalau Stronghold sudah tidak aktif.\r\n    --\r\n    -- CampfireCombatPaused milik user TIDAK disentuh.\r\n    -- =====================================================\r\n\r\n    if\r\n        not _G.IsStrongholdRaidActive\r\n        and not _G.StrongholdTransition\r\n        and not _G.StrongholdPreparingRaid\r\n    then\r\n\r\n        _G.CampfireCombatStrongholdPaused = false\r\n\r\n    end\r\n\r\n    task.spawn(function()\r\n\r\n        while\r\n            _G.AutoKillCampfireActive\r\n            and myCampfireToken == _G.CampfireCombatToken\r\n        do\r\n\r\n            -- =================================================\r\n            -- TEMPORARY PAUSE\r\n            -- Worker TETAP HIDUP.\r\n            -- Tidak melakukan combat saat:\r\n            -- 1. Pause manual\r\n            -- 2. Stronghold sedang berlangsung\r\n            -- 3. Transition sedang berlangsung\r\n            -- =================================================\r\n\r\n            if\r\n                _G.CampfireCombatPaused\r\n                or _G.CampfireCombatStrongholdPaused\r\n                or _G.StrongholdTransition\r\n                or _G.StrongholdPreparingRaid\r\n                or _G.IsStrongholdRaidActive\r\n            then\r\n\r\n                _G.CampfireCombatActive = false\r\n\r\n                task.wait(0.1)\r\n\r\n                continue\r\n            end\r\n\r\n            -- =================================================\r\n            -- JANGAN CAMPFIRE COMBAT SAAT MODE LAIN AKTIF\r\n            -- =================================================\r\n\r\n            if\r\n                _G.IsStrongholdRaidActive\r\n                or _G.CorruptedCombatActive\r\n                or _G.MossyCombatActive\r\n                or _G.TurkeyCombatActive\r\n                or _G.BearCombatActive\r\n                or _G.GlobalCultistCombatActive\r\n            then\r\n\r\n                task.wait(0.5)\r\n\r\n                continue\r\n            end\r\n\r\n            -- =================================================\r\n            -- AUTO CHEST PRIORITY\r\n            -- =================================================\r\n\r\n            if _G.AutoChestRunning then\r\n\r\n                task.wait(0.1)\r\n\r\n                continue\r\n            end\r\n\r\n            task.wait(0.5)\r\n\r\n            -- =================================================\r\n            -- CHECK STATE LAGI\r\n            -- =================================================\r\n\r\n            if\r\n                _G.IsStrongholdRaidActive\r\n                or _G.StrongholdTransition\r\n                or myCampfireToken ~= _G.CampfireCombatToken\r\n                or _G.CampfireCombatPaused\r\n                or _G.CampfireCombatStrongholdPaused\r\n            then\r\n\r\n                continue\r\n            end\r\n\r\n            -- =================================================\r\n            -- COMBAT SESSION\r\n            -- =================================================\r\n\r\n            local shouldStartCombat = false\r\n\r\n            pcall(function()\r\n\r\n                -- =================================================\r\n                -- HARD STOP\r\n                -- =================================================\r\n\r\n                if\r\n                    _G.IsStrongholdRaidActive\r\n                    or _G.StrongholdTransition\r\n                    or myCampfireToken ~= _G.CampfireCombatToken\r\n                    or not _G.AutoKillCampfireActive\r\n                    or _G.CampfireCombatPaused\r\n                    or _G.CampfireCombatStrongholdPaused\r\n                then\r\n\r\n                    return\r\n                end\r\n\r\n                -- =================================================\r\n                -- CHARACTER / TARGET FOLDER\r\n                -- =================================================\r\n\r\n                local chars =\r\n                    _Workspace:FindFirstChild(\"Characters\")\r\n\r\n                local hrp =\r\n                    _LocalPlayer.Character\r\n                    and _LocalPlayer.Character:FindFirstChild(\r\n                        \"HumanoidRootPart\"\r\n                    )\r\n\r\n                if not chars or not hrp then\r\n                    return\r\n                end\r\n\r\n                local campfirePos =\r\n                    Vector3.new(0,19,0)\r\n\r\n                local foundAny = false\r\n\r\n                -- =================================================\r\n                -- DETECT CULTIST\r\n                -- =================================================\r\n\r\n                for _,cultist in ipairs(chars:GetChildren()) do\r\n\r\n                    if\r\n                        string.find(\r\n                            cultist.Name,\r\n                            \"Cultist\"\r\n                        )\r\n                        and not string.find(\r\n                            cultist.Name,\r\n                            \"Resurrected\"\r\n                        )\r\n                        and tostring(\r\n                            cultist:GetAttribute(\"NPCType\")\r\n                        ) ~= \"Thanksgiving Guest\"\r\n                        and cultist:FindFirstChild(\r\n                            \"HumanoidRootPart\"\r\n                        )\r\n                    then\r\n\r\n                        local targetHum =\r\n                            cultist:FindFirstChildWhichIsA(\r\n                                \"Humanoid\"\r\n                            )\r\n\r\n                        if targetHum\r\n                            and targetHum.Health > 0\r\n                        then\r\n\r\n                            local targetPos =\r\n                                cultist.HumanoidRootPart.Position\r\n\r\n                            local dist2D =\r\n                                Vector2.new(\r\n                                    targetPos.X -\r\n                                        campfirePos.X,\r\n                                    targetPos.Z -\r\n                                        campfirePos.Z\r\n                                ).Magnitude\r\n\r\n                            if dist2D <= 300 then\r\n\r\n                                foundAny = true\r\n\r\n                                break\r\n                            end\r\n                        end\r\n                    end\r\n                end\r\n\r\n                if not foundAny then\r\n                    return\r\n                end\r\n\r\n                -- =================================================\r\n                -- HARD STOP AFTER DETECT\r\n                -- =================================================\r\n\r\n                if\r\n                    _G.IsStrongholdRaidActive\r\n                    or _G.StrongholdTransition\r\n                    or myCampfireToken ~= _G.CampfireCombatToken\r\n                    or not _G.AutoKillCampfireActive\r\n                    or _G.CampfireCombatPaused\r\n                    or _G.CampfireCombatStrongholdPaused\r\n                then\r\n\r\n                    return\r\n                end\r\n\r\n                shouldStartCombat = true\r\n\r\n                -- =================================================\r\n                -- SAVE STATE\r\n                -- =================================================\r\n\r\n                local originalPos =\r\n                    hrp.CFrame\r\n\r\n                local wasFlying =\r\n                    flying\r\n\r\n                local wasKillAura =\r\n                    killAuraEnabled\r\n\r\n                -- =================================================\r\n                -- STOP FLYING\r\n                -- =================================================\r\n\r\n                if flying then\r\n                    stopFlying()\r\n                end\r\n\r\n                -- =================================================\r\n                -- STATIC FLY\r\n                -- =================================================\r\n\r\n                local staticFly =\r\n                    Instance.new(\"BodyVelocity\")\r\n\r\n                staticFly.Name =\r\n                    \"CombatStaticFly\"\r\n\r\n                staticFly.MaxForce =\r\n                    Vector3.new(\r\n                        math.huge,\r\n                        math.huge,\r\n                        math.huge\r\n                    )\r\n\r\n                staticFly.Velocity =\r\n                    Vector3.zero\r\n\r\n                staticFly.Parent = hrp\r\n\r\n                -- =================================================\r\n                -- KILL AURA\r\n                -- =================================================\r\n\r\n                if not killAuraEnabled then\r\n\r\n                    auraRadius = 150\r\n\r\n                    toggleKillAura(true)\r\n                end\r\n\r\n                _G.AllowBodyAura = true\r\n                _G.CampfireCombatActive = true\r\n\r\n                syncAuraDamageTool(\"weapon\")\r\n\r\n                -- =================================================\r\n                -- CAMERA\r\n                -- =================================================\r\n\r\n                local campfireCameraTarget = nil\r\n\r\n                -- =================================================\r\n                -- HUMANOID\r\n                -- =================================================\r\n\r\n                local hum =\r\n                    hrp.Parent:FindFirstChild(\"Humanoid\")\r\n\r\n                local origWalkSpeed = 16\r\n                local origJumpPower = 50\r\n\r\n                local savedCollisions = {}\r\n\r\n                for _,part in ipairs(\r\n                    hrp.Parent:GetDescendants()\r\n                ) do\r\n\r\n                    if part:IsA(\"BasePart\") then\r\n                        savedCollisions[part] =\r\n                            part.CanCollide\r\n                    end\r\n                end\r\n\r\n                -- =================================================\r\n                -- NOCLIP\r\n                -- =================================================\r\n\r\n                local noclipCampfire =\r\n                    _RunService.Stepped:Connect(function()\r\n\r\n                        if\r\n                            not hrp\r\n                            or not hrp.Parent\r\n                        then\r\n\r\n                            return\r\n                        end\r\n\r\n                        if not getgenv()._NoclipPartsCache then\r\n                            getgenv()._NoclipPartsCache = {}\r\n                            for _, part in ipairs(hrp.Parent:GetDescendants()) do\r\n                                if part:IsA(\"BasePart\") then table.insert(getgenv()._NoclipPartsCache, part) end\r\n                            end\r\n                        end\r\n                        for i = 1, #getgenv()._NoclipPartsCache do\r\n                            getgenv()._NoclipPartsCache[i].CanCollide = false\r\n                        end\r\n                    end)\r\n\r\n                -- =================================================\r\n                -- FREEZE HUMANOID\r\n                -- =================================================\r\n\r\n                if hum then\r\n\r\n                    origWalkSpeed =\r\n                        hum.WalkSpeed\r\n\r\n                    origJumpPower =\r\n                        hum.JumpPower\r\n\r\n                    hum.WalkSpeed = 0\r\n                    hum.JumpPower = 0\r\n\r\n                    hum:SetStateEnabled(\r\n                        Enum.HumanoidStateType.Ragdoll,\r\n                        false\r\n                    )\r\n\r\n                    hum:SetStateEnabled(\r\n                        Enum.HumanoidStateType.FallingDown,\r\n                        false\r\n                    )\r\n\r\n                    hum:SetStateEnabled(\r\n                        Enum.HumanoidStateType.Physics,\r\n                        false\r\n                    )\r\n\r\n                    hum:SetStateEnabled(\r\n                        Enum.HumanoidStateType.Flying,\r\n                        false\r\n                    )\r\n\r\n                    hum:SetStateEnabled(\r\n                        Enum.HumanoidStateType.Freefall,\r\n                        false\r\n                    )\r\n\r\n                    hum:ChangeState(\r\n                        Enum.HumanoidStateType.RunningNoPhysics\r\n                    )\r\n                end\r\n\r\n                -- =================================================\r\n                -- CAMPFIRE COMBAT LOOP\r\n                -- =================================================\r\n\r\n                while\r\n                    _G.AutoKillCampfireActive\r\n                    and not _G.IsStrongholdRaidActive\r\n                    and not _G.StrongholdTransition\r\n                    and not _G.CorruptedCombatActive\r\n                    and not _G.MossyCombatActive\r\n                    and not _G.TurkeyCombatActive\r\n                    and not _G.BearCombatActive\r\n                    and not _G.GlobalCultistCombatActive\r\n                    and myCampfireToken ==\r\n                        _G.CampfireCombatToken\r\n                    and not _G.CampfireCombatPaused\r\n                    and not _G.CampfireCombatStrongholdPaused\r\n                do\r\n\r\n                    local target = campfireCameraTarget\r\n                    local tp = nil\r\n\r\n                    if target and target.Parent == chars then\r\n                        local lockedRoot = target:FindFirstChild(\"HumanoidRootPart\")\r\n                        local lockedHumanoid = target:FindFirstChildWhichIsA(\"Humanoid\")\r\n                        if lockedRoot and lockedHumanoid and lockedHumanoid.Health > 0\r\n                            and string.find(target.Name, \"Cultist\")\r\n                            and not string.find(target.Name, \"Resurrected\")\r\n                            and tostring(target:GetAttribute(\"NPCType\")) ~= \"Thanksgiving Guest\" then\r\n                            local lockedPos = lockedRoot.Position\r\n                            local lockedDistance = Vector2.new(\r\n                                lockedPos.X - campfirePos.X,\r\n                                lockedPos.Z - campfirePos.Z\r\n                            ).Magnitude\r\n                            if lockedDistance <= 300 then\r\n                                tp = lockedPos\r\n                            else\r\n                                target = nil\r\n                            end\r\n                        else\r\n                            target = nil\r\n                        end\r\n                    else\r\n                        target = nil\r\n                    end\r\n\r\n                    -- =================================================\r\n                    -- FIND TARGET\r\n                    -- =================================================\r\n\r\n                    if not target then\r\n                        for _,cultist in ipairs(chars:GetChildren()) do\r\n\r\n                            if\r\n                                string.find(cultist.Name, \"Cultist\")\r\n                                and not string.find(cultist.Name, \"Resurrected\")\r\n                                and tostring(cultist:GetAttribute(\"NPCType\")) ~= \"Thanksgiving Guest\"\r\n                                and cultist: