n                                        end\r\n\r\n                                        local verifyDeadline = os.clock() + 2.5\r\n                                        while os.clock() < verifyDeadline do\r\n                                            local ingredientFolder = station:FindFirstChild(\"Ingredients\")\r\n                                            local current = ingredientFolder and #ingredientFolder:GetChildren() or 0\r\n                                            if current > prevIngCount or current >= 3 or station:GetAttribute(\"Cooking\") then\r\n                                                confirmed = true\r\n                                                break\r\n                                            end\r\n                                            if item.Parent and item:IsDescendantOf(station) then\r\n                                                confirmed = true\r\n                                                break\r\n                                            end\r\n                                            task.wait(0.08)\r\n                                        end\r\n\r\n                                        if not confirmed then\r\n                                            -- Lepas klaim agar bahan tidak ter-lock 10 detik dan bisa langsung dicoba ulang\r\n                                            if _G.ClaimedItems then\r\n                                                _G.ClaimedItems[item] = os.time() - 8\r\n                                            end\r\n                                            task.wait(0.15)\r\n                                        end\r\n                                    end\r\n                                end\r\n                            end\r\n                        end\r\n                    end\r\n\r\n                    task.wait(1.5)\r\n                end\r\n            end)\r\n        end\r\nend\r\n_G.KixAdapters.AutoCookCrockPot = {IsEnabled = function() r