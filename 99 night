isher = nil\r\n            toggleKillAura(restoreKillAura)\r\n            syncKillAuraToggle(killAuraEnabled)\r\n        end\r\n    end\r\n})\r\n\r\n_G.AutoFarmCorruptedActive=false\r\n_G.CorruptedCombatActive=false\r\n_G.CorruptedChopActive=false\r\n_G.AutoFarmMossyActive=false\r\n_G.MossyCombatActive=false\r\n_G.TurkeyCombatActive=false\r\n_G.BearCombatActive=false\r\n_G.AutoKillCampfireActive=false\r\n_G.GlobalCultistCombatActive=false\r\n_G.AutoKillGlobalCultistActive=false\r\n_G.CultistIceChopActive=false\r\n\r\nlocal function IsCultistInIceBlock(cultist)\r\n    if not cultist then\r\n        return false\r\n    end\r\n    return cultist:FindFirstChild(\"IceBlock\",true)~=nil\r\nend\r\n\r\n--========================================================--\r\n-- AUTO KILL CULTIST GLOBAL\r\n--========================================================--\r\nlocal campfireYieldCheckAt, campfireYieldCached = 0, false\r\nlocal function shouldYieldGlobalCultistToCampfire(chars)\r\n    if not _G.AutoKillCampfireActive or not chars then return false end\r\n    local now = os.clock()\r\n    if now < campfireYieldCheckAt then return campfireYieldCached end\r\n    campfireYieldCheckAt = now + 0.2\r\n    campfireYieldCached = false\r\n    local campfirePos = Vector3.new(0, 19, 0)\r\n    for _, npc in ipairs(chars:GetChildren()) do\r\n        if string.find(npc.Name, \"Cultist\")\r\n            and not string.find(npc.Name, \"Resurrected\")\r\n            and tostring(npc:GetAttribute(\"NPCType\")) ~= \"Thanksgiving Guest\"\r\n            and not IsCultistInIceBlock(npc) then\r\n            local root = npc:FindFirstChild(\"HumanoidRootPart\")\r\n            local humanoid = npc:FindFirstChildWhichIsA(\"Humanoid\")\r\n            if root and humanoid and humanoid.Health > 0 then\r\n                local delta = root.Position - campfirePos\r\n                if Vector2.new(delta.X, delta.Z).Magnitude <= 300 then\r\n                    campfireYieldCached = true\r\n                    