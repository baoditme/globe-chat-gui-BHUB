tation.Name == \"Chefs Station\" or not hasChefsStation) then\r\n                                local closestCore = getClosestCandidate(coreFoods, 1)\r\n                                if closestCore then\r\n                                    table.insert(batchToFeed, table.remove(itemsByName[closestCore], 1))\r\n                                    totalAvailable = totalAvailable - 1\r\n                                    required = required - 1\r\n                                end\r\n                            end\r\n\r\n                            -- Penuhi sisa slot required dengan bahan makanan yang FISIKNYA PALING DEKAT ke Crock Pot\r\n                            while required > 0 do\r\n                                local closestAny = getClosestCandidate({\"Corn\", \"Carrot\", \"Morsel\", \"Cooked Morsel\", \"Steak\", \"Cooked Steak\", \"Ribs\", \"Cooked Ribs\", \"Cake\", \"Salmon\", \"Cooked Salmon\", \"Mackerel\", \"Cooked Mackerel\", \"Clownfish\", \"Jellyfish\", \"Swordfish\", \"Eel\", \"Char\"}, 1)\r\n                                if closestAny then\r\n                                    table.insert(batchToFeed, table.remove(itemsByName[closestAny], 1))\r\n                                    totalAvailable = totalAvailable - 1\r\n                                    required = required - 1\r\n                                else\r\n                                    local fallbackName = nil\r\n                                    local fallbackDist = math.huge\r\n                                    for name, list in pairs(itemsByName) do\r\n                                        if #list > 0 then\r\n                                            local itm = list[1]\r\n                                            local pos = (itm:IsA(\"Model\") and itm:GetPivot().Position) or (itm:IsA(\"BasePart\") and itm.Position) or Vector3.zero\r\n                                            local dist = (pos - stationPos).Magnitude\r\n                                            if dist < fallbackDist then\r\n                                                fallbackDist = dist\r\n                                                fallbackName = name\r\n                                            end\r\n                                        end\r\n                                    end\r\n                                    if fallbackName then\r\n                                        table.insert(batchToFeed, table.remove(itemsByName[fallbackName], 1))\r\n                                        totalAvailable = totalAvailable - 1\r\n                                        required = required - 1\r\n                                    else\r\n                                        break\r\n                                    end\r\n                                end\r\n                            end\r\n\r\n                            -- If refueling started while this batch was being prepared, reserve vegetables for Biofuel.\r\n                            if autoBiofuelSmart and isBiofuelFilling then\r\n                                for i = #batchToFeed, 1, -1 do\r\n                                    if isReservedForBiofuel(batchToFeed[i]) then\r\n                                        table.remove(batchToFeed, i)\r\n                                    end\r\n                                end\r\n                            end\r\n\r\n                            if #batchToFeed > 0 then\r\n                                _G.StationFeedAttempts[station] = true\r\n                                _G.StationLastIngredients[station] = ingredientsCount\r\n                                _G.StationBlacklistTime[station] = os.time()\r\n\r\n                                _G.ClaimedItems = _G.ClaimedItems or {}\r\n\r\n                                -- Masukkan bahan SATU PER SATU ke dalam Crock Pot secara sekuensial dan presisi\r\n                                for _, item in ipairs(batchToFeed) do\r\n                      