               if th and th:GetAttribute('WeaponResourceDamage') then\r\n                                local orig = th:FindFirstChild('OriginalItem')\r\n                                if orig and orig:IsA('ObjectValue') and orig.Value then\r\n                                    -- Pastikan yang dipegang BENAR-BENAR kapak, bukan pedang yang nyasar punya atribut resource!\r\n                                    local itemName = orig.Value.Name\r\n                                    local isTrueAxe = false\r\n                                    for _, axeName in ipairs(axePriority) do\r\n                                        if itemName == axeName then\r\n                                            isTrueAxe = true\r\n                                            break\r\n                                        end\r\n                                    end\r\n                                    if isTrueAxe then\r\n                                        actualAxe, axeId = orig.Value, 'dummy'\r\n                                    end\r\n                                end\r\n                            end\r\n                        end\r\n                        \r\n                        if actualAxe then\r\n\r\n                            local canChop = true\r\n\r\n                            if canChop then\r\n                                local nearbyTrees = {}\r\n                                local hollowMap = _Workspace:FindFirstChild(\"HollowMap\")\r\n                                for _, t in ipairs(cachedTrees) do\r\n                                    local trunk = t.Trunk\r\n                                    if trunk then\r\n                                        local dist = (trunk.Position - hrp.Position).Magnitude\r\n                                        if dist <= auraRadius then\r\n                                            local isHollowTree = hollowMap and t.Tree and t.Tree:IsDescendantOf(hollowMap)\r\n                                            if not (_G.AutoChopSelectedTreesRunning and isHollowTree) then\r\n                                                table.insert(nearbyTrees, {Tree = t.Tree, Dist = dist})\r\n                                            end\r\n                                        end\r\n                                    end\r\n                                end\r\n                                \r\n                                table.sort(nearbyTrees, function(a, b) return a.Dist < b.Dist end)\r\n                                local needsChopBodyAura = _G.AutoChopSelectedTreesRunning or _G.CorruptedChopActive or _G.CultistIceChopActive or chopAuraEnabled\r\n                                if #nearbyTrees > 0 then\r\n                                    if needsChopBodyAura then\r\n                                        while _G.KixHubAuraLock do task.wait() end\r\n                                        _G.KixHubAuraLock = true\r\n                                        syncAuraDamageTool(\"axe\", actualAxe)\r\n                                    end\r\n                                end\r\n                                \r\n                                local choppedCount = 0\r\n                                for _, data in ipairs(nearbyTrees) do\r\n                                    if choppedCount >= (_G.KixChopAuraMulti or 10) then break end\r\n                                    local currentIter = _G.GetNextAuraIterId()\r\n                                    \r\n                                    local suffix = \"_7367831688\"\r\n                                    if axeId and axeId ~= 'dummy' then\r\n                                        suffix = string.match(axeId, \"(_%d+)$\") or suffix\r\n                                    elseif toolEquipData and toolEquipData[actualAxe.Name] then\r\n                                        suffix = string.match(toolEquipData[actualAxe.Name], \"(_%d+)$\") or suffix\r\n                                    end\r\n                                    local dynamicId = tostring(currentIter) .. suffix\r\n\r\n                                    task.spawn(function()\r\n                                        pcall(function()\r\n                                            _ReplicatedStorage:WaitForChild('RemoteEvents').ToolDamageObject:InvokeServer(data.Tree, actualAxe, dynamicId, CFrame.new(0,0,0))\r\n                                        end)\r\n                                    end)                                    choppedCount = choppedCount + 1\r\n                                end\r\n\r\n                                if needsChopBodyAura then\r\n                                    task.wait(0.05)\r\n                                    if #nearbyTrees > 0 then _G.KixHubAuraLock = false end\r\n                                end\r\n                                local attackDelay = 0.55\r\n                                local cd = actualAxe:GetAttribute('ToolCooldown')\r\n                                if cd then \r\n                                    attackDelay = cd + 0.05 \r\n                                else\r\n                                    local toolHandle = char:FindFirstChild('ToolHandle') or char:FindFirstChild(actualAxe.Name)\r\n                                    local heldCooldown = toolHandle and toolHandle:GetAttribute('ToolCooldown')\r\n                                    if heldCooldown then\r\n                                        attackDelay = heldCooldown + 0.05\r\n                                    end\r\n                                end\r\n                                \r\n                                -- [FAST COOLDOWN BYPASS]: Mempercepat kecepatan serang menjadi minimal 0.01s (Mentok Frame Rate)\r\n                                attackDelay = math.min(attackDelay, 0.01)\r\n                                \r\n                                task.wait(attackDelay)\r\n                            else\r\n                                task.wait(0.5)\r\n                            end\r\n                        else\r\n                            task.wait(0.5)\r\n                        end\r\n                    else\r\n                        task.wait(0.5)\r\n                    end\r\n                end\r\n                chopAuraLoopRunning = false\r\n            end)\r\n        end\r\n    else\r\n        chopAuraLoopRunning = false\r\n    end\r\nend\r\n\r\n-- ==================== BEAR TRAP TROLLER ====================\r\nTabs.Combat:Section({Title = 'Troll / Kill Player', Icon = 'target'})\r\n\r\nbearTrapSelectedPlayers = {}\r\nbearTrapPlayerMap = {}\r\nbearTrapPromptDebounces = {}\r\ngetgenv().KixHub_BearTrap_ToggleID = getgenv().KixHub_BearTrap_ToggleID or 0\r\n\r\nBearTrapPlayerDrop = CreateMultiDropdown(Tabs.Combat, {\r\n    Title = 'Select Target Players',\r\n    Values = {\"None\"},\r\n    Multi = true,\r\n    Callback = function(val)\r\n        bearTrapSelectedPlayers = val or {}\r\n    end\r\n})\r\n\r\n-- Dynamic Auto-Refresh Dropdown (runs in background)\r\n-- =========================================================\r\n-- DYNAMIC PLAYER DROPDOWN\r\n-- Menampilkan SEMUA player yang ada di server.\r\n-- Tidak bergantung pada Character/Humanoid.\r\n-- =========================================================\r\n\r\nlocal lastPlayerListStr = \"\"\r\n\r\nlocal function RefreshBearTrapPlayerList()\r\n    local currentPlayers = {\"None\"}\r\n    local newMap = {}\r\n\r\n    for _, p in ipairs(_Players:GetPlayers()) do\r\n        if p ~= _LocalPlayer then\r\n            -- Gunakan DisplayName untuk tampilan\r\n            -- dan Name sebagai identifier sebenarnya.\r\n            local displayName = p.DisplayName\r\n\r\n            table.insert(currentPlayers, displayName)\r\n            newMap[displayName] = p.Name\r\n        end\r\n    end\r\n\r\n    table.sort(currentPlayers, function(a, b)\r\n        if a == \"None\" then\r\n            return true\r\n        end\r\n\r\n        if b == \"None\" then\r\n            return false\r\n        end\r\n\r\n        return a:lower() < b:lower()\r\n    end)\r\n\r\n    local currentStr = table.concat(currentPlayers, \",\")\r\n\r\n    if currentStr ~= lastPlayerListStr then\r\n        lastPlayerListStr = currentStr\r\n        bearTrapPlayerMap = newMap\r\n\r\n        if BearTrapPlayerDrop then\r\n            pcall(function()\r\n                BearTrapPlayerDrop:Refresh(currentPlayers)\r\n            end)\r\n        end\r\n        \r\n        if FlingPlayerDrop then\r\n            pcall(function()\r\n                FlingPlayerDrop:Refresh(currentPlayers)\r\n            end)\r\n        end\r\n    end\r\nend\r\n\r\n\r\n-- Initial refresh\r\ntask.defer(function()\r\n    task.wait(1)\r\n    RefreshBearTrapPlayerList()\r\nend)\r\n\r\n\r\n-- Player masuk server\r\n_Players.PlayerAdded:Connect(function(player)\r\n    task.defer(function()\r\n        task.wait(0.5)\r\n        RefreshBearTrapPlayerList()\r\n    end)\r\nend)\r\n\r\n\r\n-- Player keluar server\r\n_Players.PlayerRemoving:Connect(function(player)\r\n    task.defer(function()\r\n        RefreshBearTrapPlayerList()\r\n    end)\r\nend)\r\n\r\n\r\n-- Backup refresh.\r\n-- Berguna untuk kasus player sudah ada di server tetapi\r\n-- data UI/list belum tersinkron setelah rejoin.\r\ntask.spawn(function()\r\n    while KixHubSession.Alive and task.wait(2) do\r\n        RefreshBearTrapPlayerList()\r\n    end\r\nend)\r\n\r\nBearTrapStatus = Tabs.Combat:Paragraph({\r\n    Title = \"Trap Status\",\r\n    Desc = \"Status: Idle\"\r\n})\r\n\r\n\r\n-- Unified Kill Logic (One-Time Execution)\r\nlocal function executeKillLoop(targetNamesList)\r\n    getgenv().KixHub_BearTrap_ToggleID=getgenv().KixHub_BearTrap_ToggleID+1\r\n    local myToggleID=getgenv().KixHub_BearTrap_ToggleID\r\n\r\n    local structures=workspace:FindFirstChild(\"Structures\")\r\n\r\n    local validTargets={}\r\n    for _,displayName in ipairs(targetNamesList) do\r\n        local realName=bearTrapPlayerMap[displayName]\r\n        local p=realName and _Players:FindFirstChild(realName)\r\n        if p and p~=_LocalPlayer then\r\n            if not getgenv().IsSelfAdmin and getgenv().IsAdmin(p.UserId) then\r\n                if not getgenv().AdminKillNotifyDebounce then\r\n                    getgenv().AdminKillNotifyDebounce = true\r\n                    if WindUI then WindUI:Notify({Title=\"Admin Protection\", Content=\"YOU CAN'T KILL ADMIN!\", Duration=30}) end\r\n                    task.delay(30, function() getgenv().AdminKillNotifyDebounce = false end)\r\n                end\r\n                continue\r\n            end\r\n\r\n            local hum =\r\n                p.Character\r\n                and p.Character:FindFirstChildWhichIsA(\"Humanoid\")\r\n\r\n            table.insert(validTargets,{\r\n                player=p,\r\n                displayName=displayName,\r\n                maxHp=hum and hum.MaxHealth or 100\r\n            })\r\n\r\n        end\r\n    end\r\n\r\n    if #validTargets==0 then\r\n        BearTrapStatus:SetDesc(\"Status: No valid targets found!\")\r\n        WindUI:Notify({\r\n            Title=\"Bear Trap\",\r\n            Content=\"No live targets found!\",\r\n            Duration=3\r\n        })\r\n        return\r\n    end\r\n\r\n    local requiredCount=#validTargets\r\n\r\n    -- =========================================================\r\n    -- SCAN BLUEPRINT DI INVENTORY / BACKPACK / CHARACTER\r\n    -- =========================================================\r\n    local trapBlueprints={}\r\n    local containers={\r\n        _LocalPlayer:FindFirstChild(\"Inventory\"),\r\n        _LocalPlayer:FindFirstChild(\"Backpack\"),\r\n        _LocalPlayer.Character\r\n    }\r\n\r\n    for _,container in ipairs(containers) do\r\n        if container then\r\n            for _,obj in ipairs(container:GetChildren()) do\r\n                if obj.Name==\"Bear Trap Blueprint\"\r\n                    or obj.Name==\"Volcanic Bear Trap Blueprint\" then\r\n                    table.insert(trapBlueprints,obj)\r\n                end\r\n            end\r\n        end\r\n    end\r\n\r\n    -- =========================================================\r\n    -- PICKUP DARI STRUCTURES JIKA BLUEPRINT MASIH KURANG\r\n    -- Inventory selalu diprioritaskan.\r\n    -- =========================================================\r\n    if #trapBlueprints<requiredCount and structures then\r\n        for _,trap in ipairs(structures:GetChildren()) do\r\n            if #trapBlueprints>=requiredCount then\r\n                break\r\n            end\r\n\r\n            if trap:IsA(\"Model\")\r\n                and (trap.Name==\"Bear Trap\" or trap.Name==\"Volcanic Bear Trap\")\r\n                and trap:HasTag(\"CanBePickedUp\") then\r\n\r\n                local owner=trap:GetAttribute(\"Owner\")\r\n\r\n                if owner==nil\r\n                    or tostring(owner)==tostring(_LocalPlayer.UserId) then\r\n\r\n                    local ok,result=pcall(function()\r\n                        return Client.Events.RequestPickUpStructure:InvokeServer(trap)\r\n                    end)\r\n\r\n                    if ok and result and result.Success then\r\n                        local deadline=os.clock()+2\r\n\r\n                        while os.clock()<deadline do\r\n                            table.clear(trapBlueprints)\r\n\r\n                            for _,container in ipairs(containers) do\r\n                                if container then\r\n                                    for _,obj in ipairs(container:GetChildren()) do\r\n                                        if obj.Name==\"Bear Trap Blueprint\"\r\n                                            or obj.Name==\"Volcanic Bear Trap Blueprint\" then\r\n                                            table.insert(trapBlueprints,obj)\r\n                                        end\r\n                                    end\r\n                                end\r\n                            end\r\n\r\n                            if #trapBlueprints>=requiredCount then\r\n                                break\r\n                            end\r\n\r\n                            task.wait(0.05)\r\n                        end\r\n                    end\r\n\r\n                    task.wait(0.05)\r\n                end\r\n            end\r\n        end\r\n    end\r\n\r\n    -- =========================================================\r\n    -- REFRESH BLUEPRINT TERAKHIR\r\n    -- =========================================================\r\n    table.clear(trapBlueprints)\r\n\r\n    for _,container in ipairs(containers) do\r\n        if container then\r\n            for _,obj in ipairs(container:GetChildren()) do\r\n                if obj.Name==\"Bear Trap Blueprint\"\r\n                    or obj.Name==\"Volcanic Bear Trap Blueprint\" then\r\n                    table.insert(trapBlueprints,obj)\r\n                end\r\n            end\r\n        end\r\n    end\r\n\r\n    -- =========================================================\r\n    -- CARI TARGET TERDEKAT DARI LOCALPLAYER\r\n    -- Hewan liar + PLAYER LAIN YANG MASIH HIDUP\r\n    --\r\n    -- Hewan Tamed = DIABAIKAN\r\n    -- LocalPlayer = DIABAIKAN\r\n    -- 1 TRAP = 1 TARGET\r\n    -- =========================================================\r\n\r\n    local nearbyTargets = {}\r\n\r\n    local localHRP =\r\n        _LocalPlayer.Character\r\n        and _LocalPlayer.Character:FindFirstChild(\"HumanoidRootPart\")\r\n\r\n    local chars =\r\n        _Workspace:FindFirstChild(\"Characters\")\r\n\r\n    local allowedAnimals = {\r\n        [\"Bunny\"] = true,\r\n        [\"Wolf\"] = true,\r\n        [\"Alpha Wolf\"] = true,\r\n        [\"Bear\"] = true,\r\n        [\"Scorpion\"] = true\r\n    }\r\n\r\n    if localHRP then\r\n\r\n        -- =====================================================\r\n        -- 1. SCAN HEWAN LIAR\r\n        -- =====================================================\r\n\r\n        if chars then\r\n\r\n            for _, animal in ipairs(chars:GetChildren()) do\r\n\r\n                if\r\n                    animal:IsA(\"Model\")\r\n                    and animal.Parent\r\n                    and allowedAnimals[animal.Name]\r\n                then\r\n\r\n                    -- Jangan pasang Bear Trap ke hewan Tamed\r\n                    if animal:GetAttribute(\"Tamed\") == true then\r\n                        continue\r\n                    end\r\n\r\n                    local animalHumanoid =\r\n                        animal:FindFirstChildWhichIsA(\"Humanoid\")\r\n\r\n                    -- Pastikan hewan masih hidup jika punya Humanoid\r\n                    if animalHumanoid\r\n                        and animalHumanoid.Health <= 0\r\n                    then\r\n                        continue\r\n                    end\r\n\r\n                    local animalPos = nil\r\n\r\n                    pcall(function()\r\n                        animalPos =\r\n                            animal:GetPivot().Position\r\n                    end)\r\n\r\n                    if animalPos then\r\n\r\n                        table.insert(\r\n                            nearbyTargets,\r\n                            {\r\n                                object = animal,\r\n                                position = animalPos,\r\n                                distance =\r\n                                    (\r\n                                        localHRP.Position\r\n                                        - animalPos\r\n                                    ).Magnitude,\r\n\r\n                                targetType = \"Animal\",\r\n                                player = nil\r\n                            }\r\n                        )\r\n                    end\r\n                end\r\n            end\r\n        end\r\n\r\n        -- =====================================================\r\n        -- 2. SCAN PLAYER LAIN YANG MASIH HIDUP\r\n        -- =====================================================\r\n\r\n        for _, player in ipairs(_Players:GetPlayers()) do\r\n\r\n            if player ~= _LocalPlayer then\r\n\r\n                local character =\r\n                    player.Character\r\n\r\n                local playerHRP =\r\n                    character\r\n                    and character:FindFirstChild(\r\n                        \"HumanoidRootPart\"\r\n                    )\r\n\r\n                local humanoid =\r\n                    character\r\n                    and character:FindFirstChildWhichIsA(\r\n                        \"Humanoid\"\r\n                    )\r\n\r\n                if\r\n                    character\r\n                    and character.Parent\r\n                    and playerHRP\r\n                    and humanoid\r\n                    and humanoid.Health > 0\r\n                then\r\n\r\n                    local playerPos =\r\n                        playerHRP.Position\r\n\r\n                    table.insert(\r\n                        nearbyTargets,\r\n                        {\r\n                            object = character,\r\n                            position = playerPos,\r\n                            distance =\r\n                                (\r\n                                    localHRP.Position\r\n                                    - playerPos\r\n                                ).Magnitude,\r\n\r\n                            targetType = \"Player\",\r\n                            player = player\r\n                        }\r\n                    )\r\n                end\r\n            end\r\n        end\r\n    end\r\n\r\n    -- =========================================================\r\n    -- SORT DARI TARGET PALING DEKAT\r\n    -- =========================================================\r\n\r\n    table.sort(\r\n        nearbyTargets,\r\n        function(a, b)\r\n            return a.distance < b.distance\r\n        end\r\n    )\r\n\r\n    -- =========================================================\r\n    -- PLACE BLUEPRINT KE TARGET TERDEKAT\r\n    --\r\n    -- PRIORITAS:\r\n    -- 1. Target terdekat\r\n    -- 2. Kalau placement gagal -> target berikutnya\r\n    -- 3. Tidak menyerah hanya karena 1 target gagal\r\n    --\r\n    -- 1 BLUEPRINT = 1 TARGET YANG BERHASIL\r\n    -- =========================================================\r\n\r\n    local placeRemote = nil\r\n\r\n    pcall(function()\r\n        placeRemote = Client.Events.RequestPlaceStructure\r\n    end)\r\n\r\n    if not placeRemote then\r\n        placeRemote = _ReplicatedStorage:FindFirstChild(\r\n            \"RequestPlaceStructure\",\r\n            true\r\n        )\r\n    end\r\n\r\n    local placedTargets = {}\r\n    local placedCount = 0\r\n    local failedPlacements = 0\r\n\r\n    -- =========================================================\r\n    -- HELPER: CEK TARGET MASIH VALID\r\n    -- =========================================================\r\n\r\n    local function isTargetStillValid(targetData)\r\n\r\n        if not targetData\r\n            or not targetData.object\r\n            or not targetData.object.Parent\r\n        then\r\n            return false\r\n        end\r\n\r\n        -- -----------------------------------------\r\n        -- ANIMAL\r\n        -- -----------------------------------------\r\n\r\n        if targetData.targetType == \"Animal\" then\r\n\r\n            if targetData.object:GetAttribute(\"Tamed\") == true then\r\n                return false\r\n            end\r\n\r\n            local hum =\r\n                targetData.object:FindFirstChildWhichIsA(\r\n                    \"Humanoid\"\r\n                )\r\n\r\n            if hum\r\n                and hum.Health <= 0\r\n            then\r\n                return false\r\n            end\r\n\r\n            return true\r\n        end\r\n\r\n        -- -----------------------------------------\r\n        -- PLAYER\r\n        -- -----------------------------------------\r\n\r\n        if targetData.targetType == \"Player\" then\r\n\r\n            local player = targetData.player\r\n\r\n            if not player\r\n                or not player.Parent\r\n            then\r\n                return false\r\n            end\r\n\r\n            local char =\r\n                player.Character\r\n\r\n            local hrp =\r\n                char\r\n                and char:FindFirstChild(\r\n                    \"HumanoidRootPart\"\r\n                )\r\n\r\n            local hum =\r\n                char\r\n                and char:FindFirstChildWhichIsA(\r\n                    \"Humanoid\"\r\n                )\r\n\r\n            if not char\r\n                or not char.Parent\r\n                or not hrp\r\n                or not hum\r\n                or hum.Health <= 0\r\n            then\r\n                return false\r\n            end\r\n\r\n            return true\r\n        end\r\n\r\n        return false\r\n    end\r\n\r\n    -- =========================================================\r\n    -- HELPER: REFRESH TARGET POSITION\r\n    -- =========================================================\r\n\r\n    local function getCurrentTargetPosition(targetData)\r\n\r\n        if not isTargetStillValid(targetData) then\r\n            return nil\r\n        end\r\n\r\n        local position = nil\r\n\r\n        pcall(function()\r\n\r\n            if targetData.targetType == \"Player\" then\r\n\r\n                local char =\r\n                    targetData.player.Character\r\n\r\n                local hrp =\r\n                    char\r\n                    and char:FindFirstChild(\r\n                        \"HumanoidRootPart\"\r\n                    )\r\n\r\n                if hrp then\r\n                    position = hrp.Position\r\n                end\r\n\r\n            elseif targetData.targetType == \"Animal\" then\r\n\r\n                position =\r\n                    targetData.object:GetPivot().Position\r\n            end\r\n\r\n        end)\r\n\r\n        return position\r\n    end\r\n\r\n    -- =========================================================\r\n    -- HELPER: DETECT APAKAH BLUEPRINT BENAR-BENAR BERHASIL\r\n    -- =========================================================\r\n\r\n    local function wasBlueprintPlaced(bp, beforeCount)\r\n\r\n        -- Remote success tetap menjadi indikator utama.\r\n        -- Fungsi ini hanya helper tambahan agar object blueprint\r\n        -- yang masih berada di inventory tidak dianggap berhasil.\r\n\r\n        if not bp then\r\n            return true\r\n        end\r\n\r\n        if not bp.Parent then\r\n            return true\r\n        end\r\n\r\n        local parent = bp.Parent\r\n\r\n        if parent == _LocalPlayer.Character then\r\n            return false\r\n        end\r\n\r\n        local inventory =\r\n            _LocalPlayer:FindFirstChild(\"Inventory\")\r\n\r\n        local backpack =\r\n            _LocalPlayer:FindFirstChild(\"Backpack\")\r\n\r\n        if inventory and bp:IsDescendantOf(inventory) then\r\n            return false\r\n        end\r\n\r\n        if backpack and bp:IsDescendantOf(backpack) then\r\n            return false\r\n        end\r\n\r\n        return true\r\n    end\r\n\r\n    -- =========================================================\r\n    -- MAIN PLACEMENT\r\n    -- =========================================================\r\n\r\n    if placeRemote\r\n        and #nearbyTargets > 0\r\n        and #trapBlueprints > 0\r\n    then\r\n\r\n        -- ---------------------------------------------------------\r\n        -- Salin target supaya target yang gagal bisa di-skip\r\n        -- ---------------------------------------------------------\r\n\r\n        local candidateTargets = {}\r\n\r\n        for i, targetData in ipairs(nearbyTargets) do\r\n            candidateTargets[i] = targetData\r\n        end\r\n\r\n        -- ---------------------------------------------------------\r\n        -- Satu blueprint mencari target sampai BERHASIL\r\n        -- ---------------------------------------------------------\r\n\r\n        for _, bp in ipairs(trapBlueprints) do\r\n\r\n            if not bp or not bp.Parent then\r\n                continue\r\n            end\r\n\r\n            local placedThisBlueprint = false\r\n\r\n            -- =====================================================\r\n            -- CARI TARGET YANG BISA DIPAKAI\r\n            -- =====================================================\r\n\r\n            for targetIndex, targetData in ipairs(candidateTargets) do\r\n\r\n                if not targetData then\r\n                    continue\r\n                end\r\n\r\n                -- Sudah dipakai blueprint sebelumnya\r\n                if placedTargets[targetData.object] then\r\n                    continue\r\n                end\r\n\r\n                -- Target sudah mati / hilang / Tamed\r\n                if not isTargetStillValid(targetData) then\r\n                    continue\r\n                end\r\n\r\n                local targetPos =\r\n                    getCurrentTargetPosition(targetData)\r\n\r\n                if not targetPos then\r\n                    continue\r\n                end\r\n\r\n                local cf =\r\n                    CFrame.new(targetPos)\r\n\r\n                local placementResult = {\r\n                    Valid = true,\r\n                    Position = targetPos,\r\n                    CFrame = cf,\r\n                    ErrorType = nil\r\n                }\r\n\r\n                -- =================================================\r\n                -- COBA PLACE\r\n                -- =================================================\r\n\r\n                local ok, result =\r\n                    pcall(function()\r\n\r\n                        return placeRemote:InvokeServer(\r\n                            bp,\r\n                            placementResult,\r\n                            cf - cf.Position,\r\n                            bp:GetAttribute(\r\n                                \"PlaceAnywhere\"\r\n                            )\r\n                        )\r\n\r\n                    end)\r\n\r\n                local placementSuccess = false\r\n\r\n                if ok then\r\n\r\n                    -- Kalau server secara eksplisit mengatakan gagal\r\n                    if type(result) == \"table\"\r\n                        and result.Success == false\r\n                    then\r\n                        placementSuccess = false\r\n                    else\r\n                        placementSuccess = true\r\n                    end\r\n                end\r\n\r\n                -- =================================================\r\n                -- VALIDASI TAMBAHAN\r\n                -- =================================================\r\n\r\n                if placementSuccess then\r\n\r\n                    -- Beri sedikit waktu object berpindah\r\n                    task.wait(0.05)\r\n\r\n                    -- Blueprint masih ada di inventory?\r\n                    -- Kalau masih ada berarti placement kemungkinan gagal.\r\n                    if wasBlueprintPlaced(bp) then\r\n                        placementSuccess = true\r\n                    else\r\n                        placementSuccess = false\r\n                    end\r\n                end\r\n\r\n                -- =================================================\r\n                -- BERHASIL\r\n                -- =================================================\r\n\r\n                if placementSuccess then\r\n\r\n                    placedCount =\r\n                        placedCount + 1\r\n\r\n                    placedTargets[targetData.object] =\r\n                        true\r\n\r\n                    table.remove(\r\n                        candidateTargets,\r\n                        targetIndex\r\n                    )\r\n\r\n                    placedThisBlueprint = true\r\n\r\n                    break\r\n                end\r\n\r\n                -- =================================================\r\n                -- GAGAL\r\n                -- Jangan menyerah.\r\n                -- Target berikutnya langsung dicoba.\r\n                -- =================================================\r\n\r\n                failedPlacements =\r\n                    failedPlacements + 1\r\n\r\n                task.wait(0.05)\r\n            end\r\n\r\n            -- =====================================================\r\n            -- Kalau 1 blueprint tidak menemukan target valid\r\n            -- =====================================================\r\n\r\n            if not placedThisBlueprint then\r\n\r\n                -- Tidak ada target yang bisa digunakan.\r\n                -- Jangan spam placement terus.\r\n                break\r\n            end\r\n\r\n            task.wait(0.1)\r\n        end\r\n    end\r\n\r\n    -- =========================================================\r\n    -- WAIT TRAP HASIL PLACEMENT MUNCUL DI STRUCTURES\r\n    -- =========================================================\r\n\r\n    if placedCount > 0 then\r\n\r\n        local trapDeadline =\r\n            os.clock() + 2\r\n\r\n        while os.clock() < trapDeadline do\r\n\r\n            local structuresNow =\r\n                workspace:FindFirstChild(\"Structures\")\r\n\r\n            local foundTrap = false\r\n\r\n            if structuresNow then\r\n\r\n                for _, s in ipairs(\r\n                    structuresNow:GetChildren()\r\n                ) do\r\n\r\n                    if\r\n                        s:IsA(\"Model\")\r\n                        and (\r\n                            s.Name == \"Bear Trap\"\r\n                            or s.Name == \"Volcanic Bear Trap\"\r\n                        )\r\n                    then\r\n\r\n                        foundTrap = true\r\n                        break\r\n                    end\r\n                end\r\n            end\r\n\r\n            if foundTrap then\r\n                break\r\n            end\r\n\r\n            task.wait(0.05)\r\n        end\r\n\r\n        -- Extra replication tick\r\n        task.wait(0.1)\r\n    end\r\n\r\n    -- =========================================================\r\n    -- SCAN ULANG TRAP YANG SUDAH TERPLACE\r\n    -- =========================================================\r\n    local allTraps={}\r\n\r\n    if structures then\r\n        for _,s in ipairs(structures:GetChildren()) do\r\n            if s:IsA(\"Model\")\r\n                and (\r\n                    s.Name==\"Volcanic Bear Trap\"\r\n                    or s.Name==\"Bear Trap\"\r\n                ) then\r\n                table.insert(allTraps,s)\r\n            end\r\n        end\r\n    end\r\n\r\n    -- =========================================================\r\n    -- KALAU TIDAK ADA TRAP SAMA SEKALI\r\n    -- =========================================================\r\n    if #allTraps==0 then\r\n        BearTrapStatus:SetDesc(\r\n            \"Status: No Bear Traps available! Go Buy it!\"\r\n        )\r\n\r\n        WindUI:Notify({\r\n            Title=\"Bear Trap\",\r\n            Content=\"No Bear Trap or Volcanic Bear Trap available! Go Buy it!\",\r\n            Duration=3\r\n        })\r\n\r\n        return\r\n    end\r\n\r\n    -- =========================================================\r\n    -- ASSIGNMENT\r\n    -- TETAP MENGIKUTI SISTEM ORIGINAL\r\n    -- =========================================================\r\n    local targetQueue = {}\r\n    for i=1, #validTargets do\r\n        table.insert(targetQueue, validTargets[i])\r\n    end\r\n\r\n    local assignedCount=math.min(#targetQueue, #allTraps)\r\n    local assignments={}\r\n\r\n    for i=1,assignedCount do\r\n        local nTarg = table.remove(targetQueue, 1)\r\n        assignments[i]={\r\n            trap=allTraps[i],\r\n            target=nTarg,\r\n            statusText=string.format(\"Trap %d -> %s: Starting...\", i, nTarg.displayName),\r\n            isHacker=(nTarg.maxHp~=100),\r\n            active=true,\r\n            initialChar=nTarg.player.Character\r\n        }\r\n\r\n        local prompt=\r\n            allTraps[i]:FindFirstChildWhichIsA(\r\n                \"ProximityPrompt\",\r\n                true\r\n            )\r\n\r\n        if prompt then\r\n            prompt.RequiresLineOfSight=false\r\n            prompt.MaxActivationDistance=9999\r\n        end\r\n    end\r\n\r\n    if placedCount>0 then\r\n        BearTrapStatus:SetDesc(\r\n            \"Status: \"\r\n            ..placedCount\r\n            ..\" trap(s) placed. Hunting \"\r\n            ..assignedCount\r\n            ..\" player(s)...\"\r\n        )\r\n    else\r\n        BearTrapStatus:SetDesc(\r\n            \"Status: Hunting \"\r\n            ..assignedCount\r\n            ..\" player(s)...\"\r\n        )\r\n    end\r\n\r\n    if #validTargets>#allTraps then\r\n        WindUI:Notify({\r\n            Title=\"Bear Trap\",\r\n            Content=string.format(\r\n                \"Only %d trap(s) for %d target(s). Extra ignored!\",\r\n                #allTraps,\r\n                #validTargets\r\n            ),\r\n            Duration=4\r\n        })\r\n    end\r\n\r\n    local remotes=_ReplicatedStorage:WaitForChild(\"RemoteEvents\")\r\n\r\n    -- =========================================================\r\n    -- ORIGINAL KILL LOOP\r\n    -- =========================================================\r\n    task.spawn(function()\r\n        local globalTick=0\r\n        local activeCount=assignedCount\r\n\r\n        while getgenv().KixHub_BearTrap_ToggleID==myToggleID\r\n            and activeCount>0 do\r\n\r\n            activeCount=0\r\n\r\n            for i=1,assignedCount do\r\n                local assign=assignments[i]\r\n\r\n                if not assign.active then\r\n                    continue\r\n                end\r\n\r\n                local trap=assign.trap\r\n                local targetPlayer=assign.target.player\r\n                local targetDisplayName=assign.target.displayName\r\n                local isHacker=assign.isHacker\r\n                local dNameFull=\r\n                    targetDisplayName\r\n                    ..\" (\"\r\n                    ..targetPlayer.Name\r\n                    ..\")\"\r\n\r\n                local hackerSuffix=\r\n                    isHacker and \" : Hacker\" or \"\"\r\n\r\n                -- =================================================\r\n                -- AUTO REPLACEMENT ORIGINAL\r\n                -- =================================================\r\n                if not trap or not trap.Parent then\r\n                    local foundReplacement=false\r\n\r\n                    if structures then\r\n                        for _,s in ipairs(structures:GetChildren()) do\r\n                            if s.Name==\"Volcanic Bear Trap\"\r\n                                or s.Name==\"Bear Trap\" then\r\n\r\n                                local isUsed=false\r\n\r\n                                for j=1,assignedCount do\r\n                                    if assignments[j].trap==s then\r\n                                        isUsed=true\r\n                                        break\r\n                                    end\r\n                                end\r\n\r\n                                if not isUsed then\r\n                                    assign.trap=s\r\n                                    trap=s\r\n                                    foundReplacement=true\r\n\r\n                                    local prompt=\r\n                                        trap:FindFirstChildWhichIsA(\r\n                                            \"ProximityPrompt\",\r\n                                            true\r\n                                        )\r\n\r\n                                    if prompt then\r\n                                        prompt.RequiresLineOfSight=false\r\n                                        prompt.MaxActivationDistance=9999\r\n                                    end\r\n\r\n                                    break\r\n                                end\r\n                            end\r\n                        end\r\n                    end\r\n\r\n                    if not foundReplacement then\r\n                        assign.statusText=string.format(\r\n                            \"Trap %d -> %s%s: No Traps Left!\",\r\n                            i,\r\n                            dNameFull,\r\n                            hackerSuffix\r\n                        )\r\n                        assign.active=false\r\n                        continue\r\n                    end\r\n                end\r\n\r\n                if not targetPlayer or not targetPlayer.Parent then\r\n                    assign.statusText=string.format(\r\n                        \"Trap %d -> %s%s: Left Game!\",\r\n                        i,\r\n                        dNameFull,\r\n                        hackerSuffix\r\n                    )\r\n                    assign.active=false\r\n                    continue\r\n                end\r\n\r\n                local targetChar=targetPlayer.Character\r\n                local targetHRP=\r\n                    targetChar\r\n                    and targetChar:FindFirstChild(\r\n                        \"HumanoidRootPart\"\r\n                    )\r\n\r\n                local targetHumanoid=\r\n                    targetChar\r\n                    and targetChar:FindFirstChildWhichIsA(\r\n                        \"Humanoid\"\r\n                    )\r\n\r\n                -- =================================================\r\n                -- TARGET DEAD\r\n                -- =================================================\r\n                local isDead=false\r\n\r\n                if targetHumanoid\r\n                    and targetHumanoid.Health<=0 then\r\n                    isDead=true\r\n                end\r\n\r\n                if targetChar\r\n                    and targetChar~=assign.initialChar then\r\n                    isDead=true\r\n                end\r\n\r\n                if not assign.initialChar\r\n                    or not assign.initialChar.Parent then\r\n                    isDead=true\r\n                end\r\n\r\n                if isDead then\r\n                    if #targetQueue > 0 then\r\n                        local nTarg = table.remove(targetQueue, 1)\r\n                        assign.target = nTarg\r\n                        assign.isHacker = (nTarg.maxHp ~= 100)\r\n                        assign.initialChar = nTarg.player.Character\r\n                        assign.statusText = string.format(\"Trap %d -> %s: Switched!\", i, nTarg.displayName)\r\n                        continue\r\n                    else\r\n                        assign.statusText=string.format(\"Trap %d -> %s%s: DEAD!\", i, dNameFull, hackerSuffix)\r\n                        assign.active=false\r\n                        continue\r\n                    end\r\n                end\r\n\r\n                -- =================================================\r\n                -- HUNT TARGET\r\n                -- =================================================\r\n                if targetHRP then\r\n                    activeCount=activeCount+1\r\n\r\n                    pcall(function()\r\n                        remotes.RequestStartDraggingItem:FireServer(\r\n                            trap\r\n                        )\r\n                    end)\r\n\r\n                    task.wait(0.01)\r\n\r\n                    pcall(function()\r\n                        local currentPrompt=\r\n                            trap:FindFirstChildWhichIsA(\r\n                                \"ProximityPrompt\",\r\n                                true\r\n                            )\r\n\r\n                        local needsSetting=\r\n                            currentPrompt\r\n                            and currentPrompt.ActionText==\"Set Trap\"\r\n\r\n                        local offsetX=0\r\n                        local offsetZ=0\r\n                        local offsetY=2.5\r\n\r\n                        if needsSetting then\r\n                            if trap.Name==\"Volcanic Bear Trap\" then\r\n                                offsetX=\r\n                                    math.sin(globalTick*1.5)*3.0\r\n                                offsetZ=\r\n                                    math.cos(globalTick*1.5)*3.0\r\n                                offsetY=1.0\r\n                            else\r\n                                offsetX=\r\n                                    math.sin(globalTick*1.5)*2.0\r\n                                offsetZ=\r\n                                    math.cos(globalTick*1.5)*2.0\r\n                                offsetY=1.0\r\n                            end\r\n                        else\r\n                            offsetX=0\r\n                            offsetZ=0\r\n                            offsetY=0.5 -- 0.5 agar tepat mengenai area badan/kaki target untuk trigger .Touched\r\n                        end\r\n\r\n                        trap:PivotTo(\r\n                            CFrame.new(\r\n                                targetHRP.Position\r\n                                -Vector3.new(\r\n                                    offsetX,\r\n                                    offsetY,\r\n                                    offsetZ\r\n                                )\r\n                            )\r\n                        )\r\n                    end)\r\n\r\n                    task.wait(0.01)\r\n\r\n                    pcall(function()\r\n                        remotes.StopDraggingItem:FireServer(\r\n                            trap\r\n                        )\r\n                    end)\r\n\r\n                    task.wait(0.1)\r\n\r\n                    local currentPrompt=\r\n                        trap:FindFirstChildWhichIsA(\r\n                            \"ProximityPrompt\",\r\n                            true\r\n                        )\r\n\r\n                    if currentPrompt\r\n                        and currentPrompt.Enabled then\r\n\r\n                        currentPrompt.RequiresLineOfSight=false\r\n                        currentPrompt.MaxActivationDistance=99999\r\n\r\n                        if currentPrompt.ActionText==\"Set Trap\" then\r\n                            if not bearTrapPromptDebounces[currentPrompt]\r\n                                or (\r\n                                    os.clock()\r\n                                    -bearTrapPromptDebounces[currentPrompt]\r\n                                )>0.15 then\r\n\r\n                                bearTrapPromptDebounces[currentPrompt]=\r\n                                    os.clock()\r\n\r\n                                pcall(function()\r\n                                    fireproximityprompt(\r\n                                        currentPrompt\r\n                                    )\r\n                                end)\r\n                            end\r\n                        end\r\n                    end\r\n\r\n                    if globalTick%30==0\r\n                        and currentPrompt then\r\n\r\n                        currentPrompt.RequiresLineOfSight=false\r\n                        currentPrompt.MaxActivationDistance=9999\r\n                    end\r\n\r\n                    if targetHumanoid then\r\n                        local hp=\r\n                            math.floor(\r\n                                targetHumanoid.Health\r\n                            )\r\n\r\n                        local maxHp=\r\n                            math.floor(\r\n                                targetHumanoid.MaxHealth\r\n                            )\r\n\r\n                        assign.statusText=string.format(\r\n                            \"Trap %d -> %s%s: HP %d/%d\",\r\n                            i,\r\n                            dNameFull,\r\n                            hackerSuffix,\r\n                            hp,\r\n                            maxHp\r\n                        )\r\n                    end\r\n                else\r\n                    assign.statusText=string.format(\r\n                        \"Trap %d -> %s%s: Finding HRP...\",\r\n                        i,\r\n                        dNameFull,\r\n                        hackerSuffix\r\n                    )\r\n\r\n                    activeCount=activeCount+1\r\n                end\r\n            end\r\n\r\n            globalTick=globalTick+1\r\n            task.wait()\r\n        end\r\n\r\n        -- =====================================================\r\n        -- CLEANUP\r\n        -- =====================================================\r\n        for i=1,assignedCount do\r\n            local trap=assignments[i].trap\r\n\r\n            pcall(function()\r\n                if trap and trap.Parent then\r\n                    remotes.StopDraggingItem:FireServer(trap)\r\n                end\r\n            end)\r\n\r\n            local prompt=\r\n                trap\r\n                and trap:FindFirstChildWhichIsA(\r\n                    \"ProximityPrompt\",\r\n                    true\r\n                )\r\n\r\n            if prompt then\r\n                pcall(function()\r\n                    prompt.RequiresLineOfSight=true\r\n                    prompt.MaxActivationDistance=16\r\n                end)\r\n            end\r\n        end\r\n    end)\r\n\r\n    -- =========================================================\r\n    -- STATUS MONITOR\r\n    -- =========================================================\r\n    task.spawn(function()\r\n        while getgenv().KixHub_BearTrap_ToggleID==myToggleID do\r\n            local lines={}\r\n            local hasActive=false\r\n\r\n            for i=1,assignedCount do\r\n                table.insert(\r\n                    lines,\r\n                    assignments[i].statusText\r\n                )\r\n\r\n                if assignments[i].active then\r\n                    hasActive=true\r\n                end\r\n            end\r\n\r\n            if not hasActive then\r\n                table.insert(\r\n                    lines,\r\n                    \"\\n✅ All targets neutralized.\"\r\n                )\r\n\r\n                BearTrapStatus:SetDesc(\r\n                    \"Status:\\n\"\r\n                    ..table.concat(lines,\"\\n\")\r\n                )\r\n\r\n                task.delay(4,function()\r\n                    if getgenv().KixHub_BearTrap_ToggleID==myToggleID then\r\n                        BearTrapStatus:SetDesc(\"Status: Idle\")\r\n                    end\r\n                end)\r\n\r\n                break\r\n            end\r\n\r\n            BearTrapStatus:SetDesc(\r\n                \"Status:\\n\"\r\n                ..table.concat(lines,\"\\n\")\r\n            )\r\n\r\n            task.wait(0.5)\r\n        end\r\n    end)\r\nend\r\n\r\nTabs.Combat:Button({\r\n    Title = 'Kill Selected Player',\r\n    Callback = function()\r\n        local selectedList = {}\r\n        if type(bearTrapSelectedPlayers) == \"table\" then\r\n            for _, v in ipairs(bearTrapSelectedPlayers) do\r\n                if v == \"None\" then\r\n                    WindUI:Notify({Title=\"Error\", Content=\"'None' is selected! Please unselect 'None' to kill players.\", Duration=4})\r\n                    return\r\n                end\r\n                table.insert(selectedList, v)\r\n            end\r\n        end\r\n        \r\n        if #selectedList == 0 then\r\n            WindUI:Notify({Title=\"Error\", Content=\"No players selected!\", Duration=3})\r\n            return\r\n        end\r\n        \r\n        executeKillLoop(selectedList)\r\n    end\r\n})\r\n\r\nTabs.Combat:Button({\r\n    Title = '🛑 Emergency Stop!',\r\n    Desc = 'Instantly aborts any ongoing trap kill operations.',\r\n    Callback = function()\r\n        getgenv().KixHub_BearTrap_ToggleID = (getgenv().KixHub_BearTrap_ToggleID or 0) + 1\r\n        if BearTrapStatus then\r\n            BearTrapStatus:SetDesc(\"Status:\\n🛑 Force Stopped by User.\")\r\n        end\r\n        if WindUI then\r\n            WindUI:Notify({Title=\"Emergency Stop\", Content=\"All kill operations have been aborted!\", Duration=3})\r\n        end\r\n    end\r\n})\r\n\r\nTabs.Combat:Button({\r\n    Title = '🟢 Revive All Players',\r\n    Desc = 'Instantly revives all downed players across the map (Requires Bandages/Medkits).',\r\n    Callback = function()\r\n        local count = 0\r\n        pcall(function()\r\n            local remote = game:GetService(\"ReplicatedStorage\"):FindFirstChild(\"RemoteEvents\") \r\n                and game:GetService(\"ReplicatedStorage\").RemoteEvents:FindFirstChild(\"RequestRevivePlayer\")\r\n            if not remote then return end\r\n            \r\n            for _, char in ipairs(workspace.Characters:GetChildren()) do\r\n                if char.Name:match(\" Body$\") then\r\n                    remote:FireServer(char)\r\n                    count = count + 1\r\n                end\r\n            end\r\n        end)\r\n        if WindUI then\r\n            if count > 0 then\r\n                WindUI:Notify({Title=\"Revive\", Content=\"Attempted to revive \" .. count .. \" player(s)!\", Duration=3})\r\n            else\r\n                WindUI:Notify({Title=\"Revive\", Content=\"No downed players found.\", Duration=3})\r\n            end\r\n        end\r\n    end\r\n})\r\n\r\n-- ==================== MAIN TAB ====================\r\n\r\n-- ==================== AUTO TAB ====================\r\nautoUpgCamp = KixHubSavedState.AutoCamp or false\r\nautoScrap = KixHubSavedState.AutoScrap or false\r\nautoCook = KixHubSavedState.AutoCook or false\r\nautoBiofuelSmart = false\r\nisBiofuelFilling = false\r\nexcludedCookItems = {}\r\n\r\n\r\n\r\nTabs.Auto:Section({Title = 'Campfire', Icon = 'flame'})\r\n\r\nlocal function getCampfireLevel()\r\n    -- 1. Official Game Engine Attribute (Direct from workspace:GetAttribute(\"Progress\"))\r\n    local progress = workspace:GetAttribute(\"Progress\")\r\n    if typeof(progress) == \"number\" and progress >= 1 and progress <= 6 then\r\n        return progress\r\n    end\r\n\r\n    -- 2. Secondary fallback: parse BillboardGui TextLabel on MainFire\r\n    local mainFire = workspace:FindFirstChild(\"Map\") and workspace.Map:FindFirstChild(\"Campground\") and workspace.Map.Campground:FindFirstChild(\"MainFire\")\r\n    if mainFire then\r\n        local bbg = (mainFire.PrimaryPart and mainFire.PrimaryPart:FindFirstChild(\"BillboardGui\"))\r\n            or (mainFire:FindFirstChild(\"Center\") and mainFire.Center:FindFirstChild(\"BillboardGui\"))\r\n            or mainFire:FindFirstChildWhichIsA(\"BillboardGui\", true)\r\n        if bbg and bbg:FindFirstChild(\"Frame\") and bbg.Frame:FindFirstChild(\"TextLabel\") then\r\n            local txt = bbg.Frame.TextLabel.Text or \"\"\r\n            if txt:find(\"FULLY UPGRADED\") or txt:find(\"MAP FULLY REVEALED\") then\r\n                return 6\r\n            end\r\n            local lvl = txt:match(\"[Ll]evel%s*(%d+)\")\r\n            if lvl then\r\n                return tonumber(lvl)\r\n            end\r\n        end\r\n    end\r\n\r\n    -- 3. Default fallback\r\n    return 1\r\nend\r\n\r\n-- PENTING: Menyimpan toggle ke dalam variabel Global agar bisa dipanggil oleh tracker\r\n_G.UpgradeFireToggle = Tabs.Auto:Toggle({\r\n    Title = '🔥 Auto Upgrade Level Fire',\r\n    Desc = 'Level 1/6 | Fire : 0% | Automatically drop fuels to upgrade your campfire to max level.',\r\n    Value = false,\r\n    Callback = function(val)\r\n        autoUpgCamp = val\r\n        if val then\r\n            task.spawn(function()\r\n                local currentLevel = getCampfireLevel()\r\n                local isUpgFilling = (currentLevel < 6)\r\n                local lastKnownFireLevel = currentLevel\r\n\r\n                while autoUpgCamp do\r\n                    if type(campfireUpgradeTarget) == \"table\" and #campfireUpgradeTarget > 0 then\r\n                        local mainFire = workspace:FindFirstChild(\"Map\") and workspace.Map:FindFirstChild(\"Campground\") and workspace.Map.Campground:FindFirstChild(\"MainFire\")\r\n                        local fill\r\n                        pcall(function() fill = mainFire.Center.BillboardGui.Frame.Background.Fill end)\r\n                        \r\n                        if fill and mainFire then\r\n                            local fuelRemaining = mainFire:GetAttribute(\"FuelRemaining\") or 0\r\n                            local fuelTarget = mainFire:GetAttribute(\"FuelTarget\") or 3500\r\n                            \r\n                            -- Tetap pakai UI Scale sebagai sistem utama\r\n                            local percent = math.clamp(math.floor(fill.Size.X.Scale * 100 + 0.5), 0, 100)\r\n                            -- Gunakan atribut server KHUSUS di awal saat baru masuk game\r\n                            if percent >= 99 and fuelRemaining == 0 then\r\n                                percent = 0\r\n                            end\r\n                    \r\n                            if percent ~= lastPercent then\r\n                                lastPercent = percent\r\n                                lastPercentChangeTime = os.time()\r\n                            end\r\n                            \r\n                            -- Deteksi Level Api Akurat\r\n                            local currentLevel = getCampfireLevel()\r\n                            if lastKnownFireLevel and currentLevel > lastKnownFireLevel then\r\n                                if WindUI then\r\n                                    pcall(function()\r\n                                        if currentLevel >= 6 then\r\n                                            WindUI:Notify({\r\n                                                Title = \"Fire Upgrade\",\r\n                                                Content = \"Campfire reached maximum Level 6.\",\r\n                                                Duration = 3,\r\n                                                Icon = \"check\"\r\n                                            })\r\n                                        else\r\n                                            WindUI:Notify({\r\n                                                Title = \"Fire Upgrade\",\r\n                                                Content = string.format(\"Campfire reached Level %d.\", currentLevel),\r\n                                                Duration = 2,\r\n                                                Icon = \"flame\"\r\n                                            })\r\n                                        end\r\n                                    end)\r\n                                end\r\n                            end\r\n                            lastKnownFireLevel = currentLevel\r\n\r\n                            -- Logika Pengisian (Termostat Terintegrasi Level):\r\n                            if currentLevel >= 6 then\r\n                                -- Api sudah Level 6 (Maksimum):\r\n                                -- Berhenti suplai jika api sudah >= 85% (walau belum 99%).\r\n                                -- Mulai suplai kembali HANYA jika api turun di bawah batas aman (< 75%),\r\n                                -- dan berhenti lagi saat mencapai batas maks 85%.\r\n                                if percent >= 85 then\r\n                                    isUpgFilling = false\r\n                                    lastPercentChangeTime = os.time()\r\n                                elseif percent < 75 then\r\n                                    isUpgFilling = true\r\n                                end\r\n                            else\r\n                                -- Fuel percentage must not stop upgrades before Level 6.\r\n                                isUpgFilling = true\r\n                            end\r\n                            \r\n                            if isUpgFilling then\r\n                                local toUpgrade = { [\"Coal\"] = {}, [\"Fuel Canister\"] = {}, [\"Oil Barrel\"] = {}, [\"Other\"] = {} }\r\n                                for _, item in ipairs(workspace:WaitForChild('Items'):GetChildren()) do\r\n                                    if table.find(campfireUpgradeTarget, item.Name) then \r\n                                        if toUpgrade[item.Name] then\r\n                                            table.insert(toUpgrade[item.Name], item)\r\n                                        else\r\n                                            table.insert(toUpgrade[\"Other\"], item)\r\n                                        end\r\n                                    end\r\n                                end\r\n                                \r\n                                local function streamDrop(items, limit)\r\n                                    if #items > 0 then\r\n                                        local maxDrop = math.min(limit, #items)\r\n                                        for i = 1, maxDrop do\r\n                                            pcall(function()\r\n                                                dragItemSmooth(items[i], campfirePos + Vector3.new(0, 4, 0)) \r\n                                            end)\r\n                                            task.wait(0.2) \r\n                                        end\r\n                                    end\r\n                                end\r\n\r\n                                -- Eksekusi secara berurutan dan aman\r\n                                streamDrop(toUpgrade[\"Coal\"], 5)\r\n                                streamDrop(toUpgrade[\"Fuel Canister\"], 5)\r\n                                streamDrop(toUpgrade[\"Oil Barrel\"], 5)\r\n                                streamDrop(toUpgrade[\"Other\"], 5)\r\n                                \r\n                                task.wait(0.5)\r\n                            end\r\n                        end\r\n                    end\r\n                    task.wait(1)\r\n                end\r\n            end)\r\n        end\r\n    end\r\n})\r\n\r\n\r\n_G.AutoRescueLostChildActive = false\r\n_G.AutoRescueLostChildRunning = false\r\n\r\n_G.KixAdapters = _G.KixAdapters or {}\r\n_G.KixAdapters.UpgradeFire = {\r\n    IsEnabled = function()\r\n        return autoUpgCamp == true\r\n    end,\r\n    GetLevel = function()\r\n        if type(getCampfireLevel) == \"function\" then\r\n            return getCampfireLevel()\r\n        end\r\n        return 0\r\n    end,\r\n    GetPercent = function()\r\n        local mainFire = workspace:FindFirstChild(\"Map\") and workspace.Map:FindFirstChild(\"Campground\") and workspace.Map.Campground:FindFirstChild(\"MainFire\")\r\n        local fill\r\n        pcall(function() fill = mainFire.Center.BillboardGui.Frame.Background.Fill end)\r\n        if fill then\r\n            return math.clamp(math.floor(fill.Size.X.Scale * 100 + 0.5), 0, 100)\r\n        end\r\n        return 0\r\n    end,\r\n    HasFuel = function()\r\n        local items = workspace:FindFirstChild(\"Items\")\r\n        if items then\r\n            for _, itm in ipairs(items:GetChildren()) do\r\n                local n = itm.Name\r\n                if n == \"Log\" or n == \"Coal\" or n == \"Stick\" or n == \"Chair\" or n == \"Biofuel\" then\r\n                    return true\r\n                end\r\n            end\r\n        end\r\n        return false\r\n    end,\r\n    SetState = function(state)\r\n        if _G.UpgradeFireToggle then\r\n            if type(_G.UpgradeFireToggle.SetValue) == \"function\" then\r\n                _G.UpgradeFireToggle:SetValue(state)\r\n            elseif type(_G.UpgradeFireToggle.SetState) == \"function\" then\r\n                _G.UpgradeFireToggle:SetState(state)\r\n            end\r\n        end\r\n    end\r\n}\r\n\r\nlocal UI_AutoRescueToggle\r\n\r\n_G.KixEngines.AutoRescue = function(val)\r\n        _G.AutoRescueLostChildActive = val\r\n        if not val then _G.KixRescueStatus = \"stopping\" end\r\n\r\n        if not val then\r\n            return\r\n        end\r\n\r\n        if _G.AutoRescueLostChildRunning then\r\n            return\r\n        end\r\n\r\n        _G.AutoRescueLostChildRunning = true\r\n\r\n        -- Direct engine activation; no UI setter dependency.\r\n        _G.KixEngines.InstantInteract(true)\r\n\r\n        _G.KixEngines.Spawn(\"AutoRescue\", function()\r\n            local rescueRelease\r\n            local rescueOK, rescueError = xpcall(function()\r\n            local SCAN_DELAY = 0.2\r\n            local CAMPFIRE_IGNORE_RADIUS = 250\r\n\r\n            -- Display Name Mapping\r\n            local kidNameMap = {\r\n                [\"Lost Child\"]  = \"Dino Kid\",\r\n                [\"Lost Child1\"] = \"Dino Kid\",\r\n                [\"Lost Child2\"] = \"Kraken Kid\",\r\n                [\"Lost Child3\"] = \"Squid Kid\",\r\n                [\"Lost Child4\"] = \"Koala Kid\",\r\n                [\"DinoKid\"]     = \"Dino Kid\",\r\n                [\"KrakenKid\"]   = \"Kraken Kid\",\r\n                [\"SquidKid\"]    = \"Squid Kid\",\r\n                [\"KoalaKid\"]    = \"Koala Kid\"\r\n            }\r\n\r\n            local rescuedKids = {}\r\n            _G.KixRescueTargetRetryAt = _G.KixRescueTargetRetryAt or setmetatable({}, {__mode = \"k\"})\r\n\r\n            local function isActive()\r\n                return _G.AutoRescueLostChildActive == true or _G.KixRescueBusy == true\r\n            end\r\n\r\n            local function isAutoChopPriorityActive()\r\n                return _G.AutoChopSelectedTreesActive == true\r\n            end\r\n\r\n            local function getCharacter()\r\n                return _LocalPlayer.Character\r\n            end\r\n\r\n            local function getHRP()\r\n                local char = getCharacter()\r\n                return char and char:FindFirstChild(\"HumanoidRootPart\")\r\n            end\r\n\r\n            local function notify(title, content, duration, icon)\r\n                if not WindUI then return end\r\n                pcall(function()\r\n                    WindUI:Notify({\r\n                        Title = title,\r\n                        Content = content,\r\n                        Duration = duration or 2,\r\n                        Icon = icon\r\n                    })\r\n                end)\r\n            end\r\n\r\n            -- =========================================================\r\n            -- CAMPFIRE RESTORE POSITION (OFFICIAL TELEPORT COORD)\r\n            -- =========================================================\r\n            local CAMPFIRE_RESTORE_CFRAME = CFrame.new(0.43, 15.77, -1.88)\r\n            local getCampfirePosition\r\n\r\n            local function getCampfireDropCFrame()\r\n                local camp = getCampfirePosition()\r\n                local char = getCharacter()\r\n                local params = RaycastParams.new()\r\n                params.FilterType = Enum.RaycastFilterType.Exclude\r\n                params.FilterDescendantsInstances = char and { char } or {}\r\n\r\n                -- Cari rumput di sekitar MainFire agar pelepasan sack tidak terjadi\r\n                -- di udara/di atas api. Jarak antar titik kecil dan hanya discan saat rescue.\r\n                local offsets = {\r\n                    Vector3.new(5, 0, 0), Vector3.new(-5, 0, 0),\r\n                    Vector3.new(0, 0, 5), Vector3.new(0, 0, -5),\r\n                    Vector3.new(7, 0, 4), Vector3.new(-7, 0, 4),\r\n                    Vector3.new(7, 0, -4), Vector3.new(-7, 0, -4),\r\n                }\r\n\r\n                for _, offset in ipairs(offsets) do\r\n                    local origin = Vector3.new(camp.X + offset.X, camp.Y + 80, camp.Z + offset.Z)\r\n                    local result = workspace:Raycast(origin, Vector3.new(0, -180, 0), params)\r\n                    if result and result.Material == Enum.Material.Grass then\r\n                        local playerRootHeight = 3\r\n                        return CFrame.new(result.Position + Vector3.new(0, playerRootHeight, 0))\r\n                    end\r\n                end\r\n\r\n                return CAMPFIRE_RESTORE_CFRAME\r\n            end\r\n\r\n            -- =========================================================\r\n            -- CAMPFIRE CENTER & CHECK\r\n            -- =========================================================\r\n            getCampfirePosition = function()\r\n                if typeof(campfirePos) == \"Vector3\" then\r\n                    return campfirePos\r\n                end\r\n                if typeof(getAutoBagCampfirePosition) == \"function\" then\r\n                    local p = getAutoBagCampfirePosition()\r\n                    if p then return p end\r\n                end\r\n                return Vector3.new(0, 19, 0)\r\n            end\r\n\r\n            local function isInsideCampfireArea(kid)\r\n                if not kid or not kid.Parent then return false end\r\n                local ok, pos = pcall(function() return kid:GetPivot().Position end)\r\n                if not ok or not pos then return false end\r\n\r\n                local camp = getCampfirePosition()\r\n                local dx = pos.X - camp.X\r\n                local dz = pos.Z - camp.Z\r\n                local horizontalDist = math.sqrt((dx * dx) + (dz * dz))\r\n\r\n                return horizontalDist <= CAMPFIRE_IGNORE_RADIUS\r\n            end\r\n\r\n            local function isDeliveredAtCampfire(kid)\r\n                return kid ~= nil\r\n                    and kid.Parent ~= nil\r\n                    and isInsideCampfireArea(kid)\r\n                    and kid:GetAttribute(\"Lost\") ~= true\r\n            end\r\n\r\n            -- Wait for streamed Campfire geometry and its drop surface before releasing a kid.\r\n            local function findRenderedCampfireDropCFrame()\r\n                local map = workspace:FindFirstChild(\"Map\")\r\n                local campground = map and map:FindFirstChild(\"Campground\")\r\n                local mainFire = campground and campground:FindFirstChild(\"MainFire\")\r\n                local center = mainFire and mainFire:FindFirstChild(\"Center\", true)\r\n                if not mainFire or not mainFire:IsDescendantOf(workspace)\r\n                    or not center or not center:IsA(\"BasePart\") then\r\n                    return nil\r\n                end\r\n\r\n                local camp = getCampfirePosition()\r\n                local char = getCharacter()\r\n                local params = RaycastParams.new()\r\n                params.FilterType = Enum.RaycastFilterType.Exclude\r\n                params.FilterDescendantsInstances = char and {char} or {}\r\n                local offsets = {\r\n                    Vector3.new(5, 0, 0), Vector3.new(-5, 0, 0),\r\n                    Vector3.new(0, 0, 5), Vector3.new(0, 0, -5),\r\n                    Vector3.new(7, 0, 4), Vector3.new(-7, 0, 4),\r\n                    Vector3.new(7, 0, -4), Vector3.new(-7, 0, -4),\r\n                }\r\n\r\n                for index, offset in ipairs(offsets) do\r\n                    local origin = Vector3.new(camp.X + offset.X, camp.Y + 80, camp.Z + offset.Z)\r\n                    local hit = workspace:Raycast(origin, Vector3.new(0, -180, 0), params)\r\n                    if hit and hit.Material == Enum.Material.Grass\r\n                        and (hit.Position - center.Position).Magnitude <= 40 then\r\n                        return CFrame.new(hit.Position + Vector3.new(0, 3, 0)), index, hit.Position\r\n                    end\r\n                end\r\n                return nil\r\n            end\r\n\r\n            local function waitForRenderedCampfire()\r\n                local hrp = getHRP()\r\n                if not hrp then return nil end\r\n\r\n                local camp = getCampfirePosition()\r\n                _G.KixRescueStatus = \"waiting_for_campfire_stream\"\r\n                hrp.CFrame = CFrame.new(camp + Vector3.new(0, 6, 0))\r\n                hrp.AssemblyLinearVelocity = Vector3.zero\r\n                hrp.AssemblyAngularVelocity = Vector3.zero\r\n                pcall(function()\r\n                    _LocalPlayer:RequestStreamAroundAsync(camp, 8)\r\n                end)\r\n\r\n                local startedAt = os.clock()\r\n                local stableCount, stableIndex, stablePosition = 0, nil, nil\r\n                while os.clock() - startedAt < 30 do\r\n                    if not isActive() or isAutoChopPriorityActive() then return nil end\r\n\r\n                    local dropCFrame, index, groundPosition = findRenderedCampfireDropCFrame()\r\n                    if dropCFrame and index == stableIndex and stablePosition\r\n                        and (groundPosition - stablePosition).Magnitude <= 1.5 then\r\n                        stableCount = stableCount + 1\r\n                    elseif dropCFrame then\r\n                        stableCount, stableIndex, stablePosition = 1, index, groundPosition\r\n                    else\r\n                        stableCount, stableIndex, stablePosition = 0, nil, nil\r\n                    end\r\n\r\n                    if dropCFrame and stableCount >= 3 and os.clock() - startedAt >= 0.5 then\r\n                        hrp = getHRP()\r\n                        if not hrp or not hrp.Parent then return nil end\r\n                        hrp.CFrame = dropCFrame\r\n                        hrp.AssemblyLinearVelocity = Vector3.zero\r\n                        hrp.AssemblyAngularVelocity = Vector3.zero\r\n                        task.wait(0.25)\r\n\r\n                        local confirmedCFrame, confirmedIndex, confirmedPosition = findRenderedCampfireDropCFrame()\r\n                        if confirmedCFrame and confirmedIndex == stableIndex\r\n                            and (confirmedPosition - stablePosition).Magnitude <= 1.5 then\r\n                            _G.KixRescueStatus = \"campfire_render_ready\"\r\n                            return confirmedCFrame\r\n                        end\r\n                        stableCount, stableIndex, stablePosition = 0, nil, nil\r\n                    end\r\n\r\n                    task.wait(0.25)\r\n                end\r\n\r\n                _G.KixRescueStatus = \"waiting_for_campfire_stream\"\r\n                return nil\r\n            end\r\n\r\n            -- =========================================================\r\n            -- SACK TOOL\r\n            -- =========================================================\r\n            local function findBagTool()\r\n                local lp = _LocalPlayer\r\n                local folders = {}\r\n                local inventory = lp and lp:FindFirstChild(\"Inventory\")\r\n                local character = lp and lp.Character\r\n                local backpack = lp and (lp:FindFirstChild(\"Backpack\") or lp:FindFirstChildOfClass(\"Backpack\"))\r\n                if inventory then folders[#folders + 1] = inventory end\r\n                if character then folders[#folders + 1] = character end\r\n                if backpack then folders[#folders + 1] = backpack end\r\n\r\n                for _, folder in ipairs(folders) do\r\n                    for _, item in ipairs(folder:GetChildren()) do\r\n                        if item:GetAttribute(\"EasterBasket\") ~= true then\r\n                            local ok, tagged = pcall(function() return item:HasTag(\"ItemBag\") end)\r\n                            if (ok and tagged)\r\n                                or item.Name:lower():find(\"sack\", 1, true)\r\n                                or item:GetAttribute(\"ToolName\") == \"Item Bag\"\r\n                                or item:GetAttribute(\"NumberItems\") ~= nil then\r\n                                return item\r\n                            end\r\n                        end\r\n                    end\r\n                end\r\n                return nil\r\n            end\r\n\r\n            -- =========================================================\r\n            -- SCAN ALL MISSING KIDS (CHILDNPC + CHARACTERS)\r\n            -- =========================================================\r\n            local function findLostKids()\r\n                local result = {}\r\n                local seen = {}\r\n\r\n                local function checkAndAdd(kid)\r\n                    if not kid or not kid.Parent or seen[kid] then return end\r\n\r\n                    local name = kid.Name\r\n                    local kidId = kid:GetAttribute(\"KidId\")\r\n                    local isKid = false\r\n\r\n                    if name:match(\"^Lost Child[1-4]?$\")\r\n                        or name:find(\"Kid\", 1, true)\r\n                        or kidId ~= nil\r\n                        or kid:HasTag(\"ChildNPC\") then\r\n                        isKid = true\r\n                    end\r\n\r\n                    if not isKid then return end\r\n                    if kid:GetAttribute(\"CanBeBagged\") ~= true\r\n                        or kid:GetAttribute(\"Friending\") == true\r\n                        or kid:GetAttribute(\"Destroyed\") == true\r\n                        or kid:GetAttribute(\"Ignited\") == true\r\n                        or tostring(kid:GetAttribute(\"Interaction\") or \"\"):match(\"^Befriend\") then\r\n                        return\r\n                    end\r\n\r\n                    if not kid:IsDescendantOf(workspace) then return end\r\n                    -- A Lost child inside the campfire radius may have been moved there\r\n                    -- locally by an older Anti Void build; still retrieve it with the Sack.\r\n                    if isInsideCampfireArea(kid) and kid:GetAttribute(\"Lost\") ~= true then\r\n                        return\r\n                    end\r\n\r\n                    seen[kid] = true\r\n                    table.insert(result, kid)\r\n                end\r\n\r\n                -- Scan CollectionService ChildNPC tag\r\n                pcall(function()\r\n                    local cs = game:GetService(\"CollectionService\")\r\n                    for _, obj in ipairs(cs:GetTagged(\"ChildNPC\")) do\r\n                        checkAndAdd(obj)\r\n                    end\r\n                end)\r\n\r\n                -- Scan workspace.Characters\r\n                local characters = workspace:FindFirstChild(\"Characters\")\r\n                if characters then\r\n                    for _, child in ipairs(characters:GetChildren()) do\r\n                        checkAndAdd(child)\r\n                    end\r\n                end\r\n\r\n                -- Scan workspace direct children (in case dropped kid unparented to workspace)\r\n                pcall(function()\r\n                    for _, child in ipairs(workspace:GetChildren()) do\r\n                        checkAndAdd(child)\r\n                    end\r\n                end)\r\n\r\n                return result\r\n            end\r\n\r\n            local function findNextTarget()\r\n                local now = os.clock()\r\n                for _, kid in ipairs(findLostKids()) do\r\n                    local retryAt = _G.KixRescueTargetRetryAt[kid] or 0\r\n                    if not isInsideCampfireArea(kid) and now >= retryAt then return kid end\r\n                end\r\n                return nil\r\n            end\r\n            _G.KixRescueFindTarget = findNextTarget\r\n\r\n            -- Ask StreamingEnabled to load the target's area before teleporting.\r\n            -- An unrendered last child can exist in workspace.Characters while its\r\n            -- body/interaction parts are not yet available to the client.\r\n            _G.KixPrepareKidForRescue = function(kid)\r\n                if not kid or not kid.Parent or not kid:IsDescendantOf(workspace) then\r\n                    return false\r\n                end\r\n\r\n                local startedAt = os.clock()\r\n                local initialPosition\r\n                local pivotOk = pcall(function()\r\n                    initialPosition = kid:GetPivot().Position\r\n                end)\r\n                if not pivotOk or not initialPosition then return false end\r\n\r\n                pcall(function()\r\n                    _LocalPlayer:RequestStreamAroundAsync(initialPosition, 5)\r\n                end)\r\n\r\n                local stablePosition = nil\r\n                local stableCount = 0\r\n                while os.clock() - startedAt < 8 do\r\n                    if not _G.AutoRescueLostChildActive or not kid.Parent\r\n                        or not kid:IsDescendantOf(workspace)\r\n                        or isAutoChopPriorityActive() then\r\n                        return false\r\n                    end\r\n\r\n                    local loaded = kid:GetAttribute(\"Loaded\")\r\n                    local partCount = 0\r\n                    for _, descendant in ipairs(kid:GetDescendants()) do\r\n                        if descendant:IsA(\"BasePart\") then\r\n                            partCount = partCount + 1\r\n                            if partCount >= 3 then break end\r\n                        end\r\n                    end\r\n\r\n                    local currentPosition\r\n                    local currentOk = pcall(function()\r\n                        currentPosition = kid:GetPivot().Position\r\n                    end)\r\n                    if loaded ~= false and partCount >= 3 and currentOk and currentPosition then\r\n                        if stablePosition and (currentPosition - stablePosition).Magnitude <= 1.5 then\r\n                            stableCount = stableCount + 1\r\n                        else\r\n                            stablePosition = currentPosition\r\n                            stableCount = 1\r\n                        end\r\n                        if stableCount >= 3 then\r\n                            _G.KixRescueTargetRetryAt[kid] = nil\r\n                            return true\r\n                        end\r\n                    else\r\n                        stableCount = 0\r\n                        stablePosition = nil\r\n                    end\r\n                    task.wait(0.25)\r\n                end\r\n\r\n                -- Avoid hammering the same unstreamed model while allowing the\r\n                -- rescue worker/map reveal to continue and retry it later.\r\n                _G.KixRescueTargetRetryAt[kid] = os.clock() + 20\r\n                return false\r\n            end\r\n\r\n            -- =========================================================\r\n            -- ITEM BAG & CARRIED KID CHECK\r\n            -- =========================================================\r\n            local function getCarriedKidInBag()\r\n                local itemBag = _LocalPlayer and _LocalPlayer:FindFirstChild(\"ItemBag\")\r\n                if not itemBag then return nil, nil end\r\n                for _, item in ipairs(itemBag:GetChildren()) do\r\n                    local iname = item.Name\r\n                    if iname:match(\"^Lost Child[1-4]?$\")\r\n                        or iname:find(\"Child\", 1, true)\r\n                        or iname:find(\"Kid\", 1, true)\r\n                        or item:GetAttribute(\"KidId\") ~= nil\r\n                        or kidNameMap[iname] ~= nil then\r\n                        return item, iname\r\n                    end\r\n                end\r\n                return nil, nil\r\n            end\r\n\r\n            local kidIdByName = {\r\n                [\"Lost Child\"] = \"DinoKid\", [\"Lost Child1\"] = \"DinoKid\", [\"Dino Kid\"] = \"DinoKid\", [\"DinoKid\"] = \"DinoKid\",\r\n                [\"Lost Child2\"] = \"KrakenKid\", [\"Kraken Kid\"] = \"KrakenKid\", [\"KrakenKid\"] = \"KrakenKid\",\r\n                [\"Lost Child3\"] = \"SquidKid\", [\"Squid Kid\"] = \"SquidKid\", [\"SquidKid\"] = \"SquidKid\",\r\n                [\"Lost Child4\"] = \"KoalaKid\", [\"Koala Kid\"] = \"KoalaKid\", [\"KoalaKid\"] = \"KoalaKid\",\r\n            }\r\n\r\n            local function isKidInItemBag(targetName)\r\n                local itemBag = _LocalPlayer and _LocalPlayer:FindFirstChild(\"ItemBag\")\r\n                if not itemBag then return false end\r\n                local targetId = kidIdByName[targetName]\r\n\r\n                for _, item in ipairs(itemBag:GetChildren()) do\r\n                    local iname = item.Name\r\n                    if targetName then\r\n                        if (targetId and item:GetAttribute(\"KidId\") == targetId)\r\n                            or iname == targetName\r\n                            or (kidNameMap[targetName] and iname == kidNameMap[targetName])\r\n                            or (kidNameMap[iname] and kidNameMap[iname] == targetName) then\r\n                            return true\r\n                        end\r\n                    else\r\n                        if iname:match(\"^Lost Child[1-4]?$\")\r\n                            or iname:find(\"Child\", 1, true)\r\n                            or iname:find(\"Kid\", 1, true)\r\n                            or item:GetAttribute(\"KidId\") ~= nil\r\n                            or kidNameMap[iname] ~= nil then\r\n                            return true\r\n                        end\r\n                    end\r\n                end\r\n                return false\r\n            end\r\n\r\n            local function getItemBagContainer()\r\n                return _LocalPlayer and _LocalPlayer:FindFirstChild(\"ItemBag\")\r\n            end\r\n\r\n            local function findBaggedKid(targetName, targetKid)\r\n                local itemBag = getItemBagContainer()\r\n                if not itemBag then return nil end\r\n                local targetId = targetKid and targetKid:GetAttribute(\"KidId\") or kidIdByName[targetName]\r\n                local displayName = kidNameMap[targetName]\r\n                for _, item in ipairs(itemBag:GetChildren()) do\r\n                    local itemId = item:GetAttribute(\"KidId\")\r\n                    if (targetId and itemId == targetId)\r\n                        or item.Name == targetName\r\n                        or (displayName and item.Name == displayName)\r\n                        or (kidIdByName[item.Name] and targetId and kidIdByName[item.Name] == targetId) then\r\n                        return item\r\n                    end\r\n                end\r\n                return nil\r\n            end\r\n\r\n            local function findBagRemote(remoteName)\r\n                local remoteEvents = _ReplicatedStorage:FindFirstChild(\"RemoteEvents\")\r\n                return (remoteEvents and remoteEvents:FindFirstChild(remoteName))\r\n                    or _ReplicatedStorage:FindFirstChild(remoteName, true)\r\n            end\r\n\r\n            local function invokeBagRemote(remote, ...)\r\n                if not remote then return false end\r\n                local args = table.pack(...)\r\n                local ok = pcall(function()\r\n                    if remote:IsA(\"RemoteFunction\") then\r\n                        remote:InvokeServer(table.unpack(args, 1, args.n))\r\n                    elseif remote:IsA(\"RemoteEvent\") then\r\n                        remote:FireServer(table.unpack(args, 1, args.n))\r\n                    else\r\n                        error(\"Unsupported bag remote class\")\r\n                    end\r\n                end)\r\n                return ok\r\n            end\r\n\r\n            local function hasBagCapacity(bag)\r\n                local playerInventory = _LocalPlayer and _LocalPlayer:FindFirstChild(\"Inventory\")\r\n                local itemBag = getItemBagContainer()\r\n                local character = _LocalPlayer and _LocalPlayer.Character\r\n                local backpack = _LocalPlayer and (_LocalPlayer:FindFirstChild(\"Backpack\") or _LocalPlayer:FindFirstChildOfClass(\"Backpack\"))\r\n                local bagOwned = bag and (\r\n                    (playerInventory and bag.Parent == playerInventory)\r\n                    or (character and bag.Parent == character)\r\n                    or (backpack and bag.Parent == backpack)\r\n                )\r\n                if not bagOwned or not itemBag then return false end\r\n                local modules = _ReplicatedStorage:FindFirstChild(\"Modules\")\r\n                local utilityModule = modules and modules:FindFirstChild(\"Utility\")\r\n                if utilityModule and utilityModule:IsA(\"ModuleScript\") then\r\n                    local ok, utility = pcall(require, utilityModule)\r\n                    if ok and utility and type(utility.GetItemBagSpace) == \"function\"\r\n                        and type(utility.GetItemBagUsedSpace) == \"function\" then\r\n                        local capacityOk, total, used = pcall(function()\r\n                            return utility.GetItemBagSpace(bag, _LocalPlayer),\r\n                                utility.GetItemBagUsedSpace(itemBag:GetChildren(), _LocalPlayer)\r\n                        end)\r\n                        if capacityOk and type(total) == \"number\" and type(used) == \"number\" then\r\n                            return total - used >= 1\r\n                        end\r\n                    end\r\n                end\r\n                -- If the current patch moved the capacity helpers, let the server validate the one-slot request.\r\n                return true\r\n            end\r\n\r\n            -- =========================================================\r\n            -- TELEPORT & LOCK TO KID\r\n            -- =========================================================\r\n            local kidLockConnection = nil\r\n\r\n            local function releaseKidLock()\r\n                if kidLockConnection then\r\n                    kidLockConnection:Disconnect()\r\n                    kidLockConnection = nil\r\n                end\r\n            end\r\n\r\n            rescueRelease = releaseKidLock\r\n            local function teleportToKid(kid)\r\n                if isAutoChopPriorityActive() then return false end\r\n                if not kid or not kid.Parent then return false end\r\n                if isInsideCampfireArea(kid) and kid:GetAttribute(\"Lost\") ~= true then return false end\r\n                local hrp = getHRP()\r\n                if not hrp then return false end\r\n\r\n                local ok, targetPivot = pcall(function() return kid:GetPivot() end)\r\n                if not ok or not targetPivot then return false end\r\n                local targetPosition = targetPivot.Position + Vector3.new(2, 0, 0)\r\n                local groundParams = RaycastParams.new()\r\n                groundParams.FilterType = Enum.RaycastFilterType.Exclude\r\n                groundParams.FilterDescendantsInstances = { getCharacter(), kid }\r\n                local ground = workspace:Raycast(\r\n                    targetPosition + Vector3.new(0, 8, 0),\r\n                    Vector3.new(0, -120, 0),\r\n                    groundParams\r\n                )\r\n                if ground then\r\n                    targetPosition = Vector3.new(targetPosition.X, ground.Position.Y + 3, targetPosition.Z)\r\n                end\r\n                local targetCFrame = CFrame.new(targetPosition)\r\n\r\n                releaseKidLock()\r\n                kidLockConnection = game:GetService(\"RunService\").Heartbeat:Connect(function()\r\n                    pcall(function()\r\n                        if isAutoChopPriorityActive() then\r\n                            releaseKidLock()\r\n                        elseif hrp and hrp.Parent then\r\n                            hrp.CFrame = targetCFrame\r\n                            hrp.AssemblyLinearVelocity = Vector3.zero\r\n                            hrp.AssemblyAngularVelocity = Vector3.zero\r\n                        end\r\n                    end)\r\n                end)\r\n\r\n                return true\r\n            end\r\n\r\n            -- =========================================================\r\n            -- STORE FLOW: request server-side bag storage without equipping the sack.\r\n            -- =========================================================\r\n            local function instantStoreKidInSack(sack, kid, targetName)\r\n                if not kid or not kid.Parent then return false end\r\n                local storeRemote = findBagRemote(\"RequestBagStoreItem\")\r\n                if not storeRemote then _G.KixRescueStatus = \"waiting_for_bag_store_remote\"; return false end\r\n                if not hasBagCapacity(sack) then _G.KixRescueStatus = \"sack_full_or_unavailable\"; return false end\r\n                local startedAt = os.clock()\r\n                local retryAt = startedAt + 1.5\r\n                local retried = false\r\n                invokeBagRemote(storeRemote, sack, kid)\r\n                while os.clock() - startedAt < 4 and isActive() and not isAutoChopPriorityActive() do\r\n                    if findBaggedKid(targetName, kid) then return true end\r\n                    if not retried and os.clock() >= retryAt and kid.Parent\r\n                        and hasBagCapacity(sack) then\r\n                        invokeBagRemote(storeRemote, sack, kid)\r\n                        retried = true\r\n                    end\r\n                    task.wait(0.1)\r\n                end\r\n                return findBaggedKid(targetName, kid) ~= nil\r\n            end\r\n\r\n            -- =========================================================\r\n            -- bag-drop flow sends the carried model through the game's bag remote.\r\n            -- =========================================================\r\n            local function triggerUnstore(sack, targetName, targetKid)\r\n                local dropRemote = findBagRemote(\"RequestBagDropItem\")\r\n                local carriedModel = findBaggedKid(targetName, targetKid)\r\n                if not sack or not getItemBagContainer() or not carriedModel or not dropRemote then return false end\r\n                -- Keep the sack equipped/owned after releasing its last child. Low-level\r\n                -- executors can report a stale ItemBag count, so never request sack drop.\r\n                return invokeBagRemote(dropRemote, sack, carriedModel, false)\r\n            end\r\n\r\n            -- =========================================================\r\n            -- RESTORE KID AT CAMPFIRE\r\n            -- =========================================================\r\n            local function restoreKidAtCampfire(sack, targetName, targetKid)\r\n                local hrp = getHRP()\r\n                if not hrp then return false end\r\n\r\n                -- Never request a bag drop until Campfire and its ground are streamed and stable.\r\n                local dropCFrame = waitForRenderedCampfire()\r\n                if not dropCFrame then return false end\r\n\r\n                triggerUnstore(sack, targetName, targetKid)\r\n                local retryDropAt = os.clock() + 1.5\r\n                local retriedDrop = false\r\n\r\n                -- Poll and confirm kid delivery at campfire (up to 8.0s)\r\n                local startT = os.clock()\r\n                while os.clock() - startT < 8.0 do\r\n                    if not isActive() or isAutoChopPriorityActive() then break end\r\n\r\n                    -- Check if target is explicitly befriended or inside campfire\r\n                    if targetKid and targetKid.Parent then\r\n                        if targetKid:IsDescendantOf(workspace) and isDeliveredAtCampfire(targetKid) and not isKidInItemBag(targetName) then\r\n                            return true\r\n                        end\r\n                    end\r\n\r\n                    local inBag = findBaggedKid(targetName, targetKid) ~= nil\r\n                    local inWorld = targetKid and targetKid.Parent and targetKid:IsDescendantOf(workspace)\r\n\r\n                    -- If no longer in bag\r\n                    if not inBag then\r\n                        -- If kid dropped out during flight into the forest\r\n                        if inWorld and not isInsideCampfireArea(targetKid) then\r\n                            return false\r\n                        end\r\n                        -- Replication can replace the bag instance with a world model.\r\n                        local chars = workspace:FindFirstChild(\"Characters\")\r\n                        local released = (chars and chars:FindFirstChild(targetName)) or workspace:FindFirstChild(targetName)\r\n                        if not released and chars then\r\n                            local wantedId = targetKid and targetKid:GetAttribute(\"KidId\") or kidIdByName[targetName]\r\n                            for _, candidate in ipairs(chars:GetChildren()) do\r\n                                if wantedId and candidate:GetAttribute(\"KidId\") == wantedId then released = candidate; break end\r\n                            end\r\n                        end\r\n                        if released and isDeliveredAtCampfire(released) then return true end\r\n                    end\r\n\r\n                    task.wait(0.1)\r\n\r\n                    -- Retry once after allowing slow executor/server replication to settle.\r\n                    if not retriedDrop and os.clock() >= retryDropAt and inBag then\r\n                        if hrp and hrp.Parent then\r\n                            hrp.CFrame = dropCFrame\r\n                            hrp.AssemblyLinearVelocity = Vector3.zero\r\n                        end\r\n                        triggerUnstore(sack, targetName, targetKid)\r\n                        retriedDrop = true\r\n                    end\r\n                end\r\n\r\n                local inBagFinal = findBaggedKid(targetName, targetKid) ~= nil\r\n                if not inBagFinal and targetKid and targetKid:IsDescendantOf(workspace) then return isDeliveredAtCampfire(targetKid) end\r\n                local chars = workspace:FindFirstChild(\"Characters\")\r\n                local released = chars and chars:FindFirstChild(targetName)\r\n                return not inBagFinal and released ~= nil and isDeliveredAtCampfire(released)\r\n            end\r\n\r\n            -- =========================================================\r\n            -- MAIN 1-BY-1 SEQUENTIAL RESCUE LOOP\r\n            -- =========================================================\r\n            notify(\"Kid Rescue\", \"Scanning for missing children...\", 1.5, \"search\")\r\n\r\n            while _G.AutoRescueLostChildActive do\r\n                if _G.KixFullAuto and _G.KixFullAuto.Active and _G.KixFullAuto.IsPaused then\r\n                    task.wait(0.2)\r\n                    continue\r\n                end\r\n                -- Priority checks\r\n                if _G.AutoChestRunning or _G.AutoChopSelectedTreesActive or _G.IsStrongholdRaidActive then\r\n                    task.wait(1)\r\n                    continue\r\n                end\r\n\r\n                local hrp = getHRP()\r\n                if not hrp then\r\n                    task.wait(0.5)\r\n                    continue\r\n                end\r\n\r\n                local sack = findBagTool()\r\n                if not sack then\r\n                    notify(\"Kid Rescue\", \"sack in the inventory with an empty slot is required\", 2, \"alert-circle\")\r\n                    task.wait(2)\r\n                    continue\r\n                end\r\n\r\n                if _G.IsEating then task.wait(0.2); continue end\r\n\r\n                -- =============================================================\r\n                -- PRIORITY 1: Check if player is ALREADY carrying a kid in ItemBag!\r\n                -- This handles any kid already in sack (e.g. the 4th/last kid)\r\n                -- so it is immediately restored at Campfire without scanning forest!\r\n                -- =============================================================\r\n                local carriedKidItem, carriedKidName = getCarriedKidInBag()\r\n                if carriedKidItem then\r\n                    _G.KixRescueBusy = true\r\n                    _G.KixRescueStatus = \"restoring_carried\"\r\n                    local displayName = kidNameMap[carriedKidName] or carriedKidName or \"Missing Child\"\r\n                    notify(\"Kid Rescue\", \"Carrying \" .. displayName .. \" in sack. Restoring at Campfire...\", 1.5, \"package-check\")\r\n\r\n                    -- Restore kid at Campfire\r\n                    local restored = restoreKidAtCampfire(sack, carriedKidName, nil)\r\n                    if restored then\r\n                        rescuedKids[carriedKidName] = true\r\n                        _G.KixRescuePending = nil\r\n                        notify(\"Kid Rescue\", displayName .. \" successfully restored at campfire!\", 2, \"check\")\r\n                        _G.KixRescueStatus = \"delivered\"\r\n                        task.wait(0.5)\r\n                    else\r\n                        notify(\"Kid Rescue\", \"Retrying release for \" .. displayName .. \"...\", 1.2, \"alert-circle\")\r\n                        task.wait(0.3)\r\n                    end\r\n                    _G.KixRescueBusy = false\r\n                    continue\r\n                end\r\n\r\n                -- PRIORITY 2: Check _G.KixRescuePending\r\n                if _G.KixRescuePending then\r\n                    _G.KixRescueBusy = true\r\n                    if restoreKidAtCampfire(sack, _G.KixRescuePending, nil) then\r\n                        _G.KixRescuePending = nil\r\n                    end\r\n                    _G.KixRescueBusy = false\r\n                    task.wait(0.5)\r\n                    continue\r\n                end\r\n\r\n                -- PRIORITY 3: Find next lost kid in forest\r\n                local target = findNextTarget()\r\n                if not target then\r\n                    -- If reveal was paused for rescue and no reachable kids remain, resume reveal safely!\r\n                    if AutoMapReveal and AutoMapReveal.State and AutoMapReveal.State.IsPausedForRescue then\r\n                        if not _G.KixRescueBusy and not _G.KixRescuePending then\r\n                            local isCarrying = false\r\n                            if _G.KixAdapters and _G.KixAdapters.AutoRescue and type(_G.KixAdapters.AutoRescue.IsCarryingKid) == \"function\" then\r\n                                isCarrying = _G.KixAdapters.AutoRescue.IsCarryingKid()\r\n                            end\r\n                            if not isCarrying and type(AutoMapReveal.ResumeAfterRescue) == \"function\" then\r\n                                AutoMapReveal.ResumeAfterRescue()\r\n                            end\r\n                        end\r\n                    end\r\n                    -- All reachable kids are rescued or at base\r\n                    task.wait(SCAN_DELAY * 5)\r\n                    continue\r\n                end\r\n\r\n                -- PAUSE REVEAL BEFORE RESCUE MOVES CHARACTER (Unconditional: stops flight regardless of mode)\r\n                if AutoMapReveal and AutoMapReveal.State and AutoMapReveal.State.IsScanning then\r\n                    if type(AutoMapReveal.PauseForRescue) == \"function\" then\r\n                        AutoMapReveal.PauseForRescue()\r\n                        -- Beri waktu untuk jarak dekat/kontak pemain ke Lost Child\r\n                        -- direplikasi sebelum prompt Put in sack dipicu.\r\n                        task.wait(0.35)\r\n                    end\r\n                end\r\n\r\n                _G.KixRescueBusy = true\r\n                _G.KixRescueStatus = \"retrieving\"\r\n                local targetName = target.Name\r\n                local displayName = kidNameMap[targetName] or target:GetAttribute(\"PingName\") or targetName\r\n\r\n                notify(\"Kid Rescue\", \"Found \" .. displayName .. \". Teleporting...\", 1.2, \"search\")\r\n\r\n                -- RETRY / RE-PICKUP LOOP: If kid drops during transit, immediately re-teleport and re-pickup\r\n                local rescueAttempts = 0\r\n                local delivered = false\r\n\r\n                while rescueAttempts < 5 and not delivered and _G.AutoRescueLostChildActive do\r\n                    rescueAttempts = rescueAttempts + 1\r\n\r\n                    -- stores children through the bag remotes; equipping the sack is unnecessary.\r\n                    if not getItemBagContainer() then\r\n                        _G.KixRescueStatus = \"waiting_for_item_bag\"\r\n                        task.wait(0.5)\r\n                        break\r\n                    end\r\n\r\n                    -- Check if kid already reached campfire safezone\r\n                    if target:IsDescendantOf(workspace) and isDeliveredAtCampfire(target) and not isKidInItemBag(targetName) then\r\n                        delivered = true\r\n                        break\r\n                    end\r\n\r\n                    -- Check if kid is already in sack\r\n                    local stored = isKidInItemBag(targetName)\r\n                    if not stored then\r\n                        if not _G.KixPrepareKidForRescue(target) then\r\n                            _G.KixRescueStatus = \"waiting_for_kid_stream\"\r\n                            notify(\"Kid Rescue\", \"Waiting for the child area to load; retrying shortly.\", 2, \"search\")\r\n                            break\r\n                        end\r\n\r\n                        -- Teleport to Kid (re-locate wherever kid is right now, even if dropped in forest!)\r\n                        local teleported = teleportToKid(target)\r\n                        if not teleported then\r\n                            task.wait(0.5)\r\n                            break\r\n                        end\r\n\r\n                        task.wait(0.15)\r\n                        stored = instantStoreKidInSack(sack, target, targetName)\r\n                        releaseKidLock()\r\n                    end\r\n\r\n                    if stored or isKidInItemBag(targetName) then\r\n                        notify(\"Kid Rescue\", displayName .. \" secured. Returning to base...\", 1.2, \"package-check\")\r\n\r\n                        -- Restore/Release Kid at Campfire\r\n                        _G.KixRescuePending = targetName\r\n                        local restored = restoreKidAtCampfire(sack, targetName, target)\r\n                        if restored then\r\n                            _G.KixRescuePending = nil\r\n                            delivered = true\r\n                            rescuedKids[targetName] = true\r\n                            rescuedKids[target] = true\r\n                            notify(\"Kid Rescue\", displayName .. \" released at campfire.\", 2, \"check\")\r\n                            _G.KixRescueStatus = \"delivered\"\r\n                            break\r\n                        else\r\n                            -- Delivery was not confirmed or kid dropped out during transit!\r\n                            if target and target.Parent and not isInsideCampfireArea(target) then\r\n                                _G.KixRescuePending = nil\r\n                                notify(\"Kid Rescue\", displayName .. \" dropped in transit! Re-securing...\", 1.5, \"alert-circle\")\r\n                                task.wait(0.3)\r\n                                -- Loop retries: teleports to kid's new dropped position and re-picks up!\r\n                            else\r\n                                -- Kid is still in bag! Keep pending so it is retried\r\n                                _G.KixRescuePending = targetName\r\n                            end\r\n                        end\r\n                    else\r\n                        notify(\"Kid Rescue\", \"Retrieval failed. Retrying...\", 1.2, \"x-circle\")\r\n                        task.wait(0.4)\r\n                    end\r\n                end\r\n\r\n                if not delivered then\r\n                    rescuedKids[targetName] = nil\r\n                    rescuedKids[target] = nil\r\n                    if _G.KixRescueStatus ~= \"waiting_for_kid_stream\" then\r\n                        _G.KixRescueStatus = \"retry_needed\"\r\n                    end\r\n                end\r\n\r\n                _G.KixRescueBusy = false\r\n                task.wait(SCAN_DELAY)\r\n            end\r\n\r\n            _G.KixRescueBusy = false\r\n            releaseKidLock()\r\n            end, function(err) return tostring(err) end)\r\n            if rescueRelease then pcall(rescueRelease) end\r\n            _G.KixRescueBusy = false\r\n            _G.AutoRescueLostChildRunning = false\r\n            if not rescueOK then\r\n                _G.AutoRescueLostChildActive = false\r\n                _G.KixRescueStatus = \"error: \" .. rescueError\r\n                warn(\"[FullAuto Rescue] \" .. rescueError)\r\n            end\r\n        end)\r\nend\r\n\r\nUI_AutoRescueToggle = Tabs.Auto:Toggle({\r\n    Title = \"🚨 Auto Rescue All Missing Kid\",\r\n    Value = false,\r\n\r\n    Callback = function(value)\r\n        local controller = _G.KixFullAuto\r\n        if value == false and controller then\r\n            controller.Owned[\"AutoRescue\"] = nil\r\n            if controller.Suspended then controller.Suspended[\"AutoRescue\"] = nil end\r\n        end\r\n        return _G.KixEngines.AutoRescue(value)\r\n    end\r\n})\r\n\r\n_G.AutoRescueLostChildToggle = UI_AutoRescueToggle\r\n\r\n_G.KixAdapters = _G.KixAdapters or {}\r\n_G.KixAdapters.AutoRescue = {\r\n    IsEnabled = function()\r\n        return _G.AutoRescueLostChildActive == true\r\n    end,\r\n    IsRunning = function()\r\n        return _G.AutoRescueLostChildRunning == true\r\n    end,\r\n    SetState = function(state)\r\n        return _G.KixEngines.AutoRescue(state)\r\n    end,\r\n    HasSack = function()\r\n        local lp = _LocalPlayer\r\n        local inventory = lp and lp:FindFirstChild(\"Inventory\")\r\n        local character = lp and lp.Character\r\n        local backpack = lp and (lp:FindFirstChild(\"Backpack\") or lp:FindFirstChildOfClass(\"Backpack\"))\r\n        local folders = {}\r\n        if inventory then folders[#folders + 1] = inventory end\r\n        if character then folders[#folders + 1] = character end\r\n        if backpack then folders[#folders + 1] = backpack end\r\n        for _, folder in ipairs(folders) do\r\n            for _, item in ipairs(folder:GetChildren()) do\r\n                if item:GetAttribute(\"EasterBasket\") ~= true then\r\n                    local ok, tagged = pcall(function() return item:HasTag(\"ItemBag\") end)\r\n                    local name = item.Name:lower()\r\n                    if (ok and tagged) or name:find(\"sack\", 1, true)\r\n                        or item:GetAttribute(\"ToolName\") == \"Item Bag\"\r\n                        or item:GetAttribute(\"NumberItems\") ~= nil then\r\n                        return true\r\n                    end\r\n                end\r\n            end\r\n        end\r\n        return false\r\n    end,\r\n    IsCarryingKid = function()\r\n        local bag = _LocalPlayer and _LocalPlayer:FindFirstChild(\"ItemBag\")\r\n        if bag then\r\n            for _, itm in ipairs(bag:GetChildren()) do\r\n                local n = itm.Name\r\n                if n:match(\"^Lost Child[1-4]?$\")\r\n                    or n:find(\"Child\", 1, true)\r\n                    or n:find(\"Kid\", 1, true)\r\n                    or itm:GetAttribute(\"KidId\") ~= nil then\r\n                    return true\r\n                end\r\n            end\r\n        end\r\n        return false\r\n    end\r\n}\r\n\r\n-- =========================================================\r\n-- AUTO CHEST SHORTCUT\r\n-- =========================================================\r\n\r\nlocal executeAutoChest\r\n\r\nTabs.Auto:Button({\r\n    Title = 'Open Chest With Map Reveal',\r\n    Desc = \"Prepares the fire, reveals the map, opens chests, collects coins, and buys tools.\",\r\n    Callback = function()\r\n        if _G.KixAutoChestRenderedOnlyEnabled then\r\n            if WindUI then WindUI:Notify({Title = \"Auto Chest\", Content = \"Turn off the rendered-chest toggle first.\", Duration = 3}) end\r\n            return\r\n        end\r\n        local controller = _G.KixFullAuto\r\n        if not controller or type(controller.StartChestLootOnly) ~= \"function\" then\r\n            if WindUI then\r\n                WindUI:Notify({Title = \"Auto Chest\", Content = \"Automation controller is not ready. Re-execute the hub.\", Duration = 4})\r\n            end\r\n            return\r\n        end\r\n        local started, reason = controller.StartChestLootOnly()\r\n        if not started and WindUI then\r\n            WindUI:Notify({Title = \"Auto Chest\", Content = tostring(reason or \"Could not start the manual sequence.\"), Duration = 4})\r\n        end\r\n    end\r\n})\r\n\r\n_G.KixStartRenderedChestOnly = function(enabled)\r\n    enabled = enabled == true\r\n    _G.KixAutoChestRenderedOnlyEnabled = enabled\r\n    _G.KixAutoChestRenderedOnlyToken = (_G.KixAutoChestRenderedOnlyToken or 0) + 1\r\n    local runToken = _G.KixAutoChestRenderedOnlyToken\r\n    if not enabled then return end\r\n\r\n    if not includeHighTierChests and not includeLowTierChests then\r\n        _G.KixAutoChestRenderedOnlyEnabled = false\r\n        if WindUI then WindUI:Notify({Title = \"Auto Chest\", Content = \"Select at least one chest tier first.\", Duration = 3}) end\r\n        if _G.KixAutoChestRenderedToggle then pcall(function() _G.KixAutoChestRenderedToggle:SetValue(false) end) end\r\n        return\r\n    end\r\n    if _G.AutoChestRunning or (_G.KixAutoChestCore and _G.KixAutoChestCore.Running) then\r\n        _G.KixAutoChestRenderedOnlyEnabled = false\r\n        if WindUI then WindUI:Notify({Title = \"Auto Chest\", Content = \"Another chest or automation task is already running.\", Duration = 3}) end\r\n        if _G.KixAutoChestRenderedToggle then pcall(function() _G.KixAutoChestRenderedToggle:SetValue(false) end) end\r\n        return\r\n    end\r\n\r\n    task.spawn(function()\r\n        local core = _G.KixAutoChestCore\r\n        if not core or type(core.Run) ~= \"function\" then\r\n            _G.KixAutoChestRenderedOnlyEnabled = false\r\n            if WindUI then WindUI:Notify({Title = \"Auto Chest\", Content = \"Chest system is not ready yet.\", Duration = 3}) end\r\n            if _G.KixAutoChestRenderedToggle then pcall(function() _G.KixAutoChestRenderedToggle:SetValue(false) end) end\r\n            return\r\n        end\r\n\r\n        local originalAntiVoid = _G.AntiVoidItemsEnabled\r\n        _G.AutoChestAntiVoidOriginal = originalAntiVoid\r\n        _G.AutoChestAntiVoidMode, _G.AntiVoidItemsEnabled = true, true\r\n        _G.AutoChestBroughtCounts, _G.TempEquippedCache = {}, {}\r\n        local callOk, completed, detail = pcall(function()\r\n            return core.Run(\r\n                function()\r\n                    return KixHubSession.Alive\r\n                        and _G.KixAutoChestRenderedOnlyEnabled\r\n                        and _G.KixAutoChestRenderedOnlyToken == runToken\r\n                end,\r\n                function(text) setAutoChestStatus(\"Status: \" .. tostring(text)) end,\r\n                function(seconds)\r\n                    task.wait(seconds or 0)\r\n                    return KixHubSession.Alive\r\n                        and _G.KixAutoChestRenderedOnlyEnabled\r\n                        and _G.KixAutoChestRenderedOnlyToken == runToken\r\n                end,\r\n                nil,\r\n                false,\r\n                nil,\r\n                true\r\n            )\r\n        end)\r\n\r\n        _G.AutoChestAntiVoidMode = false\r\n        _G.AntiVoidItemsEnabled = originalAntiVoid\r\n        _G.AutoChestAntiVoidOriginal = nil\r\n        if callOk and completed then\r\n            _G.AutoChestStatus = \"completed_rendered_only\"\r\n            setAutoChestStatus(\"Status: Rendered chests complete.\")\r\n        elseif _G.KixAutoChestRenderedOnlyEnabled and _G.KixAutoChestRenderedOnlyToken == runToken then\r\n            _G.AutoChestStatus = \"failed\"\r\n            if WindUI then WindUI:Notify({Title = \"Auto Chest\", Content = tostring(detail or completed or \"Chest scan stopped.\"), Duration = 4}) end\r\n        else\r\n            _G.AutoChestStatus = \"stopped_rendered_only\"\r\n            setAutoChestStatus(\"Status: Rendered-chest scan stopped.\")\r\n        end\r\n\r\n        if _G.KixAutoChestRenderedOnlyToken == runToken then\r\n            _G.KixAutoChestRenderedOnlyEnabled = false\r\n            if _G.KixAutoChestRenderedToggle then pcall(function() _G.KixAutoChestRenderedToggle:SetValue(false) end) end\r\n        end\r\n    end)\r\nend\r\n\r\n_G.KixAutoChestRenderedToggle = Tabs.Auto:Toggle({\r\n    Title = 'Auto Open Chest',\r\n    Desc = 'Auto Open Chest Without Scan Map',\r\n    Value = false,\r\n    Callback = _G.KixStartRenderedChestOnly\r\n})\r\n\r\nlocal targetTreeNames = {\r\n    [\"Thicket\"] = true,\r\n    [\"Fairy Small Tree\"] = true,\r\n    [\"Small Tree\"] = true,\r\n    [\"Dead Tree1\"] = true,\r\n    [\"Dead Tree2\"] = true,\r\n    [\"Dead Tree3\"] = true,\r\n    [\"Snowy Small Tree\"] = true,\r\n    [\"JungleTreeSmall1\"] = true,\r\n    [\"JungleTreeSmall2\"] = true,\r\n    [\"Birch Tree\"] = true,\r\n    [\"Small Apple Tree\"] = true,\r\n    [\"Small Webbed Tree\"] = true,\r\n\r\n    [\"TreeBig1\"] = true,\r\n    [\"TreeBig2\"] = true,\r\n    [\"TreeBig3\"] = true,\r\n    [\"Big Tree\"] = true,\r\n    [\"Big Tree1\"] = true,\r\n    [\"Big Tree2\"] = true,\r\n    [\"Big Tree3\"] = true,\r\n    [\"BigTree\"] = true,\r\n    [\"BigTree1\"] = true,\r\n    [\"BigTree2\"] = true,\r\n    [\"BigTree3\"] = true,\r\n\r\n    [\"FairyTreeBig1\"] = true,\r\n    [\"FairyTreeBig2\"] = true,\r\n    [\"FairyTreeBig3\"] = true,\r\n    [\"Fairy Tree Big1\"] = true,\r\n    [\"Fairy Tree Big2\"] = true,\r\n    [\"Fairy Tree Big3\"] = true,\r\n\r\n    [\"WebbedTreeBig1\"] = true,\r\n    [\"WebbedTreeBig2\"] = true,\r\n    [\"WebbedTreeBig3\"] = true,\r\n    [\"Webbed Tree Big1\"] = true,\r\n    [\"Webbed Tree Big2\"] = true,\r\n    [\"Webbed Tree Big3\"] = true,\r\n\r\n    [\"Jungle Tree Big1\"] = true,\r\n    [\"Jungle Tree Big2\"] = true,\r\n    [\"JungleTreeBig1\"] = true,\r\n    [\"JungleTreeBig2\"] = true,\r\n\r\n    [\"Corrupted TreeBig1\"] = true,\r\n    [\"Corrupted TreeBig2\"] = true,\r\n    [\"Corrupted TreeBig3\"] = true,\r\n    [\"CorruptedTreeBig1\"] = true,\r\n    [\"CorruptedTreeBig2\"] = true,\r\n    [\"CorruptedTreeBig3\"] = true,\r\n\r\n    [\"Beehive Birch Tree\"] = true,\r\n    [\"Brightwood Tree\"] = true\r\n}\r\n\r\nlocal function getHalloweenBeekeeperTrees(map)\r\n    local landmarks = map and map:FindFirstChild(\"Landmarks\")\r\n    local halloweenHouse = landmarks and landmarks:FindFirstChild(\"Halloween House Beekeeper\")\r\n    return halloweenHouse and halloweenHouse:FindFirstChild(\"Trees\")\r\nend\r\n\r\nlocal function getClosestTargetTree(hrp)\r\n    local map = workspace:FindFirstChild(\"Map\")\r\n    if not map then return nil end\r\n\r\n    local closestSmallTree = nil\r\n    local shortestSmallDistance = math.huge\r\n\r\n    local closestBigTree = nil\r\n    local shortestBigDistance = math.huge\r\n\r\n    local treeFolders = {}\r\n    local foliage = map:FindFirstChild(\"Foliage\")\r\n    local halloweenBeekeeperTrees = getHalloweenBeekeeperTrees(map)\r\n    if foliage then table.insert(treeFolders, foliage) end\r\n    if halloweenBeekeeperTrees then table.insert(treeFolders, halloweenBeekeeperTrees) end\r\n    for _, treeFolder in ipairs(treeFolders) do\r\n        if treeFolder then\r\n            for _, t in ipairs(treeFolder:GetChildren()) do\r\n                if targetTreeNames[t.Name] then\r\n                    if t:FindFirstChild(\"Trunk\") or t.PrimaryPart or t:FindFirstChildWhichIsA(\"BasePart\") then\r\n                        local cPos = t:FindFirstChild(\"Trunk\") and t.Trunk.Position or (t.PrimaryPart and t.PrimaryPart.Position or (t:FindFirstChildWhichIsA(\"BasePart\") and t:FindFirstChildWhichIsA(\"BasePart\").Position))\r\n                        if cPos then\r\n                            local dist = (hrp.Position - cPos).Magnitude\r\n                            local isBigTree = string.find(t.Name, \"Big\", 1, true) ~= nil\r\n                            if not isBigTree then\r\n                                if dist < shortestSmallDistance then\r\n                                    shortestSmallDistance = dist\r\n                                    closestSmallTree = t\r\n                                end\r\n                            else\r\n                                if dist < shortestBigDistance then\r\n                                    shortestBigDistance = dist\r\n                                    closestBigTree = t\r\n                                end\r\n                            end\r\n                        end\r\n                    end\r\n                end\r\n            end\r\n        end\r\n    end\r\n    return closestSmallTree or closestBigTree\r\nend\r\n\r\nlocal wasChopAuraEnabledBeforeAutoChop = false\r\n_G.KixEngines.AutoChopTrees = function(val)\r\n    if (_G.AutoChopSelectedTreesActive == true) == val then return end\r\n        _G.AutoChopSelectedTreesActive = val\r\n\r\n        -- =========================================================\r\n        -- FORCE STOP SAAT AUTO CHOP DI-NONAKTIFKAN\r\n        -- =========================================================\r\n        if not val then\r\n            -- Hentikan loop Auto Chop\r\n            _G.AutoChopSelectedTreesActive = false\r\n            _G.AutoChopSelectedTreesRunning = false\r\n            _G.KixAutoChopTargetActive = false\r\n            _G.KixAutoChopTargetAt = 0\r\n            _G.AllowBodyAura = false\r\n\r\n            -- RESTORE CHOP AURA STATE (Menyesuaikan dengan state sebelumnya)\r\n            pcall(function()\r\n                if not wasChopAuraEnabledBeforeAutoChop then\r\n                    if chopAuraEnabled and toggleChopAura then\r\n                        toggleChopAura(false)\r\n                    end\r\n                    chopAuraEnabled = false\r\n                end\r\n            end)\r\n            \r\n            -- IMMEDIATE TELEPORT KE RETURN POS\r\n            pcall(function()\r\n                local myChar = _LocalPlayer.Character\r\n                local hrp = myChar and myChar:FindFirstChild(\"HumanoidRootPart\")\r\n                if hrp and not _G.KixHalloweenTrickBusy\r\n                    and not _G.IsStrongholdRaidActive and not _G.StrongholdTransition\r\n                    and not _G.StrongholdPreparingRaid and not _G.CampfireCombatActive\r\n                    and not _G.CorruptedCombatActive and not _G.MossyCombatActive\r\n                    and not _G.TurkeyCombatActive and not _G.BearCombatActive\r\n                    and not _G.GlobalCultistCombatActive and not _G.MammothCombatActive\r\n                    and not _G.FrogCombatActive and not _G.CustomHuntCombatActive\r\n                    and not _G.ForceStrongholdRaid and not _G.CampfireCombatPaused\r\n                    and not _G.AutoChestRunning and not _G.KixRescueBusy then\r\n                    -- Auto Chop is declared before the local Stronghold\r\n                    -- variable exists, so read the persisted return point\r\n                    -- directly. This makes the latest Set Return Position\r\n                    -- take priority over the default campfire.\r\n                    local returnPos = KixHubSavedState.customReturnPos or campfirePos or hrp.Position\r\n                    hrp.Anchored = true\r\n                    hrp.CFrame = CFrame.new(returnPos.X, returnPos.Y + 3, returnPos.Z)\r\n                    task.wait(0.1)\r\n                    hrp.Anchored = false\r\n                end\r\n            end)\r\n            \r\n            return\r\n        end\r\n\r\n        -- =========================================================\r\n        -- AUTO CHOP ENABLED\r\n        -- =========================================================\r\n        _G.KixAutoChopTargetActive = false\r\n        _G.KixAutoChopTargetAt = 0\r\n        _G.KixEngines.Spawn(\"AutoChopTrees\", function()\r\n            local hrp = _LocalPlayer.Character\r\n                and _LocalPlayer.Character:FindFirstChild(\"HumanoidRootPart\")\r\n\r\n            if not hrp then\r\n                _G.AutoChopSelectedTreesRunning = false\r\n                return\r\n            end\r\n\r\n            local mapFolder = workspace:FindFirstChild(\"Map\")\r\n            local foliageFolder = mapFolder and mapFolder:FindFirstChild(\"Foliage\")\r\n            local halloweenBeekeeperTrees = getHalloweenBeekeeperTrees(mapFolder)\r\n            local skippedTrees = setmetatable({}, {__mode = \"k\"})\r\n            if not mapFolder or (not foliageFolder and not halloweenBeekeeperTrees) then\r\n                _G.AutoChopSelectedTreesRunning = false\r\n                return\r\n            end\r\n\r\n            _G.AutoChopSelectedTreesRunning = true\r\n\r\n            local wasFlying = flying\r\n            if flying then\r\n                stopFlying()\r\n            end\r\n\r\n            local staticFly = Instance.new(\"BodyVelocity\")\r\n            staticFly.Name = \"CombatStaticFly\"\r\n            staticFly.MaxForce = Vector3.new(math.huge, math.huge, math.huge)\r\n            staticFly.Velocity = Vector3.zero\r\n            staticFly.Parent = hrp\r\n\r\n            -- =====================================================\r\n            -- AUTO ENABLE CHOP AURA\r\n            -- =====================================================\r\n            wasChopAuraEnabledBeforeAutoChop = chopAuraEnabled or false\r\n            \r\n            if toggleChopAura and not chopAuraEnabled then\r\n                pcall(function()\r\n                    toggleChopAura(true)\r\n                end)\r\n            end\r\n\r\n            _G.AllowBodyAura = true\r\n\r\n            local hum = hrp.Parent:FindFirstChild(\"Humanoid\")\r\n\r\n            local savedCollisions = {}\r\n\r\n            for _, part in ipairs(hrp.Parent:GetDescendants()) do\r\n                if part:IsA(\"BasePart\") then\r\n                    savedCollisions[part] = part.CanCollide\r\n                end\r\n            end\r\n\r\n            local noclipChop = _RunService.Stepped:Connect(function()\r\n                if not _G.AutoChopSelectedTreesActive\r\n                    or _G.KixAutoChopHold or _G.ForceStrongholdRaid\r\n                    or _G.KixHalloweenTrickBusy\r\n                    or _G.IsStrongholdRaidActive or _G.StrongholdTransition\r\n                    or _G.StrongholdPreparingRaid or _G.CampfireCombatActive\r\n                    or _G.CorruptedCombatActive or _G.MossyCombatActive\r\n                    or _G.TurkeyCombatActive or _G.BearCombatActive\r\n                    or _G.GlobalCultistCombatActive or _G.MammothCombatActive\r\n                    or _G.FrogCombatActive or _G.CustomHuntCombatActive\r\n                    or _G.AutoChestRunning or _G.KixRescueBusy then\r\n                    if _G.KixAutoChopNoclipApplied then\r\n                        pcall(function()\r\n                            for part, coll in pairs(savedCollisions) do\r\n                                if part and part.Parent then part.CanCollide = coll end\r\n                            end\r\n                        end)\r\n                        _G.KixAutoChopNoclipApplied = false\r\n                    end\r\n                    return\r\n                end\r\n\r\n                if not getgenv()._NoclipPartsCache then\r\n                    getgenv()._NoclipPartsCache = {}\r\n                    for _, part in ipairs(hrp.Parent:GetDescendants()) do\r\n                        if part:IsA(\"BasePart\") then table.insert(getgenv()._NoclipPartsCache, part) end\r\n                    end\r\n                end\r\n                for i = 1, #getgenv()._NoclipPartsCache do\r\n                    getgenv()._NoclipPartsCache[i].CanCollide = false\r\n                end\r\n                _G.KixAutoChopNoclipApplied = true\r\n            end)\r\n\r\n            while _G.AutoChopSelectedTreesActive do\r\n\r\n                if _G.KixAutoChopHold or _G.ForceStrongholdRaid or _G.CampfireCombatPaused\r\n                    or _G.KixHalloweenTrickBusy\r\n                    or _G.IsStrongholdRaidActive\r\n                    or _G.StrongholdTransition\r\n                    or _G.StrongholdPreparingRaid\r\n                    or _G.CampfireCombatActive\r\n                    or _G.CorruptedCombatActive\r\n                    or _G.MossyCombatActive\r\n                    or _G.TurkeyCombatActive\r\n                    or _G.BearCombatActive\r\n                    or _G.GlobalCultistCombatActive\r\n                    or _G.MammothCombatActive or _G.FrogCombatActive or _G.CustomHuntCombatActive\r\n                    or _G.AutoChestRunning or _G.KixRescueBusy then\r\n\r\n                    task.wait(1)\r\n                    continue\r\n                end\r\n\r\n                halloweenBeekeeperTrees = getHalloweenBeekeeperTrees(mapFolder)\r\n                local trees = {}\r\n                local campground = mapFolder:FindFirstChild(\"Campground\")\r\n                local mainFire = campground and campground:FindFirstChild(\"MainFire\")\r\n                local center = mainFire and mainFire:GetPivot().Position or campfirePos\r\n\r\n                local treeFolders = {}\r\n                if foliageFolder then table.insert(treeFolders, foliageFolder) end\r\n                if halloweenBeekeeperTrees then table.insert(treeFolders, halloweenBeekeeperTrees) end\r\n                for _, treeFolder in ipairs(treeFolders) do\r\n                    if treeFolder then\r\n                        for _, t in ipairs(treeFolder:GetChildren()) do\r\n                            if targetTreeNames[t.Name]\r\n                                and not skippedTrees[t]\r\n                                and not string.find(string.lower(t.Name), \"big\", 1, true) then\r\n                                local part =\r\n                                    t:FindFirstChild(\"Trunk\")\r\n                                    or t.PrimaryPart\r\n                                    or t:FindFirstChildWhichIsA(\"BasePart\")\r\n\r\n                                if part then\r\n                                    local offset = part.Position - center\r\n                                    local radius = Vector2.new(offset.X, offset.Z).Magnitude\r\n                                    local angle = math.atan2(offset.Z, offset.X) % (2 * math.pi)\r\n                                    table.insert(trees, {\r\n                                        ring = math.floor(radius / 50),\r\n                                        angle = angle,\r\n                                        radius = radius,\r\n                                        model = t,\r\n                                        part = part,\r\n                                        container = treeFolder,\r\n                                        isSmall = string.find(t.Name, \"Big\", 1, true) == nil\r\n                                    })\r\n                                end\r\n                            end\r\n                        end\r\n                    end\r\n                end\r\n\r\n                if #trees == 0 then\r\n                    task.wait(1)\r\n                    continue\r\n                end\r\n\r\n                -- Reverse order so removing the last entry is constant time.\r\n                table.sort(trees, function(a, b)\r\n                    if a.ring ~= b.ring then return a.ring > b.ring end\r\n                    if a.isSmall ~= b.isSmall then return not a.isSmall end\r\n                    if a.angle ~= b.angle then return a.angle > b.angle end\r\n                    return a.radius > b.radius\r\n                end)\r\n\r\n                while #trees > 0 and _G.AutoChopSelectedTreesActive do\r\n\r\n                    if _G.KixAutoChopHold or _G.ForceStrongholdRaid or _G.CampfireCombatPaused\r\n                        or _G.KixHalloweenTrickBusy\r\n                        or _G.IsStrongholdRaidActive\r\n                        or _G.StrongholdTransition\r\n                        or _G.StrongholdPreparingRaid\r\n                        or _G.CampfireCombatActive\r\n                        or _G.CorruptedCombatActive\r\n                        or _G.MossyCombatActive\r\n                        or _G.TurkeyCombatActive\r\n                        or _G.BearCombatActive\r\n                        or _G.GlobalCultistCombatActive\r\n                        or _G.MammothCombatActive or _G.FrogCombatActive or _G.CustomHuntCombatActive\r\n                        or _G.AutoChestRunning or _G.KixRescueBusy then\r\n\r\n                        break\r\n                    end\r\n\r\n                    while _G.PauseAutoChopForBagging do\r\n                        task.wait(0.1)\r\n                    end\r\n\r\n                    local targetTree = table.remove(trees)\r\n                    if not targetTree or not targetTree.model or not targetTree.part\r\n                        or not targetTree.part.Parent\r\n                        or targetTree.model.Parent ~= targetTree.container then\r\n                        continue\r\n                    end\r\n\r\n                    local initialTreePos = targetTree.part.Position\r\n                    local lastProgressAt = os.clock()\r\n                    local lastTransparency = targetTree.part.Transparency\r\n\r\n                    pcall(function()\r\n                        if not _G.IsSpectating then\r\n                            workspace.CurrentCamera.CameraSubject =\r\n                                targetTree.part\r\n                        end\r\n                    end)\r\n\r\n                    _G.KixAutoChopTargetActive = true\r\n                    _G.KixAutoChopTargetAt = os.clock()\r\n                    while _G.AutoChopSelectedTreesActive\r\n                        and targetTree.model.Parent == targetTree.container do\r\n\r\n                        _G.KixAutoChopTargetAt = os.clock()\r\n\r\n                        if _G.KixAutoChopHold or _G.ForceStrongholdRaid or _G.CampfireCombatPaused\r\n                            or _G.KixHalloweenTrickBusy\r\n                            or _G.IsStrongholdRaidActive\r\n                            or _G.StrongholdTransition\r\n                            or _G.StrongholdPreparingRaid\r\n                            or _G.CampfireCombatActive\r\n                            or _G.CorruptedCombatActive\r\n                            or _G.MossyCombatActive\r\n                            or _G.TurkeyCombatActive\r\n                            or _G.BearCombatActive\r\n                            or _G.GlobalCultistCombatActive\r\n                            or _G.MammothCombatActive or _G.FrogCombatActive or _G.CustomHuntCombatActive\r\n                            or _G.AutoChestRunning or _G.KixRescueBusy then\r\n\r\n                            break\r\n                        end\r\n\r\n                        -- Pohon berpindah/jatuh\r\n                        if targetTree.part\r\n                            and (targetTree.part.Position - initialTreePos).Magnitude > 2 then\r\n                            skippedTrees[targetTree.model] = true\r\n                            break\r\n                        end\r\n\r\n                        -- Pohon menjadi transparan\r\n                        if targetTree.part\r\n                            and targetTree.part.Transparency > 0.8 then\r\n                            skippedTrees[targetTree.model] = true\r\n                            break\r\n                        end\r\n\r\n                        -- Jangan biarkan satu pohon tanpa progres menahan seluruh Auto Chop.\r\n                        local currentTransparency = targetTree.part and targetTree.part.Transparency\r\n                        if currentTransparency and currentTransparency > lastTransparency + 0.02 then\r\n                            lastTransparency = currentTransparency\r\n                            lastProgressAt = os.clock()\r\n                        elseif os.clock() - lastProgressAt >= 12 then\r\n                            skippedTrees[targetTree.model] = true\r\n                            break\r\n                        end\r\n\r\n                        hrp.CFrame = CFrame.new(\r\n                            initialTreePos.X,\r\n                            initialTreePos.Y - 25,\r\n                            initialTreePos.Z\r\n                        )\r\n\r\n                        task.wait(0.01)\r\n                    end\r\n                    _G.KixAutoChopTargetActive = false\r\n                end\r\n            end\r\n\r\n            -- =====================================================\r\n            -- CLEANUP\r\n            -- =====================================================\r\n\r\n            if noclipChop then\r\n                noclipChop:Disconnect()\r\n            end\r\n\r\n            -- Restore collision\r\n            pcall(function()\r\n                for part, coll in pairs(savedCollisions) do\r\n                    if part and part.Parent then\r\n                        part.CanCollide = coll\r\n                    end\r\n                end\r\n            end)\r\n            _G.KixAutoChopNoclipApplied = false\r\n            _G.KixAutoChopTargetActive = false\r\n            _G.KixAutoChopTargetAt = 0\r\n\r\n            -- Hapus BodyMovers\r\n            pcall(function()\r\n                if staticFly and staticFly.Parent then\r\n                    staticFly:Destroy()\r\n                end\r\n            end)\r\n\r\n            -- Restore camera\r\n            pcall(function()\r\n                if hum\r\n                    and not _G.IsStrongholdRaidActive\r\n                    and not _G.StrongholdTransition\r\n                    and not _G.StrongholdPreparingRaid\r\n                    and not _G.CampfireCombatActive\r\n                    and not _G.IsSpectating and not _G.CampfireCombatPaused\r\n                    and not _G.ForceStrongholdRaid then\r\n\r\n                    workspace.CurrentCamera.CameraSubject = hum\r\n                end\r\n            end)\r\n\r\n            -- Return position\r\n            pcall(function()\r\n                if hrp\r\n                    and not _G.IsStrongholdRaidActive\r\n                    and not _G.StrongholdTransition\r\n                    and not _G.StrongholdPreparingRaid\r\n                    and not _G.CampfireCombatActive and not _G.CorruptedCombatActive\r\n                    and not _G.MossyCombatActive and not _G.TurkeyCombatActive\r\n                    and not _G.BearCombatActive and not _G.GlobalCultistCombatActive\r\n                    and not _G.MammothCombatActive and not _G.FrogCombatActive\r\n                    and not _G.CustomHuntCombatActive and not _G.CampfireCombatPaused\r\n                    and not _G.KixHalloweenTrickBusy\r\n                    and not _G.ForceStrongholdRaid and not _G.AutoChestRunning\r\n                    and not _G.KixRescueBusy then\r\n\r\n                    -- See the stop handler above: use the shared saved value\r\n                    -- rather than the later-scoped Stronghold local.\r\n                    local returnPos = KixHubSavedState.customReturnPos or campfirePos\r\n\r\n                    if returnPos then\r\n                        hrp.CFrame = CFrame.new(\r\n                            returnPos.X,\r\n                            returnPos.Y + 3,\r\n                            returnPos.Z\r\n                        )\r\n                    end\r\n                end\r\n            end)\r\n\r\n            _G.AutoChopSelectedTreesRunning = false\r\n\r\n            -- =====================================================\r\n            -- FINAL FORCE CLEANUP CHOP AURA\r\n            -- =====================================================\r\n\r\n            _G.AllowBodyAura = false\r\n\r\n            -- RESTORE CHOP AURA STATE (Menyesuaikan dengan state sebelumnya)\r\n            pcall(function()\r\n                if not wasChopAuraEnabledBeforeAutoChop then\r\n                    if chopAuraEnabled and toggleChopAura then\r\n                        toggleChopAura(false)\r\n                    end\r\n                    chopAuraEnabled = false\r\n                end\r\n            end)\r\n        end)\r\nend\r\n_G.KixAdapters.AutoChopTrees = {IsEnabled = function() return _G.AutoChopSelectedTreesActive == true end}\r\n\r\n_G.AutoChopTreesToggle = Tabs.Auto:Toggle({\r\n    Title = '🪓 Auto Chop Trees 🌳',\r\n    Desc = 'Prioritizes Small Trees; uses Big Trees when no Small Tree is available.',\r\n    Value = false,\r\n    Callback = function(value)\r\n        local controller = _G.KixFullAuto\r\n        if controller then\r\n            if value == false then\r\n                if controller.ChopWindowActive and not controller.StoppingAutoChop then\r\n                    controller.ChopUserPaused = true\r\n                end\r\n                controller.Owned[\"AutoChopTrees\"] = nil\r\n                if controller.Suspended then controller.Suspended[\"AutoChopTrees\"] = nil end\r\n            else\r\n                controller.ChopUserPaused = false\r\n            end\r\n        end\r\n        local result = _G.KixEngines.AutoChopTrees(value)\r\n        if _G.KixSetAutoChopStatus then\r\n            _G.KixSetAutoChopStatus(value and \"Enabled\" or \"Disabled\")\r\n        end\r\n        return result\r\n    end\r\n})\r\nAutoScrapToggle = Tabs.Auto:Toggle({\r\n    Title = '♻️ Auto Scrap',\r\n    Desc = 'Automatically brings all eligible scrap and logs to the Scrapper.',\r\n    Value = autoScrap == true,\r\n    Callback = function(value)\r\n        local engine = _G.KixEngines and _G.KixEngines.AutoScrap\r\n        if type(engine) == 'function' then engine(value) end\r\n    end\r\n})\r\n_G.KixSetAutoChopStatus = function(text)\r\n    text = tostring(text or \"\")\r\n    if _G.KixAutoChopStatusText == text then return end\r\n    _G.KixAutoChopStatusText = text\r\n    local paragraph = _G.AutoChopStatusParagraph\r\n    if paragraph then pcall(function() paragraph:SetDesc(text) end) end\r\nend\r\n_G.AutoChopStatusParagraph = nil\r\n\r\n-- Shared campfire reading for tracker, refueling and HUD.\r\n-- Use the same visible fill first; fall back to real fuel attributes when UI has not loaded.\r\nlocal function getCampfirePercent()\r\n    local map = workspace:FindFirstChild(\"Map\")\r\n    local camp = map and map:FindFirstChild(\"Campground\")\r\n    local fire = camp and camp:FindFirstChild(\"MainFire\")\r\n    if not fire then return nil, nil end\r\n    local center = fire:FindFirstChild(\"Center\")\r\n    local billboard = center and center:FindFirstChild(\"BillboardGui\")\r\n    local frame = billboard and billboard:FindFirstChild(\"Frame\")\r\n    local background = frame and frame:FindFirstChild(\"Background\")\r\n    local fill = background and background:FindFirstChild(\"Fill\")\r\n    if fill and fill:IsA(\"GuiObject\") then\r\n        return math.clamp(math.floor(fill.Size.X.Scale * 100 + 0.5), 0, 100), fire\r\n    end\r\n    local remaining = fire:GetAttribute(\"FuelRemaining\")\r\n    local target = fire:GetAttribute(\"FuelTarget\")\r\n    if type(remaining) == \"number\" and type(target) == \"number\" and target > 0 then\r\n        return math.clamp(math.floor(remaining / target * 100 + 0.5), 0, 100), fire\r\n    end\r\n    return nil, fire\r\nend\r\n\r\n-- Shared farm crop discovery for Cook and Biofuel. Supports both\r\n-- legacy prompted crops and current draggable food models sitting on Farm Plots.\r\n-- A short shared cache avoids repeatedly traversing thousands of plot descendants.\r\nlocal KixSharedFarmHarvest = {\r\n    Candidates = {}, NextScan = 0, Active = false,\r\n    Plots = {}, PlotBounds = {}, PlotEntries = setmetatable({}, {__mode = \"k\"}),\r\n    ItemCandidates = {}, NextItemScan = 0,\r\n    NextDiscovery = 0, ScanCursor = 1, ScanBusy = false,\r\n    CropCooldowns = setmetatable({}, {__mode = \"k\"}),\r\n    Reserved = setmetatable({}, {__mode = \"k\"}),\r\n    LastWarning = 0,\r\n}\r\nlocal KixSharedFarmCropNames = {Carrot = true, Corn = true}\r\n\r\nfunction KixSharedFarmHarvest.Scan()\r\n    local now = os.clock()\r\n    local cache = KixSharedFarmHarvest\r\n\r\n    -- Discover plot roots infrequently; do not traverse every plot's descendants\r\n    -- together in one pass. A single plot is refreshed incrementally below.\r\n    if now >= cache.NextDiscovery then\r\n        cache.NextDiscovery = now + 5\r\n        local plots, live, bounds = {}, {}, {}\r\n        local structures = workspace:FindFirstChild(\"Structures\")\r\n        if structures then\r\n            for _, plot in ipairs(structures:GetChildren()) do\r\n                if plot.Name == \"Farm Plot\" then\r\n                    plots[#plots + 1] = plot\r\n                    live[plot] = true\r\n                    local ok, boxCFrame, boxSize = pcall(function()\r\n                        return plot:GetBoundingBox()\r\n                    end)\r\n                    if ok and boxCFrame and boxSize then\r\n                        bounds[#bounds + 1] = {Plot = plot, CFrame = boxCFrame, Size = boxSize}\r\n                    end\r\n                end\r\n            end\r\n        end\r\n        for plot in pairs(cache.PlotEntries) do\r\n            if not live[plot] then cache.PlotEntries[plot] = nil end\r\n        end\r\n        cache.Plots = plots\r\n        cache.PlotBounds = bounds\r\n        if cache.ScanCursor > #plots then cache.ScanCursor = 1 end\r\n    end\r\n\r\n    -- New farm plots expose ripe vegetables as FarmPlant Item models in Items,\r\n    -- rather than named crop models with ProximityPrompts under the plot root.\r\n    -- Index only direct Items children that sit inside a Farm Plot's bounds.\r\n    if now >= cache.NextItemScan then\r\n        cache.NextItemScan = now + 0.75\r\n        local itemsFolder, itemsSnapshot = _G.KixItemsIndex.Get()\r\n        local itemCandidates = {}\r\n        if itemsFolder then\r\n            for _, item in ipairs(itemsSnapshot) do\r\n                if item and item.Parent == itemsFolder and KixSharedFarmCropNames[item.Name]\r\n                    and item:GetAttribute(\"FarmPlant\") == true\r\n                    and item:GetAttribute(\"Interaction\") == \"Item\" then\r\n                    local ok, position = pcall(function() return item:GetPivot().Position end)\r\n                    if ok and position then\r\n                        for _, bounds in ipairs(cache.PlotBounds) do\r\n                            if bounds.Plot.Parent then\r\n                                local localPosition = bounds.CFrame:PointToObjectSpace(position)\r\n                                if math.abs(localPosition.X) <= bounds.Size.X * 0.5 + 2\r\n                                    and math.abs(localPosition.Z) <= bounds.Size.Z * 0.5 + 2\r\n                                    and math.abs(localPosition.Y) <= bounds.Size.Y * 0.5 + 5 then\r\n                                    itemCandidates[#itemCandidates + 1] = {\r\n                                        Plot = bounds.Plot, Crop = item, Prompt = nil, ItemBacked = true,\r\n                                    }\r\n                                    break\r\n                                end\r\n                            end\r\n                        end\r\n                    end\r\n                end\r\n            end\r\n        end\r\n        cache.ItemCandidates = itemCandidates\r\n    end\r\n\r\n    if not cache.ScanBusy and now >= cache.NextScan and #cache.Plots > 0 then\r\n        cache.NextScan = now + 0.25\r\n        local plot = cache.Plots[cache.ScanCursor]\r\n        cache.ScanCursor = cache.ScanCursor % #cache.Plots + 1\r\n        if plot and plot.Parent then\r\n            cache.ScanBusy = true\r\n            local ok, entries = pcall(function()\r\n                -- Yield every 200 nodes so one large farm cannot monopolize a frame.\r\n                local pending = plot:GetChildren()\r\n                local cursor, found = 1, {}\r\n                while cursor <= #pending do\r\n                    local object = pending[cursor]\r\n                    if object:IsA(\"Model\") and KixSharedFarmCropNames[object.Name] then\r\n                        local prompt = object:FindFirstChildWhichIsA(\"ProximityPrompt\", true)\r\n                        if prompt then found[#found + 1] = {Plot = plot, Crop = object, Prompt = prompt} end\r\n                    end\r\n                    for _, child in ipairs(object:GetChildren()) do\r\n                        pending[#pending + 1] = child\r\n                    end\r\n                    cursor = cursor + 1\r\n                    if cursor % 200 == 0 then task.wait() end\r\n                end\r\n                return found\r\n            end)\r\n            cache.ScanBusy = false\r\n            if ok and plot.Parent then\r\n                cache.PlotEntries[plot] = entries\r\n            elseif not ok and now - cache.LastWarning > 10 then\r\n                cache.LastWarning = now\r\n                warn(\"[FarmHarvest] Plot index refresh failed: \" .. tostring(entries))\r\n            end\r\n        end\r\n    end\r\n\r\n    local candidates = {}\r\n    for plot, entries in pairs(cache.PlotEntries) do\r\n        if plot.Parent then\r\n            for _, entry in ipairs(entries) do\r\n                if entry.Crop.Parent and entry.Prompt.Parent then\r\n                    candidates[#candidates + 1] = entry\r\n                end\r\n            end\r\n        end\r\n    end\r\n    for _, entry in ipairs(cache.ItemCandidates) do\r\n        if entry.Plot.Parent and entry.Crop.Parent then\r\n            candidates[#candidates + 1] = entry\r\n        end\r\n    end\r\n    cache.Candidates = candidates\r\n    return candidates\r\nend\r\n\r\nfunction KixSharedFarmHarvest.GetBest(refPos, nameAllowed, preferredName)\r\n    local now = os.clock()\r\n    local best, bestDist, bestPriority = nil, math.huge, math.huge\r\n    for _, entry in ipairs(KixSharedFarmHarvest.Scan()) do\r\n        local crop, prompt = entry.Crop, entry.Prompt\r\n        local validTarget = (entry.ItemBacked\r\n            and crop.Parent == (workspace:FindFirstChild(\"Items\") or workspace:FindFirstChild(\"items\"))\r\n            and crop:GetAttribute(\"FarmPlant\") == true\r\n            and crop:GetAttribute(\"Interaction\") == \"Item\")\r\n            or (prompt and prompt.Parent and prompt.Enabled)\r\n        if entry.Plot.Parent and crop.Parent and validTarget\r\n            and now >= (KixSharedFarmHarvest.CropCooldowns[crop] or 0)\r\n            and (not prompt or now >= (_G.KixFarmCache.Claims[prompt] or 0))\r\n            and (not nameAllowed or nameAllowed(crop.Name)) then\r\n            local pos = crop:GetPivot().Position\r\n            local dist = refPos and (pos - refPos).Magnitude or 0\r\n            local priority = (preferredName and crop.Name == preferredName) and 0 or 1\r\n            -- Honour the station's preferred crop, then choose the nearest match.\r\n            if priority < bestPriority or (priority == bestPriority and dist < bestDist) then\r\n                best, bestDist, bestPriority = entry, dist, priority\r\n            end\r\n        end\r\n    end\r\n    return best\r\nend\r\n\r\n-- Returns a confirmed loose farm crop, or a newly detached crop from legacy plots.\r\nfunction KixSharedFarmHarvest.Harvest(refPos, stillActive, nameAllowed, owner, preferredName)\r\n    if KixSharedFarmHarvest.Active or not KixHubSession.Alive or _G.IsEating then return nil end\r\n    local entry = KixSharedFarmHarvest.GetBest(refPos, nameAllowed, preferredName)\r\n    if not entry then return nil end\r\n    local itemsFolder = workspace:FindFirstChild(\"Items\") or workspace:FindFirstChild(\"items\")\r\n    if not itemsFolder then return nil end\r\n    local crop, prompt = entry.Crop, entry.Prompt\r\n    if entry.ItemBacked then\r\n        if crop.Parent ~= itemsFolder or (stillActive and not stillActive()) then return nil end\r\n        KixSharedFarmHarvest.CropCooldowns[crop] = os.clock() + 4\r\n        if owner then\r\n            KixSharedFarmHarvest.Reserved[crop] = {Owner = owner, Until = os.clock() + 4}\r\n        end\r\n        _G.KixPerfDebug.Count(\"FarmHarvestConfirmed\")\r\n        return crop\r\n    end\r\n    KixSharedFarmHarvest.Active = true\r\n    KixSharedFarmHarvest.CropCooldowns[crop] = os.clock() + 4\r\n    _G.KixFarmCache.Claims[prompt] = os.clock() + 4\r\n    local ok, itemOrError = pcall(function()\r\n        local previous = {}\r\n        for _, item in ipairs(itemsFolder:GetChildren()) do previous[item] = true end\r\n        if not prompt.Parent or not prompt.Enabled then return nil end\r\n        if stillActive and not stillActive() then return nil end\r\n        if fireproximityprompt then\r\n            fireproximityprompt(prompt, 1)\r\n        else\r\n            prompt:InputHoldBegin()\r\n            task.wait((prompt.HoldDuration or 0) + 0.1)\r\n            prompt:InputHoldEnd()\r\n        end\r\n        -- Verify actual harvest, rather than assuming an invoked prompt succeeded.\r\n        for _ = 1, 15 do\r\n            if not KixHubSession.Alive or (stillActive and not stillActive()) then return nil end\r\n            task.wait(0.2)\r\n            for _, item in ipairs(itemsFolder:GetChildren()) do\r\n                if not previous[item] and item.Parent == itemsFolder\r\n                    and item.Name == crop.Name then\r\n                    return item\r\n                end\r\n            end\r\n        end\r\n        return nil\r\n    end)\r\n    KixSharedFarmHarvest.Active = false\r\n    if ok and itemOrError then\r\n        if owner then\r\n            KixSharedFarmHarvest.Reserved[itemOrError] = {Owner = owner, Until = os.clock() + 4}\r\n        end\r\n        _G.KixPerfDebug.Count(\"FarmHarvestConfirmed\")\r\n        KixSharedFarmHarvest.NextScan = 0\r\n        return itemOrError\r\n    end\r\n    _G.KixPerfDebug.Count(\"FarmHarvestUnconfirmed\")\r\n    if not ok and os.clock() - KixSharedFarmHarvest.LastWarning > 10 then\r\n        KixSharedFarmHarvest.LastWarning = os.clock()\r\n        warn(\"[FarmHarvest] \" .. tostring(itemOrError))\r\n    end\r\n    return nil\r\nend\r\n\r\n-- Only claimed ingredients are protected from concurrent cooker usage.\r\n-- A critical fire has priority for vegetables; otherwise cook and biofuel share harvests.\r\nlocal KixBiofuelClaims = setmetatable({}, {__mode = \"k\"})\r\n\r\n-- ==========================================\r\n-- AUTO SCRAP DELIVERY\r\n-- ==========================================\r\n\r\n-- Cached Auto Scrap delivery engine kept in a local scope to limit chunk registers.\r\ndo\r\n    local names = {\"Log\", \"Chair\", \"Bolt\", \"Sheet Metal\", \"UFO Junk\", \"UFO Component\", \"Broken Fan\", \"Old Radio\", \"Gears\", \"Broken Microwave\", \"Tyre\", \"Metal Chair\", \"Old Car Engine\", \"Washing Machine\", \"Cultist Experiment\", \"Cultist Prototype\", \"UFO Scrap\", \"Cultist Gem\", \"Gem of the Forest Fragment\", \"Gem of the Forest\"}\r\n    local known = {}\r\n    for _, name in ipairs(names) do known[name] = true end\r\n    local priorities = {\"Cultist Gem\", \"Gem of the Forest\", \"Gem of the Forest Fragment\", \"Log\"}\r\n    local bulk = {Log = true, Bolt = true, [\"Sheet Metal\"] = true}\r\n    local selected = KixHubSavedState.AutoScrapItems\r\n    if type(selected) ~= \"table\" or #selected == 0 then\r\n        selected = {\"All\"}\r\n    end\r\n    KixHubSavedState.AutoScrapItems = table.clone(selected)\r\n    local byName, itemNames = {}, setmetatable({}, {__mode = \"k\"})\r\n    local itemLinks, cacheLinks = setmetatable({}, {__mode = \"k\"}), {}\r\n    local folder, generation, status, scrapperPivot = nil, 0, nil, nil\r\n    local dropped, failed, skip, moving = setmetatable({}, {__mode = \"k\"}), setmetatable({}, {__mode = \"k\"}), setmetatable({}, {__mode = \"k\"}), setmetatable({}, {__mode = \"k\"})\r\n    local stuckRetryAt = setmetatable({}, {__mode = \"k\"})\r\n    local airSince, stuckCache, nextStuckScan = setmetatable({}, {__mode = \"k\"}), {}, 0\r\n    local SCAN, DROP_HEIGHT = 0.5, 17.5\r\n    local RETRY_COOLDOWN, STUCK_RETRY = 10, 1\r\n    local gemDelayStartedAt\r\n    local function shouldDelayCultistGem(now)\r\n        local structures = workspace:FindFirstChild(\"Structures\")\r\n        local craftingTable = _ReplicatedStorage:FindFirstChild(\"Crafting Table\")\r\n        local bench5 = craftingTable and craftingTable:FindFirstChild(\"Crafting Bench 5\")\r\n        local tier = craftingTable and tonumber(craftingTable:GetAttribute(\"CraftingTableTier\")) or 0\r\n        if structures and structures:FindFirstChild(\"Giant Bed\")\r\n            and tier >= 5 and bench5 and bench5:GetAttribute(\"SoldOut\") == true then\r\n            gemDelayStartedAt = gemDelayStartedAt or now\r\n        end\r\n        if not gemDelayStartedAt then return false, 0 end\r\n        local remaining = 300 - (now - gemDelayStartedAt)\r\n        return remaining > 0, math.max(0, remaining)\r\n    end\r\n\r\n    local function disconnect(list)\r\n        for _, link in ipairs(list) do pcall(function() link:Disconnect() end) end\r\n        table.clear(list)\r\n    end\r\n    local function unindex(item)\r\n        local old = itemNames[item]\r\n        if old and byName[old] then\r\n            byName[old][item] = nil\r\n            if next(byName[old]) == nil then byName[old] = nil end\r\n        end\r\n        itemNames[item] = nil\r\n        local links = itemLinks[item]\r\n        if links then disconnect(links); itemLinks[item] = nil end\r\n    end\r\n    local function index(item)\r\n        if not item or item.Parent ~= folder then return end\r\n        local name, old = item.Name, itemNames[item]\r\n        if name == old then return end\r\n        if old and byName[old] then\r\n            byName[old][item] = nil\r\n            if next(byName[old]) == nil then byName[old] = nil end\r\n        end\r\n        itemNames[item] = name\r\n        byName[name] = byName[name] or setmetatable({}, {__mode = \"k\"})\r\n        byName[name][item] = true\r\n        if not itemLinks[item] then itemLinks[item] = {item:GetPropertyChangedSignal(\"Name\"):Connect(function() index(item) end)} end\r\n    end\r\n    local function setFolder(value, active)\r\n        if folder == value then return end\r\n        disconnect(cacheLinks)\r\n        for item in pairs(itemLinks) do unindex(item) end\r\n        table.clear(byName)\r\n        folder = value\r\n        if not folder then return end\r\n        cacheLinks[#cacheLinks + 1] = folder.ChildAdded:Connect(function(item) if active() then index(item) end end)\r\n        cacheLinks[#cacheLinks + 1] = folder.ChildRemoved:Connect(unindex)\r\n        local work = 0\r\n        for _, item in ipairs(folder:GetChildren()) do\r\n            if not active() then return end\r\n            index(item)\r\n            work += 1\r\n            if work % 40 == 0 then task.wait() end\r\n        end\r\n    end\r\n    local function getNamed(name)\r\n        local out = {}\r\n        for item in pairs(byName[name] or {}) do\r\n            if item.Parent == folder and item.Name == name then out[#out + 1] = item end\r\n        end\r\n        return out\r\n    end\r\n    local function getScrapper()\r\n        local map = workspace:FindFirstChild(\"Map\")\r\n        local campground = map and map:FindFirstChild(\"Campground\")\r\n        local scrapper = campground and campground:FindFirstChild(\"Scrapper\")\r\n        if scrapper and (scrapper:IsA(\"Model\") or scrapper:IsA(\"BasePart\")) then\r\n            local ok, pivot = pcall(function() return scrapper:GetPivot() end)\r\n            if ok then scrapperPivot = pivot; return scrapper, pivot end\r\n        end\r\n        return nil, scrapperPivot\r\n    end\r\n    local function canTeleport(item)\r\n        if not item or not item:IsA(\"Model\") or not item.PrimaryPart or item:GetAttribute(\"Interaction\") == nil\r\n            or item:GetAttribute(\"Locked\") == true or item:GetAttribute(\"IceBlock\") == true then return false end\r\n        local function frozen(part) return part.Anchored and not part.CanCollide and not part.CanQuery and not part.CanTouch end\r\n        if frozen(item.PrimaryPart) then\r\n            for _, part in ipairs(item:GetDescendants()) do if part:IsA(\"BasePart\") and not frozen(part) then return true end end\r\n            return false\r\n        end\r\n        return true\r\n    end\r\n    local function eligible(item, name, teleportCheck)\r\n        if not item or item.Parent ~= folder or item.Name ~= name then return false end\r\n        if teleportCheck and not canTeleport(item) then return false end\r\n        local owner = item:GetAttribute(\"Owner\")\r\n        if owner ~= nil and owner ~= _LocalPlayer.UserId then return false end\r\n        local recipe = item:GetAttribute(\"UpgradesRecipe\") ~= nil\r\n        local gem = name == \"Cultist Gem\" or name == \"Gem of the Forest Fragment\" or name == \"Gem of the Forest\"\r\n        local tagged = false\r\n        for _, tag in ipairs({\"CanBeGrinded\", \"Gem\", \"GreenGem\"}) do\r\n            local ok, value = pcall(function() return item:HasTag(tag) end)\r\n            if ok and value then tagged = true; break end\r\n        end\r\n        -- Named Auto Scrap targets are authoritative: some game item variants\r\n        -- omit the Scrappable attribute/tag even though the Scrapper accepts them.\r\n        if not (known[name] or recipe or item:GetAttribute(\"Scrappable\") or tagged) then return false end\r\n        return not item:GetAttribute(\"Scrapped\") and item:GetAttribute(\"Locked\") ~= true\r\n            and item:GetAttribute(\"IceBlock\") ~= true and not item:FindFirstChild(\"IceBlock\")\r\n    end\r\n    local function selectedName(name) return table.find(selected, \"All\") ~= nil or table.find(selected, name) ~= nil end\r\n    local function dueAt(value, now)\r\n        return type(value) ~= \"number\" or value <= now\r\n    end\r\n    local function namesToScan()\r\n        local out, seen = {}, {}\r\n        for _, name in ipairs(priorities) do if selectedName(name) then out[#out + 1] = name; seen[name] = true end end\r\n        if table.find(selected, \"All\") then\r\n            for _, name in ipairs(names) do if not seen[name] then out[#out + 1] = name; seen[name] = true end end\r\n            local recipes = {}\r\n            for name, set in pairs(byName) do\r\n                if not seen[name] then\r\n                    for item in pairs(set) do\r\n                        if item.Parent == folder and item:IsA(\"Model\") and item:GetAttribute(\"UpgradesRecipe\") ~= nil then recipes[#recipes + 1] = name; seen[name] = true; break end\r\n                    end\r\n                end\r\n            end\r\n            table.sort(recipes)\r\n            for _, name in ipairs(recipes) do out[#out + 1] = name end\r\n        else\r\n            for _, name in ipairs(selected) do if name ~= \"All\" and not seen[name] then out[#out + 1] = name; seen[name] = true end end\r\n        end\r\n        return out\r\n    end\r\n    local function digesting(item)\r\n        local primary = item and item.PrimaryPart\r\n        local function frozen(part) return part.Anchored and not part.CanCollide and not part.CanQuery and not part.CanTouch end\r\n        if not primary or not frozen(primary) then return false end\r\n        for _, part in ipairs(item:GetDescendants()) do if part:IsA(\"BasePart\") and not frozen(part) then return false end end\r\n        return true\r\n    end\r\n    local function horiz(a, b) return Vector3.new(a.X - b.X, 0, a.Z - b.Z).Magnitude end\r\n    local function bottom(item)\r\n        local ok, box, size = pcall(function() return item:GetBoundingBox() end)\r\n        return ok and box and size and box.Position.Y - size.Y / 2 or nil\r\n    end\r\n    local function floating(item, pos)\r\n        local ok, pivot = pcall(function() return item:GetPivot() end)\r\n        if not ok or horiz(pivot.Position, pos) > 30 then return false end\r\n        local low = bottom(item)\r\n        if horiz(pivot.Position, pos) <= 4 and low and low - pos.Y > 6 and not digesting(item) then return true end\r\n        if not (item.PrimaryPart.Anchored or item:GetAttribute(\"Slept\") == true) or digesting(item) or not low then return false end\r\n        local params = RaycastParams.new()\r\n        params.FilterType = Enum.RaycastFilterType.Exclude\r\n        params.FilterDescendantsInstances = {item, _LocalPlayer.Character}\r\n        params.RespectCanCollide = true\r\n        local hit = workspace:Raycast(Vector3.new(pivot.Position.X, low + 0.1, pivot.Position.Z), Vector3.new(0, -60, 0), params)\r\n        return low - (hit and hit.Position.Y or pos.Y + 2) > 3\r\n    end\r\n    local function scanStuck(scanNames, active, pos)\r\n        local now, out, seen, work = os.clock(), {}, setmetatable({}, {__mode = \"k\"}), 0\r\n        for _, name in ipairs(scanNames) do\r\n            for _, item in ipairs(getNamed(name)) do\r\n                work += 1\r\n                if not active() then return nil end\r\n                local owner = item:GetAttribute(\"Owner\")\r\n                if (owner == nil or owner == _LocalPlayer.UserId) and eligible(item, name, false) then\r\n                    local reason, since\r\n                    if floating(item, pos) then\r\n                        airSince[item] = airSince[item] or now\r\n                        if now - airSince[item] >= 2 then reason, since = \"air\", airSince[item] end\r\n                    else airSince[item] = nil end\r\n                    local delivered = dropped[item]\r\n                    if delivered and now - delivered >= 15 then\r\n                        local ok, pivot = pcall(function() return item:GetPivot() end)\r\n                        if ok and horiz(pivot.Position, pos) <= 30 and not digesting(item) then\r\n                            reason, since = reason or \"unscrapped\", since and math.min(since, delivered) or delivered\r\n                        end\r\n                    end\r\n                    if reason and not seen[item] then seen[item] = true; out[#out + 1] = {item = item, since = since or now} end\r\n                end\r\n                if work % 40 == 0 then task.wait() end\r\n            end\r\n        end\r\n        table.sort(out, function(a, b) return a.since < b.since end)\r\n        return out\r\n    end\r\n    local function teleport(item, destination, active)\r\n        if not canTeleport(item) or not active() then return false end\r\n        local remotes = _ReplicatedStorage:FindFirstChild(\"RemoteEvents\")\r\n        local start = remotes and remotes:FindFirstChild(\"RequestStartDraggingItem\")\r\n        local stop = remotes and remotes:FindFirstChild(\"StopDraggingItem\")\r\n        if not start or not stop or not start:IsA(\"RemoteEvent\") or not stop:IsA(\"RemoteEvent\") then return false end\r\n        local parent, primary = item.Parent, item.PrimaryPart\r\n        local function valid() return active() and item.Parent == parent and item.PrimaryPart == primary and primary:IsDescendantOf(item) and item:GetAttribute(\"Locked\") ~= true and item:GetAttribute(\"IceBlock\") ~= true end\r\n        moving[item] = true\r\n        local started = pcall(function() start:FireServer(item) end)\r\n        local ok, moved = pcall(function()\r\n            if not started then return false end\r\n            local function owns()\r\n                if primary.Anchored or item:GetAttribute(\"Owner\") ~= _LocalPlayer.UserId then return false end\r\n                local roots = {}\r\n                for _, part in ipairs(item:GetDescendants()) do\r\n                    if part:IsA(\"BasePart\") then\r\n                        local root = part.AssemblyRootPart\r\n                        if not root or root.Anchored or not root:IsDescendantOf(item) then return false end\r\n                        if not roots[root] then\r\n                            roots[root] = true\r\n                            for _, linked in ipairs(part:GetConnectedParts(true)) do if not linked:IsDescendantOf(item) then return false end end\r\n                        end\r\n                    end\r\n                end\r\n                if type(getnetworkowner) == \"function\" then\r\n                    for root in pairs(roots) do local ownerOk, localOwner = pcall(getnetworkowner, root); if not ownerOk or localOwner ~= true then return false end end\r\n                end\r\n                return true\r\n            end\r\n            local deadline = os.clock() + 2\r\n            while valid() and not owns() and os.clock() < deadline do task.wait(0.05) end\r\n            if not valid() or not owns() then return false end\r\n            local target = typeof(destination) == \"Vector3\" and CFrame.new(destination) or destination\r\n            item:PivotTo(target)\r\n            task.wait(0.15)\r\n            local startedAt = os.clock()\r\n            while valid() and owns() and os.clock() - startedAt < 2 do\r\n                if item:GetAttribute(\"Scrapped\") then break end\r\n                if os.clock() - startedAt >= 0.25 and target.Position.Y - item:GetPivot().Position.Y < 1 then\r\n                    local low = bottom(item)\r\n                    if low then\r\n                        local params = RaycastParams.new()\r\n                        params.FilterType = Enum.RaycastFilterType.Exclude\r\n                        params.FilterDescendantsInstances = {item, _LocalPlayer.Character}\r\n                        params.RespectCanCollide = true\r\n                        local pivot = item:GetPivot()\r\n                        local hit = workspace:Raycast(Vector3.new(pivot.Position.X, low + 0.1, pivot.Position.Z), Vector3.new(0, -60, 0), params)\r\n                        if hit and low - hit.Position.Y > 0.25 then item:PivotTo(item:GetPivot() - Vector3.new(0, low - hit.Position.Y - 0.25, 0)) end\r\n                        break\r\n                    end\r\n                end\r\n                if primary.AssemblyLinearVelocity.Magnitude <= 1 then break end\r\n                task.wait(0.05)\r\n            end\r\n            return valid() and owns()\r\n        end)\r\n        if started then pcall(function() stop:FireServer(item) end) end\r\n        moving[item] = nil\r\n        return ok and moved == true\r\n    end\r\n    -- KixDev has no Auto Campfire fuel selector that shares Log targets with\r\n    -- Auto Scrap, so the shared-fuel guard is not active here.\r\n    local function mayTakeLog() return true end\r\n    local function setStatus(text)\r\n        _G.KixAutoScrapStatus = text\r\n        if status then pcall(function() status:SetDesc(text) end) end\r\n    end\r\n    local function setEnabled(value)\r\n        generation += 1\r\n        local runId = generation\r\n        autoScrap = value == true\r\n        KixHubSavedState.AutoScrap = autoScrap\r\n        if not autoScrap then\r\n            setStatus(\"Off\")\r\n            disconnect(cacheLinks)\r\n            for item in pairs(itemLinks) do unindex(item) end\r\n            table.clear(byName)\r\n            folder = nil\r\n            return\r\n        end\r\n        setStatus(\"Starting\")\r\n        local function active() return KixHubSession.Alive and autoScrap and generation == runId end\r\n        task.spawn(function()\r\n            local nextScan, nextSend = 0, 0\r\n            local lastErrorWarn = 0\r\n            while active() do\r\n                local passOk, passError = pcall(function()\r\n                local items = workspace:FindFirstChild(\"Items\")\r\n                setFolder(items, active)\r\n                local _, pivot = getScrapper()\r\n                if not items or not pivot then setStatus(\"Waiting for Items or Scrapper to load\"); task.wait(0.25); return end\r\n                local scanNames, now = namesToScan(), os.clock()\r\n                local delayCultistGem, gemDelayRemaining = shouldDelayCultistGem(now)\r\n                if now >= nextScan then nextScan = now + SCAN; stuckCache = scanStuck(scanNames, active, pivot.Position) or {} end\r\n                local groups, candidates, seen, stuckSet, work = {}, {}, setmetatable({}, {__mode = \"k\"}), setmetatable({}, {__mode = \"k\"}), 0\r\n                for _, stuck in ipairs(stuckCache) do stuckSet[stuck.item] = stuck end\r\n                for _, name in ipairs(scanNames) do\r\n                    if name ~= \"Log\" or mayTakeLog() then\r\n                        for _, item in ipairs(getNamed(name)) do\r\n                            work += 1\r\n                            local failedAt = tonumber(failed[item])\r\n                            local retry = failedAt ~= nil and (now >= failedAt + RETRY_COOLDOWN or (now >= failedAt + STUCK_RETRY and (function()\r\n                                for _, stuck in ipairs(stuckCache) do if stuck.item == item then return true end end\r\n                                return false\r\n                            end)()))\r\n                            local stuckItem = stuckSet[item]\r\n                            local cooldownDone = dueAt(skip[item], now) or (stuckItem ~= nil and dueAt(stuckRetryAt[item], now))\r\n                            if eligible(item, name, true)\r\n                                and not (name == \"Cultist Gem\" and delayCultistGem)\r\n                                and not moving[item] and cooldownDone and not seen[item] then\r\n                                seen[item] = true\r\n                                if stuckItem then candidates[#candidates + 1] = {item = item, time = stuckItem.since}\r\n                                elseif retry then candidates[#candidates + 1] = {item = item, time = failedAt}\r\n                                elseif not tonumber(dropped[item]) or now >= tonumber(dropped[item]) + RETRY_COOLDOWN then\r\n                                    groups[name] = groups[name] or {}\r\n                                    groups[name][#groups[name] + 1] = item\r\n                                end\r\n                            end\r\n                            if work % 40 == 0 then task.wait() end\r\n                        end\r\n                    end\r\n                end\r\n                for _, stuck in ipairs(stuckCache) do\r\n                    local item = stuck.item\r\n                    if not seen[item] and selectedName(item.Name)\r\n                        and not (item.Name == \"Cultist Gem\" and delayCultistGem)\r\n                        and eligible(item, item.Name, true)\r\n                        and not moving[item] and dueAt(stuckRetryAt[item], now) then\r\n                        candidates[#candidates + 1] = {item = item, time = stuck.since}\r\n                        seen[item] = true\r\n                    end\r\n                end\r\n                table.sort(candidates, function(a, b) return (tonumber(a.time) or 0) < (tonumber(b.time) or 0) end)\r\n                local batches = {}\r\n                for _, name in ipairs(scanNames) do\r\n                    local list = groups[name]\r\n                    if list then\r\n                        if bulk[name] then\r\n                            for first = 1, #list, 20 do local batch = {}; for i = first, math.min(first + 19, #list) do batch[#batch + 1] = list[i] end; batches[#batches + 1] = batch end\r\n                        else for _, item in ipairs(list) do batches[#batches + 1] = {item} end end\r\n                    end\r\n                end\r\n                for _, candidate in ipairs(candidates) do\r\n                    local item, duplicate = candidate.item, false\r\n                    if bulk[candidate.item.Name] then\r\n                        for _, batch in ipairs(batches) do if batch[1] and batch[1].Name == item.Name and #batch < 20 then batch[#batch + 1] = item; duplicate = true; break end end\r\n                    end\r\n                    if not duplicate then batches[#batches + 1] = {item} end\r\n                end\r\n                local sent, maxGroups, deadline = 0, math.ceil(1 / 0.12) + 1, os.clock() + 1\r\n                if #batches > 0 then setStatus(\"Delivering selected scraps\") end\r\n                for _, batch in ipairs(batches) do\r\n                    if sent >= maxGroups or os.clock() >= deadline or not active() then break end\r\n                    if os.clock() < nextSend then task.wait(nextSend - os.clock()) end\r\n                    if not active() then break end\r\n                    nextSend, sent = os.clock() + 0.12, sent + 1\r\n                    for _, item in ipairs(batch) do\r\n                        local targetItem = item\r\n                        moving[targetItem] = true\r\n                        task.spawn(function()\r\n                            local deliveryOk, deliveryError = pcall(function()\r\n                                local name = targetItem.Name\r\n                                if active() and selectedName(name) and eligible(targetItem, name, true) and (name ~= \"Log\" or mayTakeLog()) then\r\n                                    if stuckSet[targetItem] then stuckRetryAt[targetItem] = os.clock() + 1 else skip[targetItem] = os.clock() + 10 end\r\n                                    local movedOk = teleport(targetItem, pivot * CFrame.new(0, DROP_HEIGHT, 0), function()\r\n                                        return active() and targetItem.Parent == items and selectedName(targetItem.Name) and (targetItem.Name ~= \"Log\" or mayTakeLog())\r\n                                    end)\r\n                                    if movedOk then dropped[targetItem] = os.clock(); failed[targetItem] = nil else failed[targetItem] = os.clock() end\r\n                                end\r\n                            end)\r\n                            if not deliveryOk then\r\n                                failed[targetItem] = os.clock()\r\n                                if os.clock() - lastErrorWarn >= 10 then\r\n                                    lastErrorWarn = os.clock()\r\n                                    warn(\"[Auto Scrap] Delivery retry: \" .. tostring(deliveryError))\r\n                                end\r\n                                setStatus(\"Delivery error; retrying eligible items\")\r\n                            end\r\n                            moving[targetItem] = nil\r\n                        end)\r\n                    end\r\n                end\r\n                if #batches == 0 then\r\n                    local waitStatus = delayCultistGem\r\n                        and string.format(\"Cultist Gem delayed after Giant Bed and Bench 5 (%d:%02d remaining)\", math.floor(gemDelayRemaining / 60), math.floor(gemDelayRemaining % 60))\r\n                        or (#stuckCache > 0 and (\"Waiting for stuck scrap retry (\" .. #stuckCache .. \")\") or \"Waiting...\")\r\n                    setStatus(waitStatus)\r\n                    task.wait(0.25)\r\n                else task.wait(0.05) end\r\n                end)\r\n                if not passOk then\r\n                    setStatus(\"Scan error; Auto Scrap recovering\")\r\n                    if os.clock() - lastErrorWarn >= 10 then\r\n                        lastErrorWarn = os.clock()\r\n                        warn(\"[Auto Scrap] Scan retry: \" .. tostring(passError))\r\n                    end\r\n                    task.wait(0.5)\r\n                end\r\n            end\r\n            if generation == runId then setStatus(\"Off\") end\r\n        end)\r\n    end\r\n    _G.KixAutoScrapSet = setEnabled\r\n    _G.KixEngines.AutoScrap = setEnabled\r\n    _G.KixAdapters = _G.KixAdapters or {}\r\n    _G.KixAdapters.AutoScrap = {IsEnabled = function() return autoScrap == true end}\r\n    _G.KixAutoScrapTargets = selected\r\n    CreateMultiDropdown(Tabs.Auto, {\r\n        Title = \"Scraps\",\r\n        Desc = \"Choose which items Auto Scrap should move.\",\r\n        Values = {\"All\", \"Log\", \"Chair\", \"Bolt\", \"Sheet Metal\", \"UFO Junk\", \"UFO Component\", \"Broken Fan\", \"Old Radio\", \"Gears\", \"Broken Microwave\", \"Tyre\", \"Metal Chair\", \"Old Car Engine\", \"Washing Machine\", \"Cultist Experiment\", \"Cultist Prototype\", \"UFO Scrap\", \"Cultist Gem\", \"Gem of the Forest Fragment\", \"Gem of the Forest\"},\r\n        Value = selected,\r\n        Multi = true,\r\n        Callback = function(value)\r\n            selected = type(value) == \"table\" and value or {}\r\n            if #selected == 0 then selected = {\"All\"} end\r\n            _G.KixAutoScrapTargets = selected\r\n            KixHubSavedState.AutoScrapItems = table.clone(selected)\r\n        end\r\n    })\r\n    if autoScrap then task.defer(function() setEnabled(true) end) end\r\nend\r\n\r\n\r\n-- ==========================================\r\n-- BIOFUEL SYSTEM & BACKGROUND TRACKER\r\n-- ==========================================\r\nTabs.Auto:Section({Title = 'Biofuel System', Icon = 'flame'})\r\n\r\nbiofuelSmartDesc = Tabs.Auto:Paragraph({\r\n    Title = \"Smart Biofuel Status\",\r\n    Desc = \"Fire : 0% | Status: System Disabled\"\r\n})\r\n\r\ndo (function()\r\n    local supported = {\r\n        \"Apple\", \"Pumpkin\", \"Strawberry\", \"Carrot\", \"Corn\", \"Morsel\", \"Steak\", \"Cooked Morsel\",\r\n        \"Cooked Steak\", \"Cooked Ribs\", \"Cooked Salmon\", \"Berry\", \"Cake\"\r\n    }\r\n    local values = {\r\n        \"Apple\", \"Strawberry\", \"Pumpkin\", \"Carrot\", \"Corn\", \"Morsel\", \"Steak\", \"Cake\",\r\n        \"Cooked Morsel\", \"Cooked Steak\", \"Cooked Ribs\", \"Cooked Salmon\", \"Berry\",\r\n        \"Swordfish\", \"Salmon\", \"Mackerel\", \"Chili\", \"Ribs\"\r\n    }\r\n    local defaults, selected = {}, {}\r\n    for _, name in ipairs(supported) do\r\n        defaults[#defaults + 1] = name\r\n        selected[name] = true\r\n    end\r\n    _G.KixBiofuelSelectedIngredients = selected\r\n\r\n    CreateMultiDropdown(Tabs.Auto, {\r\n        Title = \"Biofuel Ingredients\",\r\n        Desc = \"Choose which foods Auto Biofuel may process.\",\r\n        Values = values,\r\n        Value = defaults,\r\n        Multi = true,\r\n        Callback = function(value)\r\n            local nextSelection = {}\r\n            if type(value) == \"table\" then\r\n                for _, name in ipairs(value) do nextSelection[name] = true end\r\n            end\r\n            _G.KixBiofuelSelectedIngredients = nextSelection\r\n        end\r\n    })\r\nend)() end\r\n\r\nlocal cachedBiofuelProcessor = nil\r\nlocal nextBiofuelProcessorLookup = 0\r\nlocal function getBiofuelProcessorCached()\r\n    if cachedBiofuelProcessor then\r\n        if cachedBiofuelProcessor.Parent and cachedBiofuelProcessor:IsDescendantOf(workspace) then\r\n            return cachedBiofuelProcessor\r\n        end\r\n        cachedBiofuelProcessor = nil\r\n        nextBiofuelProcessorLookup = 0\r\n    end\r\n\r\n    cachedBiofuelProcessor = nil\r\n    local now = os.clock()\r\n    if now < nextBiofuelProcessorLookup then return nil end\r\n    nextBiofuelProcessorLookup = now + 2\r\n\r\n    local collectionService = game:GetService(\"CollectionService\")\r\n    for _, instance in ipairs(collectionService:GetTagged(\"BiofuelProcessor\")) do\r\n        if instance and instance.Parent and instance:IsDescendantOf(workspace) then\r\n            cachedBiofuelProcessor = instance\r\n            return instance\r\n        end\r\n    end\r\n\r\n    -- Depending on the game build, a placed processor can live in Structures OR Deployables.\r\n    for _, folderName in ipairs({\"Structures\", \"Deployables\"}) do\r\n        local folder = workspace:FindFirstChild(folderName)\r\n        if folder then\r\n            cachedBiofuelProcessor = folder:FindFirstChild(\"Biofuel Processor\")\r\n            if cachedBiofuelProcessor then return cachedBiofuelProcessor end\r\n            for _, obj in ipairs(folder:GetChildren()) do\r\n                if obj.Name:find(\"Biofuel Processor\", 1, true) then\r\n                    cachedBiofuelProcessor = obj\r\n                    return obj\r\n                end\r\n            end\r\n        end\r\n    end\r\n    return nil\r\nend\r\n\r\n-- Background UI Tracker (Always Active, Sangat Ringan)\r\ntask.spawn(function()\r\n    while KixHubSession.Alive and task.wait(1) do\r\n        pcall(function()\r\n            local percent, mainFire = getCampfirePercent()\r\n            if percent == nil then\r\n                if biofuelSmartDesc then biofuelSmartDesc:SetDesc(\"Fire : ?%\\nStatus : Waiting for campfire fuel data\") end\r\n                return\r\n            end\r\n\r\n            -- Deteksi Level Api Akurat dari Workspace Progress Attribute\r\n            local level = getCampfireLevel()\r\n            local levelStr = level >= 6 and \"Level 6 (MAX)\" or string.format(\"Level %d/6\", level)\r\n            \r\n            local statusText = \"System Disabled\"\r\n            \r\n            if autoBiofuelSmart then\r\n                local biofuelProc = getBiofuelProcessorCached()\r\n                if not biofuelProc then\r\n                    statusText = \"Biofuel Processor not found in map. Waiting to be placed...\"\r\n                else\r\n                    if level >= 6 and percent >= 95 then\r\n                        statusText = string.format(\"Standby (Fire Full: %d%% | Limit: 95%%)\", percent)\r\n                    else\r\n                        statusText = _G.BiofuelStatus or (isBiofuelFilling and \"Refueling Campfire...\" or \"Standby (Fire is Normal)\")\r\n                    end\r\n                end\r\n            end\r\n            \r\n            -- UPDATE PARAGRAPH BIOFUEL\r\n            if biofuelSmartDesc then\r\n                biofuelSmartDesc:SetDesc(string.format(\"Fire : %s (%d%%)\\nStatus : %s\", levelStr, percent, statusText))\r\n            end\r\n            \r\n            -- UPDATE TOGGLE AUTO UPGRADE FIRE\r\n            if _G.UpgradeFireToggle then\r\n                if level >= 6 then\r\n                    _G.UpgradeFireToggle:SetDesc(string.format(\"%s | Fire: %d%% | Max level (maintaining 75%%-85%%).\", levelStr, percent))\r\n                else\r\n                    _G.UpgradeFireToggle:SetDesc(string.format(\"%s | Fire: %d%% | Automatically dropping fuels to reach max level.\", levelStr, percent))\r\n                end\r\n            end\r\n        end)\r\n    end\r\nend)\r\n\r\nTabs.Auto:Paragraph({\r\n    Title = '⚠️ Recommendation',\r\n    Desc = 'Recommend placing at least 20 Farm Plots inside your base.'\r\n})\r\n\r\n_G.KixEngines.AutoBiofuel = function(val)\r\n    val = val == true\r\n    if val == (autoBiofuelSmart == true)\r\n        and (not val or (_G.KixEngines.TaskCounts.AutoBiofuel or 0) > 0) then return end\r\n    _G.KixEngines.Errors.AutoBiofuel = nil\r\n    _G.KixEngines.Tokens.AutoBiofuel = (_G.KixEngines.Tokens.AutoBiofuel or 0) + 1\r\n    local engineToken = _G.KixEngines.Tokens.AutoBiofuel\r\n\r\n        autoBiofuelSmart = val\r\n        isBiofuelFilling = false\r\n        if val then\r\n            _G.KixEngines.Spawn(\"AutoBiofuel\", function()\r\n                local lastFirePercent = 100\r\n                local lastPercentChangeTime = os.time()\r\n                local isEmergencyMode = false\r\n                local itemCooldowns = {}\r\n                local nextFarmHarvestAt = 0\r\n                local biofuelFoodOrder = {\"Pumpkin\", \"Apple\", \"Carrot\", \"Corn\", \"Morsel\", \"Steak\", \"Cooked Morsel\", \"Cooked Steak\", \"Cooked Ribs\", \"Cooked Salmon\", \"Berry\", \"Cake\", \"Strawberry\", \"Swordfish\", \"Salmon\", \"Mackerel\", \"Chili\", \"Ribs\"}\r\n                local biofuelFoodRanks = {}\r\n                local directBiofuelNames = {Apple = true, Strawberry = true, Pumpkin = true}\r\n                local validBiofuelFoodNames = {\r\n                    [\"Apple\"] = true, [\"Strawberry\"] = true, [\"Pumpkin\"] = true,\r\n                    [\"Carrot\"] = true, [\"Corn\"] = true,\r\n                    [\"Morsel\"] = true, [\"Steak\"] = true, [\"Cooked Morsel\"] = true,\r\n                    [\"Cooked Steak\"] = true, [\"Cooked Ribs\"] = true, [\"Cooked Salmon\"] = true,\r\n                    [\"Berry\"] = true, [\"Cake\"] = true\r\n                }\r\n                for rank, name in ipairs(biofuelFoodOrder) do\r\n                    biofuelFoodRanks[name] = rank\r\n                end\r\n\r\n                local function getProcessorIntake(processor)\r\n                    if not processor then return nil, nil end\r\n                    local touchZone = processor:FindFirstChild(\"TouchZone\")\r\n                    local intakeInner = processor:FindFirstChild(\"IntakeInner\")\r\n                    local intake = processor:FindFirstChild(\"Intake\")\r\n                    local primary = processor:IsA(\"Model\") and processor.PrimaryPart or nil\r\n                    local targetPart = touchZone or intakeInner or intake or primary\r\n                        or (processor:IsA(\"BasePart\") and processor)\r\n                        or processor:FindFirstChildWhichIsA(\"BasePart\", true)\r\n                    return targetPart, touchZone\r\n                end\r\n\r\n                local function isBiofuelSelected(itemName)\r\n                    local selected = _G.KixBiofuelSelectedIngredients\r\n                    return type(selected) == \"table\" and selected[itemName] == true\r\n                end\r\n\r\n                local function canUseDirectBiofuelDrag(item)\r\n                    if not item or not item:IsA(\"Model\") or not item.PrimaryPart\r\n                        or item:GetAttribute(\"Interaction\") == nil\r\n                        or item:GetAttribute(\"Locked\") == true\r\n                        or item:GetAttribute(\"IceBlock\") == true then return false end\r\n                    local primary = item.PrimaryPart\r\n                    local function inert(part)\r\n                        return part.Anchored and part.CanCollide == false\r\n                            and part.CanQuery == false and part.CanTouch == false\r\n                    end\r\n                    if inert(primary) then\r\n                        for _, part in ipairs(item:GetDescendants()) do\r\n                            if part:IsA(\"BasePart\") and not inert(part) then return true end\r\n                        end\r\n                        return false\r\n                    end\r\n                    return true\r\n                end\r\n\r\n                local function stopAtMaintenanceCap()\r\n                    if not autoBiofuelSmart or engineToken ~= _G.KixEngines.Tokens.AutoBiofuel then\r\n                        return true\r\n                    end\r\n                    local currentLevel = tonumber(getCampfireLevel()) or 0\r\n                    local currentPercent = getCampfirePercent()\r\n                    if currentLevel >= 6 and type(currentPercent) == \"number\" and currentPercent >= 95 then\r\n                        isBiofuelFilling = false\r\n                        isEmergencyMode = false\r\n                        _G.KixBiofuelPercent = currentPercent\r\n                        _G.BiofuelStatus = string.format(\"Standby (Fire Full: %d%% | Limit: 95%%)\", currentPercent)\r\n                        return true\r\n                    end\r\n                    return false\r\n                end\r\n\r\n                local function isItemProcessable(item, processor, itemsFolder)\r\n                    if not item or not item.Parent or not processor or not processor.Parent then return false end\r\n                    if _G.KixIsPeltTraderGrassAsset and _G.KixIsPeltTraderGrassAsset(item) then return false end\r\n                    local harvestClaim = KixSharedFarmHarvest.Reserved[item]\r\n                    if harvestClaim and harvestClaim.Owner == \"Cook\"\r\n                        and harvestClaim.Until > os.clock() then\r\n                        return false\r\n                    end\r\n                    local position = item:IsA(\"Model\") and item:GetPivot().Position\r\n                        or (item:IsA(\"BasePart\") and item.Position)\r\n                    if not position then return false end\r\n                    if (position - processor:GetPivot().Position).Magnitude > 100\r\n                        and not KixSharedFarmCropNames[item.Name]\r\n                        and not directBiofuelNames[item.Name] then return false end\r\n                    if itemsFolder and item.Parent ~= itemsFolder then return false end\r\n                    local allowProcess = processor and processor:FindFirstChild(\"AllowProcess\")\r\n                    local cleanKey = string.gsub(item.Name, \"%W\", \"_\")\r\n                    local allowed = allowProcess and allowProcess:GetAttribute(cleanKey)\r\n                    if directBiofuelNames[item.Name]\r\n                        and (allowed ~= true or not canUseDirectBiofuelDrag(item)) then return false end\r\n                    if allowed ~= true and not validBiofuelFoodNames[item.Name] then return false end\r\n                    if not isBiofuelSelected(item.Name) then return false end\r\n\r\n                    local lowerName = string.lower(item.Name)\r\n                    if string.find(lowerName, \"grass\", 1, true)\r\n                        or string.find(lowerName, \"ground\", 1, true)\r\n                        or string.find(lowerName, \"terrain\", 1, true)\r\n                        or string.find(lowerName, \"mound\", 1, true)\r\n                        or string.find(lowerName, \"plot\", 1, true) then\r\n                        return false\r\n                    end\r\n\r\n                    if not itemsFolder then\r\n                        local map = workspace:FindFirstChild(\"Map\")\r\n                        local structures = workspace:FindFirstChild(\"Structures\")\r\n                        if (map and item:IsDescendantOf(map))\r\n                            or (structures and item:IsDescendantOf(structures)) then\r\n                            return false\r\n                        end\r\n                    end\r\n\r\n                    if item:IsA(\"Model\") then\r\n                        local prompt = item:FindFirstChildWhichIsA(\"ProximityPrompt\", true)\r\n                        if prompt and prompt.Enabled then\r\n                            -- A loose vegetable may still have a pickup prompt; don't reject it.\r\n                            -- Only skip crops that are still actively harvestable on a plot.\r\n                            local action = string.lower(prompt.ActionText or \"\")\r\n                            if action:find(\"harvest\", 1, true) or action:find(\"panen\", 1, true) then\r\n                                return false\r\n                            end\r\n                        end\r\n                    end\r\n\r\n                    if allowed ~= nil then return allowed == true end\r\n                    return true\r\n                end\r\n\r\n                -- Auto Biofuel uses the direct, unqueued drag flow used by manual Bring.\r\n                -- This intentionally bypasses the global Logging Camp exclusion for food.\r\n                local function dragBiofuelDirect(item, destination, originalParent, directFoodFlow)\r\n                    if not KixHubSession.Alive or not autoBiofuelSmart\r\n                        or engineToken ~= _G.KixEngines.Tokens.AutoBiofuel\r\n                        or not item or not item.Parent or item.Parent ~= originalParent\r\n                        or not item:IsA(\"Model\") or not item.PrimaryPart\r\n                        or item:GetAttribute(\"Interaction\") == nil\r\n                        or (directFoodFlow and typeof(destination) ~= \"CFrame\")\r\n                        or (not directFoodFlow and typeof(destination) ~= \"Vector3\") then return false end\r\n                    if directFoodFlow and (not directBiofuelNames[item.Name]\r\n                        or not canUseDirectBiofuelDrag(item)) then return false end\r\n                    if _G.KixIsBringBlacklistedItem and _G.KixIsBringBlacklistedItem(item) then return false end\r\n                    local owner = item:GetAttribute(\"Owner\")\r\n                    if owner and owner ~= _LocalPlayer.UserId then return false end\r\n                    if isItemHeldByAnotherPlayer(item, true) then return false end\r\n\r\n                    local remotes = _ReplicatedStorage:FindFirstChild(\"RemoteEvents\")\r\n                    local startDrag = remotes and remotes:FindFirstChild(\"RequestStartDraggingItem\")\r\n                    local stopDrag = remotes and remotes:FindFirstChild(\"StopDraggingItem\")\r\n                    if not (startDrag and startDrag:IsA(\"RemoteEvent\")\r\n                        and stopDrag and stopDrag:IsA(\"RemoteEvent\")) then return false end\r\n\r\n                    local primary = item.PrimaryPart\r\n                    local function valid()\r\n                        return KixHubSession.Alive and autoBiofuelSmart\r\n                            and engineToken == _G.KixEngines.Tokens.AutoBiofuel\r\n                            and item.Parent == originalParent and item.PrimaryPart == primary\r\n                            and primary:IsDescendantOf(item)\r\n                            and item:GetAttribute(\"Locked\") ~= true\r\n                            and item:GetAttribute(\"IceBlock\") ~= true\r\n                            and (not directFoodFlow or canUseDirectBiofuelDrag(item))\r\n                    end\r\n                    local startOk = pcall(function() startDrag:FireServer(item) end)\r\n                    if not startOk then return false end\r\n                    local deadline = os.clock() + 2\r\n                    local acquired = false\r\n                    while valid() and os.clock() < deadline do\r\n                        if not primary.Anchored and item:GetAttribute(\"Owner\") == _LocalPlayer.UserId then\r\n                            local assemblies, ownershipOk = {}, true\r\n                            for _, part in ipairs(item:GetDescendants()) do\r\n                                if part:IsA(\"BasePart\") then\r\n                                    local assemblyRoot = part.AssemblyRootPart\r\n                                    if not assemblyRoot or assemblyRoot.Anchored\r\n                                        or not assemblyRoot:IsDescendantOf(item) then\r\n                                        ownershipOk = false\r\n                                        break\r\n                                    end\r\n                                    if not assemblies[assemblyRoot] then\r\n                                        assemblies[assemblyRoot] = true\r\n                                        for _, connected in ipairs(part:GetConnectedParts(true)) do\r\n                                            if not connected:IsDescendantOf(item) then\r\n                                                ownershipOk = false\r\n                                                break\r\n                                            end\r\n                                        end\r\n                                        if ownershipOk and type(getnetworkowner) == \"function\" then\r\n                                            local ownerOk, isLocalOwner = pcall(getnetworkowner, assemblyRoot)\r\n                                            if not ownerOk or isLocalOwner ~= true then ownershipOk = false end\r\n                                        end\r\n                                    end\r\n                                    if not ownershipOk then break end\r\n                                end\r\n                            end\r\n                            if ownershipOk then acquired = true; break end\r\n                        end\r\n                        task.wait(0.05)\r\n                    end\r\n\r\n                    local moveOk = false\r\n                    if acquired and valid() then\r\n                        moveOk = pcall(function()\r\n                            item:PivotTo(directFoodFlow and destination or CFrame.new(destination))\r\n                        end)\r\n                        if moveOk then task.wait(0.15) end\r\n                    end\r\n                    pcall(function() stopDrag:FireServer(item) end)\r\n                    return moveOk and valid()\r\n                end\r\n\r\n                local function feedItemToProcessor(processor, item)\r\n                    if stopAtMaintenanceCap() then return false end\r\n                    if not processor or not item or not item.Parent then return false end\r\n                    if not isItemProcessable(item, processor, nil) then return false end\r\n\r\n                    local intakePart, touchZone = getProcessorIntake(processor)\r\n                    if not intakePart or not touchZone then return false end\r\n\r\n                    local directFoodFlow = directBiofuelNames[item.Name] == true\r\n                    local dropPos = directFoodFlow\r\n                        and touchZone:GetPivot() * CFrame.new(0, 5, 0)\r\n                        or (intakePart.Position + Vector3.new(0, 0.5, 0))\r\n                    local originalParent = item.Parent\r\n\r\n                    -- Recheck immediately before dragging; the fire may have filled\r\n                    -- while a previous item was being processed.\r\n                    if stopAtMaintenanceCap() then return false end\r\n\r\n                    -- Briefly reserve this exact item while the processor receives it.\r\n                    KixBiofuelClaims[item] = os.clock() + 3\r\n                    local dragged = dragBiofuelDirect(item, dropPos, originalParent, directFoodFlow)\r\n                    if not dragged then\r\n                        KixBiofuelClaims[item] = nil\r\n                        return false\r\n                    end\r\n                    task.wait(0.08)\r\n                    if stopAtMaintenanceCap() then\r\n                        KixBiofuelClaims[item] = nil\r\n                        return false\r\n                    end\r\n\r\n                    -- Let BiofuelProcessorModule's TouchZone handler perform its native\r\n                    -- local ProcessItem step and its single RequestProcessToBiofuel call.\r\n                    local touchPart = item:IsA(\"BasePart\") and item\r\n                        or item:FindFirstChildWhichIsA(\"BasePart\", true)\r\n                    if touchPart and firetouchinterest then\r\n                        pcall(function()\r\n                            firetouchinterest(touchPart, touchZone, 0)\r\n                            task.wait(0.02)\r\n                            firetouchinterest(touchPart, touchZone, 1)\r\n                        end)\r\n                    end\r\n\r\n                    local confirmed = false\r\n                    local deadline = os.clock() + 1.25\r\n                    while os.clock() < deadline do\r\n                        if not item.Parent or item.Parent ~= originalParent or item:IsDescendantOf(processor) then\r\n                            confirmed = true\r\n                            break\r\n                        end\r\n                        task.wait(0.05)\r\n                    end\r\n                    if confirmed then\r\n                        _G.KixPerfDebug.Count(\"BiofuelProcessAccepted\")\r\n                        return true\r\n                    end\r\n                    _G.KixPerfDebug.Count(\"BiofuelProcessRejected\")\r\n                    KixBiofuelClaims[item] = nil\r\n                    return false\r\n                end\r\n\r\n                local function harvestFarmPlotFood(processor)\r\n                    if stopAtMaintenanceCap() or not processor or os.clock() < nextFarmHarvestAt then return 0 end\r\n                    nextFarmHarvestAt = os.clock() + 3\r\n                    local harvested = 0\r\n                    for _ = 1, 2 do\r\n                        if stopAtMaintenanceCap() then break end\r\n                        local item = KixSharedFarmHarvest.Harvest(\r\n                            processor:GetPivot().Position,\r\n                            function()\r\n                                return autoBiofuelSmart and engineToken == _G.KixEngines.Tokens.AutoBiofuel\r\n                            end,\r\n                            function(name)\r\n                                if not KixSharedFarmCropNames[name] or not isBiofuelSelected(name) then return false end\r\n                                local allowProcess = processor:FindFirstChild(\"AllowProcess\")\r\n                                local allowed = allowProcess\r\n                                    and allowProcess:GetAttribute(string.gsub(name, \"%W\", \"_\"))\r\n                                return allowed == true or (allowed == nil and validBiofuelFoodNames[name] == true)\r\n                            end,\r\n                            \"Biofuel\",\r\n                            isBiofuelSelected(\"Pumpkin\") and \"Pumpkin\" or nil\r\n                        )\r\n                        if not item then break end\r\n                        if feedItemToProcessor(processor, item) then\r\n                            harvested = harvested + 1\r\n                        else\r\n                            itemCooldowns[item] = os.time()\r\n                            break\r\n                        end\r\n                        task.wait(0.12)\r\n                    end\r\n                    if harvested > 0 then _G.KixPerfDebug.Count(\"BiofuelFarmHarvested\") end\r\n                    return harvested\r\n                end\r\n\r\n                local lastCycleWarning = 0\r\n                while autoBiofuelSmart and engineToken == _G.KixEngines.Tokens.AutoBiofuel do\r\n                    local loopDelay = 3\r\n                    local cycleOk, cycleError = pcall(function()\r\n                        local percent, mainFire = getCampfirePercent()\r\n                        if percent == nil or not mainFire then\r\n                            _G.BiofuelStatus = \"Waiting: campfire fuel UI/attributes unavailable\"\r\n                            loopDelay = 3\r\n                            return\r\n                        end\r\n                        _G.KixBiofuelPercent = percent\r\n\r\n                        -- Hard stop at max fire + 95%, before scanning items or\r\n                        -- harvesting crops. Re-read both values every worker cycle.\r\n                        local currentLevel = tonumber(getCampfireLevel()) or 0\r\n                        if currentLevel >= 6 and percent >= 95 then\r\n                            isBiofuelFilling = false\r\n                            isEmergencyMode = false\r\n                            _G.BiofuelStatus = string.format(\"Standby (Fire Full: %d%% | Limit: 95%%)\", percent)\r\n                            loopDelay = 4\r\n                            return\r\n                        end\r\n\r\n                        local biofuelProc = getBiofuelProcessorCached()\r\n                        if not biofuelProc then\r\n                            _G.BiofuelStatus = string.format(\"Waiting: Biofuel Processor missing (Fire %d%%)\", percent)\r\n                            isBiofuelFilling = false -- do not block cooking without a processor\r\n                            loopDelay = 5\r\n                            return\r\n                        end\r\n\r\n                        -- Only a fully upgraded fire uses maintenance hysteresis.\r\n                        local upgradingFire = getCampfireLevel() < 6\r\n                        if upgradingFire then\r\n                            isBiofuelFilling = true\r\n                        elseif percent <= 75 then\r\n                            isBiofuelFilling = true\r\n                        elseif percent >= 95 then\r\n                            isBiofuelFilling = false\r\n                        end\r\n\r\n                        -- Emergency timer handling\r\n                        if not isBiofuelFilling then\r\n                            isEmergencyMode = false\r\n                            lastPercentChangeTime = os.time()\r\n                        else\r\n                            if not isEmergencyMode then\r\n                                if percent >= lastFirePercent + 5 then\r\n                                    lastPercentChangeTime = os.time()\r\n                                end\r\n                                if os.time() - lastPercentChangeTime >= 15 then\r\n                                    isEmergencyMode = true\r\n                                end\r\n                            end\r\n                        end\r\n                        lastFirePercent = percent\r\n\r\n                        local itemsFolder, itemsSnapshot = _G.KixItemsIndex.Get()\r\n                        local biofuels = {}\r\n                        if itemsFolder then\r\n                            for _, item in ipairs(itemsSnapshot) do\r\n                                if item.Name == \"Biofuel\" then\r\n                                    table.insert(biofuels, item)\r\n                                end\r\n                            end\r\n                        end\r\n\r\n                        local function canSendFuel()\r\n                            if not autoBiofuelSmart or engineToken ~= _G.KixEngines.Tokens.AutoBiofuel then return false end\r\n                            if stopAtMaintenanceCap() then\r\n                                isBiofuelFilling = false\r\n                                return false\r\n                            end\r\n                            return isBiofuelFilling\r\n                        end\r\n\r\n                        -- A. REFUEL CAMPFIRE: Jika api butuh diisi\r\n                        if isBiofuelFilling and (upgradingFire or percent < 95) then\r\n                            _G.BiofuelStatus = string.format(\"Refueling Campfire (Stock: %d)...\", #biofuels)\r\n                            if #biofuels > 0 then\r\n                                for i = 1, math.min(1, #biofuels) do\r\n                                    if not canSendFuel() then break end\r\n                                    dragBiofuelDirect(biofuels[i], campfirePos + Vector3.new(0, 4, 0), itemsFolder)\r\n                                    task.wait(0.25)\r\n                                end\r\n                            elseif isEmergencyMode and itemsFolder then\r\n                                -- Emergency backup fuels (Coal, Canister, Oil Barrel)\r\n                                for _, itm in ipairs(itemsSnapshot) do\r\n                                    local n = itm.Name\r\n                                    if n == \"Coal\" or n == \"Fuel Canister\" or n == \"Oil Barrel\" or n == \"Oil-Barrel\" then\r\n                                        if not canSendFuel() then break end\r\n                                        dragBiofuelDirect(itm, campfirePos + Vector3.new(0, 4, 0), itemsFolder)\r\n                                        task.wait(0.3)\r\n                                        break\r\n                                    end\r\n                                end\r\n                            end\r\n                        end\r\n\r\n                        -- C. PROCESS FOOD INTO BIOFUEL PROCESSOR:\r\n                        -- Keep producing fuel during upgrades; use the maintenance range only at max level.\r\n                        local now = os.time()\r\n                        local needsBiofuelProduction = isBiofuelFilling and (upgradingFire or percent < 95)\r\n                        if needsBiofuelProduction then\r\n                            if stopAtMaintenanceCap() then\r\n                                loopDelay = 4\r\n                                return\r\n                            end\r\n                            -- Harvest only from placed Farm Plot structures, then drag directly to processor intake.\r\n                            harvestFarmPlotFood(biofuelProc)\r\n                            if stopAtMaintenanceCap() then\r\n                                loopDelay = 4\r\n                                return\r\n                            end\r\n                            loopDelay = 3\r\n                            _G.BiofuelStatus = string.format(\"Processing Vegetables into Biofuel (Stock: %d)...\", #biofuels)\r\n                            local foundFoods = {}\r\n                            local processorPos = biofuelProc:GetPivot().Position\r\n\r\n                            if itemsFolder then\r\n                                for _, item in ipairs(itemsSnapshot) do\r\n                                    if itemCooldowns[item] and (now - itemCooldowns[item] < 5) then\r\n                                        continue\r\n                                    end\r\n                                    if isItemProcessable(item, biofuelProc, itemsFolder) then\r\n                                        local rank = biofuelFoodRanks[item.Name] or 99\r\n                                        local itmPos = (item:IsA(\"Model\") and item:GetPivot().Position) or (item:IsA(\"BasePart\") and item.Position) or Vector3.zero\r\n                                        local dist = (itmPos - processorPos).Magnitude\r\n                                        table.insert(foundFoods, {Item = item, Rank = rank, Dist = dist})\r\n                                    end\r\n                                end\r\n                            end\r\n\r\n                            -- Use selected Pumpkin first; otherwise retain distance and rank ordering.\r\n                            table.sort(foundFoods, function(a, b)\r\n                                if a.Item.Name == \"Pumpkin\" then return b.Item.Name ~= \"Pumpkin\" end\r\n                                if b.Item.Name == \"Pumpkin\" then return false end\r\n                                if math.abs(a.Dist - b.Dist) > 5 then\r\n                                    return a.Dist < b.Dist\r\n                                end\r\n                                return a.Rank < b.Rank\r\n                            end)\r\n\r\n                            -- Batasi batch agar scan, drag dan remote tidak menumpuk dalam satu siklus.\r\n                            local processedCount = 0\r\n                            for _, fData in ipairs(foundFoods) do\r\n                                if stopAtMaintenanceCap() then break end\r\n                                if processedCount >= 2 then break end\r\n                                local itm = fData.Item\r\n                                if itm and itm.Parent == itemsFolder and isItemProcessable(itm, biofuelProc, itemsFolder) then\r\n                                    local fed = feedItemToProcessor(biofuelProc, itm)\r\n                                    itemCooldowns[itm] = now\r\n                                    if fed then processedCount = processedCount + 1 end\r\n                                    task.wait(0.25)\r\n                                end\r\n                            end\r\n                            if stopAtMaintenanceCap() then\r\n                                loopDelay = 4\r\n                            elseif processedCount > 0 then\r\n                                loopDelay = 1.5\r\n                            elseif #biofuels == 0 then\r\n                                _G.BiofuelStatus = string.format(\"Waiting: no processable food/drag available (Fire %d%%)\", percent)\r\n                            end\r\n                        else\r\n                            loopDelay = 4\r\n                            if getCampfireLevel() >= 6 and percent >= 95 then\r\n                                isBiofuelFilling = false\r\n                                _G.BiofuelStatus = string.format(\"Standby (Fire Full: %d%% | Limit: 95%%)\", percent)\r\n                            else\r\n                                _G.BiofuelStatus = string.format(\"Standby (Fire Normal: %d%% | Stock: %d)\", percent, #biofuels)\r\n                            end\r\n                        end\r\n\r\n                        -- Clean up old cooldown entries\r\n                        for itm, t in pairs(itemCooldowns) do\r\n                            if not itm or not itm.Parent or (now - t > 15) then\r\n                                itemCooldowns[itm] = nil\r\n                            end\r\n                        end\r\n\r\n                    end)\r\n                    if not cycleOk then\r\n                        _G.BiofuelStatus = \"Error: \" .. tostring(cycleError)\r\n                        _G.KixEngines.Errors.AutoBiofuel = tostring(cycleError)\r\n                        if os.clock() - lastCycleWarning > 10 then\r\n                            lastCycleWarning = os.clock()\r\n                            warn(\"[AutoBiofuel] \" .. tostring(cycleError))\r\n                        end\r\n                    end\r\n                    task.wait(loopDelay)\r\n                end\r\n            end)\r\n        end\r\nend\r\n_G.KixAdapters.AutoBiofuel = {IsEnabled = function() return autoBiofuelSmart == true end}\r\n\r\n_G.KixStartupFeatures.Toggles.AutoBiofuel = Tabs.Auto:Toggle({\r\n    Title = '⛽ Auto Biofuel Smart System',\r\n    Desc = 'INFINITE FUEL using Biofuel. Requires a Biofuel Processor and Farm Plots.',\r\n    Value = false,\r\n    Callback = function(value)\r\n        _G.KixStartupFeatures.Set(\"AutoBiofuel\", value)\r\n    end\r\n})\r\n-- Status paragraph intentionally hidden; engine state remains available internally.\r\n_G.KixStartupFeatures.Status.AutoBiofuel = nil\r\n\r\n\r\n-- Recommendation merged with Biofuel above. Auto Cook's excludedCookItems remain separate.\r\n\r\nautoCookPots = false\r\n-- Shared stew names and spawn metadata for Auto Cook and Auto Pick Up Stew.\r\nlocal KixStewPickupNames = {Stew = true, [\"Hearty Stew\"] = true, [\"Pumpkin Soup\"] = true, [\"Seafood Chowder\"] = true}\r\nlocal KixStewSpawnOrigins = _G.KixStewSpawnOrigins\r\nif type(KixStewSpawnOrigins) ~= \"table\" then\r\n    KixStewSpawnOrigins = setmetatable({}, {__mode = \"k\"})\r\n    _G.KixStewSpawnOrigins = KixStewSpawnOrigins\r\nend\r\n-- Keep each pot's serving point fixed while Auto Cook and Auto Pick Up Stew run.\r\n-- The game can reuse a collected bowl at its last moved position; that position\r\n-- must never become the next bowl's origin.\r\nlocal KixStewPotSpawnAnchors = setmetatable({}, {__mode = \"k\"})\r\n_G.KixStewSpawnPending = false\r\n_G.KixEngines.AutoCookCrockPot = function(val)\r\n    val = val == true\r\n    if val == (autoCookPots == true)\r\n        and (not val or (_G.KixEngines.TaskCounts.AutoCookCrockPot or 0) > 0) then return end\r\n    _G.KixEngines.Errors.AutoCookCrockPot = nil\r\n    _G.KixEngines.Tokens.AutoCookCrockPot = (_G.KixEngines.Tokens.AutoCookCrockPot or 0) + 1\r\n    local engineToken = _G.KixEngines.Tokens.AutoCookCrockPot\r\n\r\n        autoCookPots = val\r\n        if val then\r\n            -- Reset data state saat toggle dinyalakan\r\n            _G.StationFails = {}\r\n            _G.StationFeedAttempts = {}\r\n            _G.StationLastIngredients = {}\r\n            _G.StationBlacklistTime = {}\r\n            _G.ClaimedItems = {}\r\n\r\n            _G.KixEngines.Spawn(\"AutoCookCrockPot\", function()\r\n                -- Per-pot serving state. The 5-second teammate grace must start\r\n                -- when a pot becomes READY, before any take prompt is fired.\r\n                -- Auto Pick Up Stew starts its five-second grace when a bowl appears.\r\n                local lastStewTake = setmetatable({}, {__mode = \"k\"})\r\n                local stewPotReady = setmetatable({}, {__mode = \"k\"})\r\n\r\n                local function looseStewAtPot(station)\r\n                    local folder = workspace:FindFirstChild(\"Items\") or workspace:FindFirstChild(\"items\")\r\n                    if not folder then return false end\r\n                    local ok, potPosition = pcall(function() return station:GetPivot().Position end)\r\n                    if not ok then return false end\r\n                    if autoPickStewEnabled then\r\n                        for _, child in ipairs(station:GetDescendants()) do\r\n                            if child:IsA(\"Model\") and KixStewPickupNames[child.Name] then\r\n                                return true\r\n                            end\r\n                        end\r\n                    end\r\n                    for _, food in ipairs(folder:GetChildren()) do\r\n                        if KixStewPickupNames[food.Name] and food.Parent == folder then\r\n                            local located, foodPosition = pcall(function() return food:GetPivot().Position end)\r\n                            if located and (foodPosition - potPosition).Magnitude <= 18 then\r\n                                -- Already a loose bowl near the station: let the\r\n                                -- 5s Auto Pick Up Stew timer or a teammate handle it.\r\n                                return true\r\n                            end\r\n                        end\r\n                    end\r\n                    return false\r\n                end\r\n\r\n                local function stewTakePrompt(station)\r\n                    local fallback\r\n                    for _, candidate in ipairs(station:GetDescendants()) do\r\n                        if candidate:IsA(\"ProximityPrompt\") and candidate.Enabled then\r\n                            local action = string.lower(tostring(candidate.ActionText or \"\"))\r\n                            if action:find(\"take\", 1, true)\r\n                                or action:find(\"collect\", 1, true)\r\n                                or action:find(\"stew\", 1, true) then\r\n                                return candidate\r\n                            end\r\n                            fallback = fallback or candidate\r\n                        end\r\n                    end\r\n                    return fallback\r\n                end\r\n\r\n                local validIngredients = {\r\n                    [\"Apple\"]=true, [\"Pumpkin\"]=true, [\"Carrot\"]=true, [\"Corn\"]=true, [\"Cake\"]=true, \r\n                    [\"Ribs\"]=true, [\"Cooked Ribs\"]=true, [\"Morsel\"]=true, [\"Cooked Morsel\"]=true, [\"Steak\"]=true, [\"Cooked Steak\"]=true, \r\n                    [\"Salmon\"]=true, [\"Cooked Salmon\"]=true, [\"Mackerel\"]=true, [\"Cooked Mackerel\"]=true, [\"Clownfish\"]=true, [\"Clowfish\"]=true, [\"Cooked Clowfish\"]=true,\r\n                    [\"Swordfish\"]=true, [\"Cooked Swordfish\"]=true, [\"Jellyfish\"]=true, [\"Char\"]=true, [\"Cooked Char\"]=true, [\"Eel\"]=true, [\"Cooked Eel\"]=true,\r\n                    [\"Lava Eel\"]=true, [\"Lionfish\"]=true, [\"Cooked Lava Eel\"]=true, [\"Cooked Lionfish\"]=true\r\n                }\r\n\r\n                -- Match the game's CrockpotClient request: detach locally, invoke the\r\n                -- authoritative RemoteFunction, and restore the old parent if rejected.\r\n                local function requestCrockpotIngredient(station, item)\r\n                    if not station or not station.Parent or not item or not item.Parent then return false end\r\n                    if station:GetAttribute(\"Cooking\") or station:GetAttribute(\"CanTake\")\r\n                        or (station:GetAttribute(\"Ingredients\") or 0) >= 3 then return false end\r\n                    if station.Name == \"Chefs Station\" and _LocalPlayer:GetAttribute(\"Class\") ~= \"Chef\" then\r\n                        return false\r\n                    end\r\n                    if item:GetAttribute(\"CrockPotBanned\") or item:GetAttribute(\"PreparedMeal\")\r\n                        or item.Name:find(\"Shark\", 1, true) then\r\n                        return false\r\n                    end\r\n                    local owner = item:GetAttribute(\"Owner\")\r\n                    if owner and owner ~= _LocalPlayer.UserId then return false end\r\n                    if not item:GetAttribute(\"RestoreHunger\") and not item:GetAttribute(\"CrockpotIngredient\") then\r\n                        return false\r\n                    end\r\n\r\n                    local remoteEvents = _ReplicatedStorage:FindFirstChild(\"RemoteEvents\")\r\n                    local request = remoteEvents and remoteEvents:FindFirstChild(\"RequestCrockpotItem\")\r\n                    if not request or not request:IsA(\"RemoteFunction\") then return false end\r\n\r\n                    local originalParent = item.Parent\r\n                    local detached = pcall(function() item.Parent = nil end)\r\n                    if not detached then return false end\r\n                    local ok, response = pcall(function()\r\n                        return request:InvokeServer(station, item)\r\n                    end)\r\n                    local accepted = ok and type(response) == \"table\" and response.Success == true\r\n                    if not accepted and item.Parent == nil then\r\n                        pcall(function() item.Parent = originalParent end)\r\n                    end\r\n                    if not ok then\r\n                        _G.KixPerfDebug.Count(\"CookRemoteError\")\r\n                    elseif not accepted then\r\n                        _G.KixPerfDebug.Count(\"CookRemoteRejected\")\r\n                    else\r\n                        _G.KixPerfDebug.Count(\"CookRemoteAccepted\")\r\n                    end\r\n                    return accepted\r\n                end\r\n\r\n                -- Move loose food with the existing direct drag sequence.\r\n                -- Do not route cooking ingredients through dragItemSmooth: its global camp\r\n                -- filter and drag governor can silently skip or delay valid food.\r\n                local function dragCookIngredientDirect(item, destination, originalParent)\r\n                    if not item or not item.Parent or item.Parent ~= originalParent\r\n                        or typeof(destination) ~= \"Vector3\" then return false end\r\n                    if _G.KixIsBringBlacklistedItem and _G.KixIsBringBlacklistedItem(item) then return false end\r\n                    local owner = item:GetAttribute(\"Owner\")\r\n                    if owner and owner ~= _LocalPlayer.UserId then return false end\r\n                    if isItemHeldByAnotherPlayer(item, true) then return false end\r\n\r\n                    local remoteEvents = _ReplicatedStorage:FindFirstChild(\"RemoteEvents\")\r\n                    local startDrag = remoteEvents and remoteEvents:FindFirstChild(\"RequestStartDraggingItem\")\r\n                    local stopDrag = remoteEvents and remoteEvents:FindFirstChild(\"StopDraggingItem\")\r\n                    if not (startDrag and startDrag:IsA(\"RemoteEvent\")\r\n                        and stopDrag and stopDrag:IsA(\"RemoteEvent\")) then return false end\r\n\r\n                    local started = pcall(function() startDrag:FireServer(item) end)\r\n                    if not started then return false end\r\n                    task.wait(0.05)\r\n                    if not autoCookPots or engineToken ~= _G.KixEngines.Tokens.AutoCookCrockPot\r\n                        or item.Parent ~= originalParent then\r\n                        pcall(function() stopDrag:FireServer(item) end)\r\n                        return false\r\n                    end\r\n\r\n                    local moved = pcall(function()\r\n                        if item:IsA(\"Model\") then\r\n                            item:PivotTo(CFrame.new(destination))\r\n                        elseif item:IsA(\"BasePart\") then\r\n                            item.CFrame = CFrame.new(destination)\r\n                        else\r\n                            error(\"Cooking ingredient is not movable\")\r\n                        end\r\n                    end)\r\n                    task.wait(0.08)\r\n                    pcall(function() stopDrag:FireServer(item) end)\r\n                    return moved\r\n                end\r\n\r\n                -- Taking a ready bowl may make the server drop it above the player.\r\n                -- When Auto Collect is enabled, return that new bowl to its pot so\r\n                -- the collector can honor its five-second grace period at the pot.\r\n                local function takeStewAndReturnToPot(station, prompt)\r\n                    local items = workspace:FindFirstChild(\"Items\") or workspace:FindFirstChild(\"items\")\r\n                    local shouldTrack = autoPickStewEnabled and items ~= nil\r\n                    local before = shouldTrack and setmetatable({}, {__mode = \"k\"}) or nil\r\n                    if shouldTrack then\r\n                        for _, item in ipairs(items:GetChildren()) do\r\n                                    if KixStewPickupNames[item.Name] then\r\n                                local positionOk, position = pcall(function()\r\n                                    return item:GetPivot().Position\r\n                                end)\r\n                                if positionOk then before[item] = position end\r\n                            end\r\n                        end\r\n                        _G.KixStewSpawnPending = true\r\n                    end\r\n\r\n                    local takeOk = pcall(function()\r\n                        if fireproximityprompt then\r\n                            fireproximityprompt(prompt, 1)\r\n                        else\r\n                            prompt:InputHoldBegin()\r\n                            task.wait((prompt.HoldDuration or 0) + 0.1)\r\n                            prompt:InputHoldEnd()\r\n                        end\r\n                    end)\r\n\r\n                    if shouldTrack then\r\n                        pcall(function()\r\n                            local deadline = os.clock() + 1.5\r\n                            local potPosition = station:GetPivot().Position\r\n                            local target = KixStewPotSpawnAnchors[station]\r\n                            if not target then\r\n                                target = potPosition + Vector3.new(0, 3, 0)\r\n                                if station:IsA(\"Model\") then\r\n                                    local boxCFrame, boxSize = station:GetBoundingBox()\r\n                                    target = Vector3.new(boxCFrame.Position.X,\r\n                                        boxCFrame.Position.Y + boxSize.Y * 0.5 + 1,\r\n                                        boxCFrame.Position.Z)\r\n                                end\r\n                                KixStewPotSpawnAnchors[station] = target\r\n                            end\r\n                            local character = _LocalPlayer.Character\r\n                            local hrp = character and character:FindFirstChild(\"HumanoidRootPart\")\r\n                            while autoCookPots and autoPickStewEnabled\r\n                                and engineToken == _G.KixEngines.Tokens.AutoCookCrockPot\r\n                                and os.clock() < deadline do\r\n                                local candidate, candidateScore\r\n                                for _, item in ipairs(items:GetChildren()) do\r\n                                    if item.Parent == items\r\n                                        and KixStewPickupNames[item.Name] then\r\n                                        local positionOk, position = pcall(function()\r\n                                            return item:GetPivot().Position\r\n                                        end)\r\n                                        local previous = before[item]\r\n                                        local isNew = previous == nil\r\n                                        local movedSinceSnapshot = positionOk and previous ~= nil\r\n                                            and (position - previous).Magnitude > 2\r\n                                        local previousOrigin = KixStewSpawnOrigins[item]\r\n                                        local reusedCollectedBowl = previousOrigin\r\n                                            and previousOrigin.LastCollected == true\r\n                                        if positionOk and (isNew or movedSinceSnapshot or reusedCollectedBowl) then\r\n                                            local playerDistance = hrp and (position - hrp.Position).Magnitude or math.huge\r\n                                            local potDistance = (position - potPosition).Magnitude\r\n                                            local owner = item:GetAttribute(\"Owner\")\r\n                                            local ownedByOther = owner ~= nil and owner ~= \"\"\r\n                                                and owner ~= 0 and owner ~= \"0\" and owner ~= false\r\n                                                and owner ~= _LocalPlayer.UserId\r\n                                                and owner ~= tostring(_LocalPlayer.UserId)\r\n                                                and owner ~= _LocalPlayer.Name\r\n                                            local belongsToStation = previousOrigin\r\n                                                and previousOrigin.Pot == station\r\n                                            if (playerDistance <= 24 or potDistance <= 24\r\n                                                or (reusedCollectedBowl and belongsToStation))\r\n                                                and not ownedByOther then\r\n                                                local score = belongsToStation and potDistance\r\n                                                    or (playerDistance <= 24 and playerDistance or 24 + potDistance)\r\n                                                if not candidateScore or score < candidateScore then\r\n                                                    candidate, candidateScore = item, score\r\n                                                end\r\n                                            end\r\n                                        end\r\n                                    end\r\n                                end\r\n                                if candidate then\r\n                                    local origin = {\r\n                                        Since = os.clock(), Pot = station,\r\n                                        Position = target, Ready = false\r\n                                    }\r\n                                    KixStewSpawnOrigins[candidate] = origin\r\n                                    pcall(dragCookIngredientDirect, candidate, target, items)\r\n                                    -- Preserve the pot anchor even if replication briefly\r\n                                    -- reports the bowl at the player's last drag position.\r\n                                    origin.Ready = true\r\n                                    return\r\n                                end\r\n                                task.wait(0.1)\r\n                            end\r\n                        end)\r\n                        _G.KixStewSpawnPending = false\r\n                    end\r\n                    return takeOk\r\n                end\r\n\r\n                local function isReservedForBiofuel(item)\r\n                    if not item or not item.Parent then return false end\r\n                    if KixBiofuelClaims[item] and os.clock() < KixBiofuelClaims[item] then\r\n                        return true\r\n                    end\r\n                    local harvestClaim = KixSharedFarmHarvest.Reserved[item]\r\n                    if harvestClaim and harvestClaim.Owner == \"Biofuel\"\r\n                        and harvestClaim.Until > os.clock() then return true end\r\n                    if not (autoBiofuelSmart and isBiofuelFilling)\r\n                        or not getBiofuelProcessorCached() then return false end\r\n                    local selected = _G.KixBiofuelSelectedIngredients\r\n                    return type(selected) == \"table\" and selected[item.Name] == true\r\n                end\r\n\r\n                local function getHarvestableCrop(refPos)\r\n                    return KixSharedFarmHarvest.GetBest(refPos)\r\n                end\r\n\r\n                -- Supports both legacy crop prompts and current draggable crops\r\n                -- that already exist as Item models inside the Farm Plot bounds.\r\n                local function harvestOneMatureCrop(refPos)\r\n                    if not getHarvestableCrop(refPos) then return false end\r\n                    local detached = KixSharedFarmHarvest.Harvest(\r\n                        refPos,\r\n                        function() return autoCookPots and engineToken == _G.KixEngines.Tokens.AutoCookCrockPot end,\r\n                        function(name)\r\n                            if name == \"Pumpkin\" then return false end\r\n                            local biofuelSelection = _G.KixBiofuelSelectedIngredients\r\n                            if autoBiofuelSmart and isBiofuelFilling\r\n                                and getBiofuelProcessorCached()\r\n                                and type(biofuelSelection) == \"table\"\r\n                                and biofuelSelection[name] == true then return false end\r\n                            local selected = _G.KixAutoCookSelectedIngredients\r\n                            if type(selected) == \"table\" and selected[name] ~= true then return false end\r\n                            for _, excl in pairs(excludedCookItems or {}) do\r\n                                if excl ~= \"None\" and name:find(excl, 1, true) then return false end\r\n                            end\r\n                            return true\r\n                        end,\r\n                        \"Cook\"\r\n                    )\r\n                    if detached then _G.KixPerfDebug.Count(\"CookFarmHarvested\") end\r\n                    return detached ~= nil\r\n                end\r\n\r\n                -- Fungsi memindai sayuran / bahan makanan yang BENAR-BENAR LEPAS di Items dan sortir jarak terdekat\r\n                local function scanLooseIngredients(refPos)\r\n                    local itemsFolder, itemsSnapshot = _G.KixItemsIndex.Get()\r\n                    if not itemsFolder then return {}, 0 end\r\n\r\n                    local itemsByName = {}\r\n                    local totalAvailable = 0\r\n                    local activeExcluded = excludedCookItems or {}\r\n\r\n                    for _, item in ipairs(itemsSnapshot) do\r\n                        if not item or not item.Parent then continue end\r\n\r\n                        -- Item index hanya memuat anak langsung dari folder Items.\r\n                        if item.Parent ~= itemsFolder then continue end\r\n                        if not validIngredients[item.Name] then continue end\r\n                        local selectedCookIngredients = _G.KixAutoCookSelectedIngredients\r\n                        if type(selectedCookIngredients) == \"table\"\r\n                            and selectedCookIngredients[item.Name] ~= true then continue end\r\n                        if _G.KixIsPeltTraderGrassAsset\r\n                            and _G.KixIsPeltTraderGrassAsset(item) then continue end\r\n                        local itemPosition = item:IsA(\"Model\") and item:GetPivot().Position\r\n                            or (item:IsA(\"BasePart\") and item.Position)\r\n                        if not itemPosition then continue end\r\n                        local isLooseVegetable = KixSharedFarmCropNames[item.Name] == true\r\n                        if refPos and (itemPosition - refPos).Magnitude > 100 and not isLooseVegetable then continue end\r\n                        -- All candidates are valid cooking ingredients; the Logging\r\n                        -- Camp volume filter also catches legitimate nearby food.\r\n                        if isReservedForBiofuel(item) then continue end\r\n\r\n                        local isExcluded = false\r\n                        for _, excl in pairs(activeExcluded) do\r\n                            if excl ~= \"None\" and string.find(item.Name, excl) then\r\n                                isExcluded = true\r\n                                break\r\n                            end\r\n                        end\r\n                        if isExcluded then continue end\r\n\r\n                        -- 3. Tolak jika item masih punya prompt panen aktif (tanaman liar / belum dipanen di tanah)\r\n                        local prompt = item:FindFirstChildWhichIsA(\"ProximityPrompt\", true)\r\n                        if prompt and prompt.Enabled then\r\n                            local act = string.lower(prompt.ActionText or \"\")\r\n                            if string.find(act, \"harvest\", 1, true) or string.find(act, \"panen\", 1, true) then\r\n                                continue\r\n                            end\r\n                        end\r\n\r\n                        -- 4. Tolak jika sedang dipegang player lain\r\n                        -- Farm Plot crops are protected by the logging-camp guard in the\r\n                        -- shared held-item check. Biofuel deliberately bypasses that guard\r\n                        -- for food; do the same for plot-grown vegetables here.\r\n                        if isItemHeldByAnotherPlayer(item, isLooseVegetable) then\r\n                            continue\r\n                        end\r\n\r\n                        -- Cek daging busuk setelah validasi bahan di atas.\r\n                        local isRotten = false\r\n                        if item.Name == \"Steak\" or item.Name == \"Morsel\" or item.Name == \"Cooked Steak\" or item.Name == \"Cooked Morsel\" then\r\n                            local meatPart = item:FindFirstChild(\"Main\") or item:FindFirstChild(\"Meat\")\r\n                            if meatPart then\r\n                                local colorStr = tostring(meatPart.BrickColor)\r\n                                if colorStr == \"Eggplant\" or colorStr == \"[85, 0, 127]\" or meatPart.Color == Color3.fromRGB(85, 0, 127) then\r\n                                    isRotten = true\r\n                                end\r\n                            end\r\n                        end\r\n\r\n                        if not isRotten then\r\n                            if _G.ClaimedItems and _G.ClaimedItems[item] and os.time() - _G.ClaimedItems[item] < 8 then\r\n                                continue\r\n                            end\r\n                            itemsByName[item.Name] = itemsByName[item.Name] or {}\r\n                            table.insert(itemsByName[item.Name], item)\r\n                            totalAvailable = totalAvailable + 1\r\n                        end\r\n                    end\r\n\r\n                    -- SORTIR SETIAP KATEGORI MAKANAN BERDASARKAN JARAK TERDEKAT KE STASIUN (Crock Pot / Chefs Station)\r\n                    if refPos then\r\n                        for name, list in pairs(itemsByName) do\r\n                            table.sort(list, function(a, b)\r\n                                local posA = (a:IsA(\"Model\") and a:GetPivot().Position) or (a:IsA(\"BasePart\") and a.Position) or Vector3.zero\r\n                                local posB = (b:IsA(\"Model\") and b:GetPivot().Position) or (b:IsA(\"BasePart\") and b.Position) or Vector3.zero\r\n                                return (posA - refPos).Magnitude < (posB - refPos).Magnitude\r\n                            end)\r\n                        end\r\n                    end\r\n\r\n                    return itemsByName, totalAvailable\r\n                end\r\n\r\n                local lastCleanup = os.time()\r\n\r\n                while autoCookPots and engineToken == _G.KixEngines.Tokens.AutoCookCrockPot do\r\n                    -- Clean up cache tiap 30 detik agar memori tidak bocor & macet setelah 1 jam\r\n                    if os.time() - lastCleanup > 30 then\r\n                        lastCleanup = os.time()\r\n                        if _G.ClaimedItems then\r\n                            for item, timeStamp in pairs(_G.ClaimedItems) do\r\n                                if not item or not item.Parent or (os.time() - timeStamp > 15) then\r\n                                    _G.ClaimedItems[item] = nil\r\n                                end\r\n                            end\r\n                        end\r\n                        if _G.StationFails then\r\n                            for stationObj, _ in pairs(_G.StationFails) do\r\n                                if not stationObj or not stationObj.Parent then\r\n                                    _G.StationFails[stationObj] = nil\r\n                                    _G.StationFeedAttempts[stationObj] = nil\r\n                                    _G.StationLastIngredients[stationObj] = nil\r\n                                    _G.StationBlacklistTime[stationObj] = nil\r\n                                end\r\n                            end\r\n                        end\r\n                    end\r\n\r\n                    local deployables = workspace:FindFirstChild(\"Deployables\")\r\n                    local structures = workspace:FindFirstChild(\"Structures\")\r\n\r\n                    local scanTargets = {}\r\n                    if deployables then for _,v in ipairs(deployables:GetChildren()) do table.insert(scanTargets, v) end end\r\n                    if structures then for _,v in ipairs(structures:GetChildren()) do table.insert(scanTargets, v) end end\r\n\r\n                    local activeStations = {}\r\n                    for _, v in ipairs(scanTargets) do\r\n                        if (string.find(v.Name, \"Crock Pot\") or string.find(v.Name, \"Chefs Station\"))\r\n                            and (v.Name ~= \"Chefs Station\" or _LocalPlayer:GetAttribute(\"Class\") == \"Chef\") then\r\n                            local ingFolder = v:FindFirstChild(\"Ingredients\")\r\n                            local ingredientsCount = ingFolder and #ingFolder:GetChildren() or 0\r\n                            local isCooking = v:GetAttribute(\"Cooking\") or false\r\n                            local canTake = v:GetAttribute(\"CanTake\") or false\r\n\r\n                            if not canTake then\r\n                                -- A new ready state means a new serving/cycle.\r\n                                -- Never let the previous bowl's timestamp apply to it.\r\n                                stewPotReady[v] = nil\r\n                            end\r\n\r\n                            if canTake then\r\n                                local now = os.clock()\r\n                                local record = stewPotReady[v]\r\n                                if not record then\r\n                                    record = {Since = now, Triggered = false}\r\n                                    stewPotReady[v] = record\r\n                                    -- Keep the last ready timestamp briefly even\r\n                                    -- if CanTake turns false during a take prompt.\r\n                                                                        _G.KixPerfDebug.Count(\"StewPotReady\")\r\n                                end\r\n\r\n                                -- Do not take from the pot for the FIRST five seconds.\r\n                                -- This is separate from Auto Pick Up Stew's grace period\r\n                                -- for loose bowls that already exist in workspace.Items.\r\n                                if now - record.Since < 5 then\r\n                                    _G.KixPerfDebug.Count(\"StewPotGraceWaiting\")\r\n                                elseif record.Triggered then\r\n                                    -- No repeated take while the same bowl remains ready.\r\n                                    _G.KixPerfDebug.Count(\"StewPotAlreadyTriggered\")\r\n                                elseif looseStewAtPot(v) then\r\n                                    -- A real stew is already by the pot. It remains\r\n                                    -- available to teammates, and Auto Pick Up Stew owns it.\r\n                                    _G.KixPerfDebug.Count(\"StewPotLooseBowlWaiting\")\r\n                                else\r\n                                    local prompt = stewTakePrompt(v)\r\n                                    if prompt then\r\n                                        -- Mark BEFORE yielding, preventing reentry.\r\n                                        record.Triggered = true\r\n                                        lastStewTake[v] = now\r\n                                        local takeOk = takeStewAndReturnToPot(v, prompt)\r\n                                        _G.KixPerfDebug.Count(takeOk and \"StewPotTakeAfterGrace\" or \"StewPotTakeError\")\r\n                                        -- Do not spam retries while CanTake stays true.\r\n                                        task.wait(0.25)\r\n                                    else\r\n                                        _G.KixPerfDebug.Count(\"StewPotTakePromptMissing\")\r\n                                    end\r\n                                end\r\n                            elseif not isCooking and ingredientsCount < 3 then\r\n                                table.insert(activeStations, v)\r\n                            elseif not isCooking and ingredientsCount >= 3 then\r\n                                -- Native RequestCrockpotItem starts cooking on the third accepted ingredient.\r\n                                _G.KixPerfDebug.Count(\"StewPotFullNotCooking\")\r\n                            end\r\n                        end\r\n                    end\r\n\r\n                    if #activeStations > 0 then\r\n                        -- Prioritaskan Chefs Station jika ada\r\n                        table.sort(activeStations, function(a, b)\r\n                            if a.Name == \"Chefs Station\" and b.Name ~= \"Chefs Station\" then return true end\r\n                            if a.Name ~= \"Chefs Station\" and b.Name == \"Chefs Station\" then return false end\r\n                            return false\r\n                        end)\r\n\r\n                        for _, station in ipairs(activeStations) do\r\n                            if not autoCookPots then break end\r\n\r\n                            local ingFolder = station:FindFirstChild(\"Ingredients\")\r\n                            local ingredientsCount = ingFolder and #ingFolder:GetChildren() or 0\r\n                            if ingredientsCount >= 3 or station:GetAttribute(\"Cooking\") or station:GetAttribute(\"CanTake\") then\r\n                                continue\r\n                            end\r\n\r\n                            local required = 3 - ingredientsCount\r\n\r\n                            -- Cek failure cooldown untuk station ini\r\n                            _G.StationFails = _G.StationFails or {}\r\n                            _G.StationFeedAttempts = _G.StationFeedAttempts or {}\r\n                            _G.StationLastIngredients = _G.StationLastIngredients or {}\r\n                            _G.StationBlacklistTime = _G.StationBlacklistTime or {}\r\n\r\n                            if _G.StationFeedAttempts[station] then\r\n                                if ingredientsCount == _G.StationLastIngredients[station] then\r\n                                    _G.StationFails[station] = (_G.StationFails[station] or 0) + 1\r\n                                else\r\n                                    _G.StationFails[station] = 0\r\n                          